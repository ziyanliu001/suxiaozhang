/**app.wxss**/
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
}

/* 🛡️ 全局：scroll-view 内末尾留白占位
   置于每个 scroll-view 的最后一个子元素之后，防止列表末项贴边
   或被物理安全区（Home 指示条）遮住。在无刘海机型上退化为 20rpx 间距。
   profile / statistics / statistics / index 页面内已有本地同名定义；
   放入 app.wxss 后所有页面均可直接使用，无需在每页 WXSS 中重复声明。*/
.fa-safe-area-spacer {
  height: calc(20rpx + constant(safe-area-inset-bottom));
  height: calc(20rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

/* 🛡️ 半屏弹窗顶部安全区：max-height 贴近 100vh 时，拖拽条/标题会进入刘海/
   状态栏区域；加此 class 在面板内容上方留出安全区高度，确保关闭按钮和
   标题始终在安全区以下。constant() 在前兼容 iOS 11.0。*/
.fa-sheet-top-safe {
  padding-top: calc(20rpx + constant(safe-area-inset-top)) !important;
  padding-top: calc(20rpx + env(safe-area-inset-top)) !important;
}

/* 🛡️ 半屏弹窗底部安全区：防止确认/提交按钮贴近 Home Indicator 被遮挡；
   比 fa-safe-area-spacer 多 10rpx 额外缓冲（30rpx vs 20rpx），留给按钮
   足够的可点击区域。用 !important 保证覆盖行内或更低优先级的 padding-bottom。*/
.fa-sheet-bottom-safe {
  padding-bottom: calc(30rpx + constant(safe-area-inset-bottom)) !important;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom)) !important;
}
