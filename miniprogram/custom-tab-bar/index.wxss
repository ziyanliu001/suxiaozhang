.app-tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 998;
  background: #FFFFFF;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.06);
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.app-tab-bar-inner {
  display: flex;
  align-items: stretch;
  justify-content: space-around;
  height: 100rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-item:active {
  opacity: 0.6;
}

.tab-icon-wrap {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 4rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  background-size: 44rpx 44rpx;
  background-repeat: no-repeat;
  background-position: center;
}

.tab-badge {
  position: absolute;
  top: -6rpx;
  right: 0;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #E03131;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: bold;
  line-height: 32rpx;
  text-align: center;
  box-sizing: border-box;
  border: 2rpx solid #FFFFFF;
}

.tab-label {
  font-size: 20rpx;
  color: #8E8E93;
  line-height: 1;
}

.tab-label.is-active {
  color: #8C1D18;
  font-weight: 600;
}

.tab-icon-home {
  background-image: url("data:image/svg+xml;base64,");
}

.tab-icon-home.is-active {
