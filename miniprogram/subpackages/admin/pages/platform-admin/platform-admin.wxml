<view class="pa-page">

  <navigation-bar
    title="🏢 SaaS 平台管理"
    background="#1C2530"
    color="#FFFFFF"
    dark="{{true}}"
    back="{{true}}"
    showHomeButton="auto"
    bind:layout="onNavLayout"
  ></navigation-bar>

  <view class="pa-loading-state" wx:if="{{!checkedAccess}}" style="margin-top: {{contentTop}}px;">
    <text>校验身份中...</text>
  </view>

  <!-- 🐛 根因修复：身份校验本身失败（网络异常/云函数未部署）时的独立错误态，
       与"确认有身份、但不是平台管理员"的拒绝态区分开——前者可以重试，后者不该
       给一个"重试"按钮误导用户以为多点几次就能有权限 -->
  <view class="pa-denied-state" wx:if="{{checkedAccess && accessError}}" style="margin-top: {{contentTop}}px;">
    <text class="pa-denied-icon">⚠️</text>
    <text class="pa-denied-title">身份校验失败</text>
    <text class="pa-denied-sub">{{accessError}}</text>
    <button class="pa-denied-btn" hover-class="btn-hover" bindtap="onRetryCheckAccess">重新校验</button>
  </view>

  <view class="pa-denied-state" wx:if="{{checkedAccess && !accessError && !isPlatformAdmin}}" style="margin-top: {{contentTop}}px;">
    <text class="pa-denied-icon">🚫</text>
    <text class="pa-denied-title">无权限访问</text>
    <text class="pa-denied-sub">本页面仅限 SaaS 平台管理员（开发者）使用，且不会显示任何门店财务明细。</text>
    <button class="pa-denied-btn" hover-class="btn-hover" bindtap="onGoBack">返回首页</button>
  </view>

  <view class="pa-content" wx:if="{{checkedAccess && !accessError && isPlatformAdmin}}" style="padding-top: {{contentTop}}px;">

    <!-- 📊 统计总览看板：三张轻量 KPI 卡片，横跨两个 Tab 共用，随时能看到
         "有多少码等着卖出去 / 有多少机构在真实付费 / 有几家快到期该跟进续费" -->
    <view class="pa-kpi-row">
      <view class="pa-kpi-card">
        <text class="pa-kpi-num" wx:if="{{!overviewLoading}}">{{overview.totals.unusedActivationCodeCount || 0}}</text>
        <view class="pa-kpi-skel" wx:else></view>
        <text class="pa-kpi-label">待核销码</text>
      </view>
      <view class="pa-kpi-card">
        <text class="pa-kpi-num" wx:if="{{!overviewLoading}}">{{overview.totals.activeSubscriptionCount || 0}}</text>
        <view class="pa-kpi-skel" wx:else></view>
        <text class="pa-kpi-label">已激活机构</text>
      </view>
      <view class="pa-kpi-card">
        <text class="pa-kpi-num {{overview.soonExpiringTenants.length > 0 ? 'pa-kpi-num-warn' : ''}}" wx:if="{{!overviewLoading}}">{{overview.soonExpiringTenants.length || 0}}</text>
        <view class="pa-kpi-skel" wx:else></view>
        <text class="pa-kpi-label">7天内到期</text>
      </view>
    </view>

    <!-- 🗂️ 顶层 Tab 分流：吸顶切换栏，滚动时始终停在导航栏正下方 -->
    <view class="pa-tab-switcher" style="top: {{contentTop}}px;">
      <view class="pa-tab-item {{activeTab === 'codes' ? 'active' : ''}}" data-tab="codes" bindtap="onSwitchTab">🔑 授权码管理</view>
      <view class="pa-tab-item {{activeTab === 'tenants' ? 'active' : ''}}" data-tab="tenants" bindtap="onSwitchTab">🏢 机构管理</view>
    </view>

    <!-- ═══════════════════════ 🔑 授权码管理 ═══════════════════════ -->
    <block wx:if="{{activeTab === 'codes'}}">

      <view class="pa-section-header">
        <text class="pa-section-title">授权码台账</text>
        <button class="pa-btn-create" hover-class="btn-hover" bindtap="onOpenGenerateCodesSheet">+ 生成授权码</button>
      </view>

      <!-- 刚生成的这一批：置顶展示 + 一键复制，不用去下面台账列表里翻找 -->
      <view class="pa-generated-box" wx:if="{{lastGeneratedCodes.length > 0}}">
        <view class="pa-generated-header">
          <text class="pa-generated-title">✅ 刚生成 {{lastGeneratedCodes.length}} 张授权码</text>
          <view class="pa-generated-copy-all" hover-class="btn-hover" bindtap="onCopyAllGeneratedCodes">复制全部</view>
        </view>
        <view class="pa-generated-row" wx:for="{{lastGeneratedCodes}}" wx:key="code" hover-class="btn-hover" bindtap="onCopyActivationCode" data-code="{{item.code}}">
          <text class="pa-generated-code">{{item.code}}</text>
          <text class="pa-generated-meta" wx:if="{{item.codeType === 'add_on'}}">扩容门店包 · +{{item.extraStores}}家</text>
          <text class="pa-generated-meta" wx:else>{{planLabels[item.planType] || item.planType}} · {{item.durationDays}}天</text>
        </view>
      </view>

      <view class="pa-codes-filter-row">
        <view class="pa-codes-filter-tab {{activationCodesFilter === 'UNUSED' ? 'active' : ''}}" data-filter="UNUSED" bindtap="onSwitchActivationCodesFilter">未使用</view>
        <view class="pa-codes-filter-tab {{activationCodesFilter === 'USED' ? 'active' : ''}}" data-filter="USED" bindtap="onSwitchActivationCodesFilter">已核销</view>
        <view class="pa-codes-filter-tab {{activationCodesFilter === 'REVOKED' ? 'active' : ''}}" data-filter="REVOKED" bindtap="onSwitchActivationCodesFilter">已作废</view>
        <view class="pa-codes-filter-tab {{activationCodesFilter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="onSwitchActivationCodesFilter">全部</view>
      </view>

      <!-- 首屏骨架屏：区分"正在加载"与"确认加载完、真的没有数据"两种状态，
           不会在请求还没回来前就先亮出"暂无数据"误导用户 -->
      <view class="pa-code-card pa-skel-card" wx:if="{{activationCodesLoading && activationCodes.length === 0}}">
        <view class="pa-skel-bar pa-skel-bar-lg"></view>
        <view class="pa-skel-bar pa-skel-bar-sm"></view>
      </view>

      <view class="pa-empty-state" wx:elif="{{!activationCodesLoading && activationCodes.length === 0}}">
        <text class="pa-empty-icon">📭</text>
        <text class="pa-empty-title">暂无{{activationCodesFilter === 'all' ? '' : (codeStatusLabels[activationCodesFilter] || '')}}授权码</text>
        <text class="pa-empty-sub">点击上方"+ 生成授权码"铸造第一批</text>
      </view>

      <block wx:else>
        <view class="pa-code-card" wx:for="{{activationCodes}}" wx:key="code" hover-class="btn-hover" bindtap="onCopyActivationCode" data-code="{{item.code}}">
          <view class="pa-code-row-top">
            <text class="pa-code-text">{{item.code}}</text>
            <text class="pa-code-status pa-code-status-{{item.status}}">{{codeStatusLabels[item.status] || item.status}}</text>
          </view>
          <view class="pa-code-row-bottom">
            <block wx:if="{{item.codeType === 'add_on'}}">
              <text class="pa-plan-badge pa-plan-badge-addon">扩容门店包</text>
              <text class="pa-duration-badge">+{{item.extraStores}}家</text>
            </block>
            <block wx:else>
              <text class="pa-plan-badge pa-plan-badge-{{item.planType}}">{{planLabels[item.planType] || item.planType}}</text>
              <text class="pa-duration-badge">{{item.durationDays}}天</text>
            </block>
            <!-- 🗑️ 仅未使用的码可作废：catchtap 阻止冒泡到卡片本身的复制 bindtap，
                 避免点"作废"顺带又触发一次复制 Toast -->
            <view class="pa-code-revoke-btn" wx:if="{{item.status === 'UNUSED'}}" hover-class="btn-hover" catchtap="onRevokeActivationCode" data-codeid="{{item._id}}" data-code="{{item.code}}" data-status="{{item.status}}">作废</view>
          </view>
          <!-- 已核销：明确展示核销机构名称 + 核销时间，不是只有一个状态 Tag -->
          <view class="pa-code-redeemed-box" wx:if="{{item.status === 'USED'}}">
            <text class="pa-code-redeemed-row">🏢 {{item.redeemedByTenantName || '未知机构'}}</text>
            <text class="pa-code-redeemed-row" wx:if="{{item.redeemedAtLabel}}">🕐 {{item.redeemedAtLabel}}</text>
          </view>
          <!-- 已作废：展示作废时间 + 原因，与已核销的信息盒子同一视觉语言 -->
          <view class="pa-code-redeemed-box pa-code-revoked-box" wx:if="{{item.status === 'REVOKED'}}">
            <text class="pa-code-redeemed-row" wx:if="{{item.revokedAtLabel}}">🕐 {{item.revokedAtLabel}}</text>
            <text class="pa-code-redeemed-row" wx:if="{{item.revokeReason}}">📝 {{item.revokeReason}}</text>
          </view>
        </view>

        <view class="pa-load-more-row" wx:if="{{activationCodesLoadingMore}}">
          <text>加载中...</text>
        </view>
        <view class="pa-load-more-row" wx:elif="{{!activationCodesHasMore}}">
          <text>没有更多了</text>
        </view>
      </block>

    </block>

    <!-- ═══════════════════════ 🏢 机构管理 ═══════════════════════ -->
    <block wx:else>

      <view class="pa-soon-expire-box" wx:if="{{overview.soonExpiringTenants.length > 0}}">
        <text class="pa-soon-title">⚠️ 7 天内到期机构</text>
        <view class="pa-soon-item" wx:for="{{overview.soonExpiringTenants}}" wx:key="_id">
          <text>{{item.tenantId}} · {{planLabels[item.planType] || item.planType}} · 到期 {{item.serviceExpireDate}}</text>
        </view>
      </view>

      <view class="pa-section-header">
        <text class="pa-section-title">机构列表</text>
        <button class="pa-btn-create" hover-class="btn-hover" bindtap="onOpenCreateTenantSheet">+ 新建机构</button>
      </view>

      <view class="pa-tenant-card pa-skel-card" wx:if="{{tenantsLoading && tenants.length === 0}}">
        <view class="pa-skel-bar pa-skel-bar-lg"></view>
        <view class="pa-skel-bar pa-skel-bar-sm"></view>
      </view>

      <view class="pa-empty-state" wx:elif="{{!tenantsLoading && tenants.length === 0}}">
        <text class="pa-empty-icon">🏢</text>
        <text class="pa-empty-title">暂无机构</text>
        <text class="pa-empty-sub">点击上方"+ 新建机构"创建第一个</text>
      </view>

      <block wx:else>
        <view class="pa-tenant-card" wx:for="{{tenants}}" wx:key="_id">
          <view class="pa-tenant-header">
            <text class="pa-tenant-name">{{item.name}}</text>
            <text class="pa-tenant-status pa-status-{{item.status}}">{{item.status}}</text>
          </view>
          <view class="pa-tenant-body">
            <view class="pa-tenant-plan-row" wx:if="{{item.subscription}}">
              <text class="pa-plan-badge pa-plan-badge-{{item.subscription.planType}}">{{planLabels[item.subscription.planType] || item.subscription.planType}}</text>
              <text class="pa-plan-badge pa-plan-badge-expiring" wx:if="{{item.isExpiringSoon}}">⚠️ 即将到期</text>
              <text class="pa-tenant-row pa-expire-text">到期：{{item.subscription.serviceExpireDate}}</text>
            </view>
            <text class="pa-tenant-row" wx:else>尚未开通订阅</text>
            <text class="pa-tenant-row pa-tenant-id">机构 ID：{{item._id}}</text>
            <!-- 🏪 门店容量进度：门店本身不会在这张机构列表里单独占一行（门店是挂在
                 tenantId 下的子资源），这里直接把"已用/配额"亮出来，避免管理员误以为
                 某个门店"丢了"——点"查看门店"即可展开该机构下的具体门店清单。
                 配额满时进度条变红，与"配额已满"的建店拦截提示相呼应 -->
            <view class="pa-store-quota-row">
              <text class="pa-tenant-row pa-tenant-store-count">🏪 {{item.storeCount || 0}} / {{item.storeLimit}} 家门店</text>
              <view class="pa-store-quota-bar">
                <view class="pa-store-quota-bar-fill {{item.isStoreQuotaFull ? 'pa-store-quota-bar-full' : ''}}" style="width: {{item.storeQuotaPercent}}%;"></view>
              </view>
            </view>
          </view>
          <view class="pa-tenant-actions">
            <button class="pa-btn-small" hover-class="btn-hover" data-tenantid="{{item._id}}" data-tenantname="{{item.name}}" bindtap="onOpenTenantStores">查看门店</button>
            <button class="pa-btn-small" hover-class="btn-hover" data-tenantid="{{item._id}}" data-tenantname="{{item.name}}" bindtap="onOpenRenewForm">开通/续费</button>
            <!-- 🛑 终止订阅：仅在机构当前持有生效中的付费套餐（非免费版且未到期）
                 时才展示，与云函数 terminateTenantSubscription 的校验口径对齐 -->
            <button
              wx:if="{{item.isActivePaidPlan}}"
              class="pa-btn-small pa-btn-danger"
              hover-class="btn-hover"
              loading="{{terminatingTenantId === item._id}}"
              disabled="{{!!terminatingTenantId}}"
              data-tenantid="{{item._id}}"
              data-tenantname="{{item.name}}"
              data-plantype="{{item.subscription.planType}}"
              bindtap="onTerminateSubscription"
            >终止订阅</button>
            <button class="pa-btn-small pa-btn-warn" hover-class="btn-hover" data-tenantid="{{item._id}}" data-currentstatus="{{item.status}}" bindtap="onToggleTenantStatus">
              {{item.status === 'suspended' ? '恢复服务' : '暂停服务'}}
            </button>
          </view>
        </view>

        <view class="pa-load-more-row" wx:if="{{tenantsLoadingMore}}">
          <text>加载中...</text>
        </view>
        <view class="pa-load-more-row" wx:elif="{{!tenantsHasMore}}">
          <text>没有更多了</text>
        </view>
      </block>

    </block>

    <view class="fa-safe-area-spacer"></view>
  </view>

  <!-- 🌸 底部抽屉：生成授权码 -->
  <view class="pa-sheet-mask" wx:if="{{showGenerateCodesSheet}}" bindtap="onCloseGenerateCodesSheet">
    <view class="pa-sheet-box" catchtap="noop">
      <view class="pa-sheet-handle"></view>
      <text class="pa-sheet-title">生成授权码</text>

      <text class="pa-field-label">授权码类型</text>
      <view class="pa-plan-row">
        <view class="pa-plan-tag {{generateCodesForm.codeType === 'package' ? 'active' : ''}}" hover-class="btn-hover" data-type="package" bindtap="onSelectCodeType">套餐码</view>
        <view class="pa-plan-tag {{generateCodesForm.codeType === 'add_on' ? 'active' : ''}}" hover-class="btn-hover" data-type="add_on" bindtap="onSelectCodeType">扩容门店包（¥200/店/年）</view>
      </view>

      <block wx:if="{{generateCodesForm.codeType === 'add_on'}}">
        <text class="pa-field-label">单张码扩容门店数（最多 20 家）</text>
        <input class="pa-input {{generateCodesErrors.extraStores ? 'pa-input-error' : ''}}" type="number" placeholder="如：1" value="{{generateCodesForm.extraStores}}" bindinput="onGenerateCodesFormInput" data-field="extraStores" />
        <text class="pa-field-error" wx:if="{{generateCodesErrors.extraStores}}">{{generateCodesErrors.extraStores}}</text>
      </block>
      <block wx:else>
        <text class="pa-field-label">套餐档位</text>
        <view class="pa-plan-row">
          <view class="pa-plan-tag {{generateCodesForm.planType === 'pro' ? 'active' : ''}}" hover-class="btn-hover" data-plan="pro" bindtap="onSelectCodePlan">专业版（¥1688/年）</view>
          <view class="pa-plan-tag {{generateCodesForm.planType === 'enterprise' ? 'active' : ''}}" hover-class="btn-hover" data-plan="enterprise" bindtap="onSelectCodePlan">旗舰版（¥3688/年）</view>
        </view>

        <text class="pa-field-label">有效期（天）</text>
        <input class="pa-input {{generateCodesErrors.durationDays ? 'pa-input-error' : ''}}" type="number" placeholder="如：365" value="{{generateCodesForm.durationDays}}" bindinput="onGenerateCodesFormInput" data-field="durationDays" />
        <text class="pa-field-error" wx:if="{{generateCodesErrors.durationDays}}">{{generateCodesErrors.durationDays}}</text>
      </block>

      <text class="pa-field-label">生成数量（单次最多 50 张）</text>
      <input class="pa-input {{generateCodesErrors.quantity ? 'pa-input-error' : ''}}" type="number" placeholder="如：1" value="{{generateCodesForm.quantity}}" bindinput="onGenerateCodesFormInput" data-field="quantity" />
      <text class="pa-field-error" wx:if="{{generateCodesErrors.quantity}}">{{generateCodesErrors.quantity}}</text>

      <view class="pa-sheet-actions">
        <button class="pa-btn-cancel" hover-class="btn-hover" bindtap="onCloseGenerateCodesSheet" disabled="{{generatingCodes}}">取消</button>
        <button class="pa-btn-submit" hover-class="btn-hover" bindtap="onSubmitGenerateCodes" loading="{{generatingCodes}}" disabled="{{generatingCodes}}">铸造授权码</button>
      </view>
      <view class="pa-safe-area-spacer"></view>
    </view>
  </view>

  <!-- 🌸 底部抽屉：新建机构 -->
  <view class="pa-sheet-mask" wx:if="{{showCreateTenantSheet}}" bindtap="onCloseCreateTenantSheet">
    <view class="pa-sheet-box" catchtap="noop">
      <view class="pa-sheet-handle"></view>
      <text class="pa-sheet-title">新建机构</text>

      <text class="pa-field-label">机构名称</text>
      <input class="pa-input {{createFormErrors.name ? 'pa-input-error' : ''}}" placeholder="必填" value="{{createForm.name}}" bindinput="onCreateFormInput" data-field="name" />
      <text class="pa-field-error" wx:if="{{createFormErrors.name}}">{{createFormErrors.name}}</text>

      <text class="pa-field-label">联系人姓名</text>
      <input class="pa-input" placeholder="选填" value="{{createForm.contactName}}" bindinput="onCreateFormInput" data-field="contactName" />

      <text class="pa-field-label">联系电话</text>
      <input class="pa-input" placeholder="选填" value="{{createForm.contactPhone}}" bindinput="onCreateFormInput" data-field="contactPhone" />

      <view class="pa-sheet-actions">
        <button class="pa-btn-cancel" hover-class="btn-hover" bindtap="onCloseCreateTenantSheet" disabled="{{creatingTenant}}">取消</button>
        <button class="pa-btn-submit" hover-class="btn-hover" bindtap="onSubmitCreateTenant" loading="{{creatingTenant}}" disabled="{{creatingTenant}}">创建机构</button>
      </view>
      <view class="pa-safe-area-spacer"></view>
    </view>
  </view>

  <!-- 🏪 底部抽屉：机构下挂门店清单——排查"机构列表看不到某个门店"的入口，
       门店本身不在机构列表里单独占一行，这里按 tenantId 展开具体门店 -->
  <view class="pa-sheet-mask" wx:if="{{showTenantStoresSheet}}" bindtap="onCloseTenantStores">
    <view class="pa-sheet-box" catchtap="noop">
      <view class="pa-sheet-handle"></view>
      <text class="pa-sheet-title">【{{tenantStoresTenantName}}】门店清单</text>

      <view class="pa-code-card pa-skel-card" wx:if="{{tenantStoresLoading}}">
        <view class="pa-skel-bar pa-skel-bar-lg"></view>
        <view class="pa-skel-bar pa-skel-bar-sm"></view>
      </view>

      <view class="pa-empty-state" wx:elif="{{tenantStores.length === 0}}">
        <text class="pa-empty-icon">🏪</text>
        <text class="pa-empty-title">该机构下暂无门店</text>
      </view>

      <scroll-view scroll-y class="pa-tenant-store-list" wx:else>
        <view class="pa-tenant-store-row" wx:for="{{tenantStores}}" wx:key="_id">
          <view class="pa-tenant-store-row-top">
            <text class="pa-tenant-store-name">{{item.storeName}}</text>
            <text class="pa-tenant-status pa-status-{{item.status === 'inactive' ? 'expired' : 'active'}}">{{item.status === 'inactive' ? '已停用' : '正常'}}</text>
          </view>
          <text class="pa-tenant-row" wx:if="{{item.city || item.province}}">📍 {{item.province}}{{item.city}}</text>
          <text class="pa-tenant-row" wx:if="{{item.createdAtLabel}}">🕐 创建于 {{item.createdAtLabel}}</text>
          <!-- 👪 家长绑定信息：有绑定才展示这一行，未绑定不显示"解除家长"按钮 -->
          <text class="pa-tenant-row" wx:if="{{item.patriarch}}">👪 家长：{{item.patriarch}}</text>
          <view class="pa-tenant-store-actions">
            <button
              class="pa-btn-small pa-btn-warn"
              hover-class="btn-hover"
              loading="{{storeActionInFlightId === item._id}}"
              disabled="{{!!storeActionInFlightId}}"
              data-storeid="{{item._id}}"
              data-storename="{{item.storeName}}"
              data-status="{{item.status}}"
              bindtap="onSetStoreStatus"
            >{{item.status === 'inactive' ? '启用门店' : '停用门店'}}</button>
            <button
              wx:if="{{item.patriarch}}"
              class="pa-btn-small pa-btn-warn"
              hover-class="btn-hover"
              loading="{{storeActionInFlightId === item._id}}"
              disabled="{{!!storeActionInFlightId}}"
              data-storeid="{{item._id}}"
              data-storename="{{item.storeName}}"
              data-patriarch="{{item.patriarch}}"
              bindtap="onUnbindStorePatriarch"
            >解除家长</button>
            <button
              class="pa-btn-small pa-btn-danger"
              hover-class="btn-hover"
              loading="{{storeActionInFlightId === item._id}}"
              disabled="{{!!storeActionInFlightId}}"
              data-storeid="{{item._id}}"
              data-storename="{{item.storeName}}"
              bindtap="onRemoveStoreFromTenant"
            >移出机构</button>
            <!-- 🚪 加入机构：与"移出机构"对称，供孤儿门店（tenantId 已清空）或需要
                 改挂到别的机构的门店重新关联使用。手动输入目标机构 ID——机构卡片上
                 的"机构 ID：{{item._id}}"（见机构列表）本就是可复制查看的，v1 先不做
                 搜索选择器，保持轻量 -->
            <button
              class="pa-btn-small"
              hover-class="btn-hover"
              loading="{{storeActionInFlightId === item._id}}"
              disabled="{{!!storeActionInFlightId}}"
              data-storeid="{{item._id}}"
              data-storename="{{item.storeName}}"
              bindtap="onAssignStoreToTenant"
            >加入机构</button>
          </view>
        </view>
      </scroll-view>

      <view class="pa-sheet-actions">
        <button class="pa-btn-cancel" hover-class="btn-hover" bindtap="onCloseTenantStores">关闭</button>
      </view>
      <view class="pa-safe-area-spacer"></view>
    </view>
  </view>

  <!-- 🌸 底部抽屉：开通/续费 -->
  <view class="pa-sheet-mask" wx:if="{{showRenewSheet}}" bindtap="onCloseRenewForm">
    <view class="pa-sheet-box" catchtap="noop">
      <view class="pa-sheet-handle"></view>
      <text class="pa-sheet-title">为【{{renewForm.tenantName}}】开通/续费</text>

      <text class="pa-field-label">套餐档位</text>
      <view class="pa-plan-row">
        <view class="pa-plan-tag {{renewForm.planType === 'basic' ? 'active' : ''}}" hover-class="btn-hover" data-plan="basic" bindtap="onSelectPlan">基础版</view>
        <view class="pa-plan-tag {{renewForm.planType === 'pro' ? 'active' : ''}}" hover-class="btn-hover" data-plan="pro" bindtap="onSelectPlan">专业版</view>
        <view class="pa-plan-tag {{renewForm.planType === 'enterprise' ? 'active' : ''}}" hover-class="btn-hover" data-plan="enterprise" bindtap="onSelectPlan">旗舰版</view>
      </view>

      <text class="pa-field-label">服务开始日期</text>
      <input class="pa-input {{renewFormErrors.serviceStartDate ? 'pa-input-error' : ''}}" placeholder="YYYY-MM-DD" value="{{renewForm.serviceStartDate}}" bindinput="onRenewFormInput" data-field="serviceStartDate" />
      <text class="pa-field-error" wx:if="{{renewFormErrors.serviceStartDate}}">{{renewFormErrors.serviceStartDate}}</text>

      <!-- 🆓 基础版免费、无到期概念：日期选择换成一条置灰的"永久有效"提示，
           不再让平台管理员误以为要给免费版也挑一个到期日 -->
      <text class="pa-field-label">服务到期日期</text>
      <view class="pa-permanent-badge" wx:if="{{renewForm.planType === 'basic'}}">🌿 永久有效，无需续费</view>
      <block wx:else>
        <input class="pa-input {{renewFormErrors.serviceExpireDate ? 'pa-input-error' : ''}}" placeholder="YYYY-MM-DD" value="{{renewForm.serviceExpireDate}}" bindinput="onRenewFormInput" data-field="serviceExpireDate" />
        <text class="pa-field-error" wx:if="{{renewFormErrors.serviceExpireDate}}">{{renewFormErrors.serviceExpireDate}}</text>
      </block>

      <text class="pa-field-label">门店数量配额</text>
      <input class="pa-input {{renewForm.planType === 'basic' ? 'pa-input-disabled' : ''}}" type="number" placeholder="如：10" value="{{renewForm.storeLimit}}" disabled="{{renewForm.planType === 'basic'}}" bindinput="onRenewFormInput" data-field="storeLimit" />
      <text class="pa-field-hint" wx:if="{{renewForm.planType === 'basic'}}">基础版为免费版固定配额（2 家门店），不可调整</text>

      <text class="pa-field-label">开通/续费原因（必填，留痕审计）</text>
      <textarea class="pa-textarea {{renewFormErrors.reason ? 'pa-input-error' : ''}}" placeholder="{{renewForm.planType === 'basic' ? '如：新机构公益接入 / 免费开通' : '如：新机构首次开通 / 年度续费'}}" value="{{renewForm.reason}}" bindinput="onRenewFormInput" data-field="reason" />
      <text class="pa-field-error" wx:if="{{renewFormErrors.reason}}">{{renewFormErrors.reason}}</text>

      <view class="pa-sheet-actions">
        <button class="pa-btn-cancel" hover-class="btn-hover" bindtap="onCloseRenewForm" disabled="{{renewSubmitting}}">取消</button>
        <button class="pa-btn-submit" hover-class="btn-hover" bindtap="onSubmitRenew" loading="{{renewSubmitting}}" disabled="{{renewSubmitting}}">确认提交</button>
      </view>
      <view class="pa-safe-area-spacer"></view>
    </view>
  </view>

</view>
