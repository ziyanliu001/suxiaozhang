.pa-page {
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  box-sizing: border-box;
  background: #F4F5F7;
}

/* 🐛 根因修复（2026-09-10）：见 platform-admin.wxml 顶部同处注释——
   navigation-bar 通过 extClass 注入这个类，脱离文档流固定贴顶，不再依赖
   隐式流式布局高度撑开下方内容；下方内容改用 pa-page 的 padding-top（真实
   测量值 contentTop）显式补位。z-index 高于 .pa-tab-switcher（60）但低于
   底部抽屉遮罩 .pa-sheet-mask（200），弹窗仍能正常盖住导航栏 */
.pa-nav-bar-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  /* 🎨（2026-09-10）浅色导航栏与下方页面背景色非常接近，光靠色块本身已经
     不足以让用户分辨"这是导航栏"——用一条极淡的底部描边 + 微弱投影维持
     可感知的分界线，取代此前"用大面积深色块压出边界"的做法 */
  border-bottom: 1rpx solid rgba(28, 37, 48, 0.06);
  box-shadow: 0 2rpx 6rpx rgba(28, 37, 48, 0.03);
}

/* 🌟 通用点击反馈：本页此前大部分按钮完全没有 hover-class，点击手感生硬——
   统一补上这一条"轻微变暗"语言 */
.btn-hover {
  opacity: 0.7;
}

.pa-loading-state,
.pa-denied-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  text-align: center;
}

.pa-denied-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.pa-denied-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

.pa-denied-sub {
  font-size: 26rpx;
  color: #888888;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

/* 🐛 加固：此前完全依赖原生 <button> 默认内边距/行高，这里显式 flex 居中 +
   box-sizing/margin/line-height 归零，与本页其余按钮统一 */
.pa-denied-btn {
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  padding: 0 48rpx;
  margin: 0;
  line-height: 1;
  background: #1C2530;
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 38rpx;
}

.pa-denied-btn::after {
  border: none;
}

/* 🐛 根因修复：此前 .pa-content 是 scroll-view 且高度写死 calc(100vh - 88rpx)，
   页面内容在一个独立的滚动容器里，与小程序原生的 onPullDownRefresh/
   onReachBottom 生命周期完全不搭边（那两个钩子只对"页面自身的原生滚动"生效）。
   改成普通 view + 让页面本身原生滚动，下拉刷新和触底加载更多才能真正工作 */
.pa-content {
  box-sizing: border-box;
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* ═══════════════════════════════════════════════════════════════
   📊 KPI 总览卡片：两个 Tab 共用的顶部数据看板
   ═══════════════════════════════════════════════════════════════ */
/* 🎨（2026-09-10）磨砂质感的"底色"——极淡暖灰渐变，给下面半透明卡片的
   backdrop-filter 提供可辨识的色彩过渡，同时呼应品牌深红但不抢眼 */
.pa-kpi-panel {
  background: linear-gradient(135deg, #FBF3F2 0%, #F6F7F9 65%);
  border-radius: 20rpx;
  padding: 18rpx 14rpx;
  margin-bottom: 20rpx;
}

.pa-kpi-row {
  display: flex;
  gap: 14rpx;
}

.pa-kpi-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
  padding: 22rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(140, 29, 24, 0.05);
}

.pa-kpi-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #1C2530;
  line-height: 1.2;
}

.pa-kpi-num-warn {
  color: #E8590C;
}

.pa-kpi-skel {
  width: 60rpx;
  height: 40rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #EEF0F2 25%, #E4E7EB 37%, #EEF0F2 63%);
  background-size: 400% 100%;
  animation: pa-skel-shimmer 1.6s ease-in-out infinite;
}

/* 🎨 数字与标签的层次感：字距拉开 + 弱化颜色，与上方大号加粗数字形成对比 */
.pa-kpi-label {
  font-size: 21rpx;
  color: #9199A3;
  letter-spacing: 1rpx;
  margin-top: 8rpx;
}

/* ═══════════════════════════════════════════════════════════════
   🗂️ 顶层 Tab 分流：吸顶切换栏
   ═══════════════════════════════════════════════════════════════ */
/* 🎨（2026-09-10 精简内外边距）吸顶栏本身不再需要大留白——它贴着上面
   KPI 面板、下面紧跟内容，留白太多会在两块之间制造不必要的视觉断层 */
.pa-tab-switcher {
  position: sticky;
  z-index: 60;
  display: flex;
  gap: 10rpx;
  background: #F4F5F7;
  padding: 6rpx 0;
  margin-bottom: 4rpx;
}

.pa-tab-item {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  font-size: 25rpx;
  font-weight: 600;
  background: #FFFFFF;
  color: #666666;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.pa-tab-item.active {
  background: #1C2530;
  color: #FFD700;
}

.pa-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 0 16rpx;
}

.pa-section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.pa-btn-create {
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  padding: 0 24rpx;
  margin: 0;
  line-height: 1;
  font-size: 24rpx;
  background: #1C2530;
  color: #FFFFFF;
  border-radius: 30rpx;
}

.pa-btn-create::after {
  border: none;
}

/* 🐛 修复输入框高度塌陷/重叠：此前只有上下 20rpx padding、没有显式
   height/line-height，不同 input（数字/文本、有无 placeholder）实际渲染
   高度会因内容/字体渲染差异而不一致，与相邻的 label/error 文本行距挤在
   一起。改为固定 height + 同值 line-height 让文字/placeholder 垂直居中，
   box-sizing: border-box 确保 padding 不会把盒子撑高过设定值 */
.pa-input {
  height: 80rpx;
  line-height: 80rpx;
  box-sizing: border-box;
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  margin-bottom: 8rpx;
  border: 2rpx solid transparent;
}

.pa-input-error {
  border-color: #E8590C;
  background: #FFF5F0;
}

/* 🆓 基础版门店配额锁定态：与 .pa-input 保持同样的尺寸/圆角，只是置灰+不可点，
   让用户一眼看出"这个字段现在不可编辑"而不是"这个字段坏了" */
.pa-input-disabled {
  background: #EBEDF0;
  color: #999999;
}

.pa-field-error {
  display: block;
  font-size: 22rpx;
  color: #E8590C;
  margin-bottom: 12rpx;
}

.pa-field-hint {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

/* 🌿 基础版"永久有效"提示条：替代到期日期输入框的位置，视觉上与 .pa-input
   同高但用绿色系区分"这是一条状态说明，不是待填写的表单项" */
.pa-permanent-badge {
  display: flex;
  align-items: center;
  background: #F0F9F0;
  color: #2B8A3E;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.pa-textarea {
  background: #F4F5F7;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 26rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 120rpx;
  margin-bottom: 8rpx;
  border: 2rpx solid transparent;
}

.pa-tenant-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.pa-tenant-empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999999;
  font-size: 26rpx;
}

.pa-tenant-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.pa-tenant-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

/* 🎨（2026-09-10 标签美化）小胶囊统一加一圈同色系描边——纯色底 + 白字在
   浅色卡片上边缘略显生硬，一圈半透明白描边能让胶囊边界更清晰、质感更精致 */
.pa-tenant-status {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  padding: 5rpx 18rpx;
  border-radius: 20rpx;
  color: #FFFFFF;
  background: #999999;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  letter-spacing: 1rpx;
}

/* 🐛 根因修复（状态徽章矛盾）：此前 .pa-status-active 与
   .pa-status-expired/.pa-status-suspended 共用同一份"机构记录状态"绑定，
   现在改绑 item.displayStatus（decorateTenants() 算出的展示专用状态），
   四态视觉上明确分开：生效中=绿，已到期=橙（自然到期，不是管理员主动
   处置，比"已暂停"轻一档），已暂停=红（管理员主动处置），未开通=中性灰 */
.pa-status-active {
  background: #2E7D32;
}

.pa-status-trial {
  background: #F9A825;
}

.pa-status-expired {
  background: #F9A825;
}

.pa-status-suspended {
  background: #C62828;
}

.pa-status-none {
  background: #9CA3AF;
}

.pa-tenant-row {
  display: block;
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 6rpx;
}

/* 🐛 机构 ID 对比度修复：#BBBBBB 在浅色卡片背景上过淡，加深到 #8E8E93，
   仍是弱化的次要信息，但达到基本可读对比度 */
.pa-tenant-id-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.pa-tenant-id {
  color: #8E8E93;
  font-size: 20rpx;
  margin-bottom: 0;
}

.pa-tenant-id-copy {
  font-size: 20rpx;
  color: #495057;
  background: #F1F3F5;
  border-radius: 10rpx;
  padding: 2rpx 12rpx;
}

.pa-tenant-store-count {
  color: #495057;
  font-weight: 600;
}

/* 🏪 门店容量进度条：配额未满是绿色，配额已满（isStoreQuotaFull）变红，
   与「已达配额上限」的建店拦截提示保持同一套视觉语义 */
.pa-store-quota-row {
  margin-bottom: 10rpx;
}

.pa-store-quota-bar {
  margin-top: 6rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #E9ECEF;
  overflow: hidden;
}

.pa-store-quota-bar-fill {
  height: 100%;
  border-radius: 4rpx;
  background: #4CAF50;
  transition: width 0.2s ease;
}

.pa-store-quota-bar-fill.pa-store-quota-bar-full {
  background: #C62828;
}

/* 🏪 机构下挂门店抽屉：与授权码台账卡片（.pa-code-card）同一套滚动/间距习惯 */
.pa-tenant-store-list {
  max-height: 720rpx;
}

.pa-tenant-store-row {
  background: #F8F9FA;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

/* 🎨（2026-09-10 状态标签内联）改用 gap 而不是 space-between——状态胶囊
   紧贴在门店名右侧，读起来是"门店名 [状态]"一个整体，而不是被推到卡片
   最右边缘、跟名字之间隔着一大段空白 */
.pa-tenant-store-row-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.pa-tenant-store-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #1C2530;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 🎨（2026-09-10 操作区收敛）与机构卡片的 .pa-tenant-actions 同一套模式：
   1 个高频主操作 + 1 个圆形"⋯更多"，永远单行、不会再因为按钮数量不定
   （0~3 个）撑高卡片或换行堆叠 */
.pa-tenant-store-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

/* 🎨 套餐 Tag：免费版灰色/专业版金色/旗舰版深色，即将到期橙色警告——
   与机构自身运营状态的 .pa-status-* 色系区分开，这是订阅套餐维度的标签 */
.pa-tenant-plan-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.pa-plan-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 5rpx 18rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.pa-plan-badge-basic {
  background: #EDEFF2;
  color: #6B7280;
}

.pa-plan-badge-pro {
  background: #FFF3E0;
  color: #B8860B;
}

.pa-plan-badge-enterprise {
  background: #1C2530;
  color: #FFD700;
}

.pa-plan-badge-addon {
  background: #E6F4EA;
  color: #2E7D32;
}

.pa-plan-badge-expiring {
  background: #FFF3E0;
  color: #E8590C;
}

.pa-expire-text {
  display: inline;
  margin-bottom: 0;
}

/* 🐛（操作栏紧凑化）此前是 4 个 .pa-btn-small 换行铺开，经常挤成两行拉高
   卡片高度。改为 2 个描边胶囊主操作（.pa-tenant-action-btn）+ 1 个圆形
   "更多"入口（.pa-tenant-more-btn），单行放得下，暂停/恢复服务与终止订阅
   收进 onOpenTenantMoreActions 的原生 ActionSheet */
.pa-tenant-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.pa-tenant-action-btn {
  flex: 1;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #495057;
  border: 1.5rpx solid #DEE2E6;
  background: #FFFFFF;
}

.pa-tenant-action-btn-primary {
  color: #1C2530;
  border-color: #1C2530;
  font-weight: 600;
}

.pa-tenant-more-btn {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F1F3F5;
  color: #495057;
  font-size: 28rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.pa-soon-expire-box {
  background: #FFF3E0;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.pa-soon-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #B8860B;
  margin-bottom: 8rpx;
  display: block;
}

.pa-soon-item {
  font-size: 22rpx;
  color: #8D6E00;
  margin-bottom: 4rpx;
}

/* ═══════════════════════════════════════════════════════════════
   🌸 授权码生成/分发：过渡收入手段——见 platform-admin.ts data 声明处注释
   ═══════════════════════════════════════════════════════════════ */
.pa-generated-box {
  background: #FFF8E1;
  border: 2rpx solid #FFD54F;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.pa-generated-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.pa-generated-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #8D6E00;
}

.pa-generated-copy-all {
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  border-radius: 26rpx;
  background: #1C2530;
  color: #FFFFFF;
  font-size: 22rpx;
}

.pa-generated-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 10rpx;
}

.pa-generated-row:last-child {
  margin-bottom: 0;
}

.pa-generated-code {
  font-family: 'Courier New', Courier, monospace;
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
  letter-spacing: 1rpx;
}

.pa-generated-meta {
  font-size: 20rpx;
  color: #999999;
}

/* 🆕 机构搜索框：复用 .pa-input 的高度/圆角/底色，margin-bottom 加大到
   16rpx 与下方筛选 Tag 行拉开距离（表单里的 .pa-input 默认 margin-bottom
   只有 8rpx，是给紧跟着的 field-error 文案留的，这里没有 error 文案） */
.pa-tenant-search-input {
  margin-bottom: 16rpx;
}

/* 🆕 机构状态筛选 Tag：与授权码台账的 .pa-codes-filter-row 同一套视觉语言 */
.pa-tenant-filter-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.pa-codes-filter-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.pa-codes-filter-tab {
  flex: 1;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  font-size: 24rpx;
  background: #EDEFF2;
  color: #666666;
}

.pa-codes-filter-tab.active {
  background: #1C2530;
  color: #FFFFFF;
  font-weight: bold;
}

/* 🆕（可视化制卡台账）顶部库存看板：三张等宽卡片，与下方 .pa-code-card
   同一套白底圆角阴影视觉语言，数值用页面主色（#1C2530）突出 */
.pa-stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.pa-stat-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.pa-stat-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #1C2530;
}

.pa-stat-label {
  font-size: 20rpx;
  color: #868E96;
}

.pa-code-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.pa-code-row-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

/* 🎨 等宽字体 + 更大字号：授权码是本页最核心的"要复制去卖给客户"的内容，
   视觉上必须第一时间跳出来，且等宽字体让字符对齐、不容易看错/抄错 */
.pa-code-text {
  font-family: 'Courier New', Courier, monospace;
  font-size: 34rpx;
  font-weight: 800;
  color: #1C2530;
  letter-spacing: 1rpx;
}

/* 🆕（2026-09-10）左侧分组：授权码文本 + 显式复制按钮，与右侧状态徽章
   保持 .pa-code-row-top 原有的 space-between 两端对齐关系不变 */
.pa-code-row-top-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.pa-code-copy-btn {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: #495057;
  background: #F1F3F5;
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
}

.pa-code-status {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  color: #FFFFFF;
  flex-shrink: 0;
}

.pa-code-status-UNUSED {
  background: #2E7D32;
}

.pa-code-status-USED {
  background: #9E9E9E;
}

.pa-code-status-REVOKED {
  background: #C92A2A;
}

.pa-code-row-bottom {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

/* 🎯（2026-09-10 双轨兼容）定向/通用码标注——flex-basis:100% 让它无论长短
   都独占一行，排在套餐/有效期徽章下方、不与它们抢同一行空间，也不会因为
   门店名称长度不定挤压到旁边的"作废"按钮 */
.pa-target-badge {
  flex-basis: 100%;
  margin-top: 6rpx;
  font-size: 22rpx;
}

.pa-target-badge-dedicated {
  color: #E8590C;
  font-weight: 600;
}

.pa-target-badge-generic {
  color: #868E96;
}

/* 🗑️ 作废按钮：与门店管理页停用按钮同一套警示红色系，靠 margin-left: auto
   贴右对齐，与前面的套餐/有效期徽章保持左对齐的同一行 */
.pa-code-revoke-btn {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 600;
  color: #C92A2A;
  border: 2rpx solid #C92A2A;
  border-radius: 20rpx;
  padding: 4rpx 20rpx;
}

/* 🎨 有效期天数徽章：与套餐 Tag 并排，颜色区分开——套餐是"哪个档位"，
   这个是"多久"，两者信息维度不同，不能用同一套配色混在一起看 */
.pa-duration-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: bold;
  background: #E3F2FD;
  color: #1565C0;
}

.pa-code-redeemed-box {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #E0E0E0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.pa-code-redeemed-row {
  font-size: 22rpx;
  color: #666666;
}

/* 🗑️ 已作废信息盒子：复用 .pa-code-redeemed-box 的布局，仅分隔线换成警示色，
   与上面 .pa-code-status-REVOKED 的红色系呼应 */
.pa-code-revoked-box {
  border-top-color: #FFC9C9;
}

/* 🆕（可视化制卡台账）铸造备注：与 .pa-code-redeemed-row 同一套次要信息文字
   样式，不占用独立信息盒子（备注是可选的轻量信息，不需要分隔线/内边距） */
.pa-code-note {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #868E96;
}

/* ═══════════════════════════════════════════════════════════════
   🦴 骨架屏 / 空状态 / 加载更多：授权码台账、机构列表共用
   ═══════════════════════════════════════════════════════════════ */
.pa-skel-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.pa-skel-bar {
  border-radius: 8rpx;
  background: linear-gradient(90deg, #EEF0F2 25%, #E4E7EB 37%, #EEF0F2 63%);
  background-size: 400% 100%;
  animation: pa-skel-shimmer 1.6s ease-in-out infinite;
}

.pa-skel-bar-lg {
  width: 60%;
  height: 34rpx;
}

.pa-skel-bar-sm {
  width: 30%;
  height: 22rpx;
}

@keyframes pa-skel-shimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

.pa-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 40rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.pa-empty-icon {
  display: block;
  width: 100rpx;
  height: 100rpx;
  line-height: 100rpx;
  font-size: 48rpx;
  text-align: center;
  background: #F4F5F7;
  border-radius: 50%;
  margin-bottom: 20rpx;
}

.pa-empty-title {
  font-size: 28rpx;
  color: #495057;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.pa-empty-sub {
  font-size: 24rpx;
  color: #ADB5BD;
}

.pa-load-more-row {
  text-align: center;
  padding: 20rpx 0;
  font-size: 22rpx;
  color: #ADB5BD;
}

/* ═══════════════════════════════════════════════════════════════
   🌸 底部抽屉（Bottom Sheet）：生成授权码 / 新建机构 / 开通续费三个表单
   共用同一套壳，从底部滑入 + 遮罩淡入，取代此前"内联折叠框硬挤在页面里"
   ═══════════════════════════════════════════════════════════════ */
.pa-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  animation: pa-sheet-fade-in 0.2s ease-out;
}

@keyframes pa-sheet-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.pa-sheet-box {
  width: 100%;
  max-height: 80vh;
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx 32rpx;
  overflow-y: auto;
  animation: pa-sheet-slide-up 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes pa-sheet-slide-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.pa-sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #E0E0E0;
  margin: 0 auto 24rpx;
}

/* 🆕（2026-09-10）顶部标准 × 关闭——替代底部整条 .pa-sheet-actions 操作栏，
   把这部分高度还给内容滚动区 */
.pa-sheet-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

/* 🐛 用 .pa-sheet-title.pa-sheet-title-inline 复合选择器而不是单独一个类——
   两个类挂在同一元素上时，单独的 .pa-sheet-title-inline 与后面才定义的
   .pa-sheet-title 选择器特异度相同，级联顺序会让后者的 margin-bottom 赢，
   复合选择器把特异度提高一级，确保这里的覆盖始终生效 */
.pa-sheet-title.pa-sheet-title-inline {
  margin-bottom: 0;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pa-sheet-close-btn {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #F1F3F5;
  color: #495057;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pa-sheet-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #1C2530;
  margin-bottom: 24rpx;
}

.pa-plan-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.pa-plan-tag {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 26rpx;
  background: #F4F5F7;
  color: #666666;
}

.pa-plan-tag.active {
  background: #1C2530;
  color: #FFD700;
  font-weight: bold;
}

.pa-field-label {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

/* 🐛 底部安全区：改为直接在操作栏自己身上留出"固定间距 + 安全区"，
   与 .pa-sheet-box 后面各自的 .pa-safe-area-spacer 兜底 view 是同一个目的的
   两套实现，保留这一套后已移除 WXML 里那 4 个重复的 spacer view（否则会
   叠加两份安全区高度） */
.pa-sheet-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.pa-btn-cancel {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 1;
  border-radius: 44rpx;
  background: #EDEFF2;
  color: #333333;
  font-size: 28rpx;
}

.pa-btn-cancel::after {
  border: none;
}

.pa-btn-submit {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 1;
  border-radius: 44rpx;
  background: #1C2530;
  color: #FFFFFF;
  font-size: 28rpx;
}

.pa-btn-submit::after {
  border: none;
}

/* ═══════════════════════ 🔍 平台巡检（2026-09-09 平台巡检自助授权） ═══════════════════════ */
.pa-inspect-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.pa-inspect-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1C2530;
  margin-bottom: 12rpx;
}

/* 🆕（2026-09-10 巡检面板体验升级）折叠式安全须知——默认单行，点击展开，
   把原来长段说明文字腾出的首屏空间让给下方三级选择器 */
.pa-inspect-notice {
  background: #FFF8E1;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 20rpx;
}

.pa-inspect-notice-brief {
  display: block;
  font-size: 24rpx;
  color: #8C6D1F;
  font-weight: 600;
}

.pa-inspect-notice-full {
  display: block;
  font-size: 23rpx;
  color: #7A5C10;
  line-height: 1.7;
}

.pa-inspect-notice-collapse {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #B08A2E;
  text-align: right;
}

/* 🆕（2026-09-10）选择路径面包屑——机构 › 门店，同时承担"返回上一级"入口 */
.pa-inspect-path {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.pa-inspect-path-item {
  font-size: 25rpx;
  color: #ADB5BD;
  padding: 6rpx 4rpx;
}

.pa-inspect-path-item.done {
  color: #495057;
  text-decoration: underline;
}

.pa-inspect-path-item.active {
  color: #1C2530;
  font-weight: 700;
}

.pa-inspect-path-sep {
  font-size: 22rpx;
  color: #CED4DA;
}

.pa-inspect-field {
  margin-bottom: 20rpx;
}

.pa-inspect-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #495057;
  margin-bottom: 10rpx;
}

.pa-inspect-input {
  width: 100%;
  height: 76rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
  font-size: 26rpx;
}

/* 🆕（2026-09-10）授权角色改为紧凑 Radio Tag/Card，label 短标签 + desc
   副文本清晰标注权限范围，两列网格布局，比原来的单列长条按钮组更省空间 */
.pa-inspect-role-tags {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.pa-inspect-role-tag {
  padding: 16rpx 18rpx;
  background: #F8F9FA;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.pa-inspect-role-tag.active {
  background: #FFF8E1;
  border-color: #FFD700;
}

.pa-inspect-role-tag-label {
  font-size: 25rpx;
  font-weight: 700;
  color: #495057;
}

.pa-inspect-role-tag.active .pa-inspect-role-tag-label {
  color: #1C2530;
}

.pa-inspect-role-tag-desc {
  font-size: 20rpx;
  color: #ADB5BD;
  line-height: 1.4;
}

.pa-inspect-role-tag.active .pa-inspect-role-tag-desc {
  color: #8C6D1F;
}

.pa-inspect-error {
  display: block;
  font-size: 22rpx;
  color: #E03131;
  margin-bottom: 16rpx;
}

/* 🔍（2026-09-10 巡检两级选择器 + 一键回收）*/
.pa-inspect-picker-loading {
  padding: 32rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #868E96;
}

.pa-inspect-picker-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.pa-inspect-picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 22rpx;
  background: #F8F9FA;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
}

.pa-inspect-picker-row.active {
  background: #FFF8E1;
  border-color: #FFD700;
}

.pa-inspect-picker-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.pa-inspect-picker-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1C2530;
}

.pa-inspect-picker-meta {
  font-size: 22rpx;
  color: #868E96;
}

.pa-inspect-picker-arrow {
  font-size: 24rpx;
  color: #CED4DA;
}

.pa-inspect-picker-check {
  font-size: 28rpx;
  font-weight: 700;
  color: #8C1D18;
}

.pa-inspect-grants-card {
  margin-top: 24rpx;
}

/* 🆕（2026-09-10 排版重构）纵向三段式：标题（门店名+短 ID）→ 横排标签
   （角色/机构/倒计时）→ 右对齐操作按钮。此前用左右两栏 flex 挤压布局，
   门店名/角色/机构/倒计时四段文字全部塞进左侧窄列，在真机上挤成竖排换行；
   改为整行纵向堆叠后，标签行单独用 flex-wrap 横排，不再和按钮抢宽度 */
.pa-inspect-grant-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #F1F3F5;
}

.pa-inspect-grant-row:last-child {
  border-bottom: none;
}

.pa-inspect-grant-store {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1C2530;
}

/* 🆕 短哈希 ID——仅供技术排障核对用，小号浅灰字，不再是标题行的主要信息 */
.pa-inspect-grant-store-id {
  display: block;
  font-size: 20rpx;
  color: #ADB5BD;
  margin-top: -4rpx;
}

.pa-inspect-grant-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.pa-inspect-grant-tag {
  font-size: 21rpx;
  color: #495057;
  background: #F1F3F5;
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  line-height: 1.6;
}

/* 🆕（2026-09-10）剩余有效时间倒计时 Tag——正常态用品牌金色强调，已过期态
   转灰，与"沙盒隔离/未生效"的视觉语义保持一致，不用红色制造不必要的紧张感 */
.pa-inspect-grant-tag.countdown {
  color: #B08A2E;
  background: #FFF8E1;
  font-weight: 600;
}

.pa-inspect-grant-tag.expired {
  color: #ADB5BD;
}

.pa-inspect-grant-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 2rpx;
}

/* 🆕 操作按钮不再复用通用 .pa-btn-small（flex:1 撑满整行宽度）——这里需要
   紧凑、按内容宽度自适应、靠右对齐的一对按钮 */
.pa-inspect-grant-btn {
  flex: none;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 28rpx;
  margin: 0;
  line-height: 1;
  border-radius: 30rpx;
  font-size: 23rpx;
}

.pa-inspect-grant-btn::after {
  border: none;
}

/* 🎨 与导航栏统一的品牌深红实心按钮——分包内"确认/进入"类主操作的既定配色 */
.pa-inspect-grant-btn-enter {
  background: #8C1D18;
  color: #FFFFFF;
}

/* 🎨 浅灰底 + 浅红描边——次要操作，视觉权重明显低于左侧的"直接进入" */
.pa-inspect-grant-btn-revoke {
  background: #FFF5F5;
  color: #C92A2A;
  border: 2rpx solid #FFC9C9;
}

.pa-inspect-grants-empty {
  padding: 32rpx 0;
  text-align: center;
}

.pa-inspect-grants-empty text {
  font-size: 24rpx;
  color: #ADB5BD;
}

/* 🆕（2026-09-10）吸底浮动主操作按钮——选中门店后出现，独立于 pa-content
   滚动容器之外，position:fixed 悬浮于安全区之上，副标题提示门店+角色权限，
   loading 态防重复点击 */
.pa-inspect-sticky-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, #FFFFFF 70%, rgba(255, 255, 255, 0));
}

.pa-inspect-sticky-btn {
  width: 100%;
  height: 108rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 1.3;
  border-radius: 54rpx;
  background: #1C2530;
  box-shadow: 0 6rpx 20rpx rgba(28, 37, 48, 0.25);
}

.pa-inspect-sticky-btn::after {
  border: none;
}

.pa-inspect-sticky-btn-main {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.pa-inspect-sticky-btn-sub {
  font-size: 21rpx;
  color: #C7CDD4;
  margin-top: 4rpx;
}
