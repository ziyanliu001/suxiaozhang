<view class="sm-page">

  <navigation-bar
    title="门店管理"
    background="#8C1D18"
    color="#FFFFFF"
    dark="{{true}}"
    back="{{true}}"
    showHomeButton="auto"
    bind:layout="onNavLayout"
  ></navigation-bar>

  <!-- 🐛 2026-09-06 修复：margin-top 不再叠加 navigation-bar 已占用的
       totalHeight，只留 24rpx 呼吸边距；height calc 里的 contentTop 不动 -->
  <view class="sm-loading-state" wx:if="{{!checkedAccess}}" style="margin-top: 24rpx;">
    <text>校验身份中...</text>
  </view>

  <view class="sm-denied-state" wx:if="{{checkedAccess && !isSuperAdmin}}" style="margin-top: 24rpx;">
    <text class="sm-denied-icon">🏠</text>
    <text class="sm-denied-title">暂未分配门店</text>
    <text class="sm-denied-sub">您的账号尚未分配所属门店，请联络您的团队负责人或店长将您加入门店。</text>
    <button class="sm-denied-btn" bindtap="goBack">返回首页</button>
  </view>

  <view class="sm-body" wx:if="{{checkedAccess && isSuperAdmin}}" style="margin-top: 24rpx; height: calc(100vh - {{contentTop}}px);">

    <!-- 已激活 / 待审核 Tab -->
    <view class="sm-tab-bar">
      <view class="sm-tab-item {{activeTab === 'active' ? 'active' : ''}}" data-tab="active" bindtap="onSwitchTab">
        已激活
      </view>
      <view class="sm-tab-item {{activeTab === 'pending' ? 'active' : ''}}" data-tab="pending" bindtap="onSwitchTab">
        待审核
        <text class="sm-tab-badge" wx:if="{{pendingList.length > 0}}">{{pendingList.length}}</text>
      </view>
    </view>

    <!-- 🛡️ 异常账目风控预警汇总条：呼叫 getRiskAlerts 云函数按门店逐个查询后在此汇总，
         漏登日报/支出异常两类信号见 loadRiskBadges() -->
    <view class="sm-risk-summary-bar" wx:if="{{activeTab === 'active' && riskAlertStoreCount > 0}}">
      <text class="sm-risk-summary-icon">⚠️</text>
      <text class="sm-risk-summary-text">{{riskAlertStoreCount}} 家门店存在风控预警，请留意下方标签</text>
    </view>

    <!-- ===== 已激活门店 ===== -->
    <scroll-view scroll-y show-scrollbar="{{false}}" class="sm-content" wx:if="{{activeTab === 'active'}}">

      <!-- 🏛️（2026-09-06 治理）机构级通用通告：本页没有"单店视角/全国总览视角"
           的切换（那是首页 index.ts 的概念，本页恒定展示全部门店），此前那句
           "仅在超管切换到'全国总览'视角时展示"是描述一个本页不存在的状态，纯属
           误导性开发态提示，已删除。改用真实可判断的数据——机构名下门店数 >1
           （真正的多店/全国连锁）才展示这张机构通用公告；只有 1 家或 0 家门店
           时，机构级公告与该店自己的专属公告是同一件事，折叠隐藏，统一走下方
           每张 .sm-store-card 已有的"📢 编辑通告"入口，不制造两个语义重叠的
           公告入口 -->
      <view class="sm-overview-notice-card" wx:if="{{list.length > 1}}">
        <view class="sm-store-header-row">
          <text class="sm-store-name">🌐 全国总览公告</text>
        </view>
        <view class="sm-store-actions">
          <button class="sm-btn-action" bindtap="onOpenOverviewNotice">📢 编辑通告</button>
        </view>
      </view>

      <!-- 🏛️（2026-09-06 空态升级）图标 + 主标题 + 副标题三段式，参照
           daily-menu.wxml/activity-log.wxml 已有的空态惯例 -->
      <view class="sm-empty-state" wx:if="{{!loading && list.length === 0}}">
        <text class="sm-empty-icon">🏛️</text>
        <text class="sm-empty-title">暂未收录运营中的爱心门店</text>
        <text class="sm-empty-sub">创建属于您的互助食堂或斋堂，开启日常流水记账与阳光公示</text>
      </view>

      <view class="sm-store-card {{item.status === 'inactive' ? 'inactive' : ''}}" wx:for="{{list}}" wx:key="storeId">
        <view class="sm-store-header-row">
          <text class="sm-store-name">{{item.storeName}}</text>
          <text class="sm-status-badge {{item.status === 'inactive' ? 'inactive' : 'active'}}">
            {{item.status === 'inactive' ? '已停用' : '已激活'}}
          </text>
        </view>

        <view class="sm-risk-row" wx:if="{{item.riskMissingReport || item.riskExpenseWarning}}">
          <text class="sm-risk-tag danger" wx:if="{{item.riskMissingReport}}">
            ⚠️ 待补登日报{{item.riskDaysSinceLastReport ? '（' + item.riskDaysSinceLastReport + '天未提交）' : ''}}
          </text>
          <text class="sm-risk-tag warning" wx:if="{{item.riskExpenseWarning}}">⚠️ 支出异常，请复核凭证</text>
        </view>

        <view class="sm-store-actions">
          <!-- 🏛️（2026-09-09 超管全国总览工作台重构）直达门店档案/资质公示/组织配置——
               store-profile.ts 已支持超管跨店切换（commit 8f3dec9），这里直接带上
               本行 storeId/storeName 跳转，免去进页后再手动切一次店 -->
          <button class="sm-btn-action" data-storeid="{{item.storeId}}" data-storename="{{item.storeName}}" bindtap="onGoToStoreProfile">📋 门店档案</button>
          <button class="sm-btn-action" data-storeid="{{item.storeId}}" data-storename="{{item.storeName}}" bindtap="onGoToGenerateCode">🔑 生成邀请码</button>
          <button class="sm-btn-action" data-storeid="{{item.storeId}}" data-storename="{{item.storeName}}" bindtap="onOpenRename">✏️ 编辑名称</button>
          <button class="sm-btn-action" data-storeid="{{item.storeId}}" data-storename="{{item.storeName}}" bindtap="onViewStoreStaff">👥 查看门店人员</button>
          <button class="sm-btn-action" data-storeid="{{item.storeId}}" data-storename="{{item.storeName}}" bindtap="onOpenStoreNotice">📢 编辑通告</button>
          <button class="sm-btn-action" data-storeid="{{item.storeId}}" data-storename="{{item.storeName}}" data-address="{{item.address}}" bindtap="onGenerateStorePoster">🎨 生成宣传海报</button>
          <button
            class="sm-btn-action {{item.status === 'inactive' ? 'sm-btn-activate' : 'sm-btn-deactivate'}}"
            data-storeid="{{item.storeId}}"
            data-storename="{{item.storeName}}"
            data-status="{{item.status || 'active'}}"
            bindtap="onToggleStoreStatus"
          >
            {{item.status === 'inactive' ? '▶️ 启用门店' : '⏸️ 停用门店'}}
          </button>
        </view>
      </view>

    </scroll-view>

    <!-- ===== 待审核门店申请 ===== -->
    <scroll-view scroll-y show-scrollbar="{{false}}" class="sm-content" wx:if="{{activeTab === 'pending'}}">

      <view class="sm-pending-loading" wx:if="{{pendingLoading}}">
        <text>加载中...</text>
      </view>

      <view class="sm-empty-state" wx:if="{{!pendingLoading && pendingList.length === 0}}">
        <text>暂无待审核的新建门店申请</text>
      </view>

      <view class="sm-pending-card" wx:for="{{pendingList}}" wx:key="_id">
        <view class="sm-pending-name">{{item.customStoreName || item.storeName}}</view>
        <view class="sm-pending-meta">申请人：{{item.applicantName || '未填写'}}</view>
        <view class="sm-pending-meta">申请时间：{{item.applyTimeStr || '近期'}}</view>
        <button
          class="sm-btn-approve"
          data-id="{{item._id}}"
          bindtap="onApproveStoreRequest"
          disabled="{{approvingId === item._id}}"
          loading="{{approvingId === item._id}}"
        >
          ✅ 一键通过审核
        </button>
      </view>

    </scroll-view>

    <!-- 🏛️（2026-09-06 布局重构）"创建新门店"原来有两个互斥渲染的按钮
         （列表非空时的表头按钮 + 空状态内嵌按钮），且空状态内文案与按钮同为
         内联级盒子兄弟节点，靠 margin-top 撑开垂直间距在内联布局下不可靠，
         真机上会出现"文案与按钮重叠"。改为唯一一个持久可见的吸底操作栏，
         只在"已激活门店" tab 显示——不再依赖 list.length 分支，也消除了
         重复入口。.sm-content 已统一预留 padding-bottom 避免遮挡列表最后一项 -->
    <view class="sm-bottom-bar" wx:if="{{activeTab === 'active'}}">
      <button class="sm-btn-create" hover-class="sm-btn-create-hover" bindtap="onOpenCreateStore">➕ 创建新门店</button>
    </view>

  </view>

  <!-- 重命名弹窗 -->
  <view class="sm-modal-mask" wx:if="{{showRenameModal}}" bindtap="onCloseRename">
    <view class="sm-modal-box" catchtap="stopPropagation">
      <text class="sm-modal-title">修改门店名称</text>

      <text class="sm-form-label">当前名称：{{renameForm.oldName}}</text>
      <input class="sm-modal-input" type="text" placeholder="请输入新的标准门店名称" value="{{renameForm.newName}}" bindinput="onRenameInput" />

      <view class="sm-modal-actions">
        <button class="sm-btn-cancel" bindtap="onCloseRename">取消</button>
        <button class="sm-btn-submit" bindtap="onSubmitRename" disabled="{{submitting}}">确认修改</button>
      </view>
    </view>
  </view>

  <!-- 创建新门店弹窗 -->
  <view class="sm-modal-mask" wx:if="{{showCreateModal}}" bindtap="onCloseCreateStore">
    <view class="sm-modal-box" catchtap="stopPropagation">
      <text class="sm-modal-title">创建新门店</text>

      <text class="sm-form-label">门店名称</text>
      <input class="sm-modal-input" type="text" placeholder="请输入门店名称" value="{{createForm.storeName}}" data-field="storeName" bindinput="onCreateFormInput" />

      <text class="sm-form-label">门店地址</text>
      <input class="sm-modal-input" type="text" placeholder="请输入门店地址（选填）" value="{{createForm.address}}" data-field="address" bindinput="onCreateFormInput" />

      <text class="sm-form-label">省份（选填，用于门店选择器省市筛选）</text>
      <input class="sm-modal-input" type="text" placeholder="如：福建省" value="{{createForm.province}}" data-field="province" bindinput="onCreateFormInput" />

      <text class="sm-form-label">门店位置（选填，用于"附近门店"距离排序）</text>
      <view class="sm-location-picker-btn" bindtap="onChooseStoreLocation">
        <text>{{createForm.locationLabel || '📍 点击选择门店位置'}}</text>
      </view>

      <text class="sm-form-label">运营状态</text>
      <view class="sm-operating-status-row">
        <view class="sm-status-pill {{createForm.operatingStatus === 'operating' ? 'active' : ''}}" bindtap="onSelectCreateOperatingStatus" data-value="operating">运营中</view>
        <view class="sm-status-pill {{createForm.operatingStatus === 'preparing' ? 'active' : ''}}" bindtap="onSelectCreateOperatingStatus" data-value="preparing">筹备中</view>
        <view class="sm-status-pill {{createForm.operatingStatus === 'paused' ? 'active' : ''}}" bindtap="onSelectCreateOperatingStatus" data-value="paused">暂停运营</view>
      </view>

      <text class="sm-form-label">初始公告</text>
      <textarea class="sm-modal-textarea" placeholder="如：三源弘志愿者之家试营业" value="{{createForm.announcement}}" data-field="announcement" bindinput="onCreateFormInput" maxlength="200" />

      <view class="sm-modal-actions">
        <button class="sm-btn-cancel" bindtap="onCloseCreateStore">取消</button>
        <button class="sm-btn-submit" bindtap="onSubmitCreateStore" disabled="{{creating}}">确认创建</button>
      </view>
    </view>
  </view>

  <!-- 查看门店人员弹窗 -->
  <view class="sm-modal-mask" wx:if="{{showStaffModal}}" bindtap="onCloseStaffModal">
    <view class="sm-modal-box" catchtap="stopPropagation">
      <text class="sm-modal-title">{{staffStoreName}} · 门店人员</text>

      <view class="sm-staff-loading" wx:if="{{staffLoading}}">
        <text>加载中...</text>
      </view>

      <view class="sm-staff-empty" wx:if="{{!staffLoading && staffList.length === 0}}">
        <text>该门店暂无已绑定的店长/财务</text>
      </view>

      <scroll-view scroll-y show-scrollbar="{{false}}" class="sm-staff-list" wx:if="{{!staffLoading && staffList.length > 0}}">
        <view class="sm-staff-item" wx:for="{{staffList}}" wx:key="_id">
          <text class="sm-staff-role-tag">{{item.roleLabel}}</text>
          <text class="sm-staff-name">{{item.applicantName || item.nickName || '未填写姓名'}}</text>
        </view>
        <view class="fa-safe-area-spacer"></view>
      </scroll-view>

      <view class="sm-modal-actions">
        <button class="sm-btn-cancel" bindtap="onCloseStaffModal">关闭</button>
      </view>
    </view>
  </view>

  <!-- 编辑通告弹窗：门店专属 / 全国总览共用 -->
  <view class="sm-modal-mask" wx:if="{{showNoticeModal}}" bindtap="onCloseNoticeModal">
    <view class="sm-modal-box" catchtap="stopPropagation">
      <text class="sm-modal-title">{{noticeForm.scopeLabel}} · 编辑通告</text>

      <view class="sm-notice-loading" wx:if="{{noticeLoading}}">
        <text>加载中...</text>
      </view>

      <block wx:if="{{!noticeLoading}}">
        <text class="sm-form-label">标签</text>
        <input class="sm-modal-input" type="text" placeholder="如：喜讯通报 / 开业公告" value="{{noticeForm.tag}}" bindinput="onNoticeTagInput" />

        <text class="sm-form-label">标题</text>
        <input class="sm-modal-input" type="text" placeholder="请输入通告标题" value="{{noticeForm.title}}" bindinput="onNoticeTitleInput" />

        <text class="sm-form-label">内容</text>
        <textarea class="sm-modal-textarea" placeholder="请输入通告内容" value="{{noticeForm.content}}" bindinput="onNoticeContentInput" maxlength="200" />

        <view class="sm-modal-actions">
          <button class="sm-btn-cancel" bindtap="onCloseNoticeModal">取消</button>
          <button class="sm-btn-submit" bindtap="onSubmitNotice" disabled="{{noticeSubmitting}}">{{noticeForm.id ? '保存修改' : '发布通告'}}</button>
        </view>
      </block>
    </view>
  </view>

  <!-- 🎨 门店宣传/招募海报预览弹窗：复用 drawStoreInvitationPoster（首页「生成门店海报」同一份绘制函数） -->
  <view class="sm-modal-mask" wx:if="{{showStorePosterModal}}" bindtap="onCloseStorePosterModal">
    <view class="sm-modal-box sm-poster-modal-box" catchtap="stopPropagation">
      <text class="sm-modal-title">{{posterStoreName}} · 宣传海报</text>

      <view class="sm-poster-canvas-wrapper">
        <canvas type="2d" id="storePosterCanvas" class="sm-poster-canvas" style="width: 320px; height: 540px;"></canvas>
      </view>

      <view class="sm-modal-actions">
        <button class="sm-btn-cancel" bindtap="onCloseStorePosterModal">关闭</button>
        <button class="sm-btn-submit" bindtap="onSaveStorePosterToPhotos" disabled="{{!storePosterTempFilePath}}" loading="{{generatingStorePoster}}">保存到相册</button>
      </view>
    </view>
  </view>

</view>
