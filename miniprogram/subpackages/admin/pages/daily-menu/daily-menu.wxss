.dm-page {
  min-height: 100vh;
  background: #F8F5F0;
}

.dm-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  height: 88rpx;
  background: #8C1D18;
}

.dm-nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.dm-nav-back-hover {
  opacity: 0.5;
}

.dm-nav-title {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
}

.dm-nav-action {
  color: #FFFFFF;
  font-size: 26rpx;
  width: 110rpx;
  text-align: right;
}

.dm-nav-action.hidden {
  visibility: hidden;
}

.dm-list-scroll {
  height: calc(100vh - 88rpx);
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  /* 🛡️ 底部固定的"生成食谱宣传海报"按钮栏自身约 128rpx 高，这里预留足够的
     滚动内容底部间距，避免最后一条历史食谱被吸底按钮遮挡 */
  padding-bottom: calc(148rpx + env(safe-area-inset-bottom));
}

.dm-store-tip {
  font-size: 24rpx;
  color: #8C1D18;
  margin-bottom: 16rpx;
}

/* 🛡️ 门店身份异步解析完成前的骨架占位：避免 currentStoreName 到达前的那一帧
   默认回退显示任何门店名/全国总览，见 daily-menu.ts applyRolePermissions */
.dm-store-tip-skeleton {
  width: 200rpx;
  height: 28rpx;
  border-radius: 6rpx;
  background: #EFE6D8;
  margin-bottom: 16rpx;
}

.dm-section-divider {
  display: flex;
  align-items: center;
  margin: 8rpx 4rpx 16rpx 4rpx;
}

.dm-divider-icon {
  font-size: 20rpx;
  margin-right: 8rpx;
}

.dm-divider-txt {
  font-size: 28rpx;
  font-weight: bold;
  color: #8C1D18;
}

.dm-today-card {
  background: linear-gradient(135deg, #FFFDFB 0%, #FFF8F0 100%);
  border: 1.5rpx solid #FFD3BE;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(140, 29, 24, 0.06);
}

/* 📅 日期导航：◀ 上一天 / 下一天 ▶ + 日历 picker，与三段式餐别切换共同构成
   本次新增的"当前查看/管理哪一天哪一餐"入口，视觉上做成今日食谱卡片内的一个
   独立分区，与卡片下方内容用留白分开 */
.dm-date-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.dm-date-nav-arrow {
  font-size: 24rpx;
  color: #8C1D18;
  padding: 6rpx 12rpx;
}

.dm-date-nav-picker {
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
  min-width: 180rpx;
  text-align: center;
}

/* 🍚 餐别切换：三段式分段控件，选中态用品牌红底白字，未选中态浅灰背景，
   与 .dm-form-picker/.dm-action-btn 已有的视觉语言保持一致 */
.dm-meal-switcher {
  display: flex;
  background: #F8F5F0;
  border-radius: 12rpx;
  padding: 4rpx;
  margin-bottom: 20rpx;
}

.dm-meal-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #8C1D18;
  padding: 12rpx 0;
  border-radius: 10rpx;
}

.dm-meal-tab.active {
  background: #8C1D18;
  color: #FFFFFF;
  font-weight: bold;
}

/* 🍱 今日食谱顶部：左侧日期+餐次，右侧管理员轻量化 [修改][删除] 按钮组 */
.dm-today-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.dm-today-top-left {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}

.dm-today-date {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.dm-today-tag {
  font-size: 22rpx;
  color: #8C1D18;
  background: #FFF0E6;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  flex-shrink: 0;
}

.dm-today-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
}

.dm-action-btn {
  font-size: 24rpx;
  color: #8C1D18;
}

.dm-action-btn-delete {
  color: #C62828;
}

.dm-today-note {
  display: block;
  font-size: 26rpx;
  color: #444444;
  line-height: 1.6;
  white-space: pre-wrap;
  margin-bottom: 16rpx;
}

.dm-today-empty-txt {
  display: block;
  color: #999999;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

/* 🍱 未发布状态主行动区：主 CTA【+ 立即发布该日食谱】+ 次要辅助按钮
   【引用历史食谱】，替代此前不起眼的纯文字"发布食谱"链接 */
.dm-publish-cta-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.dm-btn-publish-primary {
  background: #8C1D18;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 12rpx;
}

.dm-btn-reuse-template {
  background: #FFF5F0;
  color: #8C1D18;
  border: 1.5rpx solid #FFD3BE;
  font-size: 26rpx;
  border-radius: 12rpx;
}

.dm-btn-publish-primary::after,
.dm-btn-reuse-template::after {
  border: none;
}

/* 🌟 发布冲突提示：今日已存在食谱时，展示发布人与时间，弱化视觉不抢主标题 */
.dm-publish-meta {
  display: block;
  font-size: 20rpx;
  color: #999999;
  margin-top: -4rpx;
  margin-bottom: 8rpx;
}

/* 🙏 餐前感恩词：默认折叠的轻柔提示条，不与上方食谱内容抢视觉重量 */
.dm-gratitude-block {
  margin-top: 8rpx;
  border-top: 1rpx dashed #F1E4D8;
  padding-top: 16rpx;
}

.dm-gratitude-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dm-gratitude-title {
  font-size: 24rpx;
  color: #B45309;
  font-weight: bold;
}

.dm-gratitude-arrow {
  font-size: 22rpx;
  color: #C2853D;
  transition: transform 0.2s ease;
}

.dm-gratitude-arrow.rotate {
  transform: rotate(180deg);
}

.dm-gratitude-body {
  margin-top: 12rpx;
  background: #FFF9F0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.dm-gratitude-line {
  display: block;
  font-size: 24rpx;
  line-height: 1.8;
  color: #5C4326;
}

.dm-menu-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(140, 29, 24, 0.06);
}

.dm-card-date {
  font-size: 28rpx;
  font-weight: bold;
  color: #8C1D18;
  margin-bottom: 16rpx;
}

/* 🍱 标准九宫格菜品卡片：3 列流式网格，每张卡片 = 上层实拍图（1:1 圆角方图）+
   下层居中粗体菜名，今日食谱/历史食谱/详情弹窗三处复用同一套样式 */
.dm-dish-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.dm-dish-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.dm-dish-img-wrap {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  border-radius: 12rpx;
  overflow: hidden;
  background: #F0F0F0;
}

.dm-dish-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.dm-dish-name {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 🥬 默认素食占位图：菜品缺少实拍图时的兜底展示，与"加载失败"态（⚠️ 可点重试）
   区分开——这里是"根本没有图"，不提供重试操作 */
.dm-dish-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  background: #F0F7ED;
  border-radius: 12rpx;
}

.dm-dish-placeholder-lg {
  position: static;
  height: 320rpx;
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

/* 🛡️ 缩略图加载失败兜底：<image> binderror 时切换成这个占位块，而不是放任小程序
   原生裂图图标晾在原地；点击可重试，覆盖今日食谱/历史食谱/编辑表单三处图片网格 */
.thumb-load-failed {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border-radius: 12rpx;
  background: #F5F5F5;
  border: 1.5rpx dashed #D9D9D9;
}

.thumb-load-failed-icon {
  font-size: 28rpx;
  line-height: 1;
}

.thumb-load-failed-text {
  font-size: 18rpx;
  color: #999999;
}

.dm-card-text {
  font-size: 26rpx;
  color: #555555;
  line-height: 1.6;
  white-space: pre-wrap;
}

.dm-card-footer {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0EAE2;
}

.dm-btn-reuse {
  font-size: 24rpx;
  font-weight: bold;
  color: #8C1D18;
  background: #FFF5F0;
  border: 1.5rpx solid #FFD3BE;
  border-radius: 32rpx;
  padding: 12rpx 0;
  line-height: 1.4;
}

.dm-btn-reuse::after {
  border: none;
}

/* 📖 历史食谱空状态：与 statistics.wxss .smart-empty-card 同款白底圆角卡片 +
   阴影 + 居中大图标，保持与全局其它空状态视觉一致，不再用一套裸文字堆叠 */
.dm-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  margin: 8rpx 0 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.dm-empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.dm-empty-title {
  font-size: 28rpx;
  color: #495057;
  font-weight: 500;
  text-align: center;
  margin-bottom: 12rpx;
}

.dm-empty-suggest {
  font-size: 24rpx;
  color: #868E96;
  text-align: center;
}

.dm-loading-more,
.dm-no-more {
  text-align: center;
  padding: 24rpx 0;
  font-size: 22rpx;
  color: #999999;
}

.dm-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.dm-detail-box,
.dm-edit-box {
  width: 100%;
  max-height: 85vh;
  background: #FFFFFF;
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  padding: 28rpx;
  /* 底部安全区：防止操作按钮贴近 Home Indicator */
  padding-bottom: calc(28rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  /* 顶部安全区：85vh 时顶部可能进入刘海区 */
  padding-top: calc(28rpx + constant(safe-area-inset-top));
  padding-top: calc(28rpx + env(safe-area-inset-top));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.dm-detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #EFE6D8;
  margin-bottom: 20rpx;
}

.dm-detail-date {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.dm-detail-close {
  font-size: 32rpx;
  color: #999999;
}

.dm-detail-scroll {
  max-height: 60vh;
}

.dm-detail-dish {
  margin-bottom: 24rpx;
}

.dm-detail-img {
  width: 100%;
  border-radius: 12rpx;
  display: block;
}

.dm-detail-dish-name {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  text-align: center;
}

.dm-detail-text {
  font-size: 28rpx;
  color: #444444;
  line-height: 1.8;
  white-space: pre-wrap;
}

.dm-detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #EFE6D8;
}

.dm-btn-edit,
.dm-btn-delete {
  flex: 1;
  font-size: 26rpx;
}

.dm-btn-edit {
  background: #F8F5F0;
  color: #8C1D18;
}

.dm-btn-delete {
  background: #FBE9E7;
  color: #C62828;
}

.dm-edit-scroll {
  max-height: 62vh;
}

.dm-form-label {
  display: block;
  font-size: 24rpx;
  color: #666666;
  font-weight: bold;
  margin-bottom: 12rpx;
  margin-top: 20rpx;
}

.dm-form-picker,
.dm-form-textarea {
  background: #F8F9FA;
  border: 1.5rpx solid #EFE6D8;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  color: #333333;
  box-sizing: border-box;
  width: 100%;
}

.dm-form-textarea {
  min-height: 160rpx;
}

/* 🍚 编辑表单里的餐别展示：只读，不可在编辑中途切换餐别（切餐别请回到顶部
   分段控件），浅灰文字与可编辑的 .dm-form-picker 区分开 */
.dm-form-picker-readonly {
  color: #999999;
  background: #F1F1EE;
}

/* 微信标准九宫格：与上方 .dm-dish-grid 展示态同款布局（CSS Grid 三列 + padding-bottom
   撑开正方形），保证编辑态的上传网格和发布后的展示网格视觉完全一致；每个格子下方
   多一行菜名输入框，用于给这道菜命名 */
.dm-image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx 16rpx;
}

.dm-image-item {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.dm-image-thumb-wrap {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  border-radius: 12rpx;
  overflow: visible;
}

.dm-image-thumb {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background: #F0F0F0;
}

.dm-dish-name-input {
  margin-top: 8rpx;
  height: 52rpx;
  line-height: 52rpx;
  font-size: 22rpx;
  color: #333333;
  text-align: center;
  background: #F8F9FA;
  border: 1.5rpx solid #EFE6D8;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.dm-image-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: #E03131;
  color: #FFFFFF;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: bold;
  box-shadow: 0 2rpx 6rpx rgba(224, 49, 49, 0.4);
  z-index: 1;
}

.dm-image-add {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1.5rpx dashed #C9B8A0;
  border-radius: 12rpx;
}

.dm-image-add text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 22rpx;
  color: #999999;
  white-space: nowrap;
}

.dm-submit-btn {
  background: #8C1D18;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  margin-top: 24rpx;
}

/* 📤 页面底部固定栏：生成食谱宣传海报，补充 safe-area 底部适配 */
.dm-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -6rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 99;
}

.dm-btn-poster {
  background: #8C1D18;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
}

.dm-btn-poster[disabled] {
  background: #E0D5C8;
  color: #FFFFFF;
}

.dm-poster-box {
  width: 100%;
  max-height: 85vh;
  background: #FFFFFF;
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  padding: 28rpx;
  /* 底部安全区：防止保存/分享按钮贴近 Home Indicator */
  padding-bottom: calc(28rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  /* 顶部安全区：85vh 时顶部可能进入刘海区 */
  padding-top: calc(28rpx + constant(safe-area-inset-top));
  padding-top: calc(28rpx + env(safe-area-inset-top));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.dm-poster-canvas-wrapper {
  max-height: 60vh;
  display: flex;
  justify-content: center;
}

.dm-poster-canvas {
  margin: 0 auto;
}

.dm-poster-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #EFE6D8;
}

.dm-btn-poster-save,
.dm-btn-poster-share {
  flex: 1;
  font-size: 26rpx;
}

.dm-btn-poster-save {
  background: #8C1D18;
  color: #FFFFFF;
}

.dm-btn-poster-share {
  background: #F8F5F0;
  color: #8C1D18;
}

/* 📖 引用历史食谱弹窗：复用 .dm-detail-box 弹窗壳，列表项样式与 .dm-menu-card
   同一套卡片语言，但更紧凑（一行日期 + 一行摘要），适合快速扫视挑选 */
.dm-reuse-template-scroll {
  max-height: 60vh;
}

.dm-reuse-template-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0EAE2;
}

.dm-reuse-template-item:last-child {
  border-bottom: none;
}

.dm-reuse-template-item:active {
  opacity: 0.6;
}

.dm-reuse-template-date {
  font-size: 28rpx;
  font-weight: bold;
  color: #8C1D18;
  margin-bottom: 6rpx;
}

.dm-reuse-template-preview {
  font-size: 24rpx;
  color: #666666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
