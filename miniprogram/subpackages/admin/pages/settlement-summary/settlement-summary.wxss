.ss-page {
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  box-sizing: border-box;
  background: #F8F5F0;
}

.ss-body {
  padding: 24rpx;
  box-sizing: border-box;
}

.ss-loading-state,
.ss-error-state,
.ss-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  color: #8E8E93;
  font-size: 28rpx;
}

.ss-error-icon,
.ss-empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.ss-error-text,
.ss-empty-text {
  margin-bottom: 24rpx;
  text-align: center;
}

.ss-retry-btn {
  font-size: 28rpx;
  background: #8C1D18;
  color: #FFFFFF;
  padding: 0 40rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
}

/* 🐛 高度改由 wxml 内联 style 用 contentTop 动态计算（见 <navigation-bar>
   共享组件迁移记录），不再用写死的 176rpx 猜测导航栏高度 */

.ss-ops-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.ss-ops-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.ss-section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.ss-ops-range-tabs {
  display: flex;
  background: #F0EBE3;
  border-radius: 10rpx;
  padding: 4rpx;
}

.ss-ops-range-tab {
  font-size: 22rpx;
  color: #8E8E93;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
}

.ss-ops-range-tab.active {
  background: #8C1D18;
  color: #FFFFFF;
  font-weight: 600;
}

.ss-ops-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.ss-ops-tile {
  min-width: 0;
  min-height: 128rpx;
  background: #F8F5F0;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.ss-ops-tile-value {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #8C1D18;
  margin-bottom: 8rpx;
}

.ss-ops-tile-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #8C1D18;
  margin-left: 4rpx;
}

.ss-ops-tile-label {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
  word-break: break-word;
}

.ss-summary-cards {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.ss-summary-card {
  flex: 1;
  min-width: 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border-top: 6rpx solid #D8CFC7;
}

.ss-card-unsettled {
  border-top-color: #C77B2E;
}

.ss-card-settled {
  border-top-color: #2E7D32;
}

.ss-card-voided {
  border-top-color: #8E8E93;
}

.ss-card-title {
  font-size: 24rpx;
  color: #8E8E93;
  margin-bottom: 8rpx;
}

.ss-card-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-bottom: 8rpx;
}

.ss-card-sub {
  font-size: 20rpx;
  color: #ADADB2;
}

.ss-detail-list {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx 24rpx 24rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.ss-detail-header {
  font-size: 26rpx;
  font-weight: 600;
  color: #8E8E93;
  padding: 16rpx 0;
}

/* 🏛️（护城河三 M2）导出对账入口 + 批量确认结算工具条 */
.ss-detail-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ss-export-btn {
  font-size: 22rpx;
  line-height: 52rpx;
  padding: 0 20rpx;
  margin: 0;
  background: #F0EBE3;
  color: #8C1D18;
  border-radius: 24rpx;
}

.ss-export-btn::after {
  border: none;
}

.ss-batch-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F8F5F0;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 12rpx;
}

.ss-batch-toolbar-links {
  display: flex;
  gap: 20rpx;
}

.ss-batch-link {
  font-size: 22rpx;
  color: #8C1D18;
  text-decoration: underline;
}

.ss-batch-confirm-btn {
  font-size: 22rpx;
  line-height: 52rpx;
  padding: 0 20rpx;
  margin: 0;
  background: #8C1D18;
  color: #FFFFFF;
  border-radius: 24rpx;
}

.ss-batch-confirm-btn::after {
  border: none;
}

.ss-batch-confirm-btn[disabled] {
  background: #D8CFC7;
  color: #FFFFFF;
  opacity: 1;
}

.ss-detail-order-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.ss-detail-checkbox {
  transform: scale(0.75);
  margin-right: -4rpx;
}

/* 🏛️（护城河三 M2）导出核对弹窗——复用 .ss-pledge-modal-* 半屏卡片视觉语言 */
.ss-export-summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.ss-export-summary-item {
  background: #F8F5F0;
  border-radius: 10rpx;
  padding: 16rpx;
}

.ss-export-summary-label {
  display: block;
  font-size: 20rpx;
  color: #8E8E93;
  margin-bottom: 6rpx;
}

.ss-export-summary-value {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.ss-export-anomaly-hint {
  font-size: 22rpx;
  color: #E03131;
  background: rgba(224, 49, 49, 0.08);
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
}

.ss-export-preview-list {
  max-height: 400rpx;
  border: 2rpx solid #F0EBE3;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.ss-export-preview-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #F0EBE3;
}

.ss-export-preview-order {
  font-size: 24rpx;
  color: #1C1C1E;
}

.ss-export-preview-order.anomaly {
  color: #E03131;
  font-weight: 700;
}

.ss-export-preview-amount {
  font-size: 24rpx;
  color: #8E8E93;
}

.ss-detail-row {
  padding: 16rpx 0;
  border-top: 1rpx solid #F0EBE3;
}

.ss-detail-row:last-child {
  padding-bottom: 0;
}

.ss-detail-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.ss-detail-order {
  font-size: 24rpx;
  color: #8E8E93;
}

.ss-detail-status {
  font-size: 22rpx;
  padding: 2rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(140, 29, 24, 0.08);
  color: #8C1D18;
}

.ss-status-unsettled {
  background: rgba(199, 123, 46, 0.12);
  color: #C77B2E;
}

.ss-status-refunded {
  background: rgba(142, 142, 147, 0.12);
  color: #8E8E93;
}

.ss-detail-amounts {
  display: flex;
  gap: 24rpx;
}

.ss-detail-amount {
  font-size: 28rpx;
  color: #1C1C1E;
}

/* 🏛️（护城河一 M1）以产养善 —— 累计转捐卡片，颜色跟其余三桶区分开，
   用一个偏公益调性的绿色，避免和 .ss-card-settled 的深绿撞色太接近导致
   混淆哪个是"结算"哪个是"转捐" */
.ss-card-charity {
  border-top-color: #4CAF50;
}

.ss-pledge-btn {
  margin-top: 12rpx;
  display: inline-block;
  font-size: 22rpx;
  line-height: 52rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  background: #EDF7ED;
  color: #2E7D32;
  border: 1rpx solid #A5D6A7;
}

.ss-pledge-btn::after {
  border: none;
}

/* 🏛️（护城河一 M1）转捐弹窗——半屏卡片，与本仓库其余"选择+确认"类弹窗
   同一套视觉语言（浅底卡片+主操作按钮+次要取消按钮） */
.ss-pledge-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.ss-pledge-modal-card {
  width: 100%;
  max-height: 85vh;
  background: #FFFFFF;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.ss-pledge-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-bottom: 4rpx;
}

.ss-pledge-modal-sub {
  font-size: 22rpx;
  color: #8E8E93;
  margin-bottom: 20rpx;
}

.ss-pledge-field-label {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
  margin-bottom: 8rpx;
}

.ss-pledge-input {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  box-sizing: border-box;
  border: 2rpx solid #E5DED4;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1C1C1E;
  margin-bottom: 16rpx;
}

.ss-pledge-store-loading {
  text-align: center;
  padding: 40rpx 0;
  color: #8E8E93;
  font-size: 26rpx;
}

.ss-pledge-store-list {
  max-height: 400rpx;
  border: 2rpx solid #F0EBE3;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.ss-pledge-store-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F0EBE3;
}

.ss-pledge-store-item.active {
  background: #EDF7ED;
}

.ss-pledge-store-name {
  font-size: 26rpx;
  color: #1C1C1E;
  flex: 1;
}

.ss-pledge-store-region {
  font-size: 22rpx;
  color: #ADADB2;
}

.ss-pledge-store-check {
  color: #2E7D32;
  font-weight: 700;
}

.ss-pledge-store-empty {
  text-align: center;
  padding: 40rpx 0;
  color: #ADADB2;
  font-size: 24rpx;
}

.ss-pledge-submit-btn {
  background: #2E7D32;
  color: #FFFFFF;
  font-size: 30rpx;
  line-height: 84rpx;
  border-radius: 12rpx;
}

.ss-pledge-submit-btn[disabled] {
  background: #C8E6C9;
  color: #FFFFFF;
  opacity: 1;
}

.ss-pledge-cancel-btn {
  background: #F0EBE3;
  color: #8E8E93;
  font-size: 28rpx;
  line-height: 76rpx;
  border-radius: 12rpx;
  margin-top: 16rpx;
}
