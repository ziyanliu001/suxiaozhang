<view class="ss-page">

  <navigation-bar
    title="💰 对账明细"
    background="#8C1D18"
    color="#FFFFFF"
    dark="{{true}}"
    back="{{true}}"
    showHomeButton="auto"
    bind:layout="onNavLayout"
  ></navigation-bar>

  <!-- 🐛 2026-09-06 修复：margin-top 不再叠加 navigation-bar 已占用的
       totalHeight，只留 24rpx 呼吸边距；内层 .ss-scroll 的 height calc 不动 -->
  <view class="ss-body" style="margin-top: 24rpx;">

    <view class="ss-loading-state" wx:if="{{loading && details.length === 0}}">
      <text>加载中...</text>
    </view>

    <view class="ss-error-state" wx:elif="{{loadError}}">
      <text class="ss-error-icon">⚠️</text>
      <text class="ss-error-text">{{loadError}}</text>
      <button class="ss-retry-btn" bindtap="loadSummary">重试</button>
    </view>

    <scroll-view class="ss-scroll" scroll-y style="height: calc(100vh - {{contentTop}}px);" wx:else>

      <view class="ss-ops-card">
        <view class="ss-ops-header">
          <text class="ss-section-title">运营简报</text>
          <view class="ss-ops-range-tabs">
            <view class="ss-ops-range-tab {{opsRangeDays === 7 ? 'active' : ''}}" data-days="7" bindtap="onSelectOpsRange">近7天</view>
            <view class="ss-ops-range-tab {{opsRangeDays === 30 ? 'active' : ''}}" data-days="30" bindtap="onSelectOpsRange">近30天</view>
          </view>
        </view>
        <view class="ss-ops-grid">
          <view class="ss-ops-tile">
            <text class="ss-ops-tile-value">{{opsDisplay.orderCount}}<text class="ss-ops-tile-unit">单</text></text>
            <text class="ss-ops-tile-label">出货单量 · 共 {{opsDisplay.totalQuantity}} 份</text>
          </view>
          <view class="ss-ops-tile">
            <text class="ss-ops-tile-value">¥{{opsDisplay.producerAmountYuan}}</text>
            <text class="ss-ops-tile-label">制作方累计结算</text>
          </view>
          <view class="ss-ops-tile">
            <text class="ss-ops-tile-value">¥{{opsDisplay.promoterAmountYuan}}</text>
            <text class="ss-ops-tile-label">推广员累计分成</text>
          </view>
          <view class="ss-ops-tile">
            <text class="ss-ops-tile-value">¥{{opsDisplay.platformFeeYuan}}</text>
            <text class="ss-ops-tile-label">平台留存总收益</text>
          </view>
        </view>
      </view>

      <view class="ss-summary-cards">
        <view class="ss-summary-card ss-card-unsettled">
          <text class="ss-card-title">待结算</text>
          <text class="ss-card-amount">¥{{unsettled.producerAmountYuan}}</text>
          <text class="ss-card-sub">推广分成 ¥{{unsettled.promoterAmountYuan}} · {{unsettled.count}} 笔</text>
        </view>
        <view class="ss-summary-card ss-card-settled">
          <text class="ss-card-title">已结算(净额)</text>
          <text class="ss-card-amount">¥{{settled.producerAmountYuan}}</text>
          <text class="ss-card-sub">推广分成 ¥{{settled.promoterAmountYuan}} · {{settled.count}} 笔</text>
        </view>
        <view class="ss-summary-card ss-card-voided" wx:if="{{voided.count > 0}}">
          <text class="ss-card-title">已撤销</text>
          <text class="ss-card-amount">¥{{voided.producerAmountYuan}}</text>
          <text class="ss-card-sub">未产生实际支付 · {{voided.count}} 笔</text>
        </view>
        <!-- 🏛️（护城河一 M1）以产养善累计转捐——独立于三桶结算，只要 > 0 才展示 -->
        <view class="ss-summary-card ss-card-charity" wx:if="{{charityPledgedTotalYuan !== '0.00'}}">
          <text class="ss-card-title">🌾 已转捐公益厨房</text>
          <text class="ss-card-amount">¥{{charityPledgedTotalYuan}}</text>
          <text class="ss-card-sub">累计以产养善额度</text>
        </view>
      </view>

      <view class="ss-empty-state" wx:if="{{details.length === 0}}">
        <text class="ss-empty-icon">📋</text>
        <text class="ss-empty-text">暂无分账记录</text>
      </view>

      <view class="ss-detail-list" wx:else>
        <view class="ss-detail-header-row">
          <text class="ss-detail-header">分账明细</text>
          <button class="ss-export-btn" size="mini" loading="{{exportPreviewLoading}}" bindtap="onExportSettlement">📤 导出对账</button>
        </view>

        <!-- 🏛️（护城河三 M2）批量确认结算工具条：direct_wechat 模式下分账由
             微信支付自动划拨，不该出现这个入口（云函数本身也会拒绝） -->
        <view class="ss-batch-toolbar" wx:if="{{paymentMode !== 'direct_wechat' && unsettled.count > 0}}">
          <view class="ss-batch-toolbar-links">
            <text class="ss-batch-link" bindtap="onSelectAllUnsettled">全选待结算</text>
            <text class="ss-batch-link" bindtap="onClearSelection">清空</text>
          </view>
          <button
            class="ss-batch-confirm-btn"
            size="mini"
            loading="{{markSettling}}"
            disabled="{{selectedOrderIds.length === 0}}"
            bindtap="onConfirmMarkSettled"
          >批量确认结算（{{selectedOrderIds.length}}）</button>
        </view>

        <view class="ss-detail-row" wx:for="{{details}}" wx:key="orderId" wx:for-index="index">
          <view class="ss-detail-top">
            <view
              class="ss-detail-order-group"
              wx:if="{{paymentMode !== 'direct_wechat' && item.settlementStatus === 'unsettled'}}"
              data-order-id="{{item.orderId}}"
              data-index="{{index}}"
              bindtap="onToggleSelectOrder"
            >
              <checkbox class="ss-detail-checkbox" checked="{{item.selected}}" color="#8C1D18" />
              <text class="ss-detail-order">订单 {{item.orderId}}</text>
            </view>
            <view class="ss-detail-order-group" wx:else>
              <text class="ss-detail-order">订单 {{item.orderId}}</text>
            </view>
            <text class="ss-detail-status ss-status-{{item.settlementStatus}}">{{item.statusLabel}}</text>
          </view>
          <view class="ss-detail-amounts">
            <text class="ss-detail-amount">制作方 ¥{{item.producerAmountYuan}}</text>
            <text class="ss-detail-amount" wx:if="{{item.promoterAmount > 0}}">推广 ¥{{item.promoterAmountYuan}}</text>
          </view>
          <!-- 🏛️（护城河一 M1）只有真正 settled（不是 settled_then_reversed/
               unsettled/refunded）的记录才允许转捐——避免把已经被红冲、或
               根本还没结算到手的钱捐出去 -->
          <button
            class="ss-pledge-btn"
            wx:if="{{item.settlementStatus === 'settled'}}"
            data-order-id="{{item.orderId}}"
            bindtap="onOpenPledgeModal"
          >🌾 捐给公益厨房</button>
        </view>
      </view>

    </scroll-view>

  </view>

  <!-- 🏛️（护城河一 M1）转捐弹窗 -->
  <view class="ss-pledge-modal-mask" wx:if="{{showPledgeModal}}" catchtap="onClosePledgeModal">
    <view class="ss-pledge-modal-card" catchtap="stopPropagation">
      <text class="ss-pledge-modal-title">转捐给公益厨房</text>
      <text class="ss-pledge-modal-sub">订单 {{pledgeTargetOrderId}} · 制作方分成上限 ¥{{pledgeMaxAmountYuan}}</text>

      <text class="ss-pledge-field-label">转捐金额（元）</text>
      <input
        class="ss-pledge-input"
        type="digit"
        placeholder="默认全额，可减少"
        value="{{pledgeAmountYuan}}"
        bindinput="onPledgeAmountInput"
      />

      <text class="ss-pledge-field-label">选择公益厨房</text>
      <input
        class="ss-pledge-input"
        placeholder="搜索门店名称"
        value="{{pledgeKeyword}}"
        bindinput="onPledgeKeywordInput"
      />

      <view class="ss-pledge-store-loading" wx:if="{{pledgeStoresLoading}}">
        <text>加载门店列表中...</text>
      </view>
      <scroll-view class="ss-pledge-store-list" scroll-y wx:else>
        <view
          class="ss-pledge-store-item {{pledgeSelectedStoreId === item.storeId ? 'active' : ''}}"
          wx:for="{{pledgeStoresFiltered}}"
          wx:key="storeId"
          data-store-id="{{item.storeId}}"
          bindtap="onSelectTargetStore"
        >
          <text class="ss-pledge-store-name">{{item.storeName}}</text>
          <text class="ss-pledge-store-region" wx:if="{{item.city || item.province}}">📍 {{item.city || item.province}}</text>
          <text class="ss-pledge-store-check" wx:if="{{pledgeSelectedStoreId === item.storeId}}">✔</text>
        </view>
        <view class="ss-pledge-store-empty" wx:if="{{pledgeStoresFiltered.length === 0}}">
          <text>没有找到匹配的门店</text>
        </view>
      </scroll-view>

      <button class="ss-pledge-submit-btn" loading="{{pledgeSubmitting}}" disabled="{{pledgeSubmitting}}" bindtap="onSubmitPledge">确认转捐</button>
      <button class="ss-pledge-cancel-btn" bindtap="onClosePledgeModal">取消</button>
    </view>
  </view>

  <!-- 🏛️（护城河三 M2）导出核对弹窗：与 statistics.ts 的
       showExportPreviewModal 同一套「先核对、再确认、后导出」安全闭环 -->
  <view class="ss-pledge-modal-mask" wx:if="{{showExportPreviewModal}}" catchtap="onCloseExportPreviewModal">
    <view class="ss-pledge-modal-card" catchtap="stopPropagation">
      <text class="ss-pledge-modal-title">核对对账明细</text>
      <text class="ss-pledge-modal-sub">共 {{exportPreviewSummary.recordCount}} 笔记录，请核对无误后再导出</text>

      <view class="ss-export-summary-grid">
        <view class="ss-export-summary-item">
          <text class="ss-export-summary-label">应付总额</text>
          <text class="ss-export-summary-value">¥{{exportPreviewSummary.payAmountYuan}}</text>
        </view>
        <view class="ss-export-summary-item">
          <text class="ss-export-summary-label">制作方分成</text>
          <text class="ss-export-summary-value">¥{{exportPreviewSummary.producerAmountYuan}}</text>
        </view>
        <view class="ss-export-summary-item">
          <text class="ss-export-summary-label">推广分成</text>
          <text class="ss-export-summary-value">¥{{exportPreviewSummary.promoterAmountYuan}}</text>
        </view>
        <view class="ss-export-summary-item">
          <text class="ss-export-summary-label">平台服务费</text>
          <text class="ss-export-summary-value">¥{{exportPreviewSummary.platformFeeYuan}}</text>
        </view>
      </view>

      <!-- 🛡️（护城河三 4.5）恒等式复核异常提示：导出前主动复核
           producerAmount+promoterAmount+platformFee===payAmount，任何一条对
           不上都在这里如实提示，异常记录仍会正常出现在导出的表格里（带⚠标记），
           不悄悄隐藏 -->
      <view class="ss-export-anomaly-hint" wx:if="{{exportPreviewSummary.anomalyCount > 0}}">
        ⚠ 发现 {{exportPreviewSummary.anomalyCount}} 笔记录金额恒等式校验异常，导出表格中会单独标红，建议优先核实
      </view>

      <scroll-view class="ss-export-preview-list" scroll-y>
        <view class="ss-export-preview-row" wx:for="{{exportPreviewRecords}}" wx:key="orderId">
          <text class="ss-export-preview-order {{item.invariantOk ? '' : 'anomaly'}}">{{item.orderId}}{{item.invariantOk ? '' : ' ⚠'}}</text>
          <text class="ss-export-preview-amount">¥{{item.producerAmountYuan}}</text>
        </view>
      </scroll-view>

      <button class="ss-pledge-submit-btn" loading="{{exportSubmitting}}" disabled="{{exportSubmitting}}" bindtap="onExportPreviewConfirm">确认并导出</button>
      <button class="ss-pledge-cancel-btn" bindtap="onCloseExportPreviewModal">取消</button>
    </view>
  </view>

</view>
