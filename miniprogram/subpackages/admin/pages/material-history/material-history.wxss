page {
  background: #F5F6F8;
  height: 100%;
}

.mh-page {
  min-height: 100vh;
  box-sizing: border-box;
}

.mh-loading-state,
.mh-denied-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  color: #94A3B8;
  font-size: 26rpx;
}

.mh-denied-icon {
  font-size: 88rpx;
  margin-bottom: 24rpx;
}

.mh-denied-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #334155;
  margin-bottom: 12rpx;
}

.mh-denied-sub {
  font-size: 26rpx;
  color: #64748B;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.mh-denied-btn {
  background: #C97B3D;
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 16rpx;
  padding: 16rpx 48rpx;
}

.mh-body {
  display: flex;
  flex-direction: column;
}

.mh-store-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 32rpx;
  background: rgba(201, 123, 61, 0.1);
  border-bottom: 1rpx solid rgba(201, 123, 61, 0.25);
  flex-shrink: 0;
}

.mh-store-icon {
  font-size: 32rpx;
}

.mh-store-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #C97B3D;
}

.mh-tab-row {
  display: flex;
  flex-shrink: 0;
  background: #FFFFFF;
  padding: 16rpx 24rpx 0;
  box-sizing: border-box;
  gap: 16rpx;
}

.mh-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #64748B;
  padding: 16rpx 0;
  border-bottom: 4rpx solid transparent;
}

.mh-tab.active {
  color: #C97B3D;
  font-weight: 700;
  border-bottom-color: #C97B3D;
}

.mh-filter-row {
  flex-shrink: 0;
  white-space: nowrap;
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #F1F5F9;
}

.mh-filter-chip {
  display: inline-block;
  font-size: 24rpx;
  color: #64748B;
  background: #F8FAFC;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
}

.mh-filter-chip.active {
  color: #C97B3D;
  background: rgba(201, 123, 61, 0.12);
  border: 1rpx solid #C97B3D;
  font-weight: 600;
}

.mh-content {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.mh-loading-inline {
  text-align: center;
  padding: 40rpx 0;
  color: #94A3B8;
  font-size: 24rpx;
}

.mh-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  color: #94A3B8;
}

.mh-empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.mh-empty-text {
  font-size: 26rpx;
}

/* 卡片：柔和阴影 + 圆角，与前面升级后的表单/弹窗视觉语言保持一致 */
.mh-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.mh-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

/* 🎨 三色徽标：不是审批状态，是记录类型/方向的诚实标注——
   调出支援＝琥珀色、调入接收＝柔和绿、采购入库＝中性灰 */
.mh-badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.mh-badge.badge-out {
  color: #C97B3D;
  background: rgba(201, 123, 61, 0.12);
  border: 1rpx solid rgba(201, 123, 61, 0.4);
}

.mh-badge.badge-in {
  color: #4CAF50;
  background: rgba(76, 175, 80, 0.12);
  border: 1rpx solid rgba(76, 175, 80, 0.4);
}

.mh-badge.badge-purchase {
  color: #888888;
  background: rgba(136, 136, 136, 0.12);
  border: 1rpx solid rgba(136, 136, 136, 0.35);
}

.mh-card-time {
  font-size: 22rpx;
  color: #94A3B8;
}

.mh-card-route {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.mh-route-store {
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
}

.mh-route-arrow {
  font-size: 24rpx;
  color: #C97B3D;
}

.mh-card-main {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.mh-card-item {
  font-size: 28rpx;
  color: #334155;
  font-weight: 600;
}

.mh-card-qty {
  font-size: 26rpx;
  color: #C97B3D;
  font-weight: 700;
}

.mh-card-foot {
  display: flex;
  gap: 24rpx;
  margin-bottom: 8rpx;
}

.mh-card-sub {
  font-size: 22rpx;
  color: #64748B;
}

.mh-card-code {
  font-size: 20rpx;
  color: #B0B8C1;
}

.mh-safe-area-spacer {
  height: 40rpx;
}
