/* ===== 暖心历程页 ===== */

.journey-page {
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  box-sizing: border-box;
  background: linear-gradient(180deg, #FDFBF6 0%, #F9F5ED 100%);
}

.journey-scroll {
  box-sizing: border-box;
  padding: 24rpx;
  padding-bottom: calc(60rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

/* 🌟 全站统一的卡片基础层：圆角柔和阴影，与 index.wxss 的 .ui-card-wrapper 同一套
   数值规范（WXSS 页面级作用域不跨页共享样式，这里本地复刻一份）。本页每张卡片都
   叠加这个基础类，再各自用更具体的类名覆盖圆角/阴影/边框做差异化装饰（金色/翡翠绿
   渐变、金属光泽描边等），后写的具体规则在 CSS 层叠顺序上自然覆盖这里的基础值 */
.ui-card-wrapper {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid #F1F3F5;
  box-sizing: border-box;
}

/* 顶部统计卡片：金色渐变 + 微金属光泽边框（内高光描边模拟金属反光，
   WXSS 对 border-image 渐变支持不稳定，改用 inset 高光线这种更可靠的手法） */
.journey-header-card {
  position: relative;
  background: linear-gradient(135deg, #FFF9E6 0%, #FFECD2 100%);
  border-radius: 32rpx;
  padding: 36rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.3);
  box-shadow:
    0 6rpx 20rpx rgba(212, 175, 55, 0.16),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.35);
}

.journey-title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.title-icon {
  width: 40rpx;
  height: 40rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  flex-shrink: 0;
}

.lotus-icon {
  -webkit-mask: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%238C1D18' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M12 22c0-3 2-6 5-6s4 2 4 4-2 2-9 2z'/%3E%3Cpath d='M12 22c0-3-2-6-5-6s-4 2-4 4 2 2 9 2z'/%3E%3Cpath d='M12 5c-2 2-2 5 0 7s5 0 5-3-1-4-5-4z'/%3E%3C/svg%3E") no-repeat 50% 50%;
  mask: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%238C1D18' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M12 22c0-3 2-6 5-6s4 2 4 4-2 2-9 2z'/%3E%3Cpath d='M12 22c0-3-2-6-5-6s-4 2-4 4 2 2 9 2z'/%3E%3Cpath d='M12 5c-2 2-2 5 0 7s5 0 5-3-1-4-5-4z'/%3E%3C/svg%3E") no-repeat 50% 50%;
  -webkit-mask-size: cover;
  mask-size: cover;
  background-color: #8C1D18;
}

.journey-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #8C1D18;
  letter-spacing: 2rpx;
}

.journey-subtitle {
  font-size: 24rpx;
  color: #8C6D46;
  text-align: center;
  margin-bottom: 28rpx;
}

/* 4 项核心数据（护持天数/累计打卡/贡献工时/护持餐数）改用等宽 Grid，比 flex
   space-around 在 4 列时更均匀，不会因文案长度不同挤压相邻列 */
.summary-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  align-items: center;
}

.summary-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.summary-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #B22222;
}

.summary-label {
  font-size: 20rpx;
  color: #8C6D46;
}

.btn-gen-honor-card {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 16rpx 24rpx;
  line-height: 1.4;
  background: #8C1D18;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 40rpx;
  box-sizing: border-box;
}

/* ===== 📍 多站点足迹汇总卡片 ===== */
.store-stats-card {
  background: linear-gradient(135deg, #F0F9FF 0%, #E0F2FE 100%);
  border: 1rpx solid #BAE6FD;
}

.store-stats-badge {
  font-size: 22rpx;
  color: #0369A1;
  background: #E0F2FE;
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
}

.store-stats-list {
  margin-top: 8rpx;
}

.store-stats-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #BAE6FD;
}

.store-stats-row:last-child {
  border-bottom: none;
}

.store-stats-name-col {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.store-stats-dot {
  font-size: 16rpx;
  color: #0EA5E9;
  flex-shrink: 0;
}

.store-stats-name {
  font-size: 26rpx;
  color: #0C4A6E;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-stats-nums {
  display: flex;
  gap: 20rpx;
  flex-shrink: 0;
}

.store-stats-cell {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.store-stats-num {
  font-size: 28rpx;
  font-weight: bold;
  color: #0369A1;
}

.store-stats-unit {
  font-size: 20rpx;
  color: #7EA3B8;
}

/* ===== 通用卡片 header 图标（与全站同款 ===== */
.map-icon {
  width: 32rpx;
  height: 32rpx;
  background: #0EA5E9;
  border-radius: 8rpx;
  flex-shrink: 0;
}

/* ===== 爱心荣誉卡预览弹窗 ===== */
.honor-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.honor-modal-box {
  width: 600rpx;
  max-height: 90vh;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.honor-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.honor-modal-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.honor-modal-close {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.close-x-text {
  font-size: 28rpx;
  color: #999999;
}

/* 🐛 根因修复（第二轮）：第一轮把 flex:1 从 <image> 挪到了外层 scroll-view，
   但 .honor-modal-box 本身只有 max-height（没有确定的 height），flex:1 需要
   父容器有"确定的剩余空间"才能算出高度——父容器高度本身又是"内容撑出来的
   auto 值，上限 90vh"，两边互相依赖，浏览器/小程序引擎会把这种不确定情况
   解成 0，预览区域还是会塌陷成空白。改为给 scroll-view 一个具体的 max-height
   （而不是 flex:1 抢"剩余空间"），不再依赖父容器的确定高度，从根上避免这种
   循环依赖 */
.honor-card-scroll {
  max-height: 60vh;
}

.honor-card-image {
  display: block;
  width: 100%;
  border-radius: 16rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}

.honor-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.honor-loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 5rpx solid #F1ECE3;
  border-top-color: #8C1D18;
  border-radius: 50%;
  margin-bottom: 20rpx;
  animation: honor-spin 0.8s linear infinite;
}

@keyframes honor-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.honor-loading-text {
  font-size: 26rpx;
  color: #999999;
}

.honor-modal-hint {
  display: block;
  font-size: 22rpx;
  color: #B5A190;
  text-align: center;
  margin-top: 16rpx;
}

.honor-btn-save {
  width: 100%;
  margin-top: 16rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  font-size: 28rpx;
  font-weight: bold;
  background: #8C1D18;
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(140, 29, 24, 0.3);
}

.honor-btn-save::after {
  border: none;
}

.honor-btn-save[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

/* 通用卡片：与 .ui-card-wrapper 品牌规范一致的圆角柔和阴影（WXSS 页面级作用域
   不跨页共享，这里沿用本页已有的 heatmap/timeline 卡片数值，一并让勋章墙套用同款） */
.heatmap-card,
.timeline-card,
.badge-wall-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #F1ECE3;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-header-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.header-icon {
  width: 34rpx;
  height: 34rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  flex-shrink: 0;
}

.flame-icon {
  -webkit-mask: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23E65100' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M12 2c0 0-7 4-7 11 0 2.5 1 4.5 2.5 6h9c1.5-1.5 2.5-3.5 2.5-6 0-7-7-11-7-11z'/%3E%3Cpath d='M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4z'/%3E%3C/svg%3E") no-repeat 50% 50%;
  mask: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23E65100' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M12 2c0 0-7 4-7 11 0 2.5 1 4.5 2.5 6h9c1.5-1.5 2.5-3.5 2.5-6 0-7-7-11-7-11z'/%3E%3Cpath d='M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4z'/%3E%3C/svg%3E") no-repeat 50% 50%;
  -webkit-mask-size: cover;
  mask-size: cover;
  background-color: #E65100;
}

.scroll-icon {
  -webkit-mask: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%238C1D18' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/%3E%3Cpolyline points='14 2 14 8 20 8'/%3E%3Cline x1='16' y1='13' x2='8' y2='13'/%3E%3Cline x1='16' y1='17' x2='8' y2='17'/%3E%3Cpolyline points='10 9 9 9 8 9'/%3E%3C/svg%3E") no-repeat 50% 50%;
  mask: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%238C1D18' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/%3E%3Cpolyline points='14 2 14 8 20 8'/%3E%3Cline x1='16' y1='13' x2='8' y2='13'/%3E%3Cline x1='16' y1='17' x2='8' y2='17'/%3E%3Cpolyline points='10 9 9 9 8 9'/%3E%3C/svg%3E") no-repeat 50% 50%;
  -webkit-mask-size: cover;
  mask-size: cover;
  background-color: #8C1D18;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #4A4A4A;
}

/* 热力图图例 */
.heat-legend {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-label {
  font-size: 20rpx;
  color: #868E96;
}

.legend-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
}

.legend-dot.level-1 { background-color: #FDE8D0; }
.legend-dot.level-2 { background-color: #F5C88C; }
.legend-dot.level-3 { background-color: #E6A24D; }
.legend-dot.level-4 { background-color: #D4AF37; }

/* 热力图网格 */
.heatmap-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.heat-cell {
  aspect-ratio: 1;
  border-radius: 12rpx;
  background-color: #F5F1EB;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  transition: transform 0.2s ease, background-color 0.3s ease;
}

.heat-cell.active {
  transform: scale(1.05);
}

.heat-cell.level-0 { background-color: #F5F1EB; }
.heat-cell.level-1 { background-color: #FDE8D0; }
.heat-cell.level-2 { background-color: #F5C88C; }
.heat-cell.level-3 { background-color: #E6A24D; }
.heat-cell.level-4 { background-color: #D4AF37; box-shadow: 0 4rpx 10rpx rgba(212, 175, 55, 0.35); }

.cell-icon {
  width: 24rpx;
  height: 24rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  -webkit-mask: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%238C1D18' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z'/%3E%3C/svg%3E") no-repeat 50% 50%;
  mask: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%238C1D18' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z'/%3E%3C/svg%3E") no-repeat 50% 50%;
  -webkit-mask-size: cover;
  mask-size: cover;
  background-color: rgba(140, 29, 24, 0.12);
}

.heat-cell.level-1 .cell-icon,
.heat-cell.level-2 .cell-icon,
.heat-cell.level-3 .cell-icon,
.heat-cell.level-4 .cell-icon {
  background-color: rgba(140, 29, 24, 0.5);
}

.heat-cell.level-4 .cell-icon {
  background-color: #8C1D18;
}

.cell-date {
  font-size: 16rpx;
  color: rgba(0, 0, 0, 0.35);
}

.heat-cell.level-4 .cell-date {
  color: rgba(255, 255, 255, 0.9);
}

.heatmap-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #FFF9E6;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
}

.tip-icon {
  width: 28rpx;
  height: 28rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  -webkit-mask: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23B57C1E' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M9.663 17h4.673M12 3v1M6.343 4.343l-.707-.707M18.364 4.343l.707-.707M17 12a5 5 0 1 1-10 0 5 5 0 0 1 10 0z'/%3E%3C/svg%3E") no-repeat 50% 50%;
  mask: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23B57C1E' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M9.663 17h4.673M12 3v1M6.343 4.343l-.707-.707M18.364 4.343l.707-.707M17 12a5 5 0 1 1-10 0 5 5 0 0 1 10 0z'/%3E%3C/svg%3E") no-repeat 50% 50%;
  -webkit-mask-size: cover;
  mask-size: cover;
  background-color: #B57C1E;
}

.tip-text {
  font-size: 22rpx;
  color: #8C6D46;
}

/* 全部展开/收起按钮 */
.btn-toggle-all {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  background: #FFF9E6;
  border-radius: 24rpx;
}

.toggle-text {
  font-size: 22rpx;
  color: #B57C1E;
}

.toggle-arrow {
  font-size: 20rpx;
  color: #B57C1E;
  transition: transform 0.3s ease;
}

.toggle-arrow.rotate {
  transform: rotate(180deg);
}

/* 时间轴空状态 */
.timeline-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  -webkit-mask: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23D4AF37' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M12 22c0-3 2-6 5-6s4 2 4 4-2 2-9 2z'/%3E%3Cpath d='M12 22c0-3-2-6-5-6s-4 2-4 4 2 2 9 2z'/%3E%3Cpath d='M12 5c-2 2-2 5 0 7s5 0 5-3-1-4-5-4z'/%3E%3C/svg%3E") no-repeat 50% 50%;
  mask: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23D4AF37' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M12 22c0-3 2-6 5-6s4 2 4 4-2 2-9 2z'/%3E%3Cpath d='M12 22c0-3-2-6-5-6s-4 2-4 4 2 2 9 2z'/%3E%3Cpath d='M12 5c-2 2-2 5 0 7s5 0 5-3-1-4-5-4z'/%3E%3C/svg%3E") no-repeat 50% 50%;
  -webkit-mask-size: cover;
  mask-size: cover;
  background-color: #D4AF37;
}

.empty-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #4A4A4A;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #868E96;
  text-align: center;
  line-height: 1.6;
}

/* 空状态 CTA：淡金色描边 + 极浅暖橙底色，与页面整体的金色/暖橙配色呼应，
   比实心按钮更轻，符合"引导但不抢戏"的空状态语境 */
.empty-cta-btn {
  margin-top: 28rpx;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
  border: 1rpx solid #D4AF37;
  background: rgba(212, 175, 55, 0.08);
}

.empty-cta-btn:active {
  background: rgba(212, 175, 55, 0.18);
}

.empty-cta-text {
  font-size: 26rpx;
  font-weight: bold;
  color: #B8860B;
}

/* 时间轴分组 */
.timeline-group {
  margin-bottom: 16rpx;
}

.group-header {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 0;
  position: relative;
}

.group-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #D4AF37;
  box-shadow: 0 0 0 6rpx rgba(212, 175, 55, 0.2);
  flex-shrink: 0;
}

.group-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #4A4A4A;
}

.group-count {
  font-size: 22rpx;
  color: #8C6D46;
  margin-left: auto;
}

.group-arrow {
  font-size: 24rpx;
  color: #868E96;
  transition: transform 0.3s ease;
  margin-left: 8rpx;
}

.group-arrow.rotate {
  transform: rotate(180deg);
}

/* 展开/折叠动效 */
.group-items {
  overflow: hidden;
  max-height: 2000rpx;
  opacity: 1;
  transition: max-height 0.35s ease, opacity 0.3s ease;
  padding-left: 8rpx;
}

.group-items.collapsed {
  max-height: 0;
  opacity: 0;
}

/* 时间轴单项 */
.timeline-item {
  display: flex;
  gap: 18rpx;
  padding: 18rpx 0;
  opacity: 0;
  transform: translateY(16rpx);
  animation: slideInUp 0.4s ease forwards;
}

@keyframes slideInUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.item-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 44rpx;
  flex-shrink: 0;
}

.service-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 60%;
  flex-shrink: 0;
  z-index: 1;
}

.icon-reception {
  background-color: #FFF3E0;
  -webkit-mask: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23E65100' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2'/%3E%3Ccircle cx='12' cy='7' r='4'/%3E%3C/svg%3E") no-repeat 50% 50%;
