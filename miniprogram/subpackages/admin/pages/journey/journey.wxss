  -webkit-mask-size: 60%;
  mask-size: 60%;
  background-color: #1C7ED6;
}

.icon-other {
  background-color: #FFF0ED;
  -webkit-mask: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%238C1D18' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z'/%3E%3C/svg%3E") no-repeat 50% 50%;
  mask: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%238C1D18' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z'/%3E%3C/svg%3E") no-repeat 50% 50%;
  -webkit-mask-size: 60%;
  mask-size: 60%;
  background-color: #8C1D18;
}

.item-line {
  flex: 1;
  width: 2rpx;
  background: linear-gradient(180deg, #E5D8C3, transparent);
  margin-top: 8rpx;
}

.timeline-item:last-child .item-line {
  display: none;
}

.item-body {
  flex: 1;
  background: #FAF8F5;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #F1ECE3;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.item-body:active {
  transform: scale(0.99);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.item-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.item-shift {
  font-size: 28rpx;
  font-weight: bold;
  color: #4A4A4A;
}

.item-hours {
  font-size: 26rpx;
  font-weight: bold;
  color: #B22222;
}

.item-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.item-date,
.item-store {
  font-size: 22rpx;
  color: #868E96;
}

/* ===== 🔒 全国纵览（仅超级管理员可见） =====
   翡翠绿渐变 + 微金属光泽边框，与顶部金色荣誉卡区分开——"金色=个人成就，
   翡翠绿=管理员专属全局视角"，色彩本身即是权限层级的视觉提示 */
.national-overview-card {
  position: relative;
  background: linear-gradient(135deg, #E8F8F0 0%, #D2F0E0 100%);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(11, 138, 96, 0.28);
  box-shadow:
    0 6rpx 20rpx rgba(11, 138, 96, 0.14),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.85),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.3);
}

.national-title {
  color: #0B6B4A;
}

.globe-icon {
  -webkit-mask: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%230B6B4A' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Ccircle cx='12' cy='12' r='10'/%3E%3Cline x1='2' y1='12' x2='22' y2='12'/%3E%3Cpath d='M12 2a15 15 0 0 1 0 20a15 15 0 0 1 0-20z'/%3E%3C/svg%3E") no-repeat 50% 50%;
  mask: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%230B6B4A' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Ccircle cx='12' cy='12' r='10'/%3E%3Cline x1='2' y1='12' x2='22' y2='12'/%3E%3Cpath d='M12 2a15 15 0 0 1 0 20a15 15 0 0 1 0-20z'/%3E%3C/svg%3E") no-repeat 50% 50%;
  -webkit-mask-size: cover;
  mask-size: cover;
  background-color: #0B6B4A;
}

.national-badge {
  font-size: 20rpx;
  font-weight: bold;
  color: #FFFFFF;
  background: linear-gradient(135deg, #0B8A60 0%, #0B6B4A 100%);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  white-space: nowrap;
}

.national-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx 12rpx;
}

.national-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.national-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #0B6B4A;
}

.national-label {
  font-size: 20rpx;
  color: #4E8A76;
  text-align: center;
}

.national-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 40rpx 0;
}

.national-loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(11, 138, 96, 0.18);
  border-top-color: #0B6B4A;
  border-radius: 50%;
  animation: honor-spin 0.8s linear infinite;
}

.national-loading text {
  font-size: 22rpx;
  color: #4E8A76;
}

/* ===== 🎖️ 勋章墙：3 列 Grid ===== */
.medal-icon {
  -webkit-mask: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%238C1D18' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Ccircle cx='12' cy='8' r='6'/%3E%3Cpath d='M8.21 13.89 7 23l5-3 5 3-1.21-9.12'/%3E%3C/svg%3E") no-repeat 50% 50%;
  mask: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%238C1D18' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Ccircle cx='12' cy='8' r='6'/%3E%3Cpath d='M8.21 13.89 7 23l5-3 5 3-1.21-9.12'/%3E%3C/svg%3E") no-repeat 50% 50%;
  -webkit-mask-size: cover;
  mask-size: cover;
  background-color: #8C1D18;
}

.badge-progress-tip {
  font-size: 20rpx;
  color: #B57C1E;
}

.badge-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx 12rpx;
}

.badge-cell {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 4rpx;
  border-radius: 16rpx;
  transition: transform 0.15s ease;
}

.badge-cell-hover {
  transform: scale(0.94);
  background: rgba(212, 175, 55, 0.08);
}

.badge-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFF3D6 0%, #FFE2A8 100%);
  box-shadow: 0 4rpx 12rpx rgba(212, 175, 55, 0.25);
}

/* 已解锁：柔和辉光呼吸动效，与未解锁的模糊灰阶态形成强烈的"荣耀感"对比 */
.badge-cell.unlocked .badge-circle {
  animation: badge-glow-pulse 2.4s ease-in-out infinite;
}

@keyframes badge-glow-pulse {
  0%, 100% {
    box-shadow: 0 4rpx 12rpx rgba(212, 175, 55, 0.25), 0 0 0 0 rgba(255, 217, 140, 0.45);
  }
  50% {
    box-shadow: 0 4rpx 16rpx rgba(212, 175, 55, 0.35), 0 0 0 10rpx rgba(255, 217, 140, 0);
  }
}

.badge-emoji {
  font-size: 44rpx;
  line-height: 1;
}

/* 未解锁：整枚勋章高斯模糊 + 灰阶降级，叠加锁形图标，一眼区分"已获得/未获得" */
.badge-cell.locked .badge-circle {
  background: #EDEDED;
  filter: blur(1.5px) grayscale(0.6);
  box-shadow: none;
}

.badge-lock-overlay {
  position: absolute;
  top: 12rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.15);
}

.badge-lock-icon {
  font-size: 32rpx;
}

.badge-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #4A4A4A;
  text-align: center;
}

.badge-cell.locked .badge-name {
  color: #ADB5BD;
}

.badge-percent {
  font-size: 18rpx;
  color: #B57C1E;
  font-weight: bold;
}

/* ===== 🎖️ 勋章详情弹窗 ===== */
.badge-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-modal-box {
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 44rpx 36rpx 36rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.badge-detail-circle {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.badge-detail-circle.unlocked {
  background: linear-gradient(135deg, #FFF3D6 0%, #FFE2A8 100%);
  box-shadow: 0 6rpx 16rpx rgba(212, 175, 55, 0.35);
  animation: badge-glow-pulse 2.4s ease-in-out infinite;
}

.badge-detail-circle.locked {
  background: #EDEDED;
  filter: grayscale(0.6);
}

.badge-detail-emoji {
  font-size: 60rpx;
}

.badge-detail-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.badge-detail-status {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 20rpx;
}

.badge-detail-status.unlocked {
  color: #2B8A3E;
  font-weight: bold;
}

.badge-detail-meaning {
  font-size: 26rpx;
  color: #4A4A4A;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.badge-detail-desc {
  font-size: 22rpx;
  color: #999999;
  text-align: center;
  margin-bottom: 20rpx;
}

.badge-detail-progress-track {
  width: 100%;
  height: 12rpx;
  border-radius: 6rpx;
  background: #F1ECE3;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.badge-detail-progress-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #FFD98C 0%, #D4AF37 100%);
  transition: width 0.4s ease;
}

.badge-detail-progress-text {
  font-size: 22rpx;
  color: #8C6D46;
  text-align: center;
  margin-bottom: 28rpx;
}

.badge-modal-close-btn {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 38rpx;
  background: #F1F3F5;
  color: #495057;
  font-size: 26rpx;
  font-weight: bold;
}

.badge-modal-close-btn:active {
  background: #E9ECEF;
}

/* 空状态 "Day 1" 引导徽标：与开启第一天护持之旅的文案呼应，视觉上更像一个
   温暖的邀请函而不是冷冰冰的"无数据"提示 */
.empty-day-badge {
  font-size: 20rpx;
  font-weight: bold;
  color: #FFFFFF;
  background: linear-gradient(135deg, #E6A24D 0%, #D4AF37 100%);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 10rpx rgba(212, 175, 55, 0.3);
}
