  -webkit-mask: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%232E7D32' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M3 3v18h18'/%3E%3Cpath d='M7 16v-3a3 3 0 0 1 3-3h4a3 3 0 0 1 3 3v3'/%3E%3Cpath d='M7 11h10'/%3E%3C/svg%3E") no-repeat 50% 50%;
