.sp-page {
  min-height: 100vh;
  background: #F8F5F0;
}

.sp-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  height: 88rpx;
  background: #8C1D18;
}

.sp-nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
}

.sp-nav-back-hover {
  opacity: 0.5;
}

/* 🛡️ 标题绝对居中，不依赖左右两侧按钮是否存在：编辑按钮改成 wx:if 后，
   义工/财务等无编辑权限的角色不会渲染这个节点，若仍用 space-between 布局，
   标题会因为右侧少了一个占位元素而整体偏移，改为绝对定位彻底消除这个依赖 */
.sp-nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
  white-space: nowrap;
}
.sp-scroll {
  height: calc(100vh - 88rpx);
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  padding-bottom: calc(60rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

/* 🏛️ 家长风控锁：待审批提示条 */
.sp-pending-banner {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #FFFBE6;
  border: 1rpx solid #FFE58F;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.sp-pending-icon {
  font-size: 26rpx;
}

.sp-pending-text {
  font-size: 22rpx;
  color: #D48806;
  flex: 1;
}

.sp-store-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.sp-store-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.sp-store-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
}

/* 🌐 运营状态徽章：与 store-picker 组件同款配色口径 */
.sp-operating-badge {
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 10rpx;
  background: #E8F5E9;
  color: #2E7D32;
}

.sp-operating-badge.preparing {
  background: #FFF3E0;
  color: #D48806;
}

.sp-operating-badge.paused {
  background: #F1F3F5;
  color: #868E96;
}

/* ✏️ 修改档案：店名旁的快捷编辑入口，与 .sp-btn-edit-profile-count 视觉呼应
   但独立成一个 class，避免两处布局语境（flex 行内 vs 标题栏）耦合出意外样式 */
.sp-btn-edit-archive {
  margin-left: auto;
  font-size: 22rpx;
  color: #8C1D18;
  font-weight: bold;
  flex-shrink: 0;
}

.sp-store-address {
  display: block;
  font-size: 24rpx;
  color: #868E96;
}

/* 📊 门店动态健康看板：4 格矩形指标，白底圆角小卡片 + 弱化标签/加粗数值，
   状态色（good/warn/danger）与 material-usage-modal 三档选择器同一套语义 */
.sp-health-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.sp-health-tile {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sp-health-lbl {
  font-size: 22rpx;
  color: #868E96;
}

.sp-health-val {
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
}

.sp-health-val.good {
  color: #2E7D32;
}

.sp-health-val.warn {
  color: #D48806;
}

.sp-health-val.danger {
  color: #D32F2F;
}

.sp-health-val.neutral {
  color: #495057;
}

.sp-section-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.sp-section-icon {
  font-size: 26rpx;
}

.sp-section-txt {
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
}

/* 4 列 x 2 行栅格：与 history.wxss 的 .dining-breakdown-grid 同款 grid-cell/cell-lbl/cell-val 口径 */
.sp-profile-grid-4col {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 🌟 重构为白底圆角外卡 + 浅黄底色小格双层结构：每个指标自带一张淡黄色小卡片，
   比裸露排布在共用白底容器里的纯文字更有"数据卡片"质感，数字加粗放大更醒目 */
.grid-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  background: #FFFBEE;
  border-radius: 16rpx;
  padding: 20rpx 6rpx;
}

.cell-lbl {
  font-size: 20rpx;
  color: #868E96;
  text-align: center;
}

.cell-val {
  font-size: 40rpx;
  font-weight: 800;
  color: #212529;
}

/* 中共党员：醒目红色高亮，与其余暖橘色指标区分 */
.cell-val.party-highlight {
  color: #D9363E;
}

.cell-val.orange {
  color: #D2691E;
}

.cell-val.grey {
  color: #495057;
}

/* 数值为 0：不参与彩色高亮，保持素灰简约，避免一整屏都是醒目颜色反而弱化真正有数据的项 */
.cell-val.zero {
  color: #C4C9CE;
  font-weight: normal;
}

/* 👥 门店人员与服务人群画像 / 📖 门店档案信息 标题栏：不能用 justify-content:
   space-between——canManage 为 false 时右侧的"✏️ 修改"按钮不会渲染，标题栏就只剩
   icon + 文字两个子元素，space-between 会把这两个仅有的子元素拉到行首/行尾两端，
   文字被顶到最右边贴着容器边缘。改为让按钮自己用 margin-left: auto 在存在时才
   独立推到最右，图标与标题文字始终吃 .sp-section-title 基础样式的 gap:8rpx
   紧贴在一起，不受按钮是否渲染影响 */
.sp-btn-edit-profile-count {
  margin-left: auto;
  font-size: 24rpx;
  color: #8C1D18;
  font-weight: bold;
}

.sp-edit-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.sp-edit-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sp-edit-lbl {
  font-size: 22rpx;
  color: #495057;
}

.sp-edit-lbl.party-highlight {
  color: #D9363E;
  font-weight: bold;
}

.sp-edit-input {
  background: #F8F9FA;
  border: 1rpx solid #CED4DA;
  border-radius: 10rpx;
  height: 72rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
}

.sp-edit-footer {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.sp-btn-cancel {
  flex: 1;
  background: #F1F3F5;
  color: #495057;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.sp-btn-save {
  flex: 1;
  background: #8C1D18;
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.sp-loading-box {
  text-align: center;
  padding: 40rpx 0;
  color: #ADB5BD;
  font-size: 24rpx;
}

/* 🏛️ 门店档案信息：展示态纵向标签+值列表，编辑态复用 .sp-edit-item/.sp-edit-lbl */
.sp-archive-card,
.sp-archive-edit-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.sp-archive-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed #F1F3F5;
}

.sp-archive-row:last-child {
  border-bottom: none;
}

.sp-archive-row.vertical {
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}

.sp-archive-lbl {
  font-size: 24rpx;
  color: #868E96;
  flex-shrink: 0;
}

.sp-archive-val {
  font-size: 26rpx;
  color: #212529;
  text-align: right;
}

.sp-archive-val-block {
  font-size: 26rpx;
  color: #212529;
  line-height: 1.6;
}

/* 📞📍 一键拨打/一键导航：与对应字段的值同一行，右侧一个零成本快捷按键 */
.sp-archive-val-with-action {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.sp-btn-quick-action {
  font-size: 22rpx;
  font-weight: bold;
  color: #FFFFFF;
  background: #8C1D18;
  border-radius: 20rpx;
  padding: 6rpx 16rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.sp-archive-empty-hint {
  font-size: 24rpx;
  color: #ADB5BD;
  padding: 4rpx 0;
}

/* 仅 canManage 为 true 时套用——视觉上标记"暂未上传"占位可点击直达上传弹窗，
   只读角色（义工/财务/家属）看到的是不带下划线的纯灰提示，不暗示可交互 */
.sp-archive-empty-hint.clickable {
  color: #FF8C42;
  text-decoration: underline;
}

.sp-archive-edit-card .sp-edit-item {
  margin-bottom: 20rpx;
}

.sp-archive-edit-card .sp-edit-item:last-child {
  margin-bottom: 0;
}

.sp-edit-row-2col {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.sp-edit-row-2col .sp-edit-item {
  flex: 1;
  margin-bottom: 0;
}

.sp-edit-input.full {
  width: 100%;
  box-sizing: border-box;
  font-weight: normal;
}

.sp-edit-input-readonly {
  display: flex;
  align-items: center;
  color: #999999;
  background: #F1F1EE;
}

.sp-date-picker-value {
  display: flex;
  align-items: center;
}

.sp-edit-textarea {
  background: #F8F9FA;
  border: 1rpx solid #CED4DA;
  border-radius: 10rpx;
  min-height: 100rpx;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  color: #212529;
  width: 100%;
  box-sizing: border-box;
}

.sp-status-pill-row {
  display: flex;
  gap: 12rpx;
}

.sp-status-pill {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #666666;
  background: #F8F9FA;
  border: 1rpx solid #CED4DA;
  border-radius: 10rpx;
  padding: 12rpx 0;
}

.sp-status-pill.active {
  background: #8C1D18;
  color: #FFFFFF;
  border-color: #8C1D18;
  font-weight: bold;
}

.sp-location-picker-btn {
  height: 72rpx;
  line-height: 72rpx;
  background: #FFF9F0;
  border: 1rpx dashed #FFE58F;
  border-radius: 10rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
  color: #B45309;
}
/* 大事记新增/编辑弹窗 */
.sp-modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.sp-modal-card {
  width: 88%;
  max-width: 680rpx;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.sp-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F1F3F5;
  margin-bottom: 16rpx;
}

.sp-modal-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #212529;
}

.sp-modal-close {
  font-size: 32rpx;
  color: #ADB5BD;
}

.sp-modal-scroll {
  max-height: 60vh;
  min-height: 0;
}
.sp-modal-footer {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

/* 🏪 门店照片：展示态缩略图小网格 */
.sp-photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.sp-photo-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  border: 1.5rpx solid #EFE6D8;
}

/* 🏪 门店照片：编辑态上传九宫格，与 store-picker 组件的新建门店表单同款视觉
   （组件样式默认隔离不共享页面 wxss，这里单独复制一份） */
.receipt-grid-container {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 8rpx;
}

.grid-image-item {
  position: relative;
  width: 100%;
  padding-top: 100%;
  border-radius: 16rpx;
  overflow: visible;
}

.grid-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  border: 1.5rpx solid #EFE6D8;
}

.img-delete-badge {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 38rpx;
  height: 38rpx;
  background: rgba(211, 47, 47, 0.95);
  color: #FFFFFF;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.15);
}

.grid-add-btn {
  background: #FAF8F5;
  border: 2.5rpx dashed #C8B195;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  aspect-ratio: 1/1;
}

.grid-add-btn .add-icon {
  font-size: 40rpx;
  color: #8C1D18;
  line-height: 1;
  font-weight: 300;
}

.grid-add-btn .add-txt {
  font-size: 18rpx;
  color: #8C1D18;
  margin-top: 4rpx;
}

/* 🔐 门店安全设置 — 管理员密钥状态徽章与说明文字 */
.sp-admin-key-status-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}
.sp-admin-key-status-badge.set {
  background: #E8F5E9;
  color: #2E7D32;
}
.sp-admin-key-status-badge.unset {
  background: #F5F5F5;
  color: #757575;
}
.sp-admin-key-hint {
  font-size: 22rpx;
  color: #9E9E9E;
  margin-left: 12rpx;
}
.sp-admin-key-val {
  font-family: monospace;
  letter-spacing: 2rpx;
  color: #4A4A4A;
}
.sp-admin-key-desc {
  font-size: 24rpx;
  color: #8C8C8C;
  line-height: 1.6;
  padding: 0;
}
.sp-admin-key-modal-hint {
  padding: 16rpx 8rpx 8rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.sp-admin-key-modal-hint text {
  font-size: 24rpx;
  color: #8C8C8C;
  line-height: 1.6;
}

/* 🏷️ 服务受众标签配置区块分隔提示 */
.sp-edit-section-hint {
  font-size: 24rpx;
  color: #5C6BC0;
  background: #EEF2FF;
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
  margin: 8rpx 0 4rpx;
  line-height: 1.5;
}

/* 目标标签展示（归档卡片，单行 · 分隔） */
.sp-target-labels {
  font-size: 26rpx;
  color: #5C6BC0;
  line-height: 1.6;
}
