<view class="al-page">
  <!-- 🌟 微信用户隐私授权弹窗：本页会调用 chooseMedia（大事记图片上传）隐私接口 -->
  <privacy-popup />

  <view class="al-nav-bar" style="padding-top: {{navTop}}px;">
    <view class="al-nav-back" hover-class="al-nav-back-hover" bindtap="goBack">←</view>
    <text class="al-nav-title">📌 门店日志</text>
    <text class="al-nav-action {{canManage ? '' : 'hidden'}}" bindtap="onOpenTodayEditForm">编辑</text>
  </view>

  <canvas type="2d" id="imgCompressCanvas" style="position: fixed; left: -9999px; top: -9999px; width: 1920px; height: 1920px;"></canvas>

  <scroll-view scroll-y class="al-list-scroll" style="margin-top: {{contentTop}}px;" bindscrolltolower="onReachBottom">

    <!-- 📍 门店身份 Header：sticky 吸顶展示当前门店名，异步解析完成前用骨架占位
         兜底，避免闪现任何默认值。currentStoreName 已经过 applyRolePermissions/
         resolveEffectiveStoreIdentity 统一解析与虚拟店名过滤，非超管这里只会是
         真实绑定门店名；只有超管才会看到"全国总览"与右侧切换门店入口 -->
    <view class="al-store-bar-skeleton" wx:if="{{!roleReady}}"></view>
    <view class="al-store-bar" wx:elif="{{currentStoreName}}">
      <text class="al-store-bar-name">📍 {{currentStoreName}}</text>
      <picker
        wx:if="{{isSuperAdmin}}"
        mode="selector"
        range="{{superAdminStoreOptions}}"
        range-key="storeName"
        value="{{superAdminStoreIndex}}"
        bindchange="onSuperAdminStoreChange"
      >
        <view class="al-store-switch-btn">切换门店 ▾</view>
      </picker>
    </view>

    <!-- ⏳ 待确认的义工投稿：仅店长/超管可见，与下方公开时间轴完全分开——
         这里的记录还没通过确认，不会出现在今日动态/历史动态里 -->
    <block wx:if="{{canManage && pendingList.length > 0}}">
      <view class="al-section-divider">
        <text class="al-divider-icon">⏳</text>
        <text class="al-divider-txt">待确认的义工投稿（{{pendingList.length}}）</text>
      </view>

      <view class="al-pending-card" wx:for="{{pendingList}}" wx:key="_id">
        <view class="al-pending-header">
          <text class="al-pending-title">{{item.title}}</text>
          <text class="al-pending-time">{{item.eventTime}}</text>
        </view>
        <text class="al-pending-meta">🙋 {{item.publisherLabel || '义工'}}提交</text>
        <text class="al-pending-content" wx:if="{{item.content}}">{{item.content}}</text>

        <view class="al-thumb-9grid" wx:if="{{item.images.length > 0}}">
          <view class="al-thumb-grid-item" wx:for="{{item.images}}" wx:for-item="img" wx:key="url">
            <image wx:if="{{!thumbFailedMap[img.thumbUrl]}}" class="al-thumb-grid-img" src="{{img.thumbUrl}}" mode="aspectFill" lazy-load="{{true}}" bindtap="onPreviewImage" data-url="{{img.url}}" data-urls="{{item.images}}" binderror="onImageLoadError" data-thumb-url="{{img.thumbUrl}}" />
            <view wx:else class="thumb-load-failed" catchtap="onRetryImage" data-thumb-url="{{img.thumbUrl}}">
              <text class="thumb-load-failed-icon">⚠️</text>
              <text class="thumb-load-failed-text">加载失败</text>
            </view>
          </view>
        </view>

        <view class="al-pending-actions">
          <button class="al-btn-pending-reject" catchtap="onRejectPending" data-id="{{item._id}}">驳回</button>
          <button class="al-btn-pending-approve" catchtap="onApprovePending" data-id="{{item._id}}">✅ 确认</button>
        </view>
      </view>
    </block>

    <!-- 📌 今日动态：顶部高亮区，右上角提供编辑/追加入口 -->
    <view class="al-section-divider">
      <text class="al-divider-icon">🔴</text>
      <text class="al-divider-txt">今日动态</text>
      <text class="al-divider-date">{{todayDateStr}}</text>
    </view>

    <view class="al-today-card">
      <view class="al-today-header">
        <text class="al-today-title" wx:if="{{todayItem}}">{{todayItem.title}}</text>
        <text class="al-today-title al-today-empty-txt" wx:else>今日暂无动态</text>
        <!-- 🛡️ 权限死锁修复：发布/编辑入口仅对有管理或发布权限的角色开放
             （店长/超管/义工）。显式加上 !isFamily 硬性前置条件，不完全依赖
             canManage/isVolunteer 与 isFamily 互斥这一隐含前提——即便未来
             判定逻辑出现疏漏，家人也在 WXML 层面被直接、无条件挡住 -->
        <!-- 🌟 义工点这个按钮永远是"新提交一条待确认动态"（服务端只放行 create），
             不会像店长那样接续编辑当天已有的正式记录，文案固定不随 todayItem 变化 -->
        <button class="al-btn-today-edit" wx:if="{{!isFamily && canManage}}" bindtap="onOpenTodayEditForm">
          {{todayItem ? '✏️ 编辑/追加今日动态' : '📷 记录今日动态'}}
        </button>
        <button class="al-btn-today-edit" wx:elif="{{!isFamily && isVolunteer}}" bindtap="onOpenTodayEditForm">📷 提交护持动态</button>
      </view>

      <!-- 🌟 发布冲突提示：今日已有记录时展示发布人与时间 -->
      <text class="al-publish-meta" wx:if="{{todayItem}}">已由 {{todayItem.publisherLabel || '管理员'}} 于 {{todayItem.publishTimeStr}} 发布</text>
      <text class="al-card-category-tag {{todayItem.category ? 'tagged' : ''}}" wx:if="{{todayItem}}">{{todayItem.categoryLabelText}}</text>

      <text class="al-today-content" wx:if="{{todayItem && todayItem.content}}">{{todayItem.content}}</text>

      <view class="al-thumb-9grid" wx:if="{{todayItem && todayItem.images.length > 0}}">
        <view class="al-thumb-grid-item" wx:for="{{todayItem.images}}" wx:for-item="img" wx:key="url">
          <image wx:if="{{!thumbFailedMap[img.thumbUrl]}}" class="al-thumb-grid-img" src="{{img.thumbUrl}}" mode="aspectFill" lazy-load="{{true}}" bindtap="onPreviewImage" data-url="{{img.url}}" data-urls="{{todayItem.images}}" binderror="onImageLoadError" data-thumb-url="{{img.thumbUrl}}" />
          <view wx:else class="thumb-load-failed" bindtap="onRetryImage" data-thumb-url="{{img.thumbUrl}}">
            <text class="thumb-load-failed-icon">⚠️</text>
            <text class="thumb-load-failed-text">加载失败</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 🕰 历史动态：时光轴倒序，不含顶部已展示的今日记录。右侧日期选择器 +
         ◀/▶ 快捷翻页支持精确调取某一天的历史日志，不用在漫长的分页时光轴里翻找 -->
    <view class="al-section-divider al-history-header">
      <view class="al-history-header-left">
        <text class="al-divider-icon">🕰</text>
        <text class="al-divider-txt">历史动态</text>
      </view>
      <view class="al-history-filter">
        <text class="al-history-filter-arrow" bindtap="onHistoryPrevDay">◀</text>
        <picker mode="date" value="{{historyFilterDate}}" bindchange="onHistoryDateChange">
          <view class="al-history-filter-date">📅 {{historyFilterDate || '选择日期'}}</view>
        </picker>
        <text class="al-history-filter-arrow" bindtap="onHistoryNextDay">▶</text>
        <text class="al-history-filter-clear" wx:if="{{historyFilterDate}}" bindtap="onClearHistoryDateFilter">✕</text>
      </view>
    </view>

    <view class="al-timeline">
      <view class="al-timeline-item" wx:for="{{historyList}}" wx:key="_id" bindtap="onOpenDetail" data-id="{{item._id}}">
        <view class="al-timeline-dot-col">
          <view class="al-timeline-dot"></view>
          <view class="al-timeline-line"></view>
        </view>
        <view class="al-timeline-card">
          <view class="al-card-header-row">
            <view class="al-card-header-left">
              <view class="al-card-time">{{item.eventTime}}</view>
              <view class="al-card-title-row">
                <text class="al-card-title">{{item.title}}</text>
                <text class="al-card-pinned-badge" wx:if="{{item.isPinned}}">📌 已置顶</text>
              </view>
              <text class="al-card-category-tag {{item.category ? 'tagged' : ''}}">{{item.categoryLabelText}}</text>
            </view>
            <!-- 📌🗑 店长/超管权限强化：卡片右上角置顶/删除，与下方 al-card-actions-row
                 的编辑/自助删除（面向记录本人）是两套互不重叠的入口 -->
            <view class="al-card-corner-actions" wx:if="{{canManage}}">
              <text class="al-card-corner-icon al-card-corner-icon-pin {{item.isPinned ? 'active' : ''}}" catchtap="onTogglePin" data-id="{{item._id}}" data-pinned="{{item.isPinned}}">📌</text>
              <text class="al-card-corner-icon al-card-corner-icon-delete" catchtap="onDeleteLog" data-id="{{item._id}}">🗑</text>
            </view>
          </view>

          <!-- 🙋 发布者身份：角色 Badge（义工/店长/大家长/超级管理员）+ 精确发布时间。
               🛡️ 本页对家人（服务对象）也是只读监督视图，刻意不展示发布者真实姓名/
               头像——manageActivityLog 云函数 resolvePublisherLabel 只落库/回传角色
               标签，不落库真实 PII，这里维持同一条隐私边界 -->
          <view class="al-card-publisher-row">
            <text class="al-card-publisher-badge">{{item.publisherLabel || '管理员'}}</text>
            <text class="al-card-publisher-time" wx:if="{{item.publishTimeStr}}">{{item.publishTimeStr}} 发布</text>
          </view>

          <view class="al-thumb-9grid" wx:if="{{item.images.length > 0}}">
            <view class="al-thumb-grid-item" wx:for="{{item.images}}" wx:for-item="img" wx:key="url">
              <image wx:if="{{!thumbFailedMap[img.thumbUrl]}}" class="al-thumb-grid-img" src="{{img.thumbUrl}}" mode="aspectFill" lazy-load="{{true}}" catchtap="onPreviewImage" data-url="{{img.url}}" data-urls="{{item.images}}" binderror="onImageLoadError" data-thumb-url="{{img.thumbUrl}}" />
              <view wx:else class="thumb-load-failed" catchtap="onRetryImage" data-thumb-url="{{img.thumbUrl}}">
                <text class="thumb-load-failed-icon">⚠️</text>
                <text class="thumb-load-failed-text">加载失败</text>
              </view>
            </view>
          </view>
          <text class="al-card-content" wx:if="{{item.content}}">{{item.content}}</text>

          <!-- ✏️ 编辑：本店管理者（店长/家长/超管）或记录本人可见，单独一行，与
               下面 al-card-footer 的"导出活动海报"分开，避免挤压。删除对管理者
               已收进右上角 al-card-corner-actions，这里的删除只留给"记录本人但
               不是管理者"这种自助场景，避免同一张卡片上出现两处删除入口 -->
          <view class="al-card-actions-row" wx:if="{{canManage || item.createdBy === currentUserOpenid}}">
            <button class="al-btn-card-edit" catchtap="onOpenEditForm" data-id="{{item._id}}">✏️ 编辑/追加照片</button>
            <button class="al-btn-card-delete" wx:if="{{!canManage && item.createdBy === currentUserOpenid}}" catchtap="onDeleteLog" data-id="{{item._id}}">🗑️ 删除</button>
          </view>

          <view class="al-card-footer">
            <button class="al-btn-export-poster" catchtap="onExportPoster" data-id="{{item._id}}">📤 导出活动海报</button>
          </view>
        </view>
      </view>
    </view>

    <view class="al-empty-state" wx:if="{{!loading && historyList.length === 0}}">
      <text class="al-empty-icon">🕰</text>
      <text class="al-empty-text" wx:if="{{historyFilterDate}}">{{historyFilterDate}} 当天暂无历史动态记录</text>
      <text class="al-empty-text" wx:else>暂无历史动态记录</text>
    </view>

    <view class="al-loading-more" wx:if="{{loadingMore}}">
      <text>加载中...</text>
    </view>
    <view class="al-no-more" wx:if="{{!hasMore && historyList.length > 0}}">
      <text>—— 已加载全部历史记录 ——</text>
    </view>
    <view class="fa-safe-area-spacer"></view>

  </scroll-view>

  <!-- 详情弹窗 -->
  <view class="al-modal-mask" wx:if="{{showDetailModal}}" bindtap="onCloseDetail">
    <view class="al-detail-box" style="max-height: calc(100vh - {{contentTop}}px - 20rpx);" catchtap="stopPropagation">
      <view class="al-detail-header">
        <text class="al-detail-title">{{detailItem.title}}</text>
        <text class="al-detail-close" bindtap="onCloseDetail">✕</text>
      </view>
      <text class="al-detail-time">{{detailItem.eventTime}}</text>
      <text class="al-card-category-tag {{detailItem.category ? 'tagged' : ''}}">{{detailItem.categoryLabelText}}</text>

      <scroll-view scroll-y class="al-detail-scroll">
        <view class="al-detail-images" wx:if="{{detailItem.images.length > 0}}">
          <image
            wx:for="{{detailItem.images}}"
            wx:for-item="img"
            wx:key="url"
            class="al-detail-img"
            src="{{img.url}}"
            mode="widthFix"
            bindtap="onPreviewImage"
            data-url="{{img.url}}"
            data-urls="{{detailItem.images}}"
          />
        </view>
        <text class="al-detail-content">{{detailItem.content}}</text>
        <view class="fa-safe-area-spacer"></view>
      </scroll-view>

      <view class="al-detail-actions" wx:if="{{canManage || detailItem.createdBy === currentUserOpenid}}">
        <button class="al-btn-edit" bindtap="onOpenEditForm" data-id="{{detailItem._id}}">编辑</button>
        <button class="al-btn-delete" bindtap="onDeleteLog" data-id="{{detailItem._id}}">删除</button>
      </view>
    </view>
  </view>

  <!-- 发布/编辑表单 -->
  <view class="al-modal-mask" wx:if="{{showEditForm}}" bindtap="onCloseEditForm">
    <view class="al-edit-box" style="max-height: calc(100vh - {{contentTop}}px - 20rpx);" catchtap="stopPropagation">
      <view class="al-detail-header">
        <text class="al-detail-title">{{editForm.id ? '编辑动态' : '发布今日动态'}}</text>
        <text class="al-detail-close" bindtap="onCloseEditForm">✕</text>
      </view>

      <scroll-view scroll-y class="al-edit-scroll">
        <text class="al-form-label">标题</text>
        <input class="al-form-input" placeholder-class="al-input-placeholder" placeholder="如：今日志愿服务启动、门店迎新活动" value="{{editForm.title}}" bindinput="onEditTitleInput" />

        <text class="al-form-label">发生时间</text>
        <picker mode="date" value="{{editForm.eventTime}}" bindchange="onEditTimeChange">
          <view class="al-form-picker">{{editForm.eventTime}}</view>
        </picker>

        <text class="al-form-label">分类（选填）</text>
        <view class="al-category-chip-row">
          <view
            class="al-category-chip {{editForm.category === item.value ? 'active' : ''}}"
            wx:for="{{categoryOptions}}"
            wx:key="value"
            data-value="{{item.value}}"
            bindtap="onSelectCategory"
          >{{item.label}}</view>
        </view>

        <text class="al-form-label">图文内容</text>
        <textarea
          class="al-form-textarea"
          placeholder="在此记录今日的温馨故事、活动花絮或志愿者服务心得..."
          value="{{editForm.content}}"
          bindinput="onEditContentInput"
          maxlength="1000"
        />

        <text class="al-form-label">配图（最多 18 张，自动压缩至 300KB 以内，单张不超过 1MB）</text>
        <view class="al-image-grid">
          <view class="al-image-item" wx:for="{{editForm.images}}" wx:key="*this">
            <image wx:if="{{!thumbFailedMap[item]}}" class="al-image-thumb" src="{{item}}" mode="aspectFill" binderror="onImageLoadError" data-thumb-url="{{item}}" />
            <view wx:else class="thumb-load-failed" catchtap="onRetryImage" data-thumb-url="{{item}}">
              <text class="thumb-load-failed-icon">⚠️</text>
              <text class="thumb-load-failed-text">加载失败</text>
            </view>
            <text class="al-image-remove" bindtap="onRemoveImage" data-index="{{index}}">✕</text>
          </view>
          <view class="al-image-add" bindtap="onChooseImage" wx:if="{{editForm.images.length < 18}}">
            <text>{{uploading ? '压缩中...' : '+ 添加'}}</text>
          </view>
        </view>
        <view class="fa-safe-area-spacer"></view>
      </scroll-view>

      <button class="al-submit-btn" bindtap="onSubmitEdit" disabled="{{uploading}}">提交</button>
    </view>
  </view>

  <!-- 📤 活动海报导出预览 -->
  <view class="al-modal-mask" wx:if="{{showPosterModal}}" bindtap="onClosePosterModal">
    <view class="al-poster-box" style="max-height: calc(100vh - {{contentTop}}px - 20rpx);" catchtap="stopPropagation">
      <view class="al-detail-header">
        <text class="al-detail-title">活动海报</text>
        <text class="al-detail-close" bindtap="onClosePosterModal">✕</text>
      </view>

      <view class="al-poster-canvas-wrapper">
        <canvas type="2d" id="activityPosterCanvas" class="al-poster-canvas" style="width: 320px; height: 560px;"></canvas>
      </view>

      <view class="al-poster-actions">
        <button class="al-btn-poster-save" bindtap="onSavePosterToAlbum" disabled="{{!posterReady}}">💾 保存到相册</button>
        <button class="al-btn-poster-share" open-type="share" disabled="{{!posterReady}}">📤 分享给好友</button>
      </view>
    </view>
  </view>

</view>
