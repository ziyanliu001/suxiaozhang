<view class="settings-container">

  <view class="status-bar-spacer" style="height: {{statusBarHeight}}px;"></view>
  <view class="nav-title-bar" style="height: {{navBarHeight}}px;">
    <view class="nav-back-arrow" hover-class="nav-back-arrow-hover" bindtap="onBackTap">←</view>
    <text class="page-title-txt">设置</text>
    <view class="nav-right-placeholder"></view>
  </view>

  <view class="settings-content">

    <!-- 🆕 头部 Profile 简述 -->
    <view class="profile-summary-card">
      <view class="profile-avatar">{{roleIcon}}</view>
      <view class="profile-info">
        <text class="profile-role">{{roleLabel}}</text>
        <text class="profile-store">📍 {{storeName}}</text>
      </view>
    </view>

    <!-- 🆕 权限与授权组 -->
    <view class="settings-group-label">权限与授权</view>
    <view class="settings-list">
      <view class="settings-item" bindtap="onOpenSystemAuthSetting">
        <text class="settings-item-text">相机权限</text>
        <view class="settings-item-right">
          <text class="auth-status-tag {{cameraAuthStatus}}">
            {{cameraAuthStatus === 'authorized' ? '已授权' : (cameraAuthStatus === 'denied' ? '未授权' : '待确认')}}
          </text>
          <text class="settings-item-arrow">›</text>
        </view>
      </view>
      <view class="settings-item" bindtap="onOpenSystemAuthSetting">
        <text class="settings-item-text">相册权限</text>
        <view class="settings-item-right">
          <text class="auth-status-tag {{albumAuthStatus}}">
            {{albumAuthStatus === 'authorized' ? '已授权' : (albumAuthStatus === 'denied' ? '未授权' : '待确认')}}
          </text>
          <text class="settings-item-arrow">›</text>
        </view>
      </view>
      <view class="settings-item settings-item-switch">
        <view class="settings-item-text-group">
          <text class="settings-item-text">每日未录入餐报提醒</text>
          <text class="settings-item-sub">开启后，当日尚未提交餐报时推送提醒</text>
        </view>
        <switch checked="{{reminderEnabled}}" color="#07C160" bindchange="onToggleReminder" />
      </view>
    </view>

    <!-- 🆕 数据与展示偏好组 -->
    <view class="settings-group-label">数据与展示偏好</view>
    <view class="settings-list">
      <view class="settings-item" bindtap="onSelectDefaultView">
        <text class="settings-item-text">默认首页视图</text>
        <view class="settings-item-right">
          <text class="settings-item-value">{{defaultHomeViewLabel}}</text>
          <text class="settings-item-arrow">›</text>
        </view>
      </view>
      <view class="settings-item settings-item-switch">
        <view class="settings-item-text-group">
          <text class="settings-item-text">隐私与脱敏模式</text>
          <text class="settings-item-sub">开启后，敏感捐赠者姓名/金额将掩码显示</text>
        </view>
        <switch checked="{{privacyMaskEnabled}}" color="#07C160" bindchange="onTogglePrivacyMask" />
      </view>
    </view>

    <!-- 系统运维组 -->
    <view class="settings-group-label">系统运维</view>
    <view class="settings-list">
      <view class="settings-item" bindtap="onTapClearCache">
        <text class="settings-item-text">清理本地缓存</text>
        <view class="settings-item-right">
          <text class="settings-item-value">{{cacheSizeStr}}</text>
          <text class="settings-item-arrow">›</text>
        </view>
      </view>
      <view class="settings-item" bindtap="onTapComplianceReview">
        <text class="settings-item-text">查看合规声明</text>
        <text class="settings-item-arrow">›</text>
      </view>
      <view class="settings-item" bindtap="onTapAbout">
        <text class="settings-item-text">关于本小程序</text>
        <view class="settings-item-right">
          <text class="settings-item-value">v{{appVersion}}{{appEnvLabel ? '（' + appEnvLabel + '）' : ''}}</text>
          <text class="settings-item-arrow">›</text>
        </view>
      </view>
    </view>

    <view class="settings-group-label" wx:if="{{hasPrivilege}}">身份</view>
    <view class="settings-list" wx:if="{{hasPrivilege}}">
      <view class="settings-item settings-item-danger" bindtap="onTapReleaseRole">
        <text class="settings-item-text danger-text">退出当前身份 / 切换身份</text>
        <text class="settings-item-arrow">›</text>
      </view>
    </view>
  </view>

</view>
