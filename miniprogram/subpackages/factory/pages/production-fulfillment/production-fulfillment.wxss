.pf-page {
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  box-sizing: border-box;
  background: #F8F5F0;
}

.pf-body {
  padding: 24rpx;
  box-sizing: border-box;
}

.pf-switcher-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.pf-switcher-bar-hover {
  opacity: 0.6;
}

.pf-switcher-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.pf-switcher-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pf-switcher-arrow {
  color: #8E8E93;
  font-size: 24rpx;
  margin-left: 12rpx;
}

.pf-space-list {
  margin-bottom: 20rpx;
}

.pf-space-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  background: #F8F5F0;
}

.pf-space-item-active {
  background: rgba(140, 29, 24, 0.08);
  border: 2rpx solid rgba(140, 29, 24, 0.3);
}

.pf-space-item-text {
  display: flex;
  flex-direction: column;
}

.pf-space-item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 6rpx;
}

.pf-space-item-role {
  font-size: 22rpx;
  color: #8E8E93;
}

.pf-space-item-check {
  color: #8C1D18;
  font-size: 32rpx;
  font-weight: 700;
}

.pf-quick-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.pf-quick-action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 22rpx 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.12s ease, opacity 0.12s ease;
}

/* 🎨 按压反馈：轻微缩放 + 半透明，替代此前只有单一透明度变化的反馈态，
   触感更接近原生 App 的按压效果 */
.pf-quick-action-item-hover {
  transform: scale(0.96);
  opacity: 0.75;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.pf-quick-action-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
  line-height: 1;
}

.pf-quick-action-text {
  font-size: 24rpx;
  color: #1C1C1E;
  line-height: 1.3;
}

.pf-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pf-modal-card {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}

.pf-modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1C1C1E;
  text-align: center;
  margin-bottom: 32rpx;
}

.pf-invite-role-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.pf-invite-role-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #8E8E93;
  background: #F0EBE3;
  line-height: 72rpx;
  border-radius: 12rpx;
}

.pf-invite-role-tab.active {
  background: #8C1D18;
  color: #FFFFFF;
  font-weight: 600;
}

.pf-field-label {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
  margin-bottom: 12rpx;
}

.pf-picker-value {
  height: 80rpx;
  line-height: 80rpx;
  box-sizing: border-box;
  border: 2rpx solid #E5DED4;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1C1C1E;
  margin-bottom: 20rpx;
}

.pf-picker-placeholder {
  color: #999999;
}

.pf-input {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  box-sizing: border-box;
  border: 2rpx solid #E5DED4;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1C1C1E;
  margin-bottom: 20rpx;
}

.pf-input-placeholder {
  color: #999999;
  font-size: 28rpx;
}

.pf-primary-btn {
  background: #8C1D18;
  color: #FFFFFF;
  font-size: 30rpx;
  line-height: 84rpx;
  border-radius: 12rpx;
}

.pf-primary-btn[disabled] {
  background: #D8CFC7;
  color: #FFFFFF;
  opacity: 1;
}

.pf-secondary-btn {
  background: #F0EBE3;
  color: #8E8E93;
  font-size: 28rpx;
  line-height: 76rpx;
  border-radius: 12rpx;
  margin-top: 20rpx;
}

.pf-invite-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0 24rpx;
}

.pf-invite-code {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: #1C1C1E;
  margin-bottom: 8rpx;
}

.pf-invite-hint {
  font-size: 24rpx;
  color: #8E8E93;
  margin-bottom: 24rpx;
}

.pf-invite-qr {
  width: 320rpx;
  height: 320rpx;
  margin-bottom: 12rpx;
}

.pf-invite-qr-tip {
  font-size: 22rpx;
  color: #ADADB2;
  text-align: center;
}

.pf-loading-state,
.pf-error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: #8E8E93;
  font-size: 28rpx;
}

.pf-error-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.pf-error-text {
  margin-bottom: 24rpx;
  text-align: center;
}

.pf-retry-btn {
  font-size: 28rpx;
  background: #8C1D18;
  color: #FFFFFF;
  padding: 0 40rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
}

/* 🎨 履约状态筛选 Tab：常驻卡片，工坊主题红底白字表示选中态，与页面其余
   按钮/批次指示点同一套主色，视觉上是同一个语言体系 */
.pf-status-tabs {
  display: flex;
  gap: 8rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.pf-status-tab {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #6B6B70;
  line-height: 60rpx;
  border-radius: 12rpx;
  transition: background-color 0.15s ease, color 0.15s ease;
}

.pf-status-tab.active {
  background: #8C1D18;
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(140, 29, 24, 0.3);
}

/* 🎨 富态空状态：仅在整个工坊近 30 天内一笔订单都没有时出现 */
.pf-empty-state {
  display: flex;
  justify-content: center;
  padding: 60rpx 40rpx;
}

.pf-empty-card {
  width: 100%;
  max-width: 560rpx;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 56rpx 40rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  border: 1.5rpx solid rgba(255, 255, 255, 0.6);
}

.pf-empty-icon-badge {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(140, 29, 24, 0.08), rgba(230, 162, 60, 0.12));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}

.pf-empty-icon {
  font-size: 64rpx;
  line-height: 1;
}

.pf-empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 10rpx;
}

.pf-empty-subtitle {
  font-size: 24rpx;
  color: #8E8E93;
  text-align: center;
  line-height: 36rpx;
  margin-bottom: 32rpx;
}

.pf-empty-actions {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.pf-empty-action-btn {
  flex: 1;
  font-size: 26rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: #F0EBE3;
  color: #6B6B70;
  padding: 0 8rpx;
}

.pf-empty-action-btn.primary {
  background: #8C1D18;
  color: #FFFFFF;
  font-weight: 600;
}

/* 🎨 筛选后无匹配：轻量提示，区别于上面"整个工坊都没有订单"的富态空状态卡片 */
.pf-filter-empty {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

.pf-filter-empty-text {
  font-size: 26rpx;
  color: #ADADB2;
}

.pf-selfheal-banner {
  display: flex;
  align-items: center;
  background: rgba(230, 162, 60, 0.12);
  border: 2rpx solid rgba(230, 162, 60, 0.35);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.pf-selfheal-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.pf-selfheal-text {
  flex: 1;
  font-size: 24rpx;
  color: #8A5A1E;
  line-height: 34rpx;
}

.pf-selfheal-close {
  font-size: 24rpx;
  color: #8A5A1E;
  padding: 0 8rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.pf-materials-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.pf-materials-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 12rpx;
}

.pf-materials-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.pf-material-chip {
  font-size: 22rpx;
  color: #6B6B70;
  background: #F8F5F0;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.pf-batch-section {
  margin-bottom: 28rpx;
}

.pf-batch-header {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border-left: 6rpx solid #D8CFC7;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.pf-batch-header.pf-capacity-near_full {
  border-left-color: #E6A23C;
}

.pf-batch-header.pf-capacity-full {
  border-left-color: #C0392B;
}

.pf-batch-date {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-bottom: 12rpx;
}

.pf-batch-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.pf-chip {
  font-size: 22rpx;
  color: #6B6B70;
  background: #F0EBE3;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.pf-chip-near_full {
  color: #A56A1D;
  background: rgba(230, 162, 60, 0.14);
}

.pf-chip-full {
  color: #C0392B;
  background: rgba(192, 57, 43, 0.1);
}

.pf-batch-rollover-hint {
  display: block;
  font-size: 22rpx;
  color: #C0392B;
  margin-top: 12rpx;
}

.pf-status-section {
  margin-bottom: 12rpx;
}

.pf-status-header {
  display: flex;
  align-items: center;
  padding: 8rpx 8rpx 8rpx 4rpx;
}

.pf-status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #8C1D18;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.pf-status-header-pending .pf-status-dot { background: #8C1D18; }
.pf-status-header-producing .pf-status-dot { background: #E6A23C; }
.pf-status-header-shipped .pf-status-dot { background: #2E7D32; }
.pf-status-header-refunded .pf-status-dot { background: #8E8E93; }

.pf-status-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.pf-status-count {
  font-size: 22rpx;
  color: #8E8E93;
  margin-left: 8rpx;
}

.pf-order-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.pf-order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.pf-order-product {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.pf-order-status {
  font-size: 22rpx;
  color: #8C1D18;
  background: rgba(140, 29, 24, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.pf-order-status-producing {
  color: #A56A1D;
  background: rgba(230, 162, 60, 0.12);
}

.pf-order-status-shipped {
  color: #2E7D32;
  background: rgba(46, 125, 50, 0.08);
}

.pf-order-status-refunded {
  color: #8E8E93;
  background: rgba(142, 142, 147, 0.08);
}

.pf-order-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.pf-order-label {
  font-size: 26rpx;
  color: #8E8E93;
}

.pf-order-value {
  font-size: 26rpx;
  color: #1C1C1E;
}

.pf-ship-btn {
  margin-top: 20rpx;
  font-size: 28rpx;
  background: #8C1D18;
  color: #FFFFFF;
  line-height: 76rpx;
  border-radius: 12rpx;
}

.pf-ship-btn[disabled] {
  background: #D8CFC7;
  color: #FFFFFF;
}
