.mo-page {
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  box-sizing: border-box;
  background: #F8F5F0;
}

.mo-body {
  padding: 0 24rpx;
  box-sizing: border-box;
}

.mo-loading-state,
.mo-error-state,
.mo-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  color: #8E8E93;
  font-size: 28rpx;
}

.mo-error-icon,
.mo-empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.mo-error-text,
.mo-empty-text {
  margin-bottom: 24rpx;
  text-align: center;
}

.mo-retry-btn {
  font-size: 28rpx;
  background: #8C1D18;
  color: #FFFFFF;
  padding: 0 40rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
}

.mo-order-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.mo-order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
}

.mo-order-info {
  flex: 1;
  min-width: 0;
}

.mo-order-product {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 6rpx;
}

.mo-order-workshop {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
}

.mo-order-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.mo-order-status {
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(140, 29, 24, 0.08);
  color: #8C1D18;
  margin-bottom: 8rpx;
}

.mo-status-pending_payment {
  background: rgba(142, 142, 147, 0.12);
  color: #8E8E93;
}

.mo-status-pending {
  background: rgba(199, 123, 46, 0.12);
  color: #C77B2E;
}

.mo-status-producing {
  background: rgba(61, 139, 139, 0.12);
  color: #3D8B8B;
}

.mo-status-shipped {
  background: rgba(46, 125, 50, 0.12);
  color: #2E7D32;
}

.mo-status-refunded,
.mo-status-failed {
  background: rgba(142, 142, 147, 0.12);
  color: #8E8E93;
}

.mo-order-amount {
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.mo-order-detail {
  padding: 0 24rpx 24rpx;
  border-top: 1rpx solid #F0EBE3;
}

.mo-detail-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 24rpx;
}

.mo-detail-label {
  color: #8E8E93;
}

.mo-detail-value {
  color: #1C1C1E;
}

.mo-charity-card {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  background: #F3F7F0;
  border-radius: 12rpx;
  border: 2rpx solid #DCE8D6;
}

.mo-charity-title {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #4E7A45;
  margin-bottom: 6rpx;
}

.mo-charity-text {
  display: block;
  font-size: 22rpx;
  color: #2E5528;
}

.mo-charity-status {
  display: block;
  font-size: 20rpx;
  color: #6B9560;
  margin-top: 4rpx;
}

.mo-charity-empty {
  display: block;
  font-size: 22rpx;
  color: #ADADB2;
}
