.mo-page {
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  box-sizing: border-box;
  background: #F8F5F0;
}

.mo-body {
  padding: 0 24rpx;
  box-sizing: border-box;
}

.mo-loading-state,
.mo-error-state,
.mo-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  color: #8E8E93;
  font-size: 28rpx;
}

.mo-error-icon,
.mo-empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.mo-error-text,
.mo-empty-text {
  margin-bottom: 24rpx;
  text-align: center;
}

.mo-retry-btn {
  font-size: 28rpx;
  background: #8C1D18;
  color: #FFFFFF;
  padding: 0 40rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
}

/* 🆕 页面本地 hover 效果——WXSS 是页面级作用域，不能假设别的页面定义过
   的 .btn-hover 在这里也生效 */
.btn-hover {
  opacity: 0.7;
}

/* 🆕 状态筛选 Tab：固定在滚动区之上，不随列表滚动 */
.mo-tab-row {
  display: flex;
  gap: 12rpx;
  padding-bottom: 20rpx;
}

.mo-tab-item {
  flex: 1;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  font-size: 24rpx;
  background: #FFFFFF;
  color: #666666;
}

.mo-tab-item.active {
  background: #8C1D18;
  color: #FFFFFF;
  font-weight: bold;
}

.mo-order-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.mo-order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx;
}

.mo-order-info {
  flex: 1;
  min-width: 0;
}

.mo-order-product {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 6rpx;
}

.mo-order-workshop {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
}

/* 🆕 订单号 + 下单时间：折叠态就可见的核对信息 */
.mo-order-meta {
  display: block;
  font-size: 20rpx;
  color: #ADADB2;
  margin-top: 4rpx;
}

.mo-order-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.mo-order-status {
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(140, 29, 24, 0.08);
  color: #8C1D18;
  margin-bottom: 8rpx;
}

.mo-status-pending_payment {
  background: rgba(142, 142, 147, 0.12);
  color: #8E8E93;
}

.mo-status-pending {
  background: rgba(199, 123, 46, 0.12);
  color: #C77B2E;
}

.mo-status-producing {
  background: rgba(61, 139, 139, 0.12);
  color: #3D8B8B;
}

.mo-status-shipped {
  background: rgba(46, 125, 50, 0.12);
  color: #2E7D32;
}

.mo-status-refunded,
.mo-status-failed {
  background: rgba(142, 142, 147, 0.12);
  color: #8E8E93;
}

.mo-order-amount {
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1C1E;
}

/* 🆕 已发货物流信息条：常驻展示，不藏进展开区。配色用中性浅绿灰调
   （呼应已发货状态徽章 .mo-status-shipped 的绿色系），与"需要处理"的橙色
   失败提示条区分开——物流信息是正向/中性状态，不是待办事项 */
.mo-shipping-box {
  margin: 0 26rpx 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(46, 125, 50, 0.06);
  border: 1rpx solid rgba(46, 125, 50, 0.16);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.mo-shipping-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #1C1C1E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 淡灰兜底文案：单号为空/商家自主配送——与 .mo-shipping-text 同一行高，
   保持有无单号两种情况下卡片布局一致，不会因为少了复制按钮而高度跳动 */
.mo-shipping-empty {
  font-size: 24rpx;
  color: #ADADB2;
}

/* 🆕 下单失败提示条：浅橙色调，与项目里其余"锁定/需处理"提示同一套克制
   配色语言（不用红色告警色，失败订单不是安全事故），折叠态就常驻可见 */
.mo-fail-box {
  margin: 0 26rpx 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(217, 72, 14, 0.06);
  border: 1rpx solid rgba(217, 72, 14, 0.18);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.mo-fail-reason {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #7C2D12;
  line-height: 1.5;
}

.mo-fail-retry-btn {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #C2410C;
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
}

.mo-order-detail {
  padding: 0 24rpx 24rpx;
  border-top: 1rpx solid #F0EBE3;
}

.mo-detail-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 24rpx;
}

.mo-detail-label {
  color: #8E8E93;
}

.mo-detail-value {
  color: #1C1C1E;
}

/* 🆕 物流单号行：值 + 复制按钮同一行右对齐，与其余 .mo-detail-row 保持
   左右两端对齐的整体节奏 */
.mo-detail-row-tracking {
  align-items: center;
}

.mo-tracking-value-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mo-copy-btn {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  color: #8C1D18;
  background: rgba(140, 29, 24, 0.08);
  border-radius: 16rpx;
  padding: 4rpx 16rpx;
}

.mo-charity-card {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  background: #F3F7F0;
  border-radius: 12rpx;
  border: 2rpx solid #DCE8D6;
}

.mo-charity-title {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #4E7A45;
  margin-bottom: 6rpx;
}

.mo-charity-text {
  display: block;
  font-size: 22rpx;
  color: #2E5528;
}

.mo-charity-status {
  display: block;
  font-size: 20rpx;
  color: #6B9560;
  margin-top: 4rpx;
}

.mo-charity-empty {
  display: block;
  font-size: 22rpx;
  color: #ADADB2;
}
