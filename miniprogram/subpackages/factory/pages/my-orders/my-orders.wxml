<view class="mo-page">

  <navigation-bar
    title="工坊订单"
    background="#8C1D18"
    color="#FFFFFF"
    dark="{{true}}"
    back="{{true}}"
    showHomeButton="auto"
    bind:layout="onNavLayout"
  ></navigation-bar>

  <view class="mo-body" style="margin-top: 28rpx;">

    <view class="mo-loading-state" wx:if="{{loading && orders.length === 0}}">
      <text>加载中...</text>
    </view>

    <view class="mo-error-state" wx:elif="{{loadError}}">
      <text class="mo-error-icon">⚠️</text>
      <text class="mo-error-text">{{loadError}}</text>
      <button class="mo-retry-btn" bindtap="loadOrders">重试</button>
    </view>

    <view class="mo-empty-state" wx:elif="{{orders.length === 0}}">
      <text class="mo-empty-icon">🛒</text>
      <text class="mo-empty-text">还没有下过工坊订单，去逛逛吧</text>
    </view>

    <block wx:else>

      <!-- 🆕 状态筛选 Tab：本地过滤已加载好的 orders（tabBucket 已在
           loadOrders 里预先算好），不为每个 Tab 单独发云调用 -->
      <view class="mo-tab-row">
        <view
          wx:for="{{tabOptions}}"
          wx:key="value"
          class="mo-tab-item {{activeTab === item.value ? 'active' : ''}}"
          data-tab="{{item.value}}"
          bindtap="onSwitchTab"
        >{{item.label}}</view>
      </view>

      <scroll-view class="mo-scroll" scroll-y style="height: calc(100vh - {{contentTop}}px - 88rpx);">

        <view class="mo-empty-state" wx:if="{{visibleCount === 0}}">
          <text class="mo-empty-icon">📭</text>
          <text class="mo-empty-text">当前筛选下暂无订单</text>
        </view>

        <view
          class="mo-order-card"
          wx:for="{{orders}}"
          wx:key="orderId"
          wx:for-index="index"
          wx:if="{{activeTab === 'all' || item.tabBucket === activeTab}}"
        >
          <view class="mo-order-top" data-index="{{index}}" bindtap="onToggleExpand">
            <view class="mo-order-info">
              <text class="mo-order-product">{{item.productName}}</text>
              <text class="mo-order-workshop">{{item.workshopName}} · {{item.quantity}} 份</text>
              <!-- 🆕 订单号 + 下单时间：折叠态就可见，方便核对，不需要展开 -->
              <text class="mo-order-meta">订单号 {{item.orderId}}<block wx:if="{{item.createdAtLabel}}"> · {{item.createdAtLabel}}</block></text>
            </view>
            <view class="mo-order-right">
              <text class="mo-order-status mo-status-{{item.statusClass}}">{{item.statusLabel}}</text>
              <text class="mo-order-amount">¥{{item.payAmountYuan}}</text>
            </view>
          </view>

          <!-- 🆕 已发货：物流信息常驻展示在订单号下方，不藏进展开区——此前
               单号+复制按钮只在展开区才看得到，用户第一眼看不出有这个功能。
               有单号展示"快递公司 单号"+复制按钮；没有单号（商家自主配送/
               尚未录入）淡灰兜底文案，保持两种情况下卡片布局一致 -->
          <view class="mo-shipping-box" wx:if="{{item.orderStatus === 'shipped'}}">
            <block wx:if="{{item.trackingNumber}}">
              <text class="mo-shipping-text">{{item.expressCompany}} {{item.trackingNumber}}</text>
              <view class="mo-copy-btn" hover-class="btn-hover" catchtap="onCopyTrackingNumber" data-tracking="{{item.trackingNumber}}">复制单号</view>
            </block>
            <text class="mo-shipping-empty" wx:else>暂无运单号 / 商家自主配送</text>
          </view>

          <!-- 🆕 下单失败：折叠态直接可见，不藏进展开区——核心诉求是立刻
               引导重新下单，不该增加多一次点击才能看到 -->
          <view class="mo-fail-box" wx:if="{{item.orderStatus === 'failed'}}">
            <text class="mo-fail-reason">{{item.failReason || '下单失败，具体原因暂未记录，可重新下单试试'}}</text>
            <view
              class="mo-fail-retry-btn"
              hover-class="btn-hover"
              catchtap="onRetryOrder"
              data-tenantid="{{item.tenantId}}"
              data-productid="{{item.productId}}"
            >重新下单</view>
          </view>

          <view class="mo-order-detail" wx:if="{{item.expanded}}">
            <view class="mo-detail-row" wx:if="{{item.batchDate}}">
              <text class="mo-detail-label">批次日期</text>
              <text class="mo-detail-value">{{item.batchDate}}</text>
            </view>
            <view class="mo-detail-row" wx:if="{{item.estimatedShippingDate}}">
              <text class="mo-detail-label">预计发货</text>
              <text class="mo-detail-value">{{item.estimatedShippingDate}}</text>
            </view>
            <!-- 已发货订单的物流信息已经改为常驻展示在卡片顶部
                 （.mo-shipping-box），这里不再重复展示一遍；非 shipped 状态
                 理论上不会有 trackingNumber，保留这行只作兜底 -->
            <view class="mo-detail-row mo-detail-row-tracking" wx:if="{{item.trackingNumber && item.orderStatus !== 'shipped'}}">
              <text class="mo-detail-label">物流单号</text>
              <view class="mo-tracking-value-row">
                <text class="mo-detail-value">{{item.expressCompany}} {{item.trackingNumber}}</text>
                <view class="mo-copy-btn" hover-class="btn-hover" catchtap="onCopyTrackingNumber" data-tracking="{{item.trackingNumber}}">复制</view>
              </view>
            </view>
            <view class="mo-detail-row" wx:if="{{item.appliedTierLevel > 0}}">
              <text class="mo-detail-label">成交方式</text>
              <text class="mo-detail-value">拼团价（满{{item.appliedTierLevel}}件档）</text>
            </view>

            <!-- 🌾（护城河一 M1）善行反哺凭据：有真实转捐记录才显示金额，
                 没有就如实显示"暂无"，不伪造进度条/数字 -->
            <view class="mo-charity-card">
              <text class="mo-charity-title">🌾 善行反哺凭据</text>
              <block wx:if="{{item.charityContribution}}">
                <text class="mo-charity-text">已转捐 ¥{{item.charityContribution.amountYuan}} 至 {{item.charityContribution.targetStoreName}}</text>
                <text class="mo-charity-status">{{item.charityContribution.pledgeStatusLabel}}</text>
              </block>
              <text class="mo-charity-empty" wx:else>该订单尚未产生转捐记录</text>
            </view>
          </view>
        </view>
      </scroll-view>

    </block>

  </view>

</view>
