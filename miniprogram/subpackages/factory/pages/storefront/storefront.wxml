<view class="sf-page">

  <navigation-bar
    title="🛒 现做现发"
    background="#8C1D18"
    color="#FFFFFF"
    dark="{{true}}"
    back="{{true}}"
    showHomeButton="auto"
    bind:layout="onNavLayout"
  ></navigation-bar>

  <!-- 🐛 2026-09-06 修复：margin-top 不再叠加 navigation-bar 已占用的
       totalHeight，只留 24rpx 呼吸边距；内层 .sf-scroll 的 height calc 不动 -->
  <view class="sf-body" style="margin-top: 24rpx;">

    <view class="sf-loading-state" wx:if="{{loading && !product}}">
      <text>加载中...</text>
    </view>

    <view class="sf-error-state" wx:elif="{{loadError}}">
      <text class="sf-error-icon">⚠️</text>
      <text class="sf-error-text">{{loadError}}</text>
      <button class="sf-retry-btn" bindtap="loadAll">重试</button>
    </view>

    <scroll-view class="sf-scroll" scroll-y style="height: calc(100vh - {{contentTop}}px);" wx:elif="{{product}}">

      <view class="sf-product-card">
        <text class="sf-product-name">{{product.name}}</text>
        <text class="sf-product-price">¥{{product.priceYuan}}</text>
        <text class="sf-product-note">下单后按现有产能自动排期，{{product.leadTimeDays}} 天起制作</text>
        <text class="sf-product-desc" wx:if="{{product.description}}">{{product.description}}</text>

        <!-- 🏛️（方向 B）今日产能进度：一眼看到"手慢无" -->
        <view class="sf-capacity-progress" wx:if="{{capacityProgress}}">
          <view class="sf-capacity-progress-track">
            <view class="sf-capacity-progress-fill sf-capacity-{{capacityProgress.urgencyClass}}" style="width: {{capacityProgress.percentLocked}}%;"></view>
          </view>
          <text class="sf-capacity-progress-text sf-capacity-text-{{capacityProgress.urgencyClass}}">
            {{capacityProgress.batchDate}} 产能已锁 {{capacityProgress.percentLocked}}% · 仅剩 {{capacityProgress.remaining}} 份
          </text>
        </view>
      </view>

      <!-- 🏛️（方向 B）支付前反哺说明：固定文案，不承诺具体反哺数字——
           charity_contributions 是工坊主结算后自主选择是否转捐，下单页不能
           对买家做系统不保证的承诺，实际是否发生反哺以「我的工坊订单」里的
           真实记录为准 -->
      <view class="sf-charity-note">
        <text class="sf-charity-note-text">🌾 本工坊践行"以产养善"——所得盈利部分可能定向转捐雨花公益厨房，具体反哺记录可在「我的工坊订单」中查看</text>
      </view>

      <view class="sf-calendar-card" wx:if="{{calendar.length > 0}}">
        <view class="sf-calendar-header">
          <text class="sf-section-title">预售日历</text>
          <text class="sf-calendar-hint">{{selectedBatchDate ? '已选 ' + selectedBatchDate + '，再点一次可取消' : '点选日期可指定批次，不选则自动排最早可用批次'}}</text>
        </view>
        <scroll-view class="sf-calendar-scroll" scroll-x>
          <view
            class="sf-calendar-item {{item.soldOut ? 'sf-sold-out' : 'sf-selectable'}} {{!item.soldOut && item.remaining <= 3 ? 'sf-low-stock' : ''}} {{selectedBatchDate === item.batchDate ? 'sf-selected' : ''}}"
            wx:for="{{calendar}}"
            wx:key="batchDate"
            data-date="{{item.batchDate}}"
            bindtap="onSelectBatchDate"
          >
            <text class="sf-calendar-check" wx:if="{{selectedBatchDate === item.batchDate}}">✓</text>
            <text class="sf-calendar-groupbuy-tag" wx:if="{{item.groupBuyBatch}}">🎉拼团</text>
            <text class="sf-calendar-date">{{item.batchDate}}</text>
            <text class="sf-calendar-remaining" wx:if="{{item.soldOut}}">已约满</text>
            <text class="sf-calendar-remaining" wx:else>仅剩 {{item.remaining}} 份</text>
          </view>
        </scroll-view>
        <view class="sf-calendar-legend">
          <view class="sf-legend-item"><view class="sf-legend-dot sf-legend-dot-normal"></view><text>可预订</text></view>
          <view class="sf-legend-item"><view class="sf-legend-dot sf-legend-dot-low"></view><text>库存紧张</text></view>
          <view class="sf-legend-item"><view class="sf-legend-dot sf-legend-dot-full"></view><text>已约满</text></view>
        </view>

        <!-- 🏛️（护城河二）拼团阶梯预览：只在选中的日期挂了拼团批次时展示 -->
        <view class="sf-groupbuy-card" wx:if="{{groupBuyPreview}}">
          <view class="sf-groupbuy-header">
            <text class="sf-groupbuy-title">🎉 拼团进行中</text>
            <text class="sf-groupbuy-price">¥{{groupBuyPreview.unitPriceYuan}}/份</text>
          </view>
          <text class="sf-groupbuy-sub">当前已认购 {{groupBuyPreview.committedQuantity}} 份 · {{groupBuyPreview.nextTierHint}}</text>

          <!-- 🏛️（方向 B）阶梯梯度全量展示：当前档高亮，已解锁档打勾灰显 -->
          <view class="sf-tier-ladder" wx:if="{{groupBuyPreview.tierRows.length > 0}}">
            <view
              class="sf-tier-row {{item.isCurrent ? 'sf-tier-current' : ''}} {{item.isReached ? 'sf-tier-reached' : ''}}"
              wx:for="{{groupBuyPreview.tierRows}}"
              wx:key="minQuantity"
            >
              <text class="sf-tier-check" wx:if="{{item.isReached}}">✓</text>
              <text class="sf-tier-qty">满{{item.minQuantity}}件</text>
              <text class="sf-tier-price">¥{{item.priceYuan}}</text>
            </view>
          </view>

          <text class="sf-groupbuy-disclaimer">最终成交价以下单时实际结算为准</text>
        </view>
      </view>

      <view class="sf-order-card">
        <text class="sf-section-title">数量</text>
        <view class="sf-qty-stepper">
          <view class="sf-qty-btn" bindtap="onDecreaseQty">－</view>
          <text class="sf-qty-value">{{quantity}}</text>
          <view class="sf-qty-btn" bindtap="onIncreaseQty">＋</view>
        </view>
        <button class="sf-order-btn" loading="{{placing}}" bindtap="onTapOrder">立即预订</button>
      </view>

      <view class="sf-other-card" wx:if="{{otherProducts.length > 0}}">
        <text class="sf-section-title">本店其他商品</text>
        <view class="sf-other-item" wx:for="{{otherProducts}}" wx:key="_id" data-id="{{item._id}}" bindtap="onTapOtherProduct">
          <text class="sf-other-name">{{item.name}}</text>
          <text class="sf-other-price">¥{{item.priceYuan}}</text>
        </view>
      </view>

    </scroll-view>

  </view>

</view>
