.sf-page {
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  box-sizing: border-box;
  background: #F8F5F0;
}

.sf-body {
  padding: 24rpx;
  box-sizing: border-box;
}

.sf-loading-state,
.sf-error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: #8E8E93;
  font-size: 28rpx;
}

.sf-error-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.sf-error-text {
  margin-bottom: 24rpx;
  text-align: center;
}

.sf-retry-btn {
  font-size: 28rpx;
  background: #8C1D18;
  color: #FFFFFF;
  padding: 0 40rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
}

.sf-product-card,
.sf-calendar-card,
.sf-order-card,
.sf-other-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.sf-product-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-bottom: 8rpx;
}

.sf-product-price {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #8C1D18;
  margin-bottom: 12rpx;
}

.sf-product-note {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
}

.sf-product-desc {
  display: block;
  font-size: 26rpx;
  line-height: 40rpx;
  color: #4A4A4E;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0EBE3;
}

.sf-section-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #8E8E93;
  margin-bottom: 16rpx;
}

.sf-calendar-header {
  margin-bottom: 16rpx;
}

.sf-calendar-header .sf-section-title {
  margin-bottom: 6rpx;
}

.sf-calendar-hint {
  display: block;
  font-size: 22rpx;
  color: #ADADB2;
}

.sf-calendar-scroll {
  white-space: nowrap;
}

.sf-calendar-item {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  background: #F8F5F0;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-right: 16rpx;
}

/* 🎨 可选日期高亮：绿色描边 + 浅绿底色，一眼看出"这天能订" */
.sf-selectable {
  background: rgba(46, 125, 50, 0.06);
  border-color: rgba(46, 125, 50, 0.24);
}

/* 🎨 库存紧张（剩余 ≤3 份）：橙色强调，营造"仅剩 X 份"的紧迫感 */
.sf-low-stock {
  background: rgba(199, 123, 46, 0.08);
  border-color: rgba(199, 123, 46, 0.32);
}

/* 已约满：灰底灰字，弱化视觉权重，与可选日期形成对比 */
.sf-sold-out {
  background: #F0EEEA;
  opacity: 0.7;
}

/* 🎯 选中态：实心主色描边 + 角标勾选，与"可选/紧张"两种未选中态明显区分 */
.sf-selected {
  border-color: #8C1D18;
  background: rgba(140, 29, 24, 0.06);
  position: relative;
}

.sf-calendar-check {
  position: absolute;
  top: -10rpx;
  right: -6rpx;
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 20rpx;
  color: #FFFFFF;
  background: #8C1D18;
  border-radius: 50%;
}

.sf-calendar-date {
  font-size: 24rpx;
  color: #1C1C1E;
  margin-bottom: 6rpx;
}

.sf-calendar-remaining {
  font-size: 22rpx;
  font-weight: 600;
  color: #2E7D32;
}

.sf-low-stock .sf-calendar-remaining {
  color: #C77B2E;
}

.sf-sold-out .sf-calendar-remaining {
  font-weight: 400;
  color: #ADADB2;
}

.sf-calendar-legend {
  display: flex;
  gap: 24rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0EBE3;
}

.sf-legend-item {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #8E8E93;
}

.sf-legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 6rpx;
}

.sf-legend-dot-normal {
  background: #2E7D32;
}

.sf-legend-dot-low {
  background: #C77B2E;
}

.sf-legend-dot-full {
  background: #ADADB2;
}

/* 🏛️（护城河二）拼团标签 + 阶梯价预览卡片 */
.sf-calendar-groupbuy-tag {
  position: absolute;
  top: -10rpx;
  left: -6rpx;
  font-size: 18rpx;
  line-height: 28rpx;
  padding: 0 8rpx;
  color: #FFFFFF;
  background: #E8770F;
  border-radius: 8rpx;
}

.sf-groupbuy-card {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #FFF7ED;
  border: 2rpx solid #F5C99A;
  border-radius: 12rpx;
}

.sf-groupbuy-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.sf-groupbuy-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #E8770F;
}

.sf-groupbuy-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #8C1D18;
}

.sf-groupbuy-sub {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
  margin-bottom: 4rpx;
}

.sf-groupbuy-disclaimer {
  display: block;
  font-size: 20rpx;
  color: #ADADB2;
}

/* 🏛️（方向 B）阶梯梯度全量展示 */
.sf-tier-ladder {
  display: flex;
  gap: 12rpx;
  margin: 12rpx 0;
  overflow-x: auto;
  white-space: nowrap;
}

.sf-tier-row {
  position: relative;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 100rpx;
  padding: 10rpx 14rpx;
  background: #FFFFFF;
  border: 2rpx solid #F0E4D4;
  border-radius: 10rpx;
}

.sf-tier-row.sf-tier-reached {
  border-color: #D9B98C;
  opacity: 0.7;
}

.sf-tier-row.sf-tier-current {
  border-color: #8C1D18;
  background: #FDF1EE;
  opacity: 1;
}

.sf-tier-check {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  font-size: 18rpx;
  color: #FFFFFF;
  background: #8C9A7C;
  border-radius: 50%;
}

.sf-tier-qty {
  font-size: 20rpx;
  color: #8E8E93;
}

.sf-tier-price {
  font-size: 24rpx;
  font-weight: 700;
  color: #8C1D18;
  margin-top: 2rpx;
}

.sf-tier-row.sf-tier-current .sf-tier-qty {
  color: #A85C3A;
}

/* 🏛️（方向 B）今日产能进度条 */
.sf-capacity-progress {
  margin-top: 16rpx;
}

.sf-capacity-progress-track {
  width: 100%;
  height: 12rpx;
  background: #F0EBE3;
  border-radius: 6rpx;
  overflow: hidden;
}

.sf-capacity-progress-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.sf-capacity-normal {
  background: #2E7D32;
}

.sf-capacity-low {
  background: #C77B2E;
}

.sf-capacity-full {
  background: #ADADB2;
}

.sf-capacity-progress-text {
  display: block;
  font-size: 20rpx;
  margin-top: 8rpx;
}

.sf-capacity-text-normal {
  color: #2E7D32;
}

.sf-capacity-text-low {
  color: #C77B2E;
}

.sf-capacity-text-full {
  color: #8E8E93;
}

/* 🏛️（方向 B）支付前反哺说明——固定文案，克制的浅底提示条，不喧宾夺主 */
.sf-charity-note {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: #F3F7F0;
  border-radius: 12rpx;
  border: 2rpx solid #DCE8D6;
}

.sf-charity-note-text {
  font-size: 22rpx;
  color: #4E7A45;
  line-height: 32rpx;
}

.sf-qty-stepper {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.sf-qty-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F0EBE3;
  border-radius: 12rpx;
  font-size: 32rpx;
  color: #1C1C1E;
}

.sf-qty-value {
  width: 96rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}

.sf-order-btn {
  background: #8C1D18;
  color: #FFFFFF;
  font-size: 30rpx;
  line-height: 84rpx;
  border-radius: 12rpx;
}

.sf-other-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1rpx solid #F0EBE3;
}

.sf-other-name {
  font-size: 26rpx;
  color: #1C1C1E;
}

.sf-other-price {
  font-size: 26rpx;
  color: #8C1D18;
  font-weight: 600;
}
