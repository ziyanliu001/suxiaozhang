.pm-page {
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  box-sizing: border-box;
  background: #F8F5F0;
}

.pm-body {
  padding: 24rpx;
  box-sizing: border-box;
}

.pm-header-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.pm-create-btn {
  flex: 1;
  background: #8C1D18;
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  margin-bottom: 0;
}

/* 🏛️（M0）支付与分账设置入口：与"新建商品"同宽两列，视觉权重次于主操作，
   用浅底描边而不是实底红色，避免抢"新建商品"的焦点 */
.pm-settings-btn {
  flex: 1;
  background: #FFFFFF;
  color: #8C1D18;
  border: 2rpx solid #8C1D18;
  font-size: 28rpx;
  line-height: 76rpx;
  border-radius: 12rpx;
}

.pm-form-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.pm-form-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-bottom: 24rpx;
}

.pm-field-label {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
  margin-bottom: 8rpx;
}

/* height/line-height 显式对齐，避免不同机型下 input 文字垂直偏移 */
.pm-input {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  box-sizing: border-box;
  border: 2rpx solid #E5DED4;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1C1C1E;
  margin-bottom: 20rpx;
  transition: border-color 0.15s ease;
}

.pm-input:focus {
  border-color: #8C1D18;
}

.pm-textarea {
  width: 100%;
  height: 160rpx;
  box-sizing: border-box;
  border: 2rpx solid #E5DED4;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #1C1C1E;
  margin-bottom: 20rpx;
}

.pm-input-placeholder {
  color: #999999;
  font-size: 28rpx;
}

.pm-primary-btn {
  background: #8C1D18;
  color: #FFFFFF;
  font-size: 30rpx;
  line-height: 84rpx;
  border-radius: 12rpx;
  margin-top: 8rpx;
}

.pm-primary-btn[disabled] {
  background: #D8CFC7;
  color: #FFFFFF;
  opacity: 1;
}

.pm-secondary-btn {
  background: #F0EBE3;
  color: #8E8E93;
  font-size: 28rpx;
  line-height: 76rpx;
  border-radius: 12rpx;
  margin-top: 16rpx;
}

/* 🏛️（M0）支付模式二选一胶囊——本页此前没有 radio-group 场景，跟随
   .pm-primary-btn 同一套品牌红配色语言，未选中态用浅底描边区分 */
.pm-mode-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.pm-mode-pill {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
  border: 2rpx solid #E5DED4;
  color: #8E8E93;
  box-sizing: border-box;
}

.pm-mode-pill-active {
  border-color: #8C1D18;
  color: #8C1D18;
  background: #FDF1EE;
  font-weight: 600;
}

.pm-field-hint {
  display: block;
  font-size: 22rpx;
  color: #B8860B;
  margin-bottom: 20rpx;
  line-height: 32rpx;
}

.pm-settlement-loading {
  text-align: center;
  padding: 40rpx 0;
  color: #8E8E93;
  font-size: 26rpx;
}

.pm-loading-state,
.pm-error-state,
.pm-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  color: #8E8E93;
  font-size: 28rpx;
}

.pm-error-icon,
.pm-empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.pm-error-text,
.pm-empty-text {
  margin-bottom: 24rpx;
  text-align: center;
}

.pm-retry-btn {
  font-size: 28rpx;
  background: #8C1D18;
  color: #FFFFFF;
  padding: 0 40rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
}

.pm-product-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.pm-product-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.pm-product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.pm-status-switch {
  transform: scale(0.8);
  flex-shrink: 0;
}

.pm-product-status-label {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
}

.pm-status-active {
  color: #2E7D32;
  background: rgba(46, 125, 50, 0.08);
}

.pm-status-inactive {
  color: #8E8E93;
  background: rgba(142, 142, 147, 0.08);
}

.pm-product-desc {
  display: block;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #6B6B70;
  background: #F8F5F0;
  border-radius: 10rpx;
  padding: 16rpx;
  margin-top: 12rpx;
}

.pm-product-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 0;
}

.pm-product-label {
  font-size: 26rpx;
  color: #8E8E93;
}

.pm-product-value {
  font-size: 26rpx;
  color: #1C1C1E;
}

.pm-product-openid {
  font-size: 22rpx;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pm-product-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.pm-edit-btn {
  flex: 1;
  background: #F0EBE3;
  color: #1C1C1E;
  font-size: 26rpx;
  line-height: 68rpx;
  border-radius: 10rpx;
}

.pm-groupbuy-btn {
  flex: 1;
  background: #FFF3E0;
  color: #E8770F;
  font-size: 26rpx;
  line-height: 68rpx;
  border-radius: 10rpx;
}

/* 🏛️（护城河二 M3）拼团设置弹窗——半屏卡片，同 settlement-summary.wxss 的
   .ss-pledge-modal-* 视觉语言（浅底卡片 + 主操作按钮 + 次要取消按钮） */
.pm-groupbuy-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.pm-groupbuy-modal-card {
  width: 100%;
  max-height: 88vh;
  background: #FFFFFF;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.pm-groupbuy-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-bottom: 4rpx;
}

.pm-groupbuy-modal-sub {
  font-size: 22rpx;
  color: #8E8E93;
  margin-bottom: 20rpx;
}

.pm-groupbuy-scroll {
  max-height: 68vh;
}

.pm-groupbuy-loading,
.pm-groupbuy-empty {
  font-size: 24rpx;
  color: #8E8E93;
  padding: 16rpx 0;
}

.pm-groupbuy-batch-item {
  background: #F8F5F0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}

.pm-groupbuy-batch-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.pm-groupbuy-batch-date {
  font-size: 26rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.pm-groupbuy-batch-status {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  background: rgba(46, 125, 50, 0.12);
  color: #2E7D32;
}

.pm-gbs-locked {
  background: rgba(199, 123, 46, 0.12);
  color: #C77B2E;
}

.pm-gbs-closed {
  background: rgba(142, 142, 147, 0.12);
  color: #8E8E93;
}

.pm-groupbuy-batch-tiers {
  display: block;
  font-size: 22rpx;
  color: #E8770F;
  margin-bottom: 4rpx;
}

.pm-groupbuy-batch-meta {
  display: block;
  font-size: 20rpx;
  color: #ADADB2;
  margin-bottom: 8rpx;
}

.pm-groupbuy-close-btn {
  font-size: 20rpx;
  line-height: 48rpx;
  padding: 0 16rpx;
  margin: 0;
  background: #F0EBE3;
  color: #8E8E93;
  border-radius: 20rpx;
}

.pm-groupbuy-new-title {
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0EBE3;
}

.pm-picker-display {
  display: flex;
  align-items: center;
}

.pm-groupbuy-deadline-row {
  display: flex;
  gap: 16rpx;
}

.pm-groupbuy-deadline-row .pm-input {
  flex: 1;
}

.pm-groupbuy-tier-row {
  display: flex;
  gap: 16rpx;
}

.pm-tier-input {
  flex: 1;
}
