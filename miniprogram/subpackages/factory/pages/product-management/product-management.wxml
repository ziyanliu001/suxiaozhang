<view class="pm-page">

  <navigation-bar
    title="🧺 商品管理"
    background="#8C1D18"
    color="#FFFFFF"
    dark="{{true}}"
    back="{{true}}"
    showHomeButton="auto"
    bind:layout="onNavLayout"
  ></navigation-bar>

  <!-- 🐛 2026-09-06 修复：margin-top 不再叠加 navigation-bar 已占用的
       totalHeight，只留 24rpx 呼吸边距 -->
  <view class="pm-body" style="margin-top: 24rpx;">

    <view class="pm-form-card" wx:if="{{showForm}}">
      <text class="pm-form-title">{{formMode === 'edit' ? '编辑商品' : '新建商品'}}</text>

      <text class="pm-field-label">商品名称</text>
      <input
        class="pm-input"
        placeholder-class="pm-input-placeholder"
        placeholder="如：手工豆腐 500g"
        value="{{form.name}}"
        data-field="name"
        bindinput="onFormFieldInput"
      />

      <text class="pm-field-label">价格（元）</text>
      <input
        class="pm-input"
        placeholder-class="pm-input-placeholder"
        type="digit"
        placeholder="如：15.00"
        value="{{form.priceYuan}}"
        data-field="priceYuan"
        bindinput="onFormFieldInput"
      />

      <text class="pm-field-label">单日产能上限（件）</text>
      <input
        class="pm-input"
        placeholder-class="pm-input-placeholder"
        type="number"
        placeholder="如：20"
        value="{{form.dailyCapacityLimit}}"
        data-field="dailyCapacityLimit"
        bindinput="onFormFieldInput"
      />

      <text class="pm-field-label">制作前置天数（天，当日可排产填 0）</text>
      <input
        class="pm-input"
        placeholder-class="pm-input-placeholder"
        type="number"
        placeholder="如：1"
        value="{{form.leadTimeDays}}"
        data-field="leadTimeDays"
        bindinput="onFormFieldInput"
      />

      <text class="pm-field-label">图文简介（选填，买家下单页会展示）</text>
      <textarea
        class="pm-textarea"
        placeholder-class="pm-input-placeholder"
        placeholder="介绍一下这件商品的用料、工艺或故事……"
        value="{{form.description}}"
        data-field="description"
        bindinput="onFormFieldInput"
        maxlength="500"
        show-confirm-bar="{{false}}"
      />

      <text class="pm-field-label">制作方 openid（选填，用于分账归属）</text>
      <input
        class="pm-input"
        placeholder-class="pm-input-placeholder"
        placeholder="不填则该商品的制作方份额需人工结算"
        value="{{form.producerOpenId}}"
        data-field="producerOpenId"
        bindinput="onFormFieldInput"
      />

      <button class="pm-primary-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmitForm">保存</button>
      <button class="pm-secondary-btn" bindtap="onCancelForm">取消</button>
    </view>

    <!-- 🏛️（M0）支付与分账设置：与"新建商品"同一行，本页已经是 space_owner/
         space_admin 语境下管理工坊核心资产的地方，不新建专门的"工坊设置"页 -->
    <view class="pm-header-actions" wx:if="{{!showForm && !showSettlementConfigForm}}">
      <button class="pm-create-btn" bindtap="onTapCreate">+ 新建商品</button>
      <button class="pm-settings-btn" bindtap="onOpenSettlementConfig">⚙️ 支付与分账设置</button>
    </view>

    <view class="pm-form-card" wx:if="{{showSettlementConfigForm}}">
      <text class="pm-form-title">支付与分账设置</text>

      <view class="pm-settlement-loading" wx:if="{{settlementConfigLoading}}">
        <text>加载中...</text>
      </view>

      <block wx:else>
        <text class="pm-field-label">支付模式</text>
        <view class="pm-mode-row">
          <view
            class="pm-mode-pill {{settlementConfigForm.paymentMode === 'none' ? 'pm-mode-pill-active' : ''}}"
            data-mode="none"
            bindtap="onSelectPaymentMode"
          >人工/线下结算</view>
          <view
            class="pm-mode-pill {{settlementConfigForm.paymentMode === 'direct_wechat' ? 'pm-mode-pill-active' : ''}}"
            data-mode="direct_wechat"
            bindtap="onSelectPaymentMode"
          >微信直连自动分账</view>
        </view>
        <text class="pm-field-hint" wx:if="{{settlementConfigForm.paymentMode === 'direct_wechat'}}">⚠️ 需已在微信支付商户平台开通分账权限，并为制作方/推广员完成分账接收方注册，否则发货时自动分账会静默失败</text>

        <text class="pm-field-label">制作方分成比例（%）</text>
        <input
          class="pm-input"
          placeholder-class="pm-input-placeholder"
          type="digit"
          placeholder="如：75"
          value="{{settlementConfigForm.producerRatePercent}}"
          data-field="producerRatePercent"
          bindinput="onSettlementConfigFieldInput"
        />

        <text class="pm-field-label">推广员分成比例（%，订单没有推广人时不生效）</text>
        <input
          class="pm-input"
          placeholder-class="pm-input-placeholder"
          type="digit"
          placeholder="如：20"
          value="{{settlementConfigForm.promoterRatePercent}}"
          data-field="promoterRatePercent"
          bindinput="onSettlementConfigFieldInput"
        />

        <text class="pm-field-hint">平台留存比例：{{platformRatePercentDisplay}}%（100% 减去以上两项自动算出）</text>

        <button class="pm-primary-btn" loading="{{settlementConfigSubmitting}}" disabled="{{settlementConfigSubmitting}}" bindtap="onSubmitSettlementConfig">保存</button>
        <button class="pm-secondary-btn" bindtap="onCancelSettlementConfig">取消</button>
      </block>
    </view>

    <view class="pm-loading-state" wx:if="{{loading && products.length === 0}}">
      <text>加载中...</text>
    </view>

    <view class="pm-error-state" wx:elif="{{loadError}}">
      <text class="pm-error-icon">⚠️</text>
      <text class="pm-error-text">{{loadError}}</text>
      <button class="pm-retry-btn" bindtap="loadProducts">重试</button>
    </view>

    <view class="pm-empty-state" wx:elif="{{!loading && products.length === 0}}">
      <text class="pm-empty-icon">🧺</text>
      <text class="pm-empty-text">还没有商品，点击上方新建</text>
    </view>

    <view class="pm-list" wx:else>
      <view class="pm-product-card" wx:for="{{products}}" wx:key="_id">
        <view class="pm-product-header">
          <text class="pm-product-name">{{item.name}}</text>
          <switch
            class="pm-status-switch"
            checked="{{item.status === 'active'}}"
            disabled="{{togglingId === item._id}}"
            color="#8C1D18"
            data-id="{{item._id}}"
            bindchange="onSwitchStatus"
          />
        </view>
        <text class="pm-product-status-label pm-status-{{item.status}}">{{item.statusLabel}}</text>
        <view class="pm-product-row">
          <text class="pm-product-label">价格</text>
          <text class="pm-product-value">¥{{item.priceYuan}}</text>
        </view>
        <view class="pm-product-row">
          <text class="pm-product-label">单日产能</text>
          <text class="pm-product-value">{{item.dailyCapacityLimit}} 件</text>
        </view>
        <view class="pm-product-row">
          <text class="pm-product-label">前置天数</text>
          <text class="pm-product-value">{{item.leadTimeDays}} 天</text>
        </view>
        <view class="pm-product-row" wx:if="{{item.producerOpenId}}">
          <text class="pm-product-label">制作方</text>
          <text class="pm-product-value pm-product-openid">{{item.producerOpenId}}</text>
        </view>
        <text class="pm-product-desc" wx:if="{{item.description}}">{{item.description}}</text>
        <view class="pm-product-actions">
          <button class="pm-edit-btn" data-id="{{item._id}}" bindtap="onTapEdit">编辑</button>
          <button class="pm-groupbuy-btn" data-id="{{item._id}}" bindtap="onOpenGroupBuyModal">🎯 拼团设置</button>
        </view>
      </view>
    </view>

  </view>

  <!-- 🏛️（护城河二 M3）拼团批次设置弹窗 -->
  <view class="pm-groupbuy-modal-mask" wx:if="{{showGroupBuyModal}}" catchtap="onCloseGroupBuyModal">
    <view class="pm-groupbuy-modal-card" catchtap="stopPropagation">
      <text class="pm-groupbuy-modal-title">拼团设置 · {{groupBuyProductName}}</text>
      <text class="pm-groupbuy-modal-sub">商品原价 ¥{{groupBuyProductPriceYuan}}</text>

      <scroll-view class="pm-groupbuy-scroll" scroll-y>

        <text class="pm-field-label">现有批次</text>
        <view class="pm-groupbuy-loading" wx:if="{{groupBuyBatchesLoading}}">
          <text>加载中...</text>
        </view>
        <view class="pm-groupbuy-empty" wx:elif="{{groupBuyBatches.length === 0}}">
          <text>暂无拼团批次</text>
        </view>
        <block wx:else>
          <view class="pm-groupbuy-batch-item" wx:for="{{groupBuyBatches}}" wx:key="_id">
            <view class="pm-groupbuy-batch-top">
              <text class="pm-groupbuy-batch-date">{{item.batchDate}}</text>
              <text class="pm-groupbuy-batch-status pm-gbs-{{item.status}}">{{item.statusLabel}}</text>
            </view>
            <text class="pm-groupbuy-batch-tiers">{{item.tiersLabel}}</text>
            <text class="pm-groupbuy-batch-meta">已认购 {{item.committedQuantity}} 份 · 截止 {{item.deadlineStr}}</text>
            <button
              class="pm-groupbuy-close-btn"
              wx:if="{{item.status !== 'closed'}}"
              data-date="{{item.batchDate}}"
              bindtap="onCloseGroupBuyBatch"
            >关闭此批次</button>
          </view>
        </block>

        <text class="pm-field-label pm-groupbuy-new-title">+ 新建批次</text>

        <text class="pm-field-label">批次日期</text>
        <picker mode="date" value="{{groupBuyForm.batchDate}}" bindchange="onGroupBuyDateChange">
          <view class="pm-input pm-picker-display">{{groupBuyForm.batchDate || '请选择日期'}}</view>
        </picker>

        <text class="pm-field-label">拼团截止日期 + 时间</text>
        <view class="pm-groupbuy-deadline-row">
          <picker mode="date" value="{{groupBuyForm.deadlineDate}}" bindchange="onGroupBuyDeadlineDateChange">
            <view class="pm-input pm-picker-display">{{groupBuyForm.deadlineDate || '日期'}}</view>
          </picker>
          <picker mode="time" value="{{groupBuyForm.deadlineTime}}" bindchange="onGroupBuyDeadlineTimeChange">
            <view class="pm-input pm-picker-display">{{groupBuyForm.deadlineTime}}</view>
          </picker>
        </view>

        <text class="pm-field-label">阶梯价（最多 3 档，可只填 1 档；单价须低于原价、且随数量递增单调不增）</text>
        <view class="pm-groupbuy-tier-row">
          <input class="pm-input pm-tier-input" type="number" placeholder="满N件" value="{{groupBuyForm.tier1Qty}}" data-field="tier1Qty" bindinput="onGroupBuyFormFieldInput" />
          <input class="pm-input pm-tier-input" type="digit" placeholder="单价(元)" value="{{groupBuyForm.tier1PriceYuan}}" data-field="tier1PriceYuan" bindinput="onGroupBuyFormFieldInput" />
        </view>
        <view class="pm-groupbuy-tier-row">
          <input class="pm-input pm-tier-input" type="number" placeholder="满N件（选填）" value="{{groupBuyForm.tier2Qty}}" data-field="tier2Qty" bindinput="onGroupBuyFormFieldInput" />
          <input class="pm-input pm-tier-input" type="digit" placeholder="单价(元)" value="{{groupBuyForm.tier2PriceYuan}}" data-field="tier2PriceYuan" bindinput="onGroupBuyFormFieldInput" />
        </view>
        <view class="pm-groupbuy-tier-row">
          <input class="pm-input pm-tier-input" type="number" placeholder="满N件（选填）" value="{{groupBuyForm.tier3Qty}}" data-field="tier3Qty" bindinput="onGroupBuyFormFieldInput" />
          <input class="pm-input pm-tier-input" type="digit" placeholder="单价(元)" value="{{groupBuyForm.tier3PriceYuan}}" data-field="tier3PriceYuan" bindinput="onGroupBuyFormFieldInput" />
        </view>

        <button class="pm-primary-btn" loading="{{groupBuySubmitting}}" disabled="{{groupBuySubmitting}}" bindtap="onSubmitGroupBuyBatch">创建批次</button>
      </scroll-view>

      <button class="pm-secondary-btn" bindtap="onCloseGroupBuyModal">关闭</button>
    </view>
  </view>

</view>
