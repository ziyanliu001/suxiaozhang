.wj-page {
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  box-sizing: border-box;
  background: #F8F5F0;
}

.wj-body {
  padding: 24rpx;
  box-sizing: border-box;
}

/* 🎨 居中卡片布局：内容整体在可视区域内垂直居中，而不是贴在导航栏正下方，
   卡片本身左右留出页面底色余量，视觉上是"浮在页面上的卡片"而非通栏铺满 */
.wj-center-wrap {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 8rpx;
  box-sizing: border-box;
}

/* 🎨 头部：渐变徽标 + 副标题 + 说明文案，与 production-fulfillment 富态空
   状态卡片同一套"圆形渐变徽标背景"视觉语言，页面之间保持一致的设计语汇 */
.wj-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 0 24rpx;
  margin-bottom: 32rpx;
}

.wj-header-badge {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(140, 29, 24, 0.1), rgba(230, 162, 60, 0.14));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.wj-header-icon {
  font-size: 64rpx;
  line-height: 1;
}

.wj-header-subtitle {
  font-size: 28rpx;
  font-weight: 600;
  color: #8C1D18;
  margin-bottom: 12rpx;
}

.wj-header-desc {
  font-size: 26rpx;
  line-height: 40rpx;
  color: #6B6B70;
}

.wj-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.wj-input-label {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
  margin-bottom: 12rpx;
}

/* 🎨 输入框容器：input 与清空按钮叠放，清空按钮绝对定位在右侧，input 右内
   边距预留出清空按钮的空间，避免文字被按钮遮住 */
.wj-input-wrap {
  position: relative;
  margin-bottom: 24rpx;
}

/* 🐛 修复样式 Bug：此前只设了 padding、没设 height/line-height，input 内文字
   与 placeholder 在不同机型上会出现垂直方向偏上/偏下、甚至被输入框边框遮住
   一部分的问题——显式把 height 与 line-height 设成同一个值，文字就稳定
   垂直居中，不再依赖 padding 上下值去"凑"居中效果 */
.wj-input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  box-sizing: border-box;
  border: 2rpx solid #E5DED4;
  border-radius: 12rpx;
  padding: 0 80rpx 0 24rpx;
  font-size: 30rpx;
  color: #1C1C1E;
  letter-spacing: 4rpx;
  background: #FFFFFF;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

/* 🎨 邀请码输入框：大字号 + 拉宽字距，视觉上接近"分格展示"的效果，同时
   保留单一 <input> 实现（不做真正的 6 格 OTP 拼接输入，避免引入额外的
   焦点管理/退格跳格逻辑复杂度，用一个更简单的方案达成同等的视觉意图） */
.wj-input-code {
  height: 96rpx;
  line-height: 96rpx;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 12rpx;
  text-align: center;
  padding-left: 0;
}

/* 🎨 聚焦高亮边框：与页面主色一致的棕红描边 + 浅色外发光，替代默认的
   "看不出来点没点中"的无反馈状态 */
.wj-input-focused {
  border-color: #8C1D18;
  box-shadow: 0 0 0 4rpx rgba(140, 29, 24, 0.08);
}

/* 🐛 修复样式 Bug：placeholder 颜色/字号未定制过，不同机型默认灰度深浅不一，
   偶发出现颜色过深看起来像已经输入了内容的错觉——统一设成 #999、字号与正文
   接近但略小，且不继承正文的 letter-spacing（那是给已输入的邀请码用的宽字
   距，placeholder 提示文字不需要这个视觉处理） */
.wj-input-placeholder {
  color: #999999;
  font-size: 28rpx;
  letter-spacing: normal;
}

.wj-input-clear {
  position: absolute;
  right: 12rpx;
  top: 0;
  height: 88rpx;
  width: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #C4C4C6;
  font-size: 28rpx;
}

/* 🎨 一键粘贴按钮：与 .wj-input-clear 共用同一个"输入框内右侧浮层"槽位，
   两者互斥展示（有值时清空、无值时粘贴），图标+文字纵向堆叠塞进同样的
   竖直空间里 */
.wj-input-action-btn {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  bottom: 8rpx;
  width: 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  border-radius: 8rpx;
  background: #FAF5F0;
}

.wj-input-action-icon {
  font-size: 24rpx;
  line-height: 1;
}

.wj-input-action-label {
  font-size: 18rpx;
  color: #8C1D18;
  line-height: 1;
}

.wj-form-row {
  margin-bottom: 8rpx;
}

.wj-primary-btn {
  background: #8C1D18;
  color: #FFFFFF;
  font-size: 30rpx;
  line-height: 84rpx;
  border-radius: 12rpx;
  margin-top: 8rpx;
}

/* 🎨 禁用态：邀请码/姓名为空时置灰，不能点，视觉上明确"现在还不能点"，
   有输入后立刻恢复主色高亮 */
.wj-primary-btn[disabled] {
  background: #D8CFC7;
  color: #FFFFFF;
  opacity: 1;
}

.wj-secondary-btn {
  background: #F0EBE3;
  color: #8E8E93;
  font-size: 28rpx;
  line-height: 76rpx;
  border-radius: 12rpx;
  margin-top: 16rpx;
}

.wj-error-text {
  display: block;
  color: #C0392B;
  font-size: 24rpx;
  margin-top: 16rpx;
  text-align: center;
}

/* 🎨 工坊身份权益指引：轻量常驻卡片，两档身份各一行，中间一道细分隔线 */
.wj-role-guide {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.wj-role-guide-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 8rpx 0;
}

.wj-role-guide-icon {
  font-size: 40rpx;
  line-height: 1.4;
  flex-shrink: 0;
}

.wj-role-guide-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.wj-role-guide-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.wj-role-guide-desc {
  font-size: 22rpx;
  line-height: 32rpx;
  color: #8E8E93;
}

.wj-role-guide-divider {
  height: 1rpx;
  background: #F1F1EE;
  margin: 8rpx 0;
}

.wj-tips {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  padding: 0 24rpx;
}

.wj-tips-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.wj-tips-text {
  font-size: 24rpx;
  color: #ADADB2;
  text-align: center;
}

.wj-confirm-summary {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 40rpx;
}

/* 🎨 与 .wj-header-badge 同一套渐变圆形徽标语言，确认卡片与头部保持一致的
   设计语汇 */
.wj-confirm-icon-badge {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(140, 29, 24, 0.1), rgba(230, 162, 60, 0.14));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.wj-confirm-icon {
  font-size: 56rpx;
  line-height: 1;
}

.wj-confirm-title {
  font-size: 24rpx;
  color: #8E8E93;
}

.wj-confirm-tenant {
  font-size: 36rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin: 8rpx 0;
}

/* 🎯 主理人姓名：作为额外的身份锚点，弱化于门店名之下、角色徽章之上，
   帮助用户在确认加入前多一层"认得出这个工坊"的核对依据 */
.wj-confirm-owner {
  font-size: 24rpx;
  color: #8E8E93;
  margin-bottom: 12rpx;
}

.wj-confirm-role {
  font-size: 26rpx;
  color: #8C1D18;
  background: rgba(140, 29, 24, 0.08);
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
}
