<!-- 顶部门店选择胶囊 (极简清爽版) -->
<view class="store-picker-capsule" bindtap="onOpenSheet" hover-class="capsule-hover">
  <view class="capsule-avatar">{{storeInitial}}</view>
  <text class="store-name">{{currentStore.storeName || '海沧区雨花斋'}}</text>
  <text class="arrow">▼</text>
</view>

<!-- 2. 自定义绝对高层级 Bottom Sheet (替代 page-container，解决不弹窗问题) -->
<view class="store-sheet-backdrop {{showPickerSheet ? 'show' : ''}}" bindtap="onCloseSheet" catchtouchmove="preventTouchMove">
  <view class="store-sheet-panel" catchtap="stopBubble">

    <view class="sheet-drag-handle"></view>

    <!-- 头部栏 -->
    <view class="sheet-header">
      <view class="header-left">
        <text class="sheet-title">📍 选择服务的雨花斋门店与身份</text>
        <!-- 当前生效身份小贴士 -->
        <text class="current-active-tip">当前生效：{{currentStore.storeName || '海沧区雨花斋'}} · {{currentStore.role === 'FINANCE' ? '🔒 财务' : (currentStore.role === 'MANAGER' ? '👑 店长' : (currentStore.role === 'PATRIARCH' ? '🙏 大家长' : (currentStore.role === 'ADMIN' ? '🔒 管理员' : (currentStore.role === 'FAMILY' ? '❤️ 家人' : '🌸 义工'))))}}</text>
      </view>
      <text class="sheet-close-btn" bindtap="onCloseSheet">✕</text>
    </view>

    <!-- 🌐 全国家园网络：搜索 + 省市级联筛选 + 附近门店排序 -->
    <view class="store-filter-bar" wx:if="{{!showNewStoreForm}}">
      <view class="filter-search-box">
        <text class="filter-search-icon">🔍</text>
        <input class="filter-search-input" placeholder="搜索门店名称" value="{{searchKeyword}}" bindinput="onSearchInput" />
      </view>
      <view class="filter-row">
        <picker mode="selector" range="{{provinceOptionsWithAll}}" bindchange="onProvinceChange">
          <view class="filter-pill {{selectedProvince ? 'active' : ''}}">{{selectedProvince || '全部省份'}} ▾</view>
        </picker>
        <picker mode="selector" range="{{cityOptionsWithAll}}" bindchange="onCityChange" disabled="{{!selectedProvince}}">
          <view class="filter-pill {{selectedCity ? 'active' : ''}} {{!selectedProvince ? 'disabled' : ''}}">{{selectedCity || '全部城市'}} ▾</view>
        </picker>
        <view class="filter-pill nearby-pill {{sortMode === 'nearby' ? 'active' : ''}}" bindtap="onToggleNearbySort">
          {{locationLoading ? '定位中...' : '📍 附近门店'}}
        </view>
      </view>
    </view>

    <!-- 按门店分组列表 / 新建门店申请表单 二选一展示 -->
    <scroll-view scroll-y class="sheet-scroll-list" wx:if="{{!showNewStoreForm}}">
      <view class="store-list-loading-tip" wx:if="{{storeListLoading}}">
        <text>正在加载最新门店列表...</text>
      </view>
      <view class="store-empty-tip" wx:if="{{!storeListLoading && groupedStoreList.length === 0}}">
        <text>没有找到符合条件的门店，试试清空筛选条件</text>
        <text class="btn-clear-filters" bindtap="onClearFilters">清空筛选</text>
      </view>
      <block wx:for="{{groupedStoreList}}" wx:key="storeId">

        <view class="store-group-card {{item.storeName === currentStore.storeName ? 'active-store' : ''}}">

          <!-- 门店名称栏 (去掉了重复标签，保持简洁) -->
          <view class="store-card-header">
            <text class="store-icon">🏪</text>
            <text class="store-name-text">{{item.storeId === 'national_overview' ? '管理员' : item.storeName}}</text>
            <text class="store-operating-badge {{item.operatingStatus}}" wx:if="{{item.operatingStatusLabel}}">{{item.operatingStatusLabel}}</text>
            <text class="store-distance-label" wx:if="{{item.distanceLabel}}">{{item.distanceLabel}}</text>
          </view>

          <!-- 该门店下的可选身份标签列表 (解耦自由选择 + 鉴权锁定) -->
          <view class="role-selector-row">
            <view wx:for="{{item.roles}}"
                  wx:for-item="roleObj"
                  wx:key="role"
                  class="role-choice-pill {{roleObj.role}} {{item.storeName === currentStore.storeName && roleObj.role === currentStore.role ? 'selected' : ''}} {{!roleObj.isAuthorized ? 'locked' : ''}} {{roleObj.isPending ? 'pending' : ''}}"
                  bindtap="onRolePillClick"
                  data-store-id="{{item.storeId}}"
                  data-store-name="{{item.storeName}}"
                  data-role="{{roleObj.role}}"
                  data-authorized="{{roleObj.isAuthorized}}"
                  data-pending="{{roleObj.isPending}}">

              <text class="role-icon" wx:if="{{!roleObj.isPending}}">{{!roleObj.isAuthorized ? '🔒' : (roleObj.role === 'FINANCE' ? '🔒' : (roleObj.role === 'MANAGER' ? '👑' : (roleObj.role === 'PATRIARCH' ? '🙏' : (roleObj.role === 'ADMIN' || roleObj.role === 'SUPER_ADMIN' ? '🔒' : (roleObj.role === 'FAMILY' ? '❤️' : '🌸')))))}}</text>
              <text class="role-label">{{roleObj.isPending ? roleObj.pendingLabel : roleObj.label}}</text>
              <text class="check-mark" wx:if="{{item.storeName === currentStore.storeName && roleObj.role === currentStore.role}}">✔</text>
            </view>
          </view>

        </view>

      </block>
    </scroll-view>

    <!-- ➕ 找不到门店？申请新建/加入新门店 -->
    <view class="new-store-entry-btn" wx:if="{{!showNewStoreForm}}" bindtap="onToggleNewStoreForm">
      <text>➕ 找不到您的门店？申请新建/加入新门店</text>
    </view>

    <!-- 申请新门店表单 -->
    <view class="new-store-form" wx:if="{{showNewStoreForm}}">
      <view class="new-store-form-back" bindtap="onToggleNewStoreForm">‹ 返回门店列表</view>

      <text class="form-label">新门店名称</text>
      <input class="new-store-input"
             type="text"
             placeholder="如：雨花斋集美区店"
             value="{{newStoreForm.customStoreName}}"
             bindinput="onNewStoreNameInput"/>

      <block wx:if="{{currentStore.role !== 'ADMIN'}}">
        <text class="form-label">申请身份</text>
        <radio-group class="new-store-role-group" bindchange="onSelectNewStoreRole">
          <label class="new-store-role-item">
            <radio value="store_patriarch" checked="{{newStoreForm.applyRole === 'store_patriarch'}}" color="#8C1D18"/>
            <text>👑 大家长</text>
          </label>
          <label class="new-store-role-item">
            <radio value="store_manager" checked="{{newStoreForm.applyRole === 'store_manager'}}" color="#8C1D18"/>
            <text>👑 店长</text>
          </label>
          <label class="new-store-role-item">
            <radio value="finance" checked="{{newStoreForm.applyRole === 'finance'}}" color="#8C1D18"/>
            <text>🔒 财务</text>
          </label>
          <label class="new-store-role-item">
            <radio value="volunteer" checked="{{newStoreForm.applyRole === 'volunteer'}}" color="#8C1D18"/>
            <text>🌸 义工</text>
          </label>
        </radio-group>

        <text class="form-label">真实姓名</text>
        <input class="new-store-input" type="text" placeholder="请输入真实姓名" value="{{newStoreForm.realName}}" bindinput="onNewStoreRealNameInput"/>

        <text class="form-label">手机号</text>
        <input class="new-store-input" type="number" placeholder="请输入手机号" value="{{newStoreForm.phone}}" bindinput="onNewStorePhoneInput"/>

        <!-- 🏪 新建门店档案补全：门店此刻还不存在，先随申请一并提交，
             超管审核通过后自动写入新建门店的档案 -->
        <text class="form-label">门店地址</text>
        <input class="new-store-input" type="text" placeholder="请输入门店详细地址" value="{{newStoreForm.address}}" bindinput="onNewStoreAddressInput"/>

        <text class="form-label">联系电话</text>
        <input class="new-store-input" type="number" placeholder="请输入门店联系电话" value="{{newStoreForm.contactPhone}}" bindinput="onNewStoreContactPhoneInput"/>

        <text class="form-label">门店照片</text>
        <view class="receipt-grid-container">
          <view class="grid-image-item" wx:for="{{newStoreForm.storePhotos}}" wx:key="*this">
            <image class="grid-img" src="{{item}}" mode="aspectFill" />
            <view class="img-delete-badge" catchtap="onDeleteNewStorePhoto" data-index="{{index}}">✕</view>
          </view>
          <view class="grid-add-btn" bindtap="onChooseNewStorePhoto" wx:if="{{newStoreForm.storePhotos.length < 9}}">
            <text class="add-icon">{{newStorePhotoUploading ? '…' : '+'}}</text>
            <text class="add-txt">{{newStorePhotoUploading ? '压缩中' : '添加照片'}}</text>
          </view>
        </view>
      </block>
      <view class="form-hint" wx:else>👑 您是超级管理员，提交后将直接建店并自动获得该店管理权限，无需审批</view>

      <button class="new-store-submit-btn" bindtap="onSubmitNewStoreApply">
        {{currentStore.role === 'ADMIN' ? '立即创建门店' : '提交申请，等待超管审批'}}
      </button>
    </view>

  </view>
</view>

<canvas type="2d" id="storePickerImgCompressCanvas" style="position: fixed; left: -9999px; top: -9999px; width: 1920px; height: 1920px;"></canvas>

<!-- 🔐 特权身份激活弹窗 (安全防泄漏版) -->
<view class="modal-backdrop" wx:if="{{showAuthModal}}" catchtap="onCloseAuthModal">
  <view class="modal-card auth-card" catchtap="stopBubble">
    <view class="modal-header">
      <text class="modal-title">🔐 激活【{{targetAuthStoreName}} · {{targetAuthRoleLabel}}】</text>
      <text class="close-btn" bindtap="onCloseAuthModal">✕</text>
    </view>

    <!-- 选项卡：一次性邀请码 / 提交申请 -->
    <view class="auth-tab-bar">
      <view class="tab-item {{authTab === 'CODE' ? 'active' : ''}}" bindtap="onSwitchAuthTab" data-tab="CODE">一次性动态码</view>
      <view class="tab-item {{authTab === 'APPLY' ? 'active' : ''}}" bindtap="onSwitchAuthTab" data-tab="APPLY">在线提交申请</view>
    </view>

    <!-- 通道 1：一次性动态邀请码（店长/财务）；超级管理员无自助激活入口 -->
    <view class="auth-body" wx:if="{{authTab === 'CODE'}}">
      <text class="auth-tip" wx:if="{{targetAuthRole === 'ADMIN' || targetAuthRole === 'SUPER_ADMIN'}}">👑 超级管理员权限不支持在小程序内自助开通，请联系平台管理员为您的账号开通。</text>
      <text class="auth-tip" wx:else>请输入现任店长或总管向您提供的 6 位动态邀请码（一客码，用完即失效）：</text>

      <input class="auth-code-input"
             wx:if="{{targetAuthRole !== 'ADMIN' && targetAuthRole !== 'SUPER_ADMIN'}}"
             type="text"
             maxlength="20"
             placeholder="请输入 6 位动态邀请码"
             value="{{authCodeInput}}"
             bindinput="onAuthCodeInput"/>

      <text class="sub-help-text" wx:if="{{targetAuthRole !== 'ADMIN' && targetAuthRole !== 'SUPER_ADMIN'}}">🔒 防泄漏保障：邀请码仅限使用一次，过期自动失效。</text>
    </view>

    <!-- 通道 2：在线提交申请流程 -->
    <view class="auth-body" wx:if="{{authTab === 'APPLY'}}">
      <text class="auth-tip">如果您未取得邀请码，可向【{{targetAuthStoreName}}】管理组提交绑定申请：</text>
      <input class="auth-code-input"
             type="text"
             placeholder="请输入您的真实姓名/义工号"
             value="{{applicantNameInput}}"
             bindinput="onApplicantNameInput"/>
      <input class="auth-code-input"
             type="number"
             placeholder="请输入您的手机号"
             value="{{applicantPhoneInput}}"
             bindinput="onApplicantPhoneInput"/>
      <text class="sub-help-text">提交后，现任店长将在【店长工作台】收到审核通知。</text>
    </view>

    <view class="auth-footer-btns">
      <button class="btn-cancel" bindtap="onCloseAuthModal">取消</button>
      <button class="btn-confirm-auth" bindtap="onVerifyAuthSubmit">
        {{authTab === 'CODE' ? '确认激活' : '提交申请'}}
      </button>
    </view>
  </view>
</view>

<!-- 🏛️ 大家长任命申请弹窗：与上方店长/财务激活弹窗完全独立——家长任命没有客户端
     口令/邀请码通道，只能提交真实姓名/手机号，交由服务端 processRoleAudit 走
     "仅超级管理员可审批"的真实审核流程 -->
<view class="modal-backdrop" wx:if="{{showPatriarchApplyModal}}" catchtap="onClosePatriarchApplyModal">
  <view class="modal-card auth-card" catchtap="stopBubble">
    <view class="modal-header">
      <text class="modal-title">🙏 申请【{{patriarchApplyStoreName}} · 大家长】</text>
      <text class="close-btn" bindtap="onClosePatriarchApplyModal">✕</text>
    </view>

    <view class="auth-body">
      <text class="auth-tip">大家长（督导）任命仅限超级管理员审批，请填写真实姓名与手机号提交任命申请：</text>
      <input class="auth-code-input"
             type="text"
             placeholder="请输入您的真实姓名"
             value="{{patriarchApplyRealName}}"
             bindinput="onPatriarchApplyRealNameInput"/>
      <input class="auth-code-input"
             type="number"
             placeholder="请输入您的手机号"
             value="{{patriarchApplyPhone}}"
             bindinput="onPatriarchApplyPhoneInput"/>
      <text class="sub-help-text">提交后，超级管理员将在管理后台收到审核通知，请耐心等待。</text>
    </view>

    <view class="auth-footer-btns">
      <button class="btn-cancel" bindtap="onClosePatriarchApplyModal" disabled="{{patriarchApplySubmitting}}">取消</button>
      <button class="btn-confirm-auth" bindtap="onSubmitPatriarchApply" loading="{{patriarchApplySubmitting}}" disabled="{{patriarchApplySubmitting}}">
        提交申请
      </button>
    </view>
  </view>
</view>