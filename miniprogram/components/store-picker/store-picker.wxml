<!-- 顶部门店选择胶囊 (极简清爽版) -->
<view class="store-picker-capsule" bindtap="onOpenSheet" hover-class="capsule-hover">
  <text class="pin-icon">📍</text>
  <text class="store-name">{{currentStore.storeName || '海沧区雨花斋'}}</text>
  <text class="arrow">▼</text>
</view>

<!-- 2. 自定义绝对高层级 Bottom Sheet (替代 page-container，解决不弹窗问题) -->
<view class="store-sheet-backdrop {{showPickerSheet ? 'show' : ''}}" bindtap="onCloseSheet" catchtouchmove="preventTouchMove">
  <view class="store-sheet-panel" catchtap="stopBubble">

    <!-- 头部栏 -->
    <view class="sheet-header">
      <view class="header-left">
        <text class="sheet-title">📍 选择服务的雨花斋门店与身份</text>
        <!-- 当前生效身份小贴士 -->
        <text class="current-active-tip">当前生效：{{currentStore.storeName || '海沧区雨花斋'}} · {{currentStore.role === 'FINANCE' ? '🔒 财务' : (currentStore.role === 'MANAGER' ? '👑 店长' : (currentStore.role === 'ADMIN' ? '🛡️ 超级管理员' : '🌸 义工'))}}</text>
      </view>
      <text class="sheet-close-btn" bindtap="onCloseSheet">✕</text>
    </view>

    <!-- 按门店分组列表 -->
    <scroll-view scroll-y class="sheet-scroll-list">
      <block wx:for="{{groupedStoreList}}" wx:key="storeId">

        <view class="store-group-card {{item.storeName === currentStore.storeName ? 'active-store' : ''}}">

          <!-- 门店名称栏 (去掉了重复标签，保持简洁) -->
          <view class="store-card-header">
            <text class="store-icon">🏪</text>
            <text class="store-name-text">{{item.storeName}}</text>
          </view>

          <!-- 该门店下的可选身份标签列表 (解耦自由选择) -->
          <view class="role-selector-row">
            <view wx:for="{{item.roles}}"
                  wx:for-item="roleObj"
                  wx:key="role"
                  class="role-choice-pill {{roleObj.role}} {{item.storeName === currentStore.storeName && roleObj.role === currentStore.role ? 'selected' : ''}}"
                  bindtap="onSelectStoreAndRole"
                  data-store-id="{{item.storeId}}"
                  data-store-name="{{item.storeName}}"
                  data-role="{{roleObj.role}}">

              <text class="role-icon">{{roleObj.role === 'FINANCE' ? '🔒' : (roleObj.role === 'MANAGER' ? '👑' : (roleObj.role === 'ADMIN' || roleObj.role === 'SUPER_ADMIN' ? '🛡️' : '🌸'))}}</text>
              <text class="role-label">{{roleObj.label}}</text>
              <text class="check-mark" wx:if="{{item.storeName === currentStore.storeName && roleObj.role === currentStore.role}}">✔</text>
            </view>
          </view>

        </view>

      </block>
    </scroll-view>

  </view>
</view>