/* 极简大方胶囊容器 */
.store-picker-capsule {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  background: #FFFFFF;
  border: 1.5rpx solid #EFE6D8;
  border-radius: 40rpx;
  padding: 10rpx 28rpx;
  height: 64rpx;
  box-shadow: 0 4rpx 12rpx rgba(140, 29, 24, 0.06);
  box-sizing: border-box;
  transition: opacity 0.2s ease;
}

.capsule-hover {
  opacity: 0.8;
}

/* 圆形头像占位：取门店名首字，替代原先的定位图标 */
.store-picker-capsule .capsule-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8C1D18 0%, #B8433C 100%);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: bold;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
  line-height: 1;
}

/* 门店名称：大幅提升字号与加粗 */
.store-picker-capsule .store-name {
  font-size: 30rpx !important;
  font-weight: bold !important;
  color: #333333;
  line-height: 1 !important;
  display: inline-flex;
  align-items: center;
  white-space: nowrap;
}

/* 下拉箭头 */
.store-picker-capsule .arrow {
  font-size: 20rpx;
  color: #888888;
  margin-left: 12rpx;
  line-height: 1 !important;
  display: inline-flex;
  align-items: center;
}

/* ===== 关键突破：高层级全屏遮罩蒙层 ===== */
.store-sheet-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 99999 !important;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.store-sheet-backdrop.show {
  opacity: 1;
  pointer-events: auto;
}

/* 底部滑出面板 */
.store-sheet-panel {
  width: 100%;
  background: #FBF9F5;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 16rpx 28rpx 32rpx;
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.25s ease;
  max-height: 75vh;
  display: flex;
  flex-direction: column;
}

/* 顶部拖拽把手：纯视觉提示，表明这是一张可下滑关闭的面板 */
.sheet-drag-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #E3D9C8;
  margin: 0 auto 20rpx;
  flex-shrink: 0;
}

.store-sheet-backdrop.show .store-sheet-panel {
  transform: translateY(0);
}

/* ===== 头部栏 ===== */
.sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #EFE6D8;
}

.header-left {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  display: block;
}

.current-active-tip {
  font-size: 22rpx;
  color: #8C1D18;
  margin-top: 6rpx;
  display: block;
  font-weight: 500;
}

.sheet-close-btn {
  font-size: 36rpx;
  color: #999999;
  padding: 10rpx;
  flex-shrink: 0;
}

/* ===== 滚动列表 ===== */
.sheet-scroll-list {
  max-height: 55vh;
  margin-top: 20rpx;
}

.store-list-loading-tip {
  text-align: center;
  padding: 16rpx 0;
  font-size: 22rpx;
  color: #999999;
}

/* 门店分组卡片基础样式 */
.store-group-card {
  position: relative;
  background: #FFFFFF;
  border: 1.5rpx solid #EFE6D8;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  transition: all 0.25s cubic-bezier(0.25, 0.8, 0.25, 1);
  box-sizing: border-box;
}

/* 核心：选中态卡片 - 采用左侧高亮烫金线 + 柔和内阴影 */
.store-group-card.active-store {
  border-color: #8C1D18 !important;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFDF9 100%) !important;
  box-shadow: 0 8rpx 24rpx rgba(140, 29, 24, 0.08) !important;
  border-left: 8rpx solid #8C1D18 !important;
}

/* 门店标题 */
.store-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.store-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  line-height: 1;
}

.store-name-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #222222;
  line-height: 1;
}

/* 身份胶囊选择行 */
.role-selector-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* 身份可点击胶囊 */
.role-choice-pill {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 22rpx;
  border-radius: 32rpx;
  background: #F8F9FA;
  border: 1rpx solid #E9ECEF;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.role-choice-pill .role-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
  line-height: 1;
}

.role-choice-pill .role-label {
  font-size: 24rpx;
  color: #555555;
  font-weight: 500;
  line-height: 1;
}

/* 选中态对勾：Reddit 风格的实心蓝色圆形徽标（text 组件用 line-height 居中，不依赖 flex） */
.role-choice-pill .check-mark {
  display: inline-block;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #1A73E8;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: bold;
  line-height: 28rpx;
  text-align: center;
  margin-left: 10rpx;
}

/* 选中高亮状态 (朱红浅底) */
.role-choice-pill.selected {
  border-color: #8C1D18 !important;
  background: #FFEBEE !important;
}

.role-choice-pill.selected .role-label {
  color: #8C1D18 !important;
  font-weight: bold;
}

/* 未授权锁定的角色胶囊 */
.role-choice-pill.locked {
  background: #F2F4F8 !important;
  border-color: #E2E8F0 !important;
  opacity: 0.65;
}

.role-choice-pill.locked .role-label {
  color: #888888 !important;
}

/* ===== ➕ 新建门店入口按钮：吸底高亮 CTA，视觉权重与"确认激活"按钮一致 ===== */
.new-store-entry-btn {
  margin-top: 20rpx;
  flex-shrink: 0;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 40rpx;
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: bold;
  background: #8C1D18;
  box-shadow: 0 8rpx 20rpx rgba(140, 29, 24, 0.22);
}

.new-store-entry-btn:active {
  opacity: 0.85;
}

/* ===== 新建门店申请表单 ===== */
.new-store-form {
  margin-top: 20rpx;
}

.new-store-form-back {
  font-size: 24rpx;
  color: #8C1D18;
  margin-bottom: 20rpx;
}

.new-store-form .form-label {
  font-size: 24rpx;
  color: #666666;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
}

.new-store-form .form-hint {
  display: block;
  font-size: 22rpx;
  color: #8C1D18;
  background: #FFF3E0;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.new-store-input {
  background: #F8F9FA;
  border: 1.5rpx solid #EFE6D8;
  border-radius: 16rpx;
  height: 76rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #333333;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.new-store-role-group {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.new-store-role-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #555555;
}

.new-store-submit-btn {
  background: #8C1D18;
  color: #FFFFFF;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.new-store-submit-btn::after {
  border: none;
}

.new-store-submit-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* ===== 特权身份激活弹窗 ===== */
.modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 100000 !important;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-card {
  width: 85%;
  max-width: 620rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #EFE6D8;
  margin-bottom: 16rpx;
}

.modal-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  flex: 1;
  padding-right: 20rpx;
  line-height: 1.4;
}

.close-btn {
  font-size: 32rpx;
  color: #999999;
  padding: 6rpx 10rpx;
  flex-shrink: 0;
  line-height: 1;
}

/* 激活弹窗选项卡 */
.auth-tab-bar {
  display: flex;
  background: #F8F9FA;
  border-radius: 16rpx;
  padding: 6rpx;
  margin: 16rpx 0;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #666666;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.tab-item.active {
  background: #FFFFFF;
  color: #8C1D18;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.auth-body {
  margin: 24rpx 0;
}

.auth-tip {
  font-size: 24rpx;
  color: #555555;
  line-height: 1.6;
  display: block;
  margin-bottom: 20rpx;
}

.auth-code-input {
  background: #F8F9FA;
  border: 2rpx solid #8C1D18;
  border-radius: 16rpx;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.sub-help-text {
  font-size: 20rpx;
  color: #999999;
  margin-top: 12rpx;
  display: block;
}

.auth-footer-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn-cancel {
  flex: 1;
  background: #F8F9FA;
  color: #666666;
  border-radius: 40rpx;
  font-size: 26rpx;
}

.btn-cancel::after {
  border: none;
}

.btn-confirm-auth {
  flex: 1.5;
  background: #8C1D18;
  color: #FFFFFF;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: bold;
}

.btn-confirm-auth::after {
  border: none;
}

.btn-confirm-auth:active {
  opacity: 0.85;
  transform: scale(0.98);
}