/* 极简大方胶囊容器
   🐛 长门店名截断修复：此前没有 max-width，宿主页面（如 history.ts 筛选栏）
   把组件放进较窄的 flex 列时，胶囊会按内容自然宽度溢出、视觉上与相邻控件挤在
   一起（表现为"文字被挤压截断"）。max-width:100% 让胶囊最多撑满宿主给出的
   宽度，超出部分交给下面 .store-name 的 ellipsis 收尾，而不是溢出裁切 */
/* 🐛 与 history.wxss 门店/月份胶囊统一规范对齐：56rpx 高（此前 64rpx），
   两枚胶囊同一行内视觉对齐；本组件同时被 pages/index/index.wxml 复用，
   高度收紧对那边同样是更紧凑的观感，不影响其布局（该处是居中的独立一行） */
/* 🐛 门店名文字顶部被削根因修复：此前 height:56rpx 是硬性锁死的固定高度，
   配合 .store-name 的 line-height:1，中文字形（尤其是带较高笔画的字，如
   "漳""雨""花"）的实际渲染包围盒会超出这条极窄的行框，被裁切掉顶部一截。
   改为 min-height + height:auto，容器高度跟着内容的真实行高走，不再反过来
   拿一个固定数值卡住文字 */
.store-picker-capsule {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  max-width: 100%;
  background: #FFFFFF;
  border: 1.5rpx solid #EFE6D8;
  border-radius: 28rpx;
  padding: 8rpx 24rpx;
  min-height: 56rpx;
  height: auto;
  box-shadow: 0 4rpx 12rpx rgba(140, 29, 24, 0.06);
  box-sizing: border-box;
  transition: opacity 0.2s ease;
}

.capsule-hover {
  opacity: 0.8;
}

/* 圆形头像占位：取门店名首字，替代原先的定位图标 */
.store-picker-capsule .capsule-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8C1D18 0%, #B8433C 100%);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: bold;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
  flex-shrink: 0;
  /* storeInitial 取门店名首字，同样是中文字符——与 .store-name 同一类
     line-height:1 顶部裁切风险，一并放宽；36rpx 圆内空间足够容纳 1.4 倍行高 */
  line-height: 1.4;
}

/* 门店名称：与 history.wxss 门店/月份胶囊统一字号规范 24rpx（此前 30rpx，
   在收紧后的 56rpx 胶囊里也更协调）
   🐛 长门店名截断修复：min-width:0 + flex:1 让这段文字在胶囊宽度不够时才是
   真正收窄的那一环（头像/箭头保持固定尺寸），超出部分用 ellipsis 省略号收尾，
   而不是任由整个胶囊溢出撑破宿主布局 */
.store-picker-capsule .store-name {
  font-size: 24rpx !important;
  font-weight: bold !important;
  color: #333333;
  /* 🐛 门店名文字顶部被削：line-height:1 给中文字形留的行框太紧，笔画较高的
     字（"漳""雨""花"等）配合下面 overflow:hidden 会被直接裁掉顶部一截。
     1.4 倍行高留出足够的字形上缘空间，是"削字"这个问题真正的修复点，不是
     line-height:1 只是"看起来不好看" */
  line-height: 1.4;
  /* text-overflow:ellipsis 只在 block/inline-block 容器上可靠生效，flex 容器
     不保证支持——这里从 inline-flex 改为 inline-block，垂直居中改由父级
     .store-picker-capsule 的 align-items:center 负责（对 flex-item 的子元素
     同样生效，不依赖子元素自身是不是 flex 容器） */
  display: inline-block;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 下拉箭头 */
.store-picker-capsule .arrow {
  font-size: 20rpx;
  color: #888888;
  margin-left: 12rpx;
  line-height: 1 !important;
  display: inline-flex;
  align-items: center;
}

/* ===== 关键突破：高层级全屏遮罩蒙层 ===== */
.store-sheet-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 99999 !important;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.store-sheet-backdrop.show {
  opacity: 1;
  pointer-events: auto;
}

/* 底部滑出面板 */
.store-sheet-panel {
  width: 100%;
  background: #FBF9F5;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 16rpx 28rpx 0;
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.25s ease;
  max-height: 75vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 顶部拖拽把手：纯视觉提示，表明这是一张可下滑关闭的面板 */
.sheet-drag-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #E3D9C8;
  margin: 0 auto 20rpx;
  flex-shrink: 0;
}

.store-sheet-backdrop.show .store-sheet-panel {
  transform: translateY(0);
}

/* ===== 头部栏 ===== */
.sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #EFE6D8;
  flex-shrink: 0;
}

.header-left {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  display: block;
}

.current-active-tip {
  font-size: 22rpx;
  color: #8C1D18;
  margin-top: 6rpx;
  display: block;
  font-weight: 500;
}

.sheet-close-btn {
  font-size: 36rpx;
  color: #999999;
  padding: 10rpx;
  flex-shrink: 0;
}

/* ===== 🌐 全国家园网络：搜索 + 省市筛选 + 附近门店 ===== */
.store-filter-bar {
  margin-top: 20rpx;
  flex-shrink: 0;
}

.filter-search-box {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #F8F5F0;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 14rpx;
}

.filter-search-icon {
  font-size: 24rpx;
}

.filter-search-input {
  flex: 1;
  font-size: 26rpx;
  color: #222222;
}

.filter-row {
  display: flex;
  gap: 12rpx;
}

.filter-pill {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #666666;
  background: #F8F5F0;
  border-radius: 20rpx;
  padding: 12rpx 0;
  white-space: nowrap;
}

.filter-pill.active {
  background: #FFF3E0;
  color: #8C1D18;
  font-weight: bold;
}

.filter-pill.disabled {
  opacity: 0.5;
}

.filter-pill.nearby-pill {
  background: #FFF9F0;
  color: #B45309;
}

.filter-pill.nearby-pill.active {
  background: #B45309;
  color: #FFFFFF;
}

.store-empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #999999;
}

.btn-clear-filters {
  color: #8C1D18;
  font-weight: bold;
  text-decoration: underline;
}

.store-operating-badge {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  margin-left: 10rpx;
  background: #e6f4ea;
  color: #137333;
  font-weight: 500;
  flex-shrink: 0;
}

.store-operating-badge.preparing {
  background: #FFF3E0;
  color: #D48806;
}

.store-operating-badge.paused {
  background: #F1F3F5;
  color: #868E96;
}

/* 门店名称纵向列：名称行 + 地域/距离行 */
.store-name-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.store-name-row {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
}

.store-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 地域微徽章：轻量灰底圆角胶囊 */
.store-region-tag {
  font-size: 20rpx;
  color: #6B7280;
  background: #F3F4F6;
  border-radius: 20rpx;
  padding: 2rpx 12rpx;
  line-height: 1.4;
}

.store-distance-label {
  font-size: 20rpx;
  color: #B45309;
  font-weight: 500;
}

/* ===== 🛡️ 超级管理员专属置顶卡片 ===== */
.superadmin-pinned-card {
  flex-shrink: 0;
  margin-top: 20rpx;
  background: linear-gradient(135deg, #FFF5F0 0%, #FFF0EC 100%);
  border: 2rpx solid #8C1D18;
  border-left: 8rpx solid #8C1D18;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 20rpx rgba(140, 29, 24, 0.12);
}

.superadmin-name {
  color: #8C1D18 !important;
  font-weight: bold;
}

/* ===== 滚动列表：flex: 1 + height: 0 强制占满面板剩余高度，使其在 flex 列中
   真正独立滚动，顶部固定区与底部按钮永不被内容撑出视口 ===== */
.sheet-scroll-list {
  flex: 1;
  height: 0;
  margin-top: 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.store-list-loading-tip {
  text-align: center;
  padding: 16rpx 0;
  font-size: 22rpx;
  color: #999999;
}

/* 门店分组卡片基础样式 */
.store-group-card {
  position: relative;
  background: #FFFFFF;
  border: 1.5rpx solid #EFE6D8;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  transition: all 0.25s cubic-bezier(0.25, 0.8, 0.25, 1);
  box-sizing: border-box;
}

/* 核心：选中态卡片 - 采用左侧高亮烫金线 + 柔和内阴影 */
.store-group-card.active-store {
  border-color: #8C1D18 !important;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFDF9 100%) !important;
  box-shadow: 0 8rpx 24rpx rgba(140, 29, 24, 0.08) !important;
  border-left: 8rpx solid #8C1D18 !important;
}

/* 门店标题 */
.store-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.store-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  line-height: 1;
}

.store-name-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #222222;
  line-height: 1;
}

/* 身份胶囊选择行 */
.role-selector-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* 身份可点击胶囊
   🐛 加固：此前只有 transition，没有任何 :active 规则——点击热区虽然整个
   pill 都能响应 bindtap，但视觉上完全没有按压反馈，手感生硬，用户容易怀疑
   "有没有点中"。补一条与本页其余可点击元素同风格的轻微缩放+透明度反馈 */
.role-choice-pill {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 20rpx;
  border-radius: 32rpx;
  background: #F8F9FA;
  border: 1rpx solid #E9ECEF;
  box-sizing: border-box;
  transition: transform 0.12s ease, opacity 0.12s ease, background-color 0.2s ease, border-color 0.2s ease;
}

.role-choice-pill:active {
  transform: scale(0.95);
  opacity: 0.85;
}

.role-choice-pill .role-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
  line-height: 1;
}

.role-choice-pill .role-label {
  font-size: 24rpx;
  color: #555555;
  font-weight: 500;
  line-height: 1;
}

/* 选中态对勾：Reddit 风格的实心蓝色圆形徽标（text 组件用 line-height 居中，不依赖 flex） */
.role-choice-pill .check-mark {
  display: inline-block;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #1A73E8;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: bold;
  line-height: 28rpx;
  text-align: center;
  margin-left: 10rpx;
}

/* 选中高亮状态：朱红浅底 + 微阴影，当前激活身份一目了然 */
.role-choice-pill.selected {
  border-color: #8C1D18 !important;
  background: #FFEBEE !important;
  box-shadow: 0 2rpx 8rpx rgba(140, 29, 24, 0.15) !important;
}

.role-choice-pill.selected .role-label {
  color: #8C1D18 !important;
  font-weight: bold;
}

/* 未授权锁定的角色胶囊 */
.role-choice-pill.locked {
  background: #F2F4F8 !important;
  border-color: #E2E8F0 !important;
  opacity: 0.65;
}

.role-choice-pill.locked .role-label {
  color: #888888 !important;
}

/* 🔒 申请审核中：区别于纯粹"未授权"的 locked（灰色不可交互暗示"去申请"），
   pending 用琥珀色提示"已经提交、正在等审核"，视觉上更接近"进行中"而非"被拒" */
.role-choice-pill.pending {
  background: #FFF8E1 !important;
  border-color: #F0C36D !important;
  opacity: 1;
}

.role-choice-pill.pending .role-label {
  color: #B8860B !important;
  font-weight: 500;
}

/* ===== ➕ 新建门店入口按钮：吸底高亮 CTA，视觉权重与"确认激活"按钮一致
   🐛 加固：显式 flex 居中，不再单靠 text-align + 对称 padding 隐式凑出居中
   效果——与本项目其余按钮统一走 flex 居中这一套，文本/图标垂直水平都居中 ===== */
.new-store-entry-btn {
  margin-top: 20rpx;
  /* 面板本身在 z-index:99999 遮罩层内，无需为 TabBar 留出 120rpx；
     仅需 safe-area-inset-bottom 保障 iOS 全面屏底部不被黑条遮挡 */
  margin-bottom: calc(24rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  padding: 22rpx 0;
  border-radius: 40rpx;
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: bold;
  background: #8C1D18;
  box-shadow: 0 8rpx 20rpx rgba(140, 29, 24, 0.22);
}

.new-store-entry-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* ===== 新建门店申请表单（三段式 Body + Footer） ===== */

/* Body：可滚动区域，max-height 留出 Footer 高度 */
.sheet-form-scroll {
  flex: 1;
  min-height: 0;
  max-height: 50vh;
}

/* Footer：固定置底，不随 scroll-view 滚动 */
.sheet-footer {
  flex-shrink: 0;
  background: #FBF9F5;
  /* 120rpx = 100rpx TabBar + 20rpx 间距，防止新门店申请提交按钮被 TabBar 遮挡 */
  padding: 24rpx 0 calc(120rpx + env(safe-area-inset-bottom));
  z-index: 10;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.new-store-form {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.new-store-form-back {
  font-size: 24rpx;
  color: #8C1D18;
  margin-bottom: 20rpx;
}

.new-store-form .form-label {
  font-size: 24rpx;
  color: #666666;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
}

.new-store-form .form-hint {
  display: block;
  font-size: 22rpx;
  color: #8C1D18;
  background: #FFF3E0;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

/* 🐛 输入框高度塌陷修复：统一规范为标准输入控件规格——height/line-height
   双写保证 <input> 单行文本必定垂直居中（不依赖组件自身默认行为），
   box-sizing:border-box 保证 padding 不会把内容区再往下挤出可视高度之外。
   margin-top 是标签与输入框之间的间距，margin-bottom 保留给下一个字段的
   标签留白，两者不冲突 */
.new-store-input {
  height: 80rpx;
  line-height: 80rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333333;
  margin-top: 12rpx;
  margin-bottom: 24rpx;
}

/* 🆕 所属地区 picker 的展示行——套用 <input> 同款外观，用 flex 让文字垂直居中
   （<input> 本身自带垂直居中，换成 <view> 包 <text> 需要手动补上），并与
   平台类型 picker 一致在右侧留出下拉箭头的位置 */
.region-picker-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.region-placeholder {
  color: #ADB5BD;
}

/* 🏢 平台类型 picker 展示行 */
.picker-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 两个 picker 展示行点击态微暗反馈，与全站其余可点击行统一语汇 */
.picker-selector-hover {
  background: #EDEEF0;
}

.picker-arrow {
  color: #ADB5BD;
  font-size: 24rpx;
  flex-shrink: 0;
}

/* 必填星号 */
.form-label-required {
  color: #E53935;
  margin-right: 4rpx;
}

/* 选填字段的弱化提示，跟在 form-label 后面同一行展示 */
.form-label-optional {
  color: #ADB5BD;
  font-weight: normal;
  font-size: 22rpx;
}

/* ================= 🌟 申请身份：大家长/店长 双列核心角色卡片 ================= */
.role-card-row {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
  margin-bottom: 20rpx;
}

.role-card {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 24rpx 12rpx;
  background: #F8F9FA;
  border: 2rpx solid #EEEEEE;
  border-radius: 16rpx;
  box-sizing: border-box;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.role-card-active {
  background: #FFF2F0;
  border-color: #C43A3A;
}

/* 原生 radio 圆点隐藏——label 包裹整张卡片仍是完整可点击区域，
   radio-group 只关心 radio 的 checked 状态变化，不要求它可见 */
.role-card-radio {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
}

.role-card-badge {
  position: absolute;
  top: -1rpx;
  right: -1rpx;
  background: #C43A3A;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: bold;
  padding: 4rpx 12rpx;
  border-radius: 0 14rpx 0 14rpx;
}

.role-card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.role-card-active .role-card-title {
  color: #C43A3A;
}

.role-card-desc {
  font-size: 20rpx;
  color: #999999;
}

.role-card-active .role-card-desc {
  color: #C97B7B;
}

.new-store-role-group {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.new-store-role-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #555555;
}

/* 🏪 新建门店档案照片九宫格：与 pages/index/index.wxss 的 .receipt-grid-container
   同款视觉，组件样式默认隔离不共享页面 wxss，这里单独复制一份精简版（不含缩略图
   加载失败兜底，这张表单里的图片选完直接展示本地/云端路径，用不到那层） */
.receipt-grid-container {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.grid-image-item {
  position: relative;
  width: 100%;
  padding-top: 100%;
  border-radius: 16rpx;
  overflow: visible;
}

.grid-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  border: 1.5rpx solid #EFE6D8;
}

.img-delete-badge {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 38rpx;
  height: 38rpx;
  background: rgba(211, 47, 47, 0.95);
  color: #FFFFFF;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.15);
}

.grid-add-btn {
  background: #FAF8F5;
  border: 2.5rpx dashed #C8B195;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  aspect-ratio: 1/1;
}

.grid-add-btn .add-icon {
  font-size: 40rpx;
  color: #8C1D18;
  line-height: 1;
  font-weight: 300;
}

.grid-add-btn .add-txt {
  font-size: 18rpx;
  color: #8C1D18;
  margin-top: 4rpx;
}

.new-store-submit-btn {
  width: 100%;
  box-sizing: border-box;
  background: #8C1D18;
  color: #FFFFFF;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: bold;
  padding: 20rpx 40rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: flex;
  align-items: center;
  justify-content: center;
}

.new-store-submit-btn::after {
  border: none;
}

.new-store-submit-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* ===== 特权身份激活弹窗 ===== */
.modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 100000 !important;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-card {
  width: 85%;
  max-width: 620rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #EFE6D8;
  margin-bottom: 16rpx;
}

.modal-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  flex: 1;
  padding-right: 20rpx;
  line-height: 1.4;
}

.close-btn {
  font-size: 32rpx;
  color: #999999;
  padding: 6rpx 10rpx;
  flex-shrink: 0;
  line-height: 1;
}

/* 激活弹窗选项卡 */
.auth-tab-bar {
  display: flex;
  background: #F8F9FA;
  border-radius: 16rpx;
  padding: 6rpx;
  margin: 16rpx 0;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #666666;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.tab-item.active {
  background: #FFFFFF;
  color: #8C1D18;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.auth-body {
  margin: 24rpx 0;
}

.auth-tip {
  font-size: 24rpx;
  color: #555555;
  line-height: 1.6;
  display: block;
  margin-bottom: 20rpx;
}

.auth-code-input {
  background: #F8F9FA;
  border: 2rpx solid #8C1D18;
  border-radius: 16rpx;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.sub-help-text {
  font-size: 20rpx;
  color: #999999;
  margin-top: 12rpx;
  display: block;
}

.auth-footer-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn-cancel {
  flex: 1;
  background: #F8F9FA;
  color: #666666;
  border-radius: 40rpx;
  font-size: 26rpx;
}

.btn-cancel::after {
  border: none;
}

.btn-confirm-auth {
  flex: 1.5;
  background: #8C1D18;
  color: #FFFFFF;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: bold;
}

.btn-confirm-auth::after {
  border: none;
}

.btn-confirm-auth:active {
  opacity: 0.85;
  transform: scale(0.98);
}