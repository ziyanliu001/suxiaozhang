/* 🔒 功能受限升级引导弹窗：原样迁移自 pages/statistics/statistics.wxss 的
   .plan-upgrade-modal-* 系列样式（首个落地实现），改名为 .flm-* 前缀，供
   跨页面复用。"知道了"/"去了解"两个按钮强制 flex 居中，显式归零
   box-sizing/padding/margin/line-height，消除微信原生 <button> 默认内边距
   与行高造成的文字/图标偏斜 */
.flm-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.flm-card {
  width: 80%;
  max-width: 560rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.28);
}

.flm-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1A1A1A;
  text-align: center;
  margin-bottom: 20rpx;
}

.flm-content {
  font-size: 27rpx;
  color: #495057;
  line-height: 1.6;
  text-align: center;
  margin-bottom: 32rpx;
}

.flm-footer {
  display: flex;
  gap: 20rpx;
}

.flm-btn-cancel,
.flm-btn-confirm {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 1;
  border-radius: 42rpx;
  font-size: 27rpx;
  font-weight: bold;
  border: none;
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.flm-btn-cancel::after,
.flm-btn-confirm::after {
  border: none;
}

.flm-btn-cancel {
  background: #F1F3F5;
  color: #495057;
}

.flm-btn-cancel:active {
  background: #E3E6E9;
  transform: scale(0.97);
}

.flm-btn-confirm {
  background: linear-gradient(135deg, #B8860B 0%, #DAA520 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(184, 134, 11, 0.35);
}

.flm-btn-confirm:active {
  opacity: 0.88;
  transform: scale(0.97);
}
