<view class="archive-modal-mask {{visible ? 'show' : ''}}" bindtap="onMaskTap">
  <view class="archive-modal-content" catchtap="noop">
    <!-- 头部装饰 -->
    <view class="modal-header-decoration">
      <view class="deco-line"></view>
      <view class="lotus-icon"></view>
      <view class="deco-line"></view>
    </view>

    <view class="modal-title">我的雨花护持档案</view>

    <!-- 用户信息区：🛡️ 合规修复——微信已收回 <open-data> 展示个人头像/昵称的能力，
         改用标准 <image>/<text> 绑定小程序自己存下来的头像/昵称（经 chooseAvatar/
         type="nickname" 官方能力采集，见 pages/profile/profile），不再依赖 open-data -->
    <view class="user-profile-section">
      <view class="avatar-ring">
        <image wx:if="{{userInfo.avatarUrl}}" class="user-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="user-avatar user-avatar-placeholder">👤</view>
      </view>
      <view class="user-name-box">
        <text class="user-name">{{userInfo.nickName || '雨花义工家人'}}</text>
        <text class="user-slogan">感恩您的每一次默默付出</text>
      </view>
    </view>

    <!-- 数据卡片 -->
    <view class="stats-card">
      <view class="stat-cell">
        <text class="stat-value">{{userInfo.totalDays || 0}}</text>
        <text class="stat-label">累计护持/天</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-cell">
        <text class="stat-value">{{userInfo.totalCheckInCount || 0}}</text>
        <text class="stat-label">累计打卡/次</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-cell">
        <text class="stat-value">{{userInfo.totalHours || 0}}</text>
        <text class="stat-label">贡献工时/h</text>
      </view>
    </view>

    <!-- 荣誉勋章 -->
    <view class="honor-section">
      <view class="medal-row">
        <view class="medal-icon"></view>
        <text class="medal-name">{{honor.currentLevelName || '初心行者'}}</text>
      </view>

      <!-- 金色渐变进度条 -->
      <view class="progress-box">
        <view class="progress-track">
          <view class="progress-fill" style="width: {{honor.progressPercent || 0}}%;"></view>
        </view>
        <text class="progress-text" wx:if="{{honor.remainHours > 0}}">还需 {{honor.remainHours}} 小时升级</text>
        <text class="progress-text progress-full" wx:else>已是最高荣誉等级</text>
      </view>

      <view class="next-level-tip" wx:if="{{honor.remainHours > 0}}">
        距离「{{honor.nextLevelName}}」还差 {{honor.remainHours}} 小时
      </view>
    </view>

    <!-- 感恩语 -->
    <view class="gratitude-quote">
      用一餐饭的温度，传递温暖与关爱。感恩每一位默默护持的家人！
    </view>

    <!-- 双按钮 -->
    <view class="modal-actions">
      <button class="btn-share-honor {{isDrawing ? 'loading' : ''}}" bindtap="onSharePoster">
        <view class="btn-icon honor-icon"></view>
        <text class="btn-text">{{isDrawing ? '生成中...' : '分享荣誉海报'}}</text>
      </button>
      <view class="btn-secondary-row">
        <view class="btn-view-journey" bindtap="onViewJourney">
          <view class="btn-icon journey-icon"></view>
          <text class="btn-text">查看暖心历程</text>
        </view>
        <view class="btn-close" bindtap="onClose">
          <text class="btn-text">继续护持</text>
        </view>
      </view>
    </view>

    <!-- 关闭小按钮 -->
    <view class="modal-close-x" bindtap="onClose">
      <text class="close-x-text">✕</text>
    </view>

    <!-- 离屏 Canvas：用于海报合成 -->
    <canvas
      type="2d"
      id="honorPosterCanvas"
      class="poster-canvas-offscreen"
      style="width: 1px; height: 1px;"
    ></canvas>
  </view>

  <!-- 🌟【我的爱心荣誉卡】预览：海报生成完成后先展示出来，用户确认好看再手动保存，
       而不是像此前那样生成完直接静默存进相册——用户完全看不到长什么样 -->
  <view class="poster-preview-mask" wx:if="{{showPosterPreview}}" catchtap="onClosePosterPreview">
    <view class="poster-preview-card" catchtap="noop">
      <view class="poster-preview-header">
        <text class="poster-preview-title">💛 我的爱心荣誉卡</text>
        <view class="poster-preview-close" catchtap="onClosePosterPreview">
          <text class="close-x-text">✕</text>
        </view>
      </view>

      <scroll-view scroll-y class="poster-preview-scroll">
        <image
          src="{{posterTempFilePath}}"
          mode="widthFix"
          class="poster-preview"
          show-menu-by-longpress="{{true}}"
        />
      </scroll-view>

      <view class="poster-preview-footer">
        <view class="poster-preview-btn-secondary" catchtap="onClosePosterPreview">
          <text class="btn-text">再想想</text>
        </view>
        <button
          class="poster-preview-btn-primary {{posterSaving ? 'loading' : ''}}"
          bindtap="onConfirmSavePoster"
          loading="{{posterSaving}}"
          disabled="{{posterSaving}}"
        >
          <text class="btn-text">{{posterSaving ? '保存中...' : '💾 保存到相册'}}</text>
        </button>
      </view>
    </view>
  </view>
</view>
