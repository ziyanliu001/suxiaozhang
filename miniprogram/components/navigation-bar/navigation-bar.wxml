<view class="weui-navigation-bar {{extClass}}">
  <view class="weui-navigation-bar__inner {{ios ? 'ios' : 'android'}}" style="color: {{color}}; background: {{background}}; {{displayStyle}}; {{innerPaddingRight}}; {{safeAreaTop}};">

    <!-- 左侧按钮 -->
    <view class='weui-navigation-bar__left' style="{{leftWidth}};">
      <block wx:if="{{back || homeButton}}">
        <!-- 返回上一页 -->
        <block wx:if="{{back}}">
          <view class="weui-navigation-bar__buttons weui-navigation-bar__buttons_goback">
            <view
              bindtap="back"
              class="weui-navigation-bar__btn_goback_wrapper"
              hover-class="weui-active"
              hover-stay-time="100"
              aria-role="button"
              aria-label="返回"
            >
              <view class="weui-navigation-bar__button weui-navigation-bar__btn_goback"></view>
            </view>
          </view>
        </block>

        <!-- 新增：紧邻返回按钮的「回到首页」按钮（双功能模式，actualShowHome 由 attached 计算得出） -->
        <block wx:if="{{actualShowHome}}">
          <view class="weui-navigation-bar__buttons weui-navigation-bar__buttons_home_dual">
            <view
              bindtap="goHome"
              class="weui-navigation-bar__btn_home_dual_wrapper"
              hover-class="weui-active"
              hover-stay-time="100"
              aria-role="button"
              aria-label="回到首页"
            >
              <!-- 使用 SVG 房子图标（避免 Emoji 跨平台渲染差异） -->
              <view class="weui-navigation-bar__btn_home_dual_icon"></view>
            </view>
            <!-- 按钮间细分隔线 -->
            <view class="weui-navigation-bar__btn_divider"></view>
          </view>
        </block>

        <!-- 返回首页（原独立模式，保留向后兼容） -->
        <block wx:if="{{homeButton && !actualShowHome}}">
          <view class="weui-navigation-bar__buttons weui-navigation-bar__buttons_home">
            <view
              bindtap="goHome"
              class="weui-navigation-bar__btn_home_wrapper"
              hover-class="weui-active"
              aria-role="button"
              aria-label="首页"
            >
              <view class="weui-navigation-bar__button weui-navigation-bar__btn_home"></view>
            </view>
          </view>
        </block>
      </block>
      <block wx:else>
        <slot name="left"></slot>
      </block>
    </view>

    <!-- 标题 -->
    <view class='weui-navigation-bar__center'>
      <view wx:if="{{loading}}" class="weui-navigation-bar__loading" aria-role="alert">
        <view
          class="weui-loading"
          aria-role="img"
          aria-label="加载中"
        ></view>
      </view>
      <block wx:if="{{title}}">
        <text>{{title}}</text>
      </block>
      <block wx:else>
        <slot name="center"></slot>
      </block>
    </view>
    
    <!-- 右侧留空 -->
    <view class='weui-navigation-bar__right' style="{{rightWidth}}">
      <slot name="right"></slot>
    </view>
  </view>
</view>
