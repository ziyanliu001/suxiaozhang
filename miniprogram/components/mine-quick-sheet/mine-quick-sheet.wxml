<!-- "我的" 快捷操作面板：不改变点击"你" Tab 整页跳转的行为，只是从个人中心页头部
     图标额外触发的一个小型 Bottom Sheet，四个入口全部对应真实存在的页面/能力 -->
<view class="quick-sheet-backdrop {{show ? 'show' : ''}}" bindtap="close" catchtouchmove="preventTouchMove">
  <view class="quick-sheet-panel" catchtap="stopBubble">

    <view class="quick-sheet-drag-handle"></view>

    <view class="quick-sheet-header">
      <text class="quick-sheet-title">快捷操作</text>
      <text class="quick-sheet-close" bindtap="close">✕</text>
    </view>

    <view class="quick-sheet-list">
      <view class="quick-sheet-item" bindtap="onTapHistory">
        <text class="quick-sheet-icon">🧾</text>
        <text class="quick-sheet-text">历史经手流水</text>
        <text class="quick-sheet-arrow">›</text>
      </view>
      <view class="quick-sheet-item" bindtap="onTapDraftBox">
        <text class="quick-sheet-icon">✍️</text>
        <text class="quick-sheet-text">草稿箱</text>
        <text class="quick-sheet-arrow">›</text>
      </view>
      <view class="quick-sheet-item" bindtap="onTapSettings">
        <text class="quick-sheet-icon">⚙️</text>
        <text class="quick-sheet-text">设置</text>
        <text class="quick-sheet-arrow">›</text>
      </view>
      <view class="quick-sheet-item" bindtap="onTapHelp">
        <text class="quick-sheet-icon">💬</text>
        <text class="quick-sheet-text">关于与帮助</text>
        <text class="quick-sheet-arrow">›</text>
      </view>
    </view>

  </view>
</view>
