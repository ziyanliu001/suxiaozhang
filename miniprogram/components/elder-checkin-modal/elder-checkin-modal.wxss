/* 组件默认样式隔离（isolated），与 material-usage-modal.wxss 的
   feedback-sheet-* / vt-form-label / vt-status-pill 视觉语言保持一致
   （共享 class 命名习惯，不共享样式实体——各组件样式互相隔离） */

.feedback-sheet-backdrop {
  position: fixed !important;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999998 !important;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  opacity: 0;
  transition: opacity 0.25s ease;
}

.feedback-sheet-backdrop.show {
  opacity: 1;
}

.feedback-sheet-panel {
  position: relative;
  z-index: 999999 !important;
  width: 100%;
  background: #FBF9F5;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 16rpx 28rpx calc(140rpx + env(safe-area-inset-bottom)) !important;
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.25s ease;
}

.feedback-sheet-backdrop.show .feedback-sheet-panel {
  transform: translateY(0);
}

.feedback-sheet-drag-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #E3D9C8;
  margin: 0 auto 24rpx;
}

.feedback-sheet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.feedback-sheet-header-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.feedback-sheet-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.feedback-sheet-subtitle {
  font-size: 22rpx;
  color: #A08A6A;
}

.feedback-sheet-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #F1F3F5;
  color: #6B7280;
  font-size: 24rpx;
  flex-shrink: 0;
}

.vt-form-label {
  display: block;
  font-size: 24rpx;
  color: #6B5B45;
  margin-bottom: 12rpx;
}

.ecm-search-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.ecm-search-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 16rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333333;
}

.ecm-search-btn {
  flex-shrink: 0;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 32rpx;
  background: linear-gradient(135deg, #B8860B 0%, #DAA520 100%);
  color: #FFFFFF;
  font-size: 26rpx;
  border-radius: 16rpx;
  border: none;
}

.ecm-search-btn::after {
  border: none;
}

.ecm-search-btn.btn-is-disabled {
  opacity: 0.5;
}

.ecm-candidate-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.ecm-candidate-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #FFFFFF;
  border: 2rpx solid #EFE6D8;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.ecm-candidate-item.active {
  border-color: #B8860B;
  background: #FFF8E8;
}

.ecm-candidate-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.ecm-candidate-phone {
  font-size: 24rpx;
  color: #868E96;
}

.ecm-candidate-relation {
  margin-left: auto;
  font-size: 22rpx;
  color: #A08A6A;
  background: #F8F4EC;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.vt-status-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.vt-status-pill {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 16rpx;
  background: #F8F9FA;
  color: #868E96;
  font-size: 24rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.vt-status-pill.green.active {
  background: #E6F4EA;
  color: #137333;
  border-color: #137333;
  font-weight: bold;
}

.vt-status-pill.yellow.active {
  background: #FEF7E0;
  color: #B06000;
  border-color: #B06000;
  font-weight: bold;
}

.tool-hint-text {
  display: block;
  font-size: 22rpx;
  color: #A08A6A;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.ecm-hours-row {
  margin-bottom: 20rpx;
}

.ecm-hours-input {
  width: 100%;
  height: 76rpx;
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 16rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333333;
}

.feedback-submit-btn {
  width: 100%;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  background: linear-gradient(135deg, #B8860B 0%, #DAA520 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(184, 134, 11, 0.35);
}

.feedback-submit-btn::after {
  border: none;
}

.feedback-submit-btn:active {
  opacity: 0.85;
}

.feedback-submit-btn.btn-is-disabled {
  opacity: 0.5;
  box-shadow: none;
}
