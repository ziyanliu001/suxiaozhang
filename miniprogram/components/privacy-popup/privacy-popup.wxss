.privacy-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  /* 隐私弹窗必须盖在所有其他弹窗/内容之上，且不可被误关闭——mask 上不绑定任何 tap 事件，
     用户只能通过下方【同意】/【拒绝】两个按钮明确做出选择 */
  z-index: 9999;
}

.privacy-popup-card {
  width: 85%;
  max-width: 620rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 40rpx 32rpx 32rpx;
  box-sizing: border-box;
}

.privacy-popup-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #222222;
  text-align: center;
  margin-bottom: 24rpx;
}

.privacy-popup-body {
  font-size: 26rpx;
  color: #495057;
  line-height: 1.7;
  margin-bottom: 32rpx;
  /* 🛡️（2026-08-31 合规终局阶段）逐项列明权限用途后正文变长，小屏机型上
     加一道保险丝——超出可视高度时正文本身可滚动，不会把底部同意/不同意
     按钮挤出屏幕外导致用户操作不到 */
  max-height: 60vh;
  overflow-y: auto;
}

.privacy-popup-item {
  margin-top: 12rpx;
}

.privacy-popup-link {
  color: #8C1D18;
  font-weight: bold;
}

.privacy-popup-footer {
  display: flex;
  gap: 20rpx;
}

.privacy-popup-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}

.privacy-popup-btn::after {
  border: none;
}

.privacy-popup-btn-disagree {
  background: #F1F3F5;
  color: #495057;
}

.privacy-popup-btn-agree {
  background: linear-gradient(135deg, #8C1D18 0%, #B22222 100%);
  color: #FFFFFF;
  font-weight: bold;
}

.privacy-popup-btn-agree:active,
.privacy-popup-btn-disagree:active {
  opacity: 0.85;
}
