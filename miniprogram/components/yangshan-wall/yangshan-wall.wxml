<!-- 🌸 最新善行公开滚动墙：storeId 未解析出来前整块不渲染（避免闪一下空态寄语再
     被真实数据替换）；storeId 就绪后恒定展示——有名单滚动播放，无名单则显示
     静态兜底寄语，不再让整块组件从页面上消失。
     单行紧凑布局：左侧固定标签 + 右侧内容区（跑马灯/兜底文案）水平排布，
     不再是标题独占一行、内容另起一行的两段式竖排 -->
<view class="yangshan-wall-card {{bare ? 'yangshan-wall-card-bare' : ''}}" wx:if="{{storeId}}">
  <text class="yangshan-wall-title">{{title}}</text>

  <view class="yangshan-wall-content">
    <swiper class="yangshan-wall-swiper" wx:if="{{hasYangShanList}}" vertical autoplay circular interval="2800" duration="400">
      <swiper-item wx:for="{{yangShanList}}" wx:for-index="donorIdx" wx:key="donorIdx">
        <!-- 🆕 点击某条善行弹出轻量详情卡片：catchtap 不冒泡，避免宿主页面
             （如首页阳光账本行）自己的 bindtap 被意外触发 -->
        <view class="yangshan-wall-item" catchtap="onTapDeedItem" data-index="{{donorIdx}}">
          <text class="yangshan-wall-name">{{item.name}}</text>
          <text class="yangshan-wall-deed">{{item.deedText}}</text>
          <text class="yangshan-wall-time" wx:if="{{item.timeLabel}}">· {{item.timeLabel}}</text>
        </view>
      </swiper-item>
    </swiper>

    <view class="yangshan-wall-empty" wx:else>
      <text class="yangshan-wall-empty-text">{{emptyMessage}}</text>
    </view>
  </view>
</view>

<!-- 🆕 善行详情轻量弹窗：不导航去任何新页面，就地放大展示同一份已公开的数据 -->
<view class="yangshan-detail-mask" wx:if="{{showDetailModal}}" bindtap="onCloseDeedDetail">
  <view class="yangshan-detail-card" catchtap="stopDeedDetailPropagation">
    <view class="yangshan-detail-header">
      <text class="yangshan-detail-title">善行详情</text>
      <text class="yangshan-detail-close" bindtap="onCloseDeedDetail">✕</text>
    </view>
    <view class="yangshan-detail-body">
      <text class="yangshan-detail-name">{{detailItem.name}}</text>
      <text class="yangshan-detail-deed">{{detailItem.deedText}}</text>
      <text class="yangshan-detail-time" wx:if="{{detailItem.timeLabel}}">{{detailItem.timeLabel}}</text>
    </view>
  </view>
</view>
