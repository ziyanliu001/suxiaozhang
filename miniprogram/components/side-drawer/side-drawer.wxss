.drawer-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 99998;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.drawer-backdrop.show {
  opacity: 1;
  pointer-events: auto;
}

.drawer-panel {
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  width: 76%;
  max-width: 560rpx;
  background: #FBF9F5;
  box-sizing: border-box;
  padding: 0 0 24rpx;
  display: flex;
  flex-direction: column;
  transform: translateX(-100%);
  transition: transform 0.25s ease;
  box-shadow: 8rpx 0 24rpx rgba(0, 0, 0, 0.12);
}

.drawer-backdrop.show .drawer-panel {
  transform: translateX(0);
}

.drawer-header {
  display: flex;
  align-items: center;
  /* 🛡️ 顶部间距改由 side-drawer.ts 算出的安全区 margin-top 内联样式控制，
     这里只保留左右与底部的常规内边距，不再用固定 72rpx 硬编码猜测安全区高度 */
  padding: 24rpx 28rpx 24rpx;
  border-bottom: 1rpx solid #EFE6D8;
  flex-shrink: 0;
}

.drawer-brand-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8C1D18 0%, #B8433C 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
  line-height: 72rpx;
  text-align: center;
  flex-shrink: 0;
  margin-right: 18rpx;
}

.drawer-brand-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.drawer-store-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.drawer-role-label {
  font-size: 22rpx;
  color: #8C1D18;
  margin-top: 6rpx;
}

.drawer-close {
  font-size: 32rpx;
  color: #999999;
  padding: 8rpx;
  flex-shrink: 0;
}

/* 🌟 轻量快捷「切换门店」入口：胶囊小按钮，与关闭按钮同排，不抢头部视觉焦点 */
.drawer-switch-store-btn {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: #8C1D18;
  background: #FBEAE4;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
}

.drawer-switch-store-btn:active {
  opacity: 0.7;
}

.drawer-scroll {
  flex: 1;
  padding: 12rpx 20rpx 0;
  box-sizing: border-box;
}

/* 🐛 底部安全区：抽屉本体已有固定 24rpx 底部内边距（.drawer-panel），但那是
   面板自身的边界，不会随 scroll-view 内容滚动——长列表滚到底时最后一项仍可能
   贴着全面屏手势条，补一个随内容滚动的安全区占位块 */
.drawer-safe-area-spacer {
  height: calc(24rpx + constant(safe-area-inset-bottom));
  height: calc(24rpx + env(safe-area-inset-bottom));
}

.drawer-group {
  margin-bottom: 20rpx;
}

/* 🌟 精致卡片化分组：每组独立白底卡片 + 极细边框 + 轻投影，替代原来的纯列表
   平铺，分组边界更清晰、层级感更明确 */
.drawer-group-card {
  background: #FFFFFF;
  border: 1rpx solid #F2EAE0;
  border-radius: 20rpx;
  padding: 6rpx 10rpx;
  box-shadow: 0 2rpx 12rpx rgba(140, 29, 24, 0.04);
}

.drawer-group-label {
  display: block;
  font-size: 22rpx;
  color: #999999;
  font-weight: 500;
  padding: 14rpx 10rpx 8rpx;
}

.drawer-item {
  display: flex;
  align-items: center;
  padding: 18rpx 10rpx;
  border-radius: 14rpx;
}

.drawer-item:active {
  background: #F7F1E7;
}

/* 🌟 微图标排版：emoji 装进圆角色块小徽章，替代原来裸露的纯文字图标，
   视觉上更像正式的功能入口而不是随手加的表情符号 */
.drawer-item-icon-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: #FBF3E8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.drawer-item-text {
  font-size: 27rpx;
  color: #333333;
}

/* 🌟 高频操作横向双格：与其余竖排列表项区分开，突出"这两个是快捷操作"的定位 */
.drawer-quick-grid {
  display: flex;
  gap: 16rpx;
  padding: 6rpx 6rpx 10rpx;
}

.drawer-quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 22rpx 8rpx;
  background: #FBF7F1;
  border-radius: 16rpx;
}

.drawer-quick-item-hover {
  background: #F2E9DC;
}

.drawer-quick-icon {
  font-size: 38rpx;
  margin-bottom: 8rpx;
  line-height: 1;
}

.drawer-quick-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #4A3B2C;
}

.drawer-switch-item {
  justify-content: space-between;
}

.drawer-switch-item .drawer-item-text {
  flex: 1;
  min-width: 0;
}

.drawer-switch {
  flex-shrink: 0;
  transform: scale(0.8);
}
