// 前端展示脱敏：仅用于列表渲染，不影响提交/存储的原始数据
// 🐛 根因修复：中间固定只留一个 '*'，字符越长脱敏强度反而越弱（"欧阳志强"
// 此前脱敏成"欧*强"，丢了一个字的观感）——改为按隐去字符数量逐一替换成
// 等量的 '*'。与 miniprogram/utils/privacy.ts、manageVolunteerCheckIn/
// publicVerifyReport 两个云函数三处同名实现保持同一套规则（WXS 运行时是
// 独立沙箱、无法 import TS 模块，也不确定支持 String.prototype.repeat，
// 这里用 for 循环手动拼接 '*'，不依赖该方法；各云函数/WXS 独立部署、无共享
// 模块机制，需要手动同步这四处拷贝）
function maskName(name) {
  if (!name) {
    return '';
  }
  var str = '' + name;
  if (str.length <= 1) {
    return str + '*';
  }
  if (str.length === 2) {
    return str.charAt(0) + '*';
  }
  var stars = '';
  var hiddenCount = str.length - 2;
  for (var i = 0; i < hiddenCount; i++) {
    stars = stars + '*';
  }
  return str.charAt(0) + stars + str.charAt(str.length - 1);
}

function maskPhone(phone) {
  if (!phone) {
    return '';
  }
  var str = '' + phone;
  if (str.length < 7) {
    return str.charAt(0) + '****';
  }
  return str.slice(0, 3) + '****' + str.slice(-4);
}

module.exports = {
  maskName: maskName,
  maskPhone: maskPhone
};
