}

.header-title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
}

.btn-close-drawer-circle {
  width: 56rpx;
  height: 56rpx;
  background-color: #F1F3F5;
  color: #495057;
  border-radius: 50%;
