}

.invite-result-tip {
  display: flex;
  align-items: flex-start;
  gap: 6rpx;
  background: #FFF8E1;
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
  font-size: 22rpx;
  color: #8C5A00;
  line-height: 1.6;
}
.add-icon {
  font-size: 48rpx;
