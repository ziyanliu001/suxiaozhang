}

.platform-card-arrow {
  margin-top: 20rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: bold;
  color: #8C1D18;
}

.platform-card-yuhua {
  border: 2rpx solid rgba(140, 29, 24, 0.15);
}

.platform-card-badge {
  position: absolute;
  top: -16rpx;
  right: 24rpx;
  background: linear-gradient(135deg, #8C1D18 0%, #B22222 100%);
