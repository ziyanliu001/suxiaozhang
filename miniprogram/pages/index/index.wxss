  padding: 8rpx;
}

.adjust-body {
  padding: 16rpx 32rpx;
}

.adjust-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.adjust-info-label {
  color: #606266;
}

.adjust-info-value {
  color: #303133;
  font-weight: 500;
}

.adjust-diff {
  color: #e53935;
  font-weight: bold;
}

.adjust-divider {
  height: 2rpx;
  background: #ebeef5;
  margin: 16rpx 0;
}

.adjust-textarea-wrap {
  margin-top: 16rpx;
}

.adjust-textarea {
  width: 100%;
  min-height: 160rpx;
  max-height: 400rpx;
  border: 2rpx solid #dcdfe6;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  background: #f5f7fa;
  box-sizing: border-box;
}

.adjust-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx 32rpx;
}

.adjust-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
  margin: 0;
  padding: 0;
}

.adjust-btn.cancel {
  background: #f5f7fa;
  color: #606266;
}

.adjust-btn.danger {
  background: #e53935;
  color: #fff;
}

/* 小票识别确认弹窗 */
.ocr-confirm-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ocr-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.ocr-modal-card {
  position: relative;
  width: 88%;
  max-width: 640rpx;
  max-height: 78vh;
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  z-index: 1001;
  display: flex;
  flex-direction: column;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
}

.ocr-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 0 12rpx;
}

.ocr-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #303133;
}

.ocr-modal-close {
  font-size: 32rpx;
  color: #909399;
  padding: 8rpx;
}

.ocr-modal-subtitle {
  padding: 0 0 20rpx;
  font-size: 26rpx;
  color: #606266;
}

.ocr-modal-subtitle .ocr-total {
  color: #E67E22;
  font-weight: bold;
}

.ocr-modal-subtitle .ocr-fail-tip {
  color: #909399;
  margin-left: 8rpx;
}

/* 🌟 确认后预计结余实时预览：与顶部算式校验同一套配色语言(橙色结果强调)，
   放在小票列表上方，滚动查看明细时始终可见，不需要滚到底部才知道结果 */
.ocr-preview-banner {
  background: #FFF8E1;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.ocr-preview-banner .preview-header {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 8rpx;
}

.ocr-preview-banner .preview-header .title {
  font-size: 24rpx;
  color: #8C1D18;
  font-weight: bold;
}

.ocr-preview-banner .preview-formula {
  font-size: 26rpx;
  color: #E65100;
  font-weight: bold;
}

/* 🌟 原价小计/运费/优惠 结构化字段展示：与下方"实付合计"输入框区分开，
   小字号 + 灰底徽标风格，明确这几个是"识别到的过程数据"，不是可编辑的最终结论 */
.ocr-financial-breakdown {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.ocr-financial-breakdown .breakdown-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: #EDEFF1;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.ocr-financial-breakdown .breakdown-label {
  font-size: 22rpx;
  color: #909399;
}

.ocr-financial-breakdown .breakdown-val {
  font-size: 22rpx;
  color: #495057;
  font-weight: bold;
}

.ocr-financial-breakdown .breakdown-val.discount {
  color: #2E7D32;
}

.ocr-detail-container {
  flex: 1;
  padding: 0;
  overflow: hidden;
  max-height: 45vh;
  margin: 20rpx 0;
}

.ocr-receipt-block {
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  border: 1.5rpx solid transparent;
}

/* 🚨 低置信度/金额超阈值：整块用红色描边强化，与正常小票拉开区分 */
.ocr-receipt-block.has-warning {
  border-color: #FFCDD2;
  background: #FFF8F8;
}

/* 🌟 图文同屏对比：小票原图缩略展示在明细上方，点击原生放大 */
.ocr-receipt-image-wrap {
  position: relative;
  margin-bottom: 16rpx;
  border-radius: 10rpx;
  overflow: hidden;
  border: 1rpx solid #E9ECEF;
}

.ocr-receipt-image {
  width: 100%;
  max-height: 320rpx;
  display: block;
}

.ocr-receipt-image-hint {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  font-size: 18rpx;
  color: #FFFFFF;
  background: rgba(0, 0, 0, 0.45);
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.ocr-warning-banner {
  background: #FFEBEE;
  color: #C62828;
  font-size: 22rpx;
  font-weight: 500;
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.ocr-receipt-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx dashed #dee2e6;
}

.ocr-receipt-title .receipt-index {
  font-size: 24rpx;
  color: #fff;
  background: #F5A623;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.ocr-receipt-title .receipt-merchant {
  font-size: 26rpx;
  color: #495057;
  font-weight: 500;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

/* 🌟 实付合计人工覆盖行：单独一行，避免和商户名挤在标题行里，
   金额本身用可编辑 input 呈现，与下方逐条商品的编辑框保持同一视觉语言 */
.ocr-receipt-amount-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx dashed #dee2e6;
}

.amount-label {
  font-size: 26rpx;
  color: #495057;
  font-weight: 500;
  flex-shrink: 0;
}

.amount-edit-wrap {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.amount-edit-wrap.price-warning .input-receipt-amount {
  border-color: #E53935;
  border-width: 1.5rpx;
  background: #FFF5F5;
}

.amount-edit-wrap .symbol {
  font-size: 26rpx;
  font-weight: bold;
  color: #E65100;
  margin-right: 8rpx;
}

.input-receipt-amount {
  width: 160rpx;
  height: 64rpx;
  background: #F8F9FA;
  border: 1.5rpx solid #E65100;
  border-radius: 12rpx;
  padding: 0 12rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #E65100;
  text-align: right;
  flex-shrink: 0;
}

.manual-override-badge {
  font-size: 20rpx;
  color: #fff;
  background: #8C1D18;
  padding: 3rpx 12rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.ocr-item-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ocr-detail-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  font-size: 26rpx;
  margin-bottom: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.ocr-detail-row .bullet {
  font-size: 28rpx;
  color: #8C1D18;
  margin-right: 8rpx;
  flex-shrink: 0;
}

/* 🌟 疑似识别异常品名：红色描边高亮输入框本身，下方再掉行展示一条小字提示——
   .ocr-detail-row 已加 flex-wrap:wrap，这个提示条设 flex-basis:100% 会自动挤到独立一行，
   不影响没有异常标记的普通行的紧凑单行布局 */
.input-item-name.name-suspicious {
  border-color: #E53935;
  border-width: 1.5rpx;
  background: #FFF5F5;
}

.name-suspicious-badge {
  flex-basis: 100%;
  font-size: 20rpx;
  color: #E53935;
  margin: 4rpx 0 0 40rpx;
}

.input-item-name {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  background: #F8F9FA;
  border: 1rpx solid #E9ECEF;
  border-radius: 12rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  color: #333333;
}

.price-edit-wrap {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 🚨 低置信度/金额超阈值时，金额输入框改为红色边框预警 */
.price-edit-wrap.price-warning .input-item-price {
  border-color: #E53935;
  border-width: 1.5rpx;
  background: #FFF5F5;
}

.price-edit-wrap .symbol {
  font-size: 24rpx;
  font-weight: bold;
  color: #E65100;
  margin-right: 8rpx;
}

.input-item-price {
  width: 140rpx;
  height: 64rpx;
  background: #F8F9FA;
  border: 1rpx solid #E9ECEF;
  border-radius: 12rpx;
  padding: 0 12rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #E65100;
  text-align: right;
  flex-shrink: 0;
}

.ocr-detail-fallback {
  font-size: 26rpx;
  color: #6c757d;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.ocr-modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 0 0;
}

.ocr-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  font-size: 26rpx;
  text-align: center;
  border: none;
  margin: 0;
  padding: 0;
  font-weight: 500;
}

.ocr-btn.cancel {
  background: #f5f7fa;
  color: #606266;
}

.ocr-btn.adjust {
  background: #fff;
  color: #F5A623;
  border: 2rpx solid #F5A623;
}

.ocr-btn.confirm {
  background: linear-gradient(135deg, #F5A623 0%, #D97706 100%);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(245, 166, 35, 0.3);
}

.ocr-btn::after {
  border: none;
}

.balance-history-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.balance-history-modal-box {
  width: 100%;
  max-height: 75vh;
  background: #FFFFFF;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 32rpx;
  /* 🐛 修复：底部提示文字在全面屏设备上被物理 Home 指示条遮盖——
     32rpx 内边距不足以覆盖 env(safe-area-inset-bottom) */
  padding-bottom: calc(32rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.modal-top-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F1F3F5;
}

.header-title-group {
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #212529;
}

.modal-sub-title {
