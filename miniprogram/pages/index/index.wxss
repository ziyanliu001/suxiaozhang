  height: 72rpx;
  margin-top: 8rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
  line-height: 1.6;
  /* 全国视角下 empty-desc 不渲染，标题直接接按钮；段落间距统一保持 30rpx 以上 */
  margin-bottom: 30rpx;
}

.empty-desc {
  font-size: 22rpx;
  color: #868E96;
  margin: 12rpx 0 40rpx 0;
  max-width: 80%;
