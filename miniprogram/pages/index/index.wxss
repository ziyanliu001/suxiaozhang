/* 🌟 合规 Footer（组件二）：此前 20rpx/#a0a0a0 的小灰字几乎不可读，等同于"藏起来"，
   不符合"清晰可读但视觉弱化、不干扰主功能"的要求——弱化应该体现在色彩/层级上，
   不能体现在"读不清楚"上。改为浅米色卡片背景 + 常规可读字号，与主内容明确分区，
   但不采用高饱和度色彩，保持视觉上的次要地位。 */
.compliance-footer {
  margin: 32rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));
  padding: 20rpx 24rpx;
  background: #FBF8F2;
  border: 1rpx solid #EFE6D8;
  border-radius: 16rpx;
}

.compliance-footer-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.compliance-footer-icon {
  flex-shrink: 0;
  width: 24rpx;
  height: 24rpx;
  margin-top: 2rpx;
  opacity: 0.6;
}

.compliance-footer-text {
  flex: 1;
  font-size: 22rpx;
  color: #8A8580;
  line-height: 1.6;
}

.compliance-footer-link {
  display: block;
  margin-top: 10rpx;
  margin-left: 34rpx;
  font-size: 22rpx;
  color: #8C1D18;
  font-weight: 500;
}

/* 🌟 合规授权须知弹窗（组件一）：首次进入 / 首次切换到财务/店长视角强制阅读，
   与站内其它弹窗一致的白卡片圆角风格，仅在内容与关闭规则上更严格——
   'general'/'privileged' 场景下没有关闭按钮、mask 不响应 tap，只能读完点底部按钮 */
.compliance-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.compliance-modal-card {
  width: 88%;
  max-width: 640rpx;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 28rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.compliance-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.compliance-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #222222;
}

.compliance-modal-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #F1F3F5;
  color: #6B7280;
  font-size: 24rpx;
}

.compliance-modal-body {
  flex: 1;
  max-height: 56vh;
}

.compliance-section {
  margin-bottom: 28rpx;
}

.compliance-section-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #8C1D18;
  margin-bottom: 10rpx;
}

.compliance-section-text {
  font-size: 25rpx;
  color: #495057;
  line-height: 1.8;
  text-align: justify;
}

.compliance-emphasis {
  font-weight: bold;
  color: #212529;
}

.compliance-modal-footer {
  margin-top: 20rpx;
}

.compliance-confirm-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
