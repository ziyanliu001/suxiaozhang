  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #FFF7E6 0%, #FFEBC8 100%);
  border-bottom: 2rpx solid #FFD666;
}

.offline-icon {
  font-size: 32rpx;
}

.offline-text {
  font-size: 26rpx;
  color: #D46B08;
}

.offline-action {
  font-size: 24rpx;
  color: #E53935;
  font-weight: bold;
}

.bottom-links-card {
  /* 主生成按钮已迁移到底部固定吸底的 .bottom-action-floating-bar；
     这里只剩意见反馈/协议链接，保持页面滚动内容末尾干净精简 */
  width: 100%;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.sub-btn-group {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.btn-sub {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  background-color: #F5F7FA;
  color: #4A5568;
  font-size: 26rpx;
  border-radius: 34rpx;
  border: none;
  padding: 0;
}

/* 吸底按钮组的高度占位，防止其遮挡滚动区域最后一块内容 */
.floating-bar-spacer {
  /* 🌟 加大到 180rpx，确保"意见反馈/用户服务协议"链接不会被下方固定吸底的
     生成餐报文本/生成公示海报双按钮遮挡（原 88rpx+48rpx=136rpx 余量偏紧） */
  height: calc(180rpx + env(safe-area-inset-bottom));
}

.btn-hover {
  opacity: 0.8;
  transform: scale(0.99);
  transition: all 0.1s ease;
}

.btn-disabled {
  opacity: 0.6 !important;
  pointer-events: none;
}

.agreement-tips {
  font-size: 20rpx;
  color: #A0AEC0;
  text-align: center;
  margin-top: 8rpx;
}

.agreement-tips .link {
  color: #4CAF50;
}

.report-result-card {
  width: 100%;
  box-sizing: border-box;
  background-color: #FFF5F5;
  border: 1rpx solid #FFE3E3;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.result-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}

.result-card-header .title {
  font-size: 30rpx;
  font-weight: 600;
  color: #D32F2F;
}

.result-card-header .toggle-icon {
  font-size: 26rpx;
  color: #666666;
}

.result-card-body {
  padding: 0 32rpx 28rpx 32rpx;
}

/* 实时算式校验高亮条 */
.math-proof-bar {
  background: #FFF8E1;
  border: 1rpx solid #FFE082;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  margin: 16rpx 0 24rpx 0;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  box-sizing: border-box;
}

.math-proof-bar .proof-label {
  font-size: 24rpx;
  font-weight: bold;
  color: #E65100;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.math-proof-bar .proof-val {
  font-size: 24rpx;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", sans-serif;
  font-weight: bold;
  color: #8C1D18;
  word-break: keep-all;
  white-space: nowrap;
}
.output-text {
  width: 100%;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-all;
  display: block;
  padding: 20rpx 0;
  text-align: left;
  box-sizing: border-box;
}

/* 🌟 生成结果预览里的爱心照片墙：之前这张卡片只有纯文字，上传的食谱/大事记照片
   完全没地方展示，围观餐报的人看不到当天的实景。两个区块各自 wx:if 独立控制，
   互不依赖——只上传了食谱照片也能正常展示，不会因为没有大事记照片而整段消失。 */
.result-photo-section {
  margin-top: 24rpx;
}

.result-photo-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #8C1D18;
  margin-bottom: 16rpx;
}

.result-photo-scroll {
  width: 100%;
  white-space: nowrap;
}

.result-photo-item {
  position: relative;
  display: inline-block;
  width: 200rpx;
  margin-right: 16rpx;
  vertical-align: top;
  white-space: normal;
}

.result-photo-img,
.result-photo-item .thumb-load-failed {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  border: 1.5rpx solid #EFE6D8;
}

.result-photo-name {
  display: block;
  width: 200rpx;
  margin-top: 8rpx;
  font-size: 20rpx;
  font-weight: bold;
  color: #333333;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 九宫格：固定 3 列，每格保持正方形，图片再多也整齐折行，不会挤成长条 */
.result-photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.result-photo-grid-item {
  position: relative;
  width: 100%;
  aspect-ratio: 1/1;
}

.result-photo-grid-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  border: 1.5rpx solid #EFE6D8;
}

.btn-copy {
  background-color: #388e3c;
  color: #fff;
  font-size: 28rpx;
  border-radius: 48rpx;
  padding: 20rpx 0;
  border: none;
  margin-top: 24rpx;
}

.agreement-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 650rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  max-height: 85vh;
}

.agreement-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.agreement-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #323233;
}

.close-icon {
  font-size: 40rpx;
  color: #909399;
  padding: 8rpx;
}

.agreement-body {
  max-height: 55vh;
  padding: 20rpx 30rpx;
  overflow-y: auto;
}

.section {
  margin-bottom: 16rpx;
}

.section-title {
  font-weight: bold;
  font-size: 28rpx;
  color: #2c3e50;
  margin-top: 24rpx;
  margin-bottom: 12rpx;
}

.section-title:first-child {
  margin-top: 0;
}

.section-text {
  font-size: 26rpx;
  color: #606266;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.bullet-item {
  font-size: 25rpx;
  color: #7f8c8d;
  line-height: 1.5;
  padding-left: 16rpx;
  margin-bottom: 6rpx;
}

.agreement-footer {
  padding: 24rpx 32rpx;
  border-top: 2rpx solid #f0f0f0;
}

.confirm-btn {
  display: block;
  width: 100%;
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: bold;
  color: #FFFFFF;
  background-color: #E53935;
  border: none;
  border-radius: 48rpx;
}

/* 平账原因确认弹窗 */
.adjust-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.adjust-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.adjust-content {
  position: relative;
  width: 80%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  z-index: 1001;
}

.adjust-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 16rpx;
}

.adjust-header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #303133;
}

.adjust-close {
  font-size: 32rpx;
