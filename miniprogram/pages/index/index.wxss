.segment-btn .txt {
  font-size: 24rpx;
  color: #495057;
  font-weight: 500;
  white-space: nowrap;
}

/* 选中/触发态：统一切到淡黄底 + 品牌红字，三个按钮共用同一套高亮规则——
   逐条/批量靠 inputMode 互斥切换，图片识别靠 isScanningDonorList 短暂点亮后自动回落 */
.segment-btn.active {
  background: #FFF3BF;
  border-color: #FFE066;
  box-shadow: 0 2rpx 8rpx rgba(255, 224, 102, 0.4);
}

.segment-btn.active .txt {
  color: #D9480E;
  font-weight: bold;
}

.segment-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

