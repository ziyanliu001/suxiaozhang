  color: #B57C1E;
}

/* 📢 门店公告：轻量单行通告条，Header 下方 / 工作台上方，替代原先夹在工具区与表单中间的大卡片 */
/* 🌟 简洁无边框卡片 + marquee 横向滚动：长公告（如"三源弘雨花..."）不再被省略号截断，
   同时保持单行固定高度，不会随文字长度撑高，避免挤压下方核心打卡区空间 */
.announce-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #FFF8ED;
  border: none;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  margin: 12rpx 24rpx 0;
}

.announce-bar-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

/* 🐛 历史踩坑记录：.announce-bar-text 曾用 padding-left:100% + translateX(-100%) 做过一次
   跑马灯动画，percentage padding 是相对"包含块宽度"计算的，跟元素自身内容长度无关，这套
   技巧在微信小程序 WXSS 渲染引擎里对不同长度的动态文案非常不稳定——短标题可能大半个动画
   周期都停在可视区域外（看起来"文字缺失"），长标题换行/裁切位置也可能算错，露出不该出现
   的字符，因此当时改成了纯省略号截断（不滚动）。
   这次换一种不依赖百分比换算的稳定技巧：WXML 侧把超长标题渲染成"原文 + 全角空格 + 原文"
   两份首尾相接（见 .marquee 判断），这里只需要把这段固定的双倍内容整体向左平移自身宽度的
   50%，正好停在第二份原文的起始位置，循环时视觉上无缝衔接，跟文案长度、容器宽度都无关，
   不会重蹈覆辙。 */
.announce-bar-viewport {
  flex: 1;
  min-width: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  display: flex;
  align-items: center;
}

.announce-bar-text {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #B5650A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.announce-bar-text.marquee {
  text-overflow: clip;
  animation: announce-marquee 10s linear infinite;
}

@keyframes announce-marquee {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}
.announce-bar-swiper {
  flex: 1;
  min-width: 0;
  height: 36rpx;
}

.announce-bar-edit {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 8rpx;
}

.announce-bar-add {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: bold;
  color: #B5650A;
  padding: 4rpx 8rpx;
}

.announce-bar-close {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #C9A876;
  padding: 4rpx 8rpx;
}

/* 兜底温馨提示：视觉上比真实通知更柔和，避免用户误以为是一条待处理的正式公告 */
.announce-bar-fallback {
  background: #F7F8FA;
}

.announce-bar-fallback .announce-bar-text {
  color: #8A8F99;
  font-weight: 400;
}

/* 🍱📌 今日食谱 / 今日大事记 预览卡：未发布=虚线引导卡+去发布；已发布=九宫格摘要+去管理 */
.today-menu-preview-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 🌸 每日修身微卡片：非宗教化传统文化/正能量宣导，轻柔配色，不喧宾夺主 */
/* 🌸 每日修身·雨花人生十六最 卡片：独立精美卡片，图标+标题、居中金句、底部并排小按钮 */
/* 🌸 每日修身·雨花家训卡片 */
.culture-motto-card,
.motto-card-wrapper {
  display: flex !important;
  flex-direction: column !important;
  margin: 20rpx 24rpx !important;
  padding: 24rpx !important;
  background: #FFFDF8 !important;
  border: 1rpx solid #F2E8D8 !important;
  border-radius: 16rpx !important;
  box-shadow: 0 4rpx 12rpx rgba(212, 160, 89, 0.08) !important;
  box-sizing: border-box !important;
}

.motto-header {
  display: flex !important;
  flex-direction: row !important;
  align-items: center;
  margin-bottom: 16rpx;
}

.motto-title-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.motto-title-text {
  font-size: 26rpx;
  font-weight: bold;
  color: #8C6A3C;
}

.motto-content {
  display: flex !important;
  flex-direction: row !important;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 12rpx 0 20rpx 0;
}

.motto-quote {
  font-size: 30rpx;
  font-weight: bold;
  color: #D4A059;
}

.motto-quote:first-child {
  margin-right: 6rpx;
}

.motto-quote:last-child {
  margin-left: 6rpx;
}

.motto-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  letter-spacing: 2rpx;
}

.motto-actions {
  display: flex !important;
  flex-direction: row !important;
  justify-content: space-between !important;
  align-items: center !important;
  gap: 16rpx !important;
  width: 100% !important;
  margin-top: 4rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #EFE5D5;
  box-sizing: border-box !important;
}

.motto-btn {
  flex: 1 !important;
  height: 56rpx !important;
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  justify-content: center !important;
  font-size: 24rpx;
  color: #666666;
  background: #FFFFFF !important;
  border: 1rpx solid #E0D0B8 !important;
  border-radius: 28rpx !important;
  box-sizing: border-box !important;
}

/* 🌸 家训弹窗头部：单独加顶部内边距，避免关闭按钮与右上角胶囊（如切店胶囊）重叠——
   只影响这一个弹窗，不改 .modal-header-bar 这个多处弹窗共用的基础类。
   🐛 缩小到 12rpx：原 20rpx 加上 .family-motto-scroll 自身的顶部间距，两层叠加
   导致标题栏和"雨花心字诀"之间空得太多，头重脚轻 */
.family-motto-header {
  padding-top: 12rpx;
}

/* 🌸 标题突出：与 .modal-title-text 的通用灰黑小字区隔开，用品牌深红 + 加大字号 +
   字间距，与下方正文之间建立清晰的视觉层级（标题一眼可辨，不与心字诀/家训正文
   混同）；只在家训头部作用域内覆盖，不影响其他弹窗共用的 .modal-title-text */
.family-motto-header .modal-title-text {
  font-size: 34rpx;
  color: #8C1D18;
  letter-spacing: 4rpx;
}

/* 🐛 内容整体加内边距（而不是只靠 margin），让文字与弹窗左右边框、顶部标题栏都
   留出均匀的呼吸空间；margin 只保留一个较小的顶部值，避免和内边距叠加出过大留白 */
/* 🐛 text-align:center 是 .motto-section-title 改成 inline-block 后能整体居中的
   关键——inline-block 元素自身的 margin:auto 不会生效（这是 CSS 规范行为，不是
   笔误），真正让它水平居中的是这里父容器的 text-align:center；子元素里已经
   显式声明 text-align:left（.culture-list-line 等）的仍按各自声明为准，不受影响。
   底部额外留出 50rpx，滚动到「十、雨花家风」最后一屏时留有呼吸感 */
.family-motto-scroll {
  max-height: 62vh;
  margin: 8rpx 0 16rpx;
  padding: 16rpx 28rpx 50rpx;
  box-sizing: border-box;
  text-align: center;
}

/* 🌸 一至十章节主标题：手机端一律居中展示，深暖红/棕色加粗 + 细下划线；
   display:inline-block 让下划线只贴合文字本身宽度，不再贯穿彈窗左右两侧
   （水平居中依赖父级 .family-motto-scroll 的 text-align:center，见上方注释），
   与无底色的子标题（.culture-sub-title）拉开清晰的章节/子模块层级关系 */
.motto-section-title {
  display: inline-block;
  font-size: 32rpx;
  font-weight: bold;
  color: #8B261C;
  letter-spacing: 2rpx;
  margin: 40rpx 0 20rpx;
  padding: 0 8rpx 12rpx;
  border-bottom: 2rpx solid rgba(139, 38, 28, 0.3);
  text-align: center;
}

.motto-section-title:first-child {
  margin-top: 0;
}

/* 🌸 五/六/八/九大标题：破折号后的【副标题】强制另起一行，避免窄屏下折行错位——
   .motto-section-title 此时改用 <view> 包裹两个 display:block 的 <text> 子行，
   每行独立居中，字号/加粗沿用父级 32rpx Bold，仅额外统一 line-height 与 margin */
.motto-title-line {
  display: block;
  line-height: 1.4;
  text-align: center;
  margin: 0 auto;
}

/* 🌸 心字诀/为学之方正文：加字间距 + 加大行高，配合居中对齐，让四字一顿的
   古风短句有呼吸感，不再挤成密密麻麻的一整块；短句在窄屏下换行也不会显得突兀 */
.motto-section-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  letter-spacing: 3rpx;
  color: #333333;
  text-align: center;
  white-space: pre-wrap;
  margin-bottom: 14rpx;
}

/* 🌸 立志格言：四句分行居中，行高加大到 1.8 + 加粗，比普通正文更有大气庄重感 */
.culture-quote-line {
  line-height: 1.8;
  font-weight: 600;
}

/* 🌸 雨花核心精神：独立成句、加粗展示，与下方三由/五了等条目区隔开 */
.culture-core-spirit-text {
  font-weight: bold;
}

/* 🌸 雨花敬老核心理念：五句逐行单列居中，字号 28rpx / 行高 1.8，段落间距均匀 */
.culture-elder-belief-text {
  font-size: 28rpx;
  line-height: 1.8;
  margin: 0 auto 14rpx;
  text-align: center;
}

/* 🌸 为学之方：单列逐行居中——开篇一句 / 中间六句分句 / 结语一句加粗，
   字号 28rpx、行高 1.8，段落间距均匀一致 */
.culture-study-method-block {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.culture-study-line {
  font-size: 28rpx;
  line-height: 1.8;
  margin: 0 auto 14rpx;
  text-align: center;
}

.culture-study-conclusion {
  font-weight: bold;
}

.motto-creed-line {
  font-size: 26rpx;
  line-height: 1.7;
  letter-spacing: 3rpx;
  color: #333333;
  margin-bottom: 12rpx;
}

/* 🌸 「雨花家训」小标题 + 十八句家训正文独立居中区块：与上方心字诀/下方为学之方
   保持清晰的区块间距，不影响 .family-motto-scroll 的滚动或弹窗高度（只加
   margin/padding）。
   🐛 单靠 text-align: center 未生效——子元素 .motto-section-title/.motto-creed-line
   各自还有自己的 display/width 设定，光靠继承的 text-align 压不过去，这里改用
   flex 列布局 + align-items:center 从容器层面强制居中，再对两个子元素类名加
   !important 兜底，双保险确保样式优先级足够高 */
.motto-creed-block {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center !important;
  margin: 36rpx 0;
  padding: 20rpx 0;
  box-sizing: border-box;
}

.motto-creed-block .motto-creed-line {
  width: 100% !important;
  text-align: center !important;
  display: block !important;
}
/* 📖 雨花文化全集弹窗新增样式：与既有 .motto-section-title/.motto-section-text/
   .motto-creed-line 共用同一套视觉语言，补充三类新增排版需求 */

/* 一、社会主义核心价值观：12 个词汇统一收进 4 列 x 3 行的胶囊网格容器，
   替代此前"每个词单独占一行"的 .culture-value-row 纵向堆叠布局 */
.culture-value-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.culture-value-chip {
  display: block;
  font-size: 24rpx;
  color: #8B261C;
  background: #FFF8F0;
  border-radius: 30rpx;
  padding: 10rpx 6rpx;
  text-align: center;
  box-sizing: border-box;
}

/* 🌸 雨花家道/为学之方等模块内的二级小标题（如【雨花三由】、【雨花家训】）：
   彻底去除粉色卡片底色，改为简洁庄重的纯文字——深暖红加粗 + 前后 "——" 居中
   破折号装饰（装饰符直接写进 WXML 文本内容，小程序原生组件不支持
   ::before/::after），全站所有子标题 100% 统一这一套格式，不再有例外，
   与一至十章节主标题（细下划线）区隔出更轻一级的视觉层次 */
.culture-sub-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #8B261C;
  letter-spacing: 4rpx;
  margin: 24rpx 0 14rpx;
  text-align: center;
}

/* 🌸 三由/五了/六同/八欣：短句对仗型内容的居中 flex-wrap 网格容器，
   让手机窄屏下的短句并排流动展示，避免每句独占一行造成大片左侧留白 */
.culture-pair-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10rpx 20rpx;
  margin-bottom: 8rpx;
}

.culture-pair-grid .culture-list-line {
  flex: 0 1 auto;
  text-align: center;
  margin-bottom: 0;
}

/* 🌸 十个有没有：拆成"只有…/没有…"双列网格，每行左右两列各自居中对齐，
   替代逗号连写在一整行里的拥挤排版；wx:for 用 <block> 每次循环输出左右两个
   cell，按文档流自动落进两列网格 */
.culture-two-col-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx 6rpx;
  margin-bottom: 12rpx;
}

.culture-two-col-cell {
  font-size: 28rpx;
  line-height: 1.7;
  color: #333333;
  text-align: center;
}

/* 🌸 人生十六最：单列纵向列表，左对齐 + 适度缩进，行高/段距进一步加大，
   与其余条目式列表（.culture-list-line 默认样式）区隔出更从容的阅读节奏 */
.culture-list-single-column {
  display: flex;
  flex-direction: column;
  padding-left: 20rpx;
  box-sizing: border-box;
}

.culture-list-single-column .culture-list-line {
  line-height: 1.8;
  margin-bottom: 16rpx;
  text-align: left;
}

/* 🌸 感恩词/雨花五了：单列逐行居中展示，行高加大到 1.8 + 段间距加大，
   与 .culture-list-single-column（人生十六最，左对齐）区分开 */
.culture-list-single-column-center {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.culture-list-single-column-center .culture-list-line {
  text-align: center;
  margin: 0 auto 18rpx;
  line-height: 1.8;
}

/* 🌸 感恩与祈盼·祈盼排比句：三句"祈盼…，让…！"在首个逗号处拆成 6 行单列居中
   展示（左：祈盼…；右：让…依次排列），字号 28rpx，每两行为一组，组间距
   （culture-aspiration-line-group-end）比组内行距更大，避免折行时显得拥挤 */
.culture-list-single-column-center .culture-aspiration-line {
  font-size: 28rpx;
}

.culture-list-single-column-center .culture-aspiration-line-group-end {
  margin-bottom: 32rpx;
}

/* 感恩词/一日修身小结等逐行列表：与 .motto-section-text
   同款字号/行高/字间距，但左对齐、逐行独立展示（不做 .motto-creed-line 那种
   强制居中），更符合这类条目式列表的阅读习惯 */
.culture-list-line {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  letter-spacing: 3rpx;
  color: #333333;
  text-align: left;
  margin-bottom: 12rpx;
}


.today-menu-preview-card.is-empty {
  background: #FFFDFB;
  border: 2rpx dashed #FFCCA8;
  box-shadow: none;
  animation: tmp-shimmer 2.4s ease-in-out infinite;
}

@keyframes tmp-shimmer {
  0%, 100% {
    box-shadow: 0 0 0 rgba(255, 152, 0, 0);
  }
  50% {
    box-shadow: 0 0 16rpx rgba(255, 152, 0, 0.18);
  }
}

/* ❤️ 家人（服务对象）「透明监督版」首页三模块：不填报表、不需要计算工具，
   专注阳光账本大盘 / 今日菜谱 / 雨花大事记与护持剪影三件事 */
.family-home-container {
  padding: 0 24rpx;
  box-sizing: border-box;
}

/* 模块一：阳光账本核心大盘——金/暖色质感背景，突出"公开透明·全民监督" */
.family-sunshine-hero-card {
  background: linear-gradient(155deg, #FFF3D6 0%, #FDE7B8 55%, #F8D992 100%);
  border: 1rpx solid #E6C179;
  border-radius: 28rpx;
  padding: 32rpx 28rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(230, 162, 60, 0.2);
  box-sizing: border-box;
}

.fsh-badge {
  display: inline-block;
  font-size: 22rpx;
  font-weight: bold;
  color: #8B5A00;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
  margin-bottom: 16rpx;
}

.fsh-store-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #6B3E00;
}

.fsh-period {
  display: block;
  font-size: 22rpx;
  color: #8B6A2E;
  margin-top: 4rpx;
  margin-bottom: 20rpx;
}

.fsh-hero-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 20rpx;
  padding: 20rpx 8rpx;
  margin-bottom: 20rpx;
}

.fsh-hero-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fsh-hero-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #8B5A00;
}

.fsh-hero-label {
  font-size: 20rpx;
  color: #8B6A2E;
  margin-top: 6rpx;
  text-align: center;
}

.fsh-hero-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(139, 90, 0, 0.2);
}

.fsh-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fsh-footer-text {
  font-size: 20rpx;
  color: #8B6A2E;
}

.fsh-footer-link {
  font-size: 22rpx;
  font-weight: bold;
  color: #6B3E00;
  flex-shrink: 0;
}

/* 模块二：今日菜谱展示——大字号、高对比度，专注让家人一眼看清今天吃什么 */
.family-menu-card,
.family-activity-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
