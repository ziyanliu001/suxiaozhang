/* ============================================================
   🌸🌿 了凡四训·阳善与阴德：发心选择器 (Radio Cards)
   Bug fix: gap不兼容微信flex / <text>无block display / 胶囊换行
   ============================================================ */

/* 外层容器 */
.merit-selector-wrap {
  background: #FAFAFA;
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 20rpx 0;
  border: 1rpx solid #EFEFEF;
}

.intention-selector-title {
  font-size: 22rpx;
  color: #AAAAAA;
  margin-bottom: 16rpx;
}

/* 双卡片行 — 使用 margin-right 代替 gap（微信 flex gap 兼容性差） */
.intention-segment-row {
  display: flex;
  flex-direction: row;
}

/* 公共卡片 */
.intention-opt {
  flex: 1;
  min-width: 0;           /* 防止 flex 子项溢出 */
  padding: 16rpx 14rpx 14rpx;
  border-radius: 16rpx;
  border: 2rpx solid #E8E8E8;
  background-color: #F9F9F9;
  margin-right: 14rpx;
}

.intention-opt:last-child {
  margin-right: 0;
}

/* 顶行：emoji 左，radio 右 */
.intention-opt-top-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.intention-opt-icon {
  font-size: 34rpx;
  line-height: 1;
}

/* 名称行（<view> 天然块级） */
.intention-opt-name {
  font-size: 25rpx;
  font-weight: 700;
  color: #CCCCCC;
  margin-bottom: 6rpx;
  line-height: 1.35;
}

/* 描述行（<view> 天然块级） */
.intention-opt-desc {
  font-size: 20rpx;
  color: #CCCCCC;
  line-height: 1.55;
}

/* 单选圆 — inactive */
.radio-off {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid #DDDDDD;
  background-color: #FFF;
  flex-shrink: 0;
}

/* 单选圆 — active 基础：白色内环 + 品牌色填充，外加品牌色外圈 */
.radio-on {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 5rpx solid #FFF;
  flex-shrink: 0;
}

.radio-yangshan {
  background-color: #D4A017;
  box-shadow: 0 0 0 2rpx #D4A017;
}

.radio-yinde {
  background-color: #5A8A5A;
  box-shadow: 0 0 0 2rpx #5A8A5A;
}

/* ── 阳善 激活态 */
.intention-opt-yangshan {
  background-color: #FFFCF0;
  border-color: #D4A017;
  box-shadow: 0 2rpx 10rpx rgba(212, 160, 23, 0.20);
}

.intention-opt-yangshan .intention-opt-name { color: #7A5200; }
.intention-opt-yangshan .intention-opt-desc { color: #A07800; }

/* ── 积阴德 激活态 */
.intention-opt-yinde {
  background-color: #F4FBF4;
  border-color: #5A8A5A;
  box-shadow: 0 2rpx 10rpx rgba(90, 138, 90, 0.18);
}

.intention-opt-yinde .intention-opt-name { color: #2E5A2E; }
.intention-opt-yinde .intention-opt-desc { color: #4A7A4A; }

/* ── 未选中 */
.intention-opt-inactive {
  background-color: #F9F9F9;
  border-color: #E8E8E8;
  opacity: 0.55;
}

/* ============================================================
   🌸🌿 解析预览区：发心标识胶囊 Tag
   ============================================================ */

/* preview-summary：flex-wrap 防止胶囊与金额重叠 */
.preview-summary {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  row-gap: 6rpx;
  column-gap: 10rpx;
}

/* 胶囊：white-space:nowrap 防止"阳善"拆成两行 */
.intention-badge {
  display: flex;
  flex-direction: row;
  align-items: center;
  white-space: nowrap;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.intention-badge text {
  white-space: nowrap;
}

.intention-badge-yangshan {
  background-color: #FFF8DC;
  color: #7A5200;
  border: 1rpx solid #D4A017;
}

.intention-badge-yinde {
  background-color: #E6F4E6;
  color: #2E5A2E;
  border: 1rpx solid #5A8A5A;
}

/* ============================================================
   🌸🌿 生成结果卡片：发心标识胶囊（标题行内嵌）
   ============================================================ */
.result-intention-badge {
  display: inline-flex;
  align-items: center;
  white-space: nowrap;
  font-size: 20rpx;
  padding: 3rpx 12rpx;
  border-radius: 16rpx;
  margin-left: 10rpx;
  font-weight: 500;
  vertical-align: middle;
}

.result-intention-yangshan {
  background-color: #FFF8DC;
  color: #7A5200;
  border: 1rpx solid rgba(212, 160, 23, 0.5);
}

.result-intention-yinde {
  background-color: #E6F4E6;
  color: #2E5A2E;
  border: 1rpx solid rgba(90, 138, 90, 0.4);
}

.text-format-tip {
  font-size: 22rpx;
  color: #868E96;
}

/* 🌟 提示文字与实时累加反馈同一行并排展示，空间不够时允许换行——两者语义相关
   （一个说"怎么写"，一个说"系统读出来是多少"），放在一起比分成两处更容易对照着看 */
.tip-and-sum-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 20rpx;
  margin-top: 10rpx;
}

.realtime-sum-tip {
  font-size: 22rpx;
  color: #D9480E;
  font-weight: bold;
  background: #FFF3BF;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.textarea-wrap {
  position: relative;
  width: 100%;
  display: block;
  text-align: left;
  box-sizing: border-box;
}

/* 🌟 历史名单入口：绝对定位到输入框右下角，弱化灰色小字，不抢主输入区的视觉权重 */
.btn-frequent-donor-link {
  position: absolute;
  right: 16rpx;
  bottom: 12rpx;
  font-size: 22rpx;
  color: #ADB5BD;
  background: rgba(255, 255, 255, 0.9);
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

textarea, .textarea {
  display: block;
  width: 100%;
  min-height: 260rpx;
  border: 2rpx solid #e0e0e0;
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  background-color: #fafafa;
  box-sizing: border-box;
  text-align: left;
  line-height: 1.6;
}

.textarea.small {
  min-height: 160rpx;
}

.textarea.autosize {
  height: auto;
  max-height: none;
}
.parse-preview {
  margin-top: 24rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx;
  border: 1rpx solid #e9ecef;
}

.preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.preview-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.summary-item {
  font-size: 24rpx;
  color: #666;
  background-color: #fff;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  white-space: nowrap;
}

.summary-highlight {
  color: #D9480E;
  font-weight: bold;
}

.preview-list {
  max-height: 300rpx;
  overflow-y: auto;
}

.preview-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e9ecef;
}
.preview-item:last-child {
  border-bottom: none;
}

.item-name {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.item-amount {
  font-size: 26rpx;
  font-weight: bold;
  color: #e53935;
}

.preview-errors {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #dee2e6;
}

.error-item {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.error-icon {
  margin-right: 8rpx;
}

.error-text {
  font-size: 24rpx;
  color: #e53935;
}.expense-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  background: #FDFBF7;
  border-radius: 16rpx;
  border: 1rpx solid #EFE6D8;
  box-sizing: border-box;
}
/* ================= 顶栏快捷操作胶囊行 ================= */
/* ===== 首页快捷操作区 v3：标准 2x2 管理宫格 + 底部极简双粒推广工具栏 ===== */
.manager-quick-actions-v2 {
  margin: 24rpx 0;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 🌟 常用管理入口：标准对称 2x2 宫格，四张卡片对所有管理角色恒定存在（不再有条件缺角）。
   统一白底 / 24rpx 圆角 / 28rpx 内边距 / 微阴影，无粗边框——间距与热区加大，方便单手点按 */
.qa-main-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.qa-grid-cell {
  min-width: 0;
  min-height: 132rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.15s ease;
}

.qa-grid-cell:active {
  transform: scale(0.96);
  background: #FAF8F5;
}

.qa-grid-cell .icon {
  font-size: 32rpx;
}

.qa-grid-emoji {
  font-size: 32rpx;
  line-height: 1;
}

.qa-grid-cell .txt {
  width: 100%;
  min-width: 0;
  font-size: 24rpx;
  font-weight: bold;
  color: #444444;
  text-align: center;
  word-break: break-word;
}

/* 门店管理：仅超管可见的独立入口行，与固定宫格分离，样式风格保持一致 */
.qa-extra-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.15s ease;
}

.qa-extra-row:active {
  transform: scale(0.98);
  background: #FAF8F5;
}

.qa-extra-row .txt {
  flex: 1;
  font-size: 26rpx;
  font-weight: bold;
  color: #444444;
}

.qa-extra-arrow {
  font-size: 24rpx;
  color: #C7C7CC;
}

/* 👁️ 视角切换预览提示条：金色主题呼应个人中心的切换入口，明确告知"这只是展示预览" */
/* 🐛 玻璃拟态：此前不透明 #FFFDF5 实底 + 财务稽核台紧随其后的不透明白底卡片，
   两块颜色区域贴得很近，读起来像"色块硬堆叠"。改为半透明 + backdrop-filter
   模糊底层内容，视觉上退让为一条"浮在页面上的提示"，不再和下方卡片抢层级；
   底部 margin 从 0 加到 20rpx，与下一张卡片之间留出呼吸空间 */
.preview-mode-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  background: rgba(255, 253, 245, 0.72);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border: 1rpx solid rgba(241, 196, 15, 0.45);
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  margin: 16rpx 24rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(181, 124, 30, 0.08);
}

.preview-mode-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  font-weight: 500;
  color: #B57C1E;
}

.preview-mode-link {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: bold;
  color: #B57C1E;
}

/* 📢 门店公告：轻量单行通告条，Header 下方 / 工作台上方，替代原先夹在工具区与表单中间的大卡片 */
/* 🌟 暖色圆角胶囊：浅橙红底 + 30rpx 全圆角，比原来的 16rpx 直角卡片更符合
   "提醒条"的视觉语言。左侧标头与右侧轮播内容严格分区（.announce-bar-tab
   flex-shrink:0 固定宽度，.announce-bar-swiper flex:1 吃满剩余空间），
   长标题一律 ellipsis 省略号截断，不会再把胶囊撑破/文字溢出到容器外 */
.announce-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #fff8f6;
  border: 1rpx solid #ffe3e3;
  border-radius: 30rpx;
  padding: 16rpx 24rpx;
  margin: 16rpx 24rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(245, 158, 11, 0.08);
  max-height: 100rpx;
  opacity: 1;
  overflow: hidden;
  box-sizing: border-box;
  transition: max-height 0.28s ease, opacity 0.22s ease, padding 0.28s ease, margin 0.28s ease;
}

/* 📢 左侧固定"公告"标头：flex-shrink:0 保证无论右侧内容多长都不会被压缩换行。
   图标与文字之间用 margin 而非纯 flex gap 撑开间距，避免 emoji 字形本身的视觉
   留白不均导致紧挨的下一个字符看起来像被裁切（此前 "📢 营业通知" 会被看成
   "📢 业通知"） */
.announce-bar-tab {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.announce-bar-tab-label {
  font-size: 24rpx;
  font-weight: bold;
  color: #8C1D18;
  white-space: nowrap;
}

/* 🌟 点击 X 后优雅收起：先淡出+高度塌陷，动效播完才真正从 wx:if 移出，而不是瞬间消失 */
.announce-bar.announce-bar-closing {
  max-height: 0;
  opacity: 0;
  padding-top: 0;
  padding-bottom: 0;
  margin-top: 0;
  margin-bottom: 0;
}

.announce-bar-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

/* 竖线分割线：把左侧固定标头与右侧轮播内容隔开，同样 flex-shrink:0 防止被压缩消失 */
.announce-bar-divider {
  flex-shrink: 0;
  width: 1.5rpx;
  height: 24rpx;
  background: #ffcdc2;
  margin: 0 4rpx;
}

.announce-bar-viewport {
  flex: 1;
  min-width: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  display: flex;
  align-items: center;
}

/* 🐛 根因修复：此前用双份文本 + translateX(-50%) 做横向跑马灯，长标题永远不会
   被截断，但代价是文字持续移动、容器必须严格 overflow:hidden 才不会视觉溢出——
   一旦父级 flex 布局的 flex-shrink/min-width 没配置到位（如超长标题撑开了
   viewport 的实际宽度），移动中的文字就会露出到胶囊外面，出现"内容被截断
   溢出、排版崩溃"的现象。现在改回静态单行 + ellipsis：容器不再需要跟着文字
   宽度博弈，标题多长都只占固定一行，右侧最多显示到"…"，点击整条仍可在详情
   弹窗里看全文（bindtap="openAnnouncement"），不丢失信息，只是不需要动画就
   能保证排版稳定 */
.announce-bar-text {
  display: block;
  width: 100%;
  font-size: 24rpx;
  font-weight: 500;
  color: #888888;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.announce-bar-swiper {
  flex: 1;
  min-width: 0;
  height: 40rpx;
}

/* 🌟 隐形测量探针：字号/字重与 .announce-bar-text 保持一致（量出来的宽度才
   准），display:inline-block 不设宽度，让它按内容自然撑开；挪到屏幕外
   （position:fixed + 负坐标）不占布局、不可见——🐛 根因修复：此前这条规则整个
   缺失，探针元素直接以默认 flex-item 身份原样出现在 .announce-bar 里，渲染出
   一份完整未截断的标题文字，正是"长标题挤压/撑破右侧 + 按钮"这个布局 Bug 的
   真正成因，不是 .announce-bar-text 的 ellipsis 没生效 */
.announce-bar-marquee-probe {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  display: inline-block;
  white-space: nowrap;
  font-size: 24rpx;
  font-weight: 500;
  pointer-events: none;
}

/* 🌟 跑马灯激活态：覆盖 .announce-bar-text 静态态的 width:100%/ellipsis，改回
   内容自然宽度，让 transform: translateX(±100%) 精确按"文字自身宽度"位移，
   不需要额外算像素距离；父级 .announce-bar-viewport 的 overflow:hidden 负责
   裁掉超出可视区的部分 */
.announce-bar-text-marquee {
  width: auto;
  overflow: visible;
  text-overflow: clip;
  animation: announce-marquee-cycle 14s linear infinite;
  will-change: transform;
}

/* 🎬 首尾双停顿跑马灯时间轴（总周期 14s，与 animation duration 对齐）：
   0%→21.5%    起点：文字开头紧贴"📢 公告"标签、起始对齐（translateX(0)），
               停顿 3s（21.5% × 14s ≈ 3s）供用户看清标题开头
   21.5%→64.5% 停顿结束后向左匀速滚动，直到 translateX(-100%)——这个自身宽度
               的 -100% 是相对文字元素自身宽度的位移，不管文案多长都精确对应
               "整句话完整滚过一遍、尾部刚好抵达可视区左边缘、即将滑出"这一刻，
               不需要按每条通知的实际字数/像素宽度单独计算这个停顿点
   64.5%→86%   尾部停顿 3s（21.5% × 14s ≈ 3s），供用户读完结尾
   86%→93%     停顿结束后继续向左滑出（translateX(-120%)），确保文字哪怕只是
               略长于可视区宽度也能彻底划出，不会残留可见的尾巴
   93.01%→100% 瞬间跳回右侧起点（translateX(100%)）并一直停在屏幕外，直到这
               一轮 animation-iteration 结束——下一轮又从 0% 的 translateX(0)
               重新开始，两次迭代之间是离散的时间重置，不会被插值补间，因此
               看不到任何"回跳"的痕迹 */
@keyframes announce-marquee-cycle {
  0%, 21.5% {
    transform: translateX(0);
  }
  64.5%, 86% {
    transform: translateX(-100%);
  }
  93% {
    transform: translateX(-120%);
  }
  93.01%, 100% {
    transform: translateX(100%);
  }
}

/* 🌟 右侧唯一操作入口：小圆形按钮，暖色底 + 深色描边，比裸文本更有"可点击"的
   质感，也不会再和别的图标挤在一起（此前的 ✏️ 编辑入口已合并进详情弹窗的
   "修改"按钮，右侧只留这一个） */
.announce-bar-add {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fde68a;
  transition: transform 0.15s ease, background 0.15s ease;
}

.announce-bar-add:active {
  background: #fcd34d;
  transform: scale(0.88);
}

.announce-bar-add-icon {
  font-size: 26rpx;
  font-weight: bold;
  line-height: 1;
  color: #92400e;
}

/* 兜底温馨提示：视觉上比真实通知更柔和，避免用户误以为是一条待处理的正式公告 */
.announce-bar-fallback {
  background: #f7f8fa;
  border-color: #e9eaec;
  box-shadow: none;
}

.announce-bar-fallback .announce-bar-text {
  color: #8A8F99;
  font-weight: 400;
}

/* 🍱📌 今日食谱 / 今日大事记 预览卡：未发布=虚线引导卡+去发布；已发布=九宫格摘要+去管理 */
.today-menu-preview-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 🌸 家训弹窗头部：单独加顶部内边距，避免关闭按钮与右上角胶囊（如切店胶囊）重叠——
   只影响这一个弹窗，不改 .modal-header-bar 这个多处弹窗共用的基础类。
   🐛 缩小到 12rpx：原 20rpx 加上 .family-motto-scroll 自身的顶部间距，两层叠加
   导致标题栏和"雨花心字诀"之间空得太多，头重脚轻 */
.family-motto-header {
  padding-top: 12rpx;
}

/* 🌸 标题突出：与 .modal-title-text 的通用灰黑小字区隔开，用品牌深红 + 加大字号 +
   字间距，与下方正文之间建立清晰的视觉层级（标题一眼可辨，不与心字诀/家训正文
   混同）；只在家训头部作用域内覆盖，不影响其他弹窗共用的 .modal-title-text */
.family-motto-header .modal-title-text {
  font-size: 34rpx;
  color: #8C1D18;
  letter-spacing: 4rpx;
}

/* 🐛 内容整体加内边距（而不是只靠 margin），让文字与弹窗左右边框、顶部标题栏都
   留出均匀的呼吸空间；margin 只保留一个较小的顶部值，避免和内边距叠加出过大留白 */
/* 🐛 text-align:center 是 .motto-section-title 改成 inline-block 后能整体居中的
   关键——inline-block 元素自身的 margin:auto 不会生效（这是 CSS 规范行为，不是
   笔误），真正让它水平居中的是这里父容器的 text-align:center；子元素里已经
   显式声明 text-align:left（.culture-list-line 等）的仍按各自声明为准，不受影响。
   底部额外留出 50rpx，滚动到「十、雨花家风」最后一屏时留有呼吸感 */
.family-motto-scroll {
  max-height: 62vh;
  margin: 8rpx 0 16rpx;
  padding: 16rpx 28rpx 50rpx;
  box-sizing: border-box;
  text-align: center;
}

/* 🌸 一至十章节主标题：手机端一律居中展示，深暖红/棕色加粗 + 细下划线；
   display:inline-block 让下划线只贴合文字本身宽度，不再贯穿彈窗左右两侧
   （水平居中依赖父级 .family-motto-scroll 的 text-align:center，见上方注释），
   与无底色的子标题（.culture-sub-title）拉开清晰的章节/子模块层级关系 */
.motto-section-title {
  display: inline-block;
  font-size: 32rpx;
  font-weight: bold;
  color: #8B261C;
  letter-spacing: 2rpx;
  margin: 40rpx 0 20rpx;
  padding: 0 8rpx 12rpx;
  border-bottom: 2rpx solid rgba(139, 38, 28, 0.3);
  text-align: center;
}

.motto-section-title:first-child {
  margin-top: 0;
}

/* 🌸 五/六/八/九大标题：破折号后的【副标题】强制另起一行，避免窄屏下折行错位——
   .motto-section-title 此时改用 <view> 包裹两个 display:block 的 <text> 子行，
   每行独立居中，字号/加粗沿用父级 32rpx Bold，仅额外统一 line-height 与 margin */
.motto-title-line {
  display: block;
  line-height: 1.4;
  text-align: center;
  margin: 0 auto;
}

/* 🌸 心字诀/为学之方正文：加字间距 + 加大行高，配合居中对齐，让四字一顿的
   古风短句有呼吸感，不再挤成密密麻麻的一整块；短句在窄屏下换行也不会显得突兀 */
.motto-section-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  letter-spacing: 3rpx;
  color: #333333;
  text-align: center;
  white-space: pre-wrap;
  margin-bottom: 14rpx;
}

/* 🌸 立志格言：四句分行居中，行高加大到 1.8 + 加粗，比普通正文更有大气庄重感 */
.culture-quote-line {
  line-height: 1.8;
  font-weight: 600;
}

/* 🌸 雨花核心精神：独立成句、加粗展示，与下方三由/五了等条目区隔开 */
.culture-core-spirit-text {
  font-weight: bold;
}

/* 🌸 雨花敬老核心理念：五句逐行单列居中，字号 28rpx / 行高 1.8，段落间距均匀 */
.culture-elder-belief-text {
  font-size: 28rpx;
  line-height: 1.8;
  margin: 0 auto 14rpx;
  text-align: center;
}

/* 🌸 为学之方：单列逐行居中——开篇一句 / 中间六句分句 / 结语一句加粗，
   字号 28rpx、行高 1.8，段落间距均匀一致 */
.culture-study-method-block {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.culture-study-line {
  font-size: 28rpx;
  line-height: 1.8;
  margin: 0 auto 14rpx;
  text-align: center;
}

.culture-study-conclusion {
  font-weight: bold;
}

.motto-creed-line {
  font-size: 26rpx;
  line-height: 1.7;
  letter-spacing: 3rpx;
  color: #333333;
  margin-bottom: 12rpx;
}

/* 🌸 「雨花家训」小标题 + 十八句家训正文独立居中区块：与上方心字诀/下方为学之方
   保持清晰的区块间距，不影响 .family-motto-scroll 的滚动或弹窗高度（只加
   margin/padding）。
   🐛 单靠 text-align: center 未生效——子元素 .motto-section-title/.motto-creed-line
   各自还有自己的 display/width 设定，光靠继承的 text-align 压不过去，这里改用
   flex 列布局 + align-items:center 从容器层面强制居中，再对两个子元素类名加
   !important 兜底，双保险确保样式优先级足够高 */
.motto-creed-block {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center !important;
  margin: 36rpx 0;
  padding: 20rpx 0;
  box-sizing: border-box;
}

.motto-creed-block .motto-creed-line {
  width: 100% !important;
  text-align: center !important;
  display: block !important;
}
/* 📖 雨花文化全集弹窗新增样式：与既有 .motto-section-title/.motto-section-text/
   .motto-creed-line 共用同一套视觉语言，补充三类新增排版需求 */

/* 一、社会主义核心价值观：12 个词汇统一收进 4 列 x 3 行的胶囊网格容器，
   替代此前"每个词单独占一行"的 .culture-value-row 纵向堆叠布局 */
.culture-value-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.culture-value-chip {
  display: block;
  font-size: 24rpx;
  color: #8B261C;
  background: #FFF8F0;
  border-radius: 30rpx;
  padding: 10rpx 6rpx;
  text-align: center;
  box-sizing: border-box;
}

/* 🌸 雨花家道/为学之方等模块内的二级小标题（如【雨花三由】、【雨花家训】）：
   彻底去除粉色卡片底色，改为简洁庄重的纯文字——深暖红加粗 + 前后 "——" 居中
   破折号装饰（装饰符直接写进 WXML 文本内容，小程序原生组件不支持
   ::before/::after），全站所有子标题 100% 统一这一套格式，不再有例外，
   与一至十章节主标题（细下划线）区隔出更轻一级的视觉层次 */
.culture-sub-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #8B261C;
  letter-spacing: 4rpx;
  margin: 24rpx 0 14rpx;
  text-align: center;
}

/* 🌸 三由/五了/六同/八欣：短句对仗型内容的居中 flex-wrap 网格容器，
   让手机窄屏下的短句并排流动展示，避免每句独占一行造成大片左侧留白 */
.culture-pair-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10rpx 20rpx;
  margin-bottom: 8rpx;
}

.culture-pair-grid .culture-list-line {
  flex: 0 1 auto;
  text-align: center;
  margin-bottom: 0;
}

/* 🌸 十个有没有：拆成"只有…/没有…"双列网格，每行左右两列各自居中对齐，
   替代逗号连写在一整行里的拥挤排版；wx:for 用 <block> 每次循环输出左右两个
   cell，按文档流自动落进两列网格 */
.culture-two-col-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx 6rpx;
  margin-bottom: 12rpx;
}

.culture-two-col-cell {
  font-size: 28rpx;
  line-height: 1.7;
  color: #333333;
  text-align: center;
}

/* 🌸 人生十六最：单列纵向列表，左对齐 + 适度缩进，行高/段距进一步加大，
   与其余条目式列表（.culture-list-line 默认样式）区隔出更从容的阅读节奏 */
.culture-list-single-column {
  display: flex;
  flex-direction: column;
  padding-left: 20rpx;
  box-sizing: border-box;
}

.culture-list-single-column .culture-list-line {
  line-height: 1.8;
  margin-bottom: 16rpx;
  text-align: left;
}

/* 🌸 感恩词/雨花五了：单列逐行居中展示，行高加大到 1.8 + 段间距加大，
   与 .culture-list-single-column（人生十六最，左对齐）区分开 */
.culture-list-single-column-center {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.culture-list-single-column-center .culture-list-line {
  text-align: center;
  margin: 0 auto 18rpx;
  line-height: 1.8;
}

/* 🌸 感恩与祈盼·祈盼排比句：三句"祈盼…，让…！"在首个逗号处拆成 6 行单列居中
   展示（左：祈盼…；右：让…依次排列），字号 28rpx，每两行为一组，组间距
   （culture-aspiration-line-group-end）比组内行距更大，避免折行时显得拥挤 */
.culture-list-single-column-center .culture-aspiration-line {
  font-size: 28rpx;
}

.culture-list-single-column-center .culture-aspiration-line-group-end {
  margin-bottom: 32rpx;
}

/* 感恩词/一日修身小结等逐行列表：与 .motto-section-text
   同款字号/行高/字间距，但左对齐、逐行独立展示（不做 .motto-creed-line 那种
   强制居中），更符合这类条目式列表的阅读习惯 */
.culture-list-line {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  letter-spacing: 3rpx;
  color: #333333;
  text-align: left;
  margin-bottom: 12rpx;
}


/* 🪶 空状态改为轻量淡灰卡片：此前的虚线橙边 + 呼吸灯动画在"今日食谱尚未发布"
   这种平常状态下过于突兀，像在报警；改为柔和的浅灰底，安静地提示"还没有内容" */
.today-menu-preview-card.is-empty {
  background: #FAFBFC;
  border: 1rpx solid #EDEFF2;
  box-shadow: none;
}

/* ❤️ 家人（服务对象）「透明监督版」首页三模块：不填报表、不需要计算工具，
   专注阳光账本大盘 / 今日菜谱 / 雨花大事记与护持剪影三件事 */
.family-home-container {
  padding: 0 24rpx;
  box-sizing: border-box;
}

/* 模块一：阳光账本核心大盘——金/暖色质感背景，突出"公开透明·全民监督" */
.family-sunshine-hero-card {
  background: linear-gradient(155deg, #FFF3D6 0%, #FDE7B8 55%, #F8D992 100%);
  border: 1rpx solid #E6C179;
  border-radius: 28rpx;
  padding: 32rpx 28rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(230, 162, 60, 0.2);
  box-sizing: border-box;
}

.fsh-badge {
  display: inline-block;
  font-size: 22rpx;
  font-weight: bold;
  color: #8B5A00;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
  margin-bottom: 16rpx;
}

.fsh-store-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #6B3E00;
}

.fsh-period {
  display: block;
  font-size: 22rpx;
  color: #8B6A2E;
  margin-top: 4rpx;
  margin-bottom: 20rpx;
}

.fsh-hero-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 20rpx;
  padding: 20rpx 8rpx;
  margin-bottom: 20rpx;
}

.fsh-hero-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fsh-hero-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #8B5A00;
}

.fsh-hero-label {
  font-size: 20rpx;
  color: #8B6A2E;
  margin-top: 6rpx;
  text-align: center;
}

.fsh-hero-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(139, 90, 0, 0.2);
}

.fsh-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fsh-footer-text {
  font-size: 20rpx;
  color: #8B6A2E;
}

.fsh-footer-link {
  font-size: 22rpx;
  font-weight: bold;
  color: #6B3E00;
  flex-shrink: 0;
}

/* 模块二：今日菜谱展示——大字号、高对比度，专注让家人一眼看清今天吃什么 */
.family-menu-card,
.family-activity-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.fm-header,
.fa-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.fm-title,
.fa-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #222222;
}

.fm-date {
  font-size: 24rpx;
  color: #999999;
}

.fm-9grid,
.fa-9grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.fm-grid-item,
.fa-grid-item {
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 12rpx;
  overflow: hidden;
  background: #F5F5F5;
}

.fm-grid-img,
.fa-grid-img {
  width: 100%;
  height: 100%;
}

.fm-text {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.8;
  color: #222222;
}

.fa-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  color: #333333;
}

.fm-empty,
.fa-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}

.fm-empty-icon,
.fa-empty-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.fm-empty-text,
.fa-empty-text {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
}

.tmp-main {
  flex: 1;
  min-width: 0;
}

.tmp-header {
  margin-bottom: 10rpx;
}

.tmp-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tmp-9grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  max-width: 300rpx;
  margin-bottom: 10rpx;
}

.tmp-grid-item {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  border-radius: 8rpx;
  overflow: hidden;
  background: #F0F0F0;
}

.tmp-grid-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.tmp-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.tmp-empty-text {
  display: inline-block;
  max-width: 100%;
  font-size: 24rpx;
  color: #999999;
  background: #F1F3F5;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tmp-side-action {
  flex-shrink: 0;
}

/* 🌟 轻量级 Outline 胶囊按钮，避免在首页抢走核心工作台宫格的视觉重心 */
.tmp-side-btn {
  display: block;
  font-size: 24rpx;
  font-weight: bold;
  color: #8C1D18;
  background: #FFF5F0;
  border: 1.5rpx solid #E8C4B8;
  border-radius: 24rpx;
  padding: 10rpx 20rpx;
  white-space: nowrap;
}

.tmp-side-link {
  display: block;
  font-size: 24rpx;
  font-weight: bold;
  color: #8C1D18;
  white-space: nowrap;
}.draft-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.draft-left .icon {
  font-size: 26rpx;
}

.draft-left .txt {
  font-size: 22rpx;
  color: #2E7D32;
  font-weight: 500;
}

.draft-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
}
/* ================= 底部悬浮核心功能按钮 ================= */
.bottom-action-floating-bar {
  position: fixed;
  /* 悬浮于底部三段式导航栏（100rpx + 安全区）之上，避免相互遮挡 */
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  /* 纯白不透明背景 + 更轻的阴影，与上方表单滚动区形成明确的物理分层，
     不透明是必须的——半透明底色滚动时会看到文字从下面透上来，观感很脏 */
  background: #FFFFFF;
  padding: 24rpx 32rpx;
  display: flex;
  gap: 20rpx;
  border-top: 1rpx solid #E9ECEF;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 90;
}

/* 🐛 加固：display:flex 居中此前已生效，这里补上 box-sizing/padding/margin/
   line-height 显式归零——消除微信原生 <button> 默认内边距与行高对 emoji 图标 +
   文字组合可能造成的视觉干扰，不再依赖任何隐式默认值 */
.btn-main-action {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 1;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.15s ease;
  border: none;
}

/* 🌟 明确的按压变暗反馈：小程序原生已经用 hover-class="btn-hover" 做了一版（见下方 .btn-hover），
   这里再补一条标准 :active 规则兜底——个别机型/webview 对 hover-class 的触发时机不够跟手，
   :active 是更底层、响应更即时的浏览器原生伪类，两者叠加确保按下的一瞬间用户一定能看到反馈 */
.btn-main-action:active {
  opacity: 0.8;
  transform: scale(0.97);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.btn-emoji-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
  line-height: 1;
  /* emoji 字符自带色彩，不受按钮 color 影响，天然清晰可辨，
     用它代替之前 stroke 写死为白色、在白底/浅色底上完全隐形的 SVG 图标；
     line-height:1 避免 emoji 字形自身的行高与按钮文字基线产生视觉错位 */
}

/* 🌟 左右两个按钮做主次区分：生成餐报文本是流程首步、可反复重新生成校对，用白底红描边，
   视觉上更"轻"；生成公示海报是最终对外公示的产出物，用正红色实底强调，作为这组操作的主 CTA */
.text-gen-btn {
  background: #FFFFFF;
  color: #C62828;
  border: 2rpx solid #C62828;
  box-shadow: none;
}

.text-gen-btn:active {
  background: #FFF0ED;
}

/* 🐛 该按钮初始 disabled（showResult 默认 false，需先生成餐报文本才可点），微信原生
   button[disabled] 自带 color 覆盖 + opacity 遮罩，之前的金/橙渐变系配色在遮罩下始终糊成一片。
   彻底放弃黄橙色系，改用与左侧描边按钮同色系的正红渐变 + 纯白粗体字，四个选择器
   （基础态/element+class/两种 disabled 态）全部加 !important 兜底覆盖原生样式。
   若改动后画面仍无变化，大概率是 WeChat DevTools 未重新编译，而非本文件的样式没生效——
   需要手动点击"编译"或清除数据缓存后重试。 */
.poster-gen-btn,
button.poster-gen-btn,
.poster-gen-btn[disabled],
button.poster-gen-btn[disabled] {
  background: linear-gradient(135deg, #C62828 0%, #B71C1C 100%) !important;
  color: #FFFFFF !important;
  font-weight: bold !important;
  font-size: 28rpx !important;
  opacity: 1 !important;
  border: none !important;
  box-shadow: 0 4rpx 12rpx rgba(198, 40, 40, 0.3) !important;
}

.poster-gen-btn:active {
  opacity: 0.8 !important;
  box-shadow: 0 2rpx 6rpx rgba(198, 40, 40, 0.2) !important;
}

/* ================= 🔑 生成邀请码弹窗 =================
   🎨 UI/UX 重构：卡片内边距从 32rpx/24rpx 提升到 40rpx/32rpx，标题字号与
   操作按钮对比度同步加强，弹窗层级统一收敛到 2100——与站内其余全屏弹窗
   （announcement/finance/compliance 等，z-index 1000~2000 不等）相比更高，
   保证这两个弹窗打开时不会被任何其它页面浮层意外压住关键操作区 */
.gencode-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2100;
}

.gencode-modal-card {
  width: 85%;
  max-width: 620rpx;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.28);
  overflow-y: auto;
}

.gencode-header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.gencode-title-text {
  font-size: 34rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.gencode-close-btn {
  width: 56rpx;
  height: 56rpx;
  background: #F1F3F5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #6B7280;
  transition: background-color 0.15s ease, transform 0.15s ease;
}

.gencode-close-btn:active {
  background: #E3E6E9;
  transform: scale(0.92);
}

/* 🌟 选择常客弹窗：视觉上与邀请码弹窗同一套底色/圆角/关闭按钮规范，保持整站弹窗风格统一 */
.frequent-donor-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.frequent-donor-modal-card {
  width: 85%;
  max-width: 620rpx;
  max-height: 70vh;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
}

.frequent-donor-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.frequent-donor-header .title {
  font-size: 32rpx;
  font-weight: bold;
  color: #222222;
}

.frequent-donor-header .close-btn {
  width: 56rpx;
  height: 56rpx;
  background: #F1F3F5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #6B7280;
}

.frequent-donor-empty {
  padding: 40rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #ADB5BD;
  line-height: 1.6;
}

.frequent-donor-list {
  max-height: 50vh;
}

.frequent-donor-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid #F1F3F5;
}

.frequent-donor-item:active {
  background: #FFF8E1;
}

.frequent-donor-item .donor-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.frequent-donor-item .donor-count {
  font-size: 22rpx;
  color: #ADB5BD;
}

.expense-template-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.expense-template-modal-card {
  width: 85%;
  max-width: 620rpx;
  max-height: 75vh;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
}

.expense-template-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.expense-template-header .title {
  font-size: 32rpx;
  font-weight: bold;
  color: #222222;
}

.expense-template-header .close-btn {
  width: 56rpx;
  height: 56rpx;
  background: #F1F3F5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #6B7280;
}

.expense-template-segmented {
  margin-bottom: 16rpx;
}

.expense-template-manage-row {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 12rpx;
}

.manage-toggle {
  font-size: 24rpx;
  color: #FF922B;
  font-weight: bold;
  padding: 8rpx 16rpx;
}

.expense-template-add-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.expense-template-empty {
  padding: 40rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #ADB5BD;
  line-height: 1.6;
}

.expense-template-chip-list {
  max-height: 50vh;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.expense-template-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #FFF9DB;
  border: 1rpx solid #FFE066;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  min-height: 44px; /* 触控热区 ≥44pt，与拒绝/同意等操作按钮口径一致 */
  box-sizing: border-box;
}

.expense-template-chip:active {
  background: #FFE066;
  transform: scale(0.97);
}

.expense-template-chip .chip-name {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.expense-template-chip .chip-amount {
  font-size: 22rpx;
  color: #D9480E;
}

.expense-template-chip .chip-del {
  font-size: 22rpx;
  color: #ADB5BD;
  padding: 0 6rpx;
  margin-left: 4rpx;
}

.gencode-body {
  padding: 0 8rpx;
}
.form-item-row {
  margin-bottom: 36rpx;
}

.form-label {
  font-size: 24rpx;
  color: #666666;
  font-weight: bold;
  display: block;
  margin-bottom: 14rpx;
}

.form-picker-selector {
  background: #FAF8F5;
  border: 1.5rpx solid #EFE6D8;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 26rpx;
  color: #333333;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: background-color 0.15s ease;
}

.form-picker-selector:active {
  background: #F1EBE0;
}

/* 🔒 非超管（店长/大家长）锁定授权门店：与可点击态形成明确的视觉区隔——
   灰底 + 虚线边框传达"这里不可交互"，配合右侧 picker-locked-tag 文案说明原因 */
.form-picker-locked {
  background: #F5F5F5;
  border-style: dashed;
  border-color: #DEE2E6;
  color: #6B7280;
}

.picker-locked-tag {
  font-size: 20rpx;
  color: #ADB5BD;
  background: #ECECEC;
  border-radius: 10rpx;
  padding: 4rpx 12rpx;
  flex-shrink: 0;
}

/* ⚠️ 本机构暂无门店引导：黄色警示底色，与"缺权限/需前置操作"类提示统一色系 */
.gencode-no-store-tip {
  background: #FFF8E1;
  border: 1.5rpx dashed #FFD54F;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  color: #8C5A00;
  line-height: 1.6;
}

/* 🌟 自定义门店输入框的"向下展开"动画：常驻 DOM，用 max-height + opacity 过渡
   模拟折叠面板效果——wx:if 切换没有中间态、没法做动画，这是小程序里做展开动画的标准写法 */
.custom-store-input-wrap {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  margin-top: 0;
  transition: max-height 0.25s ease, opacity 0.2s ease, margin-top 0.25s ease;
}

.custom-store-input-wrap.expanded {
  /* 🌟 原本只需容纳输入框本身（72rpx），现在暂无门店时会多展示一行引导文案，
     预算调宽到 160rpx 保证不被 overflow:hidden 裁掉 */
  max-height: 160rpx;
  opacity: 1;
  margin-top: 12rpx;
}

.gencode-custom-hint {
  display: block;
  font-size: 22rpx;
  color: #8C1D18;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.gencode-custom-input {
  width: 100%;
  height: 72rpx;
  background: #F8F9FA;
  border: 1rpx solid #DEE2E6;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 🌟 身份选择卡片：类名改为 gencode- 前缀限定作用域，与"申请加入门店"弹窗里同名的
   .role-radio-group/.role-radio-item（原生 radio-group + label 那一套简单单选样式）
   彻底解耦——此前两处共用同一套类名，后声明的规则会覆盖前面的部分属性，
   全靠层叠顺序侥幸不冲突，稍改一处就可能悄悄影响另一个完全不相关的弹窗。 */
.gencode-role-group {
  display: flex;
  gap: 20rpx;
}

.gencode-role-item {
  position: relative;
  flex: 1;
  text-align: center;
  background: #F8F9FA;
  border: 2rpx solid #DEE2E6;
  border-radius: 18rpx;
  padding: 18rpx 0;
  font-size: 24rpx;
  color: #495057;
  transition: all 0.2s ease;
}

.gencode-role-item:active {
  transform: scale(0.96);
}

/* 未选中态进一步弱化：边框变浅灰虚线、文字降低对比度，与选中态形成更强烈的视觉落差 */
.gencode-role-item.inactive {
  border-style: dashed;
  border-color: #E9ECEF;
  color: #ADB5BD;
}

.gencode-role-item.active {
  background: #FFF3E0;
  border-color: #B8860B;
  border-width: 3rpx;
  color: #8C5A00;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(184, 134, 11, 0.2);
}

/* 🔒 权限阶梯里禁选的身份（如店长视角下的大家长/门店店长）：进一步压低透明度、
   取消点击态形变，与"仅是未选中"的 inactive 明确区分——这里是真的点不动 */
.gencode-role-disabled {
  opacity: 0.45;
  pointer-events: none;
}

.gencode-role-item .role-check-badge {
  position: absolute;
  top: -14rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  border-radius: 50%;
  background: #B8860B;
  color: #fff;
  font-size: 22rpx;
  font-weight: bold;
  box-shadow: 0 2rpx 6rpx rgba(184, 134, 11, 0.4);
}

/* 👑 大家长/超管授权说明：正向语气，绿系底色区别于下面的限制提示 */
.gencode-role-empower-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #137333;
  background: #E6F4EA;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  line-height: 1.6;
}

/* 🔒 店长权限受限说明：与 gencode-no-store-tip 同一套警示色系，保持弹窗内
   提示信息的视觉语言统一 */
.gencode-role-restrict-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8C5A00;
  background: #FFF8E1;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  line-height: 1.6;
}

.gen-result-box {
  margin-top: 30rpx;
  background: #FFF3E0;
  border: 1.5rpx dashed #FFB74D;
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
}

.result-label {
  font-size: 20rpx;
  color: #E65100;
  display: block;
}

.result-code {
  font-size: 54rpx;
  font-weight: bold;
  color: #E65100;
  display: block;
  letter-spacing: 6rpx;
  margin: 12rpx 0;
  font-family: monospace;
}

.result-tip {
  font-size: 18rpx;
  color: #F57C00;
  display: block;
}

.gen-code-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.btn-cancel {
  flex: 1;
  background: #F1F3F5;
  color: #495057;
  border-radius: 44rpx;
  font-size: 27rpx;
  font-weight: bold;
  border: none;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.15s ease, transform 0.15s ease;
}

.btn-cancel::after {
  border: none;
}

.btn-cancel:active {
  background: #E3E6E9;
  transform: scale(0.98);
}

.btn-primary-gen {
  flex: 1.5;
  background: linear-gradient(135deg, #8C1D18 0%, #B22222 100%);
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 27rpx;
  font-weight: bold;
  border: none;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(178, 34, 34, 0.35);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.btn-primary-gen::after {
  border: none;
}

.btn-primary-gen:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 10rpx rgba(178, 34, 34, 0.3);
}

/* ================= 🔑 邀请码生成结果弹窗 =================
   🐛 根因修复：这一族 .invite-result-* class 此前在整个 wxss 里完全没有任何
   样式定义（生成成功后弹窗只是作为普通文档流内容渲染，没有全屏遮罩/居中卡片/
   层级），现在补齐——视觉上与上面的 .gencode-modal-* 同一套卡片骨架，突出结果
   区（邀请码）沿用站内既有的琥珀色"结果揭示"配色语言（同 .gen-result-box），
   z-index 与生成弹窗保持同一档 2100（两者互斥展示，不存在同时争层级的场景） */
