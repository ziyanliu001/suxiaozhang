  max-height: 85vh;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.28);
  overflow-y: auto;
}

.invite-result-summary {
  font-size: 26rpx;
  color: #6B5B45;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.invite-result-code-box {
