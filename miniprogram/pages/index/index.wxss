/* ═══════════════════════════════════════════════════════════════
   ✍️ 编辑通报内容弹窗：卡片式布局，严格左对齐，浅灰底输入框
   ═══════════════════════════════════════════════════════════════ */

.notice-edit-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1001;
  display: flex;
  align-items: flex-end;
}

.notice-edit-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
}

.notice-edit-content {
  position: relative;
  width: 100%;
  max-height: 85vh;
  background-color: #F7F8FA;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.notice-edit-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #FFF7F0 0%, #FFEBE0 100%);
  border-bottom: 2rpx solid #FFD4B8;
}

.notice-edit-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #323233;
}

.notice-edit-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.notice-edit-close .close-icon {
  font-size: 48rpx;
  color: #969799;
  line-height: 1;
}

.notice-edit-body {
  flex: 1;
  padding: 24rpx 24rpx 12rpx;
  overflow-y: auto;
}

/* 卡片式分区：摒弃硬边框网格，用白底圆角+柔和阴影代替边框分隔，
   内边距统一加大提升呼吸感 */
.notice-edit-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
  text-align: left;
}

.notice-edit-label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #323233;
  text-align: left;
}

.notice-edit-label-sub {
  display: block;
  font-size: 22rpx;
  color: #ADB5BD;
  text-align: left;
  margin-top: 4rpx;
  margin-bottom: 18rpx;
}

.notice-edit-input {
  width: 100%;
  height: 88rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  background-color: #F7F8FA;
  border-radius: 16rpx;
  border: none;
  box-sizing: border-box;
  margin-top: 16rpx;
  text-align: left;
}

/* 正文输入区：外层浅灰圆角容器内边距 20rpx，底部工具行放清空按钮 +
   字数统计，两者都不再绝对定位盖在文字上（原实现用 absolute 贴在
   右下角，长文本时会跟最后一行文字重叠） */
.textarea-box-container {
  width: 100%;
  box-sizing: border-box;
  background: #F7F8FA;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}

.notice-edit-textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #323233;
  background-color: transparent;
}

.textarea-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #EDEFF2;
}

.textarea-toolbar-spacer {
  flex: 1;
}

/* 清空按钮：红色高亮提示误操作风险，紧贴正文框内底部而非悬浮在标题行 */
.clear-btn-inline {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 18rpx;
  background-color: #FFF5F5;
  border-radius: 24rpx;
}

.clear-btn-inline text {
  font-size: 24rpx;
  color: #E03131;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
}

.char-count-tag {
  font-size: 22rpx;
  color: #ADB5BD;
  flex-shrink: 0;
}

/* 常用场景一键套用：3 列网格，标签式圆角小卡片 */
.preset-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.preset-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 16rpx 8rpx;
  font-size: 24rpx;
  color: #D9480E;
  background-color: #FFF9DB;
  border-radius: 16rpx;
  transition: transform 0.15s;
}

.preset-tag text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preset-tag.warning {
  color: #E03131;
  background-color: #FFF5F5;
}

.preset-tag:active {
  transform: scale(0.95);
}

/* 我的模板库：条数不固定、标题长短不一，改用横向滚动标签栏 */
.preset-scroll-row {
  width: 100%;
  white-space: nowrap;
}

.preset-scroll-row .preset-tag {
  display: inline-flex;
  width: auto;
  margin-right: 12rpx;
}

/* 🌟 云端模板标签：与内置 7 条预设文案的 .preset-tag 同款外观，
   多一个左侧【公共】/【本店】小徽章区分模板来源 */
.preset-tag.template-tag {
  color: #2B8A3E;
  background-color: #EBFBEE;
  padding-left: 20rpx;
  padding-right: 20rpx;
}

.template-badge {
  flex-shrink: 0;
  font-size: 18rpx;
  font-weight: bold;
  padding: 2rpx 10rpx;
  border-radius: 16rpx;
  line-height: 1.6;
}

.template-badge.badge-system {
  color: #FFFFFF;
  background-color: #F08C00;
}

.template-badge.badge-store {
  color: #FFFFFF;
  background-color: #2B8A3E;
}

/* 合并选项条：卡片内的开关行，用于超管专属的"设为全域公共模板" */
.merge-option-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.merge-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding-right: 20rpx;
}

.merge-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #D9480E;
}

.merge-desc {
  font-size: 21rpx;
  color: #868E96;
  margin-top: 4rpx;
}

/* 🆕 底部固定操作卡片：合并到每日汇报开关 + 存为模板/立即发布按钮，
   整合进同一张带阴影、贴底固定的白色卡片，不随内容区滚动 */
.notice-edit-footer {
  background-color: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.08);
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.footer-merge-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFF9DB;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.footer-merge-row .merge-title {
  font-size: 26rpx;
}

.footer-btn-row {
  display: flex;
  gap: 16rpx;
}

.notice-edit-btn {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 按钮层级：存为模板是浅灰次要操作，立即发布是主色蓝主操作，
   两者视觉权重明确区分开 */
.notice-edit-btn.template-btn {
  flex: 0.85;
  background-color: #F1F3F5;
  color: #495057;
  font-size: 28rpx;
}

.notice-edit-btn.save-btn {
  background: linear-gradient(135deg, #339AF0 0%, #1C7ED6 100%);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(28, 126, 214, 0.3);
}
.form-main-card .section {
