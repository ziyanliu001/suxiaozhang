/* 🌟 C位核心卡片：欢迎语+护持统计+打卡 CTA，置于胶囊下方最顶部，独立于滚动区之外，
   确保永远是志工视角下第一眼看到的内容，不被公告栏/食谱大事记预览卡挤到后面 */
/* 🐛 根因修复：本类与 .ui-card-wrapper 复合使用（class="ui-card-wrapper
   volunteer-hero-card"），继承了后者的 width:100%，却又在这里另外声明了
   左右 24rpx margin——margin 不受 box-sizing:border-box 影响，会直接叠加在
   100% 宽度之外，导致卡片整体右侧溢出 48rpx，表现为右边距比左边距小、
   内容整体偏右。显式声明 width: calc(100% - 48rpx) 抵消掉这部分 margin，
   使卡片实际占用宽度精确等于 100%，左右留白严格对称 */
.volunteer-hero-card {
  width: calc(100% - 48rpx);
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  margin: 24rpx 24rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.volunteer-view-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  margin: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.volunteer-hero-card .v-header {
  text-align: center;
  margin-bottom: 20rpx;
}

.volunteer-hero-card .v-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #7A1B15;
  letter-spacing: 0.5rpx;
  margin-bottom: 10rpx;
}

.volunteer-hero-card .v-sub {
  font-size: 25rpx;
  color: #A08768;
  font-weight: 400;
}

.volunteer-hero-card .volunteer-stats-banner {
  background: linear-gradient(135deg, #FFFDF8 0%, #FFF5EB 100%);
  border: 1rpx solid #FFE0B2;
  border-radius: 16rpx;
  padding: 16rpx 16rpx 0;
  margin: 16rpx 0 20rpx 0;
  transition: opacity 0.15s ease;
}

/* 🛡️ 明确的触控反馈：整卡可点击，按下时轻微变暗，与其余胶囊按钮的 :active 手感保持一致 */
.volunteer-hero-card .volunteer-stats-banner-hover {
  opacity: 0.75;
}

.volunteer-hero-card .volunteer-stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.volunteer-hero-card .stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 🌟 核心荣誉数字：48rpx -> 56rpx 进一步加粗放大，提升志工的归属感与荣誉感 */
.volunteer-hero-card .stat-num {
  font-size: 56rpx;
  font-weight: 800;
  color: #E65100;
  line-height: 1.15;
  letter-spacing: 0.5rpx;
}

.volunteer-hero-card .stat-label {
  display: block;
  font-size: 20rpx;
  color: #A98A6E;
  font-weight: 500;
  margin-top: 8rpx;
  letter-spacing: 0.5rpx;
}

.volunteer-hero-card .stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #FFE0B2;
}

/* 🌸 温情激励语：置于统计数字下方，强化"我在被看见、被感恩"的情感连接。
   改为柔和底色的独立轻量徽章（inline-block 让背景色只贴合文字本身，不再
   撑满整行），行容器用 flex 居中定位这个徽章 */
.volunteer-hero-card .warm-encourage-badge-row {
  display: flex;
  justify-content: center;
  margin-top: 14rpx;
}

.volunteer-hero-card .warm-encourage-text {
  display: inline-block;
  font-size: 21rpx;
  font-weight: 500;
  color: #C97B3D;
  background: rgba(201, 123, 61, 0.1);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  line-height: 1.4;
}
/* 🍚 今日餐况状态卡：开餐状态 + 主食物资合并展示，用胶囊 Tag 呈现代替纯文字 */
.volunteer-view-card .today-status-card {
  background: #FFFDF8;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 20rpx;
}

.volunteer-view-card .tsc-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.volunteer-view-card .tsc-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #444444;
}

.volunteer-view-card .tsc-date {
  font-size: 22rpx;
  color: #999999;
}

.volunteer-view-card .tsc-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F2E9D8;
}

.volunteer-view-card .tsc-row:last-child {
  border-bottom: none;
}

.volunteer-view-card .tsc-label {
  font-size: 26rpx;
  color: #666666;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.volunteer-view-card .tsc-tag {
  font-size: 22rpx;
  font-weight: bold;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

/* 🌟 与 .status-pill（店长/财务设置物资状态用的选择胶囊）统一同一套色值，
   同一个"充足/一般/告急"概念在两处（管理端选择器 / 志工端展示标签）视觉一致 */
.volunteer-view-card .tsc-tag.tag-success {
  background: #E6F4EA;
  color: #137333;
}

.volunteer-view-card .tsc-tag.tag-warning {
  background: #FEF7E0;
  color: #B06000;
}

.volunteer-view-card .tsc-tag.tag-danger {
  background: #FFF2F0;
  color: #FF4D4F;
  border: 1rpx solid #FFA39E;
}

/* 🌟 物资护持交互联动：大米/食用油两行从纯展示升级为可点击，箭头给出明确的"可点击"提示，
   点击态轻微变色反馈，不需要额外的按钮就能表达"这里能点" */
.volunteer-view-card .tsc-row-tappable {
  transition: background-color 0.15s ease;
}

.volunteer-view-card .tsc-row-tappable:active {
  background-color: #FFF8ED;
}

.volunteer-view-card .tsc-tag-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* 🌟 智能物资引导跳转入口：小胶囊按钮，非满仓状态下才出现，
   与旁边的状态标签保持同一行但视觉上更主动、更像"可以点的行动号召" */
.volunteer-view-card .action-link {
  font-size: 20rpx;
  font-weight: bold;
  color: #8C1D18;
  background: #FFF3E0;
  border: 1rpx solid #FFCC80;
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
  white-space: nowrap;
}

.volunteer-view-card .action-link:active {
  opacity: 0.75;
}

.volunteer-view-card .tsc-row-arrow {
  font-size: 22rpx;
  color: #C7C7CC;
}

/* 🍱📌 食谱/大事记精简摘要行：单行文字，未发布时直接显示"尚未发布"，
   取代此前独立的大预览卡片，避免空卡片强行占用纵向空间 */
.volunteer-view-card .tsc-summary-row {
  padding: 12rpx 0 0;
  margin-top: 8rpx;
  border-top: 1rpx dashed #F2E9D8;
}

.volunteer-view-card .tsc-summary-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

/* 🌟 今日食谱动态卡片：能拆出结构化菜品名时，用小标签云替代纯文本单行，
   一眼能看清今天做了哪些菜，比一整行可能被截断的长文本更直观 */
.volunteer-view-card .tsc-menu-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.volunteer-view-card .tsc-menu-label {
  overflow: visible;
  white-space: normal;
}

.volunteer-view-card .tsc-dish-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.volunteer-view-card .tsc-dish-chip {
  font-size: 22rpx;
  color: #8C1D18;
  background: #FFF3E0;
  border: 1rpx solid #FFE0B2;
  border-radius: 16rpx;
  padding: 6rpx 16rpx;
}

.volunteer-hero-card .v-action-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  /* 任务C：高亮动画的过渡基础 */
  transition: box-shadow 0.3s ease, background-color 0.3s ease, transform 0.3s ease;
  border-radius: 24rpx;
  /* 🛡️ 打卡卡片精简后只剩主按钮一个子元素，加大上下内边距让按钮在卡片内
     更居中、大方醒目，不再贴着服务历程/公开账本链接的位置显得局促 */
  padding: 28rpx 4rpx;
}

/* ===== 任务C：highlight-pulse 金色/红色呼吸闪烁动画（持续2秒） ===== */
.volunteer-hero-card .v-action-box.highlight-pulse {
  animation: highlightPulse 2s ease-in-out 1;
  /* 兜底光晕（动画失败时也能看出高亮） */
  box-shadow: 0 0 24rpx 8rpx rgba(245, 166, 35, 0.6);
  background-color: rgba(245, 166, 35, 0.08);
}

@keyframes highlightPulse {
  0% {
    box-shadow: 0 0 0 0 rgba(245, 166, 35, 0);
    background-color: transparent;
    transform: scale(1);
  }
  15% {
    /* 第一次金色脉冲 */
    box-shadow: 0 0 32rpx 12rpx rgba(245, 166, 35, 0.85);
    background-color: rgba(245, 166, 35, 0.15);
    transform: scale(1.02);
  }
  30% {
    box-shadow: 0 0 16rpx 6rpx rgba(245, 166, 35, 0.3);
    background-color: rgba(245, 166, 35, 0.04);
    transform: scale(1);
  }
  50% {
    /* 第二次红色脉冲（呼应雨花斋品牌色 #8C1D18） */
    box-shadow: 0 0 32rpx 12rpx rgba(140, 29, 24, 0.7);
    background-color: rgba(140, 29, 24, 0.1);
    transform: scale(1.02);
  }
  70% {
    box-shadow: 0 0 16rpx 6rpx rgba(140, 29, 24, 0.25);
    background-color: rgba(140, 29, 24, 0.03);
    transform: scale(1);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(245, 166, 35, 0);
    background-color: transparent;
    transform: scale(1);
  }
}
/* 🌟 第一核心操作 CTA：渐变底色 + 加深阴影，未打卡状态额外用金色描边提醒，
   按下时轻微缩放（active 态）给出明确的触控反馈 */
.volunteer-hero-card .btn-volunteer-checkin {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #A8281F 0%, #7A1B15 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 48rpx;
  padding: 0;
  margin: 0;
  border: none;
  box-shadow: 0 10rpx 24rpx rgba(122, 27, 21, 0.32);
  transition: box-shadow 0.2s ease, transform 0.15s ease, background 0.2s ease;
}

.volunteer-hero-card .btn-volunteer-checkin::after {
  border: none;
}

.volunteer-hero-card .btn-volunteer-checkin:active {
  background: linear-gradient(135deg, #8C231C 0%, #5F140F 100%);
  box-shadow: 0 4rpx 12rpx rgba(122, 27, 21, 0.3);
  transform: scale(0.97);
}

/* 未打卡：金色描边 + 更强阴影，作为页面最醒目的行动点 */
.volunteer-hero-card .btn-volunteer-checkin.state-pending {
  border: 2rpx solid #F5A623;
  box-shadow: 0 8rpx 24rpx rgba(245, 166, 35, 0.4);
}

/* 已打卡部分班次：正常品牌色渐变，鼓励继续 */
.volunteer-hero-card .btn-volunteer-checkin.state-partial {
  background: linear-gradient(135deg, #B8342A 0%, #8C231C 100%);
}

/* 今日全部班次已完成：切换为沉稳的成功绿，弱化 CTA 紧迫感 */
.volunteer-hero-card .btn-volunteer-checkin.state-done {
  background: linear-gradient(135deg, #2E7D32 0%, #1B5E20 100%);
  box-shadow: 0 8rpx 20rpx rgba(46, 125, 50, 0.28);
}

.volunteer-hero-card .btn-volunteer-checkin.state-done:active {
  background: #1B5E20;
}
/* ================= 🙋 全角色到岗打卡卡片（店长/财务视角） =================
   与 .volunteer-hero-card 的按钮视觉语言保持一致，但这里的样式全部自成一套、
   不依赖 .volunteer-hero-card 作为祖先选择器——原按钮样式都写成
   .volunteer-hero-card .btn-volunteer-checkin 这种强绑定祖先的形式，直接把
   btn-volunteer-checkin 类名搬到这张新卡片里是不会生效的，所以在这里整套复刻。 */
/* 🐛 根因修复：与 .volunteer-hero-card 同一处问题——复合 .ui-card-wrapper
   继承 width:100% 后又另加左右 24rpx margin，margin 叠加在 100% 之外导致
   右侧溢出，见该处详细注释 */
.omni-checkin-card {
  width: calc(100% - 48rpx);
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 28rpx 24rpx;
  margin: 24rpx 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #F1E6D8;
}

/* 🌟 左右分区主行：左侧状态文案吃满剩余空间（必要时自行换行/省略），
   右侧按钮按内容自适应宽度、绝不收缩——保证打卡文案再长也能完整显示 */
.omni-checkin-main-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.omni-checkin-header {
  flex: 1;
  min-width: 0;
}

.omni-checkin-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #8C1D18;
  margin-bottom: 6rpx;
}

.omni-checkin-sub {
  display: block;
  font-size: 24rpx;
  color: #868E96;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.omni-checkin-btn {
  flex-shrink: 0;
  width: auto;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 32rpx;
  white-space: nowrap;
  background: linear-gradient(135deg, #A8281F 0%, #7A1B15 100%);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 38rpx;
  margin: 0;
  border: none;
  box-shadow: 0 10rpx 24rpx rgba(122, 27, 21, 0.32);
  transition: box-shadow 0.2s ease, transform 0.15s ease, background 0.2s ease;
}

.omni-checkin-btn::after {
  border: none;
}

.omni-checkin-btn:active {
  background: linear-gradient(135deg, #8C231C 0%, #5F140F 100%);
  box-shadow: 0 4rpx 12rpx rgba(122, 27, 21, 0.3);
  transform: scale(0.97);
}

.omni-checkin-btn.state-pending {
  border: 2rpx solid #F5A623;
  box-shadow: 0 8rpx 24rpx rgba(245, 166, 35, 0.4);
}

.omni-checkin-btn.state-partial {
  background: linear-gradient(135deg, #B8342A 0%, #8C231C 100%);
}

.omni-checkin-btn.state-done {
  background: linear-gradient(135deg, #2E7D32 0%, #1B5E20 100%);
  box-shadow: 0 8rpx 20rpx rgba(46, 125, 50, 0.28);
}

.omni-checkin-btn.state-done:active {
  background: #1B5E20;
}

/* 次级跳转入口：店长/财务身份可能同时具备（超管），两条链接可以同时出现，
   用弱化的胶囊样式呈现，不与上方的打卡主按钮抢视觉焦点 */
.omni-checkin-manage-links {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.omni-checkin-manage-link {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 64rpx;
  background: #FAF8F5;
  border: 1rpx solid #EFE6D8;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #8C7355;
}

.omni-checkin-manage-link:active {
  background: #F1EBE2;
}

.omni-link-arrow {
  font-size: 20rpx;
  color: #C97B3D;
}

.omni-checkin-store-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  padding: 14rpx;
  background: #F8F9FA;
  border: 1rpx dashed #DEE2E6;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #868E96;
}

.manager-home-card,
.finance-home-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
}

.manager-home-card .card-header-welcome,
.finance-home-card .card-header-welcome {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

/* 🐛 玻璃拟态：财务稽核台 Header 单独抬一层半透明磨砂底，与卡片本身的纯白底
   拉开一点层次，不再是"标题文字直接摆在实色卡片上"的单调堆叠 */
.finance-home-card .card-header-welcome {
  background: rgba(255, 235, 238, 0.5);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin: -4rpx -4rpx 20rpx;
}

.manager-home-card .welcome-icon,
.finance-home-card .welcome-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.manager-home-card .welcome-text-box,
.finance-home-card .welcome-text-box {
  flex: 1;
}

.manager-home-card .welcome-title,
.finance-home-card .welcome-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  display: block;
}

.manager-home-card .welcome-sub,
.finance-home-card .welcome-sub {
  font-size: 24rpx;
  color: #888888;
  margin-top: 6rpx;
  display: block;
}

.manager-home-card .role-stats-banner,
.finance-home-card .role-stats-banner {
  display: flex;
  align-items: center;
  justify-content: space-around;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  margin-top: 4rpx;
  position: relative;
}

.manager-home-card .manager-bg {
  background: linear-gradient(135deg, #FFFDF8 0%, #FFF3E0 100%);
  border: 1rpx solid #FFE0B2;
}

.finance-home-card .finance-bg {
  background: linear-gradient(135deg, #FFFDF8 0%, #FFEBEE 100%);
  border: 1rpx solid #FFCDD2;
}

.manager-home-card .stat-item,
.finance-home-card .stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.manager-home-card .stat-num,
.finance-home-card .stat-num {
  font-size: 34rpx;
  font-weight: bold;
  color: #E65100;
  line-height: 1.2;
}

.manager-home-card .stat-num.highlight,
.finance-home-card .stat-num.highlight {
  color: #D32F2F;
}

.manager-home-card .stat-num.green-text,
.finance-home-card .stat-num.green-text {
  color: #2E7D32;
}

.manager-home-card .stat-label,
.finance-home-card .stat-label {
  font-size: 20rpx;
  color: #8D6E63;
  margin-top: 4rpx;
}

.manager-home-card .stat-divider,
.finance-home-card .stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(140, 29, 24, 0.1);
}

/* 🌟 财务专属功能区宫格：复用 .qa-main-grid 的白底/圆角/阴影样式，与稽核台间隔开 */
.finance-qa-grid {
  margin-top: 20rpx;
}

/* 🐛 财务首页瘦身：录入表单默认收起后的唯一展开口子，刻意做成不起眼的文字链接
   （而不是又一张卡片/大按钮）——找得到，但不与上方稽核台抢视觉焦点 */
.finance-form-override-link {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B71C1C;
  padding: 8rpx 0;
}

/* ================= 财务专属功能区：稽核封账 / 风控预警弹窗 ================= */
.finance-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: finance-modal-fade-in 0.18s ease-out;
}

@keyframes finance-modal-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.finance-modal-card {
  width: 82%;
  max-width: 620rpx;
  max-height: 75vh;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 🐛「风控预警日志」平滑拉起：从下方轻微位移 + 淡入，而不是硬切出现，
   呼应"拉起面板"这个交互动词，与稽核封账那个纯居中弹窗的观感区分开 */
.risk-modal-card {
  animation: risk-modal-slide-up 0.22s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes risk-modal-slide-up {
  from { opacity: 0; transform: translateY(48rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.finance-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.finance-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
}

.finance-modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #868E96;
}

.finance-modal-desc {
  display: block;
  font-size: 24rpx;
  color: #868E96;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

/* 🐛 根因修复（日期区间行"至"字与两个日期框对不齐/纵向堆叠）：
   .finance-range-picker-row 此前完全没有样式，<view> 默认块级布局，两个
   <picker> 包裹的日期框各自占满一整行纵向堆叠，"至"字被挤在中间自成一行——
   不是简单的对齐问题，是整行压根没有起 flex。补上横向 flex 行，两个日期框
   等宽平分、"至"字居中夹在中间，且不再各自带 margin-bottom（原先是按"纵向
   表单字段"设计的间距，现在由行级容器统一控制） */
.finance-range-picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.finance-month-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 1;
  min-width: 0;
  background: #F8F9FA;
  border: 1rpx solid #E9ECEF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #212529;
  font-weight: 500;
  box-sizing: border-box;
}

.finance-month-picker .arrow {
  font-size: 20rpx;
  color: #ADB5BD;
  flex-shrink: 0;
}

.finance-range-sep {
  font-size: 26rpx;
  color: #868E96;
  flex-shrink: 0;
}

.lock-status-tip {
  display: block;
  font-size: 24rpx;
  color: #4E5969;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

/* 🐛 补齐一直缺失的按钮语义配色：WXML 早就按"确认封账/解封/已封账只读"
   三种状态挂了 btn-danger/btn-unlock/btn-locked-disabled 三个类名，但这里
   此前只有基础的 .finance-modal-confirm-btn 一份写死的绿色渐变——三种状态
   视觉上完全一样，用户分不清当前是哪个动作 */
.finance-modal-confirm-btn {
  width: 100% !important;
  height: 88rpx;
  line-height: 88rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 44rpx;
  padding: 0;
  margin: 0;
  border: none;
}

.finance-modal-confirm-btn::after {
  border: none;
}

.finance-modal-confirm-btn.btn-danger {
  background: linear-gradient(135deg, #C9302C 0%, #A32621 100%);
}

.finance-modal-confirm-btn.btn-unlock {
  background: linear-gradient(135deg, #2E7D32 0%, #1B5E20 100%);
}

/* 🎨 禁用态置灰：区间内没有可封账记录（或已锁定的只读态）时，按钮不该再
   长得和可点击的红/绿实底一个样——微信原生 button[disabled] 自带的半透明
   遮罩在深色实底渐变上视觉区分度不够，这里用显式类名彻底覆盖成浅灰不可
   点样式（小程序 wxss 不支持 [disabled] 属性选择器，靠 WXML 动态类名切换，
   而不是属性选择器兜底） */
.finance-modal-confirm-btn.btn-flat-disabled,
.finance-modal-confirm-btn.btn-locked-disabled {
  background: #F2F3F5 !important;
  color: #C9CDD4 !important;
  box-shadow: none !important;
}

/* 🐛 根因修复（"近 60 天: ... 至 ..."与"刷新"挤在一起，"刷新"二字被拆成
   两行）：.risk-range-row/.risk-range-label/.risk-range-refresh 此前完全
   没有任何样式——<view> 默认块级堆叠、<text> 默认行内换行，日期区间文本一长
   就把"刷新"两个字挤到换行处生生拆开。补上标准左右 flex 行：日期区间用
   nowrap，"刷新"做成不换行的浅灰小胶囊，两者各自有固定的行为边界，不会
   互相挤占对方的换行空间 */
.risk-range-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.risk-range-label {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #4E5969;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.risk-range-refresh {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: #F2F3F5;
  color: #1D2129;
  white-space: nowrap;
}

.risk-range-refresh.is-spinning {
  color: #868E96;
}

.risk-summary-row {
  display: flex;
  justify-content: space-around;
  background: #FAF8F5;
  border-radius: 16rpx;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.risk-summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.risk-summary-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #C62828;
}

.risk-summary-label {
  font-size: 20rpx;
  color: #868E96;
}

.risk-loading {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #868E96;
}

.risk-alert-list {
  max-height: 50vh;
}

.risk-alert-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  background: #FFF8E1;
  border-left: 6rpx solid #FFA000;
}

.risk-alert-item.danger {
  background: #FFEBEE;
  border-left-color: #C62828;
}

.risk-alert-date {
  font-size: 22rpx;
  font-weight: bold;
  color: #444444;
}

.risk-alert-msg {
  font-size: 22rpx;
  color: #666666;
  line-height: 1.5;
}

.risk-alert-empty {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #2E7D32;
}

.shift-scroll-area {
  max-height: 55vh;
  margin: 20rpx 0;
}

.modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99999;
}

.modal-card {
  width: 88%;
  max-width: 680rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
}

/* 🦻 到岗打卡弹窗底部安全间距：橙色确认按钮紧贴卡片底边，在带 Home 指示条的
   机型上尤其局促——只加宽这一个弹窗（.modal-card.shift-card 组合选择器，
   优先级高于基础 .modal-card），不影响项目里其它复用 .modal-card 的弹窗 */
.modal-card.shift-card {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.modal-card .modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F0E6D2;
  margin-bottom: 8rpx;
}

.modal-card .modal-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2D2D2D;
}

.modal-card .close-btn {
  font-size: 32rpx;
  color: #999999;
  line-height: 1;
  padding: 8rpx;
}

/* ── 打卡弹窗业务模型重构：供餐时段（第一维）─────────────────────────── */
.checkin-section-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #8D6E63;
  margin: 20rpx 0 12rpx;
}
.checkin-section-title:first-child {
  margin-top: 0;
}

/* ══════════════════════════════════════════════════════════════════════
   ⚠️ 2026-08 事故记录：本模态框此前的样式一度只写进了这份 index.wxss，
   但项目 project.config.json 的 useCompilerPlugins 里同时启用了 "sass"——
   微信开发者工具在这种配置下，只要同目录存在同名 .scss 文件（index.scss），
   编译产物就以 .scss 编译结果为准，会静默覆盖这份手写 .wxss，而 index.scss
   里这一段还停留在"业务模型重构"之前的旧版结构（.shift-item/.shift-time 等
   早已不被 WXML 引用的死类名），导致真机呈现"完全无样式的纯文本堆叠"。
   已把 project.config.json 的 useCompilerPlugins 里的 "sass" 移除（全仓库
   6 个 .scss 都有同名 .wxss，移除不会破坏任何页面），这份 .wxss 现在才是
   真正生效的样式来源。以下类名与 index.scss 里的同名旧内容已不再对应，
   .scss 那份仅作历史存档，不再是编译源。
   ══════════════════════════════════════════════════════════════════════ */

/* ── 供餐时段（第一维）：横向分段选项卡 ────────────────────────────── */
.shift-tabs-container {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

/* 固定 2×2 网格：flex-basis 用 calc(50% - 16rpx) 精确扣掉一半 gap，两列宽度
   严格对称，不再靠 flex:1 的自动增长在 3/4 个元素之间分配剩余空间——那种写法
   在项目数不能整除每行列数时，最后一行的元素会被拉伸铺满整行，视觉上不对齐 */
.shift-tab-item {
  position: relative;
  flex: 1 1 calc(50% - 16rpx);
  height: 72rpx;
  box-sizing: border-box;
  border-radius: 36rpx;
  border: 2rpx solid #e0e0e0;
  background: #f8f8f8;
  font-size: 26rpx;
  color: #2D2D2D;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s, border-color 0.15s, transform 0.1s;
}
.shift-tab-item:active {
  transform: scale(0.97);
}

.shift-tab-text-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: 1.3;
}

.shift-tab-name {
  font-size: 26rpx;
}

.shift-tab-time {
  font-size: 20rpx;
  color: #8D6E63;
}

.shift-tab-item.active {
  background: #fff7e6;
  border-color: #ff7a00;
  color: #ff7a00;
  font-weight: bold;
}
.shift-tab-item.active .shift-tab-time {
  color: #ff7a00;
}

.shift-tab-item.completed {
  background: #F2F4F7;
  border-color: #E2E8F0;
  color: #98A2B3;
  opacity: 0.75;
}
.shift-tab-item.completed .shift-tab-time {
  color: #2E7D32;
  font-weight: bold;
}

/* ── 护持工种（第二维）：2×2 网格卡片，多选 ─────────────────────────── */
.job-grid-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

/* 🐛 选中态反差增强：此前选中态是浅橙描边+浅橙底（#fff7e6/#ff7a00 描边），
   与未选中态的白底灰框反差不够强烈，弱光/小屏下不容易一眼分辨。改为选中态
   直接实色暖橙渐变填充整卡+文字反白，未选中态保持清爽浅灰，两态对比拉到最大。
   右上角对勾角标仍是 .active 状态下的纯 CSS ::after 伪元素——只要 .active
   类命中，勾标一定跟着出现，不会出现"背景高亮了但勾标没出现"的错位情况。
   布局结构属性（flex/min-height/padding 等）延续之前的版本，颜色/边框/
   阴影全部按最新配色重写，!important 强制赢过任何残留的低优先级同名规则 */
.job-card {
  position: relative;
  min-height: 110rpx;
  padding: 16rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 6rpx;
  background: #f8f9fa !important;
  border: 2rpx solid #e2e8f0 !important;
  border-radius: 18rpx !important;
  transition: all 0.25s ease;
  overflow: hidden;
}
.job-card:active {
  transform: scale(0.97);
}

.job-card-icon {
  font-size: 40rpx;
  line-height: 1.2;
}

.job-card .job-card-title {
  color: #334155 !important;
  font-size: 28rpx !important;
  font-weight: 500 !important;
}

.job-card .job-card-subtitle {
  color: #94a3b8 !important;
  font-size: 22rpx !important;
  margin-top: 6rpx;
}

/* 选中激活态：强对比暖橙实色渐变卡片，WXML 里只会加 active（见 job-card
   wx:for 循环），.selected 一并写上纯粹是防御性兼容，不影响现状 */
.job-card.active,
.job-card.selected {
  background: linear-gradient(135deg, #ff9800 0%, #ff6f00 100%) !important;
  border: 2rpx solid #e65100 !important;
  box-shadow: 0 8rpx 20rpx rgba(255, 111, 0, 0.28) !important;
  transform: translateY(-2rpx);
}
.job-card.active .job-card-title,
.job-card.selected .job-card-title {
  color: #ffffff !important;
  font-weight: bold !important;
}
.job-card.active .job-card-subtitle,
.job-card.selected .job-card-subtitle {
  color: rgba(255, 255, 255, 0.9) !important;
}

/* 右上角超大显眼对勾角标 */
.job-card.active::after,
.job-card.selected::after {
  content: "✓" !important;
  position: absolute !important;
  top: 0 !important;
  right: 0 !important;
  width: 40rpx !important;
  height: 40rpx !important;
  background: #ffffff !important;
  color: #ff6f00 !important;
  font-size: 24rpx !important;
  font-weight: 900 !important;
  line-height: 40rpx !important;
  text-align: center !important;
  border-radius: 0 16rpx 0 16rpx !important;
  box-shadow: -2rpx 2rpx 6rpx rgba(0, 0, 0, 0.12) !important;
}

/* ── 横向工时微调步进器 ──────────────────────────────────────────────────
   🐛 挤压/变形根因：.step-btn 此前只设了 width/height，没有 flex-shrink:0，
   也没有用 flex 居中"－"/"＋"字符（只靠 line-height 估算垂直居中）——微信
   原生 <button> 组件自带的默认内边距/最小宽度在部分基础库版本下优先级比这些
   普通属性高，挤压环境下会把圆形按钮撑成椭圆或直接被压扁。改为对
   .stepper-controls .step-btn 用完整 !important 覆盖（含 flex 居中 +
   flex-shrink:0 + max-width 兜底），确保任何情况下都以固定 64rpx 圆形渲染，
   不再被原生按钮默认样式或父级空间不足影响变形 ─────────────────────────── */
.stepper-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  width: 100%;
}

/* 保留 display:flex;flex-direction:column——WXML 里这个容器还嵌着一条条件
   提示（.stepper-hint，未选工种时显示），需要在主标签下方单独占一行；
   不影响 white-space:nowrap 的效果，nowrap 只管每个子元素自己的文本
   不换行，不管子元素之间是纵向堆叠还是横向并排 */
.stepper-label {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
}

.stepper-hint {
  font-size: 22rpx;
  font-weight: normal;
  color: #D92D20;
  white-space: nowrap;
}

.stepper-controls {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.stepper-controls .step-btn {
  width: 64rpx !important;
  height: 64rpx !important;
  min-height: 64rpx !important;
  max-width: 64rpx !important;
  border-radius: 50% !important;
  border: 2rpx solid #e0e0e0 !important;
  background: #ffffff !important;
  color: #ff7a00 !important;
  font-size: 36rpx !important;
  line-height: 56rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-sizing: border-box !important;
  flex-shrink: 0 !important;
}
.stepper-controls .step-btn::after {
  border: none !important;
}
.stepper-controls .step-btn:active {
  transform: scale(0.9);
  background: #FFF3E8 !important;
}

.stepper-controls .step-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff7a00;
  min-width: 80rpx;
  text-align: center;
}

/* ── 留餐卡片 ────────────────────────────────────────────────────────── */
.reserve-meal-card {
  display: flex;
  align-items: center;
  background: #fff;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
  margin-top: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  gap: 12rpx;
  /* 🌟 与上方班次/工种区块做视觉区隔的分割线，紧贴在这一行正上方 */
  border-top: 1rpx dashed #EAECF0;
  padding-top: 24rpx;
}

/* 大尺寸复选框：原生 checkbox 组件不支持直接 width/height 缩放，用 transform
   放大到约 1.3 倍，视觉上更接近"大尺寸复选框"的要求，同时不影响周围布局
   （transform 不占用额外文档流空间） */
.meal-reserve-checkbox {
  transform: scale(1.3);
  transform-origin: left center;
}

.meal-tip {
  font-size: 28rpx;
  color: #5D4037;
  flex: 1;
  line-height: 1.4;
}

/* 🐛 留店用餐细分餐别 Chip 多选（早/午/晚）：此前这份样式只存在于未参与实际
   构建的 index.scss 里，真正生效的 index.wxss 从未定义过 .meal-type-chip，
   导致 WXML 里这三个 Chip 在真机上一直是无边框/无底色的裸文字——现在补齐，
   并按适老化要求把字号/触控热区一并提上来，不是简单照搬旧 scss 数值 */
.meal-type-chip-row {
  display: flex;
  gap: 12rpx;
  padding: 0 28rpx;
  margin-top: 12rpx;
}

.meal-type-chip {
  flex: 1;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #8D6E63;
