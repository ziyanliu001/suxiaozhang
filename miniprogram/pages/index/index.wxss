/* Card B: 物资与服务统计网格 */
.optional-tag {
  font-size: 20rpx;
  color: #ADB5BD;
  font-weight: normal;
}

.block-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #212529;
  display: block;
  margin-bottom: 12rpx;
}

/* 📋 【一键复用昨日数据】：仅"义工与用餐统计"标题这一处需要在右侧并排放按钮，
   新起一层包装行，不改 .block-title 本身（其余多处仍是单独一行纯文本标题） */
.block-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.block-title-row .block-title.no-margin {
  margin-bottom: 0;
  flex: 1;
}

.reuse-yesterday-btn {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #E65100;
  background: #FFF3E0;
  border: 1rpx solid #FFE0B2;
  border-radius: 20rpx;
  padding: 8rpx 18rpx;
  white-space: nowrap;
}

.reuse-yesterday-btn.disabled {
  color: #ADB5BD;
  background: #F8F9FA;
  border-color: #E9ECEF;
}

.form-sub-block.top-space {
  margin-top: 24rpx;
}

.input-wrapper-inner {
  background: #F8F9FA;
  border: 1rpx solid #CED4DA;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}

.single-line-textarea {
  font-size: 24rpx;
  color: #212529;
  width: 100%;
  min-height: 60rpx;
  line-height: 1.5;
}

/* 🍱 义工与用餐统计：2 行 x 3 列 6 宫格卡片网格。
   真机上出现过单列拉通崩溃（疑似构建缓存导致这里的 class 样式未命中），
   .stats-grid-row 补上原本省略的 flex-direction: row（虽是默认值，显式写死
   更保险）+ !important，与 WXML 行内 style 双保险，任一层生效都能撑住布局 */
.stats-grid-container {
