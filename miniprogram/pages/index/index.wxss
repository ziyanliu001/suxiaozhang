}

.modal-card .close-btn {
  font-size: 32rpx;
  color: #999999;
  line-height: 1;
  padding: 8rpx;
}

/* ── 打卡弹窗业务模型重构：供餐时段（第一维）─────────────────────────── */
.checkin-section-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #8D6E63;
  margin: 20rpx 0 12rpx;
}
.checkin-section-title:first-child {
  margin-top: 0;
}

.meal-slot-row {
  display: flex;
  gap: 12rpx;
}

.meal-slot-chip {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 18rpx 8rpx;
  background: #FFFFFF;
  border: 2rpx solid #F2F4F7;
  border-radius: 16rpx;
  transition: background 0.15s, border-color 0.15s, transform 0.1s;
  box-sizing: border-box;
}
.meal-slot-chip:active {
  transform: scale(0.97);
}

.meal-slot-chip-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #2D2D2D;
}

.meal-slot-chip-time {
  font-size: 20rpx;
  color: #8D6E63;
}

.meal-slot-chip-active {
  background: #FFF8F2;
  border-color: #F97316;
  box-shadow: 0 4rpx 12rpx rgba(249, 115, 22, 0.15);
}
.meal-slot-chip-active .meal-slot-chip-name {
  color: #C0392B;
}

.meal-slot-chip-completed {
  background: #F2F4F7;
  border-color: #E2E8F0;
  opacity: 0.6;
}

.meal-slot-chip-completed-tag {
  font-size: 18rpx;
  color: #2E7D32;
  font-weight: bold;
}

/* ── 护持工种（第二维）：2×2 网格卡片，多选 ─────────────────────────── */
.job-type-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.job-type-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 22rpx 12rpx;
  background: #FFFFFF;
  border: 2rpx solid #F2F4F7;
  border-radius: 20rpx;
  box-sizing: border-box;
  transition: background 0.15s, border-color 0.15s, transform 0.1s;
}
.job-type-card:active {
  transform: scale(0.97);
}

.job-type-card-icon {
  font-size: 44rpx;
  line-height: 1.2;
}

.job-type-card-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #2D2D2D;
}

.job-type-card-hours {
  font-size: 20rpx;
  color: #8D6E63;
}

.job-type-card-active {
  background: #FFF8F2;
  border-color: #F97316;
  box-shadow: 0 4rpx 12rpx rgba(249, 115, 22, 0.18);
}
.job-type-card-active .job-type-card-name {
  color: #C0392B;
}

/* 右上角对勾角标：与个人页申请身份卡片同一套视觉语言 */
.job-type-card-check {
  position: absolute;
  top: -1rpx;
  right: -1rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: bold;
  color: #FFFFFF;
  background: #F97316;
  border-radius: 0 18rpx 0 18rpx;
}

/* ── 工时联动预览 + 微调步进器 ──────────────────────────────────────── */
.hours-preview-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: #FFF8F2;
  border-radius: 16rpx;
}

.hours-preview-label {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: #2D2D2D;
}

.hours-preview-hint {
  font-size: 20rpx;
  font-weight: normal;
  color: #D92D20;
}

.hours-stepper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hours-stepper-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #FFFFFF;
  border: 2rpx solid #F97316;
  color: #F97316;
  font-size: 28rpx;
  font-weight: bold;
}
.hours-stepper-btn:active {
  transform: scale(0.9);
  background: #FFF3E8;
}

.hours-stepper-value {
  min-width: 64rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #C0392B;
}

.meal-reserve-row {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  background: #FFF9DB;
  border-radius: 16rpx;
  margin-top: 20rpx;
  /* 🌟 与上方班次列表做视觉区隔的分割线，紧贴在这一行正上方 */
  border-top: 1rpx dashed #EAECF0;
  padding-top: 24rpx;
  gap: 12rpx;
}

.meal-tip {
  font-size: 24rpx;
  color: #5D4037;
  flex: 1;
  line-height: 1.4;
}

.btn-confirm-checkin {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #F97316;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
  border-radius: 48rpx;
  margin-top: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(249, 115, 22, 0.25);
}

.btn-confirm-checkin::after {
  border: none;
}

.btn-confirm-checkin:active {
  transform: scale(0.97);
