}

.status-pill.yellow.active {
  background: #FEF7E0;
  color: #B06000;
  border: 2rpx solid #B06000;
  font-weight: bold;
  box-shadow: 0 0 0 4rpx rgba(176, 96, 0, 0.1);
}

.status-pill.yellow.active::after {
  content: " ✓";
  font-size: 18rpx;
}

.status-pill.red.active {
  background: #FFF2F0;
  color: #FF4D4F;
  border: 2rpx solid #FFA39E;
