  border: none;
}

/* 🚨 页面末尾强制覆盖：正红渐变 + 纯白大字，压过微信原生 button[disabled] 半透明遮罩。
   与本文件前面 .poster-gen-btn 那份规则内容一致，这里追加在文件最末尾仅为提高
   源码顺序上的最终优先级，双重保险。 */
.poster-gen-btn,
button.poster-gen-btn,
.poster-gen-btn[disabled],
button.poster-gen-btn[disabled] {
  background: #C62828 !important;
  background-image: linear-gradient(135deg, #C62828 0%, #B71C1C 100%) !important;
  color: #FFFFFF !important;
  font-weight: bold !important;
  opacity: 1 !important;
  border: none !important;
  box-shadow: 0 4rpx 12rpx rgba(198, 40, 40, 0.3) !important;
}

/* 🍱 义工与用餐统计标题按钮/汇总卡片保险：class 名沿用既有的 .reuse-yesterday-btn
   （未采用请求里的 .btn-reuse-yesterday，是为了不影响 disabled 态判断走的同一个 class） */
.reuse-yesterday-btn:active {
  opacity: 0.8;
  background: #FFE0B2 !important;
}

.stats-summary-card {
  box-shadow: inset 0 1rpx 3rpx rgba(0, 0, 0, 0.02);
}

/* 🚨 雨花家训弹窗保险：类名沿用 .family-motto-card（这个类本就只用在这一个弹窗），
   未采用请求里的 .motto-modal-card，避免和其他地方潜在同名类冲突 */
.family-motto-card {
  margin-top: 80rpx !important;
}

.motto-modal-close:active {
  opacity: 0.6;
}
/* ☀️ 阳光账本入口卡片：标题正下方、全角色可见、位置最优先，阳光公益质感——
   暖金渐变 + 太阳图标，与页面其余卡片的米白基调区分开，一眼可辨识出这是
   "公开透明数据"入口而非普通功能入口 */
/* 🌟 瘦身为极简公告条：原先双行（标题+副标题）+ 大内边距的卡片明显偏高，
   压缩成 80rpx 单行，标题/副标题同行展示，给下方"财务稽核台""生成餐报"等
   核心操作腾出首屏空间 */
.sunshine-ledger-entry {
  display: flex;
  align-items: center;
  height: 80rpx;
  margin: 16rpx 24rpx 20rpx;
  padding: 0 24rpx;
  background: linear-gradient(135deg, #FFF8E1 0%, #FFECB3 100%);
  border: 1rpx solid #FFD54F;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 193, 7, 0.16);
  box-sizing: border-box;
}

.sunshine-ledger-entry:active {
  opacity: 0.85;
}

.sunshine-ledger-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.sunshine-ledger-text-group {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 10rpx;
  overflow: hidden;
  white-space: nowrap;
}

.sunshine-ledger-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #8D5B00;
  flex-shrink: 0;
}

.sunshine-ledger-sub {
  font-size: 22rpx;
  color: #A87B1F;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sunshine-ledger-arrow {
  font-size: 22rpx;
  color: #C99A2E;
  flex-shrink: 0;
}

/* ☀️ 阳光账本 Modal：与 .compliance-modal-mask/.compliance-modal-card 同款遮罩+
   卡片骨架，头部沿用暖金主题呼应入口卡片，内容轻量（三项汇总数字 + 一条透明说明） */
.sunshine-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.sunshine-modal-card {
  width: 84%;
  max-width: 600rpx;
  max-height: 82vh;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.sunshine-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}

.sunshine-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #8D5B00;
}

.sunshine-modal-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #F1F3F5;
  color: #6B7280;
  font-size: 24rpx;
}

/* 🛡️ min-height: 0 是让 flex 子项能被压缩到小于内容高度的关键，缺了这行
   scroll-view 会撑到内容的完整高度，滚动条永远不会真正生效 */
.sunshine-modal-scroll {
  flex: 1;
  min-height: 0;
}

/* 📖 理念介绍卡片：暖金质感背景，与下方数据大盘的配色自然衔接，
   避免纯数字表格显得冷冰冰。弹窗 Header 已经承载"关于雨花斋与阳光账本"
   这层标题，卡片内部不再重复次级标题，直接进两段内容 */
.sunshine-intro-card {
  width: 100%;
  background: linear-gradient(155deg, #FFF8E8 0%, #FFF3D6 100%);
  border: 1rpx solid #F0D9A0;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

/* 🌸 侧条高亮卡片：每段文案独立一张浅底小卡 + 左侧金色竖条，
   替代此前"整段文案堆在一起"的排版，段落之间呼吸感更强 */
.sunshine-intro-block {
  background: rgba(255, 255, 255, 0.55);
  border-left: 6rpx solid #E6A23C;
  border-radius: 8rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 18rpx;
}

.sunshine-intro-block:last-child {
  margin-bottom: 0;
}

.sunshine-intro-label {
  display: inline-block;
  font-size: 22rpx;
  font-weight: bold;
  color: #FFFFFF;
  background: #E6A23C;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  margin-bottom: 12rpx;
}

.sunshine-intro-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6B4C1E;
}

/* ✨ 理念介绍 / 数据大盘分界线：虚线 + 居中标签，标签文字带一点暖金微光，
   让两段内容读起来是两个层次，而不是同一块内容的延续 */
.sunshine-section-divider {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 20rpx 0;
}

.sunshine-divider-line {
  flex: 1;
  height: 0;
  border-top: 2rpx dashed rgba(230, 162, 60, 0.4);
}

.sunshine-divider-label {
  font-size: 20rpx;
  font-weight: bold;
  color: #C08A3E;
  text-shadow: 0 0 8rpx rgba(230, 162, 60, 0.35);
  white-space: nowrap;
}

.sunshine-modal-loading {
  text-align: center;
  padding: 60rpx 0;
  color: #ADB5BD;
  font-size: 26rpx;
}

.sunshine-modal-body {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sunshine-store-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #222222;
}

.sunshine-period-label {
  font-size: 22rpx;
  color: #868E96;
  margin-top: 6rpx;
  margin-bottom: 24rpx;
}

/* 🗓️ 月份切换器：‹ 2026年07月 › ，标题下方、数据网格上方 */
.sunshine-month-switcher {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.sunshine-month-arrow {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: #FFF3D6;
  color: #E6A23C;
  font-size: 28rpx;
  font-weight: bold;
}

.sunshine-month-arrow-disabled {
  color: #D9D9D9;
  background: #F5F5F5;
}

.sunshine-month-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #8D5B00;
  min-width: 160rpx;
  text-align: center;
}

/* 📊 4x2 网格数据大盘：8 项指标（2 列 x 4 行），每格独立卡片化，
   保留同一套暖金配色 */
.sunshine-stat-grid-2x2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  width: 100%;
  margin-bottom: 20rpx;
}

.sunshine-stat-cell-2x2 {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  background: linear-gradient(135deg, #FFFDF5 0%, #FFF8E1 100%);
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  box-sizing: border-box;
}

.sunshine-stat-num-2x2 {
  font-size: 36rpx;
  font-weight: bold;
  color: #E6A23C;
}

.sunshine-stat-lbl-2x2 {
  font-size: 22rpx;
  color: #A87B1F;
  text-align: center;
}

.sunshine-transparency-tip {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  width: 100%;
  background: #F1F8F1;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  box-sizing: border-box;
}

.sunshine-tip-icon {
  font-size: 22rpx;
}

.sunshine-tip-text {
  flex: 1;
  font-size: 22rpx;
  color: #4A7C4A;
  line-height: 1.6;
}

/* 🛠️ 首页「义工现场服务工具」金刚区：与旧的 .volunteer-tools-card/.tool-grid-item
   系列完全独立的一套 home-vt-* 命名，不与页面内任何既有样式共用/继承。
   🐛 .home-vt-item 补了 min-width: 0，.home-vt-text 补了 width: 100% +
   min-width: 0 + word-break——flex 子项默认 min-width: auto 会按文字"不换行
   宽度"撑开，不加这两处会导致长一点的中文标签在 3 等分栏宽下溢出、挤到
   相邻卡片上（此前已经踩过一次这个坑，这里直接一并补上，避免同一类问题
   在未来换更长文案时再犯一次） */
.home-vt-card {
  margin: 20rpx 28rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.home-vt-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #2D3748;
  margin-bottom: 20rpx;
  text-align: left;
}

.home-vt-grid {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.home-vt-item {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 8rpx;
  margin: 0 8rpx;
  background: #F7FAFC;
  border-radius: 16rpx;
  border: 1rpx solid #EDF2F7;
  transition: transform 0.15s ease, background 0.15s ease;
}

.home-vt-item:active {
  transform: scale(0.96);
  background: #EDF2F7;
}

.home-vt-icon {
  font-size: 40rpx;
  line-height: 1;
  margin-bottom: 8rpx;
}

.home-vt-text {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 600;
  color: #2D3748;
  text-align: center;
  line-height: 1.3;
  word-break: break-word;
}

/* ===== 🛡️ 通用 scroll-view 底部留白占位 =====
   置于每个 scroll-view 末尾，防止最后一项在滚动到底部时
   被物理安全区或弹窗边缘遮住（与 profile / statistics 页同名类保持一致） */
.fa-safe-area-spacer {
  height: calc(20rpx + constant(safe-area-inset-bottom));
  height: calc(20rpx + env(safe-area-inset-bottom));
}

/* ==================== 🌐 新用户零门槛引导卡 ==================== */

.nug-wrapper {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 48rpx 32rpx;
  background: #F8FAFF;
  box-sizing: border-box;
  z-index: 10;
}

.nug-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 56rpx 40rpx 44rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #f1f5f9;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  gap: 20rpx;
  box-sizing: border-box;
}

.nug-emoji {
  font-size: 80rpx;
  line-height: 1;
}

.nug-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
  text-align: center;
}

.nug-desc {
  font-size: 26rpx;
  color: #6B7280;
  text-align: center;
  line-height: 1.6;
  padding: 0 8rpx;
}

/* 共用底座：圆角 + 内边距 + flex 行排列 */
.nug-btn {
  width: 100%;
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  gap: 20rpx;
  border-radius: 18rpx;
  padding: 28rpx 32rpx;
  box-sizing: border-box;
  margin-top: 8rpx;
  transition: opacity 0.15s ease;
}
.nug-btn:active { opacity: 0.85; }

/* 主按钮：深蓝渐变 + 微阴影，传递"核心操作"视觉权重 */
.nug-btn-primary {
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.30);
  margin-top: 24rpx;
}

/* 主按钮内文字统一白色 */
.nug-btn-primary .nug-btn-main { color: #FFFFFF; }
.nug-btn-primary .nug-btn-sub  { color: rgba(255, 255, 255, 0.75); }
.nug-btn-primary .nug-btn-arrow { color: rgba(255, 255, 255, 0.70); }

/* 次按钮：浅灰底 + 细边框，视觉层级低一级 */
.nug-btn-secondary {
  background: #f8fafc;
  border: 1rpx solid #cbd5e1;
  margin-top: 20rpx;
}

.nug-btn-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.nug-btn-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.nug-btn-main {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D4ED8;
}

/* 次按钮主文字用深灰，与主按钮的白色形成层级差 */
.nug-btn-main--dark {
  color: #334155;
}

.nug-btn-sub {
  font-size: 24rpx;
  color: #6B7280;
}

.nug-btn-arrow {
  font-size: 36rpx;
  color: #9CA3AF;
  flex-shrink: 0;
}

.nug-footer {
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F3F4F6;
  width: 100%;
  text-align: center;
}

.nug-footer-text {
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.6;
}

/* ==================== 📋 折叠触发通栏卡片 ==================== */

.collapse-trigger-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 28rpx 32rpx;
  padding: 24rpx 32rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.03);
}

.collapse-trigger-card--open {
  background: #f1f5f9;
  border-color: #cbd5e1;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}

/* 左侧：图标 + 文字纵向列 */
.collapse-trigger-title {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.collapse-trigger-icon {
  font-size: 32rpx;
  flex-shrink: 0;
  line-height: 1;
}

.collapse-trigger-text-col {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.collapse-trigger-main {
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
  line-height: 1.3;
}

.collapse-trigger-sub {
  font-size: 21rpx;
  color: #94a3b8;
  line-height: 1.3;
}

/* 右侧：已录入徽章 + 旋转箭头 */
.collapse-trigger-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.accordion-badge {
  font-size: 20rpx;
  color: #EA580C;
  background: #FFF7ED;
  border: 1rpx solid #FDBA74;
  border-radius: 20rpx;
  padding: 2rpx 10rpx;
  line-height: 1.4;
  font-weight: 500;
}

/* CSS 旋转箭头：展开时旋转 180° */
.collapse-trigger-arrow {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 700;
  line-height: 1;
  display: inline-block;
  transition: transform 0.3s ease;
}

.collapse-trigger-arrow.expanded {
  transform: rotate(180deg);
}

/* ──────────────────────────────────────────────────────────────────────────── */
