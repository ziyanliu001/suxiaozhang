  border: 1rpx solid #FFE066;
  color: #D9480E;
  transition: all 0.2s ease;
}

.btn-expense-template-hover {
  background: #FFE066;
  transform: scale(0.96);
}

.btn-expense-template-pill .lbl {
  font-size: 20rpx;
  font-weight: bold;
  line-height: 1;
}

.btn-expense-template-pill .lbl {
  font-size: 20rpx;
  font-weight: bold;
