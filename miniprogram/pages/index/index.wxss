  position: relative;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.platform-card-hover {
  opacity: 0.85;
  transform: scale(0.99);
}

.platform-card-body {
  display: flex;
  align-items: center;
}

.platform-card-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.platform-card-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.platform-card-title {
  font-size: 32rpx;
  font-weight: bold;
