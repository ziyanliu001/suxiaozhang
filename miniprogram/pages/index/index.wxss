  border: 2rpx dashed #FFCCA8;
  box-shadow: none;
  animation: tmp-shimmer 2.4s ease-in-out infinite;
}

@keyframes tmp-shimmer {
  0%, 100% {
    box-shadow: 0 0 0 rgba(255, 152, 0, 0);
  }
  50% {
    box-shadow: 0 0 16rpx rgba(255, 152, 0, 0.18);
  }
}
.tmp-main {
  flex: 1;
  min-width: 0;
}

.tmp-header {
  margin-bottom: 10rpx;
}

.tmp-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tmp-9grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  max-width: 300rpx;
  margin-bottom: 10rpx;
}

.tmp-grid-item {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  border-radius: 8rpx;
  overflow: hidden;
