  height: 88rpx;
  line-height: 88rpx;
  background: #F97316;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
  border-radius: 48rpx;
  margin-top: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(249, 115, 22, 0.25);
}

.btn-confirm-checkin::after {
  border: none;
}

.btn-confirm-checkin:active {
  transform: scale(0.97);
  opacity: 0.9;
