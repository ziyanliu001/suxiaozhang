  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.nug-btn-main {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D4ED8;
}

/* 次按钮主文字用深灰，与主按钮的白色形成层级差 */
.nug-btn-main--dark {
  color: #334155;
}

.nug-btn-sub {
  font-size: 24rpx;
  color: #6B7280;
}

.nug-btn-arrow {
  font-size: 36rpx;
  color: #9CA3AF;
  flex-shrink: 0;
}

.nug-footer {
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F3F4F6;
  width: 100%;
  text-align: center;
}

.nug-footer-text {
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.6;
}

/* ==================== 📋 折叠触发通栏卡片 ==================== */

.collapse-trigger-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 28rpx 32rpx;
  padding: 24rpx 32rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.03);
}

.collapse-trigger-card--open {
  background: #f1f5f9;
  border-color: #cbd5e1;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}

/* 左侧：图标 + 文字纵向列 */
.collapse-trigger-title {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.collapse-trigger-icon {
  font-size: 32rpx;
  flex-shrink: 0;
  line-height: 1;
}

.collapse-trigger-text-col {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.collapse-trigger-main {
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
  line-height: 1.3;
}

.collapse-trigger-sub {
  font-size: 21rpx;
  color: #94a3b8;
  line-height: 1.3;
}

/* 右侧：已录入徽章 + 旋转箭头 */
.collapse-trigger-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.accordion-badge {
  font-size: 20rpx;
  color: #EA580C;
  background: #FFF7ED;
  border: 1rpx solid #FDBA74;
  border-radius: 20rpx;
  padding: 2rpx 10rpx;
  line-height: 1.4;
  font-weight: 500;
}

/* CSS 旋转箭头：展开时旋转 180° */
.collapse-trigger-arrow {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 700;
  line-height: 1;
  display: inline-block;
  transition: transform 0.3s ease;
}

.collapse-trigger-arrow.expanded {
  transform: rotate(180deg);
}

/* 🦻 关怀模式（阶段一）：本页绝大多数文字/控件的 font-size 是写死的固定 rpx
   值，天然不参与 CSS 继承缩放，无法靠一条容器级规则统一放大——3470 行 WXML
   逐个改造改用 em 相对单位不在本次范围内。这里改为对全站最高频复用的结构类
   （主操作按钮/表单标签/输入框/义工工具金刚区/打卡确认按钮）做定向覆盖，
   覆盖字号放大、边框加粗、触控热区达到 ≥48px（88rpx）三件事，是"最高频可见
   区域优先"的务实取舍，不是对全页面每个像素的逐一改造。*/
.care-mode .vt-form-label,
.care-mode .home-vt-text,
.care-mode .drawer-item-text {
  font-size: 30rpx !important;
  font-weight: 600 !important;
}

.care-mode .btn-main-action,
.care-mode .btn-confirm-checkin {
  min-height: 96rpx !important;
  font-size: 32rpx !important;
  border: 3rpx solid #000000 !important;
}

/* 🦻（2026-08-31 关怀模式"阶段二"）到岗打卡主 CTA：这是本页第一核心操作，
   此前"阶段一"覆盖了打卡后弹出的班次确认弹窗按钮（.btn-confirm-checkin），
   但漏了这颗真正最先被点到的入口按钮——按 line-height 居中的按钮（不是
   flex 布局），必须把 height 与 line-height 一起改，只改 height 会导致
   文字仍按旧的 line-height 居中、看起来往上偏 */
.care-mode .btn-volunteer-checkin {
  height: 112rpx !important;
  line-height: 112rpx !important;
  font-size: 34rpx !important;
  border: 3rpx solid #000000 !important;
}

/* 🦻 拍照识票是紧凑小胶囊，跟"常用项目"胶囊并排在同一行——不能直接套用
   上面大按钮的 112rpx 高度，否则会撑破横向排布，按约 1.4x 温和放大 */
.care-mode .btn-scan-receipt-pill {
  height: 64rpx !important;
  padding: 0 22rpx !important;
  border-width: 2rpx !important;
}

.care-mode .btn-scan-receipt-pill .lbl {
  font-size: 24rpx !important;
}

.care-mode .btn-scan-receipt-pill .icon {
  width: 30rpx !important;
  height: 30rpx !important;
}

.care-mode .home-vt-item {
  min-height: 96rpx !important;
  border-width: 3rpx !important;
  border-color: #333333 !important;
}

.care-mode .home-vt-icon {
  font-size: 48rpx !important;
}

/* 🐛（2026-08-31 修复 WXSS 标签选择器告警）此前是
   ".care-mode input, .care-mode textarea {}"——虽然已经比裸标签选择器窄
   （限定在 .care-mode 祖先下），但组合选择器里仍然含有裸标签名，同样会被
   开发者工具标黄。关怀模式的设计意图是"页面里任何一个文字输入框都要放大
   字号+加粗边框"，不能只覆盖一部分——枚举了本文件当前用到的每一个
   input/textarea 具体 class（核对过 WXML 逐个确认，而不是猜），四个此前
   完全没有 class 的门店绑定申请表单输入框（customStoreName/adminKeyInput/
   realName/phone）已在 WXML 里补上 .form-input 类一并纳入，确保枚举替换
   后关怀模式的覆盖范围与替换前的裸标签选择器完全一致，不会因为枚举遗漏
   而让某个输入框在关怀模式下悄悄变回小字号 */
.care-mode .amount-input,
.care-mode .audit-search-input,
.care-mode .balance-val,
.care-mode .fe-amount-input,
.care-mode .form-input,
.care-mode .input,
.care-mode .input-item-name,
.care-mode .input-item-price,
.care-mode .input-receipt-amount,
.care-mode .name-input,
.care-mode .notice-edit-input,
.care-mode .num-input,
.care-mode .quick-amount-input,
.care-mode .recipe-dish-name-input,
.care-mode .stats-input,
.care-mode .textarea,
.care-mode .single-line-textarea,
.care-mode .expense-textarea,
.care-mode .notice-edit-textarea,
.care-mode .adjust-textarea {
  font-size: 30rpx !important;
  border-width: 2rpx !important;
  border-color: #333333 !important;
}

.care-mode .ui-card-wrapper {
  border-width: 2rpx !important;
  border-color: #333333 !important;
}

/* 🦻（2026-08-31 关怀模式"阶段二"）大字成功提示覆盖层：wx.showToast 原生
   组件不支持自定义字号（微信平台本身的限制），仅在关怀模式开启、打卡/
   保存报告这两个核心成功时刻由 showCareModeSuccess() 触发，2.5秒后自动
   消失。样式上刻意做得比原生 Toast 更醒目（更大字号+绿色成功底色+居中
   悬浮），但不遮挡整个屏幕（不设背景蒙层），操作过程中仍能看到下方内容 */
.care-success-banner {
  position: fixed;
  left: 0;
  right: 0;
  top: 40%;
  display: flex;
  justify-content: center;
  z-index: 999;
  pointer-events: none;
}

.care-success-banner-inner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(47, 125, 60, 0.96);
  border-radius: 24rpx;
  padding: 32rpx 48rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.25);
  max-width: 80%;
}

.care-success-icon {
  font-size: 44rpx;
}

.care-success-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.4;
}

/* ──────────────────────────────────────────────────────────────────────────── */
