@charset "UTF-8";
page {
  background-color: #f8f9fa;
  height: 100vh;
}

.index-page-container {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  background-color: #F8F9FA;
  box-sizing: border-box;
  /* 自定义导航栏（navigationStyle: custom）下，页面顶部内容需自行避让胶囊按钮/刘海安全区。
     env(safe-area-inset-top) 只覆盖刘海/状态栏高度，胶囊按钮本身还有额外高度，
     单靠 env() 不够，故强制再叠加 80rpx 兜底，与 headerSafeTop 的动态胶囊测算共同生效，
     确保首屏渲染早于 JS 测算完成时内容也不会被遮挡 */
  padding-top: calc(env(safe-area-inset-top) + 80rpx) !important;
}

.app-header-section {
  background-color: #FFFFFF;
  width: 100%;
  box-sizing: border-box;
  padding-bottom: 24rpx;
  flex-shrink: 0;
}

.page-body-scroll {
  flex: 1;
  width: 100%;
  /* 底部同时叠着两层固定元素：三段式 TabBar（100rpx）+ 吸底双按钮组 .bottom-action-floating-bar
     （bottom: 100rpx 起，自身高度 24+88+24=136rpx），两者共占 236rpx，
     padding-bottom 必须盖过这个总高度，否则滚到底部时"意见反馈"/协议链接仍会被按钮组压住 */
  padding: 24rpx 24rpx calc(236rpx + env(safe-area-inset-bottom)) 24rpx;
  box-sizing: border-box;
}

.ui-card-wrapper {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid #F1F3F5;
  box-sizing: border-box;
}

.main-title-header-box {
  position: relative;
  text-align: center;
  padding-top: 32rpx;
  margin-bottom: 16rpx;
}

.brand-header-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #B22222;
  letter-spacing: 1rpx;
}

/* 左侧功能导航抽屉入口（三道槓） */
.hamburger-menu-btn {
  position: absolute;
  left: 28rpx;
  top: 32rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: opacity 0.2s ease;
}

.hamburger-menu-btn.capsule-hover {
  opacity: 0.6;
}

.hamburger-line {
  width: 32rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #B22222;
}

.capsule-bar-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tag-badge-capsule.blue-theme {
