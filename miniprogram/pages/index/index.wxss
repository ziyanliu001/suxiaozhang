/* ================= 底部悬浮核心功能按钮 ================= */
.bottom-action-floating-bar {
  position: fixed;
  /* 悬浮于底部三段式导航栏（100rpx + 安全区）之上，避免相互遮挡 */
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  /* 纯白不透明背景 + 更轻的阴影，与上方表单滚动区形成明确的物理分层，
     不透明是必须的——半透明底色滚动时会看到文字从下面透上来，观感很脏 */
  background: #FFFFFF;
  padding: 24rpx 32rpx;
  display: flex;
  gap: 20rpx;
  border-top: 1rpx solid #E9ECEF;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 90;
}

.btn-main-action {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.15s ease;
  border: none;
}

/* 🌟 明确的按压变暗反馈：小程序原生已经用 hover-class="btn-hover" 做了一版（见下方 .btn-hover），
   这里再补一条标准 :active 规则兜底——个别机型/webview 对 hover-class 的触发时机不够跟手，
   :active 是更底层、响应更即时的浏览器原生伪类，两者叠加确保按下的一瞬间用户一定能看到反馈 */
.btn-main-action:active {
  opacity: 0.8;
  transform: scale(0.97);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.btn-emoji-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
  /* emoji 字符自带色彩，不受按钮 color 影响，天然清晰可辨，
     用它代替之前 stroke 写死为白色、在白底/浅色底上完全隐形的 SVG 图标 */
}

/* 🌟 左右两个按钮做主次区分：生成餐报文本是流程首步、可反复重新生成校对，用白底红描边，
   视觉上更"轻"；生成公示海报是最终对外公示的产出物，用与全站 .btn-gold 一致的品牌金色实底
   渐变强调，作为这组操作的主 CTA，让用户一眼看出"这是最终要点的那个按钮" */
.text-gen-btn {
  background: #FFFFFF;
  color: #C62828;
  border: 2rpx solid #C62828;
  box-shadow: none;
}

.text-gen-btn:active {
  background: #FFF0ED;
}

.poster-gen-btn {
  background: linear-gradient(135deg, #B8860B 0%, #DAA520 100%);
  /* 🐛 修复严重对比度问题：金黄色底配白色文字几乎读不出字，改为深咖啡棕色——
     远比白色更符合"高亮金黄底 + 内敛深色字"的视觉规范，质感也更接近实体印章/证书配色 */
  color: #4A3200;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(184, 134, 11, 0.35);
}

.poster-gen-btn:active {
  opacity: 0.8;
  box-shadow: 0 2rpx 6rpx rgba(184, 134, 11, 0.2);
}

