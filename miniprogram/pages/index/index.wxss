  padding: 30rpx;
  border-top: 1rpx solid #eee;
}

.btn-close {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: #666;
  background-color: #f5f5f5;
  border: none;
  border-radius: 44rpx;
}

.btn-save {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: #fff;
  background: linear-gradient(135deg, #B8860B 0%, #DAA520 100%);
  border: none;
  border-radius: 44rpx;
}
.offline-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #FFF7E6 0%, #FFEBC8 100%);
  border-bottom: 2rpx solid #FFD666;
}

.offline-icon {
  font-size: 32rpx;
}

.offline-text {
  font-size: 26rpx;
  color: #D46B08;
}

.offline-action {
  font-size: 24rpx;
  color: #E53935;
  font-weight: bold;
}

.bottom-links-card {
  /* 主生成按钮已迁移到底部固定吸底的 .bottom-action-floating-bar；
     这里只剩意见反馈/协议链接，保持页面滚动内容末尾干净精简 */
  width: 100%;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.sub-btn-group {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.btn-sub {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  background-color: #F5F7FA;
  color: #4A5568;
  font-size: 26rpx;
  border-radius: 34rpx;
  border: none;
  padding: 0;
}

/* 吸底按钮组的高度占位，防止其遮挡滚动区域最后一块内容 */
.floating-bar-spacer {
  /* 🌟 加大到 180rpx，确保"意见反馈/用户服务协议"链接不会被下方固定吸底的
     生成餐报文本/生成公示海报双按钮遮挡（原 88rpx+48rpx=136rpx 余量偏紧） */
  height: calc(180rpx + env(safe-area-inset-bottom));
}

.btn-hover {
  opacity: 0.8;
  transform: scale(0.99);
  transition: all 0.1s ease;
}

.btn-disabled {
  opacity: 0.6 !important;
  pointer-events: none;
}

.agreement-tips {
  font-size: 20rpx;
  color: #A0AEC0;
  text-align: center;
  margin-top: 8rpx;
}

.agreement-tips .link {
  color: #4CAF50;
}

.report-result-card {
  width: 100%;
  box-sizing: border-box;
  background-color: #FFF5F5;
  border: 1rpx solid #FFE3E3;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.result-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}

.result-card-header .title {
  font-size: 30rpx;
  font-weight: 600;
  color: #D32F2F;
}

.result-card-header .toggle-icon {
  font-size: 26rpx;
  color: #666666;
}

.result-card-body {
  padding: 0 32rpx 28rpx 32rpx;
}

/* 实时算式校验高亮条 */
.math-proof-bar {
  background: #FFF8E1;
  border: 1rpx solid #FFE082;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  margin: 16rpx 0 24rpx 0;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  box-sizing: border-box;
}

.math-proof-bar .proof-label {
  font-size: 24rpx;
  font-weight: bold;
  color: #E65100;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.math-proof-bar .proof-val {
  font-size: 24rpx;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", sans-serif;
  font-weight: bold;
  color: #8C1D18;
  word-break: keep-all;
  white-space: nowrap;
}
.output-text {
  width: 100%;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-all;
  display: block;
  padding: 20rpx 0;
  text-align: left;
  box-sizing: border-box;
}

/* 🌟 生成结果预览里的爱心照片墙：之前这张卡片只有纯文字，上传的食谱/大事记照片
   完全没地方展示，围观餐报的人看不到当天的实景。两个区块各自 wx:if 独立控制，
   互不依赖——只上传了食谱照片也能正常展示，不会因为没有大事记照片而整段消失。 */
.result-photo-section {
  margin-top: 24rpx;
}

.result-photo-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #8C1D18;
  margin-bottom: 16rpx;
}

.result-photo-scroll {
  width: 100%;
  white-space: nowrap;
}

.result-photo-item {
  position: relative;
  display: inline-block;
  width: 200rpx;
  margin-right: 16rpx;
  vertical-align: top;
  white-space: normal;
}

.result-photo-img,
.result-photo-item .thumb-load-failed {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  border: 1.5rpx solid #EFE6D8;
}

.result-photo-name {
  display: block;
  width: 200rpx;
  margin-top: 8rpx;
  font-size: 20rpx;
  font-weight: bold;
  color: #333333;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 九宫格：固定 3 列，每格保持正方形，图片再多也整齐折行，不会挤成长条 */
.result-photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.result-photo-grid-item {
  position: relative;
  width: 100%;
  aspect-ratio: 1/1;
}

.result-photo-grid-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  border: 1.5rpx solid #EFE6D8;
}

.btn-copy {
  background-color: #388e3c;
  color: #fff;
  font-size: 28rpx;
  border-radius: 48rpx;
  padding: 20rpx 0;
  border: none;
  margin-top: 24rpx;
}

.agreement-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 650rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  max-height: 85vh;
}

.agreement-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.agreement-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #323233;
}

.close-icon {
  font-size: 40rpx;
  color: #909399;
  padding: 8rpx;
}

.agreement-body {
  max-height: 55vh;
  padding: 20rpx 30rpx;
  overflow-y: auto;
}

.section {
  margin-bottom: 16rpx;
}

.section-title {
  font-weight: bold;
  font-size: 28rpx;
  color: #2c3e50;
  margin-top: 24rpx;
  margin-bottom: 12rpx;
}

.section-title:first-child {
  margin-top: 0;
}

.section-text {
  font-size: 26rpx;
  color: #606266;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.bullet-item {
  font-size: 25rpx;
  color: #7f8c8d;
  line-height: 1.5;
  padding-left: 16rpx;
  margin-bottom: 6rpx;
}

.agreement-footer {
  padding: 24rpx 32rpx;
  border-top: 2rpx solid #f0f0f0;
}

.confirm-btn {
  display: block;
  width: 100%;
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: bold;
  color: #FFFFFF;
  background-color: #E53935;
  border: none;
  border-radius: 48rpx;
}

/* 平账原因确认弹窗 */
.adjust-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.adjust-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.adjust-content {
  position: relative;
  width: 80%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  z-index: 1001;
}

.adjust-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 16rpx;
}

.adjust-header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #303133;
}

.adjust-close {
  font-size: 32rpx;
  color: #909399;
  padding: 8rpx;
}

.adjust-body {
  padding: 16rpx 32rpx;
}

.adjust-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.adjust-info-label {
  color: #606266;
}

.adjust-info-value {
  color: #303133;
  font-weight: 500;
}

.adjust-diff {
  color: #e53935;
  font-weight: bold;
}

.adjust-divider {
  height: 2rpx;
  background: #ebeef5;
  margin: 16rpx 0;
}

.adjust-textarea-wrap {
  margin-top: 16rpx;
}

.adjust-textarea {
  width: 100%;
  min-height: 160rpx;
  max-height: 400rpx;
  border: 2rpx solid #dcdfe6;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  background: #f5f7fa;
  box-sizing: border-box;
}

.adjust-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx 32rpx;
}

.adjust-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
  margin: 0;
  padding: 0;
}

.adjust-btn.cancel {
  background: #f5f7fa;
  color: #606266;
}

.adjust-btn.danger {
  background: #e53935;
  color: #fff;
}

/* 小票识别确认弹窗 */
.ocr-confirm-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ocr-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.ocr-modal-card {
  position: relative;
  width: 88%;
  max-width: 640rpx;
  max-height: 78vh;
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  z-index: 1001;
  display: flex;
  flex-direction: column;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
}

.ocr-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 0 12rpx;
}

.ocr-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #303133;
}

.ocr-modal-close {
  font-size: 32rpx;
  color: #909399;
  padding: 8rpx;
}

.ocr-modal-subtitle {
  padding: 0 0 20rpx;
  font-size: 26rpx;
  color: #606266;
}

.ocr-modal-subtitle .ocr-total {
  color: #E67E22;
  font-weight: bold;
}

.ocr-modal-subtitle .ocr-fail-tip {
  color: #909399;
  margin-left: 8rpx;
}

/* 🌟 确认后预计结余实时预览：与顶部算式校验同一套配色语言(橙色结果强调)，
   放在小票列表上方，滚动查看明细时始终可见，不需要滚到底部才知道结果 */
.ocr-preview-banner {
  background: #FFF8E1;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.ocr-preview-banner .preview-header {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 8rpx;
}

.ocr-preview-banner .preview-header .title {
  font-size: 24rpx;
  color: #8C1D18;
  font-weight: bold;
}

.ocr-preview-banner .preview-formula {
  font-size: 26rpx;
  color: #E65100;
  font-weight: bold;
}

/* 🌟 原价小计/运费/优惠 结构化字段展示：与下方"实付合计"输入框区分开，
   小字号 + 灰底徽标风格，明确这几个是"识别到的过程数据"，不是可编辑的最终结论 */
.ocr-financial-breakdown {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.ocr-financial-breakdown .breakdown-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: #EDEFF1;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.ocr-financial-breakdown .breakdown-label {
  font-size: 22rpx;
  color: #909399;
}

.ocr-financial-breakdown .breakdown-val {
  font-size: 22rpx;
  color: #495057;
  font-weight: bold;
}

.ocr-financial-breakdown .breakdown-val.discount {
  color: #2E7D32;
}

.ocr-detail-container {
  flex: 1;
  padding: 0;
  overflow: hidden;
  max-height: 45vh;
  margin: 20rpx 0;
}

.ocr-receipt-block {
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  border: 1.5rpx solid transparent;
}

/* 🚨 低置信度/金额超阈值：整块用红色描边强化，与正常小票拉开区分 */
.ocr-receipt-block.has-warning {
  border-color: #FFCDD2;
  background: #FFF8F8;
}

/* 🌟 图文同屏对比：小票原图缩略展示在明细上方，点击原生放大 */
.ocr-receipt-image-wrap {
  position: relative;
  margin-bottom: 16rpx;
  border-radius: 10rpx;
  overflow: hidden;
  border: 1rpx solid #E9ECEF;
}

.ocr-receipt-image {
  width: 100%;
  max-height: 320rpx;
  display: block;
}

.ocr-receipt-image-hint {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  font-size: 18rpx;
  color: #FFFFFF;
  background: rgba(0, 0, 0, 0.45);
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.ocr-warning-banner {
  background: #FFEBEE;
  color: #C62828;
  font-size: 22rpx;
  font-weight: 500;
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.ocr-receipt-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx dashed #dee2e6;
}

.ocr-receipt-title .receipt-index {
  font-size: 24rpx;
  color: #fff;
  background: #F5A623;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.ocr-receipt-title .receipt-merchant {
  font-size: 26rpx;
  color: #495057;
  font-weight: 500;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

/* 🌟 实付合计人工覆盖行：单独一行，避免和商户名挤在标题行里，
   金额本身用可编辑 input 呈现，与下方逐条商品的编辑框保持同一视觉语言 */
.ocr-receipt-amount-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx dashed #dee2e6;
}

.amount-label {
  font-size: 26rpx;
  color: #495057;
  font-weight: 500;
  flex-shrink: 0;
}

.amount-edit-wrap {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.amount-edit-wrap.price-warning .input-receipt-amount {
  border-color: #E53935;
  border-width: 1.5rpx;
  background: #FFF5F5;
}

.amount-edit-wrap .symbol {
  font-size: 26rpx;
  font-weight: bold;
  color: #E65100;
  margin-right: 8rpx;
}

.input-receipt-amount {
  width: 160rpx;
  height: 64rpx;
  background: #F8F9FA;
  border: 1.5rpx solid #E65100;
  border-radius: 12rpx;
  padding: 0 12rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #E65100;
  text-align: right;
  flex-shrink: 0;
}

.manual-override-badge {
  font-size: 20rpx;
  color: #fff;
  background: #8C1D18;
  padding: 3rpx 12rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.ocr-item-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ocr-detail-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  font-size: 26rpx;
  margin-bottom: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.ocr-detail-row .bullet {
  font-size: 28rpx;
  color: #8C1D18;
  margin-right: 8rpx;
  flex-shrink: 0;
}

/* 🌟 疑似识别异常品名：红色描边高亮输入框本身，下方再掉行展示一条小字提示——
   .ocr-detail-row 已加 flex-wrap:wrap，这个提示条设 flex-basis:100% 会自动挤到独立一行，
   不影响没有异常标记的普通行的紧凑单行布局 */
.input-item-name.name-suspicious {
  border-color: #E53935;
  border-width: 1.5rpx;
  background: #FFF5F5;
}

.name-suspicious-badge {
  flex-basis: 100%;
  font-size: 20rpx;
  color: #E53935;
  margin: 4rpx 0 0 40rpx;
}

.input-item-name {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  background: #F8F9FA;
  border: 1rpx solid #E9ECEF;
  border-radius: 12rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  color: #333333;
}

.price-edit-wrap {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 🚨 低置信度/金额超阈值时，金额输入框改为红色边框预警 */
.price-edit-wrap.price-warning .input-item-price {
  border-color: #E53935;
  border-width: 1.5rpx;
  background: #FFF5F5;
}

.price-edit-wrap .symbol {
  font-size: 24rpx;
  font-weight: bold;
  color: #E65100;
  margin-right: 8rpx;
}

.input-item-price {
  width: 140rpx;
  height: 64rpx;
  background: #F8F9FA;
  border: 1rpx solid #E9ECEF;
  border-radius: 12rpx;
  padding: 0 12rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #E65100;
  text-align: right;
  flex-shrink: 0;
}

.ocr-detail-fallback {
  font-size: 26rpx;
  color: #6c757d;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.ocr-modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 0 0;
}

.ocr-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  font-size: 26rpx;
  text-align: center;
  border: none;
  margin: 0;
  padding: 0;
  font-weight: 500;
}

.ocr-btn.cancel {
  background: #f5f7fa;
  color: #606266;
}

.ocr-btn.adjust {
  background: #fff;
  color: #F5A623;
  border: 2rpx solid #F5A623;
}

.ocr-btn.confirm {
  background: linear-gradient(135deg, #F5A623 0%, #D97706 100%);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(245, 166, 35, 0.3);
}

.ocr-btn::after {
  border: none;
}

.balance-history-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.balance-history-modal-box {
  width: 100%;
  max-height: 75vh;
  background: #FFFFFF;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.modal-top-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F1F3F5;
}

.header-title-group {
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #212529;
}

.modal-sub-title {
  font-size: 22rpx;
  color: #868E96;
  margin-top: 4rpx;
}

.btn-close-modal {
  font-size: 36rpx;
  color: #ADB5BD;
  padding: 8rpx;
  line-height: 1;
}

.modal-history-scroll {
  max-height: 50vh;
  margin: 20rpx 0;
}

.history-balance-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #F8F9FA;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.history-balance-row.is-matched {
  background: #E6FCF5;
  border-color: #63E6BE;
}

.row-left-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}

.row-date-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.row-date-text {
  font-size: 26rpx;
  font-weight: bold;
  color: #212529;
}

.matched-badge {
  font-size: 18rpx;
  color: #0CA678;
  background-color: #D3F9D8;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
  font-weight: 500;
}

.row-formula-text {
  font-size: 20rpx;
  color: #868E96;
}

.row-right-action {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  margin-left: 16rpx;
}

.row-ending-balance {
  font-size: 28rpx;
  font-weight: bold;
  color: #2B8A3E;
}

.btn-apply-tag {
  font-size: 20rpx;
  color: #1C7ED6;
  background: #E7F5FF;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.empty-history-tip {
  text-align: center;
  padding: 48rpx;
  color: #868E96;
  font-size: 24rpx;
}

.modal-bottom-tip {
  font-size: 20rpx;
  color: #868E96;
  text-align: center;
  padding-top: 12rpx;
  border-top: 1rpx solid #F1F3F5;
}

/* 扫码绑定申请 Modal */
.apply-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.apply-modal-box {
  width: 85%;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
}

.apply-modal-box .modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F1F3F5;
  margin-bottom: 24rpx;
}

.apply-modal-box .modal-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #212529;
}

.apply-modal-box .btn-close {
  font-size: 36rpx;
  color: #ADB5BD;
  padding: 8rpx;
  line-height: 1;
}

.apply-form-body {
  margin-bottom: 20rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #495057;
  font-weight: 500;
  display: block;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 72rpx;
  background: #F8F9FA;
  border: 1rpx solid #DEE2E6;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.store-mode-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.store-mode-tab {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #666666;
  background: #F8F9FA;
  border: 1rpx solid #DEE2E6;
  border-radius: 12rpx;
  padding: 14rpx 0;
}

.store-mode-tab.active {
  background: #8C1D18;
  border-color: #8C1D18;
  color: #FFFFFF;
  font-weight: bold;
}

.form-hint {
  display: block;
  font-size: 22rpx;
  color: #C97B3D;
  margin-top: 10rpx;
}

.role-radio-group {
  display: flex;
  gap: 32rpx;
  padding: 12rpx 0;
}

.role-radio-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #495057;
}

.apply-modal-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.apply-modal-footer .btn-modal-cancel {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: #F1F3F5;
  color: #495057;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
}

.apply-modal-footer .btn-modal-submit {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: #1C7ED6;
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
}

/* 店长审核抽屉 Modal */
.audit-drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: flex-end;
  z-index: 1200;
}

.audit-drawer-box {
  width: 100%;
  max-height: 80vh;
  background: #FFFFFF;
  border-top-left-radius: 36rpx;
  border-top-right-radius: 36rpx;
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 修复重叠错位 Bug 的 Header 布局 */
.drawer-header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F1F3F5;
}

.header-title-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.header-title-box .header-icon {
  font-size: 34rpx;
}

.header-title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
}

.btn-close-drawer-circle {
  width: 56rpx;
  height: 56rpx;
  background-color: #F1F3F5;
  color: #495057;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: bold;
  transition: all 0.2s ease;
}

.btn-close-drawer-circle:active {
  background-color: #E9ECEF;
  color: #212529;
  transform: scale(0.92);
}

/* 双选项卡 Tab */
.audit-tab-segment {
  display: flex;
  background: #F8F9FA;
  border-radius: 16rpx;
  padding: 6rpx;
  margin: 20rpx 0;
}

.audit-tab-segment .tab-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #495057;
  padding: 14rpx 0;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.audit-tab-segment .tab-item.active {
  background: #FFFFFF;
  color: #D9480E;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 滚动列表区：🛡️ 修复底部被自定义 TabBar 遮挡——补上安全内边距，
   确保空状态的【生成邀请海报】按钮与卡片底部操作按钮完整可见、点击无阻碍 */
.drawer-content-scroll {
  max-height: 55vh;
  margin-top: 10rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 义工申请卡片 */
.audit-applicant-card {
  background: #FFFFFF;
  border: 1rpx solid #E9ECEF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
}

.audit-applicant-card.approved-card {
  background: #FAFBFC;
}

.card-top-info {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.applicant-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.applicant-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #212529;
}

.applicant-phone {
  font-size: 24rpx;
  color: #868E96;
}

/* 无手机号占位：与正常手机号保持同一行高，避免卡片高度参差不齐 */
.applicant-phone.unbound {
  color: #C7C7CC;
  font-style: italic;
}

.role-tag-badge {
  font-size: 20rpx;
  font-weight: bold;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.role-tag-badge.finance {
  background: #FFF3BF;
  color: #D9480E;
}

.role-tag-badge.volunteer {
  background: #E7F5FF;
  color: #1C7ED6;
}

.card-time-row {
  margin: 16rpx 0 20rpx 0;
}

.card-time-row .time-lbl {
  font-size: 22rpx;
  color: #ADB5BD;
}

.card-action-btns {
  display: flex;
  gap: 16rpx;
}

.btn-audit-act {
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 16rpx;
  padding: 14rpx 0;
  margin: 0;
  line-height: 1.4;
  border: none;
  transition: all 0.15s ease;
}

.btn-audit-act::after {
  border: none;
}

.btn-audit-act.reject {
  flex: 1;
  background: #FFF5F5;
  color: #E03131;
  border: 1rpx solid #FFC9C9;
}

.btn-audit-act.reject:active {
  background: #FFE3E3;
  transform: scale(0.98);
}

.btn-audit-act.approve {
  flex: 2;
  background: linear-gradient(180deg, #FFF9DB 0%, #FFE066 100%);
  color: #7A4D00;
  border: 1rpx solid #FCC419;
  box-shadow: 0 4rpx 12rpx rgba(252, 196, 25, 0.2);
}

.btn-audit-act.approve:active {
  background: linear-gradient(180deg, #FFE066 0%, #FCC419 100%);
  transform: scale(0.98);
}

/* 已绑定义工卡片：修改角色 / 解除绑定 */
.audit-applicant-card.approved-card .card-action-btns {
  margin-top: 20rpx;
}

.btn-audit-act.change-role {
  flex: 1;
  background: #E7F5FF;
  color: #1C7ED6;
  border: 1rpx solid #A5D8FF;
}

.btn-audit-act.change-role:active {
  background: #D0EBFF;
  transform: scale(0.98);
}

.btn-audit-act.unbind {
  flex: 1;
  background: #FFF5F5;
  color: #E03131;
  border: 1rpx solid #FFC9C9;
}

.btn-audit-act.unbind:active {
  background: #FFE3E3;
  transform: scale(0.98);
}

/* 温馨空状态：修复图标与文字重叠、拉开与底部按钮的间距；容器顶部额外留白避免贴着 Tab 栏 */
.warm-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40rpx;
  padding: 40rpx 20rpx;
  text-align: center;
}

.empty-emoji-icon {
  width: 72rpx;
  height: 72rpx;
  margin-top: 8rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
  line-height: 1.6;
  /* 全国视角下 empty-desc 不渲染，标题直接接按钮；段落间距统一保持 30rpx 以上 */
  margin-bottom: 30rpx;
}

.empty-desc {
  font-size: 22rpx;
  color: #868E96;
  margin: 12rpx 0 40rpx 0;
  max-width: 80%;
  line-height: 1.6;
}

.btn-empty-invite {
  background: #FFF3BF;
  color: #D9480E;
  border: 1rpx solid #FFE066;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 30rpx;
  padding: 12rpx 36rpx;
  margin: 0;
  transition: all 0.15s ease;
}

.btn-empty-invite::after {
  border: none;
}

.btn-empty-invite:active {
  background: #FFE066;
  transform: scale(0.98);
}

/* 🌟 C位核心卡片：欢迎语+护持统计+打卡 CTA，置于胶囊下方最顶部，独立于滚动区之外，
   确保永远是志工视角下第一眼看到的内容，不被公告栏/食谱大事记预览卡挤到后面 */
.volunteer-hero-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  margin: 24rpx 24rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.volunteer-view-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  margin: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.volunteer-hero-card .v-header {
  text-align: center;
  margin-bottom: 20rpx;
}

.volunteer-hero-card .v-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #8C1D18;
  margin-bottom: 12rpx;
}

.volunteer-hero-card .v-sub {
  font-size: 26rpx;
  color: #8C7355;
}

.volunteer-hero-card .volunteer-stats-banner {
  background: linear-gradient(135deg, #FFFDF8 0%, #FFF5EB 100%);
  border: 1rpx solid #FFE0B2;
  border-radius: 16rpx;
  padding: 16rpx 16rpx 0;
  margin: 16rpx 0 20rpx 0;
  transition: opacity 0.15s ease;
}

/* 🛡️ 明确的触控反馈：整卡可点击，按下时轻微变暗，与其余胶囊按钮的 :active 手感保持一致 */
.volunteer-hero-card .volunteer-stats-banner-hover {
  opacity: 0.75;
}

.volunteer-hero-card .volunteer-stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.volunteer-hero-card .stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 🌟 核心荣誉数字：34rpx -> 48rpx 加粗放大，提升志工的归属感与荣誉感 */
.volunteer-hero-card .stat-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #E65100;
  line-height: 1.2;
}

.volunteer-hero-card .stat-label {
  font-size: 20rpx;
  color: #8D6E63;
  margin-top: 4rpx;
}

.volunteer-hero-card .stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #FFE0B2;
}

/* 🌸 温情激励语：置于统计数字下方，强化"我在被看见、被感恩"的情感连接 */
.volunteer-hero-card .warm-encourage-text {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #C97B3D;
  margin-top: 12rpx;
  line-height: 1.5;
}
/* 🍚 今日餐况状态卡：开餐状态 + 主食物资合并展示，用胶囊 Tag 呈现代替纯文字 */
.volunteer-view-card .today-status-card {
  background: #FFFDF8;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 20rpx;
}

.volunteer-view-card .tsc-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.volunteer-view-card .tsc-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #444444;
}

.volunteer-view-card .tsc-date {
  font-size: 22rpx;
  color: #999999;
}

.volunteer-view-card .tsc-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F2E9D8;
}

.volunteer-view-card .tsc-row:last-child {
  border-bottom: none;
}

.volunteer-view-card .tsc-label {
  font-size: 26rpx;
  color: #666666;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.volunteer-view-card .tsc-tag {
  font-size: 22rpx;
  font-weight: bold;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

/* 🌟 与 .status-pill（店长/财务设置物资状态用的选择胶囊）统一同一套色值，
   同一个"充足/一般/告急"概念在两处（管理端选择器 / 志工端展示标签）视觉一致 */
.volunteer-view-card .tsc-tag.tag-success {
  background: #E6F4EA;
  color: #137333;
}

.volunteer-view-card .tsc-tag.tag-warning {
  background: #FEF7E0;
  color: #B06000;
}

.volunteer-view-card .tsc-tag.tag-danger {
  background: #FFF2F0;
  color: #FF4D4F;
  border: 1rpx solid #FFA39E;
}

/* 🌟 物资护持交互联动：大米/食用油两行从纯展示升级为可点击，箭头给出明确的"可点击"提示，
   点击态轻微变色反馈，不需要额外的按钮就能表达"这里能点" */
.volunteer-view-card .tsc-row-tappable {
  transition: background-color 0.15s ease;
}

.volunteer-view-card .tsc-row-tappable:active {
  background-color: #FFF8ED;
}

.volunteer-view-card .tsc-tag-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* 🌟 智能物资引导跳转入口：小胶囊按钮，非满仓状态下才出现，
   与旁边的状态标签保持同一行但视觉上更主动、更像"可以点的行动号召" */
.volunteer-view-card .action-link {
  font-size: 20rpx;
  font-weight: bold;
  color: #8C1D18;
  background: #FFF3E0;
  border: 1rpx solid #FFCC80;
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
  white-space: nowrap;
}

.volunteer-view-card .action-link:active {
  opacity: 0.75;
}

.volunteer-view-card .tsc-row-arrow {
  font-size: 22rpx;
  color: #C7C7CC;
}

/* 🍱📌 食谱/大事记精简摘要行：单行文字，未发布时直接显示"尚未发布"，
   取代此前独立的大预览卡片，避免空卡片强行占用纵向空间 */
.volunteer-view-card .tsc-summary-row {
  padding: 12rpx 0 0;
  margin-top: 8rpx;
  border-top: 1rpx dashed #F2E9D8;
}

.volunteer-view-card .tsc-summary-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

/* 🌟 今日食谱动态卡片：能拆出结构化菜品名时，用小标签云替代纯文本单行，
   一眼能看清今天做了哪些菜，比一整行可能被截断的长文本更直观 */
.volunteer-view-card .tsc-menu-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.volunteer-view-card .tsc-menu-label {
  overflow: visible;
  white-space: normal;
}

.volunteer-view-card .tsc-dish-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.volunteer-view-card .tsc-dish-chip {
  font-size: 22rpx;
  color: #8C1D18;
  background: #FFF3E0;
  border: 1rpx solid #FFE0B2;
  border-radius: 16rpx;
  padding: 6rpx 16rpx;
}

.volunteer-hero-card .v-action-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  /* 任务C：高亮动画的过渡基础 */
  transition: box-shadow 0.3s ease, background-color 0.3s ease, transform 0.3s ease;
  border-radius: 24rpx;
  /* 🛡️ 打卡卡片精简后只剩主按钮一个子元素，加大上下内边距让按钮在卡片内
     更居中、大方醒目，不再贴着服务历程/公开账本链接的位置显得局促 */
  padding: 28rpx 4rpx;
}

/* ===== 任务C：highlight-pulse 金色/红色呼吸闪烁动画（持续2秒） ===== */
.volunteer-hero-card .v-action-box.highlight-pulse {
  animation: highlightPulse 2s ease-in-out 1;
  /* 兜底光晕（动画失败时也能看出高亮） */
  box-shadow: 0 0 24rpx 8rpx rgba(245, 166, 35, 0.6);
  background-color: rgba(245, 166, 35, 0.08);
}

@keyframes highlightPulse {
  0% {
    box-shadow: 0 0 0 0 rgba(245, 166, 35, 0);
    background-color: transparent;
    transform: scale(1);
  }
  15% {
    /* 第一次金色脉冲 */
    box-shadow: 0 0 32rpx 12rpx rgba(245, 166, 35, 0.85);
    background-color: rgba(245, 166, 35, 0.15);
    transform: scale(1.02);
  }
  30% {
    box-shadow: 0 0 16rpx 6rpx rgba(245, 166, 35, 0.3);
    background-color: rgba(245, 166, 35, 0.04);
    transform: scale(1);
  }
  50% {
    /* 第二次红色脉冲（呼应雨花斋品牌色 #8C1D18） */
    box-shadow: 0 0 32rpx 12rpx rgba(140, 29, 24, 0.7);
    background-color: rgba(140, 29, 24, 0.1);
    transform: scale(1.02);
  }
  70% {
    box-shadow: 0 0 16rpx 6rpx rgba(140, 29, 24, 0.25);
    background-color: rgba(140, 29, 24, 0.03);
    transform: scale(1);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(245, 166, 35, 0);
    background-color: transparent;
    transform: scale(1);
  }
}
/* 🌟 第一核心操作 CTA：加大字号、加深阴影，未打卡状态额外用金色描边提醒 */
.volunteer-hero-card .btn-volunteer-checkin {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #8C1D18;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 48rpx;
  padding: 0;
  margin: 0;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(140, 29, 24, 0.28);
  transition: box-shadow 0.2s ease, transform 0.2s ease, background 0.2s ease;
}

.volunteer-hero-card .btn-volunteer-checkin::after {
  border: none;
}

.volunteer-hero-card .btn-volunteer-checkin:active {
  background: #6D1410;
  transform: scale(0.98);
}

/* 未打卡：金色描边 + 更强阴影，作为页面最醒目的行动点 */
.volunteer-hero-card .btn-volunteer-checkin.state-pending {
  border: 2rpx solid #F5A623;
  box-shadow: 0 8rpx 24rpx rgba(245, 166, 35, 0.4);
}

/* 已打卡部分班次：正常品牌色，鼓励继续 */
.volunteer-hero-card .btn-volunteer-checkin.state-partial {
  background: #A8281F;
}

/* 今日全部班次已完成：切换为沉稳的成功绿，弱化 CTA 紧迫感 */
.volunteer-hero-card .btn-volunteer-checkin.state-done {
  background: linear-gradient(135deg, #2E7D32 0%, #1B5E20 100%);
  box-shadow: 0 8rpx 20rpx rgba(46, 125, 50, 0.28);
}

