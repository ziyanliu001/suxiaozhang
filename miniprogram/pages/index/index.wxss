/* 固定尺寸的正方形容器：无论真实二维码/加载中/失败占位，尺寸恒定，避免右侧文字随之抖动 */
.qr-img-wrapper {
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  padding: 6rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.sun-code-real-img {
  width: 100%;
  height: 100%;
  border-radius: 6rpx;
}

.qr-loading-box {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qr-loading-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid #F0E8DD;
  border-top-color: #8C1D18;
  border-radius: 50%;
  animation: qr-spin 0.8s linear infinite;
}

@keyframes qr-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
.qr-fallback-box {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
