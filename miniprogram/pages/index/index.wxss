}

.invite-result-copy-btn:active {
  background: #FFF3E0;
  transform: scale(0.96);
}

.invite-result-qr-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.invite-result-qr-img {
  width: 320rpx;
  height: 320rpx;
  border-radius: 16rpx;
  border: 1.5rpx solid #EFE6D8;
