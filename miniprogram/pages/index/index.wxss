}

.qr-fallback-text {
  font-size: 16rpx;
  color: #999999;
  margin-top: 4rpx;
}

.qr-right-text {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.p-app-name {
  font-size: 24rpx;
  font-weight: bold;
  color: #222222;
}

.p-qr-tip {
  font-size: 20rpx;
  color: #8C1D18;
  margin-top: 6rpx;
}

.poster-modal-footer {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.btn-cancel-p {
  flex: 1;
  background: #F8F9FA;
  color: #666666;
  border-radius: 40rpx;
  font-size: 26rpx;
  border: none;
}

.btn-cancel-p::after {
  border: none;
}

.btn-share-p {
  flex: 1.8;
  background: #07C160;
  color: #FFFFFF;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-share-p::after {
  border: none;
}

