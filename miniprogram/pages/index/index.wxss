@charset "UTF-8";
page {
  background-color: #f8f9fa;
  height: 100vh;
}

.index-page-container {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  background-color: #F8F9FA;
  box-sizing: border-box;
  /* 自定义导航栏（navigationStyle: custom）下，页面顶部内容需自行避让胶囊按钮/刘海安全区。
     env(safe-area-inset-top) 只覆盖刘海/状态栏高度，胶囊按钮本身还有额外高度，
     单靠 env() 不够，故强制再叠加 80rpx 兜底，与 headerSafeTop 的动态胶囊测算共同生效，
     确保首屏渲染早于 JS 测算完成时内容也不会被遮挡 */
  padding-top: calc(env(safe-area-inset-top) + 80rpx) !important;
  /* 🛡️ 非义工视角（店长/财务/超管）在 .page-body-scroll 之外还叠了打卡卡片/店长工作台/
     财务稽核台/管理宫格/空机构建店引导卡（"该机构已有 N 家门店"）等一整段非滚动区
     内容，矮屏设备上这段总高度可能超出 100vh，导致页面本体（而非内部 page-body-scroll）
     整体上滚，此时底部固定吸底双按钮栏仍会盖住刚露出的这段内容。
     🐛 之前这里写死 180rpx，比 .bottom-action-floating-bar 注释里算好的
     "三段式 TabBar（100rpx）+ 吸底双按钮组（136rpx）= 236rpx" 还少 56rpx，且完全没算
     底部安全区，iPhone 类全面屏机型上"该机构已有 N 家门店"卡片的按钮实测仍被压住——
     改为与 .page-body-scroll 同一份 236rpx + 安全区计算，两处不再各算一套 */
  padding-bottom: calc(236rpx + constant(safe-area-inset-bottom)) !important;
  padding-bottom: calc(236rpx + env(safe-area-inset-bottom)) !important;
}

.app-header-section {
  background-color: #FFFFFF;
  width: 100%;
  box-sizing: border-box;
  padding-bottom: 24rpx;
  flex-shrink: 0;
}

.page-body-scroll {
  flex: 1;
  width: 100%;
  /* 底部同时叠着两层固定元素：三段式 TabBar（100rpx）+ 吸底双按钮组 .bottom-action-floating-bar
     （bottom: 100rpx 起，自身高度 24+88+24=136rpx），两者共占 236rpx，
     padding-bottom 必须盖过这个总高度，否则滚到底部时"意见反馈"/协议链接仍会被按钮组压住 */
  padding: 24rpx 24rpx calc(236rpx + env(safe-area-inset-bottom)) 24rpx;
  box-sizing: border-box;
}

