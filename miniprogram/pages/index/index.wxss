  font-weight: bold;
  color: #333333;
}

.p-grid-2x2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.grid-cell {
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 12rpx;
  padding: 16rpx 12rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
}

.grid-cell.highlight-cell {
  background: #FFFDF8;
  border-color: #FFE0B2;
}

.cell-label {
  font-size: 20rpx;
  color: #888888;
}

.cell-val {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-top: 6rpx;
  word-break: break-all;
}

.cell-val.primary-red {
  color: #8C1D18;
}

.cell-val.gold-color {
  color: #E65100;
  font-size: 30rpx;
}

.cell-val.mute-color {
  color: #666666;
}

.cell-sub {
  font-size: 18rpx;
  color: #999999;
  margin-top: 2rpx;
}

.p-status-row-group {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.p-status-chip {
  font-size: 22rpx;
  color: #555555;
}

.p-status-chip .val.green {
  color: #2E7D32;
  font-weight: bold;
}

.p-quote-box {
  background: #FFF5EB;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.quote-text {
  font-size: 22rpx;
  color: #E65100;
  font-style: italic;
  line-height: 1.5;
}

/* 🙏 打卡成功修身提醒：雨花敬老行为准则【十个有没有】，2 列栅格，轻柔不抢主视觉 */
.p-tenhaveyou-box {
  background: #FFF9F0;
  border: 1rpx solid #FFE8CC;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.p-tenhaveyou-title {
  display: block;
  font-size: 22rpx;
  font-weight: bold;
  color: #B45309;
  text-align: center;
  margin-bottom: 12rpx;
}

.p-tenhaveyou-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx 12rpx;
}

.p-tenhaveyou-item {
  font-size: 20rpx;
  color: #5C4326;
  line-height: 1.6;
}

.p-footer-qr-row {
  display: flex;
  align-items: center;
  border-top: 1rpx dashed #E6DCCD;
  padding-top: 20rpx;
  margin-top: 16rpx;
}

/* 固定尺寸的正方形容器：无论真实二维码/加载中/失败占位，尺寸恒定，避免右侧文字随之抖动 */
.qr-img-wrapper {
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  padding: 6rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.sun-code-real-img {
  width: 100%;
  height: 100%;
  border-radius: 6rpx;
}

.qr-loading-box {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qr-loading-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid #F0E8DD;
  border-top-color: #8C1D18;
  border-radius: 50%;
  animation: qr-spin 0.8s linear infinite;
}

@keyframes qr-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
.qr-fallback-box {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FAFAFA;
  border-radius: 6rpx;
}

.qr-fallback-icon {
  font-size: 24rpx;
  color: #BBBBBB;
  line-height: 1;
}

.qr-fallback-text {
  font-size: 16rpx;
  color: #999999;
  margin-top: 4rpx;
}

.qr-right-text {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.p-app-name {
  font-size: 24rpx;
  font-weight: bold;
  color: #222222;
}

.p-qr-tip {
  font-size: 20rpx;
  color: #8C1D18;
  margin-top: 6rpx;
}

.poster-modal-footer {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.btn-cancel-p {
  flex: 1;
  background: #F8F9FA;
  color: #666666;
  border-radius: 40rpx;
  font-size: 26rpx;
  border: none;
}

.btn-cancel-p::after {
  border: none;
}

.btn-share-p {
  flex: 1.8;
  background: #07C160;
  color: #FFFFFF;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-share-p::after {
  border: none;
}

