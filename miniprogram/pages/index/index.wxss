}

.tag-btn-capsule.gray-theme {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background-color: #F1F3F5;
  color: #495057;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.tag-btn-capsule.gray-theme .icon {
  font-size: 22rpx;
}

.tag-btn-capsule.gray-theme .lbl {
  font-size: 22rpx;
}

.btn-help-capsule {
  background-color: #F1F3F5;
  color: #495057;
