  font-weight: 600;
  color: #212529;
  display: flex;
  align-items: center;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 🌟 三颗按钮（计入成本标签 / 常用项目 / 拍照识别）统一视觉规范：同高、同 padding、
   同圆角（8-12rpx，不再是胶囊形）、同图标文字间距，让它们在 header-action-row 里
   看起来是同一组按钮，而不是三种各自不同的样式拼凑在一起 */
.box-header .tag,
.btn-expense-template-pill,
.btn-scan-receipt-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  box-sizing: border-box;
  white-space: nowrap;
  /* 细微上方内阴影（模拟轻微凹陷高光）+ 下方投影，提升按钮的实体感 */
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.5), 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
}

.box-header .tag {
  font-size: 20rpx;
  font-weight: 500;
  color: #1C7ED6;
  background: #E7F5FF;
}

.box-header .tag.warm {
  color: #D9480E;
  background: #FFF3BF;
}

.header-action-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 拍照识别：浅红底 + 红色相机图标，与「计入成本/常用项目」的蓝/黄区分开，
   同时呼应全站品牌红（#8C1D18 系），比原本的蓝色主题更醒目 */
.btn-scan-receipt-pill {
  background: #FFF2F0;
  border: 1rpx solid #FFCCC7;
  color: #C5221F;
  transition: all 0.2s ease;
}

.btn-scan-receipt-hover {
  background: #FFCCC7;
  transform: scale(0.96);
}

.btn-scan-receipt-pill .icon {
  width: 22rpx;
  height: 22rpx;
}

.btn-scan-receipt-pill .lbl {
  font-size: 20rpx;
  font-weight: bold;
  line-height: 1;
}

.btn-expense-template-pill {
  background: #FFF3BF;
  border: 1rpx solid #FFE066;
  color: #D9480E;
  transition: all 0.2s ease;
}

.btn-expense-template-hover {
  background: #FFE066;
  transform: scale(0.96);
}

.btn-expense-template-pill .lbl {
  font-size: 20rpx;
  font-weight: bold;
  line-height: 1;
}

.btn-expense-template-pill .lbl {
  font-size: 20rpx;
  font-weight: bold;
}

.expense-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #FDFBF7;
  border: 1rpx solid #EFE6D8;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
  line-height: 1.6;
}

.expense-textarea.warm-bg {
  background: #FFFDF5;
  border-color: #FFE066;
}

.expense-textarea.activity-text-spacing {
  min-height: 100rpx;
  margin-bottom: 16rpx;
}

.expense-parse-preview {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #D9480E;
  font-weight: bold;
  background: #FFF3BF;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  width: fit-content;
}

/* 🔒 大额专项：逐条添加 + 行级独立凭证 */
.fixed-expense-add-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.fixed-expense-empty {
  padding: 32rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #ADB5BD;
  line-height: 1.6;
  background: #FFFDF5;
  border: 1rpx dashed #FFE066;
  border-radius: 16rpx;
}

.fixed-expense-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.fixed-expense-item {
  background: #FFFDF5;
  border: 1rpx solid #FFE066;
  border-radius: 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.fixed-expense-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  flex-wrap: wrap;
}

/* 左区：项目名称 + 金额，作为一组视觉整体 */
.fe-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.fe-name {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fe-amount-box {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #E0E0E0;
  border-radius: 10rpx;
  padding: 0 12rpx;
  flex-shrink: 0;
}

.fe-currency {
  font-size: 24rpx;
  color: #D9480E;
}

.fe-amount-input {
  width: 100rpx;
  height: 60rpx;
  font-size: 26rpx;
  color: #D9480E;
  font-weight: bold;
  text-align: right;
}

/* 右区：独立凭证按钮 + 删除，作为另一组视觉整体，与左区拉开距离避免拥挤 */
.fe-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.fe-voucher-btn {
  display: flex;
  align-items: center;
  min-height: 44px; /* 触控热区 ≥44pt，与其余操作按钮口径一致 */
  padding: 0 16rpx;
  background: #F1F3F5;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.fe-voucher-btn.has-voucher {
  background: #E7F5FF;
}

.fe-voucher-btn .lbl {
  font-size: 20rpx;
  color: #495057;
  font-weight: bold;
  white-space: nowrap;
}

.fe-voucher-btn.has-voucher .lbl {
  color: #1C7ED6;
}

.fe-del {
  color: #E03131;
  font-size: 24rpx;
  font-weight: bold;
  padding: 8rpx;
  flex-shrink: 0;
}

.fe-voucher-grid {
  margin-top: 16rpx;
}

/* 凭证上传：紧凑化上下间距，提升屏高利用率 */
.receipt-upload-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 16rpx 16rpx;
  margin-top: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.section-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  position: relative;
}

.sec-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.sec-icon-emoji {
  font-size: 28rpx;
  margin-right: 8rpx;
  line-height: 1;
}

.sec-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
}

.sec-sub-tip {
  font-size: 22rpx;
  color: #888888;
  margin-left: 8rpx;
}

/* 默认（0 张）为中性灰，避免还没上传就先高亮；有图后才切主色调加粗，见 .has-count */
.upload-counter {
  position: absolute;
  right: 10rpx;
  font-size: 22rpx;
  font-weight: normal;
  color: #999999;
  background: #F2F4F7;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  transition: all 0.2s ease;
}

.upload-counter.has-count {
  font-size: 24rpx;
  font-weight: bold;
  color: #D92D20;
  background: #FEF3F2;
}

.upload-counter.counter-full {
  color: #FFFFFF;
  background: #D92D20;
}

.receipt-grid-container {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.grid-image-item {
  position: relative;
  width: 100%;
  padding-top: 100%;
  border-radius: 16rpx;
  overflow: visible;
}

.grid-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  border: 1.5rpx solid #EFE6D8;
}

/* 🛡️ 缩略图加载失败兜底：<image> binderror 时替换成这个占位块，而不是放任小程序
   原生裂图图标晾在原地——覆盖 receiptImages/independent_image_urls/recipeImages/
   activityImages 所有网格入口，同一个视觉语言，点击可重试 */
.thumb-load-failed {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border-radius: 16rpx;
  background: #F5F5F5;
  border: 1.5rpx dashed #D9D9D9;
}

.thumb-load-failed-icon {
  font-size: 28rpx;
  line-height: 1;
}

.thumb-load-failed-text {
  font-size: 18rpx;
  color: #999999;
}

.img-delete-badge {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 38rpx;
  height: 38rpx;
  background: rgba(211, 47, 47, 0.95);
  color: #FFFFFF;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.15);
}

.grid-add-btn {
  background: #FAF8F5;
  border: 2.5rpx dashed #C8B195;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  aspect-ratio: 1/1;
}

.grid-add-btn .add-icon {
  font-size: 40rpx;
  color: #8C1D18;
  line-height: 1;
  font-weight: 300;
}

.grid-add-btn .add-txt {
  font-size: 18rpx;
  color: #8C1D18;
  margin-top: 4rpx;
}

/* 🍱 今日食谱照片：3 列九宫格菜品卡片（实拍图 + 菜名输入框），与
   pages/daily-menu 食谱管理页的 .dm-image-grid 展示态同款布局与配色，
   保证首页随手拍的食谱和食谱管理页看起来是同一套视觉语言 */
.recipe-dish-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.recipe-dish-item {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.recipe-dish-img-wrap {
  position: relative;
  width: 100%;
  padding-top: 100%;
  border-radius: 16rpx;
  overflow: visible;
}

.recipe-dish-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  border: 1.5rpx solid #EFE6D8;
}

.recipe-dish-name-input {
  margin-top: 8rpx;
  height: 52rpx;
  line-height: 52rpx;
  font-size: 22rpx;
  color: #333333;
  text-align: center;
  background: #FAF8F5;
  border: 1.5rpx solid #EFE6D8;
  border-radius: 10rpx;
  box-sizing: border-box;
}

/* 边框/图标规格与 .grid-add-btn 统一（支出凭证/大事记网格同款虚线框） */
.recipe-dish-add {
  position: relative;
  width: 100%;
  padding-top: 100%;
  background: #FAF8F5;
  border: 2.5rpx dashed #C8B195;
  border-radius: 16rpx;
}

.recipe-dish-add .add-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -70%);
  font-size: 40rpx;
  color: #8C1D18;
  line-height: 1;
  font-weight: 300;
}

.recipe-dish-add .add-txt {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, 40%);
  font-size: 18rpx;
  color: #8C1D18;
  white-space: nowrap;
}

.upload-guide-text {
  font-size: 20rpx;
  color: #E65100;
  background: #FFF3E0;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  line-height: 1.4;
  margin-top: 12rpx;
}

