  padding: 28rpx 32rpx;
  /* base = good_news 主题；各 type-* 子类覆盖背景与边框色 */
  background: linear-gradient(135deg, #FFF7F0 0%, #FFEBE0 100%);
  border-bottom: 2rpx solid #FFD4B8;
}

/* ── 通知类型主题：停业/维护 ── */
.announcement-modal-header.type-closure {
  background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
  border-bottom-color: #FDE68A;
}
.announcement-modal-header.type-closure .announcement-modal-tag { color: #d97706; }

/* ── 通知类型主题：喜讯通报（覆盖保证显式） ── */
.announcement-modal-header.type-good_news {
  background: linear-gradient(135deg, #FFF7F0 0%, #FFEBE0 100%);
  border-bottom-color: #FFD4B8;
}
.announcement-modal-header.type-good_news .announcement-modal-tag { color: #E53935; }

/* ── 通知类型主题：紧急通知 ── */
.announcement-modal-header.type-urgent {
  background: linear-gradient(135deg, #FFF5F5 0%, #FEE2E2 100%);
  border-bottom-color: #FECACA;
}
.announcement-modal-header.type-urgent .announcement-modal-tag { color: #dc2626; }

/* ── 通知类型主题：感恩鸣谢 ── */
.announcement-modal-header.type-thanks {
  background: linear-gradient(135deg, #FFF0F3 0%, #FFDEEB 100%);
  border-bottom-color: #FFC9DE;
}
.announcement-modal-header.type-thanks .announcement-modal-tag { color: #C2255C; }

/* ── 通知类型主题：日常公告 ── */
.announcement-modal-header.type-general {
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  border-bottom-color: #BFDBFE;
}
.announcement-modal-header.type-general .announcement-modal-tag { color: #2563eb; }

.announcement-modal-tag {
  font-size: 32rpx;
  font-weight: bold;
  color: #E53935;
}

.announcement-modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.announcement-modal-close .close-icon {
  font-size: 48rpx;
  color: #969799;
  line-height: 1;
}

.announcement-modal-body {
  flex: 1;
  min-height: 0;
  padding: 36rpx 40rpx 24rpx 40rpx;
  overflow-y: auto;
  box-sizing: border-box;
  text-align: center;
}

.announcement-modal-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #222222;
  margin-bottom: 16rpx;
  line-height: 1.6;
  text-align: center;
}

.announcement-modal-date {
  display: block;
  font-size: 24rpx;
  color: #868E96;
  margin-bottom: 28rpx;
  text-align: center;
}

.announcement-modal-text {
  display: block;
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
  text-align: center;
}

.announcement-modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
  background-color: #f7f8fa;
}

.announcement-modal-btn {
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 38rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
}

.announcement-modal-btn.edit-btn {
  flex: 1;
  background: #FFF5F5;
  color: #E03131;
  border: 1rpx solid #FFC9C9;
}

.announcement-modal-btn.copy-btn {
  flex: 1.8;
  background: linear-gradient(135deg, #FF922B, #F59F00);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(245, 166, 35, 0.3);
}

.announcement-modal-btn.close-btn {
  flex: 1;
  background-color: #F1F3F5;
  color: #495057;
}

/* ═══════════════════════════════════════════════════════════════
   ✍️ 编辑通报内容弹窗：卡片式布局，严格左对齐，浅灰底输入框
   ═══════════════════════════════════════════════════════════════ */

.notice-edit-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1001;
  display: flex;
  align-items: flex-end;
}

.notice-edit-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
}

.notice-edit-content {
  position: relative;
  width: 100%;
  max-height: 85vh;
  background-color: #F7F8FA;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.notice-edit-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #FFF7F0 0%, #FFEBE0 100%);
  border-bottom: 2rpx solid #FFD4B8;
}

.notice-edit-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #323233;
}

.notice-edit-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.notice-edit-close .close-icon {
  font-size: 48rpx;
  color: #969799;
  line-height: 1;
}

.notice-edit-body {
  flex: 1;
  padding: 24rpx 24rpx 12rpx;
  overflow-y: auto;
}

/* 卡片式分区：摒弃硬边框网格，用白底圆角+柔和阴影代替边框分隔，
   内边距统一加大提升呼吸感 */
.notice-edit-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
  text-align: left;
}

.notice-edit-label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #323233;
  text-align: left;
}

.notice-edit-label-sub {
  display: block;
  font-size: 22rpx;
  color: #ADB5BD;
  text-align: left;
  margin-top: 4rpx;
  margin-bottom: 18rpx;
}

.notice-edit-input {
  width: 100%;
  height: 88rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  background-color: #F7F8FA;
  border-radius: 16rpx;
  border: none;
  box-sizing: border-box;
  margin-top: 16rpx;
  text-align: left;
}

/* 正文输入区：外层浅灰圆角容器内边距 20rpx，底部工具行放清空按钮 +
   字数统计，两者都不再绝对定位盖在文字上（原实现用 absolute 贴在
   右下角，长文本时会跟最后一行文字重叠） */
.textarea-box-container {
  width: 100%;
  box-sizing: border-box;
  background: #F7F8FA;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}

.notice-edit-textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #323233;
  background-color: transparent;
}

.textarea-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #EDEFF2;
}

.textarea-toolbar-spacer {
  flex: 1;
}

/* 清空按钮：红色高亮提示误操作风险，紧贴正文框内底部而非悬浮在标题行 */
.clear-btn-inline {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 18rpx;
  background-color: #FFF5F5;
  border-radius: 24rpx;
}

.clear-btn-inline text {
  font-size: 24rpx;
  color: #E03131;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
}

.char-count-tag {
  font-size: 22rpx;
  color: #ADB5BD;
  flex-shrink: 0;
}

/* 常用场景一键套用：3 列网格，标签式圆角小卡片 */
.preset-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.preset-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 16rpx 8rpx;
  font-size: 24rpx;
  color: #D9480E;
  background-color: #FFF9DB;
  border-radius: 16rpx;
  transition: transform 0.15s;
}

.preset-tag text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preset-tag.warning {
  color: #E03131;
  background-color: #FFF5F5;
}

.preset-tag:active {
  transform: scale(0.95);
}

/* 我的模板库：条数不固定、标题长短不一，改用横向滚动标签栏 */
.preset-scroll-row {
  width: 100%;
  white-space: nowrap;
}

.preset-scroll-row .preset-tag {
  display: inline-flex;
  width: auto;
  margin-right: 12rpx;
}

/* 🌟 云端模板标签：与内置 7 条预设文案的 .preset-tag 同款外观，
   多一个左侧【公共】/【本店】小徽章区分模板来源 */
.preset-tag.template-tag {
  color: #2B8A3E;
  background-color: #EBFBEE;
  padding-left: 20rpx;
  padding-right: 20rpx;
}

.template-badge {
  flex-shrink: 0;
  font-size: 18rpx;
  font-weight: bold;
  padding: 2rpx 10rpx;
  border-radius: 16rpx;
  line-height: 1.6;
}

.template-badge.badge-system {
  color: #FFFFFF;
  background-color: #F08C00;
}

.template-badge.badge-store {
  color: #FFFFFF;
  background-color: #2B8A3E;
}

/* 合并选项条：卡片内的开关行，用于超管专属的"设为全域公共模板" */
.merge-option-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.merge-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding-right: 20rpx;
}

.merge-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #D9480E;
}

.merge-desc {
  font-size: 21rpx;
  color: #868E96;
  margin-top: 4rpx;
}

/* 🆕 底部固定操作卡片：合并到每日汇报开关 + 存为模板/立即发布按钮，
   整合进同一张带阴影、贴底固定的白色卡片，不随内容区滚动 */
.notice-edit-footer {
  background-color: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.08);
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.footer-merge-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFF9DB;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.footer-merge-row .merge-title {
  font-size: 26rpx;
}

.footer-btn-row {
  display: flex;
  gap: 16rpx;
}

.notice-edit-btn {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 按钮层级：存为模板是浅灰次要操作，立即发布是主色蓝主操作，
   两者视觉权重明确区分开 */
.notice-edit-btn.template-btn {
  flex: 0.85;
  background-color: #F1F3F5;
  color: #495057;
  font-size: 28rpx;
}

.notice-edit-btn.save-btn {
  background: linear-gradient(135deg, #339AF0 0%, #1C7ED6 100%);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(28, 126, 214, 0.3);
}
.form-main-card .section {
  background-color: transparent;
  padding: 24rpx 0;
  border-radius: 0;
  margin-bottom: 0;
  box-shadow: none;
  text-align: left;
  border-top: 1rpx solid #F1F3F5;
}

.form-main-card .section:first-of-type {
  border-top: none;
  padding-top: 0;
}

/* Card A: 算式预览卡片 */
.math-preview-card {
  background: #FFFFFF;
}

.field-item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.label-with-tip {
  display: flex;
  align-items: baseline;
}

.label-with-tip .lbl-bold {
  font-size: 26rpx;
  font-weight: bold;
  color: #212529;
}

.label-with-tip .sub-tip {
  font-size: 20rpx;
  color: #868E96;
  margin-left: 8rpx;
}

.small-currency-input-box {
  display: flex;
  align-items: center;
  background: #F8F9FA;
  border: 1rpx solid #CED4DA;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  width: 180rpx;
}

.small-currency-input-box .symbol {
  font-size: 24rpx;
  font-weight: bold;
  color: #495057;
  margin-right: 6rpx;
}

.small-currency-input-box .num-input {
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
  width: 100%;
}

/* 高亮算式 Banner */
.formula-preview-banner {
  background: linear-gradient(135deg, #FFF9F0 0%, #FFF1DC 100%);
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #FFD79A;
}

.formula-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 14rpx;
}

.formula-header .title {
  font-size: 26rpx;
  font-weight: bold;
  color: #B45309;
}

.formula-expression-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  font-size: 30rpx;
  color: #212529;
}

.formula-expression-row .num-item {
  font-weight: bold;
  color: #343A40;
}

.formula-expression-row .unit {
  font-size: 18rpx;
  color: #868E96;
  font-weight: normal;
}

.formula-expression-row .operator {
  font-size: 30rpx;
  font-weight: bold;
  color: #B45309;
  padding: 0 4rpx;
}

.formula-expression-row .green {
  color: #2B8A3E;
  font-weight: bold;
}

.formula-expression-row .red {
  color: #E03131;
  font-weight: bold;
}

.formula-expression-row .result-val.orange {
  font-size: 38rpx;
  font-weight: bold;
  color: #D9480E;
}

/* Card B: 物资与服务统计网格 */
.optional-tag {
  font-size: 20rpx;
  color: #ADB5BD;
  font-weight: normal;
}

.block-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #212529;
  display: block;
  margin-bottom: 12rpx;
}

/* 📋 【一键复用昨日数据】：仅"义工与用餐统计"标题这一处需要在右侧并排放按钮，
   新起一层包装行，不改 .block-title 本身（其余多处仍是单独一行纯文本标题） */
.block-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.block-title-row .block-title.no-margin {
  margin-bottom: 0;
  flex: 1;
}

.reuse-yesterday-btn {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #E65100;
  background: #FFF3E0;
  border: 1rpx solid #FFE0B2;
  border-radius: 20rpx;
  padding: 8rpx 18rpx;
  white-space: nowrap;
}

.reuse-yesterday-btn.disabled {
  color: #ADB5BD;
  background: #F8F9FA;
  border-color: #E9ECEF;
}

.form-sub-block.top-space {
  margin-top: 24rpx;
}

.input-wrapper-inner {
  background: #F8F9FA;
  border: 1rpx solid #CED4DA;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}

.single-line-textarea {
  font-size: 24rpx;
  color: #212529;
  width: 100%;
  min-height: 60rpx;
  line-height: 1.5;
}

/* 🍱 义工与用餐统计：2 行 x 3 列 6 宫格卡片网格。
   真机上出现过单列拉通崩溃（疑似构建缓存导致这里的 class 样式未命中），
   .stats-grid-row 补上原本省略的 flex-direction: row（虽是默认值，显式写死
   更保险）+ !important，与 WXML 行内 style 双保险，任一层生效都能撑住布局 */
.stats-grid-container {
  display: flex !important;
  flex-direction: column !important;
  gap: 16rpx !important;
  width: 100% !important;
}

.stats-grid-row {
  display: flex !important;
  flex-direction: row !important;
  gap: 12rpx !important;
  width: 100% !important;
}

.stats-card-item {
  flex: 1 !important;
  min-width: 0 !important;
  background: #FFFDF7 !important;
  border: 1rpx solid #F5E6CD !important;
  border-radius: 16rpx !important;
  padding: 16rpx 4rpx !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  gap: 4rpx !important;
}

.stats-item-label {
  font-size: 20rpx !important;
  color: #7A6343 !important;
  white-space: nowrap !important;
}

/* 🍱 用餐总数/志愿者总人次汇总卡：双列对齐大数字展示，随细分输入框实时联动 */
.stats-summary-card {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: #FAFAFA;
  border-radius: 12rpx;
  border: 1rpx solid #F0F0F0;
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-input-wrap {
  display: flex !important;
  flex-direction: row !important;
  align-items: baseline !important;
  justify-content: center !important;
}

.stats-input {
  width: 60rpx !important;
  height: 44rpx !important;
  text-align: center !important;
  font-size: 28rpx !important;
  font-weight: bold !important;
  color: #D9531E !important;
}

.stats-unit {
  font-size: 18rpx !important;
  color: #999999 !important;
  white-space: nowrap !important;
}

/* Card C: 主食物资单选胶囊 */
.card-title-bar {
  margin-bottom: 8rpx;
}

.card-title-bar .title {
  font-size: 26rpx;
  font-weight: bold;
  color: #212529;
  display: flex;
  align-items: center;
}

/* Card D「今日支出录入」：大标题独立加大加粗，与下方 .box-header .lbl 子级
   小标签拉开字号/字重差，形成"大标题 -> 子 Label"的清晰视觉层级节奏 */
.expense-main-card .card-title-bar .title {
  font-size: 32rpx;
  font-weight: bold;
}

/* Card D: 支出明细与凭证上传 */
.expense-field-box {
  margin-bottom: 20rpx;
}

.box-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.box-header .lbl {
  font-size: 26rpx;
  font-weight: 600;
  color: #212529;
  display: flex;
  align-items: center;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 🌟 三颗按钮（计入成本标签 / 常用项目 / 拍照识别）统一视觉规范：同高、同 padding、
   同圆角（8-12rpx，不再是胶囊形）、同图标文字间距，让它们在 header-action-row 里
   看起来是同一组按钮，而不是三种各自不同的样式拼凑在一起 */
.box-header .tag,
.btn-expense-template-pill,
.btn-scan-receipt-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  box-sizing: border-box;
  white-space: nowrap;
  /* 细微上方内阴影（模拟轻微凹陷高光）+ 下方投影，提升按钮的实体感 */
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.5), 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
}

.box-header .tag {
  font-size: 20rpx;
  font-weight: 500;
  color: #1C7ED6;
  background: #E7F5FF;
}

.box-header .tag.warm {
  color: #D9480E;
  background: #FFF3BF;
}

.header-action-row {
  display: flex;
  align-items: center;
