}

.btn-empty-invite::after {
  border: none;
}

.btn-empty-invite:active {
  background: #FFE066;
  transform: scale(0.98);
}

/* 🌟 C位核心卡片：欢迎语+护持统计+打卡 CTA，置于胶囊下方最顶部，独立于滚动区之外，
   确保永远是志工视角下第一眼看到的内容，不被公告栏/食谱大事记预览卡挤到后面 */
.volunteer-hero-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  margin: 24rpx 24rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.volunteer-view-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  margin: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.volunteer-hero-card .v-header {
  text-align: center;
  margin-bottom: 20rpx;
}

.volunteer-hero-card .v-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #8C1D18;
  margin-bottom: 12rpx;
}

.volunteer-hero-card .v-sub {
  font-size: 26rpx;
  color: #8C7355;
}

.volunteer-hero-card .volunteer-stats-banner {
  background: linear-gradient(135deg, #FFFDF8 0%, #FFF5EB 100%);
  border: 1rpx solid #FFE0B2;
  border-radius: 16rpx;
  padding: 16rpx 16rpx 0;
  margin: 16rpx 0 20rpx 0;
  transition: opacity 0.15s ease;
}

/* 🛡️ 明确的触控反馈：整卡可点击，按下时轻微变暗，与其余胶囊按钮的 :active 手感保持一致 */
.volunteer-hero-card .volunteer-stats-banner-hover {
  opacity: 0.75;
}

.volunteer-hero-card .volunteer-stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.volunteer-hero-card .stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 🌟 核心荣誉数字：34rpx -> 48rpx 加粗放大，提升志工的归属感与荣誉感 */
.volunteer-hero-card .stat-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #E65100;
  line-height: 1.2;
}

.volunteer-hero-card .stat-label {
  font-size: 20rpx;
  color: #8D6E63;
  margin-top: 4rpx;
}

.volunteer-hero-card .stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #FFE0B2;
}

/* 🌸 温情激励语：置于统计数字下方，强化"我在被看见、被感恩"的情感连接 */
.volunteer-hero-card .warm-encourage-text {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #C97B3D;
  margin-top: 12rpx;
  line-height: 1.5;
}
/* 🍚 今日餐况状态卡：开餐状态 + 主食物资合并展示，用胶囊 Tag 呈现代替纯文字 */
.volunteer-view-card .today-status-card {
  background: #FFFDF8;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 20rpx;
}

.volunteer-view-card .tsc-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.volunteer-view-card .tsc-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #444444;
}

.volunteer-view-card .tsc-date {
  font-size: 22rpx;
  color: #999999;
}

.volunteer-view-card .tsc-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F2E9D8;
}

.volunteer-view-card .tsc-row:last-child {
  border-bottom: none;
}

.volunteer-view-card .tsc-label {
  font-size: 26rpx;
  color: #666666;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.volunteer-view-card .tsc-tag {
  font-size: 22rpx;
  font-weight: bold;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

/* 🌟 与 .status-pill（店长/财务设置物资状态用的选择胶囊）统一同一套色值，
   同一个"充足/一般/告急"概念在两处（管理端选择器 / 志工端展示标签）视觉一致 */
.volunteer-view-card .tsc-tag.tag-success {
  background: #E6F4EA;
  color: #137333;
}

.volunteer-view-card .tsc-tag.tag-warning {
  background: #FEF7E0;
  color: #B06000;
}

.volunteer-view-card .tsc-tag.tag-danger {
  background: #FFF2F0;
  color: #FF4D4F;
  border: 1rpx solid #FFA39E;
}

/* 🌟 物资护持交互联动：大米/食用油两行从纯展示升级为可点击，箭头给出明确的"可点击"提示，
   点击态轻微变色反馈，不需要额外的按钮就能表达"这里能点" */
.volunteer-view-card .tsc-row-tappable {
  transition: background-color 0.15s ease;
}

.volunteer-view-card .tsc-row-tappable:active {
  background-color: #FFF8ED;
}

.volunteer-view-card .tsc-tag-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* 🌟 智能物资引导跳转入口：小胶囊按钮，非满仓状态下才出现，
   与旁边的状态标签保持同一行但视觉上更主动、更像"可以点的行动号召" */
.volunteer-view-card .action-link {
  font-size: 20rpx;
  font-weight: bold;
  color: #8C1D18;
  background: #FFF3E0;
  border: 1rpx solid #FFCC80;
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
  white-space: nowrap;
}

.volunteer-view-card .action-link:active {
  opacity: 0.75;
}

.volunteer-view-card .tsc-row-arrow {
  font-size: 22rpx;
  color: #C7C7CC;
}

/* 🍱📌 食谱/大事记精简摘要行：单行文字，未发布时直接显示"尚未发布"，
   取代此前独立的大预览卡片，避免空卡片强行占用纵向空间 */
.volunteer-view-card .tsc-summary-row {
  padding: 12rpx 0 0;
  margin-top: 8rpx;
  border-top: 1rpx dashed #F2E9D8;
}

.volunteer-view-card .tsc-summary-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

/* 🌟 今日食谱动态卡片：能拆出结构化菜品名时，用小标签云替代纯文本单行，
   一眼能看清今天做了哪些菜，比一整行可能被截断的长文本更直观 */
.volunteer-view-card .tsc-menu-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.volunteer-view-card .tsc-menu-label {
  overflow: visible;
  white-space: normal;
}

.volunteer-view-card .tsc-dish-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.volunteer-view-card .tsc-dish-chip {
  font-size: 22rpx;
  color: #8C1D18;
  background: #FFF3E0;
  border: 1rpx solid #FFE0B2;
  border-radius: 16rpx;
  padding: 6rpx 16rpx;
}

.volunteer-hero-card .v-action-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  /* 任务C：高亮动画的过渡基础 */
  transition: box-shadow 0.3s ease, background-color 0.3s ease, transform 0.3s ease;
  border-radius: 24rpx;
  /* 🛡️ 打卡卡片精简后只剩主按钮一个子元素，加大上下内边距让按钮在卡片内
     更居中、大方醒目，不再贴着服务历程/公开账本链接的位置显得局促 */
  padding: 28rpx 4rpx;
}

/* ===== 任务C：highlight-pulse 金色/红色呼吸闪烁动画（持续2秒） ===== */
.volunteer-hero-card .v-action-box.highlight-pulse {
  animation: highlightPulse 2s ease-in-out 1;
  /* 兜底光晕（动画失败时也能看出高亮） */
  box-shadow: 0 0 24rpx 8rpx rgba(245, 166, 35, 0.6);
  background-color: rgba(245, 166, 35, 0.08);
}

@keyframes highlightPulse {
  0% {
    box-shadow: 0 0 0 0 rgba(245, 166, 35, 0);
    background-color: transparent;
    transform: scale(1);
  }
  15% {
    /* 第一次金色脉冲 */
    box-shadow: 0 0 32rpx 12rpx rgba(245, 166, 35, 0.85);
    background-color: rgba(245, 166, 35, 0.15);
    transform: scale(1.02);
  }
  30% {
    box-shadow: 0 0 16rpx 6rpx rgba(245, 166, 35, 0.3);
    background-color: rgba(245, 166, 35, 0.04);
    transform: scale(1);
  }
  50% {
    /* 第二次红色脉冲（呼应雨花斋品牌色 #8C1D18） */
    box-shadow: 0 0 32rpx 12rpx rgba(140, 29, 24, 0.7);
    background-color: rgba(140, 29, 24, 0.1);
    transform: scale(1.02);
  }
  70% {
    box-shadow: 0 0 16rpx 6rpx rgba(140, 29, 24, 0.25);
    background-color: rgba(140, 29, 24, 0.03);
    transform: scale(1);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(245, 166, 35, 0);
    background-color: transparent;
    transform: scale(1);
  }
}
/* 🌟 第一核心操作 CTA：加大字号、加深阴影，未打卡状态额外用金色描边提醒 */
.volunteer-hero-card .btn-volunteer-checkin {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #8C1D18;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 48rpx;
  padding: 0;
  margin: 0;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(140, 29, 24, 0.28);
  transition: box-shadow 0.2s ease, transform 0.2s ease, background 0.2s ease;
}

.volunteer-hero-card .btn-volunteer-checkin::after {
  border: none;
}

.volunteer-hero-card .btn-volunteer-checkin:active {
  background: #6D1410;
  transform: scale(0.98);
}

/* 未打卡：金色描边 + 更强阴影，作为页面最醒目的行动点 */
.volunteer-hero-card .btn-volunteer-checkin.state-pending {
  border: 2rpx solid #F5A623;
  box-shadow: 0 8rpx 24rpx rgba(245, 166, 35, 0.4);
}

/* 已打卡部分班次：正常品牌色，鼓励继续 */
.volunteer-hero-card .btn-volunteer-checkin.state-partial {
  background: #A8281F;
}

/* 今日全部班次已完成：切换为沉稳的成功绿，弱化 CTA 紧迫感 */
.volunteer-hero-card .btn-volunteer-checkin.state-done {
  background: linear-gradient(135deg, #2E7D32 0%, #1B5E20 100%);
  box-shadow: 0 8rpx 20rpx rgba(46, 125, 50, 0.28);
}

.volunteer-hero-card .btn-volunteer-checkin.state-done:active {
  background: #1B5E20;
}
/* ================= 🙋 全角色到岗打卡卡片（店长/财务视角） =================
   与 .volunteer-hero-card 的按钮视觉语言保持一致，但这里的样式全部自成一套、
   不依赖 .volunteer-hero-card 作为祖先选择器——原按钮样式都写成
   .volunteer-hero-card .btn-volunteer-checkin 这种强绑定祖先的形式，直接把
   btn-volunteer-checkin 类名搬到这张新卡片里是不会生效的，所以在这里整套复刻。 */
.omni-checkin-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 28rpx 24rpx;
  margin: 24rpx 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #F1E6D8;
}

.omni-checkin-header {
  margin-bottom: 20rpx;
}

.omni-checkin-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #8C1D18;
  margin-bottom: 6rpx;
}

.omni-checkin-sub {
  display: block;
  font-size: 22rpx;
  color: #8C7355;
  line-height: 1.5;
}

.omni-checkin-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #8C1D18;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 48rpx;
  padding: 0;
  margin: 0;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(140, 29, 24, 0.28);
  transition: box-shadow 0.2s ease, transform 0.2s ease, background 0.2s ease;
}

.omni-checkin-btn::after {
  border: none;
}

.omni-checkin-btn:active {
  background: #6D1410;
  transform: scale(0.98);
}

.omni-checkin-btn.state-pending {
  border: 2rpx solid #F5A623;
  box-shadow: 0 8rpx 24rpx rgba(245, 166, 35, 0.4);
}

.omni-checkin-btn.state-partial {
  background: #A8281F;
}

.omni-checkin-btn.state-done {
  background: linear-gradient(135deg, #2E7D32 0%, #1B5E20 100%);
  box-shadow: 0 8rpx 20rpx rgba(46, 125, 50, 0.28);
}

.omni-checkin-btn.state-done:active {
  background: #1B5E20;
}

/* 次级跳转入口：店长/财务身份可能同时具备（超管），两条链接可以同时出现，
   用弱化的胶囊样式呈现，不与上方的打卡主按钮抢视觉焦点 */
.omni-checkin-manage-links {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.omni-checkin-manage-link {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 64rpx;
  background: #FAF8F5;
  border: 1rpx solid #EFE6D8;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #8C7355;
}

.omni-checkin-manage-link:active {
  background: #F1EBE2;
}

.omni-link-arrow {
  font-size: 20rpx;
  color: #C97B3D;
}

.omni-checkin-store-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  padding: 14rpx;
  background: #F8F9FA;
  border: 1rpx dashed #DEE2E6;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #868E96;
}

.manager-home-card,
.finance-home-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
}

.manager-home-card .card-header-welcome,
.finance-home-card .card-header-welcome {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

/* 🐛 玻璃拟态：财务稽核台 Header 单独抬一层半透明磨砂底，与卡片本身的纯白底
   拉开一点层次，不再是"标题文字直接摆在实色卡片上"的单调堆叠 */
.finance-home-card .card-header-welcome {
  background: rgba(255, 235, 238, 0.5);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin: -4rpx -4rpx 20rpx;
}

.manager-home-card .welcome-icon,
.finance-home-card .welcome-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.manager-home-card .welcome-text-box,
.finance-home-card .welcome-text-box {
  flex: 1;
}

.manager-home-card .welcome-title,
.finance-home-card .welcome-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  display: block;
}

.manager-home-card .welcome-sub,
.finance-home-card .welcome-sub {
  font-size: 24rpx;
  color: #888888;
  margin-top: 6rpx;
  display: block;
}

.manager-home-card .role-stats-banner,
.finance-home-card .role-stats-banner {
  display: flex;
  align-items: center;
  justify-content: space-around;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  margin-top: 4rpx;
  position: relative;
}

.manager-home-card .manager-bg {
  background: linear-gradient(135deg, #FFFDF8 0%, #FFF3E0 100%);
  border: 1rpx solid #FFE0B2;
}

.finance-home-card .finance-bg {
  background: linear-gradient(135deg, #FFFDF8 0%, #FFEBEE 100%);
  border: 1rpx solid #FFCDD2;
}

.manager-home-card .stat-item,
.finance-home-card .stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.manager-home-card .stat-num,
.finance-home-card .stat-num {
  font-size: 34rpx;
  font-weight: bold;
  color: #E65100;
  line-height: 1.2;
}

.manager-home-card .stat-num.highlight,
.finance-home-card .stat-num.highlight {
  color: #D32F2F;
}

.manager-home-card .stat-num.green-text,
.finance-home-card .stat-num.green-text {
  color: #2E7D32;
}

.manager-home-card .stat-label,
.finance-home-card .stat-label {
  font-size: 20rpx;
  color: #8D6E63;
  margin-top: 4rpx;
}

.manager-home-card .stat-divider,
.finance-home-card .stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(140, 29, 24, 0.1);
}

/* 🌟 财务专属功能区宫格：复用 .qa-main-grid 的白底/圆角/阴影样式，与稽核台间隔开 */
.finance-qa-grid {
  margin-top: 20rpx;
}

/* 🐛 财务首页瘦身：录入表单默认收起后的唯一展开口子，刻意做成不起眼的文字链接
   （而不是又一张卡片/大按钮）——找得到，但不与上方稽核台抢视觉焦点 */
.finance-form-override-link {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B71C1C;
  padding: 8rpx 0;
}

/* ================= 财务专属功能区：稽核封账 / 风控预警弹窗 ================= */
.finance-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: finance-modal-fade-in 0.18s ease-out;
}

@keyframes finance-modal-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.finance-modal-card {
  width: 82%;
  max-width: 620rpx;
  max-height: 75vh;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 🐛「风控预警日志」平滑拉起：从下方轻微位移 + 淡入，而不是硬切出现，
   呼应"拉起面板"这个交互动词，与稽核封账那个纯居中弹窗的观感区分开 */
.risk-modal-card {
  animation: risk-modal-slide-up 0.22s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes risk-modal-slide-up {
  from { opacity: 0; transform: translateY(48rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.finance-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.finance-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
}

.finance-modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #868E96;
}

.finance-modal-desc {
  display: block;
  font-size: 24rpx;
  color: #868E96;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.finance-month-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F8F9FA;
  border: 1rpx solid #E9ECEF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 28rpx;
  font-size: 28rpx;
  color: #212529;
  font-weight: 500;
}

.finance-month-picker .arrow {
  font-size: 20rpx;
  color: #ADB5BD;
}

.finance-modal-confirm-btn {
  width: 100% !important;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #2E7D32 0%, #1B5E20 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 44rpx;
  padding: 0;
  margin: 0;
  border: none;
}

.finance-modal-confirm-btn::after {
  border: none;
}

.risk-summary-row {
  display: flex;
  justify-content: space-around;
  background: #FAF8F5;
  border-radius: 16rpx;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.risk-summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.risk-summary-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #C62828;
}

.risk-summary-label {
  font-size: 20rpx;
  color: #868E96;
}

.risk-loading {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #868E96;
}

.risk-alert-list {
  max-height: 50vh;
}

.risk-alert-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  background: #FFF8E1;
  border-left: 6rpx solid #FFA000;
}

.risk-alert-item.danger {
  background: #FFEBEE;
  border-left-color: #C62828;
}

.risk-alert-date {
  font-size: 22rpx;
  font-weight: bold;
  color: #444444;
}

.risk-alert-msg {
  font-size: 22rpx;
  color: #666666;
  line-height: 1.5;
}

.risk-alert-empty {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #2E7D32;
}

.shift-scroll-area {
  max-height: 55vh;
  margin: 20rpx 0;
}

.modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99999;
}

.modal-card {
  width: 88%;
  max-width: 680rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
}

.modal-card .modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
