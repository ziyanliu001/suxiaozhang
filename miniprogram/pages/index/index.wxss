@charset "UTF-8";
/* 🐛 根因修复（「进入店务管理/财务稽核台」点击无滚动效果）：page/
   .index-page-container 此前都写死 height:100vh——固定高度容器在小程序
   渲染层面不会因为子元素溢出而产生可滚动的页面级 scrollHeight，导致
   wx.pageScrollTo（无论传 selector 还是显式算出 scrollTop）在非义工视角
   （店长/财务/超管，见下方 .index-page-container 内 padding-bottom 注释）
   下永远没有可用的滚动范围可用，点击按钮日志正常打印、目标节点也确实
   存在，页面却纹丝不动。改为 min-height:100vh——内容不超过一屏时行为
   与之前完全一致（容器仍然至少占满 100vh，.page-body-scroll 仍按 flex:1
   吃满剩余空间）；内容超出一屏时，容器不再被硬性裁死，允许自然长高，
   原生页面级滚动从此真正有滚动范围可用，无需改动任何 WXML 结构
   （不再重蹈上一版把 scroll-view 起始标签整体上移、结果与内部
   <block wx:elif> 交叉嵌套导致编译报错/白屏的覆辙） */
page {
  background-color: #f8f9fa;
  min-height: 100vh;
}

.index-page-container {
  display: flex;
  flex-direction: column;
  width: 100%;
  min-height: 100vh;
  /* 🛡️ 兜底防线：即使个别卡片将来又不小心引入同类"width:100% + 额外横向
     margin"溢出（见 .volunteer-hero-card 等处根因修复注释），也只会被裁掉
     溢出部分、不会产生横向滚动条把整页内容推偏，双重保险 */
  overflow-x: hidden;
  background-color: #F8F9FA;
  box-sizing: border-box;
  /* 自定义导航栏（navigationStyle: custom）下，页面顶部内容需自行避让胶囊按钮/刘海安全区。
     env(safe-area-inset-top) 只覆盖刘海/状态栏高度，胶囊按钮本身还有额外高度，
     单靠 env() 不够，故强制再叠加 80rpx 兜底，与 headerSafeTop 的动态胶囊测算共同生效，
     确保首屏渲染早于 JS 测算完成时内容也不会被遮挡 */
  padding-top: calc(env(safe-area-inset-top) + 80rpx) !important;
  /* 🏛️（2026-09-03 彻底根治 TabBar 踩踏）.bottom-action-floating-bar 已从
     position:fixed 悬浮层改为普通文档流内容（随 .page-body-scroll 一起滚动），
     不再需要为它单独预留一份"TabBar + 按钮组高度"的组合安全垫——这里只需要
     跟其它页面（如 profile.wxss）同一套口径，单纯避让自定义 TabBar 本身
     （custom-tab-bar/index.wxss 实测 100rpx）+ 安全区 + 一点呼吸间距，
     不再叠加按钮组高度 */
  padding-bottom: calc(100rpx + constant(safe-area-inset-bottom) + 40rpx) !important;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom) + 40rpx) !important;
}

.app-header-section {
  background-color: #FFFFFF;
  width: 100%;
  box-sizing: border-box;
  padding-bottom: 24rpx;
  flex-shrink: 0;
}

.page-body-scroll {
  flex: 1;
  width: 100%;
  /* 🏛️（2026-09-03 彻底根治 TabBar 踩踏）.bottom-action-floating-bar 已从
     position:fixed 悬浮层改为文档流内容，本身会自然滚动到"门店今日日志/
     大事记"这类内容之后，不会再遮挡任何东西——这里的 padding-bottom 只需要
     单纯避让自定义 TabBar（100rpx 实测高度）+ 安全区 + 一点呼吸间距，
     与 .index-page-container 同一份口径，不用再叠加一份按钮组的高度估算 */
  padding: 24rpx 24rpx calc(100rpx + env(safe-area-inset-bottom) + 40rpx) 24rpx;
  box-sizing: border-box;
}

