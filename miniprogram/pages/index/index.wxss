}

/* 双选项卡 Tab */
.audit-tab-segment {
  display: flex;
  background: #F8F9FA;
  border-radius: 16rpx;
  padding: 6rpx;
  margin: 20rpx 0;
}

.audit-tab-segment .tab-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #495057;
  padding: 14rpx 0;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.audit-tab-segment .tab-item.active {
  background: #FFFFFF;
  color: #D9480E;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 滚动列表区：🛡️ 修复底部被自定义 TabBar 遮挡——补上安全内边距，
   确保空状态的【生成邀请海报】按钮与卡片底部操作按钮完整可见、点击无阻碍 */
.drawer-content-scroll {
  max-height: 55vh;
  margin-top: 10rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 义工申请卡片 */
.audit-applicant-card {
