/* 🌟 合规授权须知弹窗（组件一）：首次进入 / 首次切换到财务/店长视角强制阅读，
   与站内其它弹窗一致的白卡片圆角风格，仅在内容与关闭规则上更严格——
   'general'/'privileged' 场景下没有关闭按钮、mask 不响应 tap，只能读完点底部按钮 */
.compliance-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.compliance-modal-card {
  width: 88%;
  max-width: 640rpx;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 28rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.compliance-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.compliance-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #222222;
}

.compliance-modal-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #F1F3F5;
  color: #6B7280;
  font-size: 24rpx;
}

.compliance-modal-body {
  flex: 1;
  max-height: 56vh;
}

.compliance-section {
  margin-bottom: 28rpx;
}

.compliance-section-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #8C1D18;
  margin-bottom: 10rpx;
}

.compliance-section-text {
  font-size: 25rpx;
  color: #495057;
  line-height: 1.8;
  text-align: justify;
}

.compliance-emphasis {
  font-weight: bold;
  color: #212529;
}

.compliance-modal-footer {
  margin-top: 20rpx;
}

.compliance-confirm-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  background: linear-gradient(135deg, #8C1D18 0%, #B22222 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 42rpx;
  border: none;
}

.compliance-confirm-btn-review {
  background: #F1F3F5;
  color: #495057;
}

.compliance-confirm-btn::after {
  border: none;
}

/* 🚨 页面末尾强制覆盖：正红渐变 + 纯白大字，压过微信原生 button[disabled] 半透明遮罩。
   与本文件前面 .poster-gen-btn 那份规则内容一致，这里追加在文件最末尾仅为提高
   源码顺序上的最终优先级，双重保险。 */
.poster-gen-btn,
button.poster-gen-btn,
.poster-gen-btn[disabled],
button.poster-gen-btn[disabled] {
  background: #C62828 !important;
  background-image: linear-gradient(135deg, #C62828 0%, #B71C1C 100%) !important;
  color: #FFFFFF !important;
  font-weight: bold !important;
  opacity: 1 !important;
  border: none !important;
  box-shadow: 0 4rpx 12rpx rgba(198, 40, 40, 0.3) !important;
}

/* 🍱 义工与用餐统计标题按钮/汇总卡片保险：class 名沿用既有的 .reuse-yesterday-btn
   （未采用请求里的 .btn-reuse-yesterday，是为了不影响 disabled 态判断走的同一个 class） */
.reuse-yesterday-btn:active {
  opacity: 0.8;
  background: #FFE0B2 !important;
}

.stats-summary-card {
  box-shadow: inset 0 1rpx 3rpx rgba(0, 0, 0, 0.02);
}

/* 🚨 雨花家训弹窗保险：类名沿用 .family-motto-card（这个类本就只用在这一个弹窗），
   未采用请求里的 .motto-modal-card，避免和其他地方潜在同名类冲突 */
.family-motto-card {
  margin-top: 80rpx !important;
}

.motto-modal-close:active {
  opacity: 0.6;
}
/* ☀️ 阳光账本入口卡片：标题正下方、全角色可见、位置最优先，阳光公益质感——
   暖金渐变 + 太阳图标，与页面其余卡片的米白基调区分开，一眼可辨识出这是
   "公开透明数据"入口而非普通功能入口 */
.sunshine-ledger-entry {
  display: flex;
  align-items: center;
  margin: 16rpx 24rpx 20rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #FFF8E1 0%, #FFECB3 100%);
  border: 1rpx solid #FFD54F;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(255, 193, 7, 0.2);
}

.sunshine-ledger-entry:active {
  opacity: 0.85;
}

.sunshine-ledger-icon {
  font-size: 44rpx;
  margin-right: 16rpx;
}

.sunshine-ledger-text-group {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.sunshine-ledger-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #8D5B00;
}

.sunshine-ledger-sub {
  font-size: 22rpx;
  color: #A87B1F;
}

.sunshine-ledger-arrow {
  font-size: 22rpx;
  color: #C99A2E;
}

/* ☀️ 阳光账本 Modal：与 .compliance-modal-mask/.compliance-modal-card 同款遮罩+
   卡片骨架，头部沿用暖金主题呼应入口卡片，内容轻量（三项汇总数字 + 一条透明说明） */
.sunshine-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.sunshine-modal-card {
  width: 84%;
  max-width: 600rpx;
  max-height: 82vh;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.sunshine-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}

.sunshine-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #8D5B00;
}

.sunshine-modal-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #F1F3F5;
  color: #6B7280;
  font-size: 24rpx;
}

/* 🛡️ min-height: 0 是让 flex 子项能被压缩到小于内容高度的关键，缺了这行
   scroll-view 会撑到内容的完整高度，滚动条永远不会真正生效 */
.sunshine-modal-scroll {
  flex: 1;
  min-height: 0;
}

/* 📖 理念介绍卡片：暖金质感背景，与下方数据大盘的配色自然衔接，
   避免纯数字表格显得冷冰冰。弹窗 Header 已经承载"关于雨花斋与阳光账本"
   这层标题，卡片内部不再重复次级标题，直接进两段内容 */
.sunshine-intro-card {
  width: 100%;
  background: linear-gradient(155deg, #FFF8E8 0%, #FFF3D6 100%);
  border: 1rpx solid #F0D9A0;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

/* 🌸 侧条高亮卡片：每段文案独立一张浅底小卡 + 左侧金色竖条，
   替代此前"整段文案堆在一起"的排版，段落之间呼吸感更强 */
.sunshine-intro-block {
  background: rgba(255, 255, 255, 0.55);
  border-left: 6rpx solid #E6A23C;
  border-radius: 8rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 18rpx;
}

.sunshine-intro-block:last-child {
  margin-bottom: 0;
}

.sunshine-intro-label {
  display: inline-block;
  font-size: 22rpx;
  font-weight: bold;
  color: #FFFFFF;
  background: #E6A23C;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  margin-bottom: 12rpx;
}

.sunshine-intro-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6B4C1E;
}

/* ✨ 理念介绍 / 数据大盘分界线：虚线 + 居中标签，标签文字带一点暖金微光，
   让两段内容读起来是两个层次，而不是同一块内容的延续 */
.sunshine-section-divider {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 20rpx 0;
}

.sunshine-divider-line {
  flex: 1;
  height: 0;
  border-top: 2rpx dashed rgba(230, 162, 60, 0.4);
}

.sunshine-divider-label {
  font-size: 20rpx;
  font-weight: bold;
  color: #C08A3E;
  text-shadow: 0 0 8rpx rgba(230, 162, 60, 0.35);
  white-space: nowrap;
}

.sunshine-modal-loading {
  text-align: center;
  padding: 60rpx 0;
  color: #ADB5BD;
  font-size: 26rpx;
}

.sunshine-modal-body {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sunshine-store-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #222222;
}

.sunshine-period-label {
  font-size: 22rpx;
  color: #868E96;
  margin-top: 6rpx;
  margin-bottom: 24rpx;
}

/* 🗓️ 月份切换器：‹ 2026年07月 › ，标题下方、数据网格上方 */
.sunshine-month-switcher {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.sunshine-month-arrow {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: #FFF3D6;
  color: #E6A23C;
  font-size: 28rpx;
  font-weight: bold;
}

.sunshine-month-arrow-disabled {
  color: #D9D9D9;
  background: #F5F5F5;
}

.sunshine-month-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #8D5B00;
  min-width: 160rpx;
  text-align: center;
}

/* 📊 4x2 网格数据大盘：8 项指标（2 列 x 4 行），每格独立卡片化，
   保留同一套暖金配色 */
.sunshine-stat-grid-2x2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  width: 100%;
  margin-bottom: 20rpx;
}

.sunshine-stat-cell-2x2 {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  background: linear-gradient(135deg, #FFFDF5 0%, #FFF8E1 100%);
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  box-sizing: border-box;
}

.sunshine-stat-num-2x2 {
  font-size: 36rpx;
  font-weight: bold;
  color: #E6A23C;
}

.sunshine-stat-lbl-2x2 {
  font-size: 22rpx;
  color: #A87B1F;
  text-align: center;
}

.sunshine-transparency-tip {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  width: 100%;
  background: #F1F8F1;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  box-sizing: border-box;
}

.sunshine-tip-icon {
  font-size: 22rpx;
}

.sunshine-tip-text {
  flex: 1;
  font-size: 22rpx;
  color: #4A7C4A;
  line-height: 1.6;
}
