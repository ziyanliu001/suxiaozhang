                  data-hours="{{item.hours}}">
              <view class="shift-left">
                <view class="shift-name-row">
                  <text class="shift-name">{{item.name}}</text>
                  <text class="completed-tag" wx:if="{{item.isCompleted}}">✔ 今日已打卡</text>
                </view>
                <text class="shift-time">{{item.timeDesc}}</text>
