  <!-- 平账原因确认弹窗 -->
  <view class="adjust-modal" wx:if="{{showAdjustModal}}">
    <view class="adjust-mask" bindtap="onAdjustCancel"></view>
    <view class="adjust-content" catchtap="stopPropagation">
      <view class="adjust-header">
        <view class="adjust-header-title"><view class="idx-icon-sm idx-icon-warning" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>平账原因确认</view>
        <view class="adjust-close" bindtap="onAdjustCancel">✕</view>
      </view>
      <view class="adjust-body">
        <view class="adjust-info-row">
          <text class="adjust-info-label">系统默认余额：</text>
          <text class="adjust-info-value">¥{{adjustModalInfo.systemBalance}}</text>
        </view>
        <view class="adjust-info-row">
          <text class="adjust-info-label">现修改为：</text>
          <text class="adjust-info-value">¥{{adjustModalInfo.adjustedBalance}}</text>
        </view>
        <view class="adjust-info-row">
          <text class="adjust-info-label">差额：</text>
          <text class="adjust-info-value adjust-diff">{{adjustModalInfo.balanceDiffSign}}¥{{adjustModalInfo.balanceDiff}}</text>
        </view>
        <view class="adjust-divider"></view>
        <view class="adjust-textarea-wrap">
          <textarea
            class="adjust-textarea"
            auto-height
            maxlength="500"
            placeholder="请输入修改原因（如：补报昨日漏记支出、盘点差额平账）"
            value="{{adjustInput}}"
            bindinput="onAdjustInput"
          />
