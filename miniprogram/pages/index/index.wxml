          bindtap="onApplyHistoryBalance"
          data-item="{{item}}"
        >
          <view class="row-left-main">
            <view class="row-date-box">
              <text class="row-date-text">{{item.reportDate}}</text>
              <text class="matched-badge" wx:if="{{item.isCurrentMatched}}">✓ 系统当前匹配</text>
            </view>
            <view class="row-formula-text">
              (上日: {{item.yesterdayBal}}) + (收入: +{{item.income}}) - (支出: -{{item.expense}})
            </view>
          </view>
          <view class="row-right-action">
