          <view class="field-title-left-row">
            <text class="field-title-text">通报正文</text>
            <view class="clear-btn-inline" bindtap="clearNoticeContent" wx:if="{{noticeEditContent}}">
              <view class="clear-btn-text"><view class="idx-icon-sm idx-icon-trash" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>清空正文</view>
            </view>
          </view>
          <view class="textarea-box-container">
            <textarea 
              class="notice-edit-textarea" 
              placeholder="请输入通报正文内容..." 
              value="{{noticeEditContent}}" 
              bindinput="onNoticeContentInput"
              auto-height
              maxlength="500"
            />
            <text class="char-count-tag">{{noticeEditContent.length || 0}}/500</text>
          </view>
        </view>

        <view class="merge-option-bar">
          <view class="merge-info">
            <view class="merge-title"><view class="idx-icon-sm idx-icon-link" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>合并到每日汇报文本</view>
            <text class="merge-desc">开启后，点击【生成文本】将自动在日报开头附带此通报</text>
          </view>
          <switch
            checked="{{mergeToReportText}}"
            bindchange="onToggleMergeToReport"
            color="#FF922B"
          />
        </view>

        <!-- 🌟 仅超级管理员可见：勾选后"存为模板"会把这条模板设为全域公共，
             本机构任意门店都能在自己的编辑弹窗里看到并套用；不勾选则只存为
             当前门店的私有模板。店长/财务看不到这个开关，存的永远是本店模板 -->
        <view class="merge-option-bar" wx:if="{{isSuperAdmin}}">
          <view class="merge-info">
            <view class="merge-title"><view class="idx-icon-sm idx-icon-sparkle" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>设为全域公共模板</view>
            <text class="merge-desc">开启后"存为模板"将对本机构所有门店可见和可用</text>
          </view>
          <switch
            checked="{{saveAsSystemTemplate}}"
            bindchange="onToggleSaveAsSystemTemplate"
            color="#FF922B"
          />
        </view>
      </scroll-view>

      <view class="notice-edit-footer">
        <button class="notice-edit-btn cancel-btn" bindtap="closeNoticeEdit">取消</button>
        <button class="notice-edit-btn template-btn" bindtap="onSaveAsTemplate">存为模板</button>
        <button class="notice-edit-btn save-btn" bindtap="onSaveNotice">保存并应用</button>
      </view>
    </view>
  </view>

  <view class="history-balance-modal" wx:if="{{showHistoryBalanceModal}}" bindtap="closeHistoryBalanceModal">
    <view class="history-balance-mask"></view>
    <view class="history-balance-content" catchtap="stopPropagation">
      <view class="history-balance-header">
        <view class="history-balance-title"><view class="idx-icon-sm idx-icon-chart" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>历史结余查询</view>
        <view class="history-balance-close" bindtap="closeHistoryBalanceModal">
          <text class="close-icon">×</text>
        </view>
      </view>
      <scroll-view scroll-y class="history-balance-body">
        <view class="history-balance-list" wx:if="{{historyBalanceList && historyBalanceList.length > 0}}">
          <view 
            class="history-balance-item" 
            wx:for="{{historyBalanceList}}" 
            wx:key="date"
            bindtap="onSelectHistoryBalance"
            data-balance="{{item.balance}}"
            data-date="{{item.date}}"
          >
            <view class="history-balance-item-left">
              <text class="history-balance-date">{{item.date}}</text>
              <text class="history-balance-store">{{item.store}}</text>
            </view>
            <view class="history-balance-item-right">
              <text class="history-balance-value">¥{{item.balance}}</text>
              <text class="history-balance-select">选择</text>
            </view>
          </view>
        </view>
        <view class="history-balance-empty" wx:else>
          <view class="empty-icon idx-icon-svg idx-icon-clipboard"></view>
          <text class="empty-text">暂无历史结余数据</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="balance-history-modal-mask" wx:if="{{showBalanceHistoryModal}}" bindtap="onCloseBalanceHistoryModal">
    <view class="balance-history-modal-box" catchtap="stopPropagation">
      <view class="modal-top-header">
        <view class="header-title-group">
          <view class="modal-title"><view class="idx-icon-sm idx-icon-scroll" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>近期期末结余流水追溯</view>
          <text class="modal-sub-title">点击任意一日可快速代入其期末结余</text>
        </view>
        <text class="btn-close-modal" bindtap="onCloseBalanceHistoryModal">✕</text>
      </view>

      <scroll-view scroll-y class="modal-history-scroll">
        <view 
          class="history-balance-row {{item.isCurrentMatched ? 'is-matched' : ''}}" 
          wx:for="{{recentBalanceHistoryList}}" 
          wx:key="reportDate"
          bindtap="onApplyHistoryBalance"
          data-item="{{item}}"
        >
          <view class="row-left-main">
            <view class="row-date-box">
              <text class="row-date-text">{{item.reportDate}}</text>
              <text class="matched-badge" wx:if="{{item.isCurrentMatched}}">✓ 系统当前匹配</text>
            </view>
            <view class="row-formula-text">
              (上日: {{item.yesterdayBal}}) + (收入: +{{item.income}}) - (支出: -{{item.expense}})
            </view>
          </view>
          <view class="row-right-action">
            <text class="row-ending-balance">¥{{item.endingBalance}}</text>
            <text class="btn-apply-tag">点击代入</text>
          </view>
        </view>
        <view class="empty-history-tip" wx:if="{{recentBalanceHistoryList.length === 0}}">
          暂无近期历史结余记录
        </view>
      </scroll-view>

      <view class="modal-bottom-tip">
        <view class="idx-icon-sm idx-icon-bulb" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>提示：代入后系统将自动锁死该数值，确保账目精准接力。
      </view>
    </view>
  </view>

  <!-- 扫码绑定义工申请 Modal -->
  <view class="apply-modal-mask" wx:if="{{showApplyModal}}" bindtap="onCloseApplyModal">
    <view class="apply-modal-box" catchtap="stopPropagation">
      <view class="modal-header">
        <view class="modal-title"><view class="idx-icon-sm idx-icon-note" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>{{applyForm.storeSelectionType === 'custom' ? '申请加入新门店' : (applyForm.storeName ? '加入【' + applyForm.storeName + '】' : '申请加入门店')}}</view>
        <text class="btn-close" bindtap="onCloseApplyModal">✕</text>
      </view>

      <view class="apply-form-body">
        <view class="form-item">
          <text class="form-label">门店</text>
          <view class="store-mode-tabs">
            <view class="store-mode-tab {{applyForm.storeSelectionType === 'existing' ? 'active' : ''}}" data-mode="existing" bindtap="onSwitchApplyStoreMode">选择已有门店</view>
            <view class="store-mode-tab {{applyForm.storeSelectionType === 'custom' ? 'active' : ''}}" data-mode="custom" bindtap="onSwitchApplyStoreMode">新建门店</view>
          </view>

          <picker wx:if="{{applyForm.storeSelectionType === 'existing'}}" mode="selector" range="{{allStoresList}}" range-key="storeName" bindchange="onSelectApplyStore">
            <view class="form-picker-selector">{{applyForm.storeName || '请选择门店'}}</view>
          </picker>
          <input wx:else class="form-input" placeholder="请输入新门店名称，如：雨花斋厦门海沧店" value="{{applyForm.customStoreName}}" bindinput="onCustomStoreNameInput" />
          <text class="form-hint" wx:if="{{applyForm.storeSelectionType === 'custom'}}">新门店需待超级管理员审核通过后自动建立</text>
        </view>
        <view class="form-item">
          <text class="form-label">真实姓名</text>
          <input class="form-input" placeholder="请输入真实姓名" value="{{applyForm.realName}}" bindinput="onApplyRealNameInput" />
        </view>
        <view class="form-item">
          <text class="form-label">手机号</text>
          <input class="form-input" type="number" placeholder="请输入手机号" value="{{applyForm.phone}}" bindinput="onApplyPhoneInput" />
        </view>
        <view class="form-item">
          <text class="form-label">申请岗位</text>
          <radio-group class="role-radio-group" bindchange="onApplyRoleChange">
            <label class="role-radio-item">
              <radio value="volunteer" checked="{{applyForm.requestedRole === 'volunteer'}}" />
              <text><view class="idx-icon-sm idx-icon-heart" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>现场义工</text>
            </label>
            <label class="role-radio-item">
              <radio value="finance" checked="{{applyForm.requestedRole === 'finance'}}" />
              <text><view class="idx-icon-sm idx-icon-key" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>财务义工</text>
            </label>
          </radio-group>
        </view>
      </view>

      <view class="apply-modal-footer">
        <button class="btn-modal-cancel" bindtap="onCloseApplyModal">取消</button>
        <button class="btn-modal-submit" bindtap="onSubmitRoleApply">提交申请</button>
      </view>
    </view>
  </view>

  <!-- ================= 🔑 生成邀请码弹窗 (仅限超管与授权店长) ================= -->
  <view class="gencode-modal-mask" wx:if="{{showGenCodeModal}}" bindtap="onCloseGenCodeModal">
    <view class="gencode-modal-card" catchtap="stopPropagation">
      <view class="gencode-header-bar">
        <view class="gencode-title-text"><view class="idx-icon-sm idx-icon-key" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>新增特权邀请码</view>
        <text class="gencode-close-btn" bindtap="onCloseGenCodeModal">✕</text>
      </view>

      <view class="gencode-body">
        <!-- 1. 选择目标门店：下拉选择已有门店 / 手动输入新门店 双模式。
             【选择已有门店】是默认态（onOpenGenCodeModal 打开弹窗时，只要本机构下有门店
             就默认选中这一档，只有一家门店都没有时才会退到"手动输入新门店"）。 -->
        <view class="form-item-row">
          <text class="form-label">1. 选择授权门店：</text>
          <view class="store-mode-tabs">
            <view class="store-mode-tab {{genStoreSelectionType === 'existing' ? 'active' : ''}}" data-mode="existing" bindtap="onSwitchGenStoreMode">选择已有门店</view>
            <view class="store-mode-tab {{genStoreSelectionType === 'custom' ? 'active' : ''}}" data-mode="custom" bindtap="onSwitchGenStoreMode">手动输入新门店</view>
          </view>

          <picker wx:if="{{genStoreSelectionType === 'existing'}}" mode="selector" range="{{genStoreOptions}}" range-key="storeName" bindchange="onSelectGenStore">
            <view class="form-picker-selector">
              {{targetGenStoreName ? targetGenStoreName : (genStoreOptions.length > 0 ? '点击选择门店 ▼' : '本机构暂无门店，请切换到"手动输入新门店"')}}
            </view>
          </picker>

          <!-- 🌟 自定义门店输入框常驻 DOM，靠 max-height/opacity 过渡做"向下展开"动画——
               wx:if/wx:else 会直接卸载/挂载元素，没有中间态可过渡，做不出展开效果 -->
          <view class="custom-store-input-wrap {{genStoreSelectionType === 'custom' ? 'expanded' : ''}}">
            <!-- 🌟 本机构暂无门店时会自动切到这一档：这个输入框本身就是"快速新建门店"入口，
                 提交后会直接带入建店流程并自动选中该门店用于生成邀请码，明确告知避免用户误以为
                 只是在填写一个普通备注字段 -->
            <text class="gencode-custom-hint" wx:if="{{genStoreSelectionType === 'custom' && genStoreOptions.length === 0}}">
              本机构暂无门店，在此输入门店名称即可快速新建，创建后将自动选中该门店用于生成邀请码
            </text>
            <input class="gencode-custom-input" placeholder="请输入新门店名称，如：雨花斋厦门海沧店" value="{{genCustomStoreName}}" bindinput="onGenCustomStoreNameInput" />
          </view>
        </view>

        <!-- 2. 选择授权特权角色：默认选中身份由打开入口决定——
             从【财务稽核台】的"邀请协同"进来（onOpenFinanceInviteMenu）默认选中【门店财务】，
             从【门店推广与邀请】进来（onOpenGenCodeModal）默认选中【门店店长】。 -->
        <view class="form-item-row">
          <text class="form-label">2. 选择授权身份：</text>
          <view class="gencode-role-group">
            <view class="gencode-role-item {{genTargetRole === 'MANAGER' ? 'active' : 'inactive'}}"
                  bindtap="onSelectGenRole" data-role="MANAGER">
              <view class="role-check-badge" wx:if="{{genTargetRole === 'MANAGER'}}">✓</view>
              <view class="idx-icon-sm idx-icon-crown" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>
              <text>门店店长</text>
            </view>
            <view class="gencode-role-item {{genTargetRole === 'FINANCE' ? 'active' : 'inactive'}}"
                  bindtap="onSelectGenRole" data-role="FINANCE">
              <view class="role-check-badge" wx:if="{{genTargetRole === 'FINANCE'}}">✓</view>
              <view class="idx-icon-sm idx-icon-lock" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>
              <text>门店财务</text>
            </view>
          </view>
        </view>

        <!-- 3. 生成结果兜底展示区：正常流程点击【立即生成】后会自动复制+关闭弹窗，
             根本看不到这里；只有自动复制到剪贴板失败这一种异常情况才会保留弹窗并显示，
             让用户能长按/点击手动复制邀请码，而不是生成完全"丢失" -->
        <view class="gen-result-box" wx:if="{{generatedCode}}">
          <view class="result-label"><view class="idx-icon-sm idx-icon-sparkle" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>自动复制失败，请点击下方邀请码手动复制：</view>
          <text class="result-code" user-select bindtap="onCopyGeneratedCode">{{generatedCode}}</text>
          <view class="result-tip"><view class="idx-icon-sm idx-icon-warning" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>提示：该邀请码为一次性口令，绑定后立即失效。</view>
        </view>
      </view>

      <!-- 底部操作按钮：固定关闭 + 立即生成两个按钮——点击【立即生成】后一步到位完成
           "生成 + 复制到剪贴板 + 关闭弹窗"，不再需要先生成、再点第二个按钮才复制发送 -->
      <view class="gen-code-footer">
        <button class="btn-cancel" bindtap="onCloseGenCodeModal">关闭</button>
        <button class="btn-primary-gen {{isGeneratingInviteCode ? 'btn-disabled' : ''}}" bindtap="onGenerateInviteCode" loading="{{isGeneratingInviteCode}}" disabled="{{isGeneratingInviteCode}}">
          <view class="idx-icon-sm idx-icon-bolt" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>立即生成
        </button>
      </view>
    </view>
  </view>

  <!-- 🌟 历史名单·选择常客弹窗：按本地缓存的出现次数倒序展示，点一下姓名直接插入
       批量粘贴文本框新的一行，金额仍需用户当天手动填写 -->
  <view class="frequent-donor-modal-mask" wx:if="{{showFrequentDonorModal}}" bindtap="onCloseFrequentDonorModal">
    <view class="frequent-donor-modal-card" catchtap="stopPropagation">
      <!-- 🛡️ 去宗教化合规要求："功德主"是佛教语境里对施主的称谓，统一改用
           "常客"这一现代公益/志愿服务通用称谓，与触发此弹窗的【选择常客】按钮措辞保持一致 -->
      <view class="frequent-donor-header">
        <text class="title">🕒 常客名单</text>
        <text class="close-btn" bindtap="onCloseFrequentDonorModal">✕</text>
      </view>

      <view class="frequent-donor-empty" wx:if="{{frequentDonorList.length === 0}}">
        <text>暂无历史记录，成功提交几次餐报后，这里会自动出现常来支持的爱心人士名单</text>
      </view>

      <scroll-view scroll-y class="frequent-donor-list" wx:else>
        <view class="frequent-donor-item" wx:for="{{frequentDonorList}}" wx:key="name" bindtap="onSelectFrequentDonor" data-name="{{item.name}}">
          <text class="donor-name">{{item.name}}</text>
          <text class="donor-count">出现 {{item.count}} 次</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 🌟 高频账目模板弹窗：门店常用支出项目速录，云端存储、店铺内共享（区别于上面
       "选择常客"的本地设备记忆）。店长/财务/超管可增删，全员可点击插入表单 -->
  <view class="expense-template-modal-mask" wx:if="{{showExpenseTemplateModal}}" bindtap="onCloseExpenseTemplateModal">
    <view class="expense-template-modal-card" catchtap="stopPropagation">
      <view class="expense-template-header">
        <text class="title">🧾 常用支出项目</text>
        <text class="close-btn" bindtap="onCloseExpenseTemplateModal">✕</text>
      </view>

      <view class="expense-template-segmented">
        <view
          class="segment-btn {{expenseTemplateCategory === 'daily' ? 'active' : ''}}"
          bindtap="onSwitchExpenseTemplateCategory"
          data-category="daily"
        ><text class="txt">开餐食材</text></view>
        <view
          class="segment-btn {{expenseTemplateCategory === 'fixed' ? 'active' : ''}}"
          bindtap="onSwitchExpenseTemplateCategory"
          data-category="fixed"
        ><text class="txt">大额专项</text></view>
      </view>

      <view class="expense-template-manage-row" wx:if="{{isManager || isFinance || isSuperAdmin}}">
        <text class="manage-toggle" bindtap="onToggleExpenseTemplateEditMode">{{expenseTemplateEditMode ? '完成' : '✏️ 管理'}}</text>
      </view>

      <view class="expense-template-add-row" wx:if="{{expenseTemplateEditMode}}">
        <input class="name-input" placeholder="项目名称" value="{{expenseTemplateNewName}}" bindinput="onInputExpenseTemplateNewName" />
        <input class="amount-input" type="digit" placeholder="默认金额(选填)" value="{{expenseTemplateNewAmount}}" bindinput="onInputExpenseTemplateNewAmount" />
        <button class="btn-add-item" bindtap="onAddExpenseTemplateItem" loading="{{expenseTemplateSaving}}">+ 添加</button>
      </view>

      <block wx:if="{{expenseTemplateCategory === 'daily'}}">
        <view class="expense-template-empty" wx:if="{{expenseTemplateLoaded && expenseTemplateDailyList.length === 0}}">
          <text>暂无常用项目{{(isManager || isFinance || isSuperAdmin) ? '，点上方"管理"添加几个常买的食材吧' : ''}}</text>
        </view>
        <scroll-view scroll-y class="expense-template-chip-list" wx:else>
          <view class="expense-template-chip" wx:for="{{expenseTemplateDailyList}}" wx:key="_id" bindtap="onSelectExpenseTemplateItem" data-name="{{item.itemName}}" data-amount="{{item.defaultAmount}}">
            <text class="chip-name">{{item.itemName}}</text>
            <text class="chip-amount" wx:if="{{item.defaultAmount}}">¥{{item.defaultAmount}}</text>
            <text class="chip-del" wx:if="{{expenseTemplateEditMode}}" catchtap="onDeleteExpenseTemplateItem" data-id="{{item._id}}">✕</text>
          </view>
        </scroll-view>
      </block>
      <block wx:else>
        <view class="expense-template-empty" wx:if="{{expenseTemplateLoaded && expenseTemplateFixedList.length === 0}}">
          <text>暂无常用项目{{(isManager || isFinance || isSuperAdmin) ? '，点上方"管理"添加房租等固定支出吧' : ''}}</text>
        </view>
        <scroll-view scroll-y class="expense-template-chip-list" wx:else>
          <view class="expense-template-chip" wx:for="{{expenseTemplateFixedList}}" wx:key="_id" bindtap="onSelectExpenseTemplateItem" data-name="{{item.itemName}}" data-amount="{{item.defaultAmount}}">
            <text class="chip-name">{{item.itemName}}</text>
            <text class="chip-amount" wx:if="{{item.defaultAmount}}">¥{{item.defaultAmount}}</text>
            <text class="chip-del" wx:if="{{expenseTemplateEditMode}}" catchtap="onDeleteExpenseTemplateItem" data-id="{{item._id}}">✕</text>
          </view>
        </scroll-view>
      </block>
    </view>
  </view>

  <!-- 图片压缩用离屏画布：餐报表单内"今日食谱照片"/"今日大事记照片"上传区共用 -->
  <canvas type="2d" id="imgCompressCanvas" style="position: fixed; left: -9999px; top: -9999px; width: 1920px; height: 1920px;"></canvas>

  <!-- 店长审核义工绑定抽屉 Modal -->
  <view class="audit-drawer-mask" wx:if="{{showAuditModal}}" bindtap="onCloseAuditModal">
    <view class="audit-drawer-box" catchtap="stopPropagation">

      <!-- Header -->
      <view class="drawer-header-bar">
        <view class="header-title-box">
          <view class="header-icon idx-icon-svg idx-icon-people"></view>
          <text class="header-title-text">门店义工绑定审核</text>
        </view>
        <view class="btn-close-drawer-circle" bindtap="onCloseAuditModal">✕</view>
      </view>

      <!-- Tab 选项卡 -->
      <view class="audit-tab-segment">
        <view
          class="tab-item {{auditActiveTab === 'pending' ? 'active' : ''}}"
          bindtap="onSwitchAuditTab"
          data-tab="pending"
        >
          待审核列表 ({{pendingApplyList.length}})
        </view>
        <view
          class="tab-item {{auditActiveTab === 'approved' ? 'active' : ''}}"
          bindtap="onSwitchAuditTab"
          data-tab="approved"
        >
          已绑定义工 ({{approvedVolunteerList.length}})
        </view>
      </view>

      <!-- 滚动列表区 -->
      <scroll-view scroll-y class="drawer-content-scroll">

        <!-- 待审核列表 -->
        <block wx:if="{{auditActiveTab === 'pending'}}">
          <view class="audit-applicant-card" wx:for="{{pendingApplyList}}" wx:key="_id">
            <view class="card-top-info">
              <view class="applicant-main">
                <text class="applicant-name">{{mask.maskName(item.realName) || '义工家人'}}</text>
                <text class="applicant-phone {{!item.phone ? 'unbound' : ''}}"><view class="idx-icon-sm idx-icon-phone" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>{{item.phone ? mask.maskPhone(item.phone) : '未绑定手机'}}</text>
              </view>
              <text class="role-tag-badge {{item.requestedRole}}">
                {{item.requestedRole === 'finance' ? '财务记账' : '现场奉献'}}
              </text>
            </view>

            <view class="card-time-row">
              <text class="time-lbl">申请门店：{{item.storeSelectionType === 'custom' ? ('🆕 ' + item.customStoreName + '（新建）') : item.storeName}}</text>
            </view>
            <view class="card-time-row">
              <text class="time-lbl">申请时间：{{item.applyTimeStr || '近期'}}</text>
            </view>

            <view class="card-action-btns">
              <button
                class="btn-audit-act reject"
                bindtap="onProcessAudit"
                data-id="{{item._id}}"
                data-action="reject"
              >
                拒绝
              </button>
              <button
                class="btn-audit-act approve"
                bindtap="onProcessAudit"
                data-id="{{item._id}}"
                data-item="{{item}}"
                data-action="approve"
              >
                通过绑定
              </button>
            </view>
          </view>

          <view class="warm-empty-state" wx:if="{{pendingApplyList.length === 0}}">
            <view class="empty-emoji-icon idx-icon-svg idx-icon-sparkle"></view>
            <text class="empty-title">{{auditIsNationalView ? '当前全国各门店暂无待处理的义工申请' : '当前暂无待处理的绑定申请'}}</text>
            <text class="empty-desc" wx:if="{{!auditIsNationalView}}">您可以生成门店邀请海报，邀请财务或现场义工扫码绑定。</text>
            <button class="btn-empty-invite" bindtap="onGenerateStorePosterFromAudit">
              🏪 生成门店邀请海报
            </button>
          </view>
        </block>

        <!-- 已绑定义工列表 -->
        <block wx:if="{{auditActiveTab === 'approved'}}">
          <view class="audit-applicant-card approved-card" wx:for="{{approvedVolunteerList}}" wx:key="_id">
            <view class="card-top-info">
              <view class="applicant-main">
                <text class="applicant-name">{{mask.maskName(item.realName)}}</text>
                <text class="applicant-phone {{!item.phone ? 'unbound' : ''}}"><view class="idx-icon-sm idx-icon-phone" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>{{item.phone ? mask.maskPhone(item.phone) : '未绑定手机'}}</text>
              </view>
              <text class="role-tag-badge {{item.role}}">
                {{item.role === 'finance' ? '财务记账' : '现场奉献'}}
              </text>
            </view>

            <view class="card-action-btns">
              <button
                class="btn-audit-act change-role"
                bindtap="onChangeVolunteerRole"
                data-id="{{item._id}}"
              >
                🔄 修改角色
              </button>
              <button
                class="btn-audit-act unbind"
                bindtap="onUnbindVolunteer"
                data-id="{{item._id}}"
              >
                🚫 解除绑定
              </button>
            </view>
          </view>

          <view class="warm-empty-state" wx:if="{{approvedVolunteerList.length === 0}}">
            <view class="empty-emoji-icon idx-icon-svg idx-icon-flower"></view>
            <text class="empty-title">本店暂无已绑定的义工</text>
          </view>
        </block>

      </scroll-view>
    </view>
  </view>

  <!-- 门店邀请海报预览 Modal -->
  <view class="store-poster-mask" wx:if="{{showStorePosterModal}}" catchtap="onCloseStorePosterModal">
    <view class="store-poster-box" catchtap="stopPropagation">
      <view class="modal-header-row">
        <view class="modal-title"><view class="idx-icon-sm idx-icon-image" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>门店邀请绑定海报</view>
        <view class="btn-close-modal-circle" bindtap="onCloseStorePosterModal">
          ✕
        </view>
      </view>

      <view class="poster-canvas-wrapper">
        <canvas
          type="2d"
          id="storePosterCanvas"
          class="poster-canvas"
          style="width: 320px; height: 500px;"
        ></canvas>
      </view>

      <view class="poster-actions-bar">
        <button class="btn-share-single-line" open-type="share" bindtap="onSharePosterToFriends">
          <view class="idx-icon-sm idx-icon-chat" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>分享给微信群和朋友
        </button>
      </view>
      <view class="poster-bottom-tip">可打印贴于财务桌或保存发至微信群</view>
    </view>
  </view>

  <view class="modal-backdrop" wx:if="{{showShiftSelectModal}}">
    <view class="modal-card shift-card">
      <view class="modal-header">
        <view class="header-titles">
          <view class="modal-title"><view class="idx-icon-sm idx-icon-flower" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>请选择今日护持岗位班次</view>
          <text class="today-hours-tip {{isOverHoursLimit ? 'over-limit' : ''}}">今日已记录工时：<text class="highlight {{isOverHoursLimit ? 'danger' : ''}}">{{previewTotalHours}}h</text> / 上限 12h</text>
          <text class="over-limit-warning" wx:if="{{isOverHoursLimit}}">⚠️ 工时超出每日上限</text>
        </view>
        <text class="close-btn" bindtap="onCloseShiftModal">✕</text>
      </view>

      <scroll-view scroll-y class="shift-scroll-area">
        <view class="shift-option-list">
          <block wx:for="{{availableShifts}}" wx:key="shiftKey">
            <view class="shift-item {{item.isCompleted ? 'disabled-completed' : (selectedShift === item.shiftKey ? 'active' : '')}}"
                  bindtap="{{item.isCompleted ? '' : 'onSelectShift'}}"
                  data-shift="{{item.shiftKey}}"
                  data-hours="{{item.hours}}">
              <view class="shift-check-badge" wx:if="{{!item.isCompleted && selectedShift === item.shiftKey}}">✓</view>
              <view class="shift-left">
                <view class="shift-name-row">
                  <text class="shift-name">{{item.name}}</text>
                  <text class="completed-tag" wx:if="{{item.isCompleted}}">✔ 今日已打卡</text>
                </view>
                <text class="shift-time">{{item.timeDesc}}</text>
              </view>
              <text class="shift-hours">+{{item.hours}}h</text>
            </view>
          </block>
        </view>

        <view class="today-checked-section" wx:if="{{todayLogs.length > 0}}">
          <view class="section-title"><view class="idx-icon-sm idx-icon-pin" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>今日已打卡记录 (误选可撤销)：</view>
          <view class="today-log-chip" wx:for="{{todayLogs}}" wx:key="timestamp">
            <text class="log-info">{{item.shiftName}} (+{{item.hours}}h)</text>
            <text class="btn-revoke" bindtap="onRevokeTodayCheckIn" data-timestamp="{{item.timestamp}}" data-hours="{{item.hours}}">撤销</text>
          </view>
        </view>
      </scroll-view>

      <view class="meal-reserve-row" bindtap="onToggleMealReserve">
        <checkbox checked="{{willEatLunch}}" color="#8C1D18"/>
        <text class="meal-tip">今日留在门店用餐 (方便后厨预留菜量)</text>
      </view>

      <button class="btn-confirm-checkin {{(allShiftsCompleted || isOverHoursLimit) ? 'btn-disabled' : ''}}"
              loading="{{checkInSubmitting}}"
              disabled="{{allShiftsCompleted || isOverHoursLimit || checkInSubmitting}}"
              bindtap="onConfirmShiftCheckIn">
        {{allShiftsCompleted ? '今日班次已全部完成' : (isOverHoursLimit ? '工时超出每日上限' : '确认打卡')}}
      </button>
    </view>
  </view>

  <!-- 生成餐报文本/海报本就是"填写当日明细"表单（见 form-main-card）的后续动作，
       两者的可见性必须完全一致，否则会出现"能看到表单却找不到提交按钮"的空页面——
       🐛 历史教训：这里曾经单独写成比表单条件更严格的角色判断，导致部分角色能看到表单却看不到按钮。
       现在表单已经对所有非志工角色（含纯财务）开放，这里只保留 !isVolunteer，与表单条件保持同步。 -->
  <!-- 🐛 修复图标"看不见"问题的真正根因：.idx-icon-bolt / .idx-icon-palette 是内联 base64 SVG
       background-image，stroke 颜色写死为 #FFFFFF，不会跟随按钮文字颜色变化——白底红字的左按钮上，
       白色图标直接和白色背景融为一体（看起来像"没有图标"）；金色底的右按钮上白色图标也和金黄背景
       低对比度重叠。SVG 图标系统这里没法简单换色，改用原生 emoji 字符作为图标（用户自身颜色不受
       按钮 color 影响，天然清晰可辨，也是需求里给出的示例做法），一步到位解决对比度问题。 -->
  <view class="bottom-action-floating-bar" wx:if="{{!isVolunteer}}">
    <button class="btn-main-action text-gen-btn {{isSubmitting ? 'btn-disabled' : ''}}" hover-class="btn-hover" bindtap="generateReport" loading="{{isSubmitting}}" disabled="{{isSubmitting}}">
      <text class="btn-emoji-icon">📋</text>生成餐报文本
    </button>
    <button class="btn-main-action poster-gen-btn" hover-class="btn-hover" bindtap="onGeneratePoster" loading="{{isGeneratingPoster}}" disabled="{{isGeneratingPoster || !showResult}}" style="background: linear-gradient(135deg, #C62828 0%, #B71C1C 100%) !important; color: #FFFFFF !important; opacity: 1 !important; border: none !important; font-weight: bold !important;">
      <text class="btn-emoji-icon">🎨</text>生成公示海报
    </button>
  </view>

  <!-- 任务A：我的雨花护持档案弹窗 -->
  <archive-modal
    visible="{{showArchiveModal}}"
    userInfo="{{archiveUserInfo}}"
    bind:close="onCloseArchiveModal"
    bind:viewJourney="onViewJourneyFromArchive"
  />

  <!-- 🌟 合规 Footer：常驻展示，字体清晰可读但视觉弱化——不与主功能抢视觉焦点，
       但也不是此前那种几乎看不见的灰色小字。完整版声明见页面顶部的强制阅读弹窗
       （showComplianceModal / checkComplianceNotice），这里是精简常驻版，
       点击可随时重新查看完整声明全文 -->
  <view class="compliance-footer">
    <view class="compliance-footer-row">
      <view class="compliance-footer-icon idx-icon-sm idx-icon-warning"></view>
      <text class="compliance-footer-text">本小程序为民间公益志愿者团队独立开发维护的内部记账与信息公示辅助工具，非「雨花斋」品牌官方发布，不提供任何形式的网络募捐、众筹或代收款项服务。</text>
    </view>
    <text class="compliance-footer-link" bindtap="onViewFullComplianceNotice">查看完整声明 ›</text>
  </view>

  <!-- 🌟 财务专属功能区：稽核与封账弹窗（按月批量锁定已通过店长确认的账本记录） -->
  <view class="finance-modal-mask" wx:if="{{showFinanceLockModal}}" bindtap="onCloseFinanceLockModal">
    <view class="finance-modal-card" catchtap="stopPropagation">
      <view class="finance-modal-header">
        <text class="finance-modal-title">🔒 稽核与封账</text>
        <view class="finance-modal-close" bindtap="onCloseFinanceLockModal">✕</view>
      </view>

      <text class="finance-modal-desc">选择要封账的月份，该月内所有已通过店长确认的记录将被批量锁定，锁定后店长无法再编辑或作废。</text>

      <picker mode="date" fields="month" value="{{financeLockMonthStr}}" bindchange="onFinanceLockMonthChange">
        <view class="finance-month-picker">
          <text>{{financeLockMonthStr || '请选择月份'}}</text>
          <text class="arrow">▼</text>
        </view>
      </picker>

      <button class="finance-modal-confirm-btn" bindtap="onConfirmFinanceLock" disabled="{{financeLockInFlight}}">
        {{financeLockInFlight ? '封账中...' : '确认封账'}}
      </button>
    </view>
  </view>

  <!-- 🌟 财务专属功能区：风控预警日志弹窗 -->
  <view class="finance-modal-mask" wx:if="{{showRiskAlertsModal}}" bindtap="onCloseRiskAlertsModal">
    <view class="finance-modal-card" catchtap="stopPropagation">
      <view class="finance-modal-header">
        <text class="finance-modal-title">⚠️ 风控预警日志</text>
        <view class="finance-modal-close" bindtap="onCloseRiskAlertsModal">✕</view>
      </view>

      <text class="finance-modal-desc">近 60 天内的异常信号：红字冲销频次、小票缺失、余额异常突变</text>

      <view class="risk-summary-row" wx:if="{{!riskAlertsLoading}}">
        <view class="risk-summary-item">
          <text class="risk-summary-num">{{riskAlertsSummary.voidCount}}</text>
          <text class="risk-summary-label">红字冲销</text>
        </view>
        <view class="risk-summary-item">
          <text class="risk-summary-num">{{riskAlertsSummary.missingReceiptCount}}</text>
          <text class="risk-summary-label">小票缺失</text>
        </view>
        <view class="risk-summary-item">
          <text class="risk-summary-num">{{riskAlertsSummary.balanceAnomalyCount}}</text>
          <text class="risk-summary-label">余额异常</text>
        </view>
      </view>

      <view class="risk-loading" wx:if="{{riskAlertsLoading}}">
        <text>加载中...</text>
      </view>

      <scroll-view scroll-y class="risk-alert-list" wx:if="{{!riskAlertsLoading}}">
        <view class="risk-alert-item {{item.level}}" wx:for="{{riskAlertsList}}" wx:key="index">
          <text class="risk-alert-date">{{item.dateString}}</text>
          <text class="risk-alert-msg">{{item.message}}</text>
        </view>
        <view class="risk-alert-empty" wx:if="{{riskAlertsList.length === 0}}">
          <text>✅ 近期账本未发现异常信号</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <side-drawer id="sideDrawer"
    store-name="{{currentStoreName || shopName}}"
    role-label="{{isSuperAdmin ? '超级管理员' : (isManager ? '店长' : (isFinance ? '财务' : '义工'))}}"
    is-manager="{{isManager}}"
    is-finance="{{isFinance}}"
    is-super-admin="{{isSuperAdmin}}"
    bind:action="onSideDrawerAction" />
</view>