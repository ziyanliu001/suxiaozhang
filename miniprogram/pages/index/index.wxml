  <!-- 小票识别确认弹窗 -->
  <view class="ocr-confirm-modal" wx:if="{{showOcrConfirmModal}}">
    <view class="ocr-mask" bindtap="onOcrConfirmCancel"></view>
    <view class="ocr-modal-card" catchtap="stopPropagation">
      <view class="ocr-modal-header">
        <text class="ocr-modal-title">识别结果确认</text>
        <view class="ocr-modal-close" bindtap="onOcrConfirmCancel">✕</view>
      </view>

      <view class="ocr-modal-subtitle">
        成功识别 {{ocrSuccessCount}} 张小票
        <text class="ocr-total" wx:if="{{ocrSuccessCount > 0}}">，合计：¥{{ocrTotalAmount}}</text>
        <text class="ocr-fail-tip" wx:if="{{ocrFailCount > 0}}">（{{ocrFailCount}} 张未识别）</text>
      </view>

      <scroll-view scroll-y class="ocr-detail-container">
        <block wx:for="{{ocrReceiptList}}" wx:key="index">
          <view class="ocr-receipt-block">
            <view class="ocr-receipt-title">
              <text class="receipt-index">第 {{index + 1}} 张</text>
              <text class="receipt-merchant">{{item.merchantName}}</text>
              <text class="receipt-amount">¥{{item.amount}}</text>
            </view>
            <view class="ocr-item-list" wx:if="{{item.itemList && item.itemList.length > 0}}">
              <view class="ocr-detail-row" wx:for="{{item.itemList}}" wx:for-item="subItem" wx:for-index="subIdx" wx:key="subIdx">
                <text class="bullet">•</text>
                <input class="input-item-name" value="{{subItem.name}}" bindinput="onEditOcrItemName" data-receipt-index="{{index}}" data-item-index="{{subIdx}}" />
                <view class="price-edit-wrap">
                  <text class="symbol">¥</text>
                  <input class="input-item-price" type="digit" value="{{subItem.price}}" bindinput="onEditOcrItemPrice" data-receipt-index="{{index}}" data-item-index="{{subIdx}}" />
                </view>
              </view>
            </view>
            <view class="ocr-detail-fallback" wx:else>
              <text>{{item.formattedText}}</text>
            </view>
          </view>
        </block>
      </scroll-view>

      <view class="ocr-modal-footer">
        <button class="ocr-btn cancel" bindtap="onOcrConfirmCancel">取消</button>
        <button class="ocr-btn adjust" bindtap="onOcrAdjustCategory">调整分类</button>
        <button class="ocr-btn confirm" bindtap="onOcrAutoFill">自动填入</button>
      </view>
    </view>
  </view>

