  <!-- ❤️ 家人（服务对象）「透明监督版」首页：不填报表、不需要计算工具，
       专注三件事——阳光账本大盘、今日菜谱、雨花大事记与护持剪影 -->
  <block wx:elif="{{isFamily}}">
    <scroll-view scroll-y class="page-body-scroll">
      <view class="family-home-container">

        <!-- 模块一：阳光账本核心大盘——复用弹窗那套 sunshineLedgerData/sunshineStatCards
             数据管线（见 onShow 里的自动拉取），点击整卡打开既有的 8 项详情弹窗 -->
        <view class="family-sunshine-hero-card" bindtap="onOpenSunshineLedger">
          <view class="fsh-badge">☀️ 公开透明 · 全民监督</view>
          <text class="fsh-store-name">{{sunshineLedgerData.storeName || currentStoreName || shopName || '本门店'}}</text>
          <text class="fsh-period">{{sunshineLedgerData.periodLabel || ''}}阳光账本</text>

          <view class="fsh-hero-row">
            <view class="fsh-hero-cell">
              <text class="fsh-hero-num">{{sunshineLedgerData.totalDiners || 0}}</text>
              <text class="fsh-hero-label">累计就餐人次</text>
            </view>
            <view class="fsh-hero-divider"></view>
            <view class="fsh-hero-cell">
              <text class="fsh-hero-num">{{sunshineLedgerData.volunteerCount || 0}}</text>
              <text class="fsh-hero-label">参与护持总人次</text>
            </view>
            <view class="fsh-hero-divider"></view>
            <view class="fsh-hero-cell">
              <text class="fsh-hero-num">{{sunshineLedgerData.auditedReportsCount || 0}}</text>
              <text class="fsh-hero-label">已核销餐报篇数</text>
            </view>
          </view>

          <view class="fsh-footer">
            <text class="fsh-footer-text">🛡️ 数据经店长/财务双重核销后公开展示</text>
            <text class="fsh-footer-link">查看完整账本 ›</text>
          </view>
        </view>

        <!-- 模块二：今日菜谱展示——大字号、高对比度，专注让家人一眼看清今天吃什么 -->
        <view class="family-menu-card">
          <view class="fm-header">
            <text class="fm-title">🍱 今日菜谱</text>
            <text class="fm-date">{{todayDateStr}}</text>
          </view>
          <view class="fm-body" wx:if="{{todayMenu}}">
            <view class="fm-9grid" wx:if="{{todayMenu.images.length > 0}}">
              <view class="fm-grid-item" wx:for="{{todayMenu.images}}" wx:for-item="img" wx:key="url">
                <image wx:if="{{!previewImagesFailedMap[img.thumbUrl]}}" class="fm-grid-img" src="{{img.thumbUrl}}" mode="aspectFill" lazy-load="{{true}}" binderror="onPreviewCardImageLoadError" data-url="{{img.thumbUrl}}" />
                <view wx:else class="thumb-load-failed" catchtap="onRetryPreviewCardImage" data-url="{{img.thumbUrl}}">
                  <text class="thumb-load-failed-icon">⚠️</text>
                  <text class="thumb-load-failed-text">加载失败</text>
                </view>
              </view>
            </view>
            <text class="fm-text">{{todayMenu.menuText || '（未填写文字菜谱，见图片）'}}</text>
          </view>
          <view class="fm-empty" wx:elif="{{todayMenuLoaded}}">
            <text class="fm-empty-icon">🍚</text>
            <text class="fm-empty-text">今日菜谱尚未发布，感恩耐心等候 🌸</text>
          </view>
        </view>

        <!-- 模块三：雨花大事记与护持剪影 -->
        <view class="family-activity-card">
          <view class="fa-header">
            <text class="fa-title">📌 雨花大事记与护持剪影</text>
          </view>
          <view class="fa-body" wx:if="{{todayActivity}}">
            <view class="fa-9grid" wx:if="{{todayActivity.images.length > 0}}">
              <view class="fa-grid-item" wx:for="{{todayActivity.images}}" wx:for-item="img" wx:key="url">
                <image wx:if="{{!previewImagesFailedMap[img.thumbUrl]}}" class="fa-grid-img" src="{{img.thumbUrl}}" mode="aspectFill" lazy-load="{{true}}" binderror="onPreviewCardImageLoadError" data-url="{{img.thumbUrl}}" />
                <view wx:else class="thumb-load-failed" catchtap="onRetryPreviewCardImage" data-url="{{img.thumbUrl}}">
                  <text class="thumb-load-failed-icon">⚠️</text>
                  <text class="thumb-load-failed-text">加载失败</text>
                </view>
              </view>
            </view>
            <text class="fa-text">{{todayActivity.title}}</text>
          </view>
          <view class="fa-empty" wx:elif="{{todayActivityLoaded}}">
            <text class="fa-empty-icon">🌸</text>
            <text class="fa-empty-text">今日暂无护持剪影，感恩每一份默默付出</text>
          </view>
        </view>

      </view>
    </scroll-view>
