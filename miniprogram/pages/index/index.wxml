<view class="page-container">
  <view class="header-container" style="padding-top: {{headerSafeTop}}px;">
    <view class="header-title">{{shopName}}用餐汇报助手</view>
  </view>

  <view class="draft-banner" wx:if="{{hasDraft}}">
    <text class="draft-icon">📝</text>
    <text class="draft-text">当前正在编辑保存的草稿</text>
    <text class="draft-action" bindtap="discardDraft">[丢弃草稿]</text>
  </view>

  <view class="offline-banner" wx:if="{{offlineQueueCount > 0}}" bindtap="syncOfflineQueueManually">
    <text class="offline-icon">📦</text>
    <text class="offline-text">有 {{offlineQueueCount}} 条离线账目待同步</text>
    <text class="offline-action">[点击立即重传]</text>
  </view>

  <scroll-view scroll-y="true" class="content-scroll">
    <view class="section">
      <view class="toggle-header" bindtap="toggleSettings">
        <text class="toggle-icon">⚙️</text>
        <text class="toggle-title">店铺模板自定义</text>
        <text class="toggle-arrow">{{showSettings ? '▼' : '▶'}}</text>
      </view>
      <view class="toggle-content" wx:if="{{showSettings}}">
        <view class="row">
          <view class="col">
            <text class="label">店铺名称</text>
            <input class="input" value="{{shopName}}" bindinput="onInput" data-field="shopName" />
          </view>
          <view class="col">
            <text class="label">公众号名称</text>
            <input class="input" value="{{mpAccount}}" bindinput="onInput" data-field="mpAccount" />
          </view>
        </view>
      </view>
    </view>

    <view class="form-card">
      <view class="card-action-bar">
        <text class="card-tip">✨ 请填写当日明细：</text>
        <view class="reset-link" bindtap="resetForm">🧹 清空输入</view>
      </view>
      
      <view class="section">
        <view class="form-row">
          <view class="form-item">
            <text class="label">汇报日期</text>
            <input class="input-box gray-bg" value="{{reportDate}}" disabled />
          </view>
          <view class="form-item">
            <view class="label-bar">
              <text class="label">昨日店铺余额</text>
              <view class="edit-toggle" bindtap="toggleBalanceLock">
                {{isBalanceLocked ? '🔓 手动修改' : '🔒 锁定自动'}}
              </view>
            </view>
            <input class="input-box {{isBalanceLocked ? 'gray-bg' : ''}}"
                   type="digit"
                   value="{{yesterdayBalance}}"
                   disabled="{{isBalanceLocked}}"
                   bindinput="onYesterdayBalanceInput" />
            <view class="adjust-tag" wx:if="{{isManualAdjust}}">
              <text class="adjust-icon">⚠️</text>
              <text class="adjust-text">已手动调账（差额：{{balanceDiff >= 0 ? '+' : ''}}¥{{balanceDiff.toFixed(2)}}）</text>
            </view>
          </view>
        </view>
      </view>

      <view class="section">
        <text class="label">爱心人士供养总输入框 (支持一次性粘贴所有名单，每行一个)</text>
        <view class="textarea-wrap">
          <textarea class="textarea" auto-height placeholder="{{donationPlaceholder}}" value="{{allDonations}}" bindinput="onInput" data-field="allDonations" />
        </view>

        <view class="parse-preview" wx:if="{{parseResult.items.length > 0 || parseResult.unrecognizedLines.length > 0}}">
          <view class="preview-header">
            <text class="preview-title">📋 解析结果预览</text>
            <view class="preview-summary">
              <text class="summary-item">人数：{{parseResult.totalCount}}</text>
              <text class="summary-item">金额：¥{{parseResult.totalAmount.toFixed(2)}}</text>
            </view>
          </view>
          
          <view class="preview-list">
            <view class="preview-item" wx:for="{{parseResult.items}}" wx:key="name">
              <text class="item-name">{{item.name}}</text>
              <text class="item-amount">¥{{item.amount}}</text>
            </view>
          </view>

          <view class="preview-errors" wx:if="{{parseResult.unrecognizedLines.length > 0}}">
            <view class="error-item" wx:for="{{parseResult.unrecognizedLines}}" wx:key="index">
              <text class="error-icon">⚠️</text>
              <text class="error-text">{{item}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="form-group">
        <text class="label">其他随喜/现场供养金额 (对应示例末尾固定加项)</text>
        <input class="input-box" type="digit" placeholder="如：5" model:value="{{otherDonation}}" />
      </view>

      <view class="section">
        <text class="label">店铺支出说明 (请在末尾带上数字，如：装修地板2000)</text>
        <input class="input" placeholder="例如：装修地板2000" value="{{expenses}}" bindinput="onInput" data-field="expenses" />
        
        <view class="receipt-upload-area">
          <text class="receipt-label">📸 支出凭证/收据（选填）</text>
          <view class="receipt-images">
            <view class="receipt-image-item" wx:for="{{receiptImages}}" wx:key="index" bindtap="previewReceipt" data-index="{{index}}">
              <image class="receipt-image" src="{{item}}" mode="aspectFill" />
              <view class="receipt-delete" bindtap="deleteReceipt" data-index="{{index}}">
                <text class="delete-icon">×</text>
              </view>
            </view>
            <view class="receipt-add-btn" wx:if="{{receiptImages.length < 3}}" bindtap="chooseReceiptImages">
              <text class="add-icon">+</text>
              <text class="add-text">上传小票/收据</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <block wx:if="{{showResult}}">
      <view class="output-box">
        <text class="label">生成结果：</text>
        <text class="output-text" user-select>{{reportResult}}</text>
        <button class="btn-copy" bindtap="copyText">📋 复制文本到剪贴板</button>
      </view>
    </block>
  </scroll-view>

  <view class="footer-bar">
    <button class="action-btn btn-red {{isSubmitting ? 'btn-disabled' : ''}}" hover-class="btn-hover" bindtap="generateReport" loading="{{isSubmitting}}" disabled="{{isSubmitting}}">⚡ 一键生成汇报文本</button>
    <button class="action-btn btn-gold" hover-class="btn-hover" bindtap="onGeneratePoster" loading="{{isGeneratingPoster}}" disabled="{{isGeneratingPoster || !showResult}}">🎨 生成功德海报</button>
    <view class="btn-group">
      <button class="btn-history" bindtap="goToHistory">📜 历史</button>
      <button class="btn-statistics" bindtap="goToStatistics">📊 统计</button>
    </view>
  </view>

  <canvas type="2d" id="posterCanvas" style="position: fixed; left: -9999px; top: 0; width: 375px; height: 667px;"></canvas>

  <view class="poster-modal" wx:if="{{showPoster}}" bindtap="closePoster">
    <view class="modal-mask"></view>
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">功德海报预览</text>
        <view class="modal-close" bindtap="closePoster">
          <text class="close-icon">×</text>
        </view>
      </view>
      <view class="modal-body">
        <image class="poster-image" src="{{posterImage}}" mode="widthFix" />
      </view>
      <view class="modal-footer">
        <button class="btn-close" bindtap="closePoster">关闭</button>
        <button class="btn-save" bindtap="savePoster">保存到相册</button>
      </view>
    </view>
  </view>
</view>