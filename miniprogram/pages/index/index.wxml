<wxs src="./index.wxs" module="mask" />
<view class="index-page-container">
  <!-- 🌟 微信用户隐私授权弹窗：本页会调用 chooseAvatar/chooseMedia 等隐私接口
       （拍照识别小票、爱心支持明细图片识别等），必须放置该组件才能正常弹出授权 -->
  <privacy-popup />

  <!-- 🌟 合规授权须知弹窗（组件一）：'general'/'privileged' 场景下强制阅读——
       不提供关闭按钮、mask 不绑定 tap，用户只能点底部按钮确认后才能继续使用；
       'review' 场景（从底部 Footer「查看完整声明」点进来）已经通过强制阅读，
       允许随时自由关闭，不重复写入确认标记 -->
  <view class="compliance-modal-mask" wx:if="{{showComplianceModal}}">
    <view class="compliance-modal-card">
      <view class="compliance-modal-header">
        <text class="compliance-modal-title">重要声明与合规须知</text>
        <view class="compliance-modal-close" wx:if="{{complianceModalScene === 'review'}}" bindtap="onCloseComplianceReview">✕</view>
      </view>

      <scroll-view scroll-y class="compliance-modal-body">
        <view class="compliance-section">
          <view class="compliance-section-title">一、开发主体与身份声明</view>
          <view class="compliance-section-text">本小程序「雨花爱心餐报助手」由民间素食公益志愿者（义工）团队基于公益服务需求自发开发与维护，用于协助素食公益食堂进行内部餐报记录与信息公示。<text class="compliance-emphasis">本程序并非"雨花斋"商标持有人、雨花斋总部或其关联机构官方发布、授权或运营的产品</text>，与雨花斋总部及各地分支机构无隶属、代理或授权关系。程序内出现的"雨花""雨花斋"等字样，仅为沿用民间素食公益活动的通用称谓与历史习惯用语，不代表任何商标权利主张，亦不用于任何商业用途。</view>
        </view>

        <view class="compliance-section">
          <view class="compliance-section-title">二、功能定位声明</view>
          <!-- 🛡️ 去宗教化合规要求（用户已确认范围：仅本弹窗内文案，parser.ts 解析关键词与
               代码注释保留不动，避免影响既有解析逻辑）："供养"替换为"支持/资助" -->
          <view class="compliance-section-text">本小程序仅作为面向公益食堂内部使用的<text class="compliance-emphasis">数字化辅助记账与信息公示工具</text>，核心功能包括：当日开餐食材支出的录入与核算、爱心支持/资助/护持款项的手工登记与自动核对、以及供内部/信息公示使用的餐报文本与海报生成。所有数据处理均围绕已发生的线下业务展开，旨在提升门店账目透明度与信息化管理效率。</view>
        </view>

        <view class="compliance-section">
          <view class="compliance-section-title">三、资金与募捐合规声明（重要）</view>
          <view class="compliance-section-text"><text class="compliance-emphasis">本小程序不具备、也绝不提供任何形式的线上募捐、众筹、善款代收、在线支付或资金归集功能。</text>小程序内展示的所有金额数据，均为门店义工/店长/财务人员对线下已实际发生的现金或实物支持/资助、开支进行的后期人工录入与信息公示，仅用于账目留痕与对外透明公示，不构成、也不应被理解为面向公众的网络募捐邀约或众筹行为。如您希望向相关公益组织提供支持，请通过其官方、合规渠道进行。</view>
        </view>

        <view class="compliance-section">
          <view class="compliance-section-title">四、信息安全声明</view>
          <view class="compliance-section-text">程序中涉及的姓名等个人信息，已按照相关法律法规要求进行必要的脱敏处理，仅用于门店内部核账与公示用途，不作其他用途使用。</view>
        </view>
      </scroll-view>

      <view class="compliance-modal-footer">
        <button wx:if="{{complianceModalScene !== 'review'}}" class="compliance-confirm-btn" bindtap="onAcknowledgeCompliance">我已阅读并知悉其非官方属性</button>
        <button wx:else class="compliance-confirm-btn compliance-confirm-btn-review" bindtap="onCloseComplianceReview">关闭</button>
      </view>
    </view>
  </view>
  <view class="app-header-section" style="padding-top: {{headerSafeTop}}px;">
    <view class="main-title-header-box">
      <view class="hamburger-menu-btn" bindtap="onOpenSideDrawer" hover-class="capsule-hover">
        <view class="hamburger-line"></view>
        <view class="hamburger-line"></view>
        <view class="hamburger-line"></view>
      </view>
      <text class="brand-header-title">素小账志愿服务</text>
    </view>

    <view class="capsule-bar-row">
      <store-picker id="storePicker" bind:storechange="onStoreChanged" bind:storelistchange="onStoreListChanged" />
      <!-- 🌟 财务角色专属的轻量邀请入口：管理员/超管已经有【门店推广与邀请】宫格卡片可以生成邀请码，
           唯独纯财务角色（isFinance 且非 isManager）此前完全没有入口——财务稽核台以数据安全/对账
           为核心，不适合再放一整张运营推广卡片，所以选择和"帮助"同款的极简小图标胶囊，
           零卡片高度占用，命名也从泛化的"邀请"改成符合财务语境的"邀请协同"，见 onOpenFinanceInviteMenu -->
      <view class="btn-invite-capsule" wx:if="{{isFinance && !isManager}}" bindtap="onOpenFinanceInviteMenu">
        <view class="idx-icon-sm idx-icon-key"></view> 邀请协同
      </view>
      <view class="btn-help-capsule" bindtap="onNavigateToHelp"><view class="idx-icon-sm idx-icon-help"></view> 帮助</view>
    </view>
  </view>

  <!-- 🌟 视角切换预览提示条：仅超级管理员在非全景视角下可见，避免误以为真的丢失了管理权限 -->
  <view class="preview-mode-banner" wx:if="{{isRealSuperAdmin && currentViewMode !== 'SUPER_ADMIN'}}" bindtap="onNavigateToProfile">
    <text class="preview-mode-text">👁️ 正在预览【{{currentViewMode === 'STORE_MANAGER' ? '店长视角' : '财务视角'}}】，实际操作仍以超级管理员权限执行</text>
    <text class="preview-mode-link">去切回 ›</text>
  </view>

  <!-- 🌟 C位核心：欢迎语 + 护持统计 + 打卡 CTA，志工视角下置于胶囊下方最顶部，
       作为页面第一视觉焦点，不再被公告栏/食谱大事记预览卡挤到后面 -->
  <view class="volunteer-hero-card" wx:if="{{isVolunteer}}">
    <view class="v-header">
      <view class="v-title"><view class="idx-icon-sm idx-icon-flower"></view> 欢迎回到 {{isAllStoresView ? '雨花大家庭' : (currentStoreName || shopName || '海沧区雨花斋')}}</view>
      <text class="v-sub">端上一碗热饭，温暖世间一颗心</text>
    </view>

    <!-- 🌟 核心荣誉统计面板：置于卡片头部，数字放大，并附温情激励语增强归属感 -->
    <view class="volunteer-stats-banner" bindtap="onOpenMyCheckInHistory" hover-class="volunteer-stats-banner-hover" hover-stay-time="120">
      <view class="volunteer-stats-row">
        <view class="stat-item">
          <text class="stat-num">{{myCheckInDays || 12}}</text>
          <text class="stat-label">已护持/天</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-num">{{myCheckInCount || 15}}</text>
          <text class="stat-label">累计打卡/次</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-num">{{myServiceHours || 45}}</text>
          <text class="stat-label">贡献时长/h</text>
        </view>
      </view>
      <!-- 🛡️ 去宗教化合规要求："愿心"/"发心"均带有宗教色彩，统一替换为"爱心"/"支持"等现代公益用语 -->
      <text class="warm-encourage-text">{{myCheckInDays > 0 ? '感恩您已护持 ' + myCheckInDays + ' 天，爱心相续 🌸' : '这是您护持之路的开始，感恩支持 🌸'}}</text>
      <view class="journey-entry-row">
        <text class="journey-entry-text">📜 服务历程</text>
        <text class="journey-entry-arrow">›</text>
      </view>
    </view>

    <!-- 🌟 第一核心操作：义工到岗打卡，紧随统计面板之后，视觉最突出 -->
    <view class="v-action-box {{highlightCheckInCard ? 'highlight-pulse' : ''}}" id="checkInCard">
      <button
        class="btn-volunteer-checkin {{allShiftsCompleted ? 'state-done' : (todayLogs.length > 0 ? 'state-partial' : 'state-pending')}}"
        bindtap="onVolunteerCheckIn"
      >
        <view class="idx-icon-sm idx-icon-handshake"></view>
        {{allShiftsCompleted ? '✅ 今日已打卡（查看记录）' : (todayLogs.length > 0 ? '继续到岗打卡' : '志愿者到岗服务打卡')}}
      </button>
      <text class="link-view-public-ledger" bindtap="goToStatistics">📖 查看公开账本 ›</text>
    </view>
  </view>

  <!-- 🌟 全角色到岗打卡卡片：店长/财务此前完全看不到打卡入口——打卡按钮被锁死在只对
       isVolunteer 渲染的 volunteer-hero-card 里，而 onVolunteerCheckIn/onConfirmShiftCheckIn
       这两个真正写打卡数据的函数本身完全不关心角色，只按当天日期+班次去重、只写
       my_checkin_days/my_service_hours 这类与角色无关的本地存储——也就是说打卡功能本来就是
       "全角色通用"的，唯独入口按钮被裹在义工专属卡片里出不来。这里新增一张不依赖角色的
       打卡卡片，只在非义工视角下渲染，复用同一套 onVolunteerCheckIn 逻辑与打卡按钮样式，
       不改动 volunteer-hero-card 本身，避免给已经跑得好好的义工端引入回归风险。 -->
  <view class="omni-checkin-card" wx:if="{{!isVolunteer}}">
    <view class="omni-checkin-header">
      <text class="omni-checkin-title">🙋 志愿服务打卡</text>
      <text class="omni-checkin-sub">{{currentUserRole === 'store_manager' ? '店长' : (currentUserRole === 'finance' ? '财务' : '管理员')}}身份同样可以记录到岗时长，与全体志愿者共享同一份服务足迹</text>
    </view>
    <button
      class="btn-volunteer-checkin omni-checkin-btn {{allShiftsCompleted ? 'state-done' : (todayLogs.length > 0 ? 'state-partial' : 'state-pending')}}"
      bindtap="onVolunteerCheckIn"
    >
      <view class="idx-icon-sm idx-icon-handshake"></view>
      {{allShiftsCompleted ? '✅ 今日已打卡（查看记录）' : (todayLogs.length > 0 ? '继续到岗打卡' : '志愿者到岗服务打卡')}}
    </button>

    <!-- 次级跳转：滚动定位到下方对应的管理/财务控制台卡片，不是另开一个页面——
         那张卡片本来就在同一页往下一点的位置，这里只是给个明确的"下一步在哪"的路标 -->
    <view class="omni-checkin-manage-links">
      <view class="omni-checkin-manage-link" wx:if="{{isManager}}" bindtap="onScrollToManagerConsole">
        <text>进入店务管理</text>
        <text class="omni-link-arrow">▶</text>
      </view>
      <view class="omni-checkin-manage-link" wx:if="{{isFinance}}" bindtap="onScrollToFinanceConsole">
        <text>进入财务稽核台</text>
        <text class="omni-link-arrow">▶</text>
      </view>
    </view>
  </view>

  <!-- 📢 门店公告：按当前视角（总览级/具体门店，严格互斥）从云端拉取的通知列表。
       多条时垂直轮播；单条超长标题用水平跑马灯；没有任何有效通知时整块不占位。 -->
  <view class="announce-bar" wx:if="{{noticeList.length > 0 && !isNoticeBarHiddenToday}}">
    <text class="announce-bar-icon">📢</text>

    <view class="announce-bar-viewport" wx:if="{{noticeList.length === 1}}" bindtap="openAnnouncement">
      <text class="announce-bar-text {{noticeList[0].title.length > 14 ? 'marquee' : ''}}">{{noticeList[0].title}}<block wx:if="{{noticeList[0].title.length > 14}}">　　{{noticeList[0].title}}</block></text>
    </view>

    <swiper wx:if="{{noticeList.length > 1}}" class="announce-bar-swiper" vertical autoplay circular interval="3000" duration="500" bindchange="onSwiperNoticeChange">
      <swiper-item wx:for="{{noticeList}}" wx:key="id">
        <view class="announce-bar-viewport" bindtap="openAnnouncement">
          <text class="announce-bar-text {{item.title.length > 14 ? 'marquee' : ''}}">{{item.title}}<block wx:if="{{item.title.length > 14}}">　　{{item.title}}</block></text>
        </view>
      </swiper-item>
    </swiper>

    <text class="announce-bar-edit" wx:if="{{(isManager || isFinance || isSuperAdmin) && noticeList.length > 0}}" catchtap="openNoticeEdit">✏️</text>
    <text class="announce-bar-add" wx:if="{{isManager || isFinance || isSuperAdmin}}" catchtap="openNoticeCreate">＋</text>
    <text class="announce-bar-close" catchtap="onCloseNoticeBar">✕</text>
  </view>

  <!-- 🌟 兜底温馨提示：云端确认当前视角暂无有效通知时展示，避免跑马灯整块消失留白；
       noticesLoading 期间不展示，防止请求还没返回就先闪一下"暂无通知" -->
  <view class="announce-bar announce-bar-fallback" wx:if="{{noticeList.length === 0 && !noticesLoading && !isNoticeBarHiddenToday}}">
    <text class="announce-bar-icon">📢</text>
    <view class="announce-bar-viewport">
      <text class="announce-bar-text">欢迎使用素小账，今日公益服务正常进行中</text>
    </view>
    <text class="announce-bar-close" catchtap="onCloseNoticeBar">✕</text>
  </view>

  <!-- 🍱 今日食谱预览卡：全国总览视图不展示（无具体门店）；志工视角已合并进下方"今日餐况"单行摘要，此处不再重复展示。
       🛡️ 权限隔离：仅店长/超管可跳转至发布/管理页 -->
  <view class="today-menu-preview-card {{todayMenu ? 'is-filled' : 'is-empty'}}" wx:if="{{!isVolunteer && todayMenuLoaded && currentStoreId !== 'national_overview' && currentStoreId !== 'ALL_STORES'}}" bindtap="{{(isManager || isSuperAdmin) ? 'onGotoDailyMenu' : ''}}">
    <view class="tmp-main">
      <view class="tmp-header">
        <text class="tmp-title">🍱 今日食谱</text>
      </view>
      <view class="tmp-9grid" wx:if="{{todayMenu && todayMenu.images.length > 0}}">
        <view class="tmp-grid-item" wx:for="{{todayMenu.images}}" wx:for-item="img" wx:key="url">
          <image wx:if="{{!previewImagesFailedMap[img.thumbUrl]}}" class="tmp-grid-img" src="{{img.thumbUrl}}" mode="aspectFill" lazy-load="{{true}}" binderror="onPreviewCardImageLoadError" data-url="{{img.thumbUrl}}" />
          <view wx:else class="thumb-load-failed" catchtap="onRetryPreviewCardImage" data-url="{{img.thumbUrl}}">
            <text class="thumb-load-failed-icon">⚠️</text>
            <text class="thumb-load-failed-text">加载失败</text>
          </view>
        </view>
      </view>
      <text class="tmp-text" wx:if="{{todayMenu}}">{{todayMenu.menuText || '（未填写文字菜谱，见图片）'}}</text>
      <text class="tmp-empty-text" wx:else>今日食谱尚未发布</text>
    </view>
    <view class="tmp-side-action" catchtap="onGotoDailyMenu" wx:if="{{isManager || isSuperAdmin}}">
      <text class="tmp-side-btn" wx:if="{{!todayMenu}}">+ 去发布</text>
      <text class="tmp-side-link" wx:else>去管理 ›</text>
    </view>
  </view>

  <!-- 📌 今日大事记预览卡：全国总览视图不展示（无具体门店）；志工视角已合并进下方"今日餐况"单行摘要，此处不再重复展示。
       🛡️ 权限隔离：仅店长/超管可跳转至发布/管理页 -->
  <view class="today-menu-preview-card {{todayActivity ? 'is-filled' : 'is-empty'}}" wx:if="{{!isVolunteer && todayActivityLoaded && currentStoreId !== 'national_overview' && currentStoreId !== 'ALL_STORES'}}" bindtap="{{(isManager || isSuperAdmin) ? 'onGotoActivityLog' : ''}}">
    <view class="tmp-main">
      <view class="tmp-header">
        <text class="tmp-title">📌 今日门店日志</text>
      </view>
      <view class="tmp-9grid" wx:if="{{todayActivity && todayActivity.images.length > 0}}">
        <view class="tmp-grid-item" wx:for="{{todayActivity.images}}" wx:for-item="img" wx:key="url">
          <image wx:if="{{!previewImagesFailedMap[img.thumbUrl]}}" class="tmp-grid-img" src="{{img.thumbUrl}}" mode="aspectFill" lazy-load="{{true}}" binderror="onPreviewCardImageLoadError" data-url="{{img.thumbUrl}}" />
          <view wx:else class="thumb-load-failed" catchtap="onRetryPreviewCardImage" data-url="{{img.thumbUrl}}">
            <text class="thumb-load-failed-icon">⚠️</text>
            <text class="thumb-load-failed-text">加载失败</text>
          </view>
        </view>
      </view>
      <text class="tmp-text" wx:if="{{todayActivity}}">{{todayActivity.title}}</text>
      <text class="tmp-empty-text" wx:else>今日尚无门店日志</text>
    </view>
    <view class="tmp-side-action" catchtap="onGotoActivityLog" wx:if="{{isManager || isSuperAdmin}}">
      <text class="tmp-side-btn" wx:if="{{!todayActivity}}">+ 去发布</text>
      <text class="tmp-side-link" wx:else>去管理 ›</text>
    </view>
  </view>

  <view class="lock-readonly-banner" wx:if="{{isReadOnlyByLock}}">
    <view class="lock-icon idx-icon-sm idx-icon-lock"></view>
    <view class="lock-content">
      <text class="lock-txt">义工【{{lockOwnerName}}】正在录入，当前为只读视图</text>
      <text class="lock-remain" wx:if="{{lockRemainingFormatted}}">剩余 {{lockRemainingFormatted}}</text>
    </view>
    <view class="lock-force-btn" wx:if="{{currentUserRole === 'super_admin' || currentUserRole === 'store_manager'}}" bindtap="onForceUnlock">强制解锁</view>
  </view>

  <block wx:if="{{!isVolunteer}}">
    <view class="sponsor-brand-banner" wx:if="{{currentSponsorInfo}}">
      <view class="sponsor-left">
        <view class="sparkle idx-icon-sm idx-icon-sparkle"></view>
        <text class="lbl">爱心赞助单位：</text>
        <text class="company-name">{{currentSponsorInfo.companyName}}</text>
      </view>
      <text class="slogan-tag" wx:if="{{currentSponsorInfo.brandSlogan}}">{{currentSponsorInfo.brandSlogan}}</text>
    </view>

    <!-- 📊 数据概览卡片上移，充实上半屏视觉焦点 -->
    <view class="manager-home-card" id="managerConsoleAnchor" wx:if="{{isManager || isSuperAdmin}}">
      <view class="card-header-welcome">
        <view class="welcome-icon idx-icon-svg idx-icon-crown"></view>
        <view class="welcome-text-box">
          <text class="welcome-title">{{currentStoreName || '海沧店'}} · 店长工作台</text>
          <text class="welcome-sub">掌管门店日常运营、小票记账与餐报发布</text>
        </view>
      </view>

      <view class="role-stats-banner manager-bg">
        <view class="stat-item">
          <text class="stat-num">{{monthlyReportCount || 14}}</text>
          <text class="stat-label">本月餐报/篇</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item" bindtap="onOpenVolunteerAudit">
          <text class="stat-num highlight">{{pendingAuditCount || 0}}</text>
          <text class="stat-label">待审核志愿者/人</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-num">{{activeVolunteersCount || 28}}</text>
          <text class="stat-label">志愿团队/人</text>
        </view>
      </view>
    </view>

    <view class="finance-home-card" id="financeConsoleAnchor" wx:if="{{isFinance || isSuperAdmin}}">
      <view class="card-header-welcome">
        <view class="welcome-icon idx-icon-svg idx-icon-lock"></view>
        <view class="welcome-text-box">
          <text class="welcome-title">{{currentStoreName || '海沧店'}} · 财务稽核台</text>
          <text class="welcome-sub">账本防篡改稽核、资金安全与数据导出</text>
        </view>
      </view>

      <view class="role-stats-banner finance-bg">
        <view class="stat-item">
          <text class="stat-num green-text">100%</text>
          <text class="stat-label">账本锁定状态</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item" bindtap="onExportExcelHistory">
          <text class="stat-num">{{excelExportCount || 6}}</text>
          <text class="stat-label">月度导出/次</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item" bindtap="onOpenRiskAlertsModal">
          <text class="stat-num {{riskAlertCount > 0 ? 'highlight' : ''}}">{{riskAlertCount || 0}}</text>
          <text class="stat-label">异常风控预警</text>
        </view>
      </view>

      <!-- 🌟 财务专属功能区：标准 2x2 宫格，聚焦稽核指标 + 账本审核 + 导出/封账 -->
      <view class="qa-main-grid finance-qa-grid">
        <view class="qa-grid-cell" bindtap="onOpenFinanceExportMenu">
          <text class="qa-grid-emoji">📊</text>
          <text class="txt">Excel 账本导出</text>
        </view>
        <view class="qa-grid-cell" bindtap="onOpenFinanceLockModal">
          <text class="qa-grid-emoji">🔒</text>
          <text class="txt">稽核与封账</text>
        </view>
        <view class="qa-grid-cell" bindtap="onOpenRiskAlertsModal">
          <text class="qa-grid-emoji">⚠️</text>
          <text class="txt">风控预警日志</text>
        </view>
        <view class="qa-grid-cell" bindtap="toggleSettings">
          <view class="icon idx-icon-svg idx-icon-settings"></view>
          <text class="txt">店铺模板自定义</text>
        </view>
      </view>
    </view>

    <view class="manager-quick-actions-v2" wx:if="{{isManager || isSuperAdmin}}">
      <!-- 🌟 固定 2x2 标准四宫格：四张卡片对所有管理角色恒定存在，不再因 isSuperAdmin 等条件
           导致某个角色看到的宫格缺一角。原"门店管理"（仅超管）移至宫格下方独立入口，
           原"门店邀请海报"+"生成邀请码"两个推广入口合并进第 4 张卡片的操作菜单 -->
      <view class="qa-main-grid">
        <view class="qa-grid-cell" bindtap="goToHistory">
          <text class="qa-grid-emoji">🧾</text>
          <text class="txt">凭证与账本</text>
        </view>
        <view class="qa-grid-cell" bindtap="onOpenAuditModal">
          <view class="icon idx-icon-svg idx-icon-people"></view>
          <text class="txt">义工审核 ({{pendingAuditCount || 0}})</text>
        </view>
        <view class="qa-grid-cell" bindtap="goToStatistics">
          <view class="icon idx-icon-svg idx-icon-chart"></view>
          <text class="txt">数据统计/账本导出</text>
        </view>
        <view class="qa-grid-cell" bindtap="onOpenPromoActionSheet">
          <text class="qa-grid-emoji">🖼️</text>
          <text class="txt">门店推广与邀请</text>
        </view>
      </view>

      <!-- 门店管理：仅超管可见，独立于固定宫格之外，不再挤占/影响宫格对称性 -->
      <view class="qa-extra-row" wx:if="{{isSuperAdmin}}" bindtap="onGotoStoreManagement">
        <text class="qa-grid-emoji">🏪</text>
        <text class="txt">门店管理</text>
        <text class="qa-extra-arrow">›</text>
      </view>
    </view>

    <scroll-view scroll-y class="page-body-scroll">
    <view class="draft-notice-banner" wx:if="{{hasDraft && (isManager || isSuperAdmin)}}">
      <view class="draft-left">
        <view class="icon idx-icon-sm idx-icon-note"></view>
        <text class="txt">检测到未提交草稿</text>
      </view>
      <view class="draft-actions">
        <text class="btn-draft-act recover" bindtap="recoverDraft">恢复</text>
        <text class="divider">|</text>
        <text class="btn-draft-act discard" bindtap="discardDraft">丢弃</text>
      </view>
    </view>

    <view class="offline-banner" wx:if="{{offlineQueueCount > 0}}" bindtap="syncOfflineQueueManually">
      <view class="offline-icon idx-icon-sm idx-icon-box"></view>
      <text class="offline-text">{{offlineQueueCount}}条待同步</text>
      <text class="offline-action">[重传]</text>
    </view>

    <!-- 🐛 与 finance-qa-grid 第 4 格【店铺模板自定义】(toggleSettings) 重复的通栏横条：
         纯财务/超管已经能从四宫格进入同一个 toggleSettings，这里再展示一条一模一样的
         入口纯属冗余视觉噪音。但对"只是店长、不是财务也不是超管"的角色来说，四宫格
         (manager-quick-actions-v2) 里压根没有这一格，这条横条是他们唯一能进店铺模板
         设置的入口——不能一并删掉，只隐藏"已经有格子可以点"的那部分用户 -->
    <view class="ui-card-wrapper template-card" wx:if="{{!(isFinance || isSuperAdmin)}}" bindtap="toggleSettings">
      <view class="template-header-left">
        <view class="icon idx-icon-svg idx-icon-settings"></view>
        <text class="title">店铺模板自定义</text>
      </view>
      <text class="arrow-right">{{showSettings ? '▼' : '▶'}}</text>
    </view>

    <view class="template-expand-panel ui-card-wrapper" wx:if="{{showSettings}}">
      <view class="row">
        <view class="col">
          <text class="label">店铺名称</text>
          <picker
            mode="selector"
            range="{{storePickerList}}"
            value="{{selectedStoreIndex}}"
            bindchange="onStorePickerChange"
          >
            <view class="picker-select-box">
              <text class="picker-text">{{shopName || '请选择店铺'}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
        <view class="col">
          <text class="label">公众号名称</text>
          <input class="input" value="{{mpAccount}}" bindinput="onInput" data-field="mpAccount" placeholder="选择店铺后自动填充" />
        </view>
      </view>
      <view class="row" wx:if="{{isCustomStore}}">
        <view class="col-full">
          <text class="label">手动输入新门店名称</text>
          <input class="input" value="{{shopName}}" bindinput="onInput" data-field="shopName" placeholder="请输入新门店完整名称" />
        </view>
      </view>
      <view class="row">
        <view class="col-full">
          <text class="label">感谢语/致谢词</text>
          <textarea class="textarea small" value="{{thankText}}" bindinput="onThankTextInput" placeholder="感谢各位爱心人士的鼎力支持，感恩默默付出的义工团队！" />
        </view>
      </view>
      <view class="row">
        <view class="col">
          <text class="label">宣传标语 1</text>
          <input class="input" value="{{slogan1}}" bindinput="onSlogan1Input" placeholder="吃素一日  健康一天" />
        </view>
        <view class="col">
          <text class="label">宣传标语 2</text>
          <input class="input" value="{{slogan2}}" bindinput="onSlogan2Input" placeholder="清晰记账  透明运行" />
        </view>
      </view>
    </view>

    <!-- 🌟 职责隔离策略已按需求调整：财务义工每天稽核完账目、确认算式无误后，
         需要亲自生成/提交当日餐报并公示，因此当日明细录入表单不再对纯财务角色隐藏——
         纯财务与店长现在走完全相同的一套录入 + 提交 + 级联重算流程，不再区分。
         真正的重复录入防护在 saveReportAsync -> DataService.saveReport 的
         duplicate_date_blocked 校验里：当天若已有店长提交的记录，财务这里生成时
         会被拦截并引导去历史记录编辑，不会产生重复/冲突的账本条目。 -->
    <view class="ui-card-wrapper form-main-card">
      <view class="form-card-header">
        <view class="title-group">
          <view class="sparkle-icon idx-icon-sm idx-icon-sparkle"></view>
          <text class="card-title">请填写当日明细:</text>
        </view>
        <view class="btn-clear-input" bindtap="resetForm"><view class="idx-icon-sm idx-icon-broom"></view> 清空输入</view>
      </view>

      <view class="date-balance-grid">
        <view class="pod-card date-pod">
          <view class="pod-header">
            <view class="header-left">
              <view class="icon idx-icon-sm idx-icon-calendar"></view>
              <text class="title-txt">汇报日期</text>
            </view>
          </view>
          <view class="pod-body">
            <picker mode="date" value="{{reportDateValue}}" bindchange="onDateChange" start="2020-01-01" end="2030-12-31">
              <view class="date-picker-box">
                <text class="date-str">{{reportDateValue}}</text>
                <text class="arrow">▾</text>
              </view>
            </picker>
          </view>
          <view class="pod-footer">
            <view class="btn-group-toggle">
              <view 
                class="btn-toggle {{isTodaySelected ? 'active' : ''}}" 
                bindtap="onSelectQuickDate" 
                data-type="today"
              >
                今天
              </view>
              <view 
                class="btn-toggle {{isYesterdaySelected ? 'active' : ''}}" 
                bindtap="onSelectQuickDate" 
                data-type="yesterday"
              >
                昨天
              </view>
            </view>
          </view>
        </view>

        <view class="pod-card balance-pod">
          <view class="pod-header">
            <view class="header-left">
              <view class="icon idx-icon-sm idx-icon-wallet"></view>
              <text class="title-txt">昨日余额</text>
            </view>
            <view 
              class="badge-status {{!isBalanceLocked ? 'editing' : ''}}" 
              wx:if="{{permissions.canEditBalance}}" 
              bindtap="toggleBalanceLock"
            >
              <view class="pill-icon idx-icon-sm {{!isBalanceLocked ? 'idx-icon-edit' : 'idx-icon-lock'}}"></view>
              <text class="pill-txt">{{!isBalanceLocked ? '修改中' : '修改'}}</text>
            </view>
          </view>
          <view class="pod-body">
            <view class="balance-input-box {{!isBalanceLocked ? 'is-editing' : 'is-locked'}}">
              <text class="currency">¥</text>
              <input class="balance-val"
                     type="digit"
                     value="{{yesterdayBalance}}"
                     disabled="{{isBalanceLocked}}"
                     focus="{{!isBalanceLocked && balanceFocus}}"
                     placeholder="0.00"
                     bindinput="onYesterdayBalanceInput" />
              <view class="btn-refresh-circle" bindtap="onForceRefreshBalance">
                <view class="refresh-icon idx-icon-sm idx-icon-refresh"></view>
              </view>
            </view>
            <view class="balance-matched-tip" wx:if="{{balanceMatchTip}}">
              {{balanceMatchTip}}
            </view>
          </view>
          <view class="pod-footer">
            <view class="btn-history-pill-enhanced" bindtap="onOpenBalanceHistoryModal">
              <view class="icon idx-icon-sm idx-icon-scroll"></view>
              <text class="lbl">选择历史结余</text>
            </view>
          </view>
        </view>
      </view>

      <view class="adjust-tag" wx:if="{{isManualAdjust}}">
        <view class="adjust-icon idx-icon-sm idx-icon-warning"></view>
        <text class="adjust-text">已手动调账（差额：{{balanceDiff >= 0 ? '+' : ''}}¥{{balanceDiff.toFixed(2)}}）</text>
      </view>

      <view class="form-field-block">
        <view class="field-header-with-segment">
          <view class="title-left">
            <view class="lbl-bold"><view class="idx-icon-sm idx-icon-heart" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>爱心支持明细</view>
          </view>
          <view class="entry-mode-segmented">
            <view
              class="segment-btn {{inputMode === 'form' ? 'active' : ''}}"
              bindtap="onChangeInputMode"
              data-mode="form"
            >
              <text class="txt">✍️ 逐条</text>
            </view>
            <view
              class="segment-btn {{inputMode === 'text' ? 'active' : ''}}"
              bindtap="onChangeInputMode"
              data-mode="text"
            >
              <text class="txt">📋 粘贴</text>
            </view>
            <!-- 🌟 图片识别不是一个持续的"模式"（不参与 form/text 互斥切换），
                 是一次性动作：识别完成后直接把结果追加进批量粘贴文本框并自动切到该模式；
                 "选中态"复用同一套 .active 高亮，只在识别进行中短暂点亮，识别完自动退回中性态 -->
            <view
              class="segment-btn segment-btn-ocr {{isScanningDonorList ? 'active' : ''}}"
              bindtap="onScanDonorScreenshot"
            >
              <text class="txt">📸 识图</text>
            </view>
          </view>
        </view>

        <block wx:if="{{inputMode === 'form'}}">
          <view class="quick-amount-row">
            <text class="quick-tip">快捷金额：</text>
            <view class="amount-tag" bindtap="onSelectQuickAmount" data-amount="1">¥1</view>
            <view class="amount-tag" bindtap="onSelectQuickAmount" data-amount="2">¥2</view>
            <view class="amount-tag" bindtap="onSelectQuickAmount" data-amount="5">¥5</view>
            <view class="amount-tag" bindtap="onSelectQuickAmount" data-amount="10">¥10</view>
            <view class="amount-tag" bindtap="onSelectQuickAmount" data-amount="20">¥20</view>
          </view>

          <view class="form-add-row">
            <input class="name-input" placeholder="爱心人士姓名" value="{{singleName}}" bindinput="onInputSingleName" />
            <input class="amount-input" type="digit" placeholder="金额" value="{{singleAmount}}" bindinput="onInputSingleAmount" />
            <button class="btn-add-item" bindtap="onAddSingleSupportItem">+ 添加</button>
          </view>

          <view class="support-list-preview" wx:if="{{parseResult.items.length > 0}}">
            <view class="list-count-tag">已录入 {{parseResult.totalCount}} 人，共 ¥{{parseResult.totalAmount.toFixed(2)}}</view>
            <scroll-view scroll-y class="list-scroll-box">
              <view class="support-item-cell" wx:for="{{parseResult.items}}" wx:key="index">
                <text class="item-idx">{{index + 1}}.</text>
                <text class="item-name">{{item.name}}</text>
                <text class="item-amount">¥{{item.amount}}</text>
                <text class="btn-del" bindtap="onDeleteSupportItem" data-index="{{index}}">✕</text>
              </view>
            </scroll-view>
          </view>
        </block>

        <block wx:else>
          <view class="textarea-wrap">
            <textarea class="textarea autosize" auto-height maxlength="-1" placeholder="{{donationPlaceholder}}" value="{{allDonations}}" bindinput="onInput" data-field="allDonations" />
            <!-- 🌟 历史名单轻量入口：右下角弱化文字链接，不占主要视觉权重 -->
            <text class="btn-frequent-donor-link" bindtap="onOpenFrequentDonorPicker">🕒 选择常客</text>
          </view>
          <view class="tip-and-sum-row">
            <view class="text-format-tip"><view class="idx-icon-sm idx-icon-bulb"></view> 支持空格、逗号、冒号分隔，系统将自动清洗识别金额</view>
            <!-- 🌟 实时金额累加提示：直接读 parseResult/totalParsedAmount——这两个字段本就是
                 updateParseResult（bindinput 和图片识别成功后都会调用）算好的结果，不再另起
                 一套"抓数字求和"的逻辑，也让这里显示的数字与下方【今日预计结余算式预览】的
                 收入变量始终是同一个数，不可能出现两处对不上的情况 -->
            <text class="realtime-sum-tip" wx:if="{{parseResult.totalCount > 0}}">💡 系统已自动解析 {{parseResult.totalCount}} 笔支持，累加总额：¥{{totalParsedAmount}}</text>
          </view>

          <view class="parse-preview" wx:if="{{parseResult.items.length > 0 || parseResult.unrecognizedLines.length > 0}}">
            <view class="preview-header">
              <view class="preview-title"><view class="idx-icon-sm idx-icon-clipboard"></view> 解析结果预览</view>
              <view class="preview-summary">
                <text class="summary-item">人数：{{parseResult.totalCount}}</text>
                <text class="summary-item summary-highlight">金额：¥{{totalParsedAmount}}</text>
              </view>
            </view>
            
            <view class="preview-list">
              <view class="preview-item" wx:for="{{parseResult.items}}" wx:key="name">
                <text class="item-name">{{item.name}}</text>
                <text class="item-amount">¥{{item.amount}}</text>
              </view>
            </view>

            <view class="preview-errors" wx:if="{{parseResult.unrecognizedLines.length > 0}}">
              <view class="error-item" wx:for="{{parseResult.unrecognizedLines}}" wx:key="index">
                <view class="error-icon idx-icon-sm idx-icon-warning"></view>
                <text class="error-text">{{item}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>

    </view>

    <!-- Card A: 现场赞助补充与今日结余算式预览 -->
    <view class="ui-card-wrapper math-preview-card">
      <view class="field-item-row">
        <view class="label-with-tip">
          <view class="lbl-bold"><view class="idx-icon-sm idx-icon-wallet"></view> 现场赞助/其他支持金额</view>
          <text class="sub-tip">(末尾固定加项)</text>
        </view>
        <view class="small-currency-input-box">
          <text class="symbol">¥</text>
          <input 
            class="num-input" 
            type="digit" 
            value="{{otherDonation}}" 
            placeholder="0" 
            bindinput="onInput"
            data-field="otherDonation"
          />
        </view>
      </view>

      <view class="formula-preview-banner">
        <view class="formula-header">
          <view class="icon idx-icon-sm idx-icon-chart"></view>
          <text class="title">今日预计结余算式预览</text>
        </view>
        <view class="formula-expression-row">
          <text class="num-item">{{yesterdayBalDisplay || '0.00'}} <text class="unit">(昨日)</text></text>
          <text class="operator">+</text>
          <text class="num-item green">{{totalIncomeDisplay || '0.00'}} <text class="unit">(收入)</text></text>
          <text class="operator">-</text>
          <text class="num-item red">{{totalExpenseDisplay || '0.00'}} <text class="unit">(支出)</text></text>
          <text class="operator">=</text>
          <text class="result-val orange">¥{{previewTodayBalanceDisplay || '0.00'}}</text>
        </view>
      </view>
    </view>

    <!-- Card B: 物资赞助与服务统计卡片 -->
    <view class="ui-card-wrapper stats-grid-card">
      <view class="form-sub-block">
        <view class="block-title"><view class="idx-icon-sm idx-icon-box"></view> 物资赞助明细 <text class="optional-tag">(选填)</text></view>
        <view class="input-wrapper-inner">
          <textarea 
            class="single-line-textarea" 
            value="{{materialsInput}}" 
            placeholder="示例：张三: 大米50斤；李四: 食用油2箱"
            bindinput="onMaterialsInput"
            data-field="materialsInput"
            auto-height
            maxlength="-1"
          />
        </view>
      </view>

      <view class="form-sub-block top-space">
        <view class="block-title"><view class="idx-icon-sm idx-icon-heart"></view> 义工与用餐统计 <text class="optional-tag">(选填)</text></view>
        
        <view class="stats-3grid">
          <view class="grid-input-item">
            <text class="item-lbl">到岗义工</text>
            <view class="input-suffix-box">
              <input class="input-field" type="number" value="{{volunteerCount}}" placeholder="12" bindinput="onInput" data-field="volunteerCount" />
              <text class="suffix">人</text>
            </view>
          </view>

          <view class="grid-input-item">
            <text class="item-lbl">服务总工时</text>
            <view class="input-suffix-box">
              <input class="input-field" type="digit" value="{{volunteerHours}}" placeholder="36" bindinput="onInput" data-field="volunteerHours" />
              <text class="suffix">小时</text>
            </view>
          </view>

          <view class="grid-input-item wide">
            <text class="item-lbl">今日用餐人次</text>
            <view class="input-suffix-box">
              <input class="input-field" type="number" value="{{diningCount}}" placeholder="120" bindinput="onInput" data-field="diningCount" />
              <text class="suffix">人</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Card C: 主食物资储备状态卡片 -->
    <view class="ui-card-wrapper inventory-status-card">
      <view class="card-title-bar">
        <view class="title"><view class="idx-icon-sm idx-icon-box"></view> 主食物资储备状态 <text class="optional-tag">(选填)</text></view>
      </view>

      <view class="inventory-row">
        <view class="item-name"><view class="idx-icon-sm idx-icon-bowl" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>大米/面粉</view>
        <view class="status-pill-group">
          <view 
            class="status-pill green {{stapleRiceStatus === 'sufficient' ? 'active' : ''}}" 
            bindtap="onStapleStatusChange" data-type="rice" data-value="sufficient"
          >
            充足
          </view>
          <view 
            class="status-pill yellow {{stapleRiceStatus === 'normal' ? 'active' : ''}}" 
            bindtap="onStapleStatusChange" data-type="rice" data-value="normal"
          >
            一般
          </view>
          <view 
            class="status-pill red {{stapleRiceStatus === 'urgent' ? 'active' : ''}}" 
            bindtap="onStapleStatusChange" data-type="rice" data-value="urgent"
          >
            告急
          </view>
        </view>
      </view>

      <view class="inventory-row">
        <view class="item-name"><view class="idx-icon-sm idx-icon-box"></view> 食用油</view>
        <view class="status-pill-group">
          <view 
            class="status-pill green {{stapleOilStatus === 'sufficient' ? 'active' : ''}}" 
            bindtap="onStapleStatusChange" data-type="oil" data-value="sufficient"
          >
            充足
          </view>
          <view 
            class="status-pill yellow {{stapleOilStatus === 'normal' ? 'active' : ''}}" 
            bindtap="onStapleStatusChange" data-type="oil" data-value="normal"
          >
            一般
          </view>
          <view 
            class="status-pill red {{stapleOilStatus === 'urgent' ? 'active' : ''}}" 
            bindtap="onStapleStatusChange" data-type="oil" data-value="urgent"
          >
            告急
          </view>
        </view>
      </view>
    </view>

    <!-- Card D: 今日支出明细录入与凭证上传卡片 -->
    <view class="ui-card-wrapper expense-main-card">
      <view class="card-title-bar">
        <view class="title"><view class="idx-icon-sm idx-icon-wallet"></view> 今日支出录入</view>
      </view>

      <view class="expense-field-box">
        <view class="box-header">
          <view class="lbl"><view class="idx-icon-sm idx-icon-bowl"></view> 食材与杂购</view>
          <view class="header-action-row">
            <text class="tag">计入成本</text>
            <view class="btn-expense-template-pill" hover-class="btn-expense-template-hover" bindtap="onOpenExpenseTemplateModal" data-category="daily">
              <text class="lbl">🧾 常用项目</text>
            </view>
            <view class="btn-scan-receipt-pill" hover-class="btn-scan-receipt-hover" bindtap="onScanReceiptPhoto">
              <view class="icon idx-icon-sm idx-icon-camera"></view>
              <text class="lbl">拍照识别</text>
            </view>
          </view>
        </view>
        <textarea
          class="expense-textarea"
          value="{{dailyExpenseText}}"
          placeholder="如：青菜30 豆腐20 煤气80"
          bindinput="onInput"
          data-field="dailyExpenseText"
          maxlength="500"
          auto-height="{{true}}"
          style="min-height: 160rpx;"
        />
        <text class="expense-parse-preview" wx:if="{{dailyExpenseParseCount > 0}}">已解析 {{dailyExpenseParseCount}} 项，预计金额：¥{{dailyExpenseParseAmount}} 元</text>
      </view>

      <view class="expense-field-box major-box">
        <view class="box-header">
          <view class="lbl"><view class="idx-icon-sm idx-icon-box"></view> 房租/设备/专项大额</view>
          <view class="header-action-row">
            <text class="tag warm">不计入成本</text>
            <view class="btn-expense-template-pill" hover-class="btn-expense-template-hover" bindtap="onOpenExpenseTemplateModal" data-category="fixed">
              <text class="lbl">🧾 常用项目</text>
            </view>
          </view>
        </view>
        <!-- 🌟 大额专项已改为逐条添加的结构化列表（而非自由文本），因为要给
             每一条挂一个真实的[独立凭证]按钮，<textarea> 做不到按行挂按钮。
             fixedExpenseText 仍由 fixedExpenseItems 自动派生，无需手改。 -->
        <view class="fixed-expense-add-row">
          <input class="name-input" placeholder="项目名称" value="{{fixedExpenseNewName}}" bindinput="onInputFixedExpenseNewName" style="flex: 1 !important;" />
          <input class="amount-input" type="digit" placeholder="金额" value="{{fixedExpenseNewAmount}}" bindinput="onInputFixedExpenseNewAmount" style="width: 220rpx !important; min-width: 220rpx !important; flex: none !important;" />
          <button class="btn-add-item" bindtap="onAddFixedExpenseItem" style="width: 120rpx !important; padding: 0 12rpx !important; flex: none !important;">+ 添加</button>
        </view>

        <view class="fixed-expense-empty" wx:if="{{fixedExpenseItems.length === 0}}">
          <text>暂无大额专项支出，添加一条后可为其单独上传独立凭证</text>
        </view>

        <view class="fixed-expense-list" wx:else>
          <view class="fixed-expense-item" wx:for="{{fixedExpenseItems}}" wx:for-item="item" wx:key="_key">
            <view class="fixed-expense-row">
              <view class="fe-left">
                <text class="fe-name">{{item.name}}</text>
                <view class="fe-amount-box">
                  <text class="fe-currency">¥</text>
                  <input class="fe-amount-input" type="digit" value="{{item.amount}}" data-index="{{index}}" bindinput="onInputFixedExpenseItemAmount" />
                </view>
              </view>
              <view class="fe-right">
                <view class="fe-voucher-btn {{item.independent_image_urls.length > 0 ? 'has-voucher' : ''}}" data-index="{{index}}" bindtap="onToggleIndependentVoucher">
                  <text class="lbl">📂 独立凭证 ({{item.independent_image_urls.length}}/3)</text>
                </view>
                <text class="fe-del" data-index="{{index}}" bindtap="onDeleteFixedExpenseItem">✕</text>
              </view>
            </view>

            <view class="fe-voucher-grid receipt-grid-container" wx:if="{{item.expanded}}">
              <view class="grid-image-item" wx:for="{{item.independent_image_urls}}" wx:for-item="img" wx:for-index="imgIdx" wx:key="*this">
                <image wx:if="{{!imageLoadFailedMap[img]}}" class="grid-img" src="{{img}}" mode="aspectFill" bindtap="onPreviewIndependentVoucher" data-index="{{index}}" data-img-index="{{imgIdx}}" binderror="onImageLoadError" data-url="{{img}}" />
                <view wx:else class="thumb-load-failed" bindtap="onRetryImage" data-url="{{img}}">
                  <text class="thumb-load-failed-icon">⚠️</text>
                  <text class="thumb-load-failed-text">加载失败</text>
                </view>
                <view class="img-delete-badge" catchtap="onDeleteIndependentVoucher" data-index="{{index}}" data-img-index="{{imgIdx}}">✕</view>
              </view>
              <view class="grid-add-btn" wx:if="{{item.independent_image_urls.length < 3}}" bindtap="onChooseIndependentVoucher" data-index="{{index}}">
                <text class="add-icon">+</text>
                <text class="add-txt">上传凭证</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="receipt-upload-section">
        <view class="section-title-row">
          <view class="sec-icon idx-icon-sm idx-icon-camera"></view>
          <text class="sec-title">支出凭证 / 收据</text>
          <text class="sec-sub-tip">(可选)</text>
          <text class="upload-counter {{receiptImages.length > 0 ? 'has-count' : ''}} {{receiptImages.length >= 9 ? 'counter-full' : ''}}">
            {{receiptImages.length || 0}} / 9
          </text>
        </view>

        <view class="receipt-grid-container">
          <view class="grid-image-item" wx:for="{{receiptImages}}" wx:key="*this">
            <image wx:if="{{!imageLoadFailedMap[item]}}" class="grid-img" src="{{item}}" mode="aspectFill" bindtap="previewReceipt" data-index="{{index}}" binderror="onImageLoadError" data-url="{{item}}"/>
            <view wx:else class="thumb-load-failed" bindtap="onRetryImage" data-url="{{item}}">
              <text class="thumb-load-failed-icon">⚠️</text>
              <text class="thumb-load-failed-text">加载失败</text>
            </view>
            <view class="img-delete-badge" catchtap="deleteReceipt" data-index="{{index}}">✕</view>
          </view>
          
          <view class="grid-add-btn" bindtap="chooseReceiptImages" wx:if="{{receiptImages.length < 9}}">
            <text class="add-icon">+</text>
            <text class="add-txt">上传小票/收据</text>
          </view>
        </view>

        <view class="upload-guide-text">
          <view class="idx-icon-sm idx-icon-bulb"></view> 提示：最多可传 9 张。若收据较多，推荐将多张小收据摆在一起拍照，不仅省空间，海报展示效果更佳！
        </view>
      </view>

      <!-- 🍱 今日食谱照片：随餐报一并提交，成功后自动发布/更新首页今日食谱卡片 -->
      <view class="receipt-upload-section">
        <view class="section-title-row">
          <text class="sec-icon-emoji">🍱</text>
          <text class="sec-title">今日食谱照片</text>
          <text class="sec-sub-tip">(可选)</text>
          <text class="upload-counter {{recipeImages.length > 0 ? 'has-count' : ''}} {{recipeImages.length >= 9 ? 'counter-full' : ''}}">
            {{recipeImages.length || 0}} / 9
          </text>
        </view>

        <!-- 🍱 3 列九宫格菜品卡片：图+菜名一一对应。
             🛡️ 行内 style 兜底：外部 index.wxss 里的 .recipe-dish-* 类名样式在设备上
             反复出现"编译不生效/缓存不刷新"的问题（历经切换项目根目录、清缓存、全量编译
             均未解决），行内 style 的优先级最高，且直接写在这份 WXML 里、不依赖任何外部
             .wxss 文件被正确加载/编译，能绕开一切样式表层面的缓存问题。class 属性仍然保留
             （便于将来外部样式表恢复生效后无缝接管，也用于 thumb-load-failed 等既有逻辑）。 -->
        <view class="recipe-dish-grid" style="display: grid !important; grid-template-columns: repeat(3, 1fr) !important; gap: 16rpx !important; width: 100% !important; margin-top: 16rpx !important; margin-bottom: 16rpx !important; box-sizing: border-box !important;">
          <block wx:for="{{recipeImages}}" wx:key="index" wx:for-item="img" wx:for-index="idx">
            <view class="recipe-dish-item" style="width: 100% !important; margin: 0 !important; display: flex !important; flex-direction: column !important; min-width: 0 !important;">
              <view class="recipe-dish-img-wrap" style="width: 100% !important; height: 0 !important; padding-bottom: 100% !important; position: relative !important; border-radius: 12rpx !important; overflow: hidden !important; box-sizing: border-box !important;">
                <image wx:if="{{(img.url || img) && !imageLoadFailedMap[img.url || img]}}" class="recipe-dish-img" src="{{img.url || img}}" mode="aspectFill" bindtap="onPreviewImage" data-source="recipe" data-index="{{idx}}" binderror="onImageLoadError" data-url="{{img.url || img}}" style="position: absolute !important; top: 0 !important; left: 0 !important; width: 100% !important; height: 100% !important; object-fit: cover !important; border-radius: 12rpx !important;"/>
                <view wx:elif="{{img.url || img}}" class="thumb-load-failed" bindtap="onRetryImage" data-url="{{img.url || img}}" style="position: absolute !important; top: 0 !important; left: 0 !important; width: 100% !important; height: 100% !important; box-sizing: border-box !important; display: flex !important; flex-direction: column !important; align-items: center !important; justify-content: center !important;">
                  <text class="thumb-load-failed-icon">⚠️</text>
                  <text class="thumb-load-failed-text">加载失败</text>
                </view>
                <view class="img-delete-badge" catchtap="deleteRecipeImage" data-index="{{idx}}" style="position: absolute !important; top: 6rpx !important; right: 6rpx !important; width: 36rpx !important; height: 36rpx !important; background: rgba(224, 49, 49, 0.9) !important; color: #fff !important; border-radius: 50% !important; font-size: 20rpx !important; display: flex !important; align-items: center !important; justify-content: center !important; z-index: 10 !important;">✕</view>
              </view>
              <input class="recipe-dish-name-input" placeholder="菜名" value="{{img.name}}" bindinput="onRecipeDishNameInput" data-index="{{idx}}" maxlength="20" style="margin-top: 8rpx !important; height: 48rpx !important; background: #f8f8f8 !important; border-radius: 8rpx !important; font-size: 22rpx !important; text-align: center !important; width: 100% !important; box-sizing: border-box !important;" />
            </view>
          </block>

          <view class="recipe-dish-add" bindtap="chooseRecipeImages" wx:if="{{recipeImages.length < 9}}" style="width: 100% !important; height: 0 !important; padding-bottom: 100% !important; position: relative !important; border: 2rpx dashed #C8B195 !important; background-color: #FAF8F5 !important; border-radius: 12rpx !important; box-sizing: border-box !important; margin: 0 !important;">
            <view class="recipe-add-icon" style="position: absolute !important; top: 35% !important; left: 50% !important; transform: translate(-50%, -50%) !important; font-size: 40rpx !important; color: #8C1D18 !important; line-height: 1 !important;">{{recipeUploading ? '…' : '+'}}</view>
            <view class="recipe-add-txt" style="position: absolute !important; top: 65% !important; left: 50% !important; transform: translate(-50%, -50%) !important; font-size: 22rpx !important; color: #8C1D18 !important; white-space: nowrap !important;">{{recipeUploading ? '压缩中' : '添加照片'}}</view>
          </view>
        </view>
      </view>

      <!-- 📌 门店今日日志/大事记：随餐报一并提交，成功后自动归档至门店日志时间轴 -->
      <view class="receipt-upload-section">
        <view class="section-title-row">
          <text class="sec-icon-emoji">📌</text>
          <text class="sec-title">门店今日日志/大事记</text>
          <text class="sec-sub-tip">(可选)</text>
          <text class="upload-counter {{activityImages.length > 0 ? 'has-count' : ''}} {{activityImages.length >= 18 ? 'counter-full' : ''}}">
            {{activityImages.length || 0}} / 18
          </text>
        </view>

        <textarea
          class="expense-textarea activity-text-spacing"
          value="{{activityText}}"
          placeholder="在此记录今日的温馨故事、活动花絮或志愿者服务心得..."
          bindinput="onActivityTextInput"
          data-field="activityText"
          maxlength="300"
        />

        <!-- 🌟 与「支出凭证」同款双九宫格网格（而非食谱区的单行横滚），
             符合图文发布的视觉直觉：先文字，后图片网格 -->
        <view class="receipt-grid-container">
          <view class="grid-image-item" wx:for="{{activityImages}}" wx:key="*this">
            <image wx:if="{{!imageLoadFailedMap[item]}}" class="grid-img" src="{{item}}" mode="aspectFill" bindtap="onPreviewImage" data-source="activity" data-index="{{index}}" binderror="onImageLoadError" data-url="{{item}}"/>
            <view wx:else class="thumb-load-failed" bindtap="onRetryImage" data-url="{{item}}">
              <text class="thumb-load-failed-icon">⚠️</text>
              <text class="thumb-load-failed-text">加载失败</text>
            </view>
            <view class="img-delete-badge" catchtap="deleteActivityImage" data-index="{{index}}">✕</view>
          </view>

          <view class="grid-add-btn" bindtap="chooseActivityImages" wx:if="{{activityImages.length < 18}}">
            <text class="add-icon">{{activityUploading ? '…' : '+'}}</text>
            <text class="add-txt">{{activityUploading ? '压缩中' : '添加照片'}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 生成结果预览折叠面板：与录入表单可见性保持一致，财务角色现在也需要看到算式校验 -->
    <block wx:if="{{showResult}}">
      <view class="report-result-card {{isResultExpanded ? 'expanded' : 'collapsed'}}">
        <view class="result-card-header" bindtap="onToggleResultExpand">
          <view class="title"><view class="idx-icon-sm idx-icon-note"></view> 生成结果预览</view>
          <text class="toggle-icon">{{isResultExpanded ? '▲ 收起' : '▼ 展开预览'}}</text>
        </view>
        <view class="result-card-body" wx:if="{{isResultExpanded}}">
          <!-- 实时算式校验高亮条 -->
          <view class="math-proof-bar">
            <view class="proof-label"><view class="idx-icon-sm idx-icon-chart" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>算式校验：</view>
            <text class="proof-val">{{calculationFormulaText || '0.00 + 0.00 - 0.00 = 0.00'}}</text>
          </view>

          <text class="output-text" user-select>{{reportResult}}</text>

          <!-- 🎨 今日开餐实景图集：横向滚动，展示食谱照片；wx:if 保证没有照片时整块不渲染，
               不会在纯文字报告下方留一块空白 -->
          <view class="result-photo-section" wx:if="{{recipeImages.length > 0}}">
            <view class="result-photo-title">🎨 今日开餐实景图集</view>
            <scroll-view scroll-x class="result-photo-scroll">
              <view class="result-photo-item" wx:for="{{recipeImages}}" wx:key="*this">
                <!-- 🛡️ recipeImages 现在是 {url,name}[]，但这里用 item.url || item 兼容
                     万一遇到纯字符串数组的场景，两种数据形状都能正常出图 -->
                <image
                  wx:if="{{!imageLoadFailedMap[item.url || item]}}"
                  class="result-photo-img"
                  src="{{item.url || item}}"
                  mode="aspectFill"
                  bindtap="onPreviewImage"
                  data-source="recipe"
                  data-index="{{index}}"
                  binderror="onImageLoadError"
                  data-url="{{item.url || item}}"
                />
                <view wx:else class="thumb-load-failed" bindtap="onRetryImage" data-url="{{item.url || item}}">
                  <text class="thumb-load-failed-icon">⚠️</text>
                  <text class="thumb-load-failed-text">加载失败</text>
                </view>
                <text class="result-photo-name" wx:if="{{item.name}}">{{item.name}}</text>
              </view>
            </scroll-view>
          </view>

          <!-- 📸 义工护持与大事记剪影：九宫格网格，展示大事记照片 -->
          <view class="result-photo-section" wx:if="{{activityImages.length > 0}}">
            <view class="result-photo-title">📸 义工护持与大事记剪影</view>
            <view class="result-photo-grid">
              <view class="result-photo-grid-item" wx:for="{{activityImages}}" wx:key="*this">
                <image
                  wx:if="{{!imageLoadFailedMap[item]}}"
                  class="result-photo-grid-img"
                  src="{{item}}"
                  mode="aspectFill"
                  bindtap="onPreviewImage"
                  data-source="activity"
                  data-index="{{index}}"
                  binderror="onImageLoadError"
                  data-url="{{item}}"
                />
                <view wx:else class="thumb-load-failed" bindtap="onRetryImage" data-url="{{item}}">
                  <text class="thumb-load-failed-icon">⚠️</text>
                  <text class="thumb-load-failed-text">加载失败</text>
                </view>
              </view>
            </view>
          </view>

          <button class="btn-copy" bindtap="copyText"><view class="idx-icon-sm idx-icon-clipboard"></view> 复制文本到剪贴板</button>
        </view>
      </view>
    </block>

    <!-- 主生成按钮已迁移至底部固定吸底的 .bottom-action-floating-bar，这里仅保留精简的反馈/协议链接 -->
    <view class="bottom-links-card">
      <view class="sub-btn-group">
        <button class="btn-sub" open-type="feedback"><view class="idx-icon-sm idx-icon-chat" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>意见反馈</button>
      </view>
      <view class="agreement-tips">
        生成即代表同意 <text class="link" bindtap="showServiceAgreement">《用户服务协议》</text>
      </view>
      <!-- 吸底按钮组高度占位，避免固定按钮遮挡本区域内容 -->
      <view class="floating-bar-spacer"></view>
    </view>

  </scroll-view>
  </block>

  <block wx:elif="{{isVolunteer}}">
    <scroll-view scroll-y class="page-body-scroll">
      <view class="volunteer-view-card">
        <!-- 🍚 今日餐况：开餐状态 + 主食物资 + 食谱/大事记精简摘要，合并为一张状态卡，
             未发布时用单行提示代替独立空卡片，避免占用纵向空间 -->
        <view class="today-status-card">
          <view class="tsc-header">
            <text class="tsc-title">今日餐况</text>
            <text class="tsc-date">{{todayDateStr}}</text>
          </view>
          <view class="tsc-row">
            <text class="tsc-label"><view class="idx-icon-sm idx-icon-bowl"></view> 开餐状态</text>
            <text class="tsc-tag tag-success">正常供应中</text>
          </view>
          <!-- 🌟 物资护持交互联动：此前这两行纯展示，义工看到"告急"也无从下手。
               现在整行可点击，根据当前库存状态弹出对应的护持引导——把"看到问题"和
               "下一步能做什么"接起来，而不是让状态标签停在纯信息层面 -->
          <view class="tsc-row tsc-row-tappable" bindtap="onTapMaterialStatus" data-type="rice">
            <text class="tsc-label"><view class="idx-icon-sm idx-icon-box"></view> 大米库存</text>
            <view class="tsc-tag-group">
              <!-- 🌟 智能物资引导：库存不是"充足"时，额外露出一个更醒目的独立跳转入口，
                   不必等义工先点整行、再从弹窗里理解要护持什么——直接把行动号召摆在眼前。
                   catchtap 阻止事件冒泡到父级 .tsc-row-tappable 的 bindtap，避免同一次点击
                   触发两次响应（弹窗 + 跳转） -->
              <text class="action-link" wx:if="{{stapleRiceStatus !== 'sufficient'}}" catchtap="navToSupport" data-type="rice">🌾 点我护持物资</text>
              <text class="tsc-tag {{stapleRiceStatus === 'urgent' ? 'tag-danger' : (stapleRiceStatus === 'sufficient' ? 'tag-success' : 'tag-warning')}}">{{stapleRiceStatus === 'urgent' ? '告急' : (stapleRiceStatus === 'sufficient' ? '充足' : '一般')}}</text>
              <text class="tsc-row-arrow">›</text>
            </view>
          </view>
          <view class="tsc-row tsc-row-tappable" bindtap="onTapMaterialStatus" data-type="oil">
            <text class="tsc-label"><view class="idx-icon-sm idx-icon-box"></view> 食用油库存</text>
            <view class="tsc-tag-group">
              <text class="action-link" wx:if="{{stapleOilStatus !== 'sufficient'}}" catchtap="navToSupport" data-type="oil">🌾 点我护持物资</text>
              <text class="tsc-tag {{stapleOilStatus === 'urgent' ? 'tag-danger' : (stapleOilStatus === 'sufficient' ? 'tag-success' : 'tag-warning')}}">{{stapleOilStatus === 'urgent' ? '告急' : (stapleOilStatus === 'sufficient' ? '充足' : '一般')}}</text>
              <text class="tsc-row-arrow">›</text>
            </view>
          </view>
          <!-- 只读摘要：daily-menu/activity-log 编辑页尚无只读模式，志工不导航过去，仅在此展示摘要。
               🌟 今日食谱动态卡片：todayMenuDishes 是后端自由文本 menuText 按顿号/逗号/换行
               拆出来的菜品名列表（见 splitMenuTextToDishes），只有"看起来确实是一份菜单"
               （拆出 ≥2 段、每段都够短）时才会非空，此时用小网格标签云展示；
               拆不出结构化列表（比如整段说明文字，或菜单本身就没发布）时，
               回退到原来的纯文本单行展示，不强行拆得支离破碎 -->
          <view class="tsc-summary-row tsc-menu-row" wx:if="{{todayMenuLoaded}}">
            <text class="tsc-summary-text" wx:if="{{todayMenuDishes.length === 0}}">🍱 今日食谱：{{todayMenu ? (todayMenu.menuText || '已发布（见图片）') : '尚未发布'}}</text>
            <block wx:else>
              <text class="tsc-summary-text tsc-menu-label">🍱 今日食谱</text>
              <view class="tsc-dish-grid">
                <text class="tsc-dish-chip" wx:for="{{todayMenuDishes}}" wx:key="*this">{{item}}</text>
              </view>
            </block>
          </view>
          <view class="tsc-summary-row" wx:if="{{todayActivityLoaded}}">
            <text class="tsc-summary-text">📌 今日门店日志：{{todayActivity ? todayActivity.title : '尚未发布'}}</text>
          </view>
        </view>
      </view>
