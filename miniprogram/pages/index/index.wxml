    <view class="gencode-modal-card" catchtap="stopPropagation">
      <view class="gencode-header-bar">
        <view class="gencode-title-text"><view class="idx-icon-sm idx-icon-trash" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>全量清洗测试数据</view>
        <text class="gencode-close-btn" bindtap="onCloseDevClearModal">✕</text>
      </view>

      <view class="gencode-body">
        <view class="dev-clear-warning"><view class="idx-icon-sm idx-icon-warning" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>危险操作：此操作将清除所有测试数据，请谨慎使用！</view>

        <view class="dev-clear-options">
          <view class="dev-clear-option">
            <checkbox checked="{{clearOptions.reports}}" value="REPORTS" color="#8C1D18"/>
            <text>清除餐报记录 (daily_reports & report_logs)</text>
          </view>
          <view class="dev-clear-option">
            <checkbox checked="{{clearOptions.requests}}" value="REQUESTS" color="#8C1D18"/>
            <text>清除角色申请与邀请码</text>
          </view>
          <view class="dev-clear-option">
            <checkbox checked="{{clearOptions.cache}}" value="CACHE" color="#8C1D18"/>
            <text>清除本地缓存</text>
          </view>
        </view>

        <view class="dev-clear-input-row">
          <text>请输入大写 CLEAR 确认：</text>
          <input class="dev-clear-input" type="text" placeholder="CLEAR" value="{{clearConfirmInput}}" bindinput="onClearInput"/>
        </view>

        <button class="gencode-btn-primary dev-clear-btn" bindtap="onExecuteDevClear">
        <view class="idx-icon-sm idx-icon-bolt" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>执行全量清洗
      </button>
