  <!-- 小票识别确认弹窗 -->
  <view class="ocr-confirm-modal" wx:if="{{showOcrConfirmModal}}">
    <view class="ocr-mask" bindtap="onOcrConfirmCancel"></view>
    <view class="ocr-modal-card" catchtap="stopPropagation">
      <view class="ocr-modal-header">
        <text class="ocr-modal-title">识别结果确认</text>
        <view class="ocr-modal-close" bindtap="onOcrConfirmCancel">✕</view>
      </view>

      <view class="ocr-modal-subtitle">
        成功识别 {{ocrSuccessCount}} 张小票
        <text class="ocr-total" wx:if="{{ocrSuccessCount > 0}}">，合计：¥{{ocrTotalAmount}}</text>
        <text class="ocr-fail-tip" wx:if="{{ocrFailCount > 0}}">（{{ocrFailCount}} 张未识别）</text>
      </view>

      <!-- 🌟 确认后预计结余实时预览：口径与页面顶部算式校验完全一致（同一套 computeTodayFinancials），
           只是把这批还没点"自动填入"的小票金额也假设性地加进去，让财务在点确认前就能看到
           "这一步会把结余变成多少"，杜绝先确认、后发现结余对不上的返工 -->
      <view class="ocr-preview-banner" wx:if="{{ocrSuccessCount > 0}}">
        <view class="preview-header">
          <view class="idx-icon-sm idx-icon-chart"></view>
          <text class="title">确认后预计结余</text>
        </view>
        <text class="preview-formula">{{ocrPreviewFormula}}</text>
      </view>

      <scroll-view scroll-y class="ocr-detail-container">
        <block wx:for="{{ocrReceiptList}}" wx:key="index">
          <view class="ocr-receipt-block {{item.showWarning ? 'has-warning' : ''}}">
            <!-- 🌟 图文同屏对比：上方小票原图（点击放大），下方识别金额与明细，一屏内完成核对 -->
            <view class="ocr-receipt-image-wrap" wx:if="{{item.fileID}}" bindtap="onPreviewOcrReceiptImage" data-url="{{item.fileID}}">
              <image class="ocr-receipt-image" src="{{item.fileID}}" mode="widthFix" lazy-load="{{true}}" />
              <text class="ocr-receipt-image-hint">点击查看原图</text>
            </view>

            <view class="ocr-receipt-title">
              <text class="receipt-index">第 {{index + 1}} 张</text>
              <text class="receipt-merchant">{{item.merchantName}}</text>
            </view>

            <!-- 🚨 低置信度 / 金额超阈值：红色预警提示，明确告知"仅供参考" -->
            <view class="ocr-warning-banner" wx:if="{{item.showWarning}}">
              <text>⚠️ 识别结果仅供参考，请核对小票原图</text>
            </view>

            <!-- 🌟 结构化财务字段展示：AI/OCR 节点只做"认字"，把原价小计/运费/优惠拆开呈现，
                 让财务/店长能看清"钱是怎么从原价变成下面实付合计的"，而不是只丢一个终值让人盲信 -->
            <view class="ocr-financial-breakdown" wx:if="{{item.rawTotalAmount || item.shippingFee || item.discountAmount}}">
              <view class="breakdown-item" wx:if="{{item.rawTotalAmount}}">
                <text class="breakdown-label">原价小计</text>
                <text class="breakdown-val">¥{{item.rawTotalAmount}}</text>
              </view>
              <view class="breakdown-item" wx:if="{{item.shippingFee && item.shippingFee !== '0.00'}}">
                <text class="breakdown-label">运费</text>
                <text class="breakdown-val">+¥{{item.shippingFee}}</text>
              </view>
              <view class="breakdown-item" wx:if="{{item.discountAmount && item.discountAmount !== '0.00'}}">
                <text class="breakdown-label">优惠</text>
                <text class="breakdown-val discount">-¥{{item.discountAmount}}</text>
              </view>
            </view>

            <!-- 🌟 实付合计人工覆盖：核对小票原图后，可直接在这里改成真实实付金额，
                 不必逐条改商品明细去凑数；这个数字会原样写入最终的今日开餐支出 -->
            <view class="ocr-receipt-amount-row">
              <text class="amount-label">实付合计：</text>
              <view class="amount-edit-wrap {{item.showWarning ? 'price-warning' : ''}}">
                <text class="symbol">¥</text>
                <input
                  class="input-receipt-amount"
                  type="digit"
                  value="{{item.amount}}"
                  bindinput="onEditOcrReceiptAmountInput"
                  bindblur="onEditOcrReceiptAmountBlur"
                  confirm-type="done"
                  data-receipt-index="{{index}}"
                />
              </view>
              <text class="manual-override-badge" wx:if="{{item.manualAmountOverride}}">已手动修改</text>
            </view>

            <view class="ocr-item-list" wx:if="{{item.itemList && item.itemList.length > 0}}">
              <view class="ocr-detail-row" wx:for="{{item.itemList}}" wx:for-item="subItem" wx:for-index="subIdx" wx:key="subIdx">
                <text class="bullet">•</text>
                <!-- 🌟 品名疑似识别异常：云函数只负责结构性清洗（剥离残留的序号乱码字母、
                     标记过短的孤字），不会尝试"猜"出正确品名去自动覆盖——猜错了会把错误数据
                     悄悄写进账本。真正无法结构化判断的字符级错认（如"蜜薯"被认成"面酱"）
                     结构上看不出异常，只能靠这里高亮提醒，交给店长核对小票原图后手动改，
                     这个输入框本身就是可编辑的（onEditOcrItemName），不需要额外操作入口 -->
                <input class="input-item-name {{subItem.isSuspiciousName ? 'name-suspicious' : ''}}" value="{{subItem.name}}" bindinput="onEditOcrItemName" data-receipt-index="{{index}}" data-item-index="{{subIdx}}" />
                <text class="name-suspicious-badge" wx:if="{{subItem.isSuspiciousName}}">⚠️请核对</text>
                <view class="price-edit-wrap {{item.showWarning ? 'price-warning' : ''}}">
                  <text class="symbol">¥</text>
                  <input
                    class="input-item-price"
                    type="digit"
                    value="{{subItem.price}}"
                    bindinput="onEditOcrItemPriceInput"
                    bindblur="onEditOcrItemPriceBlur"
                    confirm-type="done"
                    data-receipt-index="{{index}}"
                    data-item-index="{{subIdx}}"
                    focus="{{ocrFocusFirstPrice && index === 0 && subIdx === 0}}"
                    selection-start="0"
                    selection-end="{{ocrFocusSelectionEnd}}"
                  />
                </view>
              </view>
            </view>
            <view class="ocr-detail-fallback" wx:else>
              <text>{{item.formattedText}}</text>
            </view>
          </view>
        </block>
      </scroll-view>

      <view class="ocr-modal-footer">
        <button class="ocr-btn cancel" bindtap="onOcrConfirmCancel">取消</button>
        <button class="ocr-btn adjust" bindtap="onOcrAdjustCategory">调整分类</button>
        <button class="ocr-btn confirm" bindtap="onOcrAutoFill">自动填入</button>
      </view>
    </view>
  </view>

  <view class="announcement-modal" wx:if="{{showAnnouncementModal}}" bindtap="closeAnnouncement">
