<view class="container">
  <view class="header">{{shopName}}用餐汇报助手</view>
  
  <view class="section">
    <view class="toggle-header" bindtap="toggleSettings">
      <text class="toggle-icon">⚙️</text>
      <text class="toggle-title">店铺模板自定义</text>
      <text class="toggle-arrow">{{showSettings ? '▼' : '▶'}}</text>
    </view>
    <view class="toggle-content" wx:if="{{showSettings}}">
      <view class="row">
        <view class="col">
          <text class="label">店铺名称</text>
          <input class="input" value="{{shopName}}" bindinput="onInput" data-field="shopName" />
        </view>
        <view class="col">
          <text class="label">公众号名称</text>
          <input class="input" value="{{mpAccount}}" bindinput="onInput" data-field="mpAccount" />
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="row">
      <view class="col">
        <text class="label">汇报日期</text>
        <input class="input" value="{{reportDate}}" bindinput="onInput" data-field="reportDate" />
      </view>
      <view class="col">
        <text class="label">昨日店铺余额</text>
        <input class="input" type="digit" value="{{prevBalance}}" bindinput="onInput" data-field="prevBalance" />
      </view>
    </view>
  </view>

  <view class="section">
    <text class="label">爱心人士供养总输入框 (支持一次性粘贴所有名单，每行一个)</text>
    <view class="textarea-wrap">
      <textarea class="textarea" auto-height placeholder="可以直接把所有供养名单一次性全部贴在这里。例如：&#10;黄玉珍 16&#10;周瑞德 2&#10;吴建平 3&#10;邢善积德 2" value="{{allDonations}}" bindinput="onInput" data-field="allDonations" />
    </view>
  </view>

  <view class="section">
    <text class="label">其他随喜/现场供养金额 (对应示例末尾固定加项)</text>
    <input class="input" type="digit" placeholder="如：5" value="{{batch4}}" bindinput="onInput" data-field="batch4" />
  </view>

  <view class="section">
    <text class="label">店铺支出说明 (请在末尾带上数字，如：装修地板2000)</text>
    <input class="input" placeholder="例如：装修地板2000" value="{{expenses}}" bindinput="onInput" data-field="expenses" />
  </view>

  <button class="btn-generate" bindtap="generateReport">⚡ 一键生成汇报文本</button>
  <button class="btn-history" bindtap="goToHistory">📜 查看历史餐报记录</button>
  <button class="btn-statistics" bindtap="goToStatistics">📊 统计分析</button>

  <block wx:if="{{showResult}}">
    <view class="output-box">
      <text class="label">生成结果：</text>
      <text class="output-text" user-select>{{reportResult}}</text>
      <button class="btn-copy" bindtap="copyText">📋 复制文本到剪贴板</button>
    </view>
  </block>
</view>