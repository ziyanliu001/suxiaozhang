  <!-- 扫码绑定义工申请 Modal -->
  <!-- 🌟 门店申请弹窗：三段式布局（Header 固定 / Body 可滚动 / Footer 固定置底）
       彻底解决表单内容多时底部提交按钮被遮挡的问题。
       Body 用 scroll-view 包裹，max-height: 50vh 保证内部滚动不挤压 Footer。 -->
  <view class="apply-modal-mask" wx:if="{{showApplyModal}}" bindtap="onCloseApplyModal">
    <view class="apply-modal-card" catchtap="stopPropagation">

      <!-- 1. Header（固定） -->
      <view class="apply-modal-header">
        <text class="apply-modal-title">
          <view class="idx-icon-sm idx-icon-note" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>{{applyForm.storeSelectionType === 'custom' ? '申请加入新门店' : (applyForm.storeName ? '加入【' + applyForm.storeName + '】' : '申请加入门店')}}
        </text>
        <text class="apply-modal-close" bindtap="onCloseApplyModal">✕</text>
      </view>

      <!-- 2. Body（可滚动，max-height: 50vh 保证内容多时内部滚动） -->
      <scroll-view scroll-y class="apply-modal-body" style="max-height: 50vh;">

        <view class="form-item">
          <text class="form-label">门店</text>
          <view class="store-mode-tabs">
            <view class="store-mode-tab {{applyForm.storeSelectionType === 'existing' ? 'active' : ''}}" data-mode="existing" bindtap="onSwitchApplyStoreMode">选择已有门店</view>
            <view class="store-mode-tab {{applyForm.storeSelectionType === 'custom' ? 'active' : ''}}" data-mode="custom" bindtap="onSwitchApplyStoreMode">新建门店</view>
          </view>

          <picker wx:if="{{applyForm.storeSelectionType === 'existing'}}" mode="selector" range="{{allStoresList}}" range-key="storeName" bindchange="onSelectApplyStore">
            <view class="form-picker-selector">{{applyForm.storeName || '请选择门店'}}</view>
          </picker>
          <input wx:else class="form-input" placeholder="请输入新门店名称，如：雨花斋厦门海沧店" value="{{applyForm.customStoreName}}" bindinput="onCustomStoreNameInput" />
          <text class="form-hint" wx:if="{{applyForm.storeSelectionType === 'custom'}}">新门店需待超级管理员审核通过后自动建立</text>
        </view>

        <!-- 🏪 新建门店档案补全：门店此刻还不存在，地址/联系电话/门店照片先收进
             申请表单，超管审核通过后由 processRoleAudit 一并写入新建的门店档案 -->
        <block wx:if="{{applyForm.storeSelectionType === 'custom'}}">
          <view class="form-item">
            <text class="form-label">门店地址</text>
            <input class="form-input" placeholder="请输入门店详细地址" value="{{applyForm.address}}" bindinput="onApplyAddressInput" />
          </view>
          <view class="form-item">
            <text class="form-label">联系电话</text>
            <input class="form-input" type="number" placeholder="请输入门店联系电话" value="{{applyForm.contactPhone}}" bindinput="onApplyContactPhoneInput" />
          </view>
          <view class="form-item">
            <text class="form-label">门店照片</text>
            <view class="receipt-grid-container">
              <view class="grid-image-item" wx:for="{{applyForm.storePhotos}}" wx:key="*this">
                <image class="grid-img" src="{{item}}" mode="aspectFill" bindtap="onPreviewImage" data-url="{{item}}" />
                <view class="img-delete-badge" catchtap="onDeleteApplyStorePhoto" data-index="{{index}}">✕</view>
              </view>
              <view class="grid-add-btn" bindtap="onChooseApplyStorePhoto" wx:if="{{applyForm.storePhotos.length < 9}}">
                <text class="add-icon">{{applyStorePhotoUploading ? '…' : '+'}}</text>
                <text class="add-txt">{{applyStorePhotoUploading ? '压缩中' : '添加照片'}}</text>
              </view>
            </view>
          </view>
        </block>

        <view class="form-item">
          <text class="form-label">真实姓名 <text class="form-required">*</text></text>
          <input class="form-input" placeholder="请输入真实姓名" value="{{applyForm.realName}}" bindinput="onApplyRealNameInput" />
        </view>
        <view class="form-item">
          <text class="form-label">手机号 <text class="form-required">*</text></text>
          <input class="form-input" type="number" placeholder="请输入手机号" value="{{applyForm.phone}}" bindinput="onApplyPhoneInput" />
        </view>
        <view class="form-item">
          <text class="form-label">申请岗位</text>
          <!-- 🌟 动态联动：切换岗位时 applyRoleTipText 与 applyRequiredHint 随之更新，
               大家长需额外补全门店档案（新建门店时）；义工免审即时生效 -->
          <radio-group class="role-radio-group" bindchange="onApplyRoleChange">
            <label class="role-radio-item">
              <radio value="store_patriarch" checked="{{applyForm.requestedRole === 'store_patriarch'}}" />
              <text>👑 大家长</text>
            </label>
            <label class="role-radio-item">
              <radio value="store_manager" checked="{{applyForm.requestedRole === 'store_manager'}}" />
              <text>🗂️ 店长</text>
            </label>
            <label class="role-radio-item">
              <radio value="finance" checked="{{applyForm.requestedRole === 'finance'}}" />
              <text>💰 财务义工</text>
            </label>
            <label class="role-radio-item">
              <radio value="volunteer" checked="{{applyForm.requestedRole === 'volunteer'}}" />
              <text>🤝 现场义工</text>
            </label>
          </radio-group>
          <text class="form-hint apply-role-tip apply-role-tip-{{applyRoleTipVariant}}">{{applyRoleTipText}}</text>
        </view>
        <view class="fa-safe-area-spacer"></view>
      </scroll-view>

      <!-- 3. Footer（固定置底，不随 Body 滚动） -->
      <view class="apply-modal-footer">
        <button
          class="btn-submit-apply"
          bindtap="onSubmitRoleApply"
          disabled="{{isSubmittingApply}}"
          loading="{{isSubmittingApply}}"
        >提交申请</button>
      </view>

    </view>
  </view>

  <!-- ================= 🔑 生成邀请码弹窗 (仅限超级管理员/店长/大家长，见 onOpenGenCodeModal 权限阶梯) ================= -->
  <view class="gencode-modal-mask" wx:if="{{showGenCodeModal}}" bindtap="onCloseGenCodeModal">
    <view class="gencode-modal-card" catchtap="stopPropagation">
      <view class="gencode-header-bar">
        <view class="gencode-title-text"><view class="idx-icon-sm idx-icon-key" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>新增特权邀请码</view>
        <text class="gencode-close-btn" bindtap="onCloseGenCodeModal">✕</text>
      </view>

      <view class="gencode-body">
        <!-- 1. 选择目标门店：仅面向本机构已有门店生成邀请码——"手动输入新门店"这一档
             已彻底移除，它此前生成的邀请码 storeId 为空，而唯一的兑换入口
             永远按选中的真实 storeId 匹配，受邀人的门店选择器里根本找不到一个还不存在
             的门店，等于生成了一个 100% 无法兑换的邀请码。新建门店请走"门店选择器 →
             找不到门店？申请新建/加入新门店"这条完整、可用的独立通道。
             🛡️ 发码防越权：非超管（店长/大家长）强制锁定为当前所属门店且禁用切换
             （genStoreSelectorDisabled，见 onOpenGenCodeModal），从入口就杜绝跨店发码。 -->
        <view class="form-item-row">
          <text class="form-label">1. 选择授权门店：</text>

          <picker wx:if="{{genStoreOptions.length > 0 && !genStoreSelectorDisabled}}" mode="selector" range="{{genStoreOptions}}" range-key="storeName" bindchange="onSelectGenStore">
            <view class="form-picker-selector">
              {{targetGenStoreName || '点击选择门店 ▼'}}
            </view>
          </picker>
          <view class="form-picker-selector form-picker-locked" wx:elif="{{genStoreOptions.length > 0 && genStoreSelectorDisabled}}">
            <text>{{targetGenStoreName}}</text>
            <text class="picker-locked-tag">🔒 仅限本店</text>
          </view>
          <view class="gencode-no-store-tip" wx:else>
            本机构暂无门店，请先在「门店管理」创建门店后再生成邀请码
          </view>
        </view>

        <!-- 2. 选择授权特权角色：默认选中身份由打开入口决定——
             从【财务稽核台】的"邀请协同"进来（onOpenFinanceInviteMenu）默认选中
             【门店财务】（超管/大家长/店长三档都够权限），从【门店推广与邀请】
             进来（onOpenGenCodeModal）默认选中 genAvailableRoles 的第一项。
             🏛️ 权限层级重构：大家长确立为门店最高负责人，与超管一样可选全部
             五种身份（含继任大家长/门店店长）；店长次一级，可选【门店财务】
             【家人】【志愿者】，但不能任命【大家长】【门店店长】（与自身同级
             或更高，只有大家长/超管能任命）。genAvailableRoles 不含的选项
             置灰禁用（gencode-role-disabled），点击不生效，见 onSelectGenRole
             的二次拦截。 -->
        <view class="form-item-row">
          <text class="form-label">2. 选择授权身份：</text>
          <view class="gencode-role-group">
            <view class="gencode-role-item {{genTargetRole === 'PATRIARCH' ? 'active' : 'inactive'}} {{!genAvailableRoles.includes('PATRIARCH') ? 'gencode-role-disabled' : ''}}"
                  bindtap="onSelectGenRole" data-role="PATRIARCH">
              <view class="role-check-badge" wx:if="{{genTargetRole === 'PATRIARCH'}}">✓</view>
              <view class="idx-icon-sm idx-icon-handshake" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>
              <text>大家长</text>
            </view>
            <view class="gencode-role-item {{genTargetRole === 'MANAGER' ? 'active' : 'inactive'}} {{!genAvailableRoles.includes('MANAGER') ? 'gencode-role-disabled' : ''}}"
                  bindtap="onSelectGenRole" data-role="MANAGER">
              <view class="role-check-badge" wx:if="{{genTargetRole === 'MANAGER'}}">✓</view>
              <view class="idx-icon-sm idx-icon-crown" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>
              <text>门店店长</text>
            </view>
            <view class="gencode-role-item {{genTargetRole === 'FINANCE' ? 'active' : 'inactive'}} {{!genAvailableRoles.includes('FINANCE') ? 'gencode-role-disabled' : ''}}"
                  bindtap="onSelectGenRole" data-role="FINANCE">
              <view class="role-check-badge" wx:if="{{genTargetRole === 'FINANCE'}}">✓</view>
              <view class="idx-icon-sm idx-icon-lock" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>
              <text>门店财务</text>
            </view>
            <view class="gencode-role-item {{genTargetRole === 'FAMILY' ? 'active' : 'inactive'}} {{!genAvailableRoles.includes('FAMILY') ? 'gencode-role-disabled' : ''}}"
                  bindtap="onSelectGenRole" data-role="FAMILY">
              <view class="role-check-badge" wx:if="{{genTargetRole === 'FAMILY'}}">✓</view>
              <view class="idx-icon-sm idx-icon-people" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>
              <text>家人</text>
            </view>
            <view class="gencode-role-item {{genTargetRole === 'VOLUNTEER' ? 'active' : 'inactive'}} {{!genAvailableRoles.includes('VOLUNTEER') ? 'gencode-role-disabled' : ''}}"
                  bindtap="onSelectGenRole" data-role="VOLUNTEER">
              <view class="role-check-badge" wx:if="{{genTargetRole === 'VOLUNTEER'}}">✓</view>
              <view class="idx-icon-sm idx-icon-heart" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>
              <text>志愿者</text>
            </view>
          </view>
          <!-- 🏛️ 大家长（含超管）：全部五档身份都已解锁，给一句正向的授权说明，
               不再是"需要超级管理员授权"这种限制口吻 -->
          <view class="gencode-role-empower-tip" wx:if="{{isPatriarch || isSuperAdmin}}">
            👑 大家长作为最高负责人，可直接任命店长、财务及继任大家长。
          </view>
          <!-- 🔒 店长：仍有两档任命不了，给出准确的限制说明——找大家长而不是只说超管 -->
          <view class="gencode-role-restrict-tip" wx:elif="{{!genAvailableRoles.includes('MANAGER')}}">
            🔒 店长仅可发放【门店财务】【家人】【志愿者】邀请码，大家长/门店店长身份需大家长或超级管理员授权
          </view>
        </view>
      </view>

      <!-- 底部操作按钮：点击【立即生成】调用云函数生成成功后，关闭本弹窗、
           打开下方的"生成结果"弹窗（inviteResultModal）展示邀请码 + 太阳码 -->
      <view class="gen-code-footer">
        <button class="btn-cancel" bindtap="onCloseGenCodeModal">关闭</button>
        <button class="btn-primary-gen {{(isGeneratingInviteCode || !targetGenStoreId) ? 'btn-disabled' : ''}}" bindtap="onGenerateInviteCode" loading="{{isGeneratingInviteCode}}" disabled="{{isGeneratingInviteCode || !targetGenStoreId}}">
          <view class="idx-icon-sm idx-icon-bolt" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>立即生成
        </button>
      </view>
    </view>
  </view>

  <!-- ================= 🔑 邀请码生成结果弹窗：邀请码 + 太阳码 + 复制/保存/分享 ================= -->
  <view class="invite-result-modal-mask" wx:if="{{showInviteResultModal}}" bindtap="onCloseInviteResultModal">
    <view class="invite-result-modal-card" catchtap="stopPropagation">
      <view class="gencode-header-bar">
        <view class="gencode-title-text"><view class="idx-icon-sm idx-icon-sparkle" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>邀请码生成成功</view>
        <text class="gencode-close-btn" bindtap="onCloseInviteResultModal">✕</text>
      </view>

      <view class="invite-result-summary">
        为【{{inviteResultStoreName}}】生成的【{{inviteResultRoleLabel}}】专属邀请码
      </view>

      <view class="invite-result-code-box">
        <text class="invite-result-code" user-select bindtap="onCopyInviteResultCode">{{inviteResultCode}}</text>
        <view class="invite-result-copy-btn" bindtap="onCopyInviteResultCode">
          <view class="idx-icon-sm idx-icon-clipboard" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>一键复制邀请码
        </view>
      </view>

      <view class="invite-result-qr-box" wx:if="{{inviteResultQrPath}}">
        <image class="invite-result-qr-img" src="{{inviteResultQrPath}}" mode="aspectFit" show-menu-by-longpress bindtap="onSaveInviteResultQr" />
        <text class="invite-result-qr-hint">长按或点击太阳码保存到相册</text>
      </view>

      <view class="invite-result-tip">
        <view class="idx-icon-sm idx-icon-warning" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>该邀请码为一次性特权码，有效期 24 小时，核销后自动作废。
      </view>

      <view class="gen-code-footer">
        <button class="btn-cancel" bindtap="onSaveInviteResultQr">保存太阳码</button>
        <button class="btn-primary-gen" bindtap="onShareInviteResultCode">
          <view class="idx-icon-sm idx-icon-link" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>复制邀请文案
        </button>
      </view>
    </view>
  </view>

  <!-- 🌟 历史名单·选择常客弹窗：按本地缓存的出现次数倒序展示，点一下姓名直接插入
       批量粘贴文本框新的一行，金额仍需用户当天手动填写 -->
  <view class="frequent-donor-modal-mask" wx:if="{{showFrequentDonorModal}}" bindtap="onCloseFrequentDonorModal">
    <view class="frequent-donor-modal-card" catchtap="stopPropagation">
      <!-- 🛡️ 去宗教化合规要求："功德主"是佛教语境里对施主的称谓，统一改用
           "常客"这一现代公益/志愿服务通用称谓，与触发此弹窗的【选择常客】按钮措辞保持一致 -->
      <view class="frequent-donor-header">
        <text class="title">🕒 常客名单</text>
        <text class="close-btn" bindtap="onCloseFrequentDonorModal">✕</text>
      </view>

      <view class="frequent-donor-empty" wx:if="{{frequentDonorList.length === 0}}">
        <text>暂无历史记录，成功提交几次餐报后，这里会自动出现常来支持的爱心人士名单</text>
      </view>

      <scroll-view scroll-y class="frequent-donor-list" wx:else>
        <view class="frequent-donor-item" wx:for="{{frequentDonorList}}" wx:key="name" bindtap="onSelectFrequentDonor" data-name="{{item.name}}">
          <text class="donor-name">{{item.name}}</text>
          <text class="donor-count">出现 {{item.count}} 次</text>
        </view>
        <view class="fa-safe-area-spacer"></view>
      </scroll-view>
    </view>
  </view>

  <!-- 🌟 高频账目模板弹窗：门店常用支出项目速录，云端存储、店铺内共享（区别于上面
       "选择常客"的本地设备记忆）。店长/财务/超管可增删，全员可点击插入表单 -->
  <view class="expense-template-modal-mask" wx:if="{{showExpenseTemplateModal}}" bindtap="onCloseExpenseTemplateModal">
    <view class="expense-template-modal-card" catchtap="stopPropagation">
      <view class="expense-template-header">
        <text class="title">🧾 常用支出项目</text>
        <text class="close-btn" bindtap="onCloseExpenseTemplateModal">✕</text>
      </view>

      <view class="expense-template-segmented">
        <view
          class="segment-btn {{expenseTemplateCategory === 'daily' ? 'active' : ''}}"
          bindtap="onSwitchExpenseTemplateCategory"
          data-category="daily"
        ><text class="txt">开餐食材</text></view>
        <view
          class="segment-btn {{expenseTemplateCategory === 'fixed' ? 'active' : ''}}"
          bindtap="onSwitchExpenseTemplateCategory"
          data-category="fixed"
        ><text class="txt">大额专项</text></view>
      </view>

      <view class="expense-template-manage-row" wx:if="{{isManager || isFinance || isSuperAdmin}}">
        <text class="manage-toggle" bindtap="onToggleExpenseTemplateEditMode">{{expenseTemplateEditMode ? '完成' : '✏️ 管理'}}</text>
      </view>

      <view class="expense-template-add-row" wx:if="{{expenseTemplateEditMode}}">
        <input class="name-input" placeholder="项目名称" value="{{expenseTemplateNewName}}" bindinput="onInputExpenseTemplateNewName" />
        <input class="amount-input" type="digit" placeholder="默认金额(选填)" value="{{expenseTemplateNewAmount}}" bindinput="onInputExpenseTemplateNewAmount" />
        <button class="btn-add-item" bindtap="onAddExpenseTemplateItem" loading="{{expenseTemplateSaving}}">+ 添加</button>
      </view>

      <block wx:if="{{expenseTemplateCategory === 'daily'}}">
        <view class="expense-template-empty" wx:if="{{expenseTemplateLoaded && expenseTemplateDailyList.length === 0}}">
          <text>暂无常用项目{{(isManager || isFinance || isSuperAdmin) ? '，点上方"管理"添加几个常买的食材吧' : ''}}</text>
          <button
            wx:if="{{isManager || isFinance || isSuperAdmin}}"
            class="btn-quick-import-template"
            bindtap="onQuickImportExpenseTemplates"
            loading="{{expenseTemplateSaving}}"
          >⚡️ 一键导入公益常用标签</button>
        </view>
        <scroll-view scroll-y enable-flex="true" class="expense-template-chip-list" wx:else>
          <view class="expense-template-chip" wx:for="{{expenseTemplateDailyList}}" wx:key="_id" bindtap="onSelectExpenseTemplateItem" data-id="{{item._id}}" data-name="{{item.itemName}}" data-amount="{{item.defaultAmount}}">
            <text class="chip-name">{{item.itemName}}</text>
            <text class="chip-amount" wx:if="{{item.defaultAmount}}">¥{{item.defaultAmount}}</text>
            <text class="chip-rename" wx:if="{{expenseTemplateEditMode}}" catchtap="onRenameExpenseTemplateItem" data-id="{{item._id}}" data-name="{{item.itemName}}">✏️</text>
            <text class="chip-del" wx:if="{{expenseTemplateEditMode}}" catchtap="onDeleteExpenseTemplateItem" data-id="{{item._id}}">✕</text>
          </view>
          <view class="fa-safe-area-spacer"></view>
        </scroll-view>
      </block>
      <block wx:else>
        <view class="expense-template-empty" wx:if="{{expenseTemplateLoaded && expenseTemplateFixedList.length === 0}}">
          <text>暂无常用项目{{(isManager || isFinance || isSuperAdmin) ? '，点上方"管理"添加房租等固定支出吧' : ''}}</text>
          <button
            wx:if="{{isManager || isFinance || isSuperAdmin}}"
            class="btn-quick-import-template"
            bindtap="onQuickImportExpenseTemplates"
            loading="{{expenseTemplateSaving}}"
          >⚡️ 一键导入公益常用标签</button>
        </view>
        <scroll-view scroll-y enable-flex="true" class="expense-template-chip-list" wx:else>
          <view class="expense-template-chip" wx:for="{{expenseTemplateFixedList}}" wx:key="_id" bindtap="onSelectExpenseTemplateItem" data-id="{{item._id}}" data-name="{{item.itemName}}" data-amount="{{item.defaultAmount}}">
            <text class="chip-name">{{item.itemName}}</text>
            <text class="chip-amount" wx:if="{{item.defaultAmount}}">¥{{item.defaultAmount}}</text>
            <text class="chip-rename" wx:if="{{expenseTemplateEditMode}}" catchtap="onRenameExpenseTemplateItem" data-id="{{item._id}}" data-name="{{item.itemName}}">✏️</text>
            <text class="chip-del" wx:if="{{expenseTemplateEditMode}}" catchtap="onDeleteExpenseTemplateItem" data-id="{{item._id}}">✕</text>
          </view>
          <view class="fa-safe-area-spacer"></view>
        </scroll-view>
      </block>
    </view>
  </view>

  <!-- ⚡ 极速记账：开餐食材 Chip 点击后的金额确认迷你弹窗，项目名称已带入，
       金额输入框自动 focus，确认后拼进 dailyExpenseText -->
  <view class="quick-amount-modal-mask" wx:if="{{showQuickAmountModal}}" bindtap="onCloseQuickAmountModal">
    <view class="quick-amount-modal-card" catchtap="stopPropagation">
      <view class="quick-amount-header">
        <text class="title">{{quickAmountItemName}}</text>
        <text class="close-btn" bindtap="onCloseQuickAmountModal">✕</text>
      </view>
      <view class="quick-amount-input-row">
        <text class="currency">¥</text>
        <input
          class="quick-amount-input"
          type="digit"
          placeholder="输入金额（选填）"
          value="{{quickAmountValue}}"
          bindinput="onInputQuickAmountValue"
          focus="{{showQuickAmountModal}}"
          confirm-type="done"
          bindconfirm="onConfirmQuickAmount"
        />
      </view>
      <button class="quick-amount-confirm-btn" bindtap="onConfirmQuickAmount">✔ 确认带入</button>
    </view>
  </view>

  <!-- 图片压缩用离屏画布：餐报表单内"今日食谱照片"/"今日大事记照片"上传区共用 -->
  <canvas type="2d" id="imgCompressCanvas" style="position: fixed; left: -9999px; top: -9999px; width: 1920px; height: 1920px;"></canvas>

  <!-- 店长审核义工绑定抽屉 Modal -->
  <view class="audit-drawer-mask" wx:if="{{showAuditModal}}" bindtap="onCloseAuditModal">
    <view class="audit-drawer-box" catchtap="stopPropagation">

      <!-- Header -->
      <view class="drawer-header-bar">
        <view class="header-title-box">
          <view class="header-icon idx-icon-svg idx-icon-people"></view>
          <text class="header-title-text">门店审核</text>
        </view>
        <view class="btn-close-drawer-circle" bindtap="onCloseAuditModal">✕</view>
      </view>

      <!-- Tab 选项卡：底部滑动指示条随 auditActiveTab 平移动画 + 数量徽章 -->
      <view class="audit-tab-segment">
        <view class="tab-slide-indicator {{auditActiveTab === 'approved' ? 'to-second' : ''}}"></view>
        <view
          class="tab-item {{auditActiveTab === 'pending' ? 'active' : ''}}"
          bindtap="onSwitchAuditTab"
          data-tab="pending"
        >
          待审核列表
          <text class="tab-count-badge {{pendingApplyList.length > 0 ? 'has-count' : ''}}">{{pendingApplyList.length}}</text>
        </view>
        <view
          class="tab-item {{auditActiveTab === 'approved' ? 'active' : ''}}"
          bindtap="onSwitchAuditTab"
          data-tab="approved"
        >
          已审核通过
          <text class="tab-count-badge {{approvedVolunteerList.length > 0 ? 'has-count' : ''}}">{{approvedVolunteerList.length}}</text>
        </view>
      </view>

      <!-- 👥 角色筛选 Segment：两个 Tab 共用 -->
      <view class="audit-role-filter-segment">
        <view class="role-filter-chip {{auditRoleFilter === 'all' ? 'active' : ''}}" bindtap="onSwitchAuditRoleFilter" data-filter="all">全部</view>
        <view class="role-filter-chip {{auditRoleFilter === 'volunteer' ? 'active' : ''}}" bindtap="onSwitchAuditRoleFilter" data-filter="volunteer">义工</view>
        <view class="role-filter-chip {{auditRoleFilter === 'finance' ? 'active' : ''}}" bindtap="onSwitchAuditRoleFilter" data-filter="finance">财务</view>
        <view class="role-filter-chip {{auditRoleFilter === 'leader' ? 'active' : ''}}" bindtap="onSwitchAuditRoleFilter" data-filter="leader">大家长/店长</view>
      </view>

      <!-- 🔍 已通过列表姓名/手机号搜索 -->
      <view class="audit-search-box" wx:if="{{auditActiveTab === 'approved'}}">
        <text class="audit-search-icon">🔍</text>
        <input
          class="audit-search-input"
          placeholder="搜索姓名/手机号"
          value="{{auditSearchKeyword}}"
          bindinput="onAuditSearchInput"
          confirm-type="search"
        />
        <view class="audit-search-clear" wx:if="{{auditSearchKeyword}}" bindtap="onClearAuditSearch">✕</view>
      </view>

      <!-- 滚动列表区 -->
      <scroll-view scroll-y class="drawer-content-scroll">

        <!-- 🦴 骨架屏：弹窗刚拉起/切 Tab 云函数还没返回时的占位卡片，避免空状态插画
             先闪一下、数据到了才变成列表这种视觉跳动 -->
        <view class="audit-skeleton-list" wx:if="{{auditListLoading}}">
          <view class="skeleton-card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
            <view class="skeleton-row">
              <view class="skeleton-avatar"></view>
              <view class="skeleton-lines">
                <view class="skeleton-line w60"></view>
                <view class="skeleton-line w40"></view>
              </view>
              <view class="skeleton-badge"></view>
            </view>
            <view class="skeleton-line w80 spaced"></view>
            <view class="skeleton-btns">
              <view class="skeleton-btn"></view>
              <view class="skeleton-btn wide"></view>
            </view>
          </view>
        </view>

        <!-- 待审核列表 -->
        <block wx:if="{{auditActiveTab === 'pending' && !auditListLoading}}">
          <view class="audit-applicant-card" wx:for="{{filteredPendingList}}" wx:key="applyId">
            <view class="card-top-info">
              <view class="applicant-avatar-wrap">
                <image class="applicant-avatar" wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" />
                <view class="applicant-avatar-placeholder" wx:else>👤</view>
              </view>
              <view class="applicant-main">
                <text class="applicant-name">{{mask.maskName(item.realName) || '义工家人'}}</text>
                <text class="applicant-phone {{!item.phone ? 'unbound' : ''}}" bindtap="onTapApplicantPhone" data-phone="{{item.phone}}">
                  <view class="idx-icon-sm idx-icon-phone" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>{{item.phone ? mask.maskPhone(item.phone) : '未绑定手机'}}
                </text>
              </view>
              <text class="role-tag-badge {{item.role}}">
                {{item.role === 'finance' ? '🏅 财务申请' : (item.role === 'store_patriarch' ? '🏛️ 家长申请' : (item.role === 'store_manager' ? '👑 店长申请' : '🙋 现场奉献'))}}
              </text>
            </view>

            <view class="card-time-row">
              <text class="time-lbl">申请门店：{{item.isCustomStore ? ('🆕 ' + item.storeName + '（新建）') : item.storeName}}</text>
            </view>
            <view class="card-time-row">
              <text class="time-lbl">申请时间：{{item.timeStr || '近期'}}</text>
            </view>

            <view class="card-action-btns">
              <button
                class="btn-audit-act reject"
                bindtap="onOpenAuditRejectModal"
                data-id="{{item.applyId}}"
              >
                拒绝
              </button>
              <button
                class="btn-audit-act approve"
                bindtap="onProcessAudit"
                data-id="{{item.applyId}}"
                data-action="approve"
              >
                通过绑定
              </button>
            </view>
          </view>

          <view class="warm-empty-state" wx:if="{{pendingApplyList.length === 0}}">
            <view class="empty-emoji-circle">
              <view class="empty-emoji-icon idx-icon-svg idx-icon-sparkle"></view>
            </view>
            <text class="empty-title">{{auditIsNationalView ? '当前全国各门店暂无待处理的申请' : '当前暂无待处理的绑定申请'}}</text>
            <text class="empty-desc" wx:if="{{!auditIsNationalView}}">您可以生成门店邀请海报，邀请财务或现场义工扫码绑定。</text>
            <button class="btn-empty-invite" bindtap="onGenerateStorePosterFromAudit">
              🏪 生成门店邀请海报
            </button>
          </view>
          <view class="warm-empty-state" wx:elif="{{filteredPendingList.length === 0}}">
            <text class="empty-title">未找到匹配「{{auditRoleFilter === 'volunteer' ? '义工' : (auditRoleFilter === 'finance' ? '财务' : '大家长/店长')}}」的待审核申请</text>
          </view>
        </block>

        <!-- 已绑定义工列表 -->
        <block wx:if="{{auditActiveTab === 'approved' && !auditListLoading}}">
          <view class="audit-applicant-card approved-card" wx:for="{{filteredApprovedList}}" wx:key="applyId">
            <view class="card-top-info">
              <view class="applicant-avatar-wrap">
                <image class="applicant-avatar" wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" />
                <view class="applicant-avatar-placeholder" wx:else>👤</view>
              </view>
              <view class="applicant-main">
                <text class="applicant-name">{{mask.maskName(item.realName)}}</text>
                <text class="applicant-phone {{!item.phone ? 'unbound' : ''}}" bindtap="onTapApplicantPhone" data-phone="{{item.phone}}">
                  <view class="idx-icon-sm idx-icon-phone" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>{{item.phone ? mask.maskPhone(item.phone) : '未绑定手机'}}
                </text>
              </view>
              <text class="role-tag-badge {{item.role}}">
                {{item.role === 'finance' ? '🏅 财务记账' : (item.role === 'store_patriarch' ? '🏛️ 大家长' : (item.role === 'store_manager' ? '👑 店长' : '🙋 现场奉献'))}}
              </text>
            </view>

            <view class="card-time-row">
              <text class="time-lbl">通过时间：{{item.timeStr || '近期'}}</text>
            </view>

            <!-- 🛡️ 变更角色/解除绑定仅支持 finance/volunteer：店长/大家长权限回收需走更审慎的
                 专属流程（manageVolunteerBinding 云函数本身也拒绝这两类角色），此处直接不出按钮，
                 避免点了才弹"无权限"提示 -->
            <view class="card-action-btns" wx:if="{{item.role === 'finance' || item.role === 'volunteer'}}">
              <button
                class="btn-audit-act change-role"
                bindtap="onChangeVolunteerRole"
                data-id="{{item.applyId}}"
              >
                🔄 变更角色
              </button>
              <button
                class="btn-audit-act unbind"
                bindtap="onUnbindVolunteer"
                data-id="{{item.applyId}}"
              >
                🚫 解除绑定
              </button>
            </view>
          </view>

          <view class="warm-empty-state" wx:if="{{approvedVolunteerList.length === 0}}">
            <view class="empty-emoji-circle">
              <view class="empty-emoji-icon idx-icon-svg idx-icon-flower"></view>
            </view>
            <text class="empty-title">本店暂无已审核通过的记录</text>
          </view>
          <view class="warm-empty-state" wx:elif="{{filteredApprovedList.length === 0}}">
            <text class="empty-title">{{auditSearchKeyword ? '未找到匹配「' + auditSearchKeyword + '」的记录' : '未找到匹配当前筛选条件的记录'}}</text>
          </view>
        </block>

      </scroll-view>
    </view>
  </view>

  <!-- 门店邀请海报预览 Modal -->
  <!-- 🐛 布局重构：绘制用 canvas 挪到屏幕外离屏渲染（与 statistics.wxml
       posterCanvas 同一套做法），弹窗里实际展示的是 canvasToTempFilePath 导出的
       静态图片——canvas 是原生组件，尺寸固定死在 wxml style 里（此前 320px/500px
       是写死的绝对像素），在小屏手机上完全不参与弹窗的 flex 收缩，海报下半截连同
       底部分享按钮一起被 max-height:85vh 硬裁掉；改成 <image mode="widthFix">
       后就是普通文档流元素，能跟着 .poster-preview-wrapper 的 flex:1+滚动兜底
       正常收缩，分享按钮固定在弹窗底部永远可见 -->
  <canvas
    type="2d"
    id="storePosterCanvas"
    class="store-poster-canvas-offscreen"
    style="width: 320px; height: 500px;"
  ></canvas>

  <view class="store-poster-mask" wx:if="{{showStorePosterModal}}" catchtap="onCloseStorePosterModal">
    <view class="store-poster-box" catchtap="stopPropagation">
      <view class="modal-header-row">
        <view class="modal-title"><view class="idx-icon-sm idx-icon-image" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>门店邀请绑定海报</view>
        <view class="btn-close-modal-circle" hover-class="ui-hover" bindtap="onCloseStorePosterModal">
          ✕
        </view>
      </view>

      <view class="poster-preview-wrapper">
        <image
          wx:if="{{storePosterTempFilePath}}"
          class="poster-preview-img"
          mode="widthFix"
          show-menu-by-longpress
          src="{{storePosterTempFilePath}}"
        />
        <!-- 🛡️ Canvas 白屏修复：绘制耗时期间（云端二维码下载+本地作图）盖一层
             品牌色 Loading 遮罩，避免用户看到的是一块空白区域 -->
        <view class="poster-canvas-loading-mask" wx:if="{{isStorePosterDrawing || !storePosterTempFilePath}}">
          <view class="poster-canvas-spinner"></view>
          <!-- 🐛 长等待体感修复：二维码首次拉取失败进入重试时切换文案，
               避免用户在提高后的超时窗口内误以为页面卡死 -->
          <text class="poster-canvas-loading-text">{{storePosterQrRetrying ? '网络较慢，正在重试...' : '正在合成精美海报...'}}</text>
        </view>
      </view>

      <!-- 🐛 二维码重试兜底：多次拉取失败后海报仍正常生成（画面里是圆角占位卡），
           这里给一条可点击的提示条，让用户不用读懂占位卡里的小字，一键重新只拉
           二维码这一步。🎨 放在预览区外的独立一行（而不是叠在海报图上），避免
           跟海报底部"雨花斋餐报助手"标语在视觉上重叠遮挡 -->
      <view
        class="poster-qr-retry-banner"
        hover-class="ui-hover"
        wx:if="{{storePosterTempFilePath && storePosterQrFailed && !isStorePosterDrawing}}"
        catchtap="onRetryStoreQr"
      >
        ⚠️ 二维码生成失败，点击重新生成
      </view>

      <view class="poster-actions-bar">
        <button class="btn-share-single-line" hover-class="ui-hover" open-type="share" bindtap="onSharePosterToFriends">
          <view class="idx-icon-sm idx-icon-chat" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>分享给微信群和朋友
        </button>
      </view>
      <view class="poster-bottom-tip">可打印贴于财务桌或保存发至微信群</view>
    </view>
  </view>

  <view class="modal-backdrop" wx:if="{{showShiftSelectModal}}">
    <view class="modal-card shift-card">
      <view class="modal-header">
        <view class="header-titles">
          <view class="modal-title"><view class="idx-icon-sm idx-icon-flower" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>请选择今日护持岗位班次</view>
          <text class="today-hours-tip {{isOverHoursLimit ? 'over-limit' : ''}}">今日已记录工时：<text class="highlight {{isOverHoursLimit ? 'danger' : ''}}">{{previewTotalHours}}h</text> / 上限 12h</text>
          <text class="over-limit-warning" wx:if="{{isOverHoursLimit}}">⚠️ 工时超出每日上限</text>
        </view>
        <text class="close-btn" bindtap="onCloseShiftModal">✕</text>
      </view>

      <scroll-view scroll-y class="shift-scroll-area">
        <view class="shift-option-list">
          <block wx:for="{{availableShifts}}" wx:key="shiftKey">
            <view class="shift-item {{item.isCompleted ? 'disabled-completed' : (item.wouldExceedCap ? 'disabled-exceed' : (selectedShift === item.shiftKey ? 'active' : ''))}}"
                  bindtap="{{item.isCompleted ? '' : (item.wouldExceedCap ? 'onSelectShiftBlocked' : 'onSelectShift')}}"
                  data-shift="{{item.shiftKey}}"
                  data-hours="{{item.hours}}">
              <view class="shift-check-badge" wx:if="{{!item.isCompleted && selectedShift === item.shiftKey}}">✓</view>
              <view class="shift-left">
                <view class="shift-name-row">
                  <text class="shift-name">{{item.name}}</text>
                  <text class="completed-tag" wx:if="{{item.isCompleted}}">✔ 今日已打卡</text>
                  <text class="exceed-tag" wx:elif="{{item.wouldExceedCap}}">⚠️ 超出12h上限</text>
                </view>
                <text class="shift-time">{{item.timeDesc}}</text>
              </view>
              <text class="shift-hours">+{{item.hours}}h</text>
            </view>
          </block>
        </view>

        <view class="today-checked-section" wx:if="{{todayLogs.length > 0}}">
          <view class="section-title"><view class="idx-icon-sm idx-icon-pin" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>今日已打卡记录 (误选可撤销)：</view>
          <view class="today-log-chip" wx:for="{{todayLogs}}" wx:key="timestamp">
            <text class="log-info">{{item.shiftName}} (+{{item.hours}}h)</text>
            <text class="btn-revoke" bindtap="onRevokeTodayCheckIn" data-timestamp="{{item.timestamp}}" data-hours="{{item.hours}}" data-cloud-log-id="{{item.cloudLogId}}">撤销此班次</text>
          </view>
        </view>
        <view class="fa-safe-area-spacer"></view>
      </scroll-view>

      <view class="meal-reserve-row" bindtap="onToggleMealReserve">
        <checkbox checked="{{willEatLunch}}" color="#8C1D18"/>
        <text class="meal-tip">☑️ 今日留店用餐 (方便后厨预留餐量)</text>
      </view>

      <!-- 🍚 留店用餐细分餐别：勾选后展开早/午/晚 Chip 多选，精确到具体餐别方便后厨备餐 -->
      <view class="meal-type-chip-row" wx:if="{{willEatLunch}}">
        <view class="meal-type-chip {{reservedMeals.includes('breakfast') ? 'active' : ''}}" catchtap="onToggleReservedMeal" data-meal="breakfast">早餐</view>
        <view class="meal-type-chip {{reservedMeals.includes('lunch') ? 'active' : ''}}" catchtap="onToggleReservedMeal" data-meal="lunch">午餐</view>
        <view class="meal-type-chip {{reservedMeals.includes('dinner') ? 'active' : ''}}" catchtap="onToggleReservedMeal" data-meal="dinner">晚餐</view>
      </view>

      <button class="btn-confirm-checkin {{(allShiftsCompleted || isOverHoursLimit) ? 'btn-disabled' : ''}}"
              loading="{{checkInSubmitting}}"
              disabled="{{allShiftsCompleted || isOverHoursLimit || checkInSubmitting}}"
              bindtap="onConfirmShiftCheckIn">
        {{allShiftsCompleted ? '今日班次已全部完成' : (isOverHoursLimit ? '工时超出每日上限' : '确认打卡')}}
      </button>
    </view>
  </view>

  <!-- 生成餐报文本/海报本就是"填写当日明细"表单（见 form-main-card）的后续动作，
       两者的可见性必须完全一致，否则会出现"能看到表单却找不到提交按钮"的空页面——
       🐛 历史教训：这里曾经单独写成比表单条件更严格的角色判断，导致部分角色能看到表单却看不到按钮。
       现在表单已经对所有非志工角色（含纯财务）开放，这里只保留 !isVolunteer，与表单条件保持同步。 -->
  <!-- 🐛 修复图标"看不见"问题的真正根因：.idx-icon-bolt / .idx-icon-palette 是内联 base64 SVG
       background-image，stroke 颜色写死为 #FFFFFF，不会跟随按钮文字颜色变化——白底红字的左按钮上，
       白色图标直接和白色背景融为一体（看起来像"没有图标"）；金色底的右按钮上白色图标也和金黄背景
       低对比度重叠。SVG 图标系统这里没法简单换色，改用原生 emoji 字符作为图标（用户自身颜色不受
       按钮 color 影响，天然清晰可辨，也是需求里给出的示例做法），一步到位解决对比度问题。 -->
  <view class="bottom-action-floating-bar" wx:if="{{!isVolunteer}}">
    <button class="btn-main-action text-gen-btn {{isSubmitting ? 'btn-disabled' : ''}}" hover-class="ui-hover" bindtap="generateReport" loading="{{isSubmitting}}" disabled="{{isSubmitting}}">
      <text class="btn-emoji-icon">📋</text>生成餐报文本
    </button>
    <button class="btn-main-action poster-gen-btn" hover-class="ui-hover" bindtap="onGeneratePoster" loading="{{isGeneratingPoster}}" disabled="{{isGeneratingPoster || !showResult}}" style="background: linear-gradient(135deg, #C62828 0%, #B71C1C 100%) !important; color: #FFFFFF !important; opacity: 1 !important; border: none !important; font-weight: bold !important;">
      <text class="btn-emoji-icon">🎨</text>生成公示海报
    </button>
  </view>

  <!-- 任务A：我的雨花护持档案弹窗 -->
  <archive-modal
    visible="{{showArchiveModal}}"
    userInfo="{{archiveUserInfo}}"
    bind:close="onCloseArchiveModal"
    bind:viewJourney="onViewJourneyFromArchive"
  />

  <!-- 🛠️ 义工现场服务工具金刚区对应的两个填报弹窗：原地直弹，不再 switchTab 跳
       个人页。isAutoApproveRole 只影响弹窗内的提示文案，真正的免审批判定始终
       由服务端按登录者真实角色重新核定，见组件文件头部注释 -->
  <daily-menu-modal
    id="dailyMenuModal"
    visible="{{showDailyMenuModal}}"
    isAutoApproveRole="{{isManager}}"
    bind:close="onCloseDailyMenuModal"
  />
  <material-usage-modal
    id="materialUsageModal"
    visible="{{showMaterialUsageModal}}"
    isAutoApproveRole="{{isManager}}"
    bind:close="onCloseMaterialUsageModal"
  />


  <!-- 🌟 财务专属功能区：稽核与封账弹窗（自定义起止日期区间批量锁定/解封已通过店长确认的账本记录） -->
  <view class="finance-modal-mask" wx:if="{{showFinanceLockModal}}" bindtap="onCloseFinanceLockModal">
    <view class="finance-modal-card" catchtap="stopPropagation">
      <view class="finance-modal-header">
        <text class="finance-modal-title">🔒 稽核与封账</text>
        <view class="finance-modal-close" bindtap="onCloseFinanceLockModal">✕</view>
      </view>

      <text class="finance-modal-desc">选择要封账的起止日期区间，区间内所有已通过店长确认的记录将被批量锁定，锁定后店长无法再编辑或作废。</text>

      <view class="finance-range-picker-row">
        <picker mode="date" value="{{financeLockStartDate}}" bindchange="onFinanceLockStartDateChange">
          <view class="finance-month-picker">
            <text>{{financeLockStartDate || '开始日期'}}</text>
            <text class="arrow">▼</text>
          </view>
        </picker>
        <text class="finance-range-sep">至</text>
        <picker mode="date" value="{{financeLockEndDate}}" bindchange="onFinanceLockEndDateChange">
          <view class="finance-month-picker">
            <text>{{financeLockEndDate || '结束日期'}}</text>
            <text class="arrow">▼</text>
          </view>
        </picker>
      </view>

      <view class="lock-status-tip">{{ lockStatusText }}</view>

      <button
        wx:if="{{!financeLockRangeLocked}}"
        class="finance-modal-confirm-btn btn-danger"
        bindtap="onConfirmFinanceLock"
        disabled="{{financeLockInFlight}}"
      >
        {{financeLockInFlight ? '封账中...' : '确认封账'}}
      </button>
      <button
        wx:elif="{{isPatriarch || isSuperAdmin}}"
        class="finance-modal-confirm-btn btn-unlock"
        bindtap="handleUnlockMonth"
        disabled="{{financeUnlockInFlight}}"
      >
        {{financeUnlockInFlight ? '解封中...' : '解封 / 反封账'}}
      </button>
      <button
        wx:else
        class="finance-modal-confirm-btn btn-locked-disabled"
        disabled="true"
      >
        该区间已封账
      </button>
    </view>
  </view>

  <!-- 🌟 财务专属功能区：风控预警日志弹窗 -->
  <view class="finance-modal-mask" wx:if="{{showRiskAlertsModal}}" bindtap="onCloseRiskAlertsModal">
    <view class="finance-modal-card risk-modal-card" catchtap="stopPropagation">
      <view class="finance-modal-header risk-modal-header {{riskAlertsHasAnomaly ? 'is-danger' : 'is-safe'}}">
        <view class="risk-modal-title-row">
          <text class="risk-modal-icon">{{riskAlertsHasAnomaly ? '⚠️' : '🛡️'}}</text>
          <text class="finance-modal-title">风控预警日志</text>
        </view>
        <view class="finance-modal-close" bindtap="onCloseRiskAlertsModal">✕</view>
      </view>

      <text class="finance-modal-desc">红字冲销频次、小票缺失、余额异常突变——点击下方卡片可查看对应明细</text>

      <view class="risk-range-row" bindtap="onRefreshRiskAlerts">
        <text class="risk-range-label">{{riskAlertsRangeLabel || '统计区间加载中...'}}</text>
        <text class="risk-range-refresh {{riskAlertsLoading ? 'is-spinning' : ''}}">⟳ 刷新</text>
      </view>

      <view class="risk-summary-row" wx:if="{{!riskAlertsLoading}}">
        <view class="risk-summary-item {{riskAlertsSummary.voidCount > 0 ? 'is-danger' : 'is-safe'}} {{riskAlertsFilterType === 'void' ? 'is-active' : ''}}" data-type="void" bindtap="onRiskCardTap">
          <text class="risk-summary-num">{{riskAlertsSummary.voidCount}}</text>
          <text class="risk-summary-label">红字冲销</text>
        </view>
        <view class="risk-summary-item {{riskAlertsSummary.missingReceiptCount > 0 ? 'is-danger' : 'is-safe'}} {{riskAlertsFilterType === 'missing_receipt' ? 'is-active' : ''}}" data-type="missing_receipt" bindtap="onRiskCardTap">
          <text class="risk-summary-num">{{riskAlertsSummary.missingReceiptCount}}</text>
          <text class="risk-summary-label">小票缺失</text>
        </view>
        <view class="risk-summary-item {{riskAlertsSummary.balanceAnomalyCount > 0 ? 'is-danger' : 'is-safe'}} {{riskAlertsFilterType === 'balance' ? 'is-active' : ''}}" data-type="balance" bindtap="onRiskCardTap">
          <text class="risk-summary-num">{{riskAlertsSummary.balanceAnomalyCount}}</text>
          <text class="risk-summary-label">余额异常</text>
        </view>
      </view>

      <view class="risk-filter-tip" wx:if="{{riskAlertsFilterType}}">
        <text>已按该类型筛选，仅显示相关明细</text>
        <view class="risk-filter-actions">
          <text class="risk-filter-goto" wx:if="{{riskAlertsFilteredList.length > 0}}" bindtap="onGoToHistoryAnomalyDetail">查看账本明细 →</text>
          <text class="risk-filter-clear" data-type="{{riskAlertsFilterType}}" bindtap="onRiskCardTap">清除筛选 ✕</text>
        </view>
      </view>

      <view class="risk-loading" wx:if="{{riskAlertsLoading}}">
        <text>加载中...</text>
      </view>

      <scroll-view scroll-y class="risk-alert-list" wx:if="{{!riskAlertsLoading}}">
        <view class="risk-alert-item {{item.level}}" wx:for="{{riskAlertsFilteredList}}" wx:key="index">
          <text class="risk-alert-date">{{item.dateString}}</text>
          <text class="risk-alert-msg">{{item.message}}</text>
        </view>
        <view class="risk-alert-empty" wx:if="{{riskAlertsFilteredList.length === 0 && !riskAlertsFilterType}}">
          <text>✅ 近期账本未发现异常信号</text>
        </view>
        <view class="risk-alert-empty" wx:if="{{riskAlertsFilteredList.length === 0 && riskAlertsFilterType}}">
          <text>该类型暂无明细</text>
        </view>
        <view class="fa-safe-area-spacer"></view>
      </scroll-view>
    </view>
  </view>

  <!-- 📖 【雨花文化全集】弹窗：十大文化模块结构化分层展示完整原文，小标题加粗，
       提升可读性——module 7（雨花家训）保留原有的居中家训正文块，其余模块与之
       共用同一套 .motto-section-title/.motto-section-text/.motto-creed-line 视觉语言 -->
  <!-- 🚨 家训弹窗容器加行内保险下移 + 限高，避开右上角原生胶囊按钮；关闭按钮
       改为绝对定位悬浮在卡片右上角，不再和标题挤同一行——这三处内联样式只作用于
       本弹窗这一个元素实例，不影响 .modal-backdrop/.modal-card/.modal-header-bar/
       .modal-close-btn 这些其他弹窗共用的基础 class -->
  <view class="modal-backdrop" wx:if="{{showFamilyMottoModal}}" bindtap="onCloseFamilyMottoModal">
    <view class="modal-card family-motto-card" catchtap="stopPropagation" style="max-height: 78vh !important; margin-top: 60rpx !important; position: relative !important; display: flex !important; flex-direction: column !important; box-sizing: border-box !important;">
      <view class="motto-modal-close" bindtap="onCloseFamilyMottoModal" style="position: absolute !important; right: 24rpx !important; top: 24rpx !important; width: 60rpx !important; height: 60rpx !important; display: flex !important; align-items: center !important; justify-content: center !important; font-size: 36rpx !important; color: #999999 !important; z-index: 10 !important;">✕</view>
      <view class="modal-header-bar family-motto-header" style="justify-content: center !important; padding-right: 60rpx !important; flex-shrink: 0 !important;">
        <text class="modal-title-text">📖 雨花文化全集</text>
      </view>
      <scroll-view scroll-y class="family-motto-scroll" style="max-height: 62vh !important; flex: 1 !important;">

        <!-- 一、社会主义核心价值观：12 个词汇统一收进 4 列 x 3 行的胶囊网格，
             三个数组按国家/社会/个人层面依次排布，网格按文档流自动分行 -->
        <text class="motto-section-title">一、社会主义核心价值观</text>
        <view class="culture-value-grid">
          <text class="culture-value-chip" wx:for="{{cultureFullData.coreValuesNational}}" wx:key="*this">{{item}}</text>
          <text class="culture-value-chip" wx:for="{{cultureFullData.coreValuesSocial}}" wx:key="*this">{{item}}</text>
          <text class="culture-value-chip" wx:for="{{cultureFullData.coreValuesIndividual}}" wx:key="*this">{{item}}</text>
        </view>

        <!-- 二、立志格言：四句分行居中展示，而非拼成一整句 -->
        <text class="motto-section-title">二、立志格言</text>
        <text class="motto-section-text culture-quote-line" wx:for="{{cultureFullData.famousQuoteLines}}" wx:key="*this">{{item}}</text>

        <!-- 三、雨花家道 -->
        <text class="motto-section-title">三、雨花家道</text>
        <text class="culture-sub-title">—— 雨花核心精神 ——</text>
        <text class="motto-section-text culture-core-spirit-text">{{cultureFullData.homeCoreSpirit}}</text>
        <text class="culture-sub-title">—— {{cultureFullData.homeSanYouTitle}} ——</text>
        <!-- 🌸 三由/六同：短句对仗型内容，用 flex-wrap 居中网格包裹，
             避免手机窄屏下每句独占一行、右侧留出大片空白 -->
        <view class="culture-pair-grid">
          <text class="culture-list-line" wx:for="{{cultureFullData.homeSanYouItems}}" wx:key="*this">{{item}}</text>
        </view>
        <!-- 🌸 五了：5 句短语，撤销多列网格，改为单列逐行居中展示 -->
        <text class="culture-sub-title">—— {{cultureFullData.homeWuLeTitle}} ——</text>
        <view class="culture-list-single-column-center">
          <text class="culture-list-line" wx:for="{{cultureFullData.homeWuLeItems}}" wx:key="*this">{{item}}</text>
        </view>
        <text class="culture-sub-title">—— {{cultureFullData.homeLiuTongTitle}} ——</text>
        <view class="culture-pair-grid">
          <text class="culture-list-line" wx:for="{{cultureFullData.homeLiuTongItems}}" wx:key="*this">{{item}}</text>
        </view>
        <!-- 🌸 八欣：8 句短语，两列 CSS Grid 天然排成 2 列 x 4 行 -->
        <text class="culture-sub-title">—— {{cultureFullData.homeBaXinTitle}} ——</text>
        <view class="culture-two-col-grid">
          <text class="culture-two-col-cell" wx:for="{{cultureFullData.homeBaXinItems}}" wx:key="*this">{{item}}</text>
        </view>

        <!-- 四、雨花敬老核心理念：拆成两行短句，加大字号与行高 -->
        <text class="motto-section-title">四、雨花敬老核心理念</text>
        <text class="motto-section-text culture-elder-belief-text" wx:for="{{cultureFullData.seniorsCoreBeliefLines}}" wx:key="*this">{{item}}</text>

        <!-- 五、雨花敬老行为准则【十个有没有】：拆成"只有…/没有…"双列网格，
             左右两列各自居中对齐，替代此前逗号连写在一行的拥挤排版 -->
        <view class="motto-section-title">
          <text class="motto-title-line">五、雨花敬老行为准则——</text>
          <text class="motto-title-line">【十个有没有】</text>
        </view>
        <view class="culture-two-col-grid">
          <block wx:for="{{cultureFullData.seniorsTenHaveYouPairs}}" wx:key="left">
            <text class="culture-two-col-cell">{{item.left}}</text>
            <text class="culture-two-col-cell">{{item.right}}</text>
          </block>
        </view>

        <!-- 六、雨花家德【雨花人生十六最】：单列纵向列表，左对齐 + 缩进 + 加大行高段距 -->
        <view class="motto-section-title">
          <text class="motto-title-line">六、雨花家德——</text>
          <text class="motto-title-line">【雨花人生十六最】</text>
        </view>
        <view class="culture-list-single-column">
          <text class="culture-list-line" wx:for="{{cultureFullData.sixteenBests}}" wx:key="*this">{{item}}</text>
        </view>

        <!-- 七、雨花家训 -->
        <text class="motto-section-title">七、雨花家训</text>
        <!-- 雨花心字诀：四言韵律短句，按四句一换行拆成 3 行居中展示 -->
        <text class="culture-sub-title">—— 雨花心字诀 ——</text>
        <text class="motto-section-text" wx:for="{{familyMottoMindFormulaLines}}" wx:key="*this">{{item}}</text>

        <!-- 🌸 「雨花家训」小标题 + 家训正文十八句整体居中，独立成块，
             与上下两段（心字诀/为学之方）用 margin 隔开，避免和左对齐正文挤在一起 -->
        <view class="motto-creed-block" style="text-align: center !important; width: 100%;">
          <text class="culture-sub-title">—— 雨花家训 ——</text>
          <view class="motto-creed-line" wx:for="{{familyMottoCreedLines}}" wx:key="*this" style="text-align: center !important; width: 100%;">{{item}}</view>
        </view>

        <!-- 为学之方：单列逐行居中，开篇一句 / 中间六句分句 / 结语一句加粗 -->
        <text class="culture-sub-title">—— 为学之方 ——</text>
        <view class="culture-study-method-block">
          <text class="motto-section-text culture-study-line">{{familyMottoStudyIntro}}</text>
          <text class="motto-section-text culture-study-line" wx:for="{{familyMottoStudyMiddleLines}}" wx:key="*this">{{item}}</text>
          <text class="motto-section-text culture-study-line culture-study-conclusion">{{familyMottoStudyConclusion}}</text>
        </view>

        <!-- 八、雨花家仪【感恩词】：逐行单列居中展示 -->
        <view class="motto-section-title">
          <text class="motto-title-line">八、雨花家仪——</text>
          <text class="motto-title-line">【感恩词】</text>
        </view>
        <view class="culture-list-single-column-center">
          <text class="culture-list-line" wx:for="{{cultureFullData.gratitudeText}}" wx:key="*this">{{item}}</text>
        </view>

        <!-- 九、一日修身小结【感恩与祈盼】：前两段（感恩铺垫 + 祈盼引导）保持单列，
             后 3 句"祈盼…，让…！"排比句拆成 6 行单列居中展示，每两行一组，
             组间距靠 culture-aspiration-line-group-end 加大 -->
        <view class="motto-section-title">
          <text class="motto-title-line">九、一日修身小结——</text>
          <text class="motto-title-line">【感恩与祈盼】</text>
        </view>
        <text class="culture-list-line" wx:for="{{cultureFullData.dailySummaryGratitude}}" wx:key="*this">{{item}}</text>
        <text class="culture-list-line" wx:for="{{cultureFullData.dailySummaryAspiration}}" wx:key="*this">{{item}}</text>
        <view class="culture-list-single-column-center">
          <text class="culture-list-line culture-aspiration-line {{index % 2 === 1 ? 'culture-aspiration-line-group-end' : ''}}" wx:for="{{cultureFullData.dailySummaryAspirationLines}}" wx:for-index="index" wx:key="*this">{{item}}</text>
        </view>

        <!-- 十、雨花家风 -->
        <text class="motto-section-title">十、雨花家风</text>
        <text class="motto-section-text">{{cultureFullData.familyStyleText}}</text>
      </scroll-view>
    </view>
  </view>

  <side-drawer id="sideDrawer"
    store-name="{{currentStoreName || shopName}}"
    role-label="{{isSuperAdmin ? '超级管理员' : (isManager ? '店长' : (isFinance ? '财务' : '义工'))}}"
    is-manager="{{isManager}}"
    is-finance="{{isFinance}}"
    is-super-admin="{{isSuperAdmin}}"
    bind:action="onSideDrawerAction" />
</view>