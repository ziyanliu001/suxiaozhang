    <view class="notice-edit-content" catchtap="stopPropagation">
      <view class="notice-edit-header">
        <text class="notice-edit-title">编辑通报内容</text>
        <view class="notice-edit-close" bindtap="closeNoticeEdit">
          <text class="close-icon">×</text>
        </view>
      </view>

      <scroll-view scroll-y class="notice-edit-body">
        <view class="notice-edit-section">
          <view class="notice-edit-label"><view class="idx-icon-sm idx-icon-sparkle" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>常用场景一键套用（自动填入标题与正文）</view>
          <view class="preset-tags">
            <view class="preset-tag" bindtap="onApplyPreset" data-key="opening">
              <view class="idx-icon-sm idx-icon-sparkle" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>试营业喜讯
            </view>
            <view class="preset-tag warning" bindtap="onApplyPreset" data-key="weather_closure">
              <view class="idx-icon-sm idx-icon-warning" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>天气暂休
            </view>
            <view class="preset-tag" bindtap="onApplyPreset" data-key="renovation_closure">
              <view class="idx-icon-sm idx-icon-settings" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>整修暂休
            </view>
            <view class="preset-tag" bindtap="onApplyPreset" data-key="volunteer">
              <view class="idx-icon-sm idx-icon-heart" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>义工招募
            </view>
            <view class="preset-tag" bindtap="onApplyPreset" data-key="supplies">
              <view class="idx-icon-sm idx-icon-box" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>物资告急呼吁
            </view>
            <view class="preset-tag" bindtap="onApplyPreset" data-key="festival">
              <view class="idx-icon-sm idx-icon-flower" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>节日活动
            </view>
            <view class="preset-tag" bindtap="onApplyPreset" data-key="thanks">
              <view class="idx-icon-sm idx-icon-handshake" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>专项致谢
            </view>
          </view>
        </view>

        <!-- 🌟 公告模板库：与上面固定的 7 条内置文案不同，这里是云端拉取的
             全域公共模板 + 本店私有模板，用【公共】/【本店】标签区分来源 -->
        <view class="notice-edit-section" wx:if="{{noticeTemplates.length > 0}}">
          <view class="notice-edit-label"><view class="idx-icon-sm idx-icon-sparkle" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>我的模板库（点击套用）</view>
          <view class="preset-tags">
            <view class="preset-tag template-tag" wx:for="{{noticeTemplates}}" wx:key="_id" bindtap="onApplyCloudTemplate" data-id="{{item._id}}">
              <text class="template-badge {{item.isSystem ? 'badge-system' : 'badge-store'}}">{{item.isSystem ? '公共' : '本店'}}</text>
              <text>{{item.title}}</text>
            </view>
          </view>
        </view>

        <view class="notice-edit-section">
          <text class="notice-edit-label">通报标题</text>
          <input 
            class="notice-edit-input" 
            placeholder="请输入通报标题" 
            value="{{noticeEditTitle}}" 
            bindinput="onNoticeTitleInput" 
          />
        </view>

        <view class="notice-edit-section">
          <view class="field-title-left-row">
            <text class="field-title-text">通报正文</text>
            <view class="clear-btn-inline" bindtap="clearNoticeContent" wx:if="{{noticeEditContent}}">
              <view class="clear-btn-text"><view class="idx-icon-sm idx-icon-trash" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>清空正文</view>
            </view>
          </view>
          <view class="textarea-box-container">
            <textarea 
              class="notice-edit-textarea" 
              placeholder="请输入通报正文内容..." 
              value="{{noticeEditContent}}" 
              bindinput="onNoticeContentInput"
              auto-height
              maxlength="500"
            />
            <text class="char-count-tag">{{noticeEditContent.length || 0}}/500</text>
          </view>
        </view>

        <view class="merge-option-bar">
          <view class="merge-info">
            <view class="merge-title"><view class="idx-icon-sm idx-icon-link" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>合并到每日汇报文本</view>
            <text class="merge-desc">开启后，点击【生成文本】将自动在日报开头附带此通报</text>
          </view>
          <switch
            checked="{{mergeToReportText}}"
            bindchange="onToggleMergeToReport"
            color="#FF922B"
          />
        </view>

        <!-- 🌟 仅超级管理员可见：勾选后"存为模板"会把这条模板设为全域公共，
             本机构任意门店都能在自己的编辑弹窗里看到并套用；不勾选则只存为
             当前门店的私有模板。店长/财务看不到这个开关，存的永远是本店模板 -->
        <view class="merge-option-bar" wx:if="{{isSuperAdmin}}">
          <view class="merge-info">
            <view class="merge-title"><view class="idx-icon-sm idx-icon-sparkle" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>设为全域公共模板</view>
            <text class="merge-desc">开启后"存为模板"将对本机构所有门店可见和可用</text>
          </view>
          <switch
            checked="{{saveAsSystemTemplate}}"
            bindchange="onToggleSaveAsSystemTemplate"
            color="#FF922B"
          />
        </view>
        <view class="fa-safe-area-spacer"></view>
      </scroll-view>

      <view class="notice-edit-footer">
        <button class="notice-edit-btn cancel-btn" bindtap="closeNoticeEdit">取消</button>
        <button class="notice-edit-btn template-btn" bindtap="onSaveAsTemplate">存为模板</button>
        <button class="notice-edit-btn save-btn" bindtap="onSaveNotice">保存并应用</button>
      </view>
    </view>
  </view>

