            class="notice-edit-input" 
            placeholder="请输入通报标题" 
            value="{{noticeEditTitle}}" 
            bindinput="onNoticeTitleInput" 
          />
        </view>

        <view class="notice-edit-section">
          <view class="field-title-left-row">
            <text class="field-title-text">通报正文</text>
            <view class="clear-btn-inline" bindtap="clearNoticeContent" wx:if="{{noticeEditContent}}">
              <view class="clear-btn-text"><view class="idx-icon-sm idx-icon-trash" style="display:inline-block;vertical-align:middle;margin-right:4rpx;"></view>清空正文</view>
            </view>
          </view>
          <view class="textarea-box-container">
            <textarea 
              class="notice-edit-textarea" 
              placeholder="请输入通报正文内容..." 
              value="{{noticeEditContent}}" 
              bindinput="onNoticeContentInput"
              auto-height
              maxlength="500"
            />
            <text class="char-count-tag">{{noticeEditContent.length || 0}}/500</text>
          </view>
        </view>

        <view class="merge-option-bar">
          <view class="merge-info">
            <view class="merge-title"><view class="idx-icon-sm idx-icon-link" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>合并到每日汇报文本</view>
            <text class="merge-desc">开启后，点击【生成文本】将自动在日报开头附带此通报</text>
          </view>
          <switch 
            checked="{{mergeToReportText}}" 
            bindchange="onToggleMergeToReport" 
            color="#FF922B"
          />
        </view>
      </scroll-view>

      <view class="notice-edit-footer">
        <button class="notice-edit-btn cancel-btn" bindtap="closeNoticeEdit">取消</button>
        <button class="notice-edit-btn save-btn" bindtap="onSaveNotice">保存并应用</button>
      </view>
    </view>
