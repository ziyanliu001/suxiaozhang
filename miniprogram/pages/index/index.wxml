      <scroll-view scroll-y class="notice-edit-body">
        <view class="notice-edit-section">
          <view class="notice-edit-label"><view class="idx-icon-sm idx-icon-sparkle" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>常用场景一键套用（自动填入标题与正文）</view>
          <view class="preset-tags">
            <view class="preset-tag" bindtap="onApplyPreset" data-key="opening">
              <view class="idx-icon-sm idx-icon-sparkle" style="display:inline-block;vertical-align:middle;margin-right:6rpx;"></view>试营业喜讯
            </view>
            <view class="preset-tag warning" bindtap="onApplyPreset" data-key="weather_closure">
