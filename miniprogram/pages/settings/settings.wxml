<view class="settings-container">

  <view class="status-bar-spacer" style="height: {{statusBarHeight}}px;"></view>
  <view class="nav-title-bar" style="height: {{navBarHeight}}px;">
    <view class="nav-back-arrow" hover-class="nav-back-arrow-hover" bindtap="onBackTap">←</view>
    <text class="page-title-txt">设置</text>
    <view class="nav-right-placeholder"></view>
  </view>

  <view class="settings-content">
    <view class="settings-group-label">通用</view>
    <view class="settings-list">
      <view class="settings-item" bindtap="onTapComplianceReview">
        <text class="settings-item-text">查看合规声明</text>
        <text class="settings-item-arrow">›</text>
      </view>
      <view class="settings-item" bindtap="onTapAbout">
        <text class="settings-item-text">关于本小程序</text>
        <text class="settings-item-arrow">›</text>
      </view>
      <view class="settings-item" bindtap="onTapClearCache">
        <text class="settings-item-text">清除本地缓存</text>
        <text class="settings-item-arrow">›</text>
      </view>
    </view>

    <view class="settings-group-label" wx:if="{{hasPrivilege}}">身份</view>
    <view class="settings-list" wx:if="{{hasPrivilege}}">
      <view class="settings-item settings-item-danger" bindtap="onTapReleaseRole">
        <text class="settings-item-text danger-text">退出当前身份 / 切换身份</text>
        <text class="settings-item-arrow">›</text>
      </view>
    </view>
  </view>

</view>
