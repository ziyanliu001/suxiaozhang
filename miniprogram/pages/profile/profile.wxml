              <view class="notice-mgmt-action-btn edit-btn" bindtap="onNoticeManagementEdit" data-id="{{item._id}}">编辑</view>
              <view class="notice-mgmt-action-btn delete-btn" bindtap="onNoticeManagementDelete" data-id="{{item._id}}">删除</view>
