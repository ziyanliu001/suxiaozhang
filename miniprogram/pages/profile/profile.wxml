<wxs src="./profile-stats.wxs" module="statsFmt" />
<view class="mine-page-container">
  <!-- 🌟 微信用户隐私授权弹窗：本页会调用 chooseAvatar（头像选择）隐私接口，
       必须放置该组件才能正常弹出授权，否则点击头像会被平台静默拦截、毫无反应 -->
  <privacy-popup />

  <view class="status-bar-spacer" style="height: {{statusBarHeight}}px;"></view>
  <view class="nav-title-bar" style="height: {{navBarHeight}}px;">
    <text class="page-title-txt">个人中心</text>
    <!-- 🛡️ 动态避让官方胶囊菜单：right 由 capsuleLeft/windowWidth 换算得出，不再用
         固定 24rpx 贴右——position:absolute 元素的 right 值不受父级 padding-right
         影响，必须直接算在按钮自己身上，否则不同机型胶囊实际左边距不同时，
         这个按钮仍会被胶囊重叠/裁切 -->
    <view class="quick-sheet-trigger-btn" style="right: {{windowWidth - capsuleLeft + 10}}px;" bindtap="onOpenQuickSheet">
      <text class="quick-sheet-trigger-icon">⋯</text>
    </view>
  </view>

  <view class="mine-content-wrapper">

    <view class="user-profile-card">
      <!-- 🐛 头像"严重放大只看到局部色块"根因排查：交叉测试证实同一张照片走食谱照片的
           <view><image> 结构完全正常，问题 100% 限定在头像这里——而食谱照片和头像的
           唯一结构性差异，就是头像的 <image> 之前被嵌套在 <button open-type="chooseAvatar">
           内部。微信原生组件（camera/video/map，以及部分特殊 open-type 按钮）有据可查地
           存在"原生层级高于普通 WXML 渲染层，可能与自身子节点的展示层叠加/干扰"的问题。
           这里把头像的可见展示（.avatar-outer 及其内部）从按钮里完全搬出来，改成普通
           <view> 兄弟节点；chooseAvatar 按钮降级为一个铺满同等区域、纯透明的点击热区，
           只负责触发 bindchooseavatar 事件，不再包裹任何要展示的内容。 -->
      <view class="avatar-tap-wrap">
        <view class="avatar-outer">
          <view class="avatar-ring" style="overflow: hidden !important; border-radius: 50% !important; position: relative !important; flex-shrink: 0 !important;">
            <!-- 🛡️ 不要在这里加行内 width/height（哪怕是 100%）：.user-avatar 的
                 CSS 注释明确记录过 mode="aspectFill" 配合百分比宽高会导致裁剪区域计算
                 错乱、表现为"放大只看到中间/色块"，固定 120rpx 定值是已验证过的修复。
                 行内 !important 的优先级高于外部样式表 !important，加了就会覆盖掉那份
                 修复——只保留 display/object-fit 这类不影响宽高数值的行内加固。 -->
            <image wx:if="{{userAvatarUrl && !avatarLoadFailed}}" class="user-avatar avatar-img" src="{{userAvatarUrl}}" mode="aspectFill" binderror="onAvatarLoadError" style="display: block !important; object-fit: cover !important;" />
            <view wx:else class="user-avatar user-avatar-placeholder">👤</view>
          </view>
        </view>
        <button class="avatar-choose-btn-overlay" hover-class="none" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar"></button>
      </view>
      <view class="user-meta-info">
        <!-- 🐛 昵称与编辑图标重叠的真正根因：<input> 是微信小程序里的原生组件，它自己身上的
             text-overflow/overflow 样式并不总是可靠生效（此前只在 .user-nickname-input 自身
             加 max-width + ellipsis 试过一次，见旧注释，长昵称依然会视觉溢出压住右侧图标）。
             可靠的做法是把"裁切边界"下放给外层普通 <view>——普通元素的 overflow:hidden
             是稳定生效的，用它兜底给原生 input 做硬裁切，而不是指望 input 自己截断。 -->
        <view class="nickname-edit-row">
          <view class="nickname-input-wrap">
            <input
              class="user-nickname-input"
              type="nickname"
              placeholder="点击设置昵称"
              value="{{userNickName}}"
              bindblur="onNicknameBlur"
            />
          </view>
          <view class="edit-profile-icon-btn" bindtap="onTapEditProfileHint">
            <view class="item-icon-svg icon-svg-edit"></view>
          </view>
        </view>

        <!-- 🛡️ 身份胶囊解耦：只展示当前业务角色名称本身，不再拼接 currentStoreName——
             该字段在超管场景下可能是"全国总览"这类虚拟聚合名（见 statistics.ts
             VIRTUAL_STORE_NAMES 同款概念），把它和角色名拼在一起会显示成"全国总览 ·
             家长"这种把"数据权限范围"和"业务身份"硬缝合的双重语义文案，界面上第一眼
             看不出这到底是店名还是模式。门店归属信息本就在订阅信息卡片等处单独展示
             （见 subscription-info-value），胶囊本身只需要回答"我现在是什么角色" -->
        <!-- 🆕 身份 Banner：把角色胶囊 + 归属机构合并进同一张高质感条带，全角色
             （大家长/店长/财务/义工/家人）统一套用暖金渐变卡片底
             （.identity-banner-card）——此前仅 isPatriarch 才有这层卡片质感，
             其余角色是无背景条的裸文本展示，视觉不统一；现改为不分角色一律套用
             同一套双层卡片容器。
             注：大家长本身没有"视角切换"功能——那是仅 isRealSuperAdmin 才有的
             预览层能力（见下方 view-mode-switch-card），这里不为真实大家长
             伪造一个不存在的切换入口，只做视觉整合 -->
        <view class="identity-banner identity-banner-card">
          <view class="role-badge-row">
            <view class="badge-tag {{isFamily ? 'family' : currentUserRole}}">
              <view class="badge-icon-svg icon-svg-flower"></view>
              <text>{{currentUserRole === 'super_admin' ? '超级管理员' :
                currentUserRole === 'store_manager' ? '👑 店长' :
                currentUserRole === 'finance' ? '财务' :
                currentUserRole === 'store_patriarch' ? '🏛️ 大家长' :
                (isFamily || currentUserRole === 'store_family') ? '家人' :
                '义工'}}</text>
            </view>
          </view>

          <!-- 🆕 显式呈现归属机构/平台：与角色胶囊分离展示，避免"全国总览 · 家长"
               这类把数据权限范围和业务身份硬缝合的双重语义文案（见上方 role-badge-row
               旁的历史注释）。
               🐛 归属机构与当前门店分层修复：此前这里把 currentStoreName（门店名，
               如"嵩屿街道敬老中心助餐点"）直接当"归属机构"展示——机构是门店上层的
               账套，两者不是同一层级，混用会让"机构"这个概念名不副实。现拆成两行：
               超管/平台管理员顶部改展示统一的"超级管理员 · 全局总览"高亮标识，
               不展示具体机构名（避免与巡检门店/全局视角产生混淆）；其余角色展示
               真实机构名（currentTenantName，见 fetchCurrentTenantName），选定了
               具体门店时下面再单独一行"当前门店" -->
          <!-- 🐛 根因修复（标签堆叠去重）：上方 role-badge-row 在 currentUserRole
               ==='super_admin' 时已经展示过一次"超级管理员"，这里此前无条件再拼
               一遍"超级管理员 · 全局总览"，同一屏挤出两个写着"超级管理员"的标签，
               视觉啰嗦。只在 currentUserRole 不是 'super_admin' 时（真实超管正在
               预览其他角色视角，见下方 role-switch-modal，上方角色胶囊此时显示的
               是被预览的角色名而不是"超级管理员"）才需要保留完整前缀——这种场景下
               两个标签本就展示不同信息（预览角色 vs 真实身份+数据范围），不是重复 -->
          <view class="belong-store-tag super-admin-highlight" wx:if="{{isSuperAdmin}}">
            <text class="store-icon">🛡️</text>
            <text class="store-name">{{currentUserRole === 'super_admin' ? '全局总览' : '超级管理员 · 全局总览'}}</text>
          </view>
          <block wx:else>
            <view class="belong-store-tag">
              <text class="store-icon">🏢</text>
              <text class="store-label">归属机构：</text>
              <text class="store-name">{{currentTenantName || orgTypeFallbackLabel || '未绑定机构'}}</text>
              <text class="org-type-badge" wx:if="{{orgTypeBadge}}">{{orgTypeBadge}}</text>
            </view>
            <view class="belong-store-tag" wx:if="{{currentStoreName}}">
              <text class="store-icon">📍</text>
              <text class="store-label">当前门店：</text>
              <text class="store-name">{{currentStoreName}}</text>
            </view>
          </block>
        </view>

        <!-- 🌐 超管专属：当前巡检门店指示器，点击唤起【门店选择与搜索】弹窗。
             默认展示"📍 全国总览"，选中具体门店后切换为该门店名称 -->
        <view class="sa-store-indicator" wx:if="{{isSuperAdmin}}" hover-class="ui-hover" bindtap="onOpenStorePickerModal">
          <text class="sa-store-indicator-icon">📍</text>
          <text class="sa-store-indicator-text">{{currentInspectStoreId ? currentInspectStoreName : '全国总览'}}</text>
          <text class="sa-store-indicator-arrow">❯</text>
        </view>
      </view>
    </view>

    <!-- 🏛️（2026-09-09 超管个人中心 IA 重构）原"超管工具箱"折叠卡片（摘要条 +
         sa-command-card + admin-dashboard-card，此前深埋在第 9-11 段区块，要先
         看完义工/家人/店长/大家长/财务各自的功能区才会出现）整段移除，核心管理
         能力上提到紧跟头像信息卡片之后的这张「全域管控面板」2x2 金刚区——不再
         需要先划到页面底部、再点开一个折叠条，才能看到任何管理入口。原 8 项工具
         全部保留，只是换了位置：全国数据看板/撤销违规管理权限/重置门店申请密钥/
         管理视角切换/清理缓存/一键加速系统/DEV 体验开通专业版收进下方"更多系统
         工具"弹窗，安全操作日志升级为金刚区第 4 格的主入口，不再需要先展开
         工具箱才找得到 -->
    <view class="sa-global-control-card" wx:if="{{isSuperAdmin && !isVolunteer && !isFamily && !isManager && !isPatriarch && !isFinance}}">
      <view class="sa-command-header">
        <view class="sa-command-badge-row">
          <text class="sa-command-crown">👑</text>
          <view class="sa-command-title-col">
            <text class="sa-command-title">超级管理员</text>
            <text class="sa-command-sub">全域管控面板</text>
          </view>
        </view>
        <view class="sa-command-store-tag">
          <text class="sa-command-store-name">{{currentStoreName || '全国总览'}}</text>
        </view>
      </view>

      <!-- 风控与安全：顶部风险预警条复用 patriarchData（fetchPatriarchDashboardData
           已按当前选中门店加载，超管与家长共用同一份数据），不新增云函数调用；
           仅当有待确认的作废/画像变更时才显示 -->
      <view class="sa-risk-banner" wx:if="{{patriarchData.pendingVoidList.length > 0 || patriarchData.pendingProfileUpdate}}">
        <text class="sa-risk-banner-dot"></text>
        <text class="sa-risk-banner-text">{{currentStoreName || '当前门店'}} 有 {{patriarchData.pendingVoidList.length + (patriarchData.pendingProfileUpdate ? 1 : 0)}} 项待确认的高风险操作</text>
      </view>

      <view class="sa-control-grid">
        <!-- 🐛 根因修复（紧急，2026-09-09）：这 4 个格子此前全部用
             hover-class="ui-hover"——那是本页其余浅色卡片专用的按压态
             （background:#FAF8F5，近白/奶油色），套在这张深色渐变卡片
             （sa-global-control-card，#0f2744→#1e3a5f→#0c3060）上的格子里，
             点按时背景会瞬间变成一块近白色，与周围深色背景形成强烈反差，且
             文字颜色本身也是浅色（#e2e8f0），近白底 + 浅色字几乎不可辨读——
             表现正是用户反馈的"淡灰色、看起来像置灰"。真实点击事件本身一直
             是正常绑定、正常触发的，没有任何拦截逻辑或 disabled 态，问题
             完全在按压视觉反馈的配色上。改用专门适配深色卡片的
             sa-control-cell-hover（半透明白，不反差），4 个格子一并修正 -->
        <view class="sa-control-cell" bindtap="onGoToStoreManagementHub" hover-class="sa-control-cell-hover">
          <text class="sa-control-icon">🏬</text>
          <text class="sa-control-label">门店档案/管理</text>
          <!-- 🏛️（2026-09-09）currentInspectStoreId 是本页已有的"超管巡检门店选择"
               专用字段（见 fetchPendingApplications 头部注释），留空即代表当前处于
               "全国总览"——用它而不是新引入一个字段来判断是否追加跨店切换提示 -->
          <text class="sa-control-desc">{{!currentInspectStoreId ? '门店档案（支持跨店切换）' : '可穿透修改全国门店资料与地址'}}</text>
        </view>
        <!-- 🐛 根因修复（2026-09-09）：onOpenMemberApplicationModal 对应的"待审批
             申请"半屏弹窗此前只挂在 patriarch-panel-card（isPatriarch && !isSuperAdmin）
             /isManager 专属的同名卡片里——两处 wx:if 都显式排除了 isSuperAdmin，
             导致这个入口对真实超管账号完全不可达，尽管 fetchPendingApplications()
             自身早就写好了"超管未选巡检门店时走 elevated 全域队列，选中门店后穿透
             该店全角色队列"的完整逻辑（见该方法头部注释）——这里复用同一个 handler，
             是这个既有能力第一次对超管账号可达，不是重复入口 -->
        <view class="sa-control-cell" bindtap="onOpenMemberApplicationModal" hover-class="sa-control-cell-hover">
          <text class="sa-control-icon">📝</text>
          <text class="sa-control-label">权限与审核</text>
          <text class="sa-control-desc">全域角色审批 · 加入申请流转</text>
        </view>
        <view class="sa-control-cell" bindtap="onOpenProSubscriptionModal" hover-class="sa-control-cell-hover">
          <text class="sa-control-icon">🏢</text>
          <text class="sa-control-label">租户与SaaS</text>
          <text class="sa-control-desc">机构席位 · 工作空间套餐</text>
        </view>
        <view class="sa-control-cell" bindtap="onOpenSecurityLogModal" hover-class="sa-control-cell-hover">
          <text class="sa-control-icon">🛡️</text>
          <text class="sa-control-label">全网风控/日志</text>
          <text class="sa-control-desc">安全拦截 · 审计日志查看</text>
        </view>
      </view>

      <view class="sa-more-tools-link" bindtap="onOpenMoreToolsModal" hover-class="sa-control-cell-hover">
        <text>更多系统工具</text>
        <text class="sa-more-tools-arrow">❯</text>
      </view>
    </view>

    <!-- 🏛️（2026-09-09 超管个人中心 IA 重构）"更多系统工具"紧凑弹窗——原折叠卡片
         里除上面 4 个主入口之外的其余能力，原样搬运（handler 一个不改），只是
         从"展开才看得到的折叠大卡片"换成"点一下才弹出的紧凑列表" -->
    <view class="sa-more-tools-modal-mask" wx:if="{{showMoreToolsModal}}" catchtouchmove="stopPropagation" bindtap="onCloseMoreToolsModal">
      <view class="sa-more-tools-sheet" catchtap="stopPropagation">
        <view class="sa-more-tools-header">
          <text class="sa-more-tools-title">更多系统工具</text>
          <text class="sa-more-tools-close" bindtap="onCloseMoreToolsModal">✕</text>
        </view>

        <view class="sa-light-action-row" bindtap="onGoToStatistics" hover-class="ui-hover">
          <view class="sa-action-left">
            <text class="sa-action-icon">🚀</text>
            <text class="sa-light-action-title">全国数据看板</text>
          </view>
          <view class="sa-light-action-arrow">❯</view>
        </view>
        <view class="sa-light-action-row" bindtap="onOpenForceUnbindModal" hover-class="ui-hover">
          <view class="sa-action-left">
            <text class="sa-action-icon">🛡️</text>
            <text class="sa-light-action-title">撤销违规管理权限</text>
          </view>
          <view class="sa-light-action-arrow">❯</view>
        </view>
        <view class="sa-light-action-row" bindtap="onOpenResetStoreKeyModal" hover-class="ui-hover">
          <view class="sa-action-left">
            <text class="sa-action-icon">🔑</text>
            <text class="sa-light-action-title">重置门店申请密钥</text>
          </view>
          <view class="sa-light-action-arrow">❯</view>
        </view>
        <view class="sa-light-action-row" bindtap="onOpenViewModeModal" hover-class="ui-hover">
          <view class="sa-action-left">
            <text class="sa-action-icon">🎭</text>
            <view class="sa-action-text-col">
              <text class="sa-light-action-title">管理视角切换</text>
              <text class="sa-action-desc sa-light-desc">当前：{{viewModeOptionLabels[viewModeOptionIndex]}}</text>
            </view>
          </view>
          <view class="sa-light-action-arrow">❯</view>
        </view>
        <view class="sa-light-action-row" bindtap="onTriggerClearCache" hover-class="ui-hover">
          <view class="sa-action-left">
            <text class="sa-action-icon">🧹</text>
            <view class="sa-action-text-col">
              <text class="sa-light-action-title">清理缓存</text>
              <text class="sa-action-desc sa-light-desc" wx:if="{{cacheSizeText}}">当前已用 {{cacheSizeText}}</text>
            </view>
          </view>
          <view class="sa-light-action-arrow">❯</view>
        </view>
        <view class="sa-light-action-row {{createIndexesRunning ? 'sa-light-action-disabled' : ''}}"
              hover-class="{{createIndexesRunning ? '' : 'ui-hover'}}"
              bindtap="onTriggerCreateIndexes">
          <view class="sa-action-left">
            <text class="sa-action-icon">⚡</text>
            <text class="sa-light-action-title">{{createIndexesRunning ? '系统加速中，请稍候…' : '一键加速系统'}}</text>
          </view>
          <view class="sa-light-action-arrow">{{createIndexesRunning ? '⏳' : '❯'}}</view>
        </view>

        <!-- 🧪 Dev/Debug 专用：模拟开通专业版，仅供功能自测，不接入真实支付/计费流程。
             🛡️ 根因修复：见 profile.ts data.isDevEnvironment 声明处注释——此前只挂
             enterpriseBuildEnabled（区分完整版/开源核心版代码，跟"是否正式上线"
             无关），正式生产包里真实用户也能看到这个标 DEV 字样的入口，叠加
             isDevEnvironment（envVersion !== 'release'）后正式版直接隐藏 -->
        <view class="sa-dev-tool-row" wx:if="{{isDevEnvironment && enterpriseBuildEnabled && !subscriptionInfo.isActive}}" bindtap="onOpenProSubscriptionModal">
          <text class="sa-dev-tool-tag">DEV</text>
          <text class="sa-dev-tool-text">体验 / 模拟开通专业版（测试用）</text>
        </view>
      </view>
    </view>

    <!-- 🐛（去重）原"阳善纵向冒出轮播"（.sunshine-marquee-bar）已删除：与下方
         【善行功德专区】（.merit-hall-card）里的 <yangshan-wall> 组件展示的是
         同一份 getSunshineLedger 数据（同店、同近30天窗口），紧邻身份 Banner
         下方 + 页面中段各出现一条几乎一样的阳善滚动条，纯属重复。保留下方
         善行功德专区里的完整展示即可，这里不再渲染任何内容 -->

    <!-- 🐛 合并重构："超管巡检门店"（currentInspectStoreId）与"管理视角模拟"
         （isImpersonating）此前是两条独立的黄色提示条，判断口径又都依赖
         isSuperAdmin/isImpersonating 这类会随手动切换角色一起变化的展示态标志——
         一旦两者恰好同时激活（超管巡检某家门店的同时还在模拟店长/财务等视角），
