<wxs src="./profile-stats.wxs" module="stats" />
<view class="mine-page-container">
  <!-- 🌟 微信用户隐私授权弹窗：本页会调用 chooseAvatar（头像选择）隐私接口，
       必须放置该组件才能正常弹出授权，否则点击头像会被平台静默拦截、毫无反应 -->
  <privacy-popup />

  <view class="status-bar-spacer" style="height: {{statusBarHeight}}px;"></view>
  <view class="nav-title-bar" style="height: {{navBarHeight}}px;">
    <text class="page-title-txt">个人中心</text>
    <!-- 🛡️ 动态避让官方胶囊菜单：right 由 capsuleLeft/windowWidth 换算得出，不再用
         固定 24rpx 贴右——position:absolute 元素的 right 值不受父级 padding-right
         影响，必须直接算在按钮自己身上，否则不同机型胶囊实际左边距不同时，
         这个按钮仍会被胶囊重叠/裁切 -->
    <view class="quick-sheet-trigger-btn" style="right: {{windowWidth - capsuleLeft + 10}}px;" bindtap="onOpenQuickSheet">
      <text class="quick-sheet-trigger-icon">⋯</text>
    </view>
  </view>

  <view class="mine-content-wrapper">

    <view class="user-profile-card">
      <!-- 🐛 头像"严重放大只看到局部色块"根因排查：交叉测试证实同一张照片走食谱照片的
           <view><image> 结构完全正常，问题 100% 限定在头像这里——而食谱照片和头像的
           唯一结构性差异，就是头像的 <image> 之前被嵌套在 <button open-type="chooseAvatar">
           内部。微信原生组件（camera/video/map，以及部分特殊 open-type 按钮）有据可查地
           存在"原生层级高于普通 WXML 渲染层，可能与自身子节点的展示层叠加/干扰"的问题。
           这里把头像的可见展示（.avatar-outer 及其内部）从按钮里完全搬出来，改成普通
           <view> 兄弟节点；chooseAvatar 按钮降级为一个铺满同等区域、纯透明的点击热区，
           只负责触发 bindchooseavatar 事件，不再包裹任何要展示的内容。 -->
      <view class="avatar-tap-wrap">
        <view class="avatar-outer">
          <view class="avatar-ring" style="overflow: hidden !important; border-radius: 50% !important; position: relative !important; flex-shrink: 0 !important;">
            <!-- 🛡️ 不要在这里加行内 width/height（哪怕是 100%）：.user-avatar 的
                 CSS 注释明确记录过 mode="aspectFill" 配合百分比宽高会导致裁剪区域计算
                 错乱、表现为"放大只看到中间/色块"，固定 120rpx 定值是已验证过的修复。
                 行内 !important 的优先级高于外部样式表 !important，加了就会覆盖掉那份
                 修复——只保留 display/object-fit 这类不影响宽高数值的行内加固。 -->
            <image wx:if="{{userAvatarUrl && !avatarLoadFailed}}" class="user-avatar avatar-img" src="{{userAvatarUrl}}" mode="aspectFill" binderror="onAvatarLoadError" style="display: block !important; object-fit: cover !important;" />
            <view wx:else class="user-avatar user-avatar-placeholder">👤</view>
          </view>
        </view>
        <button class="avatar-choose-btn-overlay" hover-class="none" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar"></button>
      </view>
      <view class="user-meta-info">
        <!-- 🐛 昵称与编辑图标重叠的真正根因：<input> 是微信小程序里的原生组件，它自己身上的
             text-overflow/overflow 样式并不总是可靠生效（此前只在 .user-nickname-input 自身
             加 max-width + ellipsis 试过一次，见旧注释，长昵称依然会视觉溢出压住右侧图标）。
             可靠的做法是把"裁切边界"下放给外层普通 <view>——普通元素的 overflow:hidden
             是稳定生效的，用它兜底给原生 input 做硬裁切，而不是指望 input 自己截断。 -->
        <view class="nickname-edit-row">
          <view class="nickname-input-wrap">
            <input
              class="user-nickname-input"
              type="nickname"
              placeholder="点击设置昵称"
              value="{{userNickName}}"
              bindblur="onNicknameBlur"
            />
          </view>
          <view class="edit-profile-icon-btn" bindtap="onTapEditProfileHint">
            <view class="item-icon-svg icon-svg-edit"></view>
          </view>
        </view>

        <!-- 🛡️ 身份胶囊解耦：只展示当前业务角色名称本身，不再拼接 currentStoreName——
             该字段在超管场景下可能是"全国总览"这类虚拟聚合名（见 statistics.ts
             VIRTUAL_STORE_NAMES 同款概念），把它和角色名拼在一起会显示成"全国总览 ·
             家长"这种把"数据权限范围"和"业务身份"硬缝合的双重语义文案，界面上第一眼
             看不出这到底是店名还是模式。门店归属信息本就在订阅信息卡片等处单独展示
             （见 subscription-info-value），胶囊本身只需要回答"我现在是什么角色" -->
        <view class="role-badge-row">
          <view class="badge-tag {{isFamily ? 'family' : currentUserRole}}">
            <view class="badge-icon-svg icon-svg-flower"></view>
            <text>{{currentUserRole === 'super_admin' ? '超级管理员' :
              currentUserRole === 'store_manager' ? '店长' :
              currentUserRole === 'finance' ? '财务' :
              currentUserRole === 'store_patriarch' ? '大家长' :
              (isFamily || currentUserRole === 'store_family') ? '家人' :
              '义工'}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 🌟 家人骨干版护持榜：与流动义工共用同一套统计结构（护持天数/累计工时），
         只是标题文案换成"家人"专属用语，与义工版视觉区分开——不是隐藏，是选项 B
         （保留家人页面顶部的护持榜/核心荣誉模块，只调整专属称谓）。
         🔀 排在「日常护持」前面：个人信息卡片下方第一优先展示护持榜 -->
    <!-- 🐛 家人（服务对象）没有打卡/护持数据可展示——护持榜对他们没有意义，
         完全隐藏（原先只是换个标题文案展示 0 数据，现在直接不渲染） -->
    <view class="merit-board-card" wx:if="{{!isFamily}}">
      <view class="board-header">
        <view class="header-icon-svg icon-svg-flower"></view>
        <text class="header-title">爱心护持榜</text>
        <view class="header-icon-svg icon-svg-flower flip-x"></view>
      </view>

      <!-- 🌟 核心荣誉数据：护持天数 / 累计工时，暖金渐变底 + 微阴影提升仪式感，
           大号加粗突出，与次要统计做视觉分层 -->
      <view class="merit-hero-row">
        <view class="merit-hero-cell">
          <text class="merit-hero-num">{{stats.volunteerDays || 0}}</text>
          <text class="merit-hero-label">护持天数</text>
        </view>
        <view class="merit-hero-divider"></view>
        <view class="merit-hero-cell">
          <text class="merit-hero-num">{{stats.volunteerHours || 0}}</text>
          <text class="merit-hero-label">累计工时</text>
        </view>
      </view>

      <!-- 🎖️ 义工电子证书快捷入口：与 honor-wall-header 里的"义工证书"共用
           同一个 onGoToBadges，方便义工在护持榜顶部就能直接查看/分享荣誉证书 -->
      <view class="merit-cert-entry" bindtap="onGoToBadges">
        <text class="merit-cert-entry-text">🎖️ 义工电子证书</text>
        <view class="item-arrow">❯</view>
      </view>

      <view class="merit-sub-row" wx:if="{{hasPrivilege}}">
        <view class="merit-sub-cell" wx:if="{{isStoreAdmin}}">
          <text class="merit-sub-num">{{stats.submittedReports || 0}}</text>
          <text class="merit-sub-label">登记餐报</text>
        </view>
        <view class="merit-sub-cell" wx:if="{{isFinance || isPatriarch || isSuperAdmin}}">
          <text class="merit-sub-num">{{stats.auditedReports || 0}}</text>
          <text class="merit-sub-label">稽核账本</text>
        </view>
      </view>

      <!-- ❤️ 爱心护持榜：本月/年度/总贡献三档，前 20 名 + 前三名奖牌 + 当前登录用户
           自己的排名与距上一名差距，姓名统一脱敏展示 -->
      <view class="leaderboard-divider"></view>
      <view class="leaderboard-section">
        <view class="leaderboard-tab-row">
          <view class="leaderboard-tab {{leaderboardRange === 'month' ? 'active' : ''}}" bindtap="onSwitchLeaderboardRange" data-range="month">本月榜</view>
          <view class="leaderboard-tab {{leaderboardRange === 'year' ? 'active' : ''}}" bindtap="onSwitchLeaderboardRange" data-range="year">年度榜</view>
          <view class="leaderboard-tab {{leaderboardRange === 'total' ? 'active' : ''}}" bindtap="onSwitchLeaderboardRange" data-range="total">总贡献榜</view>
        </view>

        <view class="leaderboard-loading" wx:if="{{leaderboardLoading}}">加载中…</view>
        <block wx:elif="{{leaderboardList.length > 0}}">
          <view class="leaderboard-row {{item.isSelf ? 'is-self' : ''}}" wx:for="{{leaderboardList}}" wx:key="rank">
            <view class="leaderboard-rank {{item.rank <= 3 ? 'top3' : ''}}">
              <text wx:if="{{item.rank === 1}}">🥇</text>
              <text wx:elif="{{item.rank === 2}}">🥈</text>
              <text wx:elif="{{item.rank === 3}}">🥉</text>
              <text wx:else>{{item.rank}}</text>
            </view>
            <text class="leaderboard-name">{{item.displayName}}</text>
            <text class="leaderboard-hours">{{item.hours}}h</text>
          </view>
        </block>
        <view class="leaderboard-empty" wx:else>暂无护持记录，快去打卡吧～</view>

        <view class="leaderboard-self-footer" wx:if="{{leaderboardSelfRank > 0}}">
          <text>当前排名：第 {{leaderboardSelfRank}} 名</text>
          <text wx:if="{{leaderboardGapToNext > 0}}"> · 距上一名还差 {{leaderboardGapToNext}} 工时</text>
          <text wx:else> · 🎉 您已是本榜第一名</text>
        </view>
        <view class="leaderboard-self-footer unranked" wx:elif="{{!leaderboardLoading}}">
          <text>您暂未上榜，打卡即可参与排名</text>
        </view>
      </view>
    </view>

    <!-- ❤️ 家人（服务对象）版面：新用户/未审核用户的默认身份视角。原"极简关怀"版面
         精简版：护持榜/核心荣誉模块对家人完全隐藏（见上方 merit-board-card/
         honor-wall-card 的 wx:if="{{!isFamily}}"），这张卡片专注日常护持向导 -->
    <view class="family-care-card" wx:if="{{isFamily}}">
      <view class="board-header">
        <view class="header-icon-svg icon-svg-flower"></view>
        <text class="header-title">雨花家园</text>
        <view class="header-icon-svg icon-svg-flower flip-x"></view>
      </view>

      <text class="family-care-hint">公开透明 · 广结善缘 · 全民监督</text>

      <!-- 💖 我的爱心：阳光账本直达（护持不记名，汇入公开账本）+ 温情感谢卡/荣誉证书 -->
      <text class="list-group-label family-care-list-label">💖 我的爱心</text>
      <view class="ui-card-wrapper action-list-container family-care-list">
        <view class="action-item-cell" hover-class="ui-hover" bindtap="onGoToSunshineLedger">
          <view class="item-left">
            <text class="manager-only-emoji">📖</text>
            <text class="item-text">阳光账本直达</text>
          </view>
          <view class="item-arrow">❯</view>
        </view>

        <view class="action-item-cell" hover-class="ui-hover" bindtap="onOpenCertificateModal">
          <view class="item-left">
            <text class="manager-only-emoji">💌</text>
            <text class="item-text">爱心感谢卡 / 荣誉证书</text>
          </view>
          <view class="item-arrow">❯</view>
        </view>
      </view>

      <!-- 🏡 雨花家园：门店整体视角——档案 + 日志 + 关注门店 + 温情故事 + 建议反馈 -->
      <text class="list-group-label family-care-list-label">🏡 雨花家园</text>
      <view class="ui-card-wrapper action-list-container family-care-list">
        <view class="action-item-cell" hover-class="ui-hover" bindtap="onGoToStoreProfile">
          <view class="item-left">
            <text class="manager-only-emoji">🏠</text>
            <text class="item-text">门店档案</text>
          </view>
          <view class="item-arrow">❯</view>
        </view>

        <!-- 门店日志（原"门店服务历程"）：家人没有个人打卡记录，onGoToActivityLog
             直接跳门店整体大事记列表（而不是个人 0 数据的 journey 页） -->
        <view class="action-item-cell" hover-class="ui-hover" bindtap="onGoToActivityLog">
          <view class="item-left">
            <view class="item-icon-svg icon-svg-flower"></view>
            <text class="item-text">门店日志</text>
          </view>
          <view class="item-arrow">❯</view>
        </view>

        <view class="action-item-cell" hover-class="ui-hover" bindtap="onGoToStorePicker">
          <view class="item-left">
            <text class="manager-only-emoji">🤝</text>
            <text class="item-text">我关注的雨花门店</text>
          </view>
          <view class="item-arrow">❯</view>
        </view>

        <view class="action-item-cell" hover-class="ui-hover" bindtap="onOpenWarmStory">
          <view class="item-left">
            <text class="manager-only-emoji">🌸</text>
            <text class="item-text">雨花温情故事</text>
          </view>
          <view class="item-arrow">❯</view>
        </view>

        <!-- 爱心建议箱：改为小程序原生半屏弹窗（见底部 feedback-sheet-*），
             不再用微信官方 open-type="feedback" 原生反馈页——那个入口去到的是
             微信平台通用反馈通道，不落在本项目自己的数据里，店长/运营看不到 -->
        <view class="action-item-cell" hover-class="ui-hover" bindtap="onOpenFeedbackModal">
          <view class="item-left">
            <text class="manager-only-emoji">📮</text>
            <text class="item-text">爱心建议箱</text>
          </view>
          <view class="pd-feedback-entry-right">
            <view class="badge" wx:if="{{unreadReplyCount > 0}}">{{unreadReplyCount}}</view>
            <view class="item-arrow">❯</view>
          </view>
        </view>
      </view>

      <!-- 📚 文化与帮助：家训文化 + 使用帮助。
           🐛 原本这里还有一个"切换关注门店"，与上方"雨花家园"分组新增的
           "我关注的雨花门店"（onGoToStorePicker）是完全同一个动作，两个入口
           重复——按要求物理删除这里的重复项，只保留雨花家园分组那一个 -->
      <text class="list-group-label family-care-list-label">📚 文化与帮助</text>
      <view class="ui-card-wrapper action-list-container family-care-list">
        <view class="action-item-cell" hover-class="ui-hover" bindtap="onGoToCultureFull">
          <view class="item-left">
            <text class="manager-only-emoji">📖</text>
            <text class="item-text">雨花家训与文化全集</text>
          </view>
          <view class="item-arrow">❯</view>
        </view>

        <navigator class="action-item-cell" hover-class="ui-hover" url="/pages/help/help">
          <view class="item-left">
            <text class="manager-only-emoji">❓</text>
            <text class="item-text">使用帮助</text>
          </view>
          <view class="item-arrow">❯</view>
        </navigator>
      </view>
    </view>

    <!-- 🌟 超级管理员专属：视角切换预览，纯前端展示层模拟，不改变云端真实角色。
         🐛 原生 picker 会弹出微信绿色系统选择器，与本页暖白/金色调不搭——改为
         点击触发下方自定义半屏 role-switch-modal，风格与 switch-identity-modal/
         subscription-modal 统一 -->
    <view class="view-mode-switch-card" wx:if="{{isRealSuperAdmin}}">
      <view class="view-mode-switch-row" bindtap="onOpenViewModeModal">
        <view class="item-left">
          <view class="item-icon-svg icon-svg-key"></view>
          <text class="item-text">管理视角切换</text>
        </view>
        <view class="view-mode-current-value">
          <text class="view-mode-current-label">{{viewModeOptionLabels[viewModeOptionIndex]}}</text>
          <view class="item-arrow">❯</view>
        </view>
      </view>
      <text class="view-mode-hint" wx:if="{{currentViewMode !== 'SUPER_ADMIN'}}">当前为预览模式，仅展示样式变化，实际操作仍以超级管理员权限执行</text>
    </view>

    <!-- 🏛️ 大家长管理面板：仅大家长本人或超级管理员可见——家长锁定本店，
         超管跟随全局门店切换器（fetchPatriarchDashboardData 与原 patriarch-dashboard
         页面同一套口径）。store_manager（店长）有独立的"门店日常管理"卡片，不再混入这里。 -->
    <view class="patriarch-panel-card" wx:if="{{isPatriarch || isSuperAdmin}}">
      <view class="patriarch-panel-header">
        <text class="patriarch-panel-title">🏛️ 家长管理</text>
      </view>

      <!-- 极简门店健康大盘：本月服务人次 + 收支总览 + 验真状态 -->
      <view class="pd-health-card">
        <view class="pd-health-title">📊 {{patriarchData.monthLabel}}门店健康大盘</view>
        <view class="pd-health-grid">
          <view class="pd-health-cell">
            <text class="pd-health-lbl">本月服务人次</text>
            <text class="pd-health-val">{{patriarchData.monthDiners}} 人次</text>
          </view>
          <view class="pd-health-cell">
            <text class="pd-health-lbl">本月收入</text>
            <text class="pd-health-val green">¥{{patriarchData.monthIncome}}</text>
          </view>
          <view class="pd-health-cell">
            <text class="pd-health-lbl">本月支出</text>
            <text class="pd-health-val red">¥{{patriarchData.monthExpense}}</text>
          </view>
          <view class="pd-health-cell">
            <text class="pd-health-lbl">本月净额</text>
            <text class="pd-health-val {{patriarchData.monthNetPositive ? 'green' : 'red'}}">{{patriarchData.monthNetPositive ? '+' : '-'}}¥{{patriarchData.monthNet}}</text>
          </view>
        </view>
        <view class="pd-verify-row">
          <text class="pd-verify-icon">🛡️</text>
          <text class="pd-verify-text">防伪验真：已验真 {{patriarchData.auditedCount}} / 共 {{patriarchData.totalCount}} 条</text>
        </view>
      </view>

      <!-- 待确认队列：作废申请 -->
      <view class="pd-section-title" wx:if="{{patriarchData.pendingVoidList.length > 0}}">
        <text class="pd-section-icon">⏳</text>
        <text class="pd-section-txt">待确认的作废申请（{{patriarchData.pendingVoidList.length}}）</text>
      </view>
      <view class="pd-void-card" wx:for="{{patriarchData.pendingVoidList}}" wx:key="docId">
        <view class="pd-void-info">
          <text class="pd-void-date">{{item.dateString}}</text>
          <text class="pd-void-amount">今日结余 ¥{{item.todayBalance}} · 支出 ¥{{item.expenseAmount}}</text>
        </view>
        <view class="pd-void-actions">
          <button class="pd-btn-reject" data-id="{{item.docId}}" data-action="reject" bindtap="onDecideVoid" disabled="{{patriarchData.voidActionInFlight}}">驳回</button>
          <button class="pd-btn-approve" data-id="{{item.docId}}" data-action="approve" bindtap="onDecideVoid" disabled="{{patriarchData.voidActionInFlight}}">确认作废</button>
        </view>
      </view>

      <!-- 待确认队列：门店画像变更 -->
      <view class="pd-section-title" wx:if="{{patriarchData.pendingProfileUpdate}}">
        <text class="pd-section-icon">⏳</text>
        <text class="pd-section-txt">待确认的门店画像变更</text>
      </view>
      <view class="pd-profile-card" wx:if="{{patriarchData.pendingProfileUpdate}}">
        <view class="pd-profile-items">
          <text class="pd-profile-item" wx:for="{{patriarchData.pendingProfileItems}}" wx:for-item="pf" wx:key="label">{{pf.label}}：{{pf.value}}</text>
        </view>
        <view class="pd-void-actions">
          <button class="pd-btn-reject" data-action="reject" bindtap="onDecideProfileUpdate" disabled="{{patriarchData.profileActionInFlight}}">驳回</button>
          <button class="pd-btn-approve" data-action="approve" bindtap="onDecideProfileUpdate" disabled="{{patriarchData.profileActionInFlight}}">确认变更</button>
        </view>
      </view>

      <view class="pd-empty-tip" wx:if="{{patriarchData.pendingVoidList.length === 0 && !patriarchData.pendingProfileUpdate && !patriarchData.loading}}">
        <text>✅ 当前没有待确认的高风险操作</text>
      </view>
      <view class="pd-loading-box" wx:if="{{patriarchData.loading}}">
        <text>加载中...</text>
      </view>

      <!-- ─── 门店管理中心 ─────────────────────────────── -->
      <view class="pd-mgmt-center-header">
        <text class="pd-mgmt-center-title">🏢 门店管理中心</text>
        <!-- ✏️ 快捷修改门店名称：仅大家长/超管可见，catchtap 防止冒泡触发外层事件 -->
        <view class="pd-store-name-edit-row" wx:if="{{isPatriarch || isSuperAdmin}}" catchtap="onQuickEditStoreName">
