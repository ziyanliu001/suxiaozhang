      <text class="vt-form-label" style="margin-top:24rpx;">新密钥</text>
      <input class="admin-key-modal-input"
             type="text"
             password
             value="{{resetStoreKeyInput}}"
             bindinput="onResetStoreKeyInput"
             placeholder="请输入新密钥（留空则不设密码）"
             maxlength="50" />

