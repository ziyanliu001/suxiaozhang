          <input class="reset-key-search-input"
                 value="{{resetStoreKeySearchText}}"
                 bindinput="onResetStoreKeySearch"
                 placeholder="搜索门店名称…"
                 focus="{{true}}"
                 maxlength="50" />
          <view class="reset-key-search-cancel" bindtap="onToggleResetKeyStoreList">取消</view>
        </view>
        <scroll-view scroll-y class="reset-key-store-scroll">
          <block wx:for="{{resetStoreKeyFilteredList}}" wx:key="storeId">
            <view class="reset-key-store-item {{item.storeId === resetStoreKeyStoreId ? 'active' : ''}}"
                  bindtap="onSelectResetKeyStore"
                  data-store-id="{{item.storeId}}"
                  data-store-name="{{item.storeName}}">
              <view class="reset-key-item-main">
                <text class="reset-key-item-name">{{item.storeName}}</text>
              </view>
              <text wx:if="{{item.storeId === resetStoreKeyStoreId}}" class="reset-key-item-check">✓</text>
            </view>
          </block>
          <view wx:if="{{resetStoreKeyFilteredList.length === 0}}" class="reset-key-no-result">
            <text>未找到匹配门店</text>
          </view>
        </scroll-view>
      </view>

      <!-- ③ 新密钥输入 ─────────────────────────────── -->
      <text class="vt-form-label" style="margin-top:24rpx;">新密钥</text>
      <input class="admin-key-modal-input"
             type="text"
             password
             value="{{resetStoreKeyInput}}"
             bindinput="onResetStoreKeyInput"
             placeholder="请输入新密钥（留空则不设密码）"
             maxlength="50" />

      <!-- ④ 软提示：留空 = 清空密钥；有内容 = 设置新密钥 -->
      <text class="reset-key-soft-note" wx:if="{{resetStoreKeyStoreId}}">
        {{resetStoreKeyIsClearMode ? '⚠️ 留空将清空密钥，义工申请管理身份时无需验证密码。' : '✅ 设置后，义工申请管理身份时需输入此密钥才能通过。'}}
      </text>

      <!-- ⑤ 提交按钮 -->
      <button class="feedback-submit-btn {{resetStoreKeyIsClearMode ? 'reset-key-btn-clear' : 'reset-key-btn-set'}} {{(resetStoreKeySaving || !resetStoreKeyStoreId || resetStoreKeyShowList) ? 'feedback-submit-btn-disabled' : ''}}"
              bindtap="onConfirmResetStoreKey"
              loading="{{resetStoreKeySaving}}"
              disabled="{{resetStoreKeySaving || !resetStoreKeyStoreId || resetStoreKeyShowList}}">
        {{resetStoreKeyIsClearMode ? '清空现有密钥' : '设置新密钥'}}
      </button>
    </view>
  </view>

