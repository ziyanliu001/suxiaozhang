          <text class="pd-store-edit-btn">✏️ 修改</text>
        </view>
      </view>

      <!-- 成员管理 -->
      <view class="action-item-cell pd-feedback-entry-cell" hover-class="ui-hover" bindtap="onOpenMemberManageModal">
        <view class="item-left">
