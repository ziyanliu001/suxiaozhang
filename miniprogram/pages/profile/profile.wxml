    <view class="certificate-modal-card sa-tool-modal-card admin-key-modal-card" catchtap="stopPropagation">

      <!-- ① 标题行 -->
      <view class="certificate-modal-header admin-key-modal-header">
        <text class="admin-key-modal-title">🔑 重置门店管理员密钥</text>
        <view class="certificate-modal-close" bindtap="onCloseResetStoreKeyModal">✕</view>
      </view>

      <!-- ② 目标门店选择区 ─────────────────────────── -->
      <text class="vt-form-label">目标门店</text>

      <!-- 已选中：展示门店名称卡片 -->
      <view wx:if="{{resetStoreKeyStoreId && !resetStoreKeyShowList}}" class="reset-key-selected-card">
        <view class="reset-key-selected-info">
          <text class="reset-key-selected-name">{{resetStoreKeyStoreName || resetStoreKeyStoreId}}</text>
