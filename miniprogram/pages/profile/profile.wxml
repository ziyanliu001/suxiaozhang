         管理弹窗才能看到。今日用餐人次/今日义工打卡/结余概览见
         fetchManagerTodaySnapshot；待审批事项直接对三路已在 initMinePage 里
         proactively 拉取好的角标计数求和展示，不发起额外请求。🆕 追加
         showAdminWorkbench 折叠开关，见上方 admin-workbench-summary 摘要卡 -->
    <view class="mgr-snapshot-card" wx:if="{{isManager && !isSuperAdmin && !isVolunteer && !isFamily && !isFinance && !isPatriarch && showAdminWorkbench}}">
      <view class="mgr-snapshot-header">
        <text class="mgr-snapshot-title">📊 本店数据概览</text>
      </view>
      <view class="mgr-snapshot-grid">
        <view class="mgr-snapshot-cell">
          <text class="mgr-snapshot-val">{{todayMealsCount}}</text>
          <text class="mgr-snapshot-lbl">今日用餐人次</text>
        </view>
        <view class="mgr-snapshot-cell">
          <text class="mgr-snapshot-val">{{todayVolunteersCount}}</text>
          <text class="mgr-snapshot-lbl">今日义工打卡</text>
        </view>
        <view class="mgr-snapshot-cell">
          <text class="mgr-snapshot-val {{(pendingMemberApplicationCount + pendingVolunteerSubmissionCount + pendingFeedbackCount) > 0 ? 'highlight' : ''}}">{{pendingMemberApplicationCount + pendingVolunteerSubmissionCount + pendingFeedbackCount}}</text>
          <text class="mgr-snapshot-lbl">待审批事项</text>
        </view>
        <view class="mgr-snapshot-cell">
          <text class="mgr-snapshot-val">¥{{storeNetBalance}}</text>
          <text class="mgr-snapshot-lbl">爱心积攒 / 结余</text>
        </view>
      </view>
    </view>

    <!-- 🏪 【店长专属】⚙️ 门店管理中心：与上方大家长专属的宫格化卡片同名，
         但沿用旧版列表式布局——大家长已改用新版宫格卡片（isManager 已从
         wx:if 中移除），这里严格只服务 isManager，二者互不重叠。🆕 追加
         showAdminWorkbench 折叠开关，见上方 admin-workbench-summary 摘要卡 -->
    <view class="patriarch-panel-card" wx:if="{{isManager && !isSuperAdmin && !isVolunteer && !isFamily && !isFinance && !isPatriarch && showAdminWorkbench}}">
      <!-- 🐛 层级瘦身：此前标题行"⚙️ 门店管理中心"与紧接着第二行的"🏢 门店管理
           中心 [门店名] ✏️修改"重复堆叠了两遍"门店管理中心"文案——合并为一行，
           门店名改用轻量 Pill 标签收纳在大标题右侧，点击直接唤起【组织信息配置】
           （onEditStoreInfo），不再单独起一整行 -->
      <view class="patriarch-panel-header">
        <text class="patriarch-panel-title">⚙️ 门店管理中心</text>
        <view class="pd-store-name-pill" catchtap="onEditStoreInfo">
          <text class="pd-store-name-pill-text">{{currentStoreName || '未命名门店'}}</text>
          <text class="pd-store-name-pill-edit">✏️</text>
        </view>
      </view>

      <!-- 🗂️ 分组一：核心日常审批——2x2 宫格，与大家长专属的门店管理中心
           （见上方 isPatriarch 卡片）同一套 .pd-mgmt-grid 视觉语言，两个角色的
           管理中心不再一个是宫格一个是纯列表。四项都是高频日常运维操作，
           带待办数量 Badge 提醒 -->
      <text class="pd-mgmt-section-title">核心日常审批</text>
      <view class="pd-mgmt-grid">
        <view class="pd-mgmt-grid-cell" hover-class="ui-hover" bindtap="onOpenMemberManageModal">
          <text class="pd-mgmt-grid-icon">⚙️</text>
          <text class="pd-mgmt-grid-label">成员权限管理</text>
        </view>

        <view class="pd-mgmt-grid-cell" hover-class="ui-hover" bindtap="onOpenMemberApplicationModal">
          <view class="pd-mgmt-grid-badge" wx:if="{{pendingMemberApplicationCount > 0}}">{{pendingMemberApplicationCount}}</view>
          <text class="pd-mgmt-grid-icon">🙋</text>
          <text class="pd-mgmt-grid-label">待审批申请</text>
        </view>

        <view class="pd-mgmt-grid-cell" hover-class="ui-hover" bindtap="onOpenVolunteerSubmissionAdminModal">
          <view class="pd-mgmt-grid-badge" wx:if="{{pendingVolunteerSubmissionCount > 0}}">{{pendingVolunteerSubmissionCount}}</view>
          <text class="pd-mgmt-grid-icon">📝</text>
          <text class="pd-mgmt-grid-label">待审核餐报</text>
        </view>

        <!-- 🆕 门店账目与凭证管理：原【本店数据看板】（合并自【门店餐饮与物资统计】+
             【本店数据明细】），门店维度的账目/凭证管理是门店管理职责，不该混在
             个人提交流水清单里，与 isFinance「财务稽核专区」的同款入口保持
             命名/跳转目标一致 -->
        <view class="pd-mgmt-grid-cell" hover-class="ui-hover" bindtap="onGoToStoreOverview">
          <text class="pd-mgmt-grid-icon">📊</text>
          <text class="pd-mgmt-grid-label">账目与凭证</text>
        </view>
      </view>

      <view class="pd-mgmt-divider"></view>

      <!-- 🗂️ 分组二：门店运营公告——对外公示/沟通类，与上面"审批处理"类操作
           物理分组，避免高频待办事项和低频公告项混排在一起 -->
      <text class="pd-mgmt-section-title">门店运营公告</text>

      <!-- 📢 门店公告/通知管理：此前只有店长的门店管理中心有这个入口，大家长自己的
           面板一直没有，这里补齐 -->
      <view class="action-item-cell pd-feedback-entry-cell" hover-class="ui-hover" bindtap="onOpenNoticeManagement">
        <view class="item-left">
          <text class="manager-only-emoji">📢</text>
          <text class="item-text">门店公告/通知管理</text>
        </view>
        <view class="pd-feedback-entry-right">
          <view class="item-arrow">❯</view>
        </view>
      </view>

      <!-- 📮 爱心意见箱管理：不在最初的精简清单里，但这是目前全站唯一剩下的入口——
           删掉会导致这项功能对所有角色（含超管）都不可用，保留 -->
      <view class="action-item-cell pd-feedback-entry-cell" hover-class="ui-hover" bindtap="onOpenFeedbackAdminModal">
        <view class="item-left">
          <text class="manager-only-emoji">📮</text>
          <text class="item-text">爱心意见箱管理</text>
        </view>
        <view class="pd-feedback-entry-right">
          <view class="badge" wx:if="{{pendingFeedbackCount > 0}}">{{pendingFeedbackCount}}</view>
          <view class="item-arrow">❯</view>
        </view>
      </view>

      <!-- 🔑 门店安全密钥设置：仅大家长可见（可编辑）——店长不再展示只读版，
           按需求"大家长额外显示"字面执行 -->
      <block wx:if="{{isPatriarch}}">
        <view class="pd-mgmt-divider"></view>
        <view class="action-item-cell pd-feedback-entry-cell admin-key-entry-cell">
          <view class="item-left">
            <text class="manager-only-emoji">🔐</text>
            <text class="item-text">门店安全密钥设置</text>
          </view>
          <view class="admin-key-inline-right">
            <text class="admin-key-inline-val">{{storeAdminKeySet ? (storeAdminKeyVisible ? (storeAdminKey || '（已设置）') : '●●●●●●') : '未设置'}}</text>
            <view class="admin-key-btn admin-key-toggle-btn" bindtap="onToggleAdminKeyVisible" wx:if="{{storeAdminKeySet}}">{{storeAdminKeyVisible ? '隐藏' : '查看'}}</view>
            <view class="admin-key-btn admin-key-modify-btn" bindtap="onOpenAdminKeyModal">修改</view>
          </view>
        </view>
      </block>

      <!-- 🎨 组织文化配置（二）：机构名称/寄语/Logo/机构类型编辑——店长/大家长共有 -->
      <view class="action-item-cell pd-feedback-entry-cell" hover-class="ui-hover" bindtap="onOpenOrgConfigModal">
        <view class="item-left">
          <text class="manager-only-emoji">🎨</text>
          <text class="item-text">组织信息配置</text>
        </view>
        <view class="pd-feedback-entry-right">
          <view class="item-arrow">❯</view>
        </view>
      </view>

      <!-- 大家长专属：邀请码 + 全国数据看板（合并自底部工具箱，避免反复滚动） -->
      <block wx:if="{{isPatriarch}}">
        <view class="pd-mgmt-divider"></view>
        <view class="action-item-cell pd-feedback-entry-cell" hover-class="ui-hover" bindtap="onPatriarchGenCode">
          <view class="item-left">
            <text class="manager-only-emoji">🎫</text>
            <text class="item-text">生成本店邀请码</text>
          </view>
          <view class="item-arrow">❯</view>
        </view>
        <view class="action-item-cell pd-feedback-entry-cell" hover-class="ui-hover" bindtap="onPatriarchGoToNationalDashboard">
          <view class="item-left">
            <text class="manager-only-emoji">📊</text>
            <text class="item-text">全国数据看板</text>
            <text class="item-premium-tag">高级</text>
          </view>
          <view class="item-arrow">❯</view>
        </view>
      </block>
    </view>

    <!-- 分组二：日常记录 —— 原【我的餐报提交记录】+【我的统计数据】两个入口
         合并重构为两个更清晰的入口：「我的护持历程」（个人打卡/参与日志，即原
         "服务历程"改名）与「我的提交与数据」（餐报+物资提交历史，弹窗内新增
         月度统计摘要 + 跳转完整统计的入口，见下方 my-vs-monthly-stats）。
         🆕 「我的提交与数据」已解除 isFamily 限制，全员统一可见（原先整组连同
         该入口一起对家人隐藏，家人只能通过 family-care-card 里的重复入口查看，
         现改为整组容器不再按角色隐藏，组内其余"打卡/管理"类入口改为逐项加
         wx:if="{{!isFamily}}"，只有「我的提交与数据」保持无条件展示）。
         🔀 排在「核心荣誉」前面：日常操作类入口优先于荣誉展示 -->
    <view class="list-group-label">日常记录</view>

    <!-- 🏛️（2026-09-09 超管个人中心 IA 重构·个人业务档案收敛）"我的工坊购买"
         原是核心卡片位置下移后的独立大卡（.my-orders-entry-card，图标+双行
         文案+统计摘要），与下方"我的志愿历程"/"我的提交与数据"各自占一整张
         卡片，纵向堆叠偏长。三者业务含义不变（买家自查个人消费/个人打卡参与
         日志/餐报物资提交历史，互不相关，只是物理相邻），现合并进同一张紧凑
         列表卡片——"我的工坊购买"改用与另外两行一致的单图标+单行文案样式，
         订单笔数/最新摘要收进小徽标（与 rejectedCount 未读徽标同一视觉语言），
         减少三张卡片各自的 padding/margin/shadow 重复占用的纵向空间 -->
    <view class="ui-card-wrapper action-list-container personal-archive-card">
      <view class="action-item-cell" hover-class="ui-hover" wx:if="{{myProductionOrdersCount > 0}}" bindtap="onGoToMyProductionOrders">
        <view class="item-left">
          <text class="manager-only-emoji">🛒</text>
          <text class="item-text">我的工坊购买（个人消费）</text>
          <text class="unread-badge archive-count-badge">{{myProductionOrdersCount}}</text>
        </view>
        <view class="item-arrow">❯</view>
      </view>

      <!-- 🐛 双重图标修复：此前左侧 .item-icon-svg（SVG 矢量图标）与文案里手打的
           emoji（📜/📝）同时存在，等于同一个入口画了两枚图标，且 emoji 字形的行高
           与相邻纯文字菜单项不一致，会导致这两行看起来比其他行更高/字体更跳。
           统一改为与全页其余 .item-icon-svg 菜单项完全一致的单图标 + 纯文字模式
           （如"门店日志""管理视角切换"），字体大小/字重/颜色/行高全部复用 .item-text -->
      <view class="action-item-cell" hover-class="ui-hover" wx:if="{{!isFamily}}" bindtap="onTapServiceHistory">
        <view class="item-left">
          <view class="item-icon-svg icon-svg-flower"></view>
          <text class="item-text">{{isYuhuazhai ? '我的护持历程' : '我的志愿历程'}}</text>
        </view>
        <view class="item-arrow">❯</view>
      </view>

      <view class="action-item-cell" hover-class="ui-hover" bindtap="onGoToMySubmissions">
        <view class="item-left">
          <view class="item-icon-svg icon-svg-history"></view>
          <text class="item-text">我的提交与数据</text>
          <text class="unread-badge" wx:if="{{rejectedCount > 0}}">{{rejectedCount}}</text>
        </view>
        <view class="item-arrow">❯</view>
      </view>

      <!-- 🆕 本店数据看板（原【门店餐饮与物资统计】+【本店数据明细】合并入口）
           已从这个"个人日常记录"清单移出，改为收纳进各管理角色自己的【门店管理
           中心】卡片（isManager/isPatriarch 的 patriarch-panel-card）及财务的
           「💰 财务稽核专区」卡片内——这个清单现在严格只展示"个人提交流水"，
           不再混入门店维度的管理/账目功能，避免个人视角与门店管理视角混淆 -->

      <!-- 🏠 门店档案：门店人员与服务人群画像（中共党员/社会工作者/志愿者/堂食老人等 7 项人数指标），
           店长/超管可编辑维护，财务/义工只读查看。
           🐛 权限修复：此前用 wx:if="{{!isVolunteer}}" 把义工排除在外，与义工日常记录
           清单本应包含"门店档案"的设计意图不符——这里改为按 !isFamily 展示（本区块
           外层不再整体屏蔽家人后，门店档案对家人无意义，逐项补上 !isFamily）。
           🆕 图标统一：与本组其余入口一样改用 item-icon-svg 图标库，不再用手打 emoji -->
      <!-- 🏛️（2026-09-09 避免双重入口）超管已有本页顶部 sa-global-control-card
           的"门店档案/管理"格子（跳转全量门店列表，能力更强），这里改为对超管
           隐藏，避免同一账号在同一页看到两个指向不同能力的"门店档案"入口；
           店长/大家长/财务仍按原逻辑使用这个单店版入口 -->
      <view class="action-item-cell" hover-class="ui-hover" wx:if="{{!isFamily && !isSuperAdmin}}" bindtap="onGoToStoreProfile">
        <view class="item-left">
          <view class="item-icon-svg icon-svg-home"></view>
          <text class="item-text">门店档案</text>
        </view>
        <view class="item-arrow">❯</view>
      </view>

      <!-- 🐛 命名统一（与上方 245 行同一处修复）："爱心建议箱"改为"爱心意见箱"，
           与它实际打开的半屏弹窗标题一致。义工此前在个人页没有"提交建议"入口，
           复用家人卡片同款 onOpenFeedbackModal（小程序原生半屏弹窗，落在本项目
           自己的数据里，店长/大家长能在各自管理中心的"爱心意见箱管理"里看到并
           回复）。家人本就有自己卡片里的意见箱入口，这里逐项加 !isFamily 避免重复。
           🆕 图标统一：改用 item-icon-svg 图标库 -->
      <view class="action-item-cell" hover-class="ui-hover" wx:if="{{!isFamily}}" bindtap="onOpenFeedbackModal">
        <view class="item-left">
          <view class="item-icon-svg icon-svg-mail"></view>
          <text class="item-text">爱心意见箱</text>
        </view>
        <view class="pd-feedback-entry-right">
          <view class="badge" wx:if="{{unreadReplyCount > 0}}">{{unreadReplyCount}}</view>
          <view class="item-arrow">❯</view>
        </view>
      </view>

      <!-- 激活店长 / 财务特权：从原独立置底卡片移入本组末尾，刻意保留 subtle 弱化
           视觉（.subtle-cell），不与上面的核心日常操作抢焦点。只在完全没有特权的
           普通义工账号显示，家人（isFamily）逐项加 !isFamily 排除 -->
      <view class="action-item-cell subtle-cell" hover-class="ui-hover" wx:if="{{!hasPrivilege && !isFamily}}" bindtap="onTriggerActivate">
        <view class="item-left">
          <view class="item-icon-svg icon-svg-key subtle-icon"></view>
          <text class="item-text subtle-text">激活店长 / 财务特权</text>
        </view>
        <view class="item-arrow subtle-icon">❯</view>
      </view>
    </view>

    <!-- 🌸（信息架构优化）善行功德专区：合并原先物理位置相距很远的两块内容——
         「阳光温情图册与爱心故事」（原顶部 photo-archive-mine-entry 独立白卡）
         与「发心分布：阳善vs积阴德 + 阳善善缘墙」（原 national-overview-card），
         统一进一张视觉庄重的暖色专区卡片，避免色块生硬堆叠。两个子区块各自
         独立判空（一个用 recentPhotosLoaded，一个用 yangRatioPct/yinRatioPct），
         整卡 wx:if 取两者并集，任一子区块有内容就整卡渲染；数据获取逻辑
         （loadRecentPhotos()/fetchStoreLoveWallSummary()）完全不变，只是渲染
         的视觉容器合并了。子区块内部原有的数据源/角色可见性说明见下方各自
         注释，均从原位置原样迁移，未改动业务逻辑 -->
    <!-- 🏛️（2026-09-09）追加 isSuperAdmin && orgType 作为第 4 个可单独触发整卡渲染
         的条件——否则超管绑定的门店刚好还没有照片/发心比例数据时，下方新增的
         "阳光账本/每日家训"聚合行会因为外层卡片本身不渲染而一起消失 -->
    <view class="merit-hall-card" wx:if="{{recentPhotosLoaded || storeLoveWallMeritRatio.yangRatioPct > 0 || storeLoveWallMeritRatio.yinRatioPct > 0 || (isSuperAdmin && orgType)}}">
      <view class="merit-hall-header">
        <text class="merit-hall-icon">🌸</text>
        <text class="merit-hall-title">善行功德专区</text>
      </view>

      <!-- 📸 阳光温情图册与爱心故事：从首页迁移至个人中心，路由（history 页图册
           模式）与数据加载逻辑（getPhotoArchive 云函数）与原首页入口卡完全一致。
           全角色通用：wx:if 不再限制 !isVolunteer && !isFamily，义工/家人也能
           看到；已合并原【爱心温情故事】独立入口——getPhotoArchive 本就聚合
           activity_logs（温情故事）与 report_logs/daily_menus（阳光凭证），
           history 图册页已有"📸 活动日志"筛选 Tab，不需要旧版温情故事弹窗的
           二次跳转 -->
      <view class="merit-hall-row" wx:if="{{recentPhotosLoaded}}" hover-class="ui-hover" bindtap="onGoToPhotoArchive">
        <view class="pame-icon-wrap">
          <text class="pame-icon">🏡</text>
        </view>
        <view class="pame-text">
          <text class="pame-title">阳光温情图册与爱心故事</text>
          <text class="pame-subtitle">查看爱心图册、温情故事与阳光凭证{{recentPhotosTotal > 0 ? '（' + recentPhotosTotal + '张）' : ''}}</text>
        </view>
        <view class="pame-arrow">›</view>
      </view>

      <view class="merit-hall-divider" wx:if="{{recentPhotosLoaded && (storeLoveWallMeritRatio.yangRatioPct > 0 || storeLoveWallMeritRatio.yinRatioPct > 0)}}"></view>

      <!-- 💖 发心分布：阳善 vs 积阴德——从统计页「全国数据看板」迁移至此，原位置
           是数据密集的运营/财务分析场景，这类温情公开展示放在那里既不醒目也不
           合场景；个人中心是人人都会打开的页面，更适合公开展示。「最新爱心
           支持」滚动善缘墙已抽成独立可复用组件 <yangshan-wall/>（与首页同款，
           见 components/yangshan-wall），组件自行按 storeId 拉取数据。数据源是
           公开只读云函数 getSunshineLedger（与首页「☀️ 阳光账本」入口同款，见
           fetchStoreLoveWallSummary），严格按调用方自己归属的 storeId 查询，
           不做任何角色权限校验——家人/义工/财务/店长/大家长/超管全部角色都能
