    <!-- 编辑/新建视图 -->
    <block wx:elif="{{noticeManagementView === 'edit'}}">
      <view class="feedback-sheet-title-row">
        <text class="feedback-sheet-title notice-mgmt-edit-title">{{noticeMgmtEditId ? '编辑公告' : '发布新公告'}}</text>
        <view class="feedback-sheet-close-btn" bindtap="onCloseNoticeManagementModal">✕</view>
      </view>

      <scroll-view scroll-y class="notice-mgmt-scroll">
        <view class="notice-mgmt-form">
          <!-- 🏷️ 常用场景一键套用 -->
          <view class="notice-preset-section">
            <view class="notice-preset-label">⚡ 常用场景一键套用（点击自动填入标题与正文）</view>
            <view class="notice-preset-tags">
              <view class="notice-preset-tag" bindtap="onNoticeMgmtApplyPreset" data-key="opening">🌟 试营业喜讯</view>
              <view class="notice-preset-tag notice-preset-tag-warning" bindtap="onNoticeMgmtApplyPreset" data-key="weather_closure">⛅ 天气暂休</view>
              <view class="notice-preset-tag" bindtap="onNoticeMgmtApplyPreset" data-key="renovation_closure">🔧 整修暂休</view>
              <view class="notice-preset-tag" bindtap="onNoticeMgmtApplyPreset" data-key="volunteer">❤️ 义工招募</view>
              <view class="notice-preset-tag" bindtap="onNoticeMgmtApplyPreset" data-key="supplies">📦 物资告急</view>
              <view class="notice-preset-tag" bindtap="onNoticeMgmtApplyPreset" data-key="festival">🏮 节日活动</view>
              <view class="notice-preset-tag" bindtap="onNoticeMgmtApplyPreset" data-key="thanks">🤝 专项致谢</view>
            </view>
          </view>

          <text class="vt-form-label">公告标题</text>
          <input class="notice-mgmt-input"
                 type="text"
                 value="{{noticeMgmtEditTitle}}"
                 bindinput="onNoticeMgmtTitleInput"
                 placeholder="请输入公告标题（将显示在走马灯）"
                 maxlength="50" />

          <text class="vt-form-label" style="margin-top:24rpx;">公告正文</text>
          <textarea class="notice-mgmt-textarea"
                    value="{{noticeMgmtEditContent}}"
                    bindinput="onNoticeMgmtContentInput"
                    placeholder="请输入公告详细内容..."
                    maxlength="500"
                    auto-height />
