        <view class="fa-safe-area-spacer"></view>
      </scroll-view>

      <view class="notice-mgmt-footer notice-mgmt-footer-dual">
        <button class="notice-mgmt-cancel-btn"
                bindtap="onNoticeManagementBackToList"
                disabled="{{noticeMgmtSaving}}">取消</button>
        <button class="feedback-submit-btn notice-mgmt-save-btn {{(noticeMgmtSaving || !noticeMgmtEditTitle || !noticeMgmtEditContent) ? 'feedback-submit-btn-disabled notice-mgmt-save-btn-disabled' : ''}}"
                bindtap="onNoticeManagementSave"
                loading="{{noticeMgmtSaving}}"
                disabled="{{noticeMgmtSaving || !noticeMgmtEditTitle || !noticeMgmtEditContent}}">保存发布</button>
      </view>
    </block>
    </view>
  </view>

  <!-- ===== 🎫 生成本店邀请码 — 角色选择弹窗 ===== -->
  <!--
    三段式 Flex 布局（彻底解决底部按钮截断）：
    ① invite-modal-head  — flex-shrink:0，固定不滚动
    ② invite-modal-scroll — flex:1 + scroll-view，中间区域独立滚动
    ③ invite-modal-footer — flex-shrink:0，固定在底部永不压缩
  -->
  <view class="invite-modal-mask" wx:if="{{showInviteModal}}" catchtouchmove="stopPropagation" bindtap="onCloseInviteModal">
    <view class="invite-modal-panel" catchtap="stopPropagation">

      <!-- ① 固定头部：拖动条 + 标题行 + 提示卡片 + 副标题 -->
      <view class="invite-modal-head">
        <view class="invite-drag-bar"></view>
        <view class="invite-modal-header">
          <text class="invite-modal-title">🎫 生成本店邀请码</text>
          <view class="invite-modal-close" bindtap="onCloseInviteModal">×</view>
        </view>
        <view class="invite-modal-tip">💡 生成的邀请码 24 小时内有效，请直接发送给信任的本店成员。</view>
        <view class="invite-modal-label">选择邀请身份</view>
      </view>

      <!-- ② 中间独立滚动区：仅身份卡片参与滚动 -->
      <scroll-view scroll-y class="invite-modal-scroll">
        <view class="invite-role-grid">
          <view class="invite-role-item {{inviteTargetRole === 'STORE_PATRIARCH' ? 'selected' : ''}}"
                data-role="STORE_PATRIARCH" bindtap="onSelectInviteRole">
            <view class="invite-role-check" wx:if="{{inviteTargetRole === 'STORE_PATRIARCH'}}">✓</view>
            <text class="invite-role-icon">🏛️</text>
            <text class="invite-role-name">大家长</text>
            <text class="invite-role-desc">机构全局权限与审批</text>
          </view>
          <view class="invite-role-item {{inviteTargetRole === 'STORE_MANAGER' ? 'selected' : ''}}"
                data-role="STORE_MANAGER" bindtap="onSelectInviteRole">
            <view class="invite-role-check" wx:if="{{inviteTargetRole === 'STORE_MANAGER'}}">✓</view>
            <text class="invite-role-icon">⚙️</text>
            <text class="invite-role-name">门店店长</text>
            <text class="invite-role-desc">门店日常核销与管理</text>
          </view>
          <view class="invite-role-item {{inviteTargetRole === 'FINANCE' ? 'selected' : ''}}"
                data-role="FINANCE" bindtap="onSelectInviteRole">
            <view class="invite-role-check" wx:if="{{inviteTargetRole === 'FINANCE'}}">✓</view>
            <text class="invite-role-icon">💰</text>
            <text class="invite-role-name">财务记账</text>
            <text class="invite-role-desc">收支记账与报表核对</text>
          </view>
          <!-- 🐛 跨页面统一：此前本弹窗缺失【爱心家人】这一档，与 index.ts 的
               邀请码弹窗（onOpenGenCodeModal/genAvailableRoles）少了一个选项，
               大家长在本页无法生成家人身份的邀请码 -->
          <view class="invite-role-item {{inviteTargetRole === 'FAMILY' ? 'selected' : ''}}"
                data-role="FAMILY" bindtap="onSelectInviteRole">
            <view class="invite-role-check" wx:if="{{inviteTargetRole === 'FAMILY'}}">✓</view>
            <text class="invite-role-icon">❤️</text>
            <text class="invite-role-name">爱心家人</text>
            <text class="invite-role-desc">查看爱心餐与门店动态</text>
          </view>
          <view class="invite-role-item {{inviteTargetRole === 'VOLUNTEER' ? 'selected' : ''}}"
                data-role="VOLUNTEER" bindtap="onSelectInviteRole">
            <view class="invite-role-check" wx:if="{{inviteTargetRole === 'VOLUNTEER'}}">✓</view>
            <text class="invite-role-icon">🙏</text>
            <text class="invite-role-name">普通义工</text>
            <text class="invite-role-desc">每日打卡与餐报</text>
          </view>
        </view>
      </scroll-view>

      <!-- ③ 固定底部：flex-shrink:0 保证任何情况下都完整可见 -->
      <view class="invite-modal-footer">
        <view class="invite-gen-btn {{inviteGenerating ? 'invite-gen-btn-loading' : ''}}"
              bindtap="onGeneratePatriarchInviteCode">
          {{inviteGenerating ? '生成中...' : '生成邀请码'}}
        </view>
      </view>

    </view>
  </view>

  <!-- ===== 🎫 生成本店邀请码 — 结果展示弹窗 ===== -->
  <view class="invite-modal-mask" wx:if="{{showInviteResultModal}}" catchtouchmove="stopPropagation" bindtap="onCloseInviteResultModal">
    <view class="invite-modal-panel" catchtap="stopPropagation">

      <!-- ① 固定头部 -->
      <view class="invite-modal-head">
        <view class="invite-drag-bar"></view>
        <view class="invite-modal-header">
          <text class="invite-modal-title">✅ 邀请码生成成功</text>
          <view class="invite-modal-close" bindtap="onCloseInviteResultModal">×</view>
        </view>
      </view>

      <!-- ② 中间滚动区：邀请码卡片 + 有效期 + 二维码 + 警告 -->
      <scroll-view scroll-y class="invite-modal-scroll">
        <view class="invite-result-store">
          为 <text class="invite-result-store-name">{{inviteResultStoreName}}</text> 生成的邀请码
        </view>
        <view class="invite-result-code-box" bindtap="onCopyPatriarchInviteCode">
          <text class="invite-result-code">{{inviteResultCode}}</text>
          <text class="invite-result-tap-hint">点击复制</text>
        </view>
        <view class="invite-result-validity">⏰ 24 小时内有效，过期自动失效</view>
        <image wx:if="{{inviteResultQrFileId && !inviteQrLoadFailed}}"
               class="invite-result-qr"
               src="{{inviteResultQrFileId}}"
               mode="aspectFit"
               binderror="onInviteQrLoadError"
               show-menu-by-longpress />
        <view class="invite-result-qr-failed" wx:elif="{{inviteResultQrFileId && inviteQrLoadFailed}}">
          <text>二维码加载失败，可复制邀请码分享</text>
        </view>
        <view class="invite-result-warning">⚠️ 一次性特权码，核销后自动作废，请勿公开传播</view>
      </scroll-view>

      <!-- ③ 固定底部复制按钮 -->
      <view class="invite-modal-footer">
        <view class="invite-copy-btn" bindtap="onCopyPatriarchInviteCode">📋 复制邀请码</view>
      </view>

    </view>
  </view>

  <!-- ===================== 新用户入驻引导弹窗 ===================== -->
  <!-- ── 🎨 组织信息配置弹窗（大家长专属） ──────────────────────────── -->
  <view wx:if="{{showOrgConfigModal}}" class="onb-mask">
    <view class="onb-panel">

      <!-- 标题栏：Flex 居中标题 + 绝对定位关闭按钮——此前用"左侧✕ + 标题 + 右侧
           等宽占位 view"三段式模拟两端对齐，但占位 view 与✕按钮实际渲染宽度
           不对称（✕按钮没有固定尺寸，占位 view 又是空的 0 宽度），导致标题
           视觉上并不居中、✕也不在真正的右上角。现改为标题独占一行居中，
           关闭按钮脱离文档流绝对定位到右上角，两者互不干扰 -->
      <view class="onb-head org-config-head">
        <text class="onb-head-title">🎨 组织信息配置</text>
        <view class="onb-back-btn" bindtap="onCloseOrgConfigModal">✕</view>
      </view>

      <!-- 表单区 -->
      <scroll-view scroll-y class="onb-scroll">
        <view class="onb-form-body" style="padding-top: 32rpx !important; padding-bottom: 32rpx !important; padding-left: 36rpx !important; padding-right: 36rpx !important; box-sizing: border-box !important; width: 100% !important; overflow: hidden !important;">

          <!-- 组织/门店名称 -->
          <view class="onb-field-group">
            <!-- 🆕 提示文案改为挂在标签右侧的细小灰字（.onb-field-label-row +
                 .onb-field-label-hint），不再单独占一整行大块文字 -->
            <view style="display: flex !important; flex-direction: column !important; align-items: flex-start !important; width: 100% !important; box-sizing: border-box !important; margin-bottom: 12rpx !important;">
              <text style="font-size: 30rpx !important; font-weight: bold !important; color: #333333 !important;">门店名称</text>
              <text style="font-size: 22rpx !important; color: #999999 !important; font-weight: normal !important; margin-top: 4rpx !important; text-align: left !important;">简短即可，将结合所属地区汇总</text>
            </view>
            <input class="onb-field-input org-form-input" style="width: 100% !important; box-sizing: border-box !important; background: #F8F9FA !important; padding: 16rpx 20rpx !important; border-radius: 12rpx !important; font-size: 28rpx !important; height: 80rpx !important; min-height: 80rpx !important; line-height: 80rpx !important; margin-top: 12rpx !important;" placeholder="例：嵩屿街道敬老中心助餐点（或 海沧雨花斋）" value="{{orgConfigName}}" bindinput="onOrgConfigNameInput" maxlength="60" />
          </view>

          <!-- 🆕 机构/平台类型：已设置过的门店（orgConfigOrgTypeIndex >= 0）固定只读展示，
               避免二次误改引发文化文案风格漂移；仅当门店从未设置过（历史遗留/未走过
               首页工作空间选择）时才渲染下方 wx:else 的可点击 picker，一次性补录。
               🎨 只读态精简为轻量 Tag 标签 + 小字提示，替代原先大面积灰底伪输入框
               （一整行 #F1F1EE 灰底容器，视觉上像个能点的输入框，实际不可编辑，
               容易让人误以为交互失效；且占用一整行高度，与"仅供查看"的低优先级
               信息不匹配） -->
          <view class="onb-field-group" wx:if="{{orgConfigOrgTypeIndex >= 0}}">
            <view class="org-type-tag-row">
              <text class="org-type-field-label">机构类型</text>
              <view class="org-type-tag">
                <text class="org-type-tag-text">{{orgConfigTypeOptions[orgConfigOrgTypeIndex].label}}</text>
              </view>
            </view>
            <text class="org-type-field-hint">进入首页时已选定，决定首页与个人中心的文化文案风格</text>
          </view>
          <!-- 🆕（2026-09-09）原生滚轮选择器（picker mode="selector"）交互生硬、
               看不清各档位区别，改为 2x2 卡片单选网格：逐张卡片展示类型名 + 低饱和
               短标签（badge），选中后网格下方展示一行说明提示（hint），与卡片
               文案同源（ORG_CONFIG_TYPE_OPTIONS，见 profile.ts 注释），不是凭空
               写的展示文案 -->
          <view class="onb-field-group" wx:else>
            <text class="org-type-field-label">机构类型</text>
            <view class="org-type-card-grid">
              <view
                class="org-type-card {{orgConfigOrgType === item.value ? 'org-type-card-selected' : ''}}"
                wx:for="{{orgConfigTypeOptions}}"
                wx:key="value"
                data-value="{{item.value}}"
                bindtap="onOrgConfigOrgTypeSelect"
              >
                <text class="org-type-card-label">{{item.label}}</text>
                <view class="org-type-card-badge">{{item.badge}}</view>
              </view>
            </view>
            <text class="org-type-field-hint" wx:if="{{orgConfigOrgType}}">{{orgConfigOrgTypeHint}}</text>
            <text class="org-type-field-hint" wx:else>该门店尚未设置机构类型，点击上方卡片选择后将决定首页与个人中心的文化文案风格</text>
          </view>

          <!-- 🆕 文化寄语纵向上下分布，每句独立占满一行，避免文字被裁剪截断 -->
          <view class="onb-field-group culture-slogan-group">
            <view style="display: flex !important; flex-direction: column !important; align-items: flex-start !important; width: 100% !important; box-sizing: border-box !important; margin-bottom: 12rpx !important;">
              <text style="font-size: 30rpx !important; font-weight: bold !important; color: #333333 !important;">文化寄语 / 家训配置</text>
              <text style="font-size: 22rpx !important; color: #999999 !important; font-weight: normal !important; margin-top: 4rpx !important; text-align: left !important;">展示于首页顶栏及每日餐报海报</text>
            </view>
            <view style="display: flex !important; flex-direction: column !important; width: 100% !important; gap: 16rpx !important;">
              <view class="culture-slogan-col">
                <text class="culture-slogan-sub-label">第一句</text>
                <input
                  class="onb-field-input org-form-input culture-slogan-input"
                  style="width: 100% !important; box-sizing: border-box !important; background: #F8F9FA !important; padding: 16rpx 20rpx !important; border-radius: 12rpx !important; font-size: 28rpx !important; height: auto !important; min-height: 70rpx !important;"
                  placeholder="{{orgConfigOrgType === 'yuhuazhai' ? '如：买菜的敬畏、做菜的热爱、行堂的恭敬' : '如：节约粮食，温暖同行'}}"
                  value="{{orgConfigSlogan1}}"
                  bindinput="onOrgConfigSlogan1Input"
                  maxlength="30"
                />
              </view>
              <view class="culture-slogan-col">
                <text class="culture-slogan-sub-label">第二句</text>
                <input
                  class="onb-field-input org-form-input culture-slogan-input"
                  style="width: 100% !important; box-sizing: border-box !important; background: #F8F9FA !important; padding: 16rpx 20rpx !important; border-radius: 12rpx !important; font-size: 28rpx !important; height: auto !important; min-height: 70rpx !important;"
                  placeholder="{{orgConfigOrgType === 'yuhuazhai' ? '如：一粥一饭，当思来处不易' : '如：爱心传递每一天'}}"
                  value="{{orgConfigSlogan2}}"
                  bindinput="onOrgConfigSlogan2Input"
                  maxlength="30"
                />
              </view>
            </view>
          </view>

          <!-- 组织 Logo -->
          <view class="onb-field-group">
            <text class="onb-field-label">组织 Logo</text>
            <view class="orgcfg-logo-row">
              <!-- 🆕 预览态：图片包一层 wrap 承载右上角悬浮的"清空"按钮；
                   点击图片本身仍走 onUploadOrgLogo 重新选图 -->
              <view wx:if="{{orgConfigLogoUrl && !orgLogoLoadFailed}}" class="orgcfg-logo-preview-wrap">
                <image class="orgcfg-logo-preview" src="{{orgConfigLogoUrl}}" mode="aspectFill" bindtap="onUploadOrgLogo" binderror="onOrgLogoLoadError" />
                <!-- 🆕 悬浮微型操作按钮：↻ 更换 / ✕ 删除，替代原先并排的「重新上传」文字链接 -->
                <view class="orgcfg-logo-actions">
                  <view class="orgcfg-logo-action-btn" catchtap="onUploadOrgLogo">↻</view>
                  <view class="orgcfg-logo-action-btn orgcfg-logo-action-btn--danger" catchtap="onClearOrgLogo">✕</view>
                </view>
              </view>
              <view wx:else class="orgcfg-logo-placeholder" bindtap="onUploadOrgLogo">
                <view class="orgcfg-logo-icon-wrap">
                  <text class="orgcfg-logo-icon">📷</text>
                </view>
                <text class="orgcfg-logo-hint">{{orgConfigLogoUrl && orgLogoLoadFailed ? '加载失败，点击重新上传' : '点击上传'}}</text>
              </view>
            </view>
          </view>

        </view>
      </scroll-view>

      <!-- 底部保存按钮：暖色品牌主按钮，与「新建组织」引导弹窗的蓝色按钮
           （同样复用 .onb-submit-btn，但走的是另一条入驻流程）区分开——
           org-config-submit-btn 是仅本弹窗生效的修饰类，不影响 onb-submit-btn
           的共享基础样式 -->
      <view class="onb-footer">
        <view class="onb-submit-btn org-config-submit-btn {{orgConfigSaving ? 'onb-submit-btn--loading' : ''}}"
              hover-class="org-config-submit-btn-hover"
              bindtap="onSaveOrgConfig">
          {{orgConfigSaving ? '保存中…' : '保存配置'}}
        </view>
      </view>

    </view>
  </view>

  <view wx:if="{{showOnboardingModal}}" class="onb-mask">
    <view class="onb-panel">

      <!-- Step 1：选择路径 -->
      <block wx:if="{{onboardingStep === 'choice'}}">
        <!-- 头部 -->
        <view class="onb-head">
          <text class="onb-title">欢迎使用素小账 👋</text>
          <view class="onb-close" bindtap="onDismissOnboarding">×</view>
        </view>
        <!-- 内容 -->
        <view class="onb-body">
          <text class="onb-desc">您目前还未关联任何门店。请选择接下来要做的事：</text>
          <view class="onb-choice-btn onb-choice-primary" bindtap="onOnboardingChooseCreate">
            <text class="onb-choice-icon">🏠</text>
            <view class="onb-choice-text">
              <text class="onb-choice-main">创建新组织 / 门店</text>
              <text class="onb-choice-sub">成为大家长，自主管理账目</text>
            </view>
          </view>
          <view class="onb-choice-btn onb-choice-secondary" bindtap="onOnboardingChooseJoin">
            <text class="onb-choice-icon">🔑</text>
            <view class="onb-choice-text">
              <text class="onb-choice-main onb-choice-main--dark">通过邀请码加入</text>
              <text class="onb-choice-sub">已有大家长给您发了邀请码</text>
            </view>
          </view>
          <text class="onb-dismiss-hint" bindtap="onDismissOnboarding">以后再说</text>
        </view>
      </block>

      <!-- Step 2：填写创建信息 -->
      <block wx:if="{{onboardingStep === 'create'}}">
        <!-- 固定头部 -->
        <view class="onb-head">
          <view class="onb-back" bindtap="onOnboardingBackToChoice">‹ 返回</view>
          <text class="onb-title">创建您的组织</text>
          <view class="onb-close" bindtap="onDismissOnboarding">×</view>
        </view>
        <!-- 中间滚动区 -->
        <scroll-view scroll-y class="onb-scroll">
          <text class="onb-form-hint">填写后您将成为该组织的大家长，可管理门店账目与成员。</text>

          <view class="onb-field">
            <text class="onb-label">组织名称 <text class="onb-required">*</text></text>
            <input class="onb-input" placeholder="例：厦门海沧爱心食堂"
                   value="{{onboardingOrgName}}"
                   bindinput="onOnboardingOrgNameInput" maxlength="30" />
          </view>

          <view class="onb-field">
            <text class="onb-label">首个门店名称 <text class="onb-required">*</text></text>
            <input class="onb-input" placeholder="同组织名或具体门店名"
                   value="{{onboardingStoreName}}"
                   bindinput="onOnboardingStoreNameInput" maxlength="30" />
            <text class="onb-field-hint">默认与组织名相同，可单独修改</text>
          </view>

          <view class="onb-field">
            <text class="onb-label">您的真实姓名 <text class="onb-required">*</text></text>
            <input class="onb-input" placeholder="用于身份核验"
                   value="{{onboardingRealName}}"
                   bindinput="onOnboardingRealNameInput" maxlength="20" />
          </view>

          <view class="onb-field">
            <text class="onb-label">联系电话（选填）</text>
            <input class="onb-input" placeholder="方便运营联系"
                   type="number" value="{{onboardingPhone}}"
                   bindinput="onOnboardingPhoneInput" maxlength="11" />
          </view>

          <view class="onb-field">
            <text class="onb-label">组织类型</text>
            <picker mode="selector" range="{{orgTypeOptions}}" range-key="label"
                    value="{{orgTypeIndex}}" bindchange="onOnboardingOrgTypeChange">
              <view class="onb-picker">
                <text>{{orgTypeOptions[orgTypeIndex].label}}</text>
                <text class="onb-picker-arrow">›</text>
              </view>
            </picker>
          </view>
        </scroll-view>
        <!-- 固定底部按钮 -->
        <view class="onb-footer">
          <view class="onb-submit-btn {{onboardingCreating ? 'onb-submit-btn--loading' : ''}}"
                bindtap="onSubmitCreateOrg">
            {{onboardingCreating ? '创建中…' : '立即创建'}}
          </view>
        </view>
      </block>

    </view>
  </view>

  <!-- ✏️ 快捷修改门店名称 Mini-Modal（大家长/超管专属） -->
  <view class="esn-mask" wx:if="{{showEditStoreNameModal}}" bindtap="onCloseEditStoreNameModal">
    <view class="esn-card" catchtap="stopPropagation">
      <view class="esn-header">
        <text class="esn-title">✏️ 修改门店名称</text>
        <view class="esn-close" bindtap="onCloseEditStoreNameModal">✕</view>
      </view>
      <view class="esn-body">
        <input
          class="esn-input"
          value="{{tempStoreName}}"
          bindinput="onTempStoreNameInput"
          placeholder="例：嵩屿街道敬老中心助餐点（或 海沧雨花斋）"
          maxlength="60"
          focus="{{showEditStoreNameModal}}"
        />
        <text class="esn-hint">💡 门店名称保持简短即可，系统会自动结合【所属地区】进行全国汇总</text>
      </view>
      <view class="esn-footer">
        <view class="esn-btn esn-btn-cancel" bindtap="onCloseEditStoreNameModal">取消</view>
        <view class="esn-btn esn-btn-confirm {{editStoreNameSaving ? 'esn-btn-loading' : ''}}" bindtap="onConfirmEditStoreName">
          {{editStoreNameSaving ? '保存中…' : '确认修改'}}
        </view>
      </view>
    </view>
  </view>

  <!-- 🏛️（护城河一 M1：以产养善·物资反哺链）产销工坊反哺核销弹窗——只读
       charity_contributions 这张两边体系之间唯一的中间账本，不触碰
       tenant_members/production_orders 半点，见 manageCharityContribution
       云函数头部注释。
       🍚（2026-09-08）标题与入口卡片统一改为"工坊爱心护持"系措辞（modal 内
       用"明细"二字与卡片本身区分，避免同名歧义），裸露的 🌾 emoji 升级为
       微圆角低饱和图标容器，与本页/workspace-join 等页面已验证过的
       icon-badge 设计语言保持一致。⚠️ 本 modal 复用的 .admin-key-modal-title
       共享 class 在另外三处（联系超级管理员/设置管理员密钥/重置门店管理员
       密钥）仍是裸 emoji 前缀写法，本次只针对这一处做局部包裹，未改动共享
       class 本身，如需统一到全部四处需要单独确认 -->
  <view class="certificate-modal-mask" wx:if="{{showCharityContributionModal}}" catchtouchmove="stopPropagation" bindtap="onCloseCharityContributionModal">
    <view class="certificate-modal-card" catchtap="stopPropagation">
      <view class="certificate-modal-header">
        <view class="ccm-title-row">
          <view class="ccm-title-icon-badge">
            <text class="ccm-title-icon">🍚</text>
          </view>
          <text class="admin-key-modal-title">工坊爱心护持明细</text>
        </view>
        <view class="certificate-modal-close" bindtap="onCloseCharityContributionModal">✕</view>
      </view>

      <view class="ccm-loading" wx:if="{{charityContributionModalLoading}}">
        <text>加载中...</text>
      </view>
      <view class="ccm-empty" wx:elif="{{charityContributions.length === 0}}">
        <text>暂无产销工坊转捐记录</text>
      </view>
      <scroll-view class="ccm-list" scroll-y wx:else>
        <view class="ccm-item" wx:for="{{charityContributions}}" wx:key="_id">
          <view class="ccm-item-top">
            <text class="ccm-item-amount">¥{{item.amountYuan}}</text>
            <text class="ccm-item-status ccm-status-{{item.pledgeStatus}}">{{item.pledgeStatusLabel}}</text>
          </view>
          <text class="ccm-item-sub">来自「{{item.tenantId}}」工坊 · {{item.pledgedAtLabel}}</text>
          <text class="ccm-item-note" wx:if="{{item.redeemNote}}">备注：{{item.redeemNote}}</text>
          <view class="ccm-redeem-btn" wx:if="{{item.pledgeStatus === 'pledged'}}" data-id="{{item._id}}" bindtap="onRedeemCharityContribution">
            标记已核销领用
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

</view>
