        <view class="aws-text-col">
          <text class="aws-title">门店管理中心</text>
          <text class="aws-sub" wx:if="{{(pendingMemberApplicationCount + pendingVolunteerSubmissionCount + pendingFeedbackCount) > 0}}">{{pendingMemberApplicationCount + pendingVolunteerSubmissionCount + pendingFeedbackCount}} 项待处理</text>
          <text class="aws-sub" wx:else>暂无待处理事项</text>
