        </view>
        <view wx:else>
          <view class="notice-mgmt-item" wx:for="{{noticeManagementList}}" wx:key="_id">
            <view class="notice-mgmt-item-header">
              <view class="notice-mgmt-status-dot {{item.is_active ? 'active' : 'inactive'}}"></view>
              <text class="notice-mgmt-item-title">{{item.title}}</text>
              <text class="notice-mgmt-item-status">{{item.is_active ? '展示中' : '已隐藏'}}</text>
            </view>
            <text class="notice-mgmt-item-content" user-select>{{item.content}}</text>
            <view class="notice-mgmt-item-actions">
              <view class="notice-mgmt-action-btn toggle-btn" bindtap="onNoticeManagementToggleActive" data-id="{{item._id}}">
