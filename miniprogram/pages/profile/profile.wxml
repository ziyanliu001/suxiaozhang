         门店管理中心，且用 isPatriarch || isSuperAdmin 与超管共用），现拆分为：
         ① 独立的 .pro-service-card（订阅是机构/租户维度的权益，超管与大家长按各自
            身份都可能需要管理，保持 isPatriarch || isSuperAdmin 共用不变）；
         ② 两张严格仅 isPatriarch && !isSuperAdmin 可见的自治卡片——【本店经营健康
            大盘】【大家长自治管理中心】。超管即便去掉视角切换预览、以自己真实身份
            浏览时，也绝不会看到这两张店级日常运营卡片；要看某店的这两张卡片，
            走"视角切换"预览成该店大家长身份即可（预览态下 isSuperAdmin 会降级为
            false，isPatriarch 命中，两张卡片自然显示）。
         store_manager（店长）有自己独立的"门店管理中心"卡片（见下方），不再混入
         这里 -->
    <!-- 🆕 加入 isFinance：财务角色的"👑 专业版服务"卡片组第一项——财务本就
         最关心订阅权益是否覆盖多账本稽核/无限制通知数，与大家长共用同一张卡。
         🛡️ 超管视角下彻底隐藏：套餐订阅是租户/门店维度的权益，超管作为平台方本人
         无需（也不该）看到"立即开通专业版"这类面向租户的推销卡片——此前误与
         isPatriarch/isFinance 共用同一张卡片，现显式排除 isSuperAdmin -->
    <!-- 🆕 大家长（及店长）不再展示这张整行大卡片：专业版服务状态收纳进上方
         「顶部卡片区」.top-advanced-secondary 弱化辅助卡片，与全国数据看板
         并排展示，不再单独占用一整行——财务角色需求不变，仍显示完整版 -->
    <view class="pro-service-card" wx:if="{{isFinance && !isVolunteer && !isFamily && !isManager && !isSuperAdmin && !isPatriarch}}">
      <view class="pro-card-header">
        <text class="pro-title">👑 专业版服务状态</text>
        <text class="pro-status-badge {{subscriptionInfo.isActive ? 'active' : 'inactive'}}">
          {{subscriptionInfo.isActive ? '已生效（专业版）' : '未开通'}}
        </text>
      </view>
      <view class="pro-card-body">
        <text class="pro-desc">解锁全国数据大屏、跨店数据导出、多账本稽核与无限制通知数。</text>
        <button class="pro-action-btn" bindtap="onOpenProSubscriptionModal">
          {{subscriptionInfo.isActive ? '管理续费套餐' : '立即开通 / 升级专业版'}}
        </button>
      </view>
      <!-- 超管一键模拟开通入口已迁移至「系统运维与性能」模块的 Dev/Debug 专区
           （见 sa-dev-tool-row），与真实订阅管理操作解耦，避免重复入口 -->
    </view>

    <!-- 💰 财务角色卡片组第二部分：财务稽核专区——isFinance 严格等于
         displayRole === 'finance'（不含大家长/超管/店长），不需要额外排除条件。
         🆕 深度重构：新增 3 列 KPI 数据看板（待复核凭证/本月稽核总额/合规预警，
         见 fetchFinanceAuditData），下方 4 个操作入口重新梳理为财务核心工作流：
         凭证快速复核 → 门店账目明细 → 阳光账本核查 → Excel 财务报表导出 -->
    <view class="patriarch-panel-card finance-audit-card" wx:if="{{isFinance}}">
      <view class="patriarch-panel-header">
        <text class="patriarch-panel-title">💰 财务稽核专区</text>
      </view>

      <!-- 3 列 KPI 数据看板：待复核凭证 >0 橙色高亮，本月稽核总额加粗金额，
           合规预警/异常 >0 红色警示 -->
      <view class="fa-kpi-grid" wx:if="{{!financeAuditData.loading}}">
        <view class="fa-kpi-cell">
          <text class="fa-kpi-val {{financeAuditData.pendingReviewCount > 0 ? 'fa-warn' : ''}}">{{financeAuditData.pendingReviewCount}}</text>
          <text class="fa-kpi-lbl">待复核凭证</text>
        </view>
        <view class="fa-kpi-cell">
          <text class="fa-kpi-val fa-bold">¥{{financeAuditData.monthAuditTotal}}</text>
          <text class="fa-kpi-lbl">本月稽核总额</text>
        </view>
        <view class="fa-kpi-cell">
          <text class="fa-kpi-val {{financeAuditData.anomalyCount > 0 ? 'fa-danger' : ''}}">{{financeAuditData.anomalyCount}}</text>
          <text class="fa-kpi-lbl">合规预警/异常</text>
        </view>
      </view>
      <view class="fa-kpi-grid" wx:else>
        <view class="fa-kpi-cell skel-cell" wx:for="{{[1,2,3]}}" wx:key="*this">
          <view class="skel-bar skel-bar-lg"></view>
          <view class="skel-bar skel-bar-sm"></view>
        </view>
      </view>

      <view class="fa-divider"></view>

      <view class="action-item-cell pd-feedback-entry-cell" hover-class="ui-hover" bindtap="onGoToVoucherReview">
        <view class="item-left">
          <text class="manager-only-emoji">🧾</text>
          <text class="item-text">凭证快速复核</text>
        </view>
        <view class="pd-feedback-entry-right">
          <view class="badge" wx:if="{{financeAuditData.pendingReviewCount > 0}}">{{financeAuditData.pendingReviewCount}}</view>
          <view class="item-arrow">❯</view>
        </view>
      </view>

      <view class="action-item-cell pd-feedback-entry-cell" hover-class="ui-hover" bindtap="onGoToFinanceLedger">
        <view class="item-left">
          <view class="item-icon-svg icon-svg-bar-chart"></view>
          <text class="item-text">门店账目明细</text>
        </view>
        <view class="item-arrow">❯</view>
      </view>

      <view class="action-item-cell pd-feedback-entry-cell" hover-class="ui-hover" bindtap="onGoToSunshineLedgerAudit">
        <view class="item-left">
          <text class="manager-only-emoji">☀️</text>
          <text class="item-text">阳光账本核查</text>
        </view>
        <view class="item-arrow">❯</view>
      </view>

      <view class="action-item-cell pd-feedback-entry-cell" hover-class="ui-hover" bindtap="onExportFinanceExcel">
        <view class="item-left">
          <text class="manager-only-emoji">📊</text>
          <text class="item-text">Excel 财务报表导出</text>
        </view>
        <view class="item-arrow">❯</view>
      </view>
    </view>

    <!-- 🆕 顶部卡片区（数据与高级功能）：左侧主卡片加粗突出展示；专业服务弱化为
         右侧轻量 Banner/Tag，只标明开通状态，不与核心数据入口抢视觉焦点——两者
         物理并排，暗示"核心数据"与"增值服务"同一层级但主次分明。店长与家长
         视角共用同一套顶部卡片外壳，但文案按角色区分：
         🐛 根因修复：此前不分角色一律显示"全国数据看板/查看全平台"，但
         onPatriarchGoToNationalDashboard 跳转到 statistics.wxml 后，只有
         isPatriarch 才会触发 _triggerPatriarchNationalView() 真正切到全国聚合视图
         （见 statistics.ts onLoad 对 _autoNationalIntent 的判断），isManager 点进去
         只是落在自己门店的常规历史统计页——按设计店长本就不该有跨店数据权限，
         这是正确的行为，但顶部卡片文案"全国数据看板/查看全平台"完全说错了，
         点进去发现根本不是全国数据，容易被当成 bug 反馈。现在按角色分文案，
         店长看到的是与实际落地页一致的"所在店铺历史数据看板" -->
    <view class="top-advanced-row" wx:if="{{(isPatriarch || isManager) && !isSuperAdmin && !isVolunteer && !isFamily && !isFinance}}">
      <view class="top-advanced-primary" hover-class="ui-hover" bindtap="onPatriarchGoToNationalDashboard">
        <text class="top-advanced-primary-icon">{{isPatriarch ? '🌐' : '📊'}}</text>
        <text class="top-advanced-primary-title">{{isPatriarch ? '全国数据看板' : '所在店铺历史数据看板'}}</text>
        <text class="top-advanced-primary-sub">{{isPatriarch ? '查看全平台 / 全国统计数据' : '查看本店历史经营数据'}}</text>
        <text class="top-advanced-primary-arrow">❯</text>
      </view>
      <view class="top-advanced-secondary {{subscriptionInfo.isActive ? 'active' : ''}}" hover-class="ui-hover" bindtap="onOpenProSubscriptionModal">
        <text class="top-advanced-secondary-icon">👑</text>
        <text class="top-advanced-secondary-title">专业服务</text>
        <text class="top-advanced-secondary-tag">{{subscriptionInfo.isActive ? '已开通' : '未开通 · 点击了解'}}</text>
      </view>
    </view>

    <!-- 🆕 区块一：本店经营健康大盘——服务人次/收支/净额 + 验真状态 + 高风险
         待确认队列（作废申请/门店画像变更）。仅真实大家长本人可见，超管不再
         直接经手单店日常运营数据 -->
    <view class="patriarch-panel-card" wx:if="{{isPatriarch && !isSuperAdmin && !isVolunteer && !isFamily && !isManager && !isFinance}}">
      <view class="patriarch-panel-header">
        <text class="patriarch-panel-title">📊 本店经营健康大盘</text>
      </view>

      <!-- 🆕 点击整卡跳转到本店统计明细页（复用店长同款 onGoToStoreOverview，
           携带 shopName 预选中本店），大盘只做摘要，明细收敛到统计页 -->
      <view class="pd-health-card pd-health-card--clickable" hover-class="ui-hover" bindtap="onGoToStoreOverview">
        <view class="pd-health-title-row">
          <text class="pd-health-title">{{patriarchData.monthLabel}}经营概况</text>
          <text class="pd-health-more">查看明细 ❯</text>
        </view>
        <view class="pd-health-grid">
          <view class="pd-health-cell">
            <text class="pd-health-lbl">本月服务人次</text>
            <text class="pd-health-val">{{patriarchData.monthDiners}} 人次</text>
          </view>
          <view class="pd-health-cell">
            <text class="pd-health-lbl">本月收入</text>
            <text class="pd-health-val green">¥{{patriarchData.monthIncome}}</text>
          </view>
          <view class="pd-health-cell">
            <text class="pd-health-lbl">本月支出</text>
            <text class="pd-health-val red">¥{{patriarchData.monthExpense}}</text>
          </view>
          <view class="pd-health-cell">
            <text class="pd-health-lbl">本月净额</text>
            <text class="pd-health-val {{patriarchData.monthNetPositive ? 'green' : 'red'}}">{{patriarchData.monthNetPositive ? '+' : '-'}}¥{{patriarchData.monthNet}}</text>
          </view>
        </view>
        <!-- 🆕 防伪验真进度条：原来只有一行纯文字"已验真 X / 共 Y 条"，看不出
             进度快慢；现补上分段进度条，与荣誉勋章详情弹窗的 .badge-detail-progress-*
             同一套视觉手法（轨道+渐变填充），百分比由 fetchPatriarchDashboardData()
             算好，WXML 只做纯变量输出 -->
        <view class="pd-verify-section">
          <view class="pd-verify-row">
            <text class="pd-verify-icon">🛡️</text>
            <text class="pd-verify-text">防伪验真：已验真 {{patriarchData.auditedCount}} / 共 {{patriarchData.totalCount}} 条</text>
          </view>
          <view class="pd-verify-progress-track" wx:if="{{patriarchData.totalCount > 0}}">
            <view class="pd-verify-progress-fill" style="width: {{patriarchData.verifyProgressPercent}}%;"></view>
          </view>
        </view>
      </view>

      <!-- 待确认队列：作废申请 -->
      <view class="pd-section-title" wx:if="{{patriarchData.pendingVoidList.length > 0}}">
        <text class="pd-section-icon">⏳</text>
        <text class="pd-section-txt">待确认的作废申请（{{patriarchData.pendingVoidList.length}}）</text>
      </view>
      <view class="pd-void-card" wx:for="{{patriarchData.pendingVoidList}}" wx:key="docId">
        <view class="pd-void-info">
          <text class="pd-void-date">{{item.dateString}}</text>
          <text class="pd-void-amount">今日结余 ¥{{item.todayBalance}} · 支出 ¥{{item.expenseAmount}}</text>
        </view>
        <view class="pd-void-actions">
          <button class="pd-btn-reject" data-id="{{item.docId}}" data-action="reject" bindtap="onDecideVoid" disabled="{{patriarchData.voidActionInFlight}}">驳回</button>
          <button class="pd-btn-approve" data-id="{{item.docId}}" data-action="approve" bindtap="onDecideVoid" disabled="{{patriarchData.voidActionInFlight}}">确认作废</button>
        </view>
      </view>

      <!-- 待确认队列：门店画像变更 -->
      <view class="pd-section-title" wx:if="{{patriarchData.pendingProfileUpdate}}">
        <text class="pd-section-icon">⏳</text>
        <text class="pd-section-txt">待确认的门店画像变更</text>
      </view>
      <view class="pd-profile-card" wx:if="{{patriarchData.pendingProfileUpdate}}">
        <view class="pd-profile-items">
          <text class="pd-profile-item" wx:for="{{patriarchData.pendingProfileItems}}" wx:for-item="pf" wx:key="label">{{pf.label}}：{{pf.value}}</text>
        </view>
        <view class="pd-void-actions">
          <button class="pd-btn-reject" data-action="reject" bindtap="onDecideProfileUpdate" disabled="{{patriarchData.profileActionInFlight}}">驳回</button>
          <button class="pd-btn-approve" data-action="approve" bindtap="onDecideProfileUpdate" disabled="{{patriarchData.profileActionInFlight}}">确认变更</button>
        </view>
      </view>

      <view class="pd-empty-tip" wx:if="{{patriarchData.pendingVoidList.length === 0 && !patriarchData.pendingProfileUpdate && !patriarchData.loading}}">
        <text>✅ 当前没有待确认的高风险操作</text>
      </view>
      <view class="pd-loading-box" wx:if="{{patriarchData.loading}}">
        <text>加载中...</text>
      </view>
    </view>

    <!-- 🆕 区块二：门店管理中心（大家长专属·分组网格化）——【日常审批与安全】
         用 2x2 宫格突出高频操作与待办 Badge（一眼扫清有几件事要处理），
         【门店运营配置】维持列表形式（低频公示/配置类操作，不需要抢视觉优先级），
         两种信息密度物理分组，管理任务轻重缓急一目了然。此卡片严格仅
         isPatriarch 专属——原合并卡片（下方 patriarch-panel-card，isManager 专属）
         保留给店长继续使用旧的列表式布局，互不影响 -->
    <view class="patriarch-panel-card" wx:if="{{isPatriarch && !isSuperAdmin && !isVolunteer && !isFamily && !isManager && !isFinance}}">
      <view class="patriarch-panel-header">
        <text class="patriarch-panel-title">⚙️ 门店管理中心</text>
        <view class="pd-store-name-pill" catchtap="onEditStoreInfo">
          <text class="pd-store-name-pill-text">{{currentStoreName || '未命名门店'}}</text>
          <text class="pd-store-name-pill-edit">✏️</text>
        </view>
      </view>

      <!-- 🗂️ 【门店管理中心】：成员/审批/账目——四项最高频的门店管理动作用 2x2
           宫格突出，带待办数量的红点角标。🆕 原第 4 格"安全密钥/邀请码"迁到下方
           【治理与安全】组，腾出的位置换成"门店账目与凭证管理"（原本在
           下面的列表里）——三组划分严格对齐"成员/审批/账目"|"组织/公告"|
           "治理与安全"这三条业务边界，而不是按"操作频率"这种此前的口径分组 -->
      <text class="pd-mgmt-section-title">门店管理中心</text>
      <view class="pd-mgmt-grid">
        <view class="pd-mgmt-grid-cell" hover-class="ui-hover" bindtap="onOpenMemberManageModal">
          <text class="pd-mgmt-grid-icon">⚙️</text>
          <text class="pd-mgmt-grid-label">成员管理</text>
        </view>

        <view class="pd-mgmt-grid-cell" hover-class="ui-hover" bindtap="onOpenMemberApplicationModal">
          <view class="pd-mgmt-grid-badge" wx:if="{{pendingMemberApplicationCount > 0}}">{{pendingMemberApplicationCount}}</view>
          <text class="pd-mgmt-grid-icon">🙋</text>
          <text class="pd-mgmt-grid-label">待审批申请</text>
        </view>

        <view class="pd-mgmt-grid-cell" hover-class="ui-hover" bindtap="onOpenVolunteerSubmissionAdminModal">
          <view class="pd-mgmt-grid-badge" wx:if="{{pendingVolunteerSubmissionCount > 0}}">{{pendingVolunteerSubmissionCount}}</view>
          <text class="pd-mgmt-grid-icon">📝</text>
          <text class="pd-mgmt-grid-label">待审核餐报</text>
        </view>

        <!-- 🆕 门店账目与凭证管理：原【本店数据看板】（合并自【门店餐饮与物资统计】+
             【本店数据明细】），从下方"运营配置"列表移入本宫格，与 isManager/
             isFinance 的同款入口保持命名/跳转目标一致 -->
        <view class="pd-mgmt-grid-cell" hover-class="ui-hover" bindtap="onGoToStoreOverview">
          <text class="pd-mgmt-grid-icon">📊</text>
          <text class="pd-mgmt-grid-label">账目与凭证</text>
        </view>
      </view>

      <view class="pd-mgmt-divider"></view>

      <!-- 🗂️ 【门店运营配置】：组织信息配置 + 门店公告/通知——低频公示与配置类
           操作，保留列表形式，不与上方高频宫格抢视觉焦点 -->
      <text class="pd-mgmt-section-title">门店运营配置</text>

      <view class="action-item-cell pd-feedback-entry-cell" hover-class="ui-hover" bindtap="onOpenOrgConfigModal">
        <view class="item-left">
          <text class="manager-only-emoji">🎨</text>
          <text class="item-text">组织信息配置</text>
        </view>
        <view class="pd-feedback-entry-right">
          <view class="item-arrow">❯</view>
        </view>
      </view>

      <view class="action-item-cell pd-feedback-entry-cell" hover-class="ui-hover" bindtap="onOpenNoticeManagement">
        <view class="item-left">
          <text class="manager-only-emoji">📢</text>
          <text class="item-text">门店公告/通知</text>
        </view>
        <view class="pd-feedback-entry-right">
          <view class="item-arrow">❯</view>
        </view>
      </view>

      <view class="pd-mgmt-divider"></view>

      <!-- 🐛 命名去重：原名"文化与平台监管"与页面底部全角色共用的"文化与平台
           监督"底座（见 list-group-label，line ~1188）只差一个字，大家长这个角色
           会同时看到"文化与平台监管"（本组）和"文化与平台监督"（页面底部），两个
           名字长得几乎一样但内容完全不同，容易误以为是重复入口。改名为【治理与
           安全】，准确描述本组实际内容——爱心意见箱（社区心声反馈）+ 安全密钥 +
           邀请码（门店准入与访问控制），与上面两组的"日常运营"性质不同，
           单独归为第三组 -->
      <text class="pd-mgmt-section-title">治理与安全</text>

      <view class="action-item-cell pd-feedback-entry-cell" hover-class="ui-hover" bindtap="onOpenFeedbackAdminModal">
        <view class="item-left">
          <text class="manager-only-emoji">📮</text>
          <text class="item-text">爱心意见箱</text>
        </view>
        <view class="pd-feedback-entry-right">
          <view class="badge" wx:if="{{pendingFeedbackCount > 0}}">{{pendingFeedbackCount}}</view>
          <view class="item-arrow">❯</view>
        </view>
      </view>

      <view class="action-item-cell pd-feedback-entry-cell" hover-class="ui-hover" bindtap="onOpenAdminKeyModal">
        <view class="item-left">
          <text class="manager-only-emoji">🔐</text>
          <text class="item-text">安全密钥</text>
        </view>
        <view class="pd-feedback-entry-right">
          <view class="item-arrow">❯</view>
        </view>
      </view>

      <view class="action-item-cell pd-feedback-entry-cell" hover-class="ui-hover" bindtap="onPatriarchGenCode">
        <view class="item-left">
          <text class="manager-only-emoji">🎫</text>
          <text class="item-text">邀请码</text>
        </view>
        <view class="pd-feedback-entry-right">
          <view class="item-arrow">❯</view>
        </view>
      </view>
    </view>

    <!-- 🆕 【店长专属】📊 本店数据概览：2x2 核心指标卡片，放在【门店管理中心】
         正上方——店长打开个人中心第一眼就能扫到今日运营核心数字，不用逐个点开
         管理弹窗才能看到。今日用餐人次/今日义工打卡/结余概览见
         fetchManagerTodaySnapshot；待审批事项直接对三路已在 initMinePage 里
         proactively 拉取好的角标计数求和展示，不发起额外请求 -->
    <view class="mgr-snapshot-card" wx:if="{{isManager && !isSuperAdmin && !isVolunteer && !isFamily && !isFinance && !isPatriarch}}">
      <view class="mgr-snapshot-header">
        <text class="mgr-snapshot-title">📊 本店数据概览</text>
      </view>
      <view class="mgr-snapshot-grid">
        <view class="mgr-snapshot-cell">
          <text class="mgr-snapshot-val">{{todayMealsCount}}</text>
          <text class="mgr-snapshot-lbl">今日用餐人次</text>
        </view>
        <view class="mgr-snapshot-cell">
          <text class="mgr-snapshot-val">{{todayVolunteersCount}}</text>
          <text class="mgr-snapshot-lbl">今日义工打卡</text>
        </view>
        <view class="mgr-snapshot-cell">
          <text class="mgr-snapshot-val {{(pendingMemberApplicationCount + pendingVolunteerSubmissionCount + pendingFeedbackCount) > 0 ? 'highlight' : ''}}">{{pendingMemberApplicationCount + pendingVolunteerSubmissionCount + pendingFeedbackCount}}</text>
          <text class="mgr-snapshot-lbl">待审批事项</text>
        </view>
        <view class="mgr-snapshot-cell">
          <text class="mgr-snapshot-val">¥{{storeNetBalance}}</text>
          <text class="mgr-snapshot-lbl">爱心积攒 / 结余</text>
        </view>
      </view>
    </view>

    <!-- 🏪 【店长专属】⚙️ 门店管理中心：与上方大家长专属的宫格化卡片同名，
         但沿用旧版列表式布局——大家长已改用新版宫格卡片（isManager 已从
         wx:if 中移除），这里严格只服务 isManager，二者互不重叠 -->
    <view class="patriarch-panel-card" wx:if="{{isManager && !isSuperAdmin && !isVolunteer && !isFamily && !isFinance && !isPatriarch}}">
      <!-- 🐛 层级瘦身：此前标题行"⚙️ 门店管理中心"与紧接着第二行的"🏢 门店管理
           中心 [门店名] ✏️修改"重复堆叠了两遍"门店管理中心"文案——合并为一行，
           门店名改用轻量 Pill 标签收纳在大标题右侧，点击直接唤起【组织信息配置】
           （onEditStoreInfo），不再单独起一整行 -->
      <view class="patriarch-panel-header">
        <text class="patriarch-panel-title">⚙️ 门店管理中心</text>
        <view class="pd-store-name-pill" catchtap="onEditStoreInfo">
          <text class="pd-store-name-pill-text">{{currentStoreName || '未命名门店'}}</text>
          <text class="pd-store-name-pill-edit">✏️</text>
        </view>
      </view>

      <!-- 🗂️ 分组一：核心日常审批——2x2 宫格，与大家长专属的门店管理中心
           （见上方 isPatriarch 卡片）同一套 .pd-mgmt-grid 视觉语言，两个角色的
           管理中心不再一个是宫格一个是纯列表。四项都是高频日常运维操作，
           带待办数量 Badge 提醒 -->
      <text class="pd-mgmt-section-title">核心日常审批</text>
      <view class="pd-mgmt-grid">
        <view class="pd-mgmt-grid-cell" hover-class="ui-hover" bindtap="onOpenMemberManageModal">
          <text class="pd-mgmt-grid-icon">⚙️</text>
          <text class="pd-mgmt-grid-label">成员权限管理</text>
        </view>

        <view class="pd-mgmt-grid-cell" hover-class="ui-hover" bindtap="onOpenMemberApplicationModal">
          <view class="pd-mgmt-grid-badge" wx:if="{{pendingMemberApplicationCount > 0}}">{{pendingMemberApplicationCount}}</view>
          <text class="pd-mgmt-grid-icon">🙋</text>
          <text class="pd-mgmt-grid-label">待审批申请</text>
        </view>

        <view class="pd-mgmt-grid-cell" hover-class="ui-hover" bindtap="onOpenVolunteerSubmissionAdminModal">
          <view class="pd-mgmt-grid-badge" wx:if="{{pendingVolunteerSubmissionCount > 0}}">{{pendingVolunteerSubmissionCount}}</view>
          <text class="pd-mgmt-grid-icon">📝</text>
          <text class="pd-mgmt-grid-label">待审核餐报</text>
        </view>

        <!-- 🆕 门店账目与凭证管理：原【本店数据看板】（合并自【门店餐饮与物资统计】+
             【本店数据明细】），门店维度的账目/凭证管理是门店管理职责，不该混在
             个人提交流水清单里，与 isFinance「财务稽核专区」的同款入口保持
             命名/跳转目标一致 -->
        <view class="pd-mgmt-grid-cell" hover-class="ui-hover" bindtap="onGoToStoreOverview">
          <text class="pd-mgmt-grid-icon">📊</text>
          <text class="pd-mgmt-grid-label">账目与凭证</text>
        </view>
      </view>

      <view class="pd-mgmt-divider"></view>

      <!-- 🗂️ 分组二：门店运营公告——对外公示/沟通类，与上面"审批处理"类操作
           物理分组，避免高频待办事项和低频公告项混排在一起 -->
      <text class="pd-mgmt-section-title">门店运营公告</text>

      <!-- 📢 门店公告/通知管理：此前只有店长的门店管理中心有这个入口，大家长自己的
           面板一直没有，这里补齐 -->
      <view class="action-item-cell pd-feedback-entry-cell" hover-class="ui-hover" bindtap="onOpenNoticeManagement">
        <view class="item-left">
          <text class="manager-only-emoji">📢</text>
          <text class="item-text">门店公告/通知管理</text>
        </view>
        <view class="pd-feedback-entry-right">
          <view class="item-arrow">❯</view>
        </view>
      </view>

      <!-- 📮 爱心意见箱管理：不在最初的精简清单里，但这是目前全站唯一剩下的入口——
           删掉会导致这项功能对所有角色（含超管）都不可用，保留 -->
      <view class="action-item-cell pd-feedback-entry-cell" hover-class="ui-hover" bindtap="onOpenFeedbackAdminModal">
        <view class="item-left">
          <text class="manager-only-emoji">📮</text>
          <text class="item-text">爱心意见箱管理</text>
        </view>
        <view class="pd-feedback-entry-right">
          <view class="badge" wx:if="{{pendingFeedbackCount > 0}}">{{pendingFeedbackCount}}</view>
          <view class="item-arrow">❯</view>
        </view>
      </view>

      <!-- 🔑 门店安全密钥设置：仅大家长可见（可编辑）——店长不再展示只读版，
           按需求"大家长额外显示"字面执行 -->
      <block wx:if="{{isPatriarch}}">
        <view class="pd-mgmt-divider"></view>
        <view class="action-item-cell pd-feedback-entry-cell admin-key-entry-cell">
          <view class="item-left">
            <text class="manager-only-emoji">🔐</text>
            <text class="item-text">门店安全密钥设置</text>
          </view>
          <view class="admin-key-inline-right">
            <text class="admin-key-inline-val">{{storeAdminKeySet ? (storeAdminKeyVisible ? (storeAdminKey || '（已设置）') : '●●●●●●') : '未设置'}}</text>
            <view class="admin-key-btn admin-key-toggle-btn" bindtap="onToggleAdminKeyVisible" wx:if="{{storeAdminKeySet}}">{{storeAdminKeyVisible ? '隐藏' : '查看'}}</view>
            <view class="admin-key-btn admin-key-modify-btn" bindtap="onOpenAdminKeyModal">修改</view>
          </view>
        </view>
      </block>

      <!-- 🎨 组织文化配置（二）：机构名称/寄语/Logo/机构类型编辑——店长/大家长共有 -->
      <view class="action-item-cell pd-feedback-entry-cell" hover-class="ui-hover" bindtap="onOpenOrgConfigModal">
        <view class="item-left">
          <text class="manager-only-emoji">🎨</text>
          <text class="item-text">组织信息配置</text>
        </view>
        <view class="pd-feedback-entry-right">
          <view class="item-arrow">❯</view>
        </view>
      </view>

      <!-- 大家长专属：邀请码 + 全国数据看板（合并自底部工具箱，避免反复滚动） -->
      <block wx:if="{{isPatriarch}}">
        <view class="pd-mgmt-divider"></view>
        <view class="action-item-cell pd-feedback-entry-cell" hover-class="ui-hover" bindtap="onPatriarchGenCode">
          <view class="item-left">
            <text class="manager-only-emoji">🎫</text>
            <text class="item-text">生成本店邀请码</text>
          </view>
          <view class="item-arrow">❯</view>
        </view>
        <view class="action-item-cell pd-feedback-entry-cell" hover-class="ui-hover" bindtap="onPatriarchGoToNationalDashboard">
          <view class="item-left">
            <text class="manager-only-emoji">📊</text>
            <text class="item-text">全国数据看板</text>
            <text class="item-premium-tag">高级</text>
          </view>
          <view class="item-arrow">❯</view>
        </view>
      </block>
    </view>

    <!-- 分组二：日常记录 —— 原【我的餐报提交记录】+【我的统计数据】两个入口
         合并重构为两个更清晰的入口：「我的护持历程」（个人打卡/参与日志，即原
         "服务历程"改名）与「我的提交与数据」（餐报+物资提交历史，弹窗内新增
         月度统计摘要 + 跳转完整统计的入口，见下方 my-vs-monthly-stats）。
         🆕 「我的提交与数据」已解除 isFamily 限制，全员统一可见（原先整组连同
         该入口一起对家人隐藏，家人只能通过 family-care-card 里的重复入口查看，
         现改为整组容器不再按角色隐藏，组内其余"打卡/管理"类入口改为逐项加
         wx:if="{{!isFamily}}"，只有「我的提交与数据」保持无条件展示）。
         🔀 排在「核心荣誉」前面：日常操作类入口优先于荣誉展示 -->
    <view class="list-group-label">日常记录</view>
    <view class="ui-card-wrapper action-list-container">
      <!-- 🐛 双重图标修复：此前左侧 .item-icon-svg（SVG 矢量图标）与文案里手打的
           emoji（📜/📝）同时存在，等于同一个入口画了两枚图标，且 emoji 字形的行高
           与相邻纯文字菜单项不一致，会导致这两行看起来比其他行更高/字体更跳。
           统一改为与全页其余 .item-icon-svg 菜单项完全一致的单图标 + 纯文字模式
           （如"门店日志""管理视角切换"），字体大小/字重/颜色/行高全部复用 .item-text -->
      <view class="action-item-cell" hover-class="ui-hover" wx:if="{{!isFamily}}" bindtap="onTapServiceHistory">
        <view class="item-left">
          <view class="item-icon-svg icon-svg-flower"></view>
          <text class="item-text">{{isYuhuazhai ? '我的护持历程' : '我的志愿历程'}}</text>
        </view>
        <view class="item-arrow">❯</view>
      </view>

      <view class="action-item-cell" hover-class="ui-hover" bindtap="onGoToMySubmissions">
        <view class="item-left">
          <view class="item-icon-svg icon-svg-history"></view>
          <text class="item-text">我的提交与数据</text>
          <text class="unread-badge" wx:if="{{rejectedCount > 0}}">{{rejectedCount}}</text>
        </view>
        <view class="item-arrow">❯</view>
      </view>

      <!-- 🆕 本店数据看板（原【门店餐饮与物资统计】+【本店数据明细】合并入口）
           已从这个"个人日常记录"清单移出，改为收纳进各管理角色自己的【门店管理
           中心】卡片（isManager/isPatriarch 的 patriarch-panel-card）及财务的
           「💰 财务稽核专区」卡片内——这个清单现在严格只展示"个人提交流水"，
           不再混入门店维度的管理/账目功能，避免个人视角与门店管理视角混淆 -->

      <!-- 🏠 门店档案：门店人员与服务人群画像（中共党员/社会工作者/志愿者/堂食老人等 7 项人数指标），
           店长/超管可编辑维护，财务/义工只读查看。
           🐛 权限修复：此前用 wx:if="{{!isVolunteer}}" 把义工排除在外，与义工日常记录
           清单本应包含"门店档案"的设计意图不符——这里改为按 !isFamily 展示（本区块
           外层不再整体屏蔽家人后，门店档案对家人无意义，逐项补上 !isFamily）。
           🆕 图标统一：与本组其余入口一样改用 item-icon-svg 图标库，不再用手打 emoji -->
      <view class="action-item-cell" hover-class="ui-hover" wx:if="{{!isFamily}}" bindtap="onGoToStoreProfile">
        <view class="item-left">
          <view class="item-icon-svg icon-svg-home"></view>
          <text class="item-text">门店档案</text>
        </view>
        <view class="item-arrow">❯</view>
      </view>

      <!-- 🐛 命名统一（与上方 245 行同一处修复）："爱心建议箱"改为"爱心意见箱"，
           与它实际打开的半屏弹窗标题一致。义工此前在个人页没有"提交建议"入口，
           复用家人卡片同款 onOpenFeedbackModal（小程序原生半屏弹窗，落在本项目
           自己的数据里，店长/大家长能在各自管理中心的"爱心意见箱管理"里看到并
           回复）。家人本就有自己卡片里的意见箱入口，这里逐项加 !isFamily 避免重复。
           🆕 图标统一：改用 item-icon-svg 图标库 -->
      <view class="action-item-cell" hover-class="ui-hover" wx:if="{{!isFamily}}" bindtap="onOpenFeedbackModal">
        <view class="item-left">
          <view class="item-icon-svg icon-svg-mail"></view>
          <text class="item-text">爱心意见箱</text>
        </view>
        <view class="pd-feedback-entry-right">
          <view class="badge" wx:if="{{unreadReplyCount > 0}}">{{unreadReplyCount}}</view>
          <view class="item-arrow">❯</view>
        </view>
      </view>

      <!-- 激活店长 / 财务特权：从原独立置底卡片移入本组末尾，刻意保留 subtle 弱化
           视觉（.subtle-cell），不与上面的核心日常操作抢焦点。只在完全没有特权的
           普通义工账号显示，家人（isFamily）逐项加 !isFamily 排除 -->
      <view class="action-item-cell subtle-cell" hover-class="ui-hover" wx:if="{{!hasPrivilege && !isFamily}}" bindtap="onTriggerActivate">
        <view class="item-left">
          <view class="item-icon-svg icon-svg-key subtle-icon"></view>
          <text class="item-text subtle-text">激活店长 / 财务特权</text>
        </view>
        <view class="item-arrow subtle-icon">❯</view>
      </view>
    </view>

    <!-- 💖 全网爱心支持卡片：不展示门店总数/活跃门店/服务人次等运营数据网格，
         也没有跳转数据大屏的卡片标题/入口——只保留「发心分布：阳善 vs 积阴德」
         比例条这块公开、温情性质的内容；「最新爱心支持」滚动善缘墙已抽成独立
         可复用组件 <yangshan-wall/>（与首页同款，见 components/yangshan-wall），
         组件自行按 storeId 拉取数据，不需要本卡片再传一份 donors 列表进去。
         🆕 数据源是公开只读云函数 getSunshineLedger（与首页「☀️ 阳光账本」入口
         同款，见 fetchStoreLoveWallSummary），严格按调用方自己归属的 storeId
         查询，不做任何角色权限校验——家人/义工/财务/店长/大家长/超管全部角色
         都能看到，且只会看到自己所属门店的数据，不会带出其他门店的信息。
         比例条 wx:if 与 <yangshan-wall/> 各自独立判空，不需要卡片外层再做
         一次联合判断——donors 非空必然意味着 yangRatioPct>0（donors 只会来自
         阳善报表），不存在"比例条为空但善缘墙有数据"的情况 -->
    <view class="national-overview-card" wx:if="{{storeLoveWallMeritRatio.yangRatioPct > 0 || storeLoveWallMeritRatio.yinRatioPct > 0}}">
      <!-- 发心分布：阳善 vs 积阴德——从统计页「全国数据看板」迁移至此，原位置是
           数据密集的运营/财务分析场景，这类温情公开展示放在那里既不醒目也不合
           场景；个人中心是人人都会打开的页面，更适合公开展示 -->
      <view class="no-merit-section no-merit-section--first">
        <text class="no-merit-title">发心分布：阳善 vs 积阴德</text>
        <view class="no-merit-bar-wrap">
          <view class="no-merit-seg seg-yang" style="width:{{storeLoveWallMeritRatio.yangRatioPct}}%" wx:if="{{storeLoveWallMeritRatio.yangRatioPct > 0}}"></view>
          <view class="no-merit-seg seg-yin" style="width:{{storeLoveWallMeritRatio.yinRatioPct}}%" wx:if="{{storeLoveWallMeritRatio.yinRatioPct > 0}}"></view>
        </view>
        <view class="no-merit-legend">
          <!-- 🆕 解释性提示文案：与首页提交报表时的「发心选择」卡片（onSelectMerit，
               data-type="yang"/"yin"）用同一套措辞，帮用户看懂比例条到底在说什么——
               选公示姓名(阳善)的会进下方善缘墙，选积阴德(匿名)的只计入比例不露名 -->
          <view class="no-merit-legend-item" wx:if="{{storeLoveWallMeritRatio.yangRatioPct > 0}}">
            <view class="no-merit-dot dot-yang"></view>
            <view class="no-merit-legend-text-col">
              <text class="no-merit-legend-text">🌟 阳善（公开）{{storeLoveWallMeritRatio.yangRatioPct}}%</text>
              <text class="no-merit-legend-caption">公开姓名，长养公信</text>
            </view>
          </view>
          <view class="no-merit-legend-item" wx:if="{{storeLoveWallMeritRatio.yinRatioPct > 0}}">
            <view class="no-merit-dot dot-yin"></view>
            <view class="no-merit-legend-text-col">
              <text class="no-merit-legend-text">🌙 积阴德（匿名）{{storeLoveWallMeritRatio.yinRatioPct}}%</text>
              <text class="no-merit-legend-caption">隐名护持，涵养阴德</text>
            </view>
          </view>
        </view>
      </view>

      <view class="no-yangshan-wall-slot">
        <yangshan-wall storeId="{{myStoreId}}" />
      </view>
    </view>

    <!-- 🆕 大家长视角·个人荣誉模块折叠入口：管理任务优先，爱心护持榜/核心荣誉
         对大家长而言是次要的个人向信息，默认收起只留一条摘要 + 展开按钮，避免
         管理向页面被这两张较长的卡片拖得下滑过长。其余角色（义工/店长/财务）
         不受影响，始终直接展示完整内容——仅 isPatriarch 命中折叠逻辑 -->
    <view class="pd-honor-collapsed-bar" wx:if="{{isPatriarch && !isSuperAdmin && !patriarchHonorExpanded}}" hover-class="ui-hover" bindtap="onTogglePatriarchHonor">
      <text class="pd-honor-collapsed-icon">🌸</text>
      <text class="pd-honor-collapsed-text">展开我的个人义工荣誉</text>
      <text class="pd-honor-collapsed-arrow">∨</text>
    </view>

    <!-- 🌸 爱心护持榜 + 🏅 核心荣誉徽章墙：从页面靠前位置搬入【义工角色】日常记录
         区块内，物理相邻展示。可见范围（!isFamily && !isSuperAdmin && !isFinance，
         家人/纯超管/财务视角均看不到，其余角色——义工/店长/大家长——都能看到，
         这组内容并非严格 isVolunteer 专属，缩窄会让其他角色丢失现有功能）。
         🆕 财务角色排除：护持天数/累计工时/义工电子证书/服务榜单都是义工向的
         个人荣誉展示，与财务的稽核职责无关，容易造成角色混淆——财务已有专属的
         【财务稽核专区】数据看板（见 finance-audit-card），不再需要这组卡片
         🆕 大家长视角额外叠加折叠态判断（!isPatriarch || patriarchHonorExpanded）：
         非大家长角色恒为 true，行为不变；大家长仅在点击展开后才渲染 -->
    <view class="merit-board-card" wx:if="{{!isFamily && !isSuperAdmin && !isFinance && (!isPatriarch || patriarchHonorExpanded)}}">
      <view class="board-header">
        <view class="header-icon-svg icon-svg-flower"></view>
        <text class="header-title">爱心护持榜</text>
        <view class="header-icon-svg icon-svg-flower flip-x"></view>
      </view>

      <!-- 🌟 核心荣誉数据：护持天数 / 累计工时，暖金渐变底 + 微阴影提升仪式感，
           大号加粗突出，与次要统计做视觉分层 -->
      <view class="merit-hero-row">
        <view class="merit-hero-cell">
          <text class="merit-hero-num">{{stats.volunteerDays || 0}}</text>
          <text class="merit-hero-label">{{isYuhuazhai ? '护持天数' : '服务天数'}}</text>
        </view>
        <view class="merit-hero-divider"></view>
        <view class="merit-hero-cell">
          <text class="merit-hero-num">{{stats.volunteerHours || 0}}</text>
          <text class="merit-hero-label">累计工时</text>
        </view>
      </view>

      <!-- 🎖️ 义工电子证书快捷入口：与 honor-wall-header 里的"义工证书"共用
           同一个 onGoToBadges，方便义工在护持榜顶部就能直接查看/分享荣誉证书 -->
      <view class="merit-cert-entry" bindtap="onGoToBadges">
        <text class="merit-cert-entry-text">🎖️ 义工电子证书</text>
        <view class="item-arrow">❯</view>
      </view>

      <view class="merit-sub-row" wx:if="{{hasPrivilege}}">
        <view class="merit-sub-cell" wx:if="{{isStoreAdmin}}">
          <text class="merit-sub-num">{{stats.submittedReports || 0}}</text>
          <text class="merit-sub-label">登记餐报</text>
        </view>
        <view class="merit-sub-cell" wx:if="{{isFinance || isPatriarch || isSuperAdmin}}">
          <text class="merit-sub-num">{{stats.auditedReports || 0}}</text>
          <text class="merit-sub-label">稽核账本</text>
        </view>
      </view>

      <!-- ❤️ 爱心护持榜：本月/年度/总贡献三档，前 20 名 + 前三名奖牌 + 当前登录用户
           自己的排名与距上一名差距，姓名统一脱敏展示 -->
      <view class="leaderboard-divider"></view>
      <view class="leaderboard-section">
        <view class="leaderboard-tab-row">
          <view class="leaderboard-tab {{leaderboardRange === 'month' ? 'active' : ''}}" bindtap="onSwitchLeaderboardRange" data-range="month">本月榜</view>
          <view class="leaderboard-tab {{leaderboardRange === 'year' ? 'active' : ''}}" bindtap="onSwitchLeaderboardRange" data-range="year">年度榜</view>
          <view class="leaderboard-tab {{leaderboardRange === 'total' ? 'active' : ''}}" bindtap="onSwitchLeaderboardRange" data-range="total">总贡献榜</view>
        </view>

        <view class="leaderboard-loading" wx:if="{{leaderboardLoading}}">加载中…</view>
        <block wx:elif="{{leaderboardList.length > 0}}">
          <view class="leaderboard-row {{item.isSelf ? 'is-self' : ''}}" wx:for="{{leaderboardList}}" wx:key="rank">
            <view class="leaderboard-rank {{item.rank <= 3 ? 'top3' : ''}}">
              <text wx:if="{{item.rank === 1}}">🥇</text>
              <text wx:elif="{{item.rank === 2}}">🥈</text>
              <text wx:elif="{{item.rank === 3}}">🥉</text>
              <text wx:else>{{item.rank}}</text>
            </view>
            <text class="leaderboard-name">{{item.displayName}}</text>
            <text class="leaderboard-hours">{{item.hours}}h</text>
          </view>
        </block>
        <view class="leaderboard-empty" wx:else>暂无{{isYuhuazhai ? '护持' : '服务'}}记录，快去打卡吧～</view>

        <view class="leaderboard-self-footer" wx:if="{{leaderboardSelfRank > 0}}">
          <text>当前排名：第 {{leaderboardSelfRank}} 名</text>
          <text wx:if="{{leaderboardGapToNext > 0}}"> · 距上一名还差 {{leaderboardGapToNext}} 工时</text>
          <text wx:else> · 🎉 您已是本榜第一名</text>
        </view>
        <view class="leaderboard-self-footer unranked" wx:elif="{{!leaderboardLoading}}">
          <text>您暂未上榜，打卡即可参与排名</text>
        </view>
      </view>
    </view>

    <view class="list-group-label" wx:if="{{!isFamily && !isSuperAdmin && !isFinance && (!isPatriarch || patriarchHonorExpanded)}}">核心荣誉</view>
    <view class="honor-wall-card" wx:if="{{!isFamily && !isSuperAdmin && !isFinance && (!isPatriarch || patriarchHonorExpanded)}}">
      <view class="honor-wall-header">
        <text class="honor-wall-title">🏅 我的核心荣誉</text>
        <view class="honor-wall-cert-link" bindtap="onGoToBadges">
          <text>义工证书</text>
          <view class="item-arrow">❯</view>
        </view>
      </view>

      <scroll-view scroll-x="true" class="honor-badge-scroll" enable-flex>
        <view class="honor-badge-row">
          <view
            class="honor-badge-item {{item.unlocked ? 'unlocked' : 'locked'}}"
            wx:for="{{badgeList}}"
            wx:key="id"
            bindtap="onTapBadge"
            data-id="{{item.id}}"
          >
            <view class="honor-badge-circle">
              <text class="honor-badge-emoji">{{item.emoji}}</text>
              <!-- 未点亮：柔和灰阶基础上叠加完成百分比，让人一眼看到"还差多少" -->
              <text class="honor-badge-percent" wx:if="{{!item.unlocked}}">{{item.progressPercent}}%</text>
            </view>
            <text class="honor-badge-name">{{item.name}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 🆕 大家长专属：展开态下的收起按钮，与顶部折叠摘要条呼应，随时可收回 -->
    <view class="pd-honor-collapse-btn" wx:if="{{isPatriarch && !isSuperAdmin && patriarchHonorExpanded}}" hover-class="ui-hover" bindtap="onTogglePatriarchHonor">
      <text>收起</text>
      <text class="pd-honor-collapsed-arrow">∧</text>
    </view>

    <!-- 👑 超级管理员工具箱：两张外层卡片——① 全局控制台（深色，全网数据与决策）
         ② 系统管理面板（浅色，内部再分风控与安全 / 视角与租户管理 / 系统运维与
         性能三个分组，原先是三张各自独立的卡片，已合并瘦身，见下方 admin-dashboard-card）。
         🆕 挪位：整组从"角色差异化功能区"之前移到之后——先看完家人/义工/店长-
         大家长/财务各自的功能区，再是纯超管本人视角才会命中的工具箱，符合
         "顶部通用区 → 角色差异化功能区 → 超管工具箱 → 文化与平台监督底座 →
         底部账号操作"的整体信息架构顺序。
         整组统一挂 isSuperAdmin：处于"模拟视角"预览时 isSuperAdmin 会降级为 false，
         两张卡片随之一起隐藏，改由顶部 sa-status-bar 接管展示——避免深色
         指挥卡与浅色列表在预览态下同时刷屏、语义打架。真正的"超管专属操作"权限
         仍由各 on* 处理函数内部用 isRealSuperAdmin 二次校验，与卡片显隐是两回事。 -->

    <!-- 模块一：全局控制台（深色，全网数据与决策入口）
         🛡️ 加固：显式排除 isVolunteer/isFamily/isManager/isPatriarch/isFinance，
         多重兜底——即便未来角色计算逻辑出现回归导致 isSuperAdmin 与其他角色标志
         同时为 true，店长/义工/家人/大家长/财务视角也绝不会渲染这张超管专属卡片。
         isSuperAdmin 本身已与其余角色互斥，这里是防御性冗余，不是当前已知的漏洞修复 -->
    <view class="sa-command-card" wx:if="{{isSuperAdmin && !isVolunteer && !isFamily && !isManager && !isPatriarch && !isFinance}}">
      <view class="sa-command-header">
        <view class="sa-command-badge-row">
          <text class="sa-command-crown">👑</text>
          <view class="sa-command-title-col">
            <text class="sa-command-title">超级管理员</text>
            <text class="sa-command-sub">全局控制台</text>
          </view>
        </view>
        <view class="sa-command-store-tag">
          <text class="sa-command-store-name">{{currentStoreName || '全国总览'}}</text>
        </view>
      </view>

      <view class="sa-action-row" bindtap="onGoToStatistics" hover-class="ui-hover">
        <view class="sa-action-left">
          <text class="sa-action-icon">🚀</text>
          <view class="sa-action-text-col">
            <text class="sa-action-title">全国数据看板</text>
            <text class="sa-action-desc">全网餐次 · 义工工时 · 财务健康度</text>
          </view>
        </view>
        <view class="sa-action-arrow">❯</view>
      </view>
      <!-- 🐛 死代码清理：这一行此前按 isPlatformAdmin 分流文案，但本卡片整体的
           wx:if 已要求 isSuperAdmin===true（见上方 sa-command-card），而
           isPlatformAdmin===true 时 isSuperAdmin 恒为 false（platform_admin 与
           super_admin 是两个完全独立的角色维度，前者的 trueServerRole 永远不会
           等于 'super_admin'，见 authService.ts UserRole 定义处注释）——这张卡片
           对 platform_admin 账号根本不会渲染，isPlatformAdmin 分支永远走不到。
           platform_admin 的入口在下方 admin-developer-section（会员开通/续费
           管理），本行固定展示 super_admin/store_patriarch 唯一会看到的文案：
           点击后由 onGoToPlatformAdminTenants() 就地弹出本机构的"套餐升级/续费"
           半屏卡片，不跳转 pages/platform-admin（该页面服务端 requirePlatformAdmin
           只认 platform_admin，super_admin 进去只会撞见硬拦截） -->
      <view class="sa-action-row" bindtap="onGoToPlatformAdminTenants" hover-class="ui-hover">
        <view class="sa-action-left">
          <text class="sa-action-icon">💎</text>
          <view class="sa-action-text-col">
            <text class="sa-action-title">开通 / 续费专业版套餐</text>
            <text class="sa-action-desc">全国汇总大屏 · 批量导出 · 高级权限</text>
          </view>
        </view>
        <view class="sa-action-arrow">❯</view>
      </view>
    </view>

    <!-- 🆕 结构瘦身：风控与安全 / 视角与租户管理 / 系统运维与性能，原先是三张
         各自独立的 .sa-light-card 外层卡片，现合并进同一张 .admin-dashboard-card，
         内部按 .admin-dashboard-section-title 分组、.admin-dashboard-divider 分隔——
         页面外层卡片数量减少 2 张，各分组内部的 action-row 绑定与交互逻辑完全不变 -->
    <!-- 🛡️ 加固：同 sa-command-card，显式排除 isVolunteer/isFamily/isManager/isPatriarch/
         isFinance 作防御性冗余——"撤销违规管理权限"/"重置门店申请密钥"/"系统运维与性能"
         这类平台全局工具收在这张卡片内，大家长/财务（放权自治后）绝不应该看到 -->
    <view class="admin-dashboard-card" wx:if="{{isSuperAdmin && !isVolunteer && !isFamily && !isManager && !isPatriarch && !isFinance}}">
      <view class="admin-dashboard-header">
        <text class="admin-dashboard-title">🛡️ 系统管理面板</text>
      </view>

      <!-- 风控与安全：顶部风险预警条复用 patriarchData（fetchPatriarchDashboardData
           已按当前选中门店加载，超管与家长共用同一份数据），不新增云函数调用；
           仅当有待确认的作废/画像变更时才显示 -->
      <text class="admin-dashboard-section-title">🛡️ 风控与安全</text>
      <view class="sa-risk-banner" wx:if="{{patriarchData.pendingVoidList.length > 0 || patriarchData.pendingProfileUpdate}}">
        <text class="sa-risk-banner-dot"></text>
        <text class="sa-risk-banner-text">{{currentStoreName || '当前门店'}} 有 {{patriarchData.pendingVoidList.length + (patriarchData.pendingProfileUpdate ? 1 : 0)}} 项待确认的高风险操作</text>
      </view>
      <view class="sa-light-action-row" bindtap="onOpenForceUnbindModal" hover-class="ui-hover">
        <view class="sa-action-left">
          <text class="sa-action-icon">🛡️</text>
          <text class="sa-light-action-title">撤销违规管理权限</text>
        </view>
        <view class="sa-light-action-arrow">❯</view>
      </view>
      <view class="sa-light-action-row" bindtap="onOpenResetStoreKeyModal" hover-class="ui-hover">
        <view class="sa-action-left">
          <text class="sa-action-icon">🔑</text>
          <text class="sa-light-action-title">重置门店申请密钥</text>
        </view>
        <view class="sa-light-action-arrow">❯</view>
      </view>
      <view class="sa-light-action-row" bindtap="onOpenSecurityLogModal" hover-class="ui-hover">
        <view class="sa-action-left">
          <text class="sa-action-icon">📋</text>
          <text class="sa-light-action-title">安全操作日志</text>
        </view>
        <view class="sa-light-action-arrow">❯</view>
      </view>

      <view class="admin-dashboard-divider"></view>

      <!-- 视角与租户管理：门店/家长管理下钻见下方 patriarch-panel-card 管理中心，
           isSuperAdmin 同样命中该卡片，不重复建入口 -->
      <text class="admin-dashboard-section-title">🎭 视角与租户管理</text>
      <view class="sa-light-action-row" bindtap="onOpenViewModeModal" hover-class="ui-hover">
        <view class="sa-action-left">
          <text class="sa-action-icon">🎭</text>
          <view class="sa-action-text-col">
            <text class="sa-light-action-title">管理视角切换</text>
            <text class="sa-action-desc sa-light-desc">当前：{{viewModeOptionLabels[viewModeOptionIndex]}}</text>
          </view>
        </view>
        <view class="sa-light-action-arrow">❯</view>
      </view>

      <view class="admin-dashboard-divider"></view>

      <!-- 系统运维与性能：清理缓存是高频操作，直接展示；一键加速系统/DEV 模拟开通
           是低频运维项，折叠进"更多系统工具"，点击展开，避免零散提示块常驻占地方 -->
      <text class="admin-dashboard-section-title">⚙️ 系统运维与性能</text>
      <view class="sa-light-action-row" bindtap="onTriggerClearCache" hover-class="ui-hover">
        <view class="sa-action-left">
          <text class="sa-action-icon">🧹</text>
          <view class="sa-action-text-col">
            <text class="sa-light-action-title">清理缓存</text>
            <text class="sa-action-desc sa-light-desc" wx:if="{{cacheSizeText}}">当前已用 {{cacheSizeText}}</text>
          </view>
        </view>
        <view class="sa-light-action-arrow">❯</view>
      </view>

      <view class="sa-light-action-row" bindtap="onToggleAdminMoreTools" hover-class="ui-hover">
        <view class="sa-action-left">
          <text class="sa-action-icon">⋯</text>
          <text class="sa-light-action-title">更多系统工具</text>
        </view>
        <view class="sa-light-action-arrow">{{showAdminMoreTools ? '︿' : '﹀'}}</view>
      </view>

      <block wx:if="{{showAdminMoreTools}}">
        <view class="sa-light-action-row {{createIndexesRunning ? 'sa-light-action-disabled' : ''}}"
              hover-class="{{createIndexesRunning ? '' : 'ui-hover'}}"
              bindtap="onTriggerCreateIndexes">
          <view class="sa-action-left">
            <text class="sa-action-icon">⚡</text>
            <text class="sa-light-action-title">{{createIndexesRunning ? '系统加速中，请稍候…' : '一键加速系统'}}</text>
          </view>
          <view class="sa-light-action-arrow">{{createIndexesRunning ? '⏳' : '❯'}}</view>
        </view>

        <!-- 🧪 Dev/Debug 专用：模拟开通专业版，仅供功能自测，不接入真实支付/计费流程 -->
        <view class="sa-dev-tool-row" wx:if="{{!subscriptionInfo.isActive}}" bindtap="onOpenProSubscriptionModal">
          <text class="sa-dev-tool-tag">DEV</text>
          <text class="sa-dev-tool-text">体验 / 模拟开通专业版（测试用）</text>
        </view>
      </block>
    </view>

    <!-- 🌸☀️ 文化与平台监督底座：全角色统一入口，替代此前分散在家人/店长/大家长
         各自卡片里的重复文化入口，与"关于本站/阳光账本"合并成同一组列表行——
         复用现有 .list-group-label/.ui-card-wrapper.action-list-container/
         .action-item-cell 视觉样式，不新增类。cultureTitle/aboutTitle 由
         initMinePage 内 computeOrgDisplayCopy() 按门店真实 orgType 计算，
         已经是雨花斋/社区助餐/通用机构三档区分文案，比单纯 isYuhuazhai 二选一
         更贴合当前多租户去品牌化方向，两个入口本身对角色无感知，全角色可见 -->
    <view class="list-group-label">文化与平台监督</view>
    <view class="ui-card-wrapper action-list-container">
      <view class="action-item-cell" hover-class="ui-hover" bindtap="onGoToCultureFull">
        <view class="item-left">
          <text class="manager-only-emoji">🌸</text>
          <text class="item-text">{{cultureTitle}}</text>
        </view>
        <view class="item-arrow">❯</view>
      </view>

      <view class="action-item-cell" hover-class="ui-hover" bindtap="onGoToAbout">
        <view class="item-left">
          <text class="manager-only-emoji">☀️</text>
          <text class="item-text">{{aboutTitle}}</text>
        </view>
        <view class="item-arrow">❯</view>
      </view>
    </view>

    <!-- 🏛️ 底部账号操作：全角色可见，去掉原 hasPrivilege 限制——家人/纯义工
         之前完全看不到这个入口，现在也能点开；processRoleAudit 云函数
         releaseSelf 在调用者没有任何已持有角色时会优雅返回"当前身份无需卸任"
         提示，不会崩溃，服务端已确认安全 -->
    <view class="list-group-label">账号</view>
    <view class="ui-card-wrapper action-list-container">
      <view class="action-item-cell danger-cell" hover-class="ui-hover" bindtap="onReleaseUserRole">
        <view class="item-left">
          <view class="item-icon-svg icon-svg-release"></view>
          <text class="item-text danger-text">切换身份 / 退出当前绑定</text>
        </view>
        <view class="item-arrow">❯</view>
      </view>
    </view>

    <!-- 🛠️ 义工现场服务工具：已平铺内嵌到 Tab1 首页「义工现场服务工具」金刚区
         （index.wxml home-vt-* 系列 + daily-menu-modal/material-usage-modal 组件），
         个人页不再重复展示这一组入口，避免功能冗余。daily-menu-modal/
         material-usage-modal 组件仍挂载在本页（见下方），供「我的提交与数据」里
         "重新修改并提交"通过 selectComponent 调用 presetForm() 复用 -->

    <!-- 分组五：系统/管理权限 —— 超级管理员 + 家长 + 平台管理员（SaaS 运维方）
         可见的开发者工具箱。前三项仍是 super_admin 专属操作，各自补上独立的
         wx:if；最后一项"会员开通/续费管理"三种身份都可见——容器本身的显隐条件
         相应放宽，否则家长/平台管理员永远走不到这个入口。
         🐛 根因修复：这里全部改用 isRealSuperAdmin（服务端真实角色，见
         initMinePage 的 trueServerRole），不再用 isSuperAdmin（会被"视角切换
         预览"降级、也会被 store-picker 角色胶囊的手动切换覆盖）——工具箱是
         超管自己的管理工具，不是"正在预览的内容"，不该因为切换视角/切换过
         门店角色就消失 -->
    <!-- ╔══════════════════════════════════════════════════════════════╗
         ║  工具箱（大家长：仅会员管理 / 超管专属操作见上方的                ║
         ║  sa-command-card + admin-dashboard-card「超级管理员工具箱」，    ║
         ║  不在此重复）                                                   ║
         ╚══════════════════════════════════════════════════════════════╝ -->

    <!-- ▸ 平台管理员精简版（大家长的同类入口已合并至 patriarch-panel-card 管理中心末尾） -->
    <view class="ui-card-wrapper admin-developer-section"
          wx:if="{{isPlatformAdmin && !isRealSuperAdmin && !isPatriarch}}">
      <view class="admin-divider">平台工具</view>
      <view class="action-item-cell" hover-class="ui-hover" bindtap="onGoToPlatformAdminTenants">
        <view class="item-left">
          <text class="manager-only-emoji">💳</text>
          <text class="item-text">会员开通 / 续费管理</text>
        </view>
        <view class="item-arrow">❯</view>
      </view>
    </view>

  </view>

  <!-- 🏛️ 切换身份面板：账号兼任多个身份（switchableRoleOptions 非空）时，
       点击"切换身份/退出当前绑定"优先展示这个面板——列出可直接切换过去的
       其他身份（纯客户端展示态切换，不改动服务端数据）+ 底部"退出当前门店
       绑定"入口（转入下面的卸任确认弹窗，走真正的服务端卸任）。只有单一
       身份时 onReleaseUserRole 会跳过本面板，直接打开卸任确认弹窗 -->
  <view class="switch-identity-modal-mask {{showSwitchIdentityModal ? 'show' : ''}}" catchtouchmove="stopPropagation" bindtap="onCloseSwitchIdentityModal">
    <view class="switch-identity-card" catchtap="stopPropagation">
      <view class="switch-identity-header">
        <text class="switch-identity-title">切换身份</text>
        <text class="switch-identity-close" bindtap="onCloseSwitchIdentityModal">✕</text>
      </view>
      <text class="switch-identity-desc">您在【{{currentStoreName || '当前门店'}}】同时持有多个身份，可直接切换查看视角</text>

      <view class="switch-identity-option-list">
        <view
          class="switch-identity-option"
          wx:for="{{switchableRoleOptions}}"
          wx:key="role"
          catchtap="onSwitchToRole"
          data-role="{{item.role}}"
        >
          <text class="option-text">切换至 {{item.label}}</text>
          <text class="option-arrow">❯</text>
        </view>
      </view>

      <view class="switch-identity-divider"></view>

      <button class="btn-exit-binding" bindtap="onOpenReleaseConfirmModal">退出当前门店绑定</button>
    </view>
  </view>

  <!-- 🌟 管理视角切换半屏弹窗：替换原生 picker 绿色系统弹窗，卡片式六选一
       （全景/大家长/店长/财务/义工/家人），当前选中项主题金色高亮 + Check 图标。
       点击卡片仅暂存 viewModeModalPendingMode，须点"确认切换"才真正生效——与
       switch-identity-modal-mask 同一套"常驻 DOM + show 类切换"方案 -->
  <view class="role-switch-modal-mask {{showViewModeModal ? 'show' : ''}}" catchtouchmove="stopPropagation" bindtap="onCloseViewModeModal">
    <!-- 标准三段式弹窗结构：card 自身 position: fixed; bottom: 0 独立贴底 +
         z-index: 9999（高于自定义 tabBar 的 998，见 .role-switch-modal-card
         注释），不再依赖 mask 的 flex 布局来定位，避免被 tabBar 盖住；card 自带
         120rpx + 安全区的 padding-bottom，进一步避让 tabBar 实际高度。
         内部仍是 max-height 兜底 + flex 列布局：Header/Footer 各自
         flex-shrink: 0 固定占位，Body 是唯一的可滚动区（flex: 1 + min-height: 0 +
         max-height），确认按钮永远不会被卡片列表挤出可视区 -->
    <view class="role-switch-modal-card" catchtap="stopPropagation">
      <!-- 1. Header (固定) -->
      <view class="role-switch-modal-header">
        <text class="title">管理视角切换</text>
        <text class="reset-link" bindtap="onResetToDefaultViewMode">恢复默认视角</text>
        <view class="close-btn" bindtap="onCloseViewModeModal">×</view>
      </view>
      <text class="role-switch-modal-desc">预览超级管理员在各角色下看到的界面与操作入口，仅展示层模拟，不改变云端真实角色</text>

      <!-- 2. Body (单独可滚动区) -->
      <scroll-view scroll-y class="role-switch-modal-body">
        <view
          class="role-switch-option-card {{item.mode === viewModeModalPendingMode ? 'active' : ''}}"
          wx:for="{{viewModeCards}}"
          wx:key="mode"
          bindtap="onSelectViewModeCard"
          data-mode="{{item.mode}}"
        >
          <view class="role-switch-option-icon">{{item.icon}}</view>
          <view class="role-switch-option-info">
            <text class="role-switch-option-label">{{item.label}}</text>
            <text class="role-switch-option-desc">{{item.desc}}</text>
          </view>
          <view class="role-switch-option-check" wx:if="{{item.mode === viewModeModalPendingMode}}">✓</view>
        </view>
      </scroll-view>

      <!-- 3. Footer (绝对固定在底部)：改用 <view> 而非原生 <button>——原生
           button 的默认内边距/行高/伪装边框在部分机型上会跟自定义 flex 居中
           样式打架，出现"按钮有背景色但文字不可见"的诡异表现；view + bindtap
           在交互上完全等价，样式却完全由自己掌控 -->
      <view class="role-switch-modal-footer">
        <view class="role-switch-btn-confirm" bindtap="onConfirmViewModeModal">确认切换至 {{viewModeModalPendingLabel || '当前视角'}}</view>
      </view>
    </view>
  </view>

  <!-- 卸任特权 Warning 弹窗 -->
  <view class="release-modal-mask {{showReleaseModal ? 'show' : ''}}" catchtouchmove="stopPropagation" bindtap="onCancelReleaseModal">
    <view class="release-modal-card" catchtap="stopPropagation">
      <view class="release-warning-icon">⚠️</view>

      <text class="release-modal-title">确认退出 <text class="release-role-highlight">「{{releaseRoleLabel}}」</text> 身份？</text>

      <view class="release-consequence-list">
        <view class="release-consequence-item">
          <text class="bullet-dot">•</text>
          <text class="bullet-text">立即失去【{{currentStoreName || '当前门店'}}】「{{releaseRoleLabel}}」身份对应的写账 / 审账权能</text>
        </view>
        <view class="release-consequence-item">
          <text class="bullet-dot">•</text>
          <text class="bullet-text">若您还兼任其他身份，将自动平滑切换为其中权限最高的一档；否则重置为未绑定门店状态</text>
        </view>
        <view class="release-consequence-item">
          <text class="bullet-dot">•</text>
          <text class="bullet-text">新负责人可使用邀请码重新绑定该门店身份</text>
        </view>
        <view class="release-consequence-item danger">
          <text class="bullet-dot">•</text>
          <text class="bullet-text">该操作不可逆，请务必确认后再操作</text>
        </view>
      </view>

      <!-- 🌟 工时保留承诺：与上方"失去权能"的警示形成清晰对比，单独一块浅绿底色
           展示，避免用户误以为退出身份连累积的护持记录也会被清空 -->
      <view class="release-safe-notice">
        <text class="safe-icon">✅</text>
        <text class="safe-text">您的护持工时、打卡记录与其他持有身份完全不受影响，不会被清除</text>
      </view>

      <view class="release-modal-footer">
        <button class="release-btn-cancel" bindtap="onCancelReleaseModal">我再想想</button>
        <button class="release-btn-confirm" bindtap="onConfirmReleaseRole" loading="{{isReleasing}}" disabled="{{isReleasing}}">确认退出</button>
      </view>
    </view>
  </view>

  <!-- 🌐 超管专属【门店选择与搜索】弹窗：实时搜索框（名称/拼音/城市）+ 固定首项
       【全国总览】+ 全国活跃门店列表，复用 feedback-sheet-* 半屏抽屉视觉规范 -->
  <view class="feedback-sheet-backdrop feedback-admin-sheet-backdrop {{showStorePickerModal ? 'show' : ''}}" catchtouchmove="stopPropagation" wx:if="{{showStorePickerModal}}" bindtap="onCloseStorePickerModal">
    <view class="feedback-sheet-panel feedback-admin-sheet-panel" catchtap="stopPropagation">
      <view class="feedback-sheet-drag-handle"></view>

      <view class="feedback-sheet-header">
        <view class="feedback-sheet-header-text">
          <text class="feedback-sheet-title">📍 门店选择与搜索</text>
          <text class="feedback-sheet-subtitle">选择具体门店进入单店巡检视角</text>
        </view>
        <view class="feedback-sheet-close" bindtap="onCloseStorePickerModal">✕</view>
      </view>

      <!-- 实时搜索框：支持按名称/拼音/城市搜索，见 matchStoreSearchKeyword -->
      <view class="mm-search-bar">
        <text class="mm-search-icon">🔍</text>
        <input class="mm-search-input"
               placeholder="搜索门店名称、拼音或城市..."
               placeholder-class="mm-search-placeholder"
               value="{{storePickerSearchText}}"
               bindinput="onStorePickerSearchInput" />
      </view>

      <scroll-view scroll-y class="feedback-admin-list-scroll">
        <!-- 🌐 固定首项：全国总览，不参与搜索过滤，始终展示在列表最顶端 -->
        <view class="sp-store-item sp-national-item {{!currentInspectStoreId ? 'active' : ''}}" bindtap="onSelectNationalOverview">
          <view class="sp-item-main">
            <text class="sp-item-name">🌐 全国总览</text>
            <text class="sp-item-sub">聚合全国门店数据</text>
          </view>
          <text wx:if="{{!currentInspectStoreId}}" class="sp-item-check">✓</text>
        </view>

        <view class="feedback-admin-loading" wx:if="{{storePickerLoading}}">
          <text>加载门店列表中…</text>
        </view>
        <view class="feedback-admin-empty" wx:elif="{{storePickerFilteredStores.length === 0}}">
          <text wx:if="{{storePickerSearchText}}">未找到匹配门店</text>
          <text wx:else>暂无活跃门店</text>
        </view>
        <block wx:else>
          <view class="sp-store-item {{item.storeId === currentInspectStoreId ? 'active' : ''}}"
                wx:for="{{storePickerFilteredStores}}"
                wx:key="storeId"
                bindtap="onSelectInspectStore"
                data-store-id="{{item.storeId}}"
                data-store-name="{{item.storeName}}">
            <view class="sp-item-main">
              <text class="sp-item-name">{{item.storeName}}</text>
              <text class="sp-item-sub" wx:if="{{item.province || item.city}}">{{item.province}}{{item.city}}</text>
            </view>
            <text wx:if="{{item.storeId === currentInspectStoreId}}" class="sp-item-check">✓</text>
          </view>
        </block>

        <view class="fa-safe-area-spacer"></view>
      </scroll-view>
    </view>
  </view>

  <!-- 🎖️ 徽章详情 Modal：点击核心荣誉墙任一枚徽章展示名称/图标/解锁条件/进度条，
       复用 certificate-modal-* 同一套弹窗壳视觉规范 -->
  <view class="certificate-modal-mask" wx:if="{{showBadgeDetailModal}}" catchtouchmove="stopPropagation" bindtap="onCloseBadgeDetailModal">
    <view class="certificate-modal-card badge-detail-card" catchtap="stopPropagation">
      <view class="certificate-modal-header">
        <view class="certificate-modal-close" bindtap="onCloseBadgeDetailModal">✕</view>
      </view>

      <view class="badge-detail-circle {{selectedBadge.unlocked ? 'unlocked glow-anim' : 'locked'}}">
        <text class="badge-detail-emoji">{{selectedBadge.emoji}}</text>
      </view>
      <text class="badge-detail-name">{{selectedBadge.name}}</text>
      <text class="badge-detail-status unlocked" wx:if="{{selectedBadge.unlocked}}">✅ 已解锁</text>
      <text class="badge-detail-status" wx:else>🔒 未解锁（{{selectedBadge.progressPercent}}%）</text>
      <!-- 🎖️ 勋章寓意：与解锁条件分两行展示，寓意在前，条件在后 -->
      <text class="badge-detail-meaning">{{selectedBadge.meaning}}</text>
      <text class="badge-detail-desc">{{selectedBadge.unlockDesc}}</text>

      <view class="badge-detail-progress-track">
        <view class="badge-detail-progress-fill" style="width: {{selectedBadge.progressPercent}}%;"></view>
      </view>
      <text class="badge-detail-progress-text">{{selectedBadge.progressStatusText}}</text>

      <!-- 🌟 已点亮荣誉可分享；未点亮不展示该按钮，避免诱导分享一份还没达成的成就 -->
      <button
        wx:if="{{selectedBadge.unlocked}}"
        class="badge-detail-share-btn"
        open-type="share"
      >📤 分享荣誉</button>
    </view>
  </view>

  <!-- 🌟 荣誉证书 Modal：义工/家人共用同一个弹窗壳（遮罩 + 卡片 + 关闭按钮），
       正文按角色分流——义工是 Canvas 绘制的长图证书（可保存相册），家人是纯 WXML
       文本证书（系统没有家人的护持统计口径，也不需要生成图片）。
       🐛 此前家人版是独立的一份"爱心感谢卡"弹窗（.gratitude-modal-*），与本证书
       弹窗视觉高度相似，两套并存容易让人以为"重复渲染了两张证书卡片"——现在合并
       为一个弹窗，彻底消除这种重叠观感 -->
  <view class="certificate-modal-mask" wx:if="{{showCertificateModal}}" catchtouchmove="stopPropagation" bindtap="onCloseCertificateModal">
    <view class="certificate-modal-card" catchtap="stopPropagation">
      <!-- 标题文字已删除：义工版标题直接画在证书图片本体里，家人版正文自带称谓，
           这里再放一遍"爱心护持荣誉证书"文字反而是重复表述，只保留关闭按钮 -->
      <view class="certificate-modal-header">
        <view class="certificate-modal-close" bindtap="onCloseCertificateModal">✕</view>
      </view>

      <!-- 家人分支：纯文本证书，无 Canvas、无工时统计、无二维码。古典边框 + 落款
           印鑑营造仪式感，纹饰复用 family-care-card 头部同一对镜像莲花图标 -->
      <view class="certificate-family-body" wx:if="{{isFamily}}">
        <view class="cf-title-row">
          <view class="header-icon-svg icon-svg-flower"></view>
          <text class="cf-title">📜 爱心护持荣誉证书</text>
          <view class="header-icon-svg icon-svg-flower flip-x"></view>
        </view>

        <view class="cf-inner-border">
          <text class="certificate-family-icon">🌸</text>

          <view class="cert-salutation">尊敬的家人【{{userNickName}}】：</view>
          <view class="cert-paragraph">{{isYuhuazhai ? '感谢您对雨花斋公益事业的倾心关怀与倾心护持。一碗热饭，温暖世间。雨花斋因您的守护而更具温情！' : '感谢您对公益事业的倾心关怀与护持。一碗热饭，温暖世间。您的守护让这个大家庭更有力量！'}}</view>
          <view class="cert-paragraph">特发此证，以兹感谢。</view>

          <view class="cf-signature-row">
            <view class="cf-seal">
              <text class="cf-seal-line">{{isYuhuazhai ? '雨花' : '公益'}}</text>
              <text class="cf-seal-line">爱心</text>
            </view>
            <view class="cf-signature-text">
              <text class="cf-sign-line">{{isYuhuazhai ? '雨花斋公益团队' : (currentStoreName || '公益志愿团队')}}</text>
              <text class="cf-sign-line">{{certificateIssueDate}}</text>
            </view>
          </view>
        </view>
      </view>

      <button wx:if="{{isFamily}}" class="certificate-family-save-btn" bindtap="onSaveCertificateImage">
        🖼️ 保存证书海报
      </button>

      <!-- 义工分支：原有 Canvas 证书生成流程，保留工时/天数统计文案 -->
      <block wx:else>
        <view class="certificate-canvas-wrap">
          <!-- Canvas 本身始终挂载在 DOM 里供 selectorQuery 查询，绘制完成后用生成的图片
               覆盖显示在它上面——2D Canvas 无法直接作为图片展示/长按保存，必须转成图片。
               🐛 双重渲染修复：canvas 与 image 尺寸口径不完全一致（canvas 是固定 340×480px，
               image 是按容器宽度等比缩放），生成完成后 canvas 边缘可能在 image 周围露出一圈
               像素，观感上像"叠了两张证书"——图片就绪后直接把 canvas 从渲染树里摘掉，
               保证画面上任何时刻都只有一张完整证书可见 -->
          <canvas wx:if="{{!certificateTempFilePath}}" type="2d" id="certificateCanvas" class="certificate-canvas" style="width: 340px; height: 480px;"></canvas>
          <image wx:if="{{certificateTempFilePath}}" class="certificate-preview-img" src="{{certificateTempFilePath}}" mode="widthFix" show-menu-by-longpress="{{true}}" bindtap="onPreviewCertificateImage" binderror="onCertificateLoadError" />
          <view class="certificate-loading-mask" wx:if="{{certificateGenerating}}" catchtouchmove="stopPropagation">
            <text>正在生成证书…</text>
          </view>
        </view>

        <button class="certificate-save-btn {{(certificateGenerating || !certificateTempFilePath) ? 'certificate-save-btn-disabled' : ''}}" bindtap="onSaveCertificateToAlbum" disabled="{{certificateGenerating || !certificateTempFilePath}}">
          💾 保存证书分享朋友圈
        </button>
      </block>
    </view>
  </view>

  <!-- 📮 爱心意见箱：小程序原生半屏弹窗，替代微信官方 open-type="feedback"，
       提交内容落在本项目自己的 feedback_submissions 集合，店长/运营可查阅 -->
  <view class="feedback-sheet-backdrop {{showFeedbackModal ? 'show' : ''}}" catchtouchmove="stopPropagation" wx:if="{{showFeedbackModal}}" bindtap="onCloseFeedbackModal">
    <view class="feedback-sheet-panel" catchtap="stopPropagation">
      <view class="feedback-sheet-drag-handle"></view>

      <view class="feedback-sheet-header">
        <view class="feedback-sheet-header-text">
          <text class="feedback-sheet-title">📮 爱心意见箱</text>
          <text class="feedback-sheet-subtitle">感恩您的倾心护持，共同守护{{isYuhuazhai ? '雨花温情' : '公益温情'}}</text>
        </view>
        <view class="feedback-sheet-close" bindtap="onCloseFeedbackModal">✕</view>
      </view>

      <view class="feedback-modal-tab-row">
        <view
          class="feedback-modal-tab {{feedbackModalTab === 'submit' ? 'active' : ''}}"
          bindtap="onSwitchFeedbackModalTab"
          data-tab="submit"
        >✍️ 提交建议</view>
        <view
          class="feedback-modal-tab {{feedbackModalTab === 'mine' ? 'active' : ''}}"
          bindtap="onSwitchFeedbackModalTab"
          data-tab="mine"
        >
          💌 我的反馈与回复
          <view class="badge feedback-modal-tab-badge" wx:if="{{unreadReplyCount > 0}}">{{unreadReplyCount}}</view>
        </view>
      </view>

      <block wx:if="{{feedbackModalTab === 'submit'}}">
        <view class="feedback-type-row">
          <view
            class="feedback-type-pill {{feedbackSelectedType === item.key ? 'active' : ''}}"
            wx:for="{{feedbackTypeOptions}}"
            wx:key="key"
            bindtap="onSelectFeedbackType"
            data-type="{{item.key}}"
          >{{item.label}}</view>
        </view>

        <textarea
          class="feedback-content-textarea"
          placeholder="请输入您的宝贵意见或建议..."
          placeholder-class="feedback-textarea-placeholder"
          value="{{feedbackContent}}"
          bindinput="onFeedbackContentInput"
          maxlength="500"
          auto-height
        ></textarea>

        <button class="feedback-submit-btn {{feedbackSubmitting ? 'feedback-submit-btn-disabled' : ''}}" bindtap="onSubmitFeedback" loading="{{feedbackSubmitting}}" disabled="{{feedbackSubmitting}}">📮 提交宝贵意见</button>
      </block>

      <!-- 💌 我的反馈与回复：家人自己的历史提交 + 团队回复，Tab 内自成一个可滚动列表 -->
      <scroll-view scroll-y class="my-feedback-list-scroll" wx:if="{{feedbackModalTab === 'mine'}}">
        <view class="feedback-admin-loading" wx:if="{{myFeedbackLoading}}">
          <text>加载中...</text>
        </view>

        <view class="feedback-admin-empty" wx:if="{{!myFeedbackLoading && myFeedbackList.length === 0}}">
          <text>暂无提交记录，快去提交您的第一条爱心意见吧</text>
        </view>

        <view class="my-feedback-item" wx:for="{{myFeedbackList}}" wx:key="_id">
          <view class="fa-item-header">
            <text class="fa-item-type-tag">{{item.typeLabel}}</text>
            <text class="fa-item-time">🗓️ {{item.createTimeStr}}</text>
          </view>
          <text class="fa-item-content">{{item.content}}</text>

          <view class="fa-reply-display my-feedback-reply" wx:if="{{item.replyContent}}">
            <text class="fa-reply-display-label">💬 店长回复{{item.replyByName ? '（' + item.replyByName + '）' : ''}} · {{item.replyTimeStr}}</text>
            <text class="fa-reply-display-text">{{item.replyContent}}</text>
          </view>
          <text class="my-feedback-pending-tag" wx:else>⏳ 团队审阅中</text>
        </view>
        <view class="fa-safe-area-spacer"></view>
      </scroll-view>
    </view>
  </view>

  <!-- 📮 爱心意见箱管理：店长/家长/超管审阅入口，与提交侧共用同一套半屏弹窗视觉语言 -->
  <view class="feedback-sheet-backdrop feedback-admin-sheet-backdrop {{showFeedbackAdminModal ? 'show' : ''}}" catchtouchmove="stopPropagation" wx:if="{{showFeedbackAdminModal}}" bindtap="onCloseFeedbackAdminModal">
    <view class="feedback-sheet-panel feedback-admin-sheet-panel" catchtap="stopPropagation">
      <view class="feedback-sheet-drag-handle"></view>

      <view class="feedback-sheet-header">
        <view class="feedback-sheet-header-text">
          <text class="feedback-sheet-title">📮 爱心意见箱管理</text>
          <text class="feedback-sheet-subtitle">家人提交的宝贵意见，回复或标记处理后自动更新角标</text>
        </view>
        <view class="feedback-sheet-close" bindtap="onCloseFeedbackAdminModal">✕</view>
      </view>

      <!-- ⏳✅ Tab 切换：待处理 / 已处理 -->
      <view class="fa-tab-bar">
        <view class="fa-tab {{feedbackAdminTab === 'pending' ? 'active' : ''}}" bindtap="onSwitchFeedbackAdminTab" data-tab="pending">
          <text>⏳ 待处理</text>
          <text class="fa-tab-badge" wx:if="{{pendingFeedbackCount > 0}}">{{pendingFeedbackCount}}</text>
        </view>
        <view class="fa-tab {{feedbackAdminTab === 'handled' ? 'active' : ''}}" bindtap="onSwitchFeedbackAdminTab" data-tab="handled">
          <text>✅ 已处理</text>
        </view>
      </view>

      <scroll-view scroll-y class="feedback-admin-list-scroll">
        <view class="feedback-admin-loading" wx:if="{{feedbackAdminLoading}}">
          <text>加载中...</text>
        </view>

        <!-- 待处理 Tab -->
        <block wx:if="{{!feedbackAdminLoading && feedbackAdminTab === 'pending'}}">
          <view class="feedback-admin-empty" wx:if="{{feedbackAdminPendingList.length === 0}}">
            <text>🎉 暂无待处理意见</text>
          </view>
          <view class="feedback-admin-item" wx:for="{{feedbackAdminPendingList}}" wx:key="_id">
            <view class="fa-item-header">
              <text class="fa-item-nickname">{{item.nickName || '匿名家人'}}</text>
              <text class="fa-item-type-tag">{{item.typeLabel}}</text>
            </view>
            <text class="fa-item-time">🗓️ {{item.createTimeStr}}</text>
            <text class="fa-item-content">{{item.content}}</text>
            <view class="fa-item-actions">
              <button class="fa-item-handle-btn {{item.handling ? 'fa-item-handle-btn-disabled' : ''}}" bindtap="onMarkFeedbackHandled" data-id="{{item._id}}" disabled="{{item.handling}}">✅ 标记已处理</button>
              <button class="fa-item-reply-btn fa-feedback-reply-btn" bindtap="onToggleFeedbackReplyBox" data-id="{{item._id}}">{{feedbackReplyingId === item._id ? '收起' : '💬 回复家人'}}</button>
            </view>
            <view class="fa-reply-box" wx:if="{{feedbackReplyingId === item._id}}">
              <textarea class="fa-reply-textarea" placeholder="输入给这位家人的回复..." value="{{feedbackReplyContent}}" bindinput="onFeedbackReplyInput" maxlength="500" auto-height></textarea>
              <button class="fa-reply-submit-btn {{feedbackReplySubmitting ? 'fa-reply-submit-btn-disabled' : ''}}" bindtap="onSubmitFeedbackReply" loading="{{feedbackReplySubmitting}}" disabled="{{feedbackReplySubmitting}}">发送回复</button>
            </view>
          </view>
        </block>

        <!-- 已处理 Tab -->
        <block wx:if="{{!feedbackAdminLoading && feedbackAdminTab === 'handled'}}">
          <view class="feedback-admin-empty" wx:if="{{feedbackAdminHandledList.length === 0}}">
            <text>暂无已处理意见</text>
          </view>
          <view class="feedback-admin-item is-handled" wx:for="{{feedbackAdminHandledList}}" wx:key="_id">
            <view class="fa-item-header">
              <text class="fa-item-nickname">{{item.nickName || '匿名家人'}}</text>
              <text class="fa-item-type-tag">{{item.typeLabel}}</text>
            </view>
            <text class="fa-item-time">🗓️ {{item.createTimeStr}}</text>
            <text class="fa-item-content">{{item.content}}</text>
            <!-- 有回复内容：简洁展示回复正文 + 回复人/时间元信息 -->
            <view class="fa-reply-display" wx:if="{{item.replyContent}}">
              <text class="fa-reply-display-text">💬 回复：{{item.replyContent}}</text>
              <text class="fa-reply-display-meta" wx:if="{{item.replyByName || item.replyTimeStr}}">— {{item.replyByName}}{{item.replyTimeStr ? ' · ' + item.replyTimeStr : ''}}</text>
            </view>
            <!-- 仅标记处理（无回复内容） -->
            <text class="fa-item-handled-tag" wx:else>✅ 已处理</text>
          </view>
        </block>

        <view class="fa-safe-area-spacer"></view>
      </scroll-view>
    </view>
  </view>

  <!-- 🍱 登记今日菜单与人数 / 🌾 登记物资消耗与报损：表单唯一实现已提炼为独立
       自定义组件（daily-menu-modal / material-usage-modal，与首页共用）。入口
       已迁移到首页，本页仅供 onTapMyVolunteerSubmissionItem "重新修改并提交"
       通过 selectComponent 调用 presetForm() 复用 -->
  <daily-menu-modal
    id="dailyMenuModal"
    visible="{{showDailyMenuModal}}"
    isAutoApproveRole="{{isStoreAdmin}}"
    bind:close="onCloseDailyMenuModal"
  />
  <material-usage-modal
    id="materialUsageModal"
    visible="{{showMaterialUsageModal}}"
    isAutoApproveRole="{{isStoreAdmin}}"
    bind:close="onCloseMaterialUsageModal"
  />

  <!-- 📄 义工版【我的餐报提交记录】：volunteer_submissions 里"我自己"的菜单/物资
       原始记录，与店长/财务在 history 页看到的正式台账历史彻底隔离 -->
  <view class="feedback-sheet-backdrop feedback-admin-sheet-backdrop {{showMyVolunteerSubmissionsModal ? 'show' : ''}}" catchtouchmove="stopPropagation" wx:if="{{showMyVolunteerSubmissionsModal}}" bindtap="onCloseMyVolunteerSubmissionsModal">
    <view class="feedback-sheet-panel feedback-admin-sheet-panel" catchtap="stopPropagation">
      <view class="feedback-sheet-drag-handle"></view>

      <view class="feedback-sheet-header">
        <view class="feedback-sheet-header-text">
          <text class="feedback-sheet-title">📝 我的提交与数据</text>
          <text class="feedback-sheet-subtitle">餐报/物资提交历史与本月统计</text>
        </view>
        <view class="feedback-sheet-close" bindtap="onCloseMyVolunteerSubmissionsModal">✕</view>
      </view>

      <!-- 📊 个人月度统计摘要：合并原"我的统计数据"入口——只做轻量摘要（基于本次
           已拉取的 myVolunteerSubmissionsList 按当月 dateString 前缀客户端过滤计数），
           完整的门店/多维度统计仍跳转 onGoToStatistics 对应的统计页，不在这里重复实现 -->
      <view class="my-vs-monthly-stats">
        <view class="my-vs-monthly-stats-row">
          <text class="my-vs-monthly-stats-title">📊 本月提交 {{monthlySubmissionStats.total}} 次</text>
          <view class="my-vs-monthly-stats-link" bindtap="onGoToStatistics">查看完整统计 ❯</view>
        </view>
        <text class="my-vs-monthly-stats-detail">✅ 已采纳 {{monthlySubmissionStats.approved}} · ⏳ 待确认 {{monthlySubmissionStats.pending}} · ❌ 已驳回 {{monthlySubmissionStats.rejected}}</text>
      </view>

      <scroll-view scroll-y class="feedback-admin-list-scroll">
        <view class="feedback-admin-loading" wx:if="{{myVolunteerSubmissionsLoading}}">
          <text>加载中...</text>
        </view>

        <view class="feedback-admin-empty" wx:if="{{!myVolunteerSubmissionsLoading && myVolunteerSubmissionsList.length === 0}}">
          <text>暂无提交记录，去登记今天的菜单人数或物资消耗吧</text>
        </view>

        <view class="my-feedback-item {{item.status === 'rejected' ? 'tappable rejected' : ''}}" wx:for="{{myVolunteerSubmissionsList}}" wx:key="_id" data-index="{{index}}" bindtap="onTapMyVolunteerSubmissionItem">
          <view class="fa-item-header">
            <text class="fa-item-type-tag">{{item.type === 'menu' ? '🍱 用餐人数' : '🌾 物资消耗'}}</text>
            <!-- 🐛 根因修复：这份 volunteer_submissions 记录的 dateString 由服务端
                 handleSubmit 兜底成提交当天（前端从不单独传别的日期），createTimeStr
                 也是同一时刻生成的，两者永远是同一天，此前"dateString · createTimeStr"
                 拼接必然产生"2026-07-29 · 2026-07-29 22:46"这种年月日重复展示——
                 createTimeStr 本身已经是完整的"YYYY-MM-DD HH:mm"，直接展示它即可 -->
            <text class="fa-item-time">🗓️ {{item.createTimeStr}}</text>
          </view>

          <block wx:if="{{item.type === 'menu'}}">
            <text class="fa-item-content" wx:if="{{item.mealStatus === 'closed'}}">今日休餐</text>
            <text class="fa-item-content fa-item-core-data" wx:else>早: <text class="highlight-num">{{item.breakfastCount || 0}}</text> 人 | 午: <text class="highlight-num">{{item.lunchCount || 0}}</text> 人 | 晚: <text class="highlight-num">{{item.dinnerCount || 0}}</text> 人</text>
            <text class="fa-item-content fa-item-note" wx:if="{{item.menuNote}}">备注：{{item.menuNote}}</text>
          </block>
          <block wx:else>
            <text class="fa-item-content fa-item-core-data">米: <text class="highlight-num">{{item.riceCount || 0}}</text>斤 | 面: <text class="highlight-num">{{item.flourCount || 0}}</text>斤 | 油: <text class="highlight-num">{{item.oilCount || 0}}</text>斤 | 菜: <text class="highlight-num">{{item.vegetableCount || 0}}</text>斤</text>
            <text class="fa-item-content fa-item-note" wx:if="{{item.lossNote}}">说明：{{item.lossNote}}</text>
          </block>

          <block wx:if="{{item.status === 'approved'}}">
            <text class="my-vs-status-tag approved">✅ 已采纳入库</text>
            <!-- 🛡️ 已采纳入库的记录已合并进门店账本/库存统计，普通提交人（含店长/家长
                 本人）不再允许自助撤回——按钮替换为"申请冲销"提示语，引导线下联系店长
                 处理；仅超级管理员保留真正的撤回操作，且走二次强确认 + 服务端级联撤销 -->
            <view class="my-vs-action-row">
              <button wx:if="{{isRealSuperAdmin}}" class="delete-submission-btn" catchtap="onRevokeApprovedSubmission" data-index="{{index}}">🗑️ 撤回记录</button>
              <button wx:else class="request-writeoff-btn" catchtap="onRequestWriteOff" data-index="{{index}}">🔒 申请冲销</button>
            </view>
          </block>
          <block wx:elif="{{item.status === 'rejected'}}">
            <text class="my-vs-status-tag rejected">❌ 已驳回</text>
            <text class="my-vs-reject-reason" wx:if="{{item.rejectReason}}">驳回原因：{{item.rejectReason}}</text>
            <view class="my-vs-action-row">
              <button class="resubmit-btn" catchtap="onTapMyVolunteerSubmissionItem" data-index="{{index}}">✏️ 重新修改并提交</button>
              <button class="delete-submission-btn" catchtap="onDeleteMyVolunteerSubmission" data-index="{{index}}">🗑️ 删除</button>
            </view>
          </block>
          <block wx:else>
            <text class="my-vs-status-tag pending">⏳ 待店长确认</text>
            <view class="my-vs-action-row">
              <button class="cancel-pending-btn" catchtap="onDeleteMyVolunteerSubmission" data-index="{{index}}">🗑️ 撤销提交</button>
            </view>
          </block>
        </view>
        <view class="fa-safe-area-spacer"></view>
      </scroll-view>
    </view>
  </view>

  <!-- 📥 待审核的义工餐报与物资：店长/家长/超管审阅入口，与爱心意见箱管理同一套
       半屏弹窗视觉语言 -->
  <view class="feedback-sheet-backdrop feedback-admin-sheet-backdrop {{showVolunteerSubmissionAdminModal ? 'show' : ''}}" catchtouchmove="stopPropagation" wx:if="{{showVolunteerSubmissionAdminModal}}" bindtap="onCloseVolunteerSubmissionAdminModal">
    <view class="feedback-sheet-panel feedback-admin-sheet-panel" catchtap="stopPropagation">
      <view class="feedback-sheet-drag-handle"></view>

      <view class="feedback-sheet-header">
        <view class="feedback-sheet-header-text">
          <text class="feedback-sheet-title">📥 待审核的义工餐报与物资</text>
          <text class="feedback-sheet-subtitle">采纳后自动同步入库，驳回需填写原因</text>
        </view>
        <view class="feedback-sheet-close" bindtap="onCloseVolunteerSubmissionAdminModal">✕</view>
      </view>

      <scroll-view scroll-y class="feedback-admin-list-scroll">
        <view class="feedback-admin-loading" wx:if="{{volunteerSubmissionAdminLoading}}">
          <text>加载中...</text>
        </view>

        <view class="feedback-admin-empty" wx:if="{{!volunteerSubmissionAdminLoading && volunteerSubmissionAdminList.length === 0}}">
          <text>暂无待审核的义工投稿</text>
        </view>

        <view class="feedback-admin-item" wx:for="{{volunteerSubmissionAdminList}}" wx:key="_id">
          <view class="fa-item-header">
            <text class="fa-item-nickname">{{item.nickName || '匿名义工'}}</text>
            <text class="fa-item-type-tag">{{item.type === 'menu' ? '🍱 用餐人数' : '🌾 物资消耗'}}</text>
          </view>
          <!-- 🐛 根因修复：同一条根因——dateString/createTimeStr 永远是同一天，
               去掉重复的日期前缀，只展示完整的 createTimeStr -->
          <text class="fa-item-time">🗓️ {{item.createTimeStr}}</text>

          <block wx:if="{{item.type === 'menu'}}">
            <text class="fa-item-content" wx:if="{{item.mealStatus === 'closed'}}">今日休餐</text>
            <text class="fa-item-content fa-item-core-data" wx:else>早: <text class="highlight-num">{{item.breakfastCount || 0}}</text> 人 | 午: <text class="highlight-num">{{item.lunchCount || 0}}</text> 人 | 晚: <text class="highlight-num">{{item.dinnerCount || 0}}</text> 人</text>
            <text class="fa-item-content fa-item-note" wx:if="{{item.menuNote}}">备注：{{item.menuNote}}</text>
          </block>
          <block wx:else>
            <text class="fa-item-content fa-item-core-data">米: <text class="highlight-num">{{item.riceCount || 0}}</text>斤 | 面: <text class="highlight-num">{{item.flourCount || 0}}</text>斤 | 油: <text class="highlight-num">{{item.oilCount || 0}}</text>斤 | 菜: <text class="highlight-num">{{item.vegetableCount || 0}}</text>斤</text>
            <text class="fa-item-content fa-item-note" wx:if="{{item.lossNote}}">说明：{{item.lossNote}}</text>
          </block>

          <view class="fa-item-actions">
            <button
              class="fa-item-reply-btn {{item.processing ? 'fa-item-reply-btn-disabled' : ''}}"
              bindtap="onOpenRejectModal"
              data-id="{{item._id}}"
              disabled="{{item.processing}}"
            >❌ 驳回</button>
            <button
              class="fa-item-handle-btn {{item.processing ? 'fa-item-handle-btn-disabled' : ''}}"
              bindtap="onApproveSubmission"
              data-id="{{item._id}}"
              disabled="{{item.processing}}"
            >{{item.type === 'menu' ? '✅ 确认采纳' : '✅ 一键采纳入库'}}</button>
          </view>
        </view>
        <view class="fa-safe-area-spacer"></view>
      </scroll-view>
    </view>
  </view>

  <!-- ❌ 驳回原因弹窗：与证书/温情故事等说明弹窗共用 certificate-modal-* 视觉规范 -->
  <view class="certificate-modal-mask" wx:if="{{showRejectSubmissionModal}}" catchtouchmove="stopPropagation" bindtap="onCloseRejectModal">
    <view class="certificate-modal-card" catchtap="stopPropagation">
      <view class="certificate-modal-header">
        <view class="certificate-modal-close" bindtap="onCloseRejectModal">✕</view>
      </view>

      <text class="vt-form-label">驳回原因</text>

      <!-- 🏷️ 快捷驳回标签：点击直接填入常见原因，减少店长手动打字 -->
      <view class="quick-reject-tag-row">
        <text
          class="quick-reject-tag {{rejectSubmissionReason === tag ? 'active' : ''}}"
          wx:for="{{quickRejectReasonTags}}"
          wx:key="*this"
          wx:for-item="tag"
          data-tag="{{tag}}"
          bindtap="onQuickRejectReasonTagTap"
        >{{tag}}</text>
      </view>

      <textarea
        class="feedback-content-textarea"
        placeholder="如：人数填写有误，请核实后重提交"
        placeholder-class="feedback-textarea-placeholder"
        value="{{rejectSubmissionReason}}"
        bindinput="onRejectSubmissionReasonInput"
        maxlength="300"
        auto-height
      ></textarea>

      <button
        class="feedback-submit-btn {{rejectSubmissionSubmitting ? 'feedback-submit-btn-disabled' : ''}}"
        bindtap="onSubmitRejectSubmission"
        loading="{{rejectSubmissionSubmitting}}"
        disabled="{{rejectSubmissionSubmitting}}"
      >确认驳回</button>
    </view>
  </view>

  <!-- 🔑 人员权限管理：本店全部已授权成员（含义工），支持角色互转/移出，店长/大家长/超管可操作 -->
  <view class="feedback-sheet-backdrop feedback-admin-sheet-backdrop {{showMemberManageModal ? 'show' : ''}}" catchtouchmove="stopPropagation" wx:if="{{showMemberManageModal}}" bindtap="onCloseMemberManageModal">
    <view class="feedback-sheet-panel feedback-admin-sheet-panel" catchtap="stopPropagation">
      <view class="feedback-sheet-drag-handle"></view>

      <view class="feedback-sheet-header">
        <view class="feedback-sheet-header-text">
          <text class="feedback-sheet-title">🔑 成员权限管理</text>
          <text class="feedback-sheet-subtitle">本店全部已授权成员 · 点击卡片操作角色调整或移出</text>
        </view>
        <view class="feedback-sheet-close" bindtap="onCloseMemberManageModal">✕</view>
      </view>

      <!-- 搜索框 -->
      <view class="mm-search-bar">
        <text class="mm-search-icon">🔍</text>
        <input class="mm-search-input"
               placeholder="搜索成员姓名或手机号..."
               placeholder-class="mm-search-placeholder"
               value="{{memberManageSearch}}"
               bindinput="onMemberManageSearch" />
      </view>

      <scroll-view scroll-y class="feedback-admin-list-scroll">
        <view class="feedback-admin-loading" wx:if="{{memberManageLoading}}">
          <text>加载中...</text>
        </view>

        <view class="feedback-admin-empty" wx:elif="{{!memberManageLoading && memberManageFilteredList.length === 0}}">
          <text wx:if="{{memberManageSearch}}">未找到匹配的成员</text>
          <text wx:else>暂无可管理的授权成员</text>
        </view>

        <!-- 成员卡片列表 -->
        <view class="mm-member-card" wx:for="{{memberManageFilteredList}}" wx:key="applyId">

          <!-- 上半区：头像 + 姓名/手机/时间 + 角色 Tag -->
          <view class="mm-card-top">
            <view class="mm-avatar-wrap">
              <image wx:if="{{item.avatarUrl && !memberAvatarFailedMap[item.avatarUrl]}}" class="mm-avatar-img" src="{{item.avatarUrl}}" mode="aspectFill" binderror="onMemberAvatarError" data-url="{{item.avatarUrl}}" />
              <view wx:else class="mm-avatar-fallback">{{item.realName[0] || '?'}}</view>
            </view>
            <view class="mm-member-info">
              <text class="mm-member-name">{{item.realName}}</text>
              <text class="mm-member-phone">📱 {{item.phoneMasked}}</text>
              <text class="mm-member-time">🗓️ {{item.timeStr}}</text>
            </view>
            <view class="mm-role-tag mm-role-tag-{{item.roleClass}}">{{item.roleLabel}}</view>
          </view>

          <!-- 下半区操作 ── 情形 A0：目标是超级管理员 → 恒定锁态，任何调用者都不可操作。
               🛡️ 服务端 manageVolunteerBinding 的 MANAGEABLE_ROLES 本就不含
               super_admin（操作会被云函数拒绝），这里只是让 UI 提前如实反映
               这一点，不再展示点了也会失败的按钮 -->
          <view class="mm-locked-notice" wx:if="{{item.role === 'super_admin'}}">
            <text class="mm-locked-icon">👑</text>
            <text class="mm-locked-text">最高管理权限，不可在此调整</text>
          </view>

          <!-- 下半区操作 ── 情形 A1：这一条是当前登录者本人 → 禁止对自己降级/移出，
               避免误操作把自己踢出本店 -->
          <view class="mm-locked-notice" wx:elif="{{item.isSelf}}">
            <text class="mm-locked-icon">🙋</text>
            <text class="mm-locked-text">这是你自己，无法对自己执行此操作</text>
          </view>

          <!-- 下半区操作 ── 情形 A2：大家长操作同级大家长 → 锁态提示（超管本人不受此限制，见下方 wx:else 分支） -->
          <view class="mm-locked-notice" wx:elif="{{item.role === 'store_patriarch' && !isSuperAdmin}}">
            <text class="mm-locked-icon">🔒</text>
            <text class="mm-locked-text">同级大家长权限调整需联系超级管理员</text>
            <button class="mm-contact-admin-btn" bindtap="onContactAdmin">联系超管</button>
          </view>

          <!-- 下半区操作 ── 情形 B：可正常操作
               🐛 义工没有更低一级的角色可降级，改为展示【设为财务】这个正向
               入口；财务/店长保留原有的【降级为义工】。
               🛡️ 不提供"设为店长"：manageVolunteerBinding 云函数的
               changeRole 明确只允许 volunteer/finance 互转，禁止通过此入口
               提权到 store_manager（见该云函数文件头注释），店长任命走邀请码
               这条更审慎的既有路径，这里不越权放开 -->
          <view class="mm-actions" wx:elif="{{item.role === 'volunteer'}}">
            <button class="mm-demote-btn {{memberManageOperating ? 'mm-demote-btn-disabled' : ''}}"
                    bindtap="onChangeMemberRole"
                    data-id="{{item.applyId}}"
                    data-name="{{item.realName}}"
                    data-new-role="finance"
                    disabled="{{memberManageOperating}}">⬆ 设为财务</button>
            <button class="mm-remove-btn {{memberManageOperating ? 'mm-remove-btn-disabled' : ''}}"
                    bindtap="onRemoveFromStore"
                    data-id="{{item.applyId}}"
                    data-name="{{item.realName}}"
                    disabled="{{memberManageOperating}}">✕ 移出本店</button>
          </view>
          <view class="mm-actions" wx:else>
            <button class="mm-demote-btn {{memberManageOperating ? 'mm-demote-btn-disabled' : ''}}"
                    bindtap="onChangeMemberRole"
                    data-id="{{item.applyId}}"
                    data-name="{{item.realName}}"
                    data-new-role="volunteer"
                    disabled="{{memberManageOperating}}">⬇ 降级为义工</button>
            <button class="mm-remove-btn {{memberManageOperating ? 'mm-remove-btn-disabled' : ''}}"
                    bindtap="onRemoveFromStore"
                    data-id="{{item.applyId}}"
                    data-name="{{item.realName}}"
                    disabled="{{memberManageOperating}}">✕ 移出本店</button>
          </view>

        </view>

        <view class="fa-safe-area-spacer"></view>
      </scroll-view>
    </view>
  </view>

  <!-- 📞 联系超管：同级大家长锁态提示旁「联系超管」按钮触发，展示电话/微信号，
       复用 .certificate-modal-mask/.certificate-modal-card 居中弹窗视觉语言 -->
  <view class="certificate-modal-mask" wx:if="{{showContactAdminModal}}" catchtouchmove="stopPropagation" bindtap="onCloseContactAdminModal">
    <view class="certificate-modal-card contact-admin-modal-card" catchtap="stopPropagation">
      <view class="certificate-modal-header contact-admin-modal-header">
        <text class="admin-key-modal-title">📞 联系超级管理员</text>
        <view class="certificate-modal-close" bindtap="onCloseContactAdminModal">✕</view>
      </view>
      <text class="contact-admin-modal-desc">同级大家长的权限调整需超级管理员协助处理，可通过以下方式联系：</text>

      <view class="contact-admin-row">
        <view class="contact-admin-row-info">
          <text class="contact-admin-row-label">☎️ 客服电话</text>
          <text class="contact-admin-row-value">{{superAdminContactPhone}}</text>
        </view>
        <button class="contact-admin-action-btn" bindtap="onCallSuperAdmin">拨打</button>
      </view>

      <view class="contact-admin-row">
        <view class="contact-admin-row-info">
          <text class="contact-admin-row-label">💬 超管微信号</text>
          <text class="contact-admin-row-value">{{superAdminContactWechat}}</text>
        </view>
        <button class="contact-admin-action-btn" bindtap="onCopySuperAdminWechat">复制</button>
      </view>
    </view>
  </view>

  <!-- 👥 待审批的本店成员申请：店长/家长入口，义工/财务两类，与「爱心意见箱管理」/
       「待审核的义工餐报」同一套半屏弹窗视觉语言 -->
  <view class="feedback-sheet-backdrop feedback-admin-sheet-backdrop {{showMemberApplicationModal ? 'show' : ''}}" catchtouchmove="stopPropagation" wx:if="{{showMemberApplicationModal}}" bindtap="onCloseMemberApplicationModal">
    <view class="feedback-sheet-panel feedback-admin-sheet-panel" catchtap="stopPropagation">
      <view class="feedback-sheet-drag-handle"></view>

      <view class="feedback-sheet-header">
        <view class="feedback-sheet-header-text">
          <text class="feedback-sheet-title">👥 待审批的本店成员申请</text>
          <text class="feedback-sheet-subtitle">义工/财务身份申请，拒绝需填写原因</text>
        </view>
        <view class="feedback-sheet-close" bindtap="onCloseMemberApplicationModal">✕</view>
      </view>

      <scroll-view scroll-y class="feedback-admin-list-scroll">
        <view class="feedback-admin-loading" wx:if="{{memberApplicationLoading}}">
          <text>加载中...</text>
        </view>

        <view class="feedback-admin-empty" wx:if="{{!memberApplicationLoading && memberApplicationList.length === 0}}">
          <text>暂无待审批的成员申请</text>
        </view>

        <view class="feedback-admin-item" wx:for="{{memberApplicationList}}" wx:key="applyId">
          <view class="fa-item-header">
            <text class="fa-item-nickname">{{item.realName}}</text>
            <text class="fa-item-type-tag">{{item.requestedRoleLabel}}</text>
          </view>
          <text class="fa-item-time">🗓️ {{item.applyTimeStr}}</text>
          <text class="fa-item-content">手机号：{{item.phone}}</text>

          <view class="fa-item-actions">
            <button
              class="fa-item-reply-btn"
              bindtap="onOpenRejectApplicationModal"
              data-id="{{item.applyId}}"
              data-queue="member"
            >❌ 拒绝</button>
            <button
              class="fa-item-handle-btn"
              bindtap="onApproveApplication"
              data-id="{{item.applyId}}"
              data-queue="member"
            >✅ 通过</button>
          </view>
        </view>
        <view class="fa-safe-area-spacer"></view>
      </scroll-view>
    </view>
  </view>

  <!-- ❌ 拒绝申请原因弹窗：成员申请驳回，与义工投稿驳回同一套
       certificate-modal-* 视觉规范 -->
  <view class="certificate-modal-mask" wx:if="{{showRejectApplicationModal}}" catchtouchmove="stopPropagation" bindtap="onCloseRejectApplicationModal">
    <view class="certificate-modal-card" catchtap="stopPropagation">
      <view class="certificate-modal-header">
        <view class="certificate-modal-close" bindtap="onCloseRejectApplicationModal">✕</view>
      </view>

      <text class="vt-form-label">拒绝原因</text>
      <textarea
        class="feedback-content-textarea"
        placeholder="如：门店档案信息不全、身份信息核实失败"
        placeholder-class="feedback-textarea-placeholder"
        value="{{rejectApplicationReason}}"
        bindinput="onRejectApplicationReasonInput"
        maxlength="300"
        auto-height
      ></textarea>

      <button
        class="feedback-submit-btn {{rejectApplicationSubmitting ? 'feedback-submit-btn-disabled' : ''}}"
        bindtap="onSubmitRejectApplication"
        loading="{{rejectApplicationSubmitting}}"
        disabled="{{rejectApplicationSubmitting}}"
      >确认拒绝</button>
    </view>
  </view>

  <!-- 🍚 门店餐饮与物资统计：即时查询 volunteer_submissions/material_logs，
       不新建汇总表，与 warm-story-modal-* 共用弹窗视觉规范 -->
  <view class="warm-story-modal-mask" wx:if="{{showStoreStatsModal}}" catchtouchmove="stopPropagation" bindtap="onCloseStoreStatsModal">
    <view class="warm-story-modal-card store-stats-modal-card" catchtap="stopPropagation">
      <view class="warm-story-modal-header">
        <text class="warm-story-modal-title">📊 门店餐饮与物资统计</text>
        <view class="warm-story-modal-close" bindtap="onCloseStoreStatsModal">✕</view>
      </view>

      <view class="feedback-admin-loading" wx:if="{{storeStatsLoading}}">
        <text>加载中...</text>
      </view>

      <scroll-view scroll-y class="store-stats-scroll" wx:else>
        <view class="store-stats-timestamp">
          <text>统计日期：{{storeStats.today}}</text>
          <text class="store-stats-timestamp-dot">|</text>
          <text class="store-stats-refresh">刚刚更新 🔄</text>
        </view>

        <text class="pd-health-title">🍚 今日三餐人数（共 {{storeStats.mealTotals.totalCount}} 人次）</text>
        <view class="pd-health-grid">
          <view class="pd-health-cell">
            <text class="pd-health-lbl">早餐人数</text>
            <text class="pd-health-val {{stats.isZero(storeStats.mealTotals.breakfastCount) ? 'pd-health-val-zero' : ''}}">{{stats.fmtCount(storeStats.mealTotals.breakfastCount, '人次')}}</text>
          </view>
          <view class="pd-health-cell">
            <text class="pd-health-lbl">午餐人数</text>
            <text class="pd-health-val {{stats.isZero(storeStats.mealTotals.lunchCount) ? 'pd-health-val-zero' : ''}}">{{stats.fmtCount(storeStats.mealTotals.lunchCount, '人次')}}</text>
          </view>
          <view class="pd-health-cell">
            <text class="pd-health-lbl">晚餐人数</text>
            <text class="pd-health-val {{stats.isZero(storeStats.mealTotals.dinnerCount) ? 'pd-health-val-zero' : ''}}">{{stats.fmtCount(storeStats.mealTotals.dinnerCount, '人次')}}</text>
          </view>
          <view class="pd-health-cell">
            <text class="pd-health-lbl">今日总计</text>
            <text class="pd-health-val {{stats.isZero(storeStats.mealTotals.totalCount) ? 'pd-health-val-zero' : 'green'}}">{{stats.fmtCount(storeStats.mealTotals.totalCount, '人次')}}</text>
          </view>
        </view>

        <text class="pd-health-title">🌾 今日物资消耗</text>
        <view class="pd-health-grid">
          <view class="pd-health-cell">
            <text class="pd-health-lbl">大米</text>
            <text class="pd-health-val {{stats.isZero(storeStats.todayMaterialTotals.riceCount) ? 'pd-health-val-zero' : ''}}">{{stats.fmtMaterial(storeStats.todayMaterialTotals.riceCount, 'rice')}}</text>
          </view>
          <view class="pd-health-cell">
            <text class="pd-health-lbl">面粉</text>
            <text class="pd-health-val {{stats.isZero(storeStats.todayMaterialTotals.flourCount) ? 'pd-health-val-zero' : ''}}">{{stats.fmtMaterial(storeStats.todayMaterialTotals.flourCount, 'flour')}}</text>
          </view>
          <view class="pd-health-cell">
            <text class="pd-health-lbl">食用油</text>
            <text class="pd-health-val {{stats.isZero(storeStats.todayMaterialTotals.oilCount) ? 'pd-health-val-zero' : ''}}">{{stats.fmtMaterial(storeStats.todayMaterialTotals.oilCount, 'oil')}}</text>
          </view>
          <view class="pd-health-cell">
            <text class="pd-health-lbl">蔬菜</text>
            <text class="pd-health-val {{stats.isZero(storeStats.todayMaterialTotals.vegetableCount) ? 'pd-health-val-zero' : ''}}">{{stats.fmtMaterial(storeStats.todayMaterialTotals.vegetableCount, 'vegetable')}}</text>
          </view>
        </view>

        <text class="pd-health-title">📅 本月累计物资消耗</text>
        <view class="pd-health-grid">
          <view class="pd-health-cell">
            <text class="pd-health-lbl">大米</text>
            <text class="pd-health-val {{stats.isZero(storeStats.monthMaterialTotals.riceCount) ? 'pd-health-val-zero' : ''}}">{{stats.fmtMaterial(storeStats.monthMaterialTotals.riceCount, 'rice')}}</text>
          </view>
          <view class="pd-health-cell">
            <text class="pd-health-lbl">面粉</text>
            <text class="pd-health-val {{stats.isZero(storeStats.monthMaterialTotals.flourCount) ? 'pd-health-val-zero' : ''}}">{{stats.fmtMaterial(storeStats.monthMaterialTotals.flourCount, 'flour')}}</text>
          </view>
          <view class="pd-health-cell">
            <text class="pd-health-lbl">食用油</text>
            <text class="pd-health-val {{stats.isZero(storeStats.monthMaterialTotals.oilCount) ? 'pd-health-val-zero' : ''}}">{{stats.fmtMaterial(storeStats.monthMaterialTotals.oilCount, 'oil')}}</text>
          </view>
          <view class="pd-health-cell">
            <text class="pd-health-lbl">蔬菜</text>
            <text class="pd-health-val {{stats.isZero(storeStats.monthMaterialTotals.vegetableCount) ? 'pd-health-val-zero' : ''}}">{{stats.fmtMaterial(storeStats.monthMaterialTotals.vegetableCount, 'vegetable')}}</text>
          </view>
        </view>

        <!-- 🌱 空状态引导：今日三餐人数与物资消耗全为 0，大概率是今天还没人录入，
             直接给一个"前往补报"的快捷按钮，比干巴巴一堆 0/-- 更有指引性 -->
        <view class="store-stats-empty-hint" wx:if="{{storeStatsAllZero}}">
          <text class="store-stats-empty-text">今日暂无录入数据</text>
          <button class="store-stats-empty-btn" bindtap="onGoToStoreStatsSupplement">前往补报</button>
        </view>
      </scroll-view>

      <view class="store-stats-footer-actions">
        <view class="store-stats-footer-btn store-stats-footer-btn-detail" bindtap="onGoToStoreStatsDetail">查看消耗明细</view>
        <view class="store-stats-footer-btn store-stats-footer-btn-supplement" bindtap="onGoToStoreStatsSupplement">补报今日数据</view>
      </view>
    </view>
  </view>

  <!-- 🔐 高级功能授权半屏卡片：super_admin/store_patriarch 点击"会员开通/续费
       管理"时唤起。卡片分为：① 黑钻身份卡（门店 + 套餐状态）② 高级权益对比
       ③ 授权码自助兑换 ④ 底部金色主按钮（在线订购/续费）。
       card 自独立 position:fixed 贴底 + z-index:9999，避免被自定义 tabBar 遮挡。-->
  <view class="subscription-modal-mask {{showSubscriptionModal ? 'show' : ''}}" catchtouchmove="stopPropagation" bindtap="onCloseSubscriptionModal">
    <!-- 🏛️ Flex 垂直三段式骨架：.sub-modal-container 固定 height:80vh（封顶
         1200rpx），不再是"内容多高、卡片多高"的 max-height 内容驱动型盒子——
         无论中间套餐对比/权益卡片内容有多少，这个盒子的总高度都是确定值，
         底部操作区（flex-shrink:0）永远有稳定的落脚空间，不会被顶出可视区 -->
    <view class="sub-modal-container" catchtap="stopPropagation">

      <!-- 右上角关闭 -->
      <view class="sub-close-row">
        <view class="sub-close-btn" bindtap="onCloseSubscriptionModal">✕</view>
      </view>

      <!-- 加载中骨架 -->
      <view class="subscription-loading" wx:if="{{subscriptionLoading}}">
        <text>加载套餐信息中…</text>
      </view>

      <block wx:else>

        <!-- ① 顶部固定：黑钻身份卡（机构信息） ──────────────────────── -->
        <view class="sub-identity-card sub-identity-card-{{subscriptionInfo.planType}}">
          <!-- 🐛 归属层级修复：套餐是按机构（tenantId）生效的，不是按单店——同一机构
               多家门店共享这一份套餐权益（见 checkTenantPermission 云函数），这里改
               展示机构名而不是当前门店名，避免"续费的到底是这家店还是整个机构"的误解 -->
          <view class="sub-identity-top">
            <text class="sub-store-name">{{currentTenantName || currentStoreName || '我的机构'}}</text>
            <view class="sub-plan-badge sub-plan-badge-{{subscriptionInfo.planType}}">
              {{subscriptionInfo.planLabel}}
            </view>
          </view>
          <view class="sub-identity-bottom">
            <!-- 🕊️ 宽限期：套餐已过到期日但仍在 7 天宽限期内，高级功能照常可用，
                 只是明确提醒"快去续费"，与彻底降级为 basic 的 isExpired 分开展示 -->
            <text class="sub-expiry-grace" wx:if="{{subscriptionInfo.isInGracePeriod}}">⏳ 已到期，宽限期至 {{subscriptionInfo.graceExpireDate}}（宽限期内权益不受影响），请尽快续费</text>
            <text class="sub-expiry-warn" wx:elif="{{subscriptionInfo.isExpiringSoon}}">⚠️ 即将到期：{{subscriptionInfo.expireDateStr}}</text>
            <text class="sub-expiry-expired" wx:elif="{{subscriptionInfo.isExpired}}">套餐已到期（超出 7 天宽限期），续费后恢复高级权益</text>
            <text class="sub-expiry-active" wx:elif="{{subscriptionInfo.isActive}}">有效期至 {{subscriptionInfo.expireDateStr}}</text>
            <text class="sub-expiry-free" wx:else>当前为免费基础版，升级解锁更多权益</text>
          </view>
        </view>

        <!-- ② 中间滚动区：.sub-modal-body（flex:1，唯一会滚动的区域）——
             机构信息卡片已固定在上方，这里只承载"可以变长"的内容：升级权益
             卡片组、套餐对比 Tab、价格/配额卡片、扩容包 Stepper、授权码
             折叠区，内容再多也只在这一个区域内部滚动，不影响上下两段固定区 -->
        <scroll-view scroll-y="true" class="sub-modal-body sub-scroll-body">

          <!-- ②.1 高级权益卡片组 ──────────────────────────────── -->
          <view class="sub-section">
            <text class="sub-section-title">{{subscriptionInfo.isActive ? '✦ 当前权益' : '✦ 升级后解锁'}}</text>
            <view class="sub-benefit-grid">
              <view class="sub-benefit-card {{subscriptionInfo.isActive ? 'sub-benefit-active' : ''}}">
                <text class="sub-benefit-icon">📊</text>
                <text class="sub-benefit-name">全国汇总大屏</text>
                <text class="sub-benefit-desc">跨店数据一屏掌握</text>
              </view>
              <view class="sub-benefit-card {{subscriptionInfo.isActive ? 'sub-benefit-active' : ''}}">
                <text class="sub-benefit-icon">📑</text>
                <text class="sub-benefit-name">Excel 批量导出</text>
                <text class="sub-benefit-desc">账目明细一键导表</text>
              </view>
              <view class="sub-benefit-card {{subscriptionInfo.isActive ? 'sub-benefit-active' : ''}}">
                <text class="sub-benefit-icon">⚡</text>
                <text class="sub-benefit-name">高级权限管理</text>
                <text class="sub-benefit-desc">多财务/多大家长并行</text>
              </view>
            </view>
          </view>

          <!-- ②.2 套餐对比：基础版 / 专业版 / 旗舰版 / 扩容门店包 四个 Tab
               切换，明确列出定价与门店配额——与上面的"当前权益"摘要不同，这里是
               给用户"看清楚每档具体差在哪、该选哪个"用的完整对比，纯浏览态，
               不影响任何已生效的订阅状态。门店配额口径与 checkTenantPermission/
               createStore 等云函数的 PLAN_STORE_LIMITS 完全一致：
               basic 2 家 / pro 10 家 / enterprise（旗舰版）30 家 -->
          <view class="sub-section">
            <text class="sub-section-title">✦ 套餐对比</text>
            <view class="sub-plan-compare-tabs">
              <view class="sub-plan-compare-tab {{comparePlanTab === 'basic' ? 'active' : ''}}" data-plan="basic" bindtap="onSwitchComparePlanTab">
                <text class="sub-plan-compare-tab-icon">🌱</text>
                <text>基础版</text>
              </view>
              <view class="sub-plan-compare-tab {{comparePlanTab === 'pro' ? 'active' : ''}}" data-plan="pro" bindtap="onSwitchComparePlanTab">
                <text class="sub-plan-compare-tab-icon">🌟</text>
                <text>专业版</text>
              </view>
              <view class="sub-plan-compare-tab {{comparePlanTab === 'enterprise' ? 'active' : ''}}" data-plan="enterprise" bindtap="onSwitchComparePlanTab">
                <text class="sub-plan-compare-tab-icon">👑</text>
                <text>旗舰版</text>
              </view>
              <view class="sub-plan-compare-tab {{comparePlanTab === 'add_on' ? 'active' : ''}}" data-plan="add_on" bindtap="onSwitchComparePlanTab">
                <text class="sub-plan-compare-tab-icon">🏪</text>
                <text>扩容包</text>
              </view>
            </view>

            <view class="sub-plan-compare-panel" wx:if="{{comparePlanTab === 'basic'}}">
              <view class="sub-plan-compare-price-row">
                <text class="sub-plan-compare-price">¥0</text>
                <text class="sub-plan-compare-price-unit">永久免费</text>
              </view>
              <view class="sub-plan-quota-tag">📦 包含机构门店上限：2 家</view>
              <view class="sub-plan-compare-feature-row">
                <text class="sub-plan-compare-feature-icon">✓</text>
                <text>基础收支记账</text>
              </view>
              <view class="sub-plan-compare-feature-row">
                <text class="sub-plan-compare-feature-icon">✓</text>
                <text>日常流水查看</text>
              </view>
              <view class="sub-plan-compare-feature-row">
                <text class="sub-plan-compare-feature-icon">✓</text>
                <text>简单日报</text>
              </view>
            </view>

            <view class="sub-plan-compare-panel" wx:elif="{{comparePlanTab === 'pro'}}">
              <view class="sub-plan-compare-price-row">
                <text class="sub-plan-compare-price">¥1,688</text>
                <text class="sub-plan-compare-price-unit">/ 年</text>
              </view>
              <view class="sub-plan-quota-tag">📦 包含机构门店上限：10 家</view>
              <view class="sub-plan-compare-feature-row">
                <text class="sub-plan-compare-feature-icon">✓</text>
                <text>跨店汇总统计</text>
              </view>
              <view class="sub-plan-compare-feature-row">
                <text class="sub-plan-compare-feature-icon">✓</text>
                <text>进销存 / 物资管理</text>
              </view>
              <view class="sub-plan-compare-feature-row">
                <text class="sub-plan-compare-feature-icon">✓</text>
                <text>Excel 账目与收支报表导出</text>
              </view>
              <view class="sub-plan-compare-feature-row">
                <text class="sub-plan-compare-feature-icon">✓</text>
                <text>角色权限精细化</text>
              </view>
            </view>

            <view class="sub-plan-compare-panel" wx:elif="{{comparePlanTab === 'enterprise'}}">
              <view class="sub-plan-compare-price-row">
                <text class="sub-plan-compare-price">¥3,688</text>
                <text class="sub-plan-compare-price-unit">/ 年</text>
              </view>
              <view class="sub-plan-quota-tag">📦 包含机构门店上限：30 家</view>
              <view class="sub-plan-compare-feature-row">
                <text class="sub-plan-compare-feature-icon">✓</text>
                <text>数据大屏看板</text>
              </view>
              <view class="sub-plan-compare-feature-row">
                <text class="sub-plan-compare-feature-icon">✓</text>
                <text>专属财务凭证导出</text>
              </view>
              <view class="sub-plan-compare-feature-row">
                <text class="sub-plan-compare-feature-icon">✓</text>
                <text>数据备份</text>
              </view>
              <view class="sub-plan-compare-feature-row">
                <text class="sub-plan-compare-feature-icon">✓</text>
                <text>多级人员调度与优先客服</text>
              </view>
            </view>

            <view class="sub-plan-compare-panel" wx:else>
              <view class="sub-plan-compare-price-row">
                <text class="sub-plan-compare-price">¥200</text>
                <text class="sub-plan-compare-price-unit">/ 店 / 年</text>
              </view>
              <view class="sub-plan-quota-tag">📦 在当前机构门店上限基础上按需叠加</view>
              <view class="sub-plan-compare-feature-row">
                <text class="sub-plan-compare-feature-icon">✓</text>
                <text>不改变套餐档位，仅追加门店名额</text>
              </view>
              <view class="sub-plan-compare-feature-row">
                <text class="sub-plan-compare-feature-icon">✓</text>
                <text>基础版机构同样可购买</text>
              </view>
              <view class="sub-plan-addon-stepper-row">
                <text class="sub-plan-addon-stepper-label">购买数量（家/年）</text>
                <view class="sub-plan-addon-stepper">
                  <view class="sub-plan-addon-stepper-btn" bindtap="onDecreaseAddOnQuantity">－</view>
                  <text class="sub-plan-addon-stepper-value">{{addOnQuantity}}</text>
                  <view class="sub-plan-addon-stepper-btn" bindtap="onIncreaseAddOnQuantity">＋</view>
                </view>
              </view>
              <view class="sub-plan-addon-total-row">
                <text>合计：</text>
                <text class="sub-plan-addon-total-price">¥{{addOnTotalPrice}}</text>
              </view>
            </view>
          </view>

          <!-- ②.3 授权码兑换区：折叠式次级入口 ──────────────────────
               🐛 层级冲突修复：此前是一张与"套餐对比"同权重的常驻展开卡片
               （标题+输入框+按钮全部常驻可见），与主线"微信支付开通"抢视觉
               焦点，容易让用户误以为"这两条路都得走一遍"。改为默认折叠的
               轻量入口——只有极少数拿到卡号/授权码的用户才会点开，绝大多数
               走微信支付的用户完全不会被这块内容分散注意力 -->
          <view class="sub-section sub-redeem-collapse">
            <view class="sub-redeem-toggle" bindtap="onToggleRedeemSection">
              <text class="sub-redeem-toggle-icon">🎫</text>
              <text class="sub-redeem-toggle-text">使用授权码 / 兑换卡号</text>
              <text class="sub-redeem-toggle-arrow {{showRedeemSection ? 'sub-redeem-toggle-arrow-expanded' : ''}}">›</text>
            </view>
            <view class="sub-redeem-panel" wx:if="{{showRedeemSection}}">
              <view class="sub-redeem-input-row">
                <input class="sub-redeem-input"
                       placeholder="请输入或粘贴授权码 / 兑换卡号"
                       value="{{activationCodeInput}}"
                       bindinput="onActivationCodeInput" />
                <view class="sub-paste-btn" bindtap="onPasteActivationCode">粘贴</view>
              </view>
              <button class="sub-btn-activate {{(activationSubmitting || !activationCodeInput) ? 'sub-btn-activate-disabled' : ''}}"
                      bindtap="onRedeemActivationCode"
                      disabled="{{activationSubmitting || !activationCodeInput}}"
                      loading="{{activationSubmitting}}">激活授权码</button>
            </view>
          </view>

        </scroll-view>

        <!-- ③ 底部固定操作区：.sub-modal-footer（flex-shrink:0，不随
             .sub-modal-body 滚动），按 comparePlanTab 分流成三种真实的微信
             支付下单动作（专业版/旗舰版/扩容门店包，均已在
             createSubscriptionOrder 云函数登记真实价格与 SKU），基础版本身
             免费无需下单——见 onPrimaryPlanAction 注释。
             🐛 折行截断修复：文案精简为更短的行动导向文案（价格信息通过 " · "
             紧凑呈现），且必须在按钮内单行水平居中展示——按钮文本直接写在
             同一行源码里，不留换行/多余空白，配合 .btn-pay-action 的
             white-space:nowrap + overflow:hidden + text-overflow:ellipsis，
             双重保险确保严禁出现折行 -->
        <view class="sub-modal-footer">
          <button class="btn-pay-action" bindtap="onPrimaryPlanAction" loading="{{subscriptionLoading}}" wx:if="{{comparePlanTab === 'pro'}}">💳 立即开通专业版 · ¥1,688/年</button>
          <button class="btn-pay-action btn-pay-action-enterprise" bindtap="onPrimaryPlanAction" loading="{{subscriptionLoading}}" wx:elif="{{comparePlanTab === 'enterprise'}}">👑 立即开通旗舰版 · ¥3,688/年</button>
          <button class="btn-pay-action btn-pay-action-addon" bindtap="onPrimaryPlanAction" loading="{{subscriptionLoading}}" wx:elif="{{comparePlanTab === 'add_on'}}">🏪 确认购买扩容包 · ¥{{addOnTotalPrice}}/年</button>
          <view class="btn-pay-action btn-pay-action-disabled" wx:else>当前为默认免费档位</view>
          <text class="sub-btn-dismiss" bindtap="onCloseSubscriptionModal">暂不升级</text>
        </view>

      </block>
    </view>
  </view>

  <!-- 💳 微信支付资质申请中兜底弹窗：点击"微信支付开通"但支付未配置时展示，
       引导走授权码兑换或联系客服，文案为需求方指定的固定措辞，不可改写 -->
  <view class="payment-pending-modal-mask" wx:if="{{showPaymentPendingModal}}" catchtouchmove="stopPropagation" bindtap="onClosePaymentPendingModal">
    <view class="payment-pending-modal-card" catchtap="stopPropagation">
      <view class="payment-pending-modal-header">
        <text class="payment-pending-modal-title">💳 微信支付开通中</text>
        <view class="payment-pending-modal-close" bindtap="onClosePaymentPendingModal">✕</view>
      </view>
      <text class="payment-pending-modal-desc">微信在线支付正在开通中，当前支持使用授权码直接激活。如需开通请联系平台开发者。</text>

      <view class="payment-pending-modal-contact-row">
        <view class="payment-pending-modal-contact-info">
          <text class="payment-pending-modal-contact-label">💬 平台客服微信号</text>
          <text class="payment-pending-modal-contact-value">{{superAdminContactWechat}}</text>
        </view>
        <button class="payment-pending-modal-contact-btn" bindtap="onCopyPlatformSupportWechat">复制</button>
      </view>

      <button class="payment-pending-modal-ok-btn" bindtap="onClosePaymentPendingModal">🔑 我知道了，去输入授权码</button>
    </view>
  </view>

  <mine-quick-sheet id="mineQuickSheet" />

  <!-- 🔐 管理员密钥修改弹窗：仅大家长/超管可触发，复用 certificate-modal 弹窗壳 -->
  <view class="certificate-modal-mask" wx:if="{{showAdminKeyModal}}" catchtouchmove="stopPropagation" bindtap="onCloseAdminKeyModal">
    <view class="certificate-modal-card admin-key-modal-card" catchtap="stopPropagation">
      <view class="certificate-modal-header admin-key-modal-header">
        <text class="admin-key-modal-title">🔐 {{storeAdminKeySet ? '修改' : '设置'}}管理员密钥</text>
        <view class="certificate-modal-close" bindtap="onCloseAdminKeyModal">✕</view>
      </view>
      <text class="vt-form-label">新密钥（留空则清除密钥）</text>
      <input class="admin-key-modal-input"
             type="text"
             password
             value="{{adminKeyModalInput}}"
             bindinput="onAdminKeyModalInput"
             placeholder="请输入密钥，最多 50 字"
             maxlength="50" />
      <text class="admin-key-modal-desc">设置后，申请大家长/店长/财务角色时须提供此密钥。留空保存则清除密钥（允许所有人自由申请）。</text>
      <button class="feedback-submit-btn {{adminKeyModalSaving ? 'feedback-submit-btn-disabled' : ''}}"
              bindtap="onSaveAdminKeyFromProfile"
              loading="{{adminKeyModalSaving}}"
              disabled="{{adminKeyModalSaving}}">保存密钥</button>
    </view>
  </view>

  <!-- 🛡️ 超管撤销管理权限弹窗 -->
  <view class="feedback-sheet-backdrop feedback-admin-sheet-backdrop {{showForceUnbindModal ? 'show' : ''}}" catchtouchmove="stopPropagation" wx:if="{{showForceUnbindModal}}" bindtap="onCloseForceUnbindModal">
    <view class="feedback-sheet-panel sa-unbind-sheet-panel" catchtap="stopPropagation">
      <view class="feedback-sheet-drag-handle"></view>

      <view class="feedback-sheet-header">
        <view class="feedback-sheet-header-text">
          <text class="feedback-sheet-title">🛡️ 撤销管理权限</text>
          <text class="feedback-sheet-subtitle">将违规管理成员降级为义工，操作立即生效</text>
        </view>
        <view class="feedback-sheet-close" bindtap="onCloseForceUnbindModal">✕</view>
      </view>

      <!-- ① 搜索栏 -->
      <view class="sa-member-search-bar">
        <input class="sa-member-search-input"
               placeholder="搜索成员姓名、手机号或门店..."
               value="{{forceUnbindSearchQuery}}"
               bindinput="onForceUnbindSearch" />
      </view>

      <view class="sa-member-loading" wx:if="{{forceUnbindMemberLoading}}">
        <text>加载成员列表中...</text>
      </view>
      <scroll-view scroll-y class="sa-member-list-scroll" wx:elif="{{forceUnbindFilteredList.length > 0}}">
        <view
          class="sa-member-item {{forceUnbindSelectedMember && forceUnbindSelectedMember.applyId === item.applyId ? 'selected' : ''}}"
          wx:for="{{forceUnbindFilteredList}}"
          wx:key="applyId"
          bindtap="onSelectForceUnbindMember"
          data-member="{{item}}"
        >
          <!-- 左：头像 -->
          <view class="sa-member-avatar-wrap">
            <image wx:if="{{item.avatarUrl && !memberAvatarFailedMap[item.avatarUrl]}}" class="sa-member-avatar" src="{{item.avatarUrl}}" mode="aspectFill" binderror="onMemberAvatarError" data-url="{{item.avatarUrl}}" />
            <view wx:else class="sa-member-avatar-fallback">{{item.realName ? item.realName[0] : '?'}}</view>
          </view>
          <!-- 中：姓名 + 当前角色·门店 -->
          <view class="sa-member-info">
            <text class="sa-member-name">{{item.realName || '未知姓名'}}</text>
            <text class="sa-member-meta">{{item.roleLabel}} · {{item.storeName || '未知门店'}}</text>
          </view>
          <!-- 右：遮敏手机号 + 选中徽标 -->
          <view class="sa-member-right">
            <text class="sa-member-phone" wx:if="{{item.phoneMasked}}">{{item.phoneMasked}}</text>
            <view class="sa-member-selected-badge" wx:if="{{forceUnbindSelectedMember && forceUnbindSelectedMember.applyId === item.applyId}}">
              <text class="sa-member-selected-check">✔</text>
              <text class="sa-member-selected-label">已选中</text>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="sa-member-empty" wx:elif="{{!forceUnbindMemberLoading}}">
        <text>{{forceUnbindSearchQuery ? '未找到匹配成员' : '暂无管理岗位成员'}}</text>
      </view>

      <!-- ② 已选中成员确认卡片 -->
      <view class="sa-selected-card" wx:if="{{forceUnbindSelectedMember}}">
        <!-- 头像 -->
        <view class="sa-selected-avatar-wrap">
          <image wx:if="{{forceUnbindSelectedMember.avatarUrl && !memberAvatarFailedMap[forceUnbindSelectedMember.avatarUrl]}}" class="sa-selected-avatar" src="{{forceUnbindSelectedMember.avatarUrl}}" mode="aspectFill" binderror="onMemberAvatarError" data-url="{{forceUnbindSelectedMember.avatarUrl}}" />
          <view wx:else class="sa-selected-avatar-fallback">{{forceUnbindSelectedMember.realName ? forceUnbindSelectedMember.realName[0] : '?'}}</view>
        </view>
        <!-- 信息 -->
        <view class="sa-selected-card-left">
          <text class="sa-selected-name">{{forceUnbindSelectedMember.realName}}</text>
          <text class="sa-selected-meta">{{forceUnbindSelectedMember.roleLabel}} · {{forceUnbindSelectedMember.storeName}}</text>
          <text class="sa-selected-phone" wx:if="{{forceUnbindSelectedMember.phoneMasked}}">📱 {{forceUnbindSelectedMember.phoneMasked}}</text>
        </view>
        <!-- 取消 -->
        <view class="sa-clear-btn" bindtap="onClearForceUnbindSelection">取消</view>
      </view>

      <!-- ③ 兜底：手动输入账号编号（折叠态，点击"找不到？"后展开） -->
      <view class="sa-manual-section" wx:if="{{!forceUnbindSelectedMember}}">
        <!-- 折叠触发行 -->
        <view class="sa-manual-toggle-row" bindtap="onToggleForceUnbindManualInput">
          <text class="sa-manual-toggle-text">找不到该成员？使用编号搜索</text>
          <text class="sa-manual-toggle-arrow">{{showForceUnbindManualInput ? '▲' : '▼'}}</text>
        </view>
        <!-- 展开内容 -->
        <view class="sa-manual-input-wrap" wx:if="{{showForceUnbindManualInput}}">
          <input class="sa-manual-input"
                 type="text"
                 value="{{forceUnbindInput}}"
                 bindinput="onForceUnbindInput"
                 placeholder="输入用户专有账号编号（如无法搜到时使用）"
                 maxlength="100" />
        </view>
      </view>

      <!-- ④ 操作结果 -->
      <view class="sa-tool-result" wx:if="{{forceUnbindResult}}">
        <text>{{forceUnbindResult}}</text>
      </view>

      <!-- ⑤ 撤销按钮：无选中灰色提示态（不 disabled，避免 opacity 0.5 叠加），有选中激活红 -->
      <button class="sa-confirm-btn {{forceUnbindSelectedMember || forceUnbindInput ? 'sa-confirm-btn-active' : 'sa-confirm-btn-inactive'}}"
              bindtap="onConfirmForceUnbind"
              loading="{{forceUnbindSaving}}"
              disabled="{{forceUnbindSaving}}">
        {{forceUnbindSelectedMember ? '确认撤销 ' + forceUnbindSelectedMember.realName + ' 的管理权限' : (forceUnbindInput ? '确认撤销管理权限' : '请先选择要撤销的成员')}}
      </button>
    </view>
  </view>

  <!-- 🔑 超管重置门店密钥弹窗 -->
