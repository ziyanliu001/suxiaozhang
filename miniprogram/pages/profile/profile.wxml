      <!-- 未选中（多门店场景、列表加载完但尚未选）：点击展开列表 -->
      <view wx:elif="{{!resetStoreKeyStoreId && !resetStoreKeyShowList}}"
            class="reset-key-unselected-btn" bindtap="onToggleResetKeyStoreList">
