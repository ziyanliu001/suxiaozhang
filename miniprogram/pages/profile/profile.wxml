    <view class="feedback-sheet-drag-handle"></view>

    <!-- 列表视图 -->
    <block wx:if="{{noticeManagementView === 'list'}}">
      <view class="feedback-sheet-title-row">
        <text class="feedback-sheet-title">📢 门店公告管理</text>
        <view class="feedback-sheet-close-btn" bindtap="onCloseNoticeManagementModal">✕</view>
      </view>

      <scroll-view scroll-y class="notice-mgmt-scroll">
        <view wx:if="{{noticeManagementLoading}}" class="notice-mgmt-empty">
          <text class="notice-mgmt-empty-text">加载中…</text>
        </view>
        <view wx:elif="{{noticeManagementList.length === 0}}" class="notice-mgmt-empty">
