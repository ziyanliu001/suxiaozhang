              <view class="reset-key-item-main">
                <text class="reset-key-item-name">{{item.storeName}}</text>
              </view>
              <text wx:if="{{item.storeId === resetStoreKeyStoreId}}" class="reset-key-item-check">✓</text>
            </view>
          </block>
          <view wx:if="{{resetStoreKeyFilteredList.length === 0}}" class="reset-key-no-result">
            <text>未找到匹配门店</text>
          </view>
