      <button class="feedback-submit-btn {{resetStoreKeyIsClearMode ? 'reset-key-btn-clear' : 'reset-key-btn-set'}} {{(resetStoreKeySaving || !resetStoreKeyStoreId || resetStoreKeyShowList) ? 'feedback-submit-btn-disabled' : ''}}"
