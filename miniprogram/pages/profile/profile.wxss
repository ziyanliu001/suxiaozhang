  align-items: center;
  gap: 20rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
  background: #FAFAFA;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  box-sizing: border-box;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.role-switch-option-card:active {
  opacity: 0.85;
}

.role-switch-option-card.active {
  background: #FFFBF0;
  border-color: #DAA520;
}

.role-switch-option-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: #FFFFFF;
  border-radius: 50%;
}

.role-switch-option-card.active .role-switch-option-icon {
  background: #FFF3D6;
}

.role-switch-option-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.role-switch-option-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.role-switch-option-card.active .role-switch-option-label {
  color: #B57C1E;
}

.role-switch-option-desc {
  font-size: 22rpx;
  color: #999999;
  line-height: 1.4;
}

.role-switch-option-check {
