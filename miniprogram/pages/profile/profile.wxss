  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  background: #c60000;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 44rpx;
  box-sizing: border-box;
}

.role-switch-btn-confirm:active {
