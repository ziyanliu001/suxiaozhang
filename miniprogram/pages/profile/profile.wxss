}

.subscription-btn-cancel,
.subscription-btn-confirm {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 1;
  border-radius: 42rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.subscription-btn-cancel::after,
.subscription-btn-confirm::after {
  border: none;
}

.subscription-btn-cancel {
  background: #F1F3F5;
  color: #495057;
}

.subscription-btn-cancel:active {
  background: #E3E6E9;
  transform: scale(0.97);
}

