}
.sub-benefit-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
  display: block;
}
.sub-benefit-name {
  font-size: 22rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 6rpx;
  display: block;
  line-height: 1.3;
}
.sub-benefit-desc {
  font-size: 19rpx;
  color: #8B909A;
  line-height: 1.4;
  display: block;
}

/* ── ③ 授权码兑换区 ──────────────────────────────────────────── */
.sub-redeem-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 24rpx 24rpx;
  border: 1.5rpx solid #EDEFF2;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  margin-bottom: 20rpx;
}
.sub-redeem-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.sub-redeem-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  background: #F8F9FA;
  border: 1.5rpx solid #E9ECEF;
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 25rpx;
  color: #212529;
  box-sizing: border-box;
}
.sub-paste-btn {
  flex-shrink: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  background: #F1F3F5;
  color: #495057;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 14rpx;
  box-sizing: border-box;
}
.sub-paste-btn:active { background: #E3E6E9; }

.sub-btn-activate {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F1F3F5;
  color: #374151;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 14rpx;
  border: none;
  box-sizing: border-box;
  margin: 0;
  transition: background 0.15s;
}
.sub-btn-activate::after { border: none; }
.sub-btn-activate:active { background: #E3E6E9; }
/* 有内容时过渡为金色激活感（靠 disabled 属性控制，enabled 态更显眼） */
.sub-btn-activate[disabled] { opacity: 0.45; }

/* ── ④ 底部主操作区 ──────────────────────────────────────────── */
.sub-footer {
  flex-shrink: 0;
  padding: 24rpx 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  border-top: 1rpx solid #EDEFF2;
  background: #F7F8FA;
}
.sub-btn-purchase {
  width: 100%;
  /* 高度足够容纳单行文本，不用 line-height 撑高（line-height 在 flex 按钮上会
     导致多行文字行距等于按钮高度，造成文字重叠；改用 min-height + flex 居中） */
  min-height: 96rpx;
  height: auto;
  line-height: 1.3;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0 32rpx;
  background: linear-gradient(90deg, #C9941A 0%, #E8C548 55%, #D4A017 100%);
  color: #1C1200;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 48rpx;
  border: none;
  box-sizing: border-box;
  margin: 0;
  letter-spacing: 1rpx;
  box-shadow: 0 6rpx 20rpx rgba(201, 148, 26, 0.38);
  transition: transform 0.12s ease, opacity 0.12s ease;
  white-space: nowrap;
}
.sub-btn-purchase::after { border: none; }
.sub-btn-purchase:active { transform: scale(0.97); opacity: 0.9; }

.sub-btn-dismiss {
  font-size: 24rpx;
  color: #9CA3AF;
  padding: 2rpx 24rpx 12rpx;
}

/* ================= 🔐 管理员密钥行 & 修改弹窗 ================= */

/* action-item-cell 覆盖：密钥行不需要整行可点击态，避免与内部按钮冲突 */
.admin-key-entry-cell {
  cursor: default;
  align-items: center;
}

/* 右侧密钥值 + 操作按钮横排 */
.admin-key-inline-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  flex-wrap: nowrap;
}

.admin-key-inline-val {
  font-size: 24rpx;
  color: #4A4A4A;
  font-family: monospace;
  letter-spacing: 4rpx;
  flex-shrink: 1;
}

/* 查看 / 隐藏 / 修改 小胶囊按钮 */
.admin-key-btn {
  display: inline-flex;
  align-items: center;
