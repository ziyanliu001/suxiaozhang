  box-shadow: none;
}

/* 📮 爱心意见箱管理弹窗：复用 .feedback-sheet-backdrop/.feedback-sheet-panel 的
   遮罩+滑出动效，这里只补充"列表可滚动、限制最大高度"这类管理弹窗特有的样式 */
.feedback-admin-sheet-panel {
