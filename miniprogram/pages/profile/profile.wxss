/* ===== 🎫 生成本店邀请码弹窗 ===== */

/* 半透明遮罩：底部抽屉定位 */
.invite-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

/*
 * 三段式 Flex 容器（根本修复：彻底杜绝底部按钮截断）
 * ─────────────────────────────────────────────────
 * 关键设计：
 *   • overflow: hidden — 容器本身不滚动，滚动完全交给内部 scroll-view
 *   • display: flex + flex-direction: column — 三段垂直排列
 *   • max-height: 86vh — 限制总高度，防止面板超出屏幕
 * 三个子区域：
 *   ① invite-modal-head  (flex-shrink: 0) — 固定头部，绝不压缩
 *   ② invite-modal-scroll (flex: 1; min-height: 0) — 弹性中间区，独立滚动
 *   ③ invite-modal-footer (flex-shrink: 0) — 固定底部，绝不压缩
 */
.invite-modal-panel {
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  width: 100%;
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ① 固定头部：包含拖动条、标题行、提示卡片、副标题 */
.invite-modal-head {
  flex-shrink: 0;
  padding: 12rpx 36rpx 0;
}

/* 拖动指示条 */
.invite-drag-bar {
  width: 72rpx;
  height: 8rpx;
  background: #E0E0E0;
  border-radius: 4rpx;
  margin: 0 auto 24rpx;
}

.invite-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.invite-modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.invite-modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  color: #888;
  border-radius: 50%;
  background: #F5F5F5;
  flex-shrink: 0;
}

/* 黄色提示卡片 */
.invite-modal-tip {
  font-size: 25rpx;
  color: #B45309;
  background: #FFFBEB;
  border: 1rpx solid #FDE68A;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 28rpx;
  line-height: 1.7;
}

.invite-modal-label {
  font-size: 27rpx;
  color: #374151;
  font-weight: 600;
  margin-bottom: 16rpx;
}

/* ② 弹性中间区：scroll-view 独立滚动，min-height:0 是 Flex 子元素收缩的关键 */
.invite-modal-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 36rpx;
}

/* 2×2 身份卡片网格 */
.invite-role-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-bottom: 8rpx;
}

.invite-role-item {
  flex: 1 1 calc(50% - 8rpx);
  min-width: calc(50% - 8rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 28rpx 16rpx;
  border-radius: 20rpx;
  border: 2rpx solid #E5E7EB;
  background: #F9FAFB;
  box-sizing: border-box;
}

.invite-role-item.selected {
  border-color: #2563EB;
  background: #EFF6FF;
}

.invite-role-icon {
  font-size: 40rpx;
}

.invite-role-name {
  font-size: 27rpx;
  color: #4B5563;
  font-weight: 500;
}

.invite-role-item.selected .invite-role-name {
  color: #1D4ED8;
  font-weight: 700;
}

/* ③ 固定底部：flex-shrink:0 是核心，保证任何情况下按钮完整可见 */
.invite-modal-footer {
  flex-shrink: 0;
  padding: 20rpx 36rpx calc(36rpx + env(safe-area-inset-bottom, 0px));
  background: #FFFFFF;
  border-top: 1rpx solid #F3F4F6;
}

/*
 * 主按钮用 <view> 而非 <button>，彻底规避微信 button 的默认
 * margin / ::after 边框 / padding 等不可控样式干扰。
 * line-height 垂直居中（view 内 text 节点继承 line-height）。
 */
.invite-gen-btn {
  height: 88rpx;
  line-height: 88rpx;
  background: #2563EB;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 44rpx;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.25);
}

.invite-gen-btn-loading {
  opacity: 0.65;
}

/* ── 结果展示弹窗 ── */

/* 滚动区内各元素 */
.invite-result-store {
  font-size: 26rpx;
  color: #6B7280;
  text-align: center;
  padding-top: 8rpx;
  margin-bottom: 24rpx;
}

.invite-result-store-name {
  color: #1D4ED8;
  font-weight: 600;
}

/* 大号邀请码卡片：整块可点击复制 */
.invite-result-code-box {
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  border-radius: 24rpx;
  padding: 32rpx 28rpx 24rpx;
  text-align: center;
  margin-bottom: 16rpx;
  border: 2rpx dashed #93C5FD;
}

.invite-result-code {
  display: block;
  font-size: 62rpx;
  font-weight: 800;
  color: #1E3A8A;
  letter-spacing: 8rpx;
  line-height: 1.2;
}

.invite-result-tap-hint {
  display: block;
  font-size: 22rpx;
  color: #60A5FA;
  margin-top: 10rpx;
}

/* 有效期提示 */
.invite-result-validity {
  font-size: 24rpx;
  color: #D97706;
  background: #FFFBEB;
  border: 1rpx solid #FDE68A;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.invite-result-qr {
  width: 220rpx;
  height: 220rpx;
  display: block;
  margin: 0 auto 24rpx;
  border-radius: 16rpx;
}

.invite-result-warning {
  font-size: 22rpx;
  color: #9CA3AF;
  text-align: center;
  line-height: 1.6;
  padding-bottom: 8rpx;
}

/* 复制按钮（同主按钮，用 <view> 避免 button 样式干扰） */
.invite-copy-btn {
  height: 88rpx;
  line-height: 88rpx;
  background: #2563EB;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 44rpx;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.25);
}

/* ==================== 新用户入驻引导弹窗 ==================== */

.onb-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 9999;
}

.onb-panel {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ---- 头部（固定） ---- */
.onb-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx 36rpx 20rpx;
  position: relative;
  border-bottom: 1rpx solid #F3F4F6;
}

.onb-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.onb-close {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 44rpx;
  color: #9CA3AF;
  line-height: 1;
  padding: 8rpx 12rpx;
}

.onb-back {
  position: absolute;
  left: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
  color: #2563EB;
  padding: 8rpx 12rpx;
}

/* 🆕 组织信息配置弹窗标题栏（.org-config-head）：.onb-back-btn/.onb-head-title
   此前完全没有样式定义（靠 .onb-head 的 justify-content: center 硬凑），✕按钮
   与占位 view 宽度不对称，导致标题不居中、✕也没有稳定的点击热区。现改为标题
   独占一行真正居中（复用 .onb-head 自带的 position: relative 作为定位上下文），
   ✕按钮绝对定位到右上角，提供充足的点击热区 */
.onb-head-title {
  font-weight: bold;
  font-size: 32rpx;
  color: #111827;
}

.onb-back-btn {
  position: absolute;
  right: 32rpx;
  top: 32rpx;
  font-size: 36rpx;
  color: #999999;
  padding: 10rpx;
  line-height: 1;
}

/* 🆕 机构类型只读展示：轻量 Tag 标签，替代原先一整行大面积灰底伪输入框
   （#F1F1EE 满宽容器，视觉上像可点的输入框，实际不可编辑，容易造成"点了没
   反应"的误会，且比其余表单项占用更高的卡片空间） */
.org-type-tag-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.org-type-field-label {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.org-type-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: #FFF7E6;
}

.org-type-tag-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #D46B08;
}

.org-type-field-hint {
  display: block;
  font-size: 22rpx;
  color: #999999;
  font-weight: normal;
  margin-top: 4rpx;
}

/* ---- 选择路径内容区（无滚动，内容简短） ---- */
.onb-body {
  flex: 1;
  min-height: 0;
  padding: 36rpx 40rpx calc(40rpx + env(safe-area-inset-bottom, 0px));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.onb-desc {
  font-size: 28rpx;
  color: #6B7280;
  line-height: 1.6;
  text-align: center;
}

.onb-choice-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
}

.onb-choice-primary {
  background: #EFF6FF;
  border: 2rpx solid #BFDBFE;
}

.onb-choice-secondary {
  background: #F9FAFB;
  border: 2rpx solid #E5E7EB;
}

.onb-choice-icon {
  font-size: 52rpx;
  flex-shrink: 0;
}

.onb-choice-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.onb-choice-main {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D4ED8;
}

.onb-choice-main--dark {
  color: #374151;
}

.onb-choice-sub {
  font-size: 24rpx;
  color: #6B7280;
}

.onb-dismiss-hint {
  text-align: center;
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
}

/* ---- 创建表单滚动区 ---- */
.onb-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 40rpx;
}

.onb-form-hint {
  display: block;
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.6;
  padding: 24rpx 0 16rpx;
}

.onb-field {
  margin-bottom: 28rpx;
}

.onb-label {
  font-size: 26rpx;
  color: #374151;
  font-weight: 500;
  margin-bottom: 10rpx;
  display: block;
}

.onb-required {
  color: #EF4444;
}

.onb-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #D1D5DB;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #111827;
  background: #FAFAFA;
  box-sizing: border-box;
}

.onb-field-hint {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
  display: block;
}

.onb-picker {
  height: 80rpx;
  border: 1rpx solid #D1D5DB;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #111827;
  background: #FAFAFA;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.onb-picker-arrow {
  color: #9CA3AF;
  font-size: 32rpx;
}

/* 🆕 组织信息配置弹窗·输入框规范化：门店名称/机构类型/文化寄语两句共用的
   标准微卡片外框，.onb-field-group 本身没有定义任何样式（此前这几个控件
   完全靠 .onb-field-input 的裸样式撑场面），统一叠加这层视觉框架。
   !important：与本文件其余强约束单行/表单样式同一套约定，确保不被
   .onb-field-input/.onb-picker 等基础规则的后续调整意外覆盖 */
.org-form-input {
  width: 100% !important;
  box-sizing: border-box !important;
  background: #F9FAFB !important;
  border: 1rpx solid #E5E7EB !important;
  border-radius: 12rpx !important;
  padding: 20rpx 24rpx !important;
  font-size: 28rpx !important;
  color: #1F2937 !important;
  margin-top: 10rpx !important;
  margin-bottom: 20rpx !important;
}

.org-form-input:focus {
  border-color: #D97706 !important;
  background: #FFFFFF !important;
}

/* 🆕 表单辅助说明：改为挂在标签右侧的细小灰字，替代原先输入框下方独占一行的
   长段提示文字块——视线不再被大段说明打断，只在本弹窗内使用。Label 与提示文案
   横向 inline 排布，两端对齐；提示文案单行截断，不再折行挤压表单纵向空间 */
.onb-field-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 🆕 本弹窗规范类名：Label 主标题，居左，与提示文案（.onb-field-label-hint）
   形成粗体深色 / 细体浅色的明显字重对比，只挂在组织信息配置弹窗内的三个
   Label 上（.onb-field-label 共享基类本身仍保持零样式，不影响入驻引导弹窗） */
.org-field-label {
  font-size: 28rpx; /* 14px */
  font-weight: bold;
  color: #333333;
}

.onb-field-label-hint {
  font-size: 22rpx; /* 11px */
  color: #999999;
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 🆕 机构类型选择器：浅灰卡片背景 + 细边框，叠加在 .onb-picker/.org-form-input
   之上，!important 与本文件其余强约束单行/表单样式同一套约定。height 改为 auto + padding
   精确控制卡片尺寸（垂直 10px / 水平 12px），不再依赖固定 80rpx 高度撑开 */
.org-type-picker {
  height: auto !important;
  min-height: 80rpx;
  background: #F8F9FA !important;
  border: 1rpx solid #E9ECEF !important;
  border-radius: 16rpx !important;
  padding: 20rpx 24rpx !important;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.org-type-picker-arrow {
  transform: rotate(0deg);
  font-size: 22rpx !important;
  color: #ADB5BD !important;
}

/* 🆕 本弹窗规范类名：浅灰下拉箭头，叠加在 .org-type-picker-arrow 之上，
   同一颜色/字号，仅作为对外可寻址的规范类名 */
.picker-arrow {
  color: #ADB5BD;
  font-size: 22rpx;
}

/* 🆕 文化寄语 / 家训配置：改回纵向上下分布，每句独立占满一行，
   避免像并排双列那样把文字挤压裁剪截断 */
.culture-slogan-row {
  display: flex;
  flex-direction: column;
  width: 100%;
  gap: 12rpx;
}

.culture-slogan-col {
  width: 100%;
}

.culture-slogan-sub-label {
  display: block;
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 12rpx;
  margin-bottom: 4rpx;
}

.culture-slogan-input {
  width: 100% !important;
  margin-top: 0 !important;
  margin-bottom: 16rpx !important; /* 8px */
}

/* ---- 固定底部提交按钮 ---- */
.onb-footer {
  flex-shrink: 0;
  /* 120rpx = 100rpx TabBar 高度 + 20rpx 视觉间距，确保按钮在任何设备（含无底部 Home 条）
     都不被自定义 TabBar 遮挡；env(safe-area-inset-bottom) 另行叠加处理 iPhone 刘海 */
  padding: 20rpx 40rpx calc(120rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #F3F4F6;
}

.onb-submit-btn {
  height: 88rpx;
  line-height: 88rpx;
  background: #2563EB;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 44rpx;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.25);
}

.onb-submit-btn--loading {
  background: #93C5FD;
  box-shadow: none;
}

/* 🆕 组织信息配置弹窗·暖色品牌主按钮：与首页/个人页其余暖金色系（.user-profile-card
   渐变、.org-type-badge 等）保持一致，替换掉与「新建组织」引导弹窗共用的默认蓝色。
   .org-config-submit-btn 只加在这一个弹窗的按钮上，.onb-submit-btn 的蓝色基础样式
   对引导弹窗保持不变 */
.org-config-submit-btn {
  background: linear-gradient(135deg, #D97706 0%, #B45309 100%);
  box-shadow: 0 6rpx 16rpx rgba(180, 83, 9, 0.25);
  /* 🆕 独立的底部安全外边距：即便日后 .onb-footer 的公共 padding 调整，
     本弹窗的保存按钮也始终与安全区/Home 条保持至少 40rpx 间距 */
  margin-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  margin-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.org-config-submit-btn.onb-submit-btn--loading {
  background: #FBBF7D;
  box-shadow: none;
}

/* 🆕 保存按钮点击态微交互：只挂在本弹窗按钮的 hover-class 上，
   入驻引导弹窗的按钮没有加这个 hover-class，互不影响 */
.org-config-submit-btn-hover {
  transform: scale(0.97);
  opacity: 0.9;
}

/* ── 🎨 组织信息配置 Modal — Logo 上传区 ──────────────────────────── */
.orgcfg-logo-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  margin-top: 12rpx;
}

.orgcfg-logo-preview-wrap {
  position: relative;
  width: 160rpx; /* 80px */
  height: 160rpx; /* 80px */
  flex-shrink: 0;
}

.orgcfg-logo-preview {
  width: 160rpx; /* 80px */
  height: 160rpx; /* 80px */
  border-radius: 16rpx;
  border: 2rpx solid #E5E7EB;
  flex-shrink: 0;
}

/* 🆕 悬浮操作按钮组：预览图右上角 ↻ 更换 / ✕ 删除两枚微型圆按钮，
   替代原先并排的「重新上传」文字链接，见 onUploadOrgLogo / onClearOrgLogo */
.orgcfg-logo-actions {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  display: flex;
  gap: 8rpx;
}

.orgcfg-logo-action-btn {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(31, 41, 55, 0.75);
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 36rpx;
  text-align: center;
}

.orgcfg-logo-action-btn--danger {
  background: rgba(220, 38, 38, 0.85);
}

.orgcfg-logo-placeholder {
  width: 160rpx; /* 80px */
  height: 160rpx; /* 80px */
  border-radius: 8px;
  border: 1px dashed #DCDFE6;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F9FAFB;
  flex-shrink: 0;
}

/* 🆕 相机图标外面加一层淡色圆形底，提升"带背景的图标"质感 */
.orgcfg-logo-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #FFF5F0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.orgcfg-logo-icon {
  font-size: 32rpx;
  line-height: 1;
}

.orgcfg-logo-hint {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 6rpx;
}

/* 组织信息配置弹窗高权重覆盖样式 */
.onb-panel .onb-field-label-row {
  display: flex !important;
  justify-content: space-between !important;
  align-items: center !important;
  margin-bottom: 6rpx !important;
}

.onb-panel .onb-field-label-hint {
  font-size: 22rpx !important;
  color: #999999 !important;
  font-weight: normal !important;
  white-space: nowrap !important;
}

.onb-panel .org-type-picker {
  background-color: #F8F9FA !important;
  border-radius: 16rpx !important;
  padding: 20rpx 24rpx !important;
  display: flex !important;
  justify-content: space-between !important;
  align-items: center !important;
}

.onb-panel .culture-slogan-row {
  display: flex !important;
  flex-direction: column !important;
  width: 100% !important;
  gap: 16rpx !important;
}

.onb-panel .culture-slogan-input {
  width: 100% !important;
  box-sizing: border-box !important;
}

.onb-panel .org-config-submit-btn {
  margin-bottom: calc(40rpx + env(safe-area-inset-bottom)) !important;
}
