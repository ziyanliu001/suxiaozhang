.mine-page-container {
  min-height: 100vh;
  background-color: #FDF6E3;
  box-sizing: border-box;
}

.status-bar-spacer {
  width: 100%;
}

.nav-title-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  position: relative;
}

.page-title-txt {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
}

.quick-sheet-trigger-btn {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-sheet-trigger-btn:active {
  opacity: 0.6;
}

.quick-sheet-trigger-icon {
  font-size: 36rpx;
  font-weight: bold;
  color: #666666;
  line-height: 1;
}

.mine-content-wrapper {
  /* 底部预留三段式导航栏高度（100rpx）+ 安全区，避免最后一项被遮挡 */
  padding: 20rpx 24rpx calc(100rpx + env(safe-area-inset-bottom) + 40rpx) 24rpx;
  box-sizing: border-box;
}

.user-profile-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  border: 1rpx solid #EFE6D8;
  box-shadow: 0 6rpx 20rpx rgba(239, 230, 216, 0.3);
  margin-bottom: 30rpx;
}

/* 🐛 头像"严重放大只看到局部色块"根因排查：交叉测试确认同一张照片走食谱照片的普通
   <view><image> 结构完全正常，问题限定在头像——而头像与食谱照片唯一的结构性差异，
   就是头像的 <image> 之前被嵌套在 <button open-type="chooseAvatar"> 原生组件内部。
   现改为：可见展示（.avatar-outer 及以下）搬到 .avatar-tap-wrap 这个普通 <view> 下，
   与 chooseAvatar 按钮变成兄弟节点；按钮本身降级为铺满同一区域的纯透明点击热区
   （.avatar-choose-btn-overlay），只负责触发选择事件，不再包裹/展示任何内容。
   固定 128rpx×128rpx 尺寸与热区/视觉重合的设计保持不变，仅仅是从按钮身上移到
   .avatar-tap-wrap 身上。 */
.avatar-tap-wrap {
  position: relative;
  width: 128rpx !important;
  height: 128rpx !important;
  min-width: 128rpx;
  min-height: 128rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.avatar-choose-btn-overlay {
  position: absolute !important;
  top: 0;
  left: 0;
  width: 100% !important;
  height: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
  background: transparent !important;
  border-radius: 50%;
  z-index: 2;
}

.avatar-choose-btn-overlay::after {
  border: none;
}

/* 🐛 圆形裁剪失效修复：此前头像角标是 .avatar-ring 的子元素，导致 .avatar-ring
   不敢加 overflow:hidden（加了会把角标一起裁掉），圆形裁剪只能靠最内层 .user-avatar
   单独兜底，在部分渲染环境下不够可靠。现拆成两层：.avatar-outer 只负责定位，
   .avatar-ring 专职裁剪（overflow:hidden + border-radius:50%）。角标已移除，
   保留这层拆分是因为它本身就是让圆形裁剪稳定生效的正确结构，不依赖角标是否存在。
   🛡️ 物理锁死：width/height 由 100%（相对 .avatar-tap-wrap 128rpx 解出）改为直接
   写死 128rpx，链路上不再有任何百分比宽高需要逐层解析。 */
.avatar-outer {
  width: 128rpx !important;
  height: 128rpx !important;
  position: relative;
  flex-shrink: 0;
  box-sizing: border-box;
}

/* 🌟 渐变金边头像环：padding-box 撑开渐变描边，内层裁切绝对正圆，
   彻底杜绝头像变形/背景裁切异常，同时提升整体质感。
   🛡️ 物理锁死：同上，改百分比为写死 128rpx；4rpx padding + box-sizing:border-box
   解出的内容区正好是 120rpx，与 .user-avatar 的固定尺寸严丝合缝，不依赖任何
   百分比换算。 */
.avatar-ring {
  width: 128rpx !important;
  height: 128rpx !important;
  border-radius: 50% !important;
  overflow: hidden !important;
  padding: 4rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #F1C40F 0%, #E8B923 45%, #EFE6D8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-avatar {
  /* 🐛 回退为显式 rpx 定值：<image mode="aspectFill"> 配合百分比宽高在 flex 容器
     （.avatar-ring 是 align-items:center，不会拉伸子项撑满）里计算裁剪区域时不够可靠，
     曾观察到按图片自身原始像素尺寸而非容器尺寸取景、出现"放大只看到中间"的现象。
     父级 .avatar-ring 内容区本就是固定 120rpx×120rpx，这里直接写死定值更稳妥。
     🛡️ 这条 !important 规则本身从一开始就是对的——真正的问题是 WXML 里 <image>
     标签自己的行内 style 曾用 width:100% !important 把这条规则盖掉了，已在
     profile.wxml 里移除那处行内覆盖，现在这条规则能不受干扰地直接生效。 */
  width: 120rpx !important;
  height: 120rpx !important;
  border-radius: 50% !important;
  display: block;
  overflow: hidden !important;
  box-sizing: border-box;
  background: #F1EFEA;
  /* 🛡️ 与 mode="aspectFill" 是同一语义的双保险：object-fit 在部分基础库/渲染路径下
     对 <image> 生效更可靠，两者一起兜底，不冲突 */
  object-fit: cover !important;
}

.user-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  background: #F1EFEA;
}

.user-meta-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.nickname-edit-row {
  display: flex;
  align-items: center;
  overflow: hidden;
}

/* 🐛 彻底修复昵称与编辑图标重叠：裁切边界交给这层普通 <view>（flex:1 抢占剩余空间，
   min-width:0 允许在 flex 容器里正常收缩，overflow:hidden 做硬裁切），
   不再依赖原生 <input> 自身的 text-overflow——那个在部分机型上不可靠。 */
.nickname-input-wrap {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

/* 昵称输入框：视觉上仍表现为普通文字，聚焦编辑时才显现输入态；
   width:100% 撑满外层 wrap 分配到的空间，真正的裁切由外层 wrap 的 overflow:hidden 保证，
   这里的 white-space/text-overflow 仅作为该组件支持时的锦上添花，不是唯一防线 */
.user-nickname-input {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-sizing: border-box;
}

.edit-profile-icon-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 6rpx;
}

.edit-profile-icon-btn:active {
  opacity: 0.6;
}

.role-badge-row {
  display: flex;
}

.badge-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 20rpx;
  font-weight: bold;
  color: #8C1D18;
  background: #FFF0ED;
  border: 1rpx solid #FFCDD2;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.badge-tag.super_admin {
  background: #FFF9E6;
  color: #B57C1E;
  border-color: #FFE082;
}

.badge-tag.store_manager {
  background: #FFF3E0;
  color: #E65100;
  border-color: #FFCC80;
}

.badge-tag.finance {
  background: #E8F5E9;
  color: #2E7D32;
  border-color: #A5D6A7;
}

/* 🏛️ 雨花家长：与超管/店长/财务视觉区隔的暖金棕色系，呼应家长管理卡片的配色 */
.badge-tag.store_patriarch {
  background: #FFFBF0;
  color: #8C1D18;
  border-color: #E6D0A0;
}

/* 🌟 提升荣誉感：淡金色底 + 深棕色文字，志工身份也拥有仪式感的专属配色 */
.badge-tag.volunteer {
  background: #F9E79F;
  color: #784212;
  border-color: #F1C40F;
}

/* ❤️ 家人（服务对象）：暖红系配色，与志工的金色系明确区分开 */
.badge-tag.family {
  background: #FFF0ED;
  color: #C0392B;
  border-color: #FFCDD2;
}

/* ❤️ 家人（服务对象）极简关怀版面：与 merit-board-card 同款卡片骨架，
   暖红色系与志工的金色系区分开，突出"关怀"而非"荣誉" */
.family-care-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(155deg, #FFF8F7 0%, #FFFFFF 55%);
  border: 1rpx solid #FFE0DB;
  border-radius: 28rpx;
  padding: 32rpx 20rpx 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 224, 219, 0.3);
  margin-bottom: 30rpx;
}

.family-care-card .header-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #C0392B;
  letter-spacing: 2rpx;
}

.family-care-hint {
  position: relative;
  z-index: 1;
  display: block;
  font-size: 24rpx;
  color: #8C4A42;
  line-height: 1.6;
  text-align: center;
  margin-bottom: 24rpx;
  padding: 0 12rpx;
}

/* 🛡️ 视觉统一：此前是半透明白 rgba(255,255,255,0.6)，会透出 .family-care-card 自身
   的暖粉渐变背景，列表看起来泛淡黄/奶咖色。改为纯不透明白，与义工版本"日常记录"
   列表（.action-list-container 默认就是纯白）保持一致 */
.family-care-list {
  position: relative;
  z-index: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
}

/* 卡片内嵌的"日常记录"小标题：与 .list-group-label 同一套弱化语义分组样式，
   只是紧跟在关怀语之后，顶部留白收窄一些，避免和上面的 hint 文字挤在一起 */
.family-care-list-label {
  margin-top: 0;
}

.merit-board-card {
  position: relative;
  overflow: hidden;
  /* 🌟 简化背景：去掉此前干扰读数的满铺心形纹理，改为柔和的单向渐变，
     仅在右上角留一枚极淡的莲花水印作点缀，视觉焦点回归数字本身 */
  background: linear-gradient(155deg, #FFFDF7 0%, #FFFFFF 55%);
  border: 1rpx solid #EFE6D8;
  border-radius: 28rpx;
  padding: 32rpx 20rpx 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(239, 230, 216, 0.3);
  margin-bottom: 30rpx;
}

.merit-board-card::after {
  content: "";
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  width: 160rpx;
  height: 160rpx;
  background-image: url('data:image/svg+xml;base64,');
  background-repeat: no-repeat;
  background-size: contain;
  pointer-events: none;
}

.board-header {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.board-header .header-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #8C1D18;
  letter-spacing: 2rpx;
}

/* 核心数据：护持天数 / 累计工时 —— 大号加粗，突出荣誉感 */
.merit-hero-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.merit-hero-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.merit-hero-divider {
  width: 1rpx;
  height: 64rpx;
  background: #EFE6D8;
  flex-shrink: 0;
}

.merit-hero-num {
  font-size: 64rpx;
  font-weight: bold;
  color: #8C1D18;
  line-height: 1.15;
  margin-bottom: 8rpx;
}

.merit-hero-label {
  font-size: 22rpx;
  color: #A08A6A;
  font-weight: 500;
}

/* 次要数据：登记餐报 / 稽核账本 —— 仅店长/财务/超管可见，弱化为辅助信息条。
   🌟 与上方护持天数/累计工时拉开更明确的垂直间距（24→36rpx），主次数据分组更清晰 */
.merit-sub-row {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-top: 36rpx;
  padding-top: 26rpx;
  border-top: 1rpx dashed #EFE6D8;
}

.merit-sub-cell {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.merit-sub-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #666666;
}

.merit-sub-label {
  font-size: 20rpx;
  color: #999999;
}

/* 分组小标题：弱化视觉但清晰划分列表语义分组，替代此前一整块无分组的长列表 */
.list-group-label {
  font-size: 22rpx;
  font-weight: bold;
  color: #A08A6A;
  padding: 0 12rpx;
  margin: 8rpx 0 14rpx;
}

/* 🌟 超级管理员视角切换卡片：此前 #F1C40F 是高饱和度亮黄，和整卡"预览/管理"的克制调性
   不太搭，观感偏刺眼。改为低饱和度淡金边 + 更浅的底色，与常规列表项区分开的同时，
   更贴近财务/管理场景该有的沉稳质感；文字颜色（#B57C1E 金棕）保持不变。 */
.view-mode-switch-card {
  background: #FFFBF0;
  border: 1rpx solid #E6D0A0;
  border-radius: 28rpx;
  padding: 10rpx 0;
  margin-bottom: 30rpx;
  overflow: hidden;
}

.view-mode-switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 32rpx;
}

.view-mode-switch-row:active {
  background: #FFF9E6;
}

.view-mode-current-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.view-mode-current-label {
  font-size: 26rpx;
  color: #B57C1E;
  font-weight: bold;
}

.view-mode-hint {
  display: block;
  font-size: 20rpx;
  color: #B57C1E;
  line-height: 1.5;
  padding: 0 32rpx 20rpx;
}

/* ===== 🏛️ 家长管理 / 资源兜底：内嵌自原 pages/patriarch-dashboard，样式沿用
   该页原有的 pd-* 命名，外层包一层与本页其余卡片一致的金边容器 ===== */
.patriarch-panel-card {
  background: #FFFBF0;
  border: 1rpx solid #E6D0A0;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
  box-sizing: border-box;
}

.patriarch-panel-header {
  margin-bottom: 16rpx;
}

.patriarch-panel-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #8C1D18;
}

.pd-health-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.pd-health-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
  margin-bottom: 16rpx;
}

.pd-health-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.pd-health-cell {
  background: #F8F9FA;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.pd-health-lbl {
  font-size: 22rpx;
  color: #868E96;
}

.pd-health-val {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
}

.pd-health-val.green {
  color: #2B8A3E;
}

.pd-health-val.red {
  color: #E03131;
}

.pd-verify-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #F1F3F5;
}

.pd-verify-icon {
  font-size: 24rpx;
}

.pd-verify-text {
  font-size: 24rpx;
  color: #495057;
}

.pd-section-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 20rpx 0 12rpx;
}

.pd-section-icon {
  font-size: 24rpx;
}

.pd-section-txt {
  font-size: 26rpx;
  font-weight: bold;
  color: #D48806;
}

.pd-void-card,
.pd-profile-card {
  background: #FFFBE6;
  border: 1rpx solid #FFE58F;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.pd-void-info {
  margin-bottom: 16rpx;
}

.pd-void-date {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
  margin-bottom: 6rpx;
}

.pd-void-amount {
  font-size: 22rpx;
  color: #868E96;
}

.pd-profile-items {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 20rpx;
  margin-bottom: 16rpx;
}

.pd-profile-item {
  font-size: 24rpx;
  color: #5C4326;
}

.pd-void-actions {
  display: flex;
  gap: 16rpx;
}

.pd-btn-reject {
  flex: 1;
  background: #F1F3F5;
  color: #495057;
  border-radius: 12rpx;
  font-size: 26rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.pd-btn-approve {
  flex: 1;
  background: #D48806;
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: bold;
  height: 72rpx;
  line-height: 72rpx;
}

.pd-empty-tip {
  text-align: center;
  padding: 40rpx 0;
  color: #ADB5BD;
  font-size: 24rpx;
}

.pd-loading-box {
  text-align: center;
  padding: 40rpx 0;
  color: #ADB5BD;
  font-size: 24rpx;
}

/* 📮 爱心意见箱管理入口：店长/家长/超管共用的 patriarch-panel-card 内新增区块 */
.pd-feedback-entry-title {
  margin-top: 8rpx;
}

.pd-feedback-entry-cell {
  background: #FAF8F5;
  border-radius: 16rpx;
  margin: 0;
}

.pd-feedback-entry-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 🔴 .unread-badge 与 .badge 共用同一套醒目红色圆角数字角标样式——.badge 一般
   放在行尾（靠近箭头），.unread-badge 紧跟在入口标题文字右侧（如"我的餐报
   提交记录"），两种排布位置不同但视觉语言保持一致 */
.badge,
.unread-badge {
  display: inline-block;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #E03131;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: bold;
  text-align: center;
  box-sizing: border-box;
}

.action-list-container {
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 28rpx;
  padding: 10rpx 0;
  margin-bottom: 30rpx;
  overflow: hidden;
}

.action-item-cell {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 32rpx;
  background: #FFFFFF;
}

.action-item-cell:not(:last-child) {
  border-bottom: 1rpx solid #FAF6F0;
}

.action-item-cell:active {
  background: #FAF8F5;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.item-text {
  font-size: 26rpx;
  color: #444444;
  font-weight: 500;
  line-height: 1;
}

.item-arrow {
  font-size: 20rpx;
  color: #C7C7CC;
}

/* 🌟 店长专属管理入口："淡金底强化行"语言，让店长在自己的个人页里
   一眼看到这一行明显跟普通义工看到的列表不一样——权限层级的视觉区隔，不只是多一行文字 */
.manager-only-cell {
  background: linear-gradient(135deg, #FFFDF5 0%, #FFF3E0 100%);
}

.manager-only-cell:active {
  background: #FFE9C4;
}

.manager-only-emoji {
  font-size: 32rpx;
  width: 38rpx;
  flex-shrink: 0;
  text-align: center;
}

/* 关于与帮助分组内的"切换身份"行：保留列表统一样式，仅文字提示危险语义 */
.danger-cell:active {
  background: #FFF5F5;
}

.item-text.danger-text {
  color: #D32F2F;
}

/* 低权限自助入口：刻意置于列表最下方且弱化视觉，符合"高权限低频功能不抢焦点"的排版逻辑 */
.subtle-group {
  margin-bottom: 30rpx;
}

.subtle-cell {
  padding: 22rpx 32rpx;
}

.subtle-text {
  color: #999999;
  font-weight: 400;
  font-size: 24rpx;
}

.subtle-icon {
  opacity: 0.45;
}

/* 开发者与超管工具箱：独立成卡（原先依附在 .action-list-container 内，
   现已拆分为独立分组，需要补回卡片背景/边框，避免变成无背景的裸列表） */
.admin-developer-section {
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 28rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
}

.admin-divider {
  font-size: 20rpx;
  font-weight: bold;
  color: #8E8E93;
  background: #F2F2F7;
  padding: 10rpx 32rpx;
}

/* ==========================================
   🌟 核心修复：高兼容性 SVG 矢量背景图注入
   ========================================== */

.item-icon-svg {
  width: 38rpx;
  height: 38rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  flex-shrink: 0;
}

.badge-icon-svg {
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  display: inline-block;
  vertical-align: middle;
}

.header-icon-svg {
  width: 32rpx;
  height: 32rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.flip-x {
  transform: scaleX(-1);
}

/* 🌟 统一菜单图标色调为深古铜色（不使用红色），提升整体质感的同时更符合"荣誉"而非"警示"的调性 */
.icon-svg-history { background-image: url('data:image/svg+xml;base64,'); }

.icon-svg-about { background-image: url('data:image/svg+xml;base64,'); }

.icon-svg-key { background-image: url('data:image/svg+xml;base64,'); }

.icon-svg-clear { background-image: url('data:image/svg+xml;base64,'); }

/* 🐛 顺带修复：原图标末尾坐标是损坏数据 y2="1*"，已修正为合法的 21 */
.icon-svg-screen { background-image: url('data:image/svg+xml;base64,'); }

/* 🐛 顺带修复：原图标 base64 数据已损坏（含非法字节，浏览器会渲染为空白/破图），重新绘制为简洁莲花双瓣造型 */
.icon-svg-flower { background-image: url('data:image/svg+xml;base64,'); }

/* 新增：昵称行编辑入口图标（简洁铅笔造型） */
.icon-svg-edit { background-image: url('data:image/svg+xml;base64,'); }

.icon-svg-release { background-image: url('data:image/svg+xml;base64,'); }

/* ==========================================
   🚪 卸任特权 Warning 弹窗
   ========================================== */
.release-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.release-modal-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.release-modal-card {
  width: 82%;
  max-width: 620rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 36rpx 36rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  transform: scale(0.9) translateY(20rpx);
  opacity: 0;
  transition: all 0.25s ease;
}

.release-modal-mask.show .release-modal-card {
  transform: scale(1) translateY(0);
  opacity: 1;
}

.release-warning-icon {
  display: block;
  text-align: center;
  font-size: 72rpx;
  margin-bottom: 20rpx;
  line-height: 1;
}

.release-modal-title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
  margin-bottom: 32rpx;
  line-height: 1.5;
}

.release-role-highlight {
  color: #D32F2F;
}

.release-consequence-list {
  background: #FFF5F5;
  border: 1.5rpx solid #FFCDD2;
  border-radius: 20rpx;
  padding: 24rpx 24rpx 8rpx;
  margin-bottom: 36rpx;
}

.release-consequence-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.bullet-dot {
  font-size: 26rpx;
  color: #D32F2F;
  margin-right: 12rpx;
  line-height: 1.6;
  flex-shrink: 0;
}

.bullet-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #5C5C5C;
  line-height: 1.6;
  word-break: break-all;
}

.release-consequence-item.danger .bullet-text {
  color: #D32F2F;
  font-weight: bold;
}

.release-modal-footer {
  display: flex;
  gap: 20rpx;
}

.release-btn-cancel,
.release-btn-confirm {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 42rpx;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.release-btn-cancel::after,
.release-btn-confirm::after {
  border: none;
}

.release-btn-cancel {
  background: #F1F3F5;
  color: #495057;
}

.release-btn-cancel:active {
  transform: scale(0.96);
  background: #E9ECEF;
}

.release-btn-confirm {
  background: linear-gradient(135deg, #E53935 0%, #C62828 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(198, 40, 40, 0.35);
}

.release-btn-confirm:active {
  transform: scale(0.96);
  opacity: 0.9;
  box-shadow: 0 4rpx 10rpx rgba(198, 40, 40, 0.3);
}

/* ================= 🏅 数字荣誉墙 ================= */

.honor-wall-card {
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 28rpx;
  padding: 24rpx 28rpx 28rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 6rpx 20rpx rgba(239, 230, 216, 0.3);
}

/* 🛠️ 义工现场服务工具：外层卡片只负责包住列表 + 底部提示语，
   列表本身复用通用 .action-list-container，不重复一套列表样式 */
.volunteer-tools-card {
  margin-bottom: 30rpx;
}

.volunteer-tools-card .action-list-container {
  margin-bottom: 12rpx;
}

.volunteer-tools-hint {
  display: block;
  font-size: 22rpx;
  color: #A08A6A;
  line-height: 1.6;
  padding: 0 12rpx;
}

.honor-wall-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.honor-wall-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
}

.honor-wall-cert-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: #8C1D18;
}

.honor-badge-scroll {
  width: 100%;
  white-space: nowrap;
}

.honor-badge-row {
  display: flex;
  gap: 28rpx;
  padding: 4rpx 4rpx 8rpx;
}

.honor-badge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  width: 108rpx;
  transition: transform 0.15s ease;
}

.honor-badge-item:active {
  transform: scale(0.94);
}

.honor-badge-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 已解锁：饱满金色渐变 + 微光投影，点击时整体缩放做"微光"反馈（见 .honor-badge-item:active） */
.honor-badge-item.unlocked .honor-badge-circle {
  background: linear-gradient(135deg, #F1C40F 0%, #B8860B 100%);
  box-shadow: 0 0 0 4rpx #FFF3BF, 0 6rpx 16rpx rgba(184, 134, 11, 0.45);
}

.honor-badge-item.unlocked .honor-badge-emoji {
  font-size: 44rpx;
}

.honor-badge-item.unlocked .honor-badge-name {
  color: #8C1D18;
  font-weight: bold;
}

/* 未解锁：整体置灰半透明，与已解锁形成清晰的"未达成"视觉信号 */
.honor-badge-item.locked .honor-badge-circle {
  background: #E9ECEF;
  opacity: 0.4;
}

.honor-badge-item.locked .honor-badge-emoji {
  font-size: 40rpx;
  filter: grayscale(100%);
}

.honor-badge-item.locked .honor-badge-name {
  color: #ADB5BD;
}

.honor-badge-name {
  font-size: 20rpx;
  text-align: center;
}

/* ================= 🌟 义工证书 Modal ================= */

/* 🐛 硬性根治：本弹窗（驳回原因/拒绝申请原因等）经常是从「待审核的义工餐报与
   物资」这类半屏抽屉（.feedback-sheet-backdrop/.feedback-sheet-panel，
   z-index: 999998/999999 !important）里点开的二级弹窗。此前 z-index: 2000
   远低于抽屉的层级，导致弹出后视觉上仍被压在抽屉下面、看不见驳回输入框。
   这里顶到比抽屉更高的层级，并同样用 !important 排除任何后续样式意外覆盖 */
.certificate-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999999 !important;
}

.certificate-modal-card {
  width: 88%;
  max-width: 660rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 24rpx 32rpx;
  box-sizing: border-box;
}

.certificate-modal-header {
  display: flex;
  align-items: center;
  /* 标题文字已删除，header 现在只剩关闭按钮——改成 flex-end 让它继续贴右上角，
     不再需要 space-between 那种"两端对齐"布局 */
  justify-content: flex-end;
  margin-bottom: 20rpx;
}

.certificate-modal-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #F1F3F5;
  color: #6B7280;
  font-size: 24rpx;
}

/* 🏷️ 快捷驳回标签：常见驳回原因一键填入，减少店长手动打字 */
.quick-reject-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.quick-reject-tag {
  font-size: 22rpx;
  color: #6B5B45;
  background: #F5F0E6;
  border: 1rpx solid #E5DCC8;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  line-height: 1.4;
}

.quick-reject-tag.active {
  color: #FFFFFF;
  background: #C0392B;
  border-color: #C0392B;
}

.certificate-canvas-wrap {
  position: relative;
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  background: #F1E6C8;
  /* Canvas 用 style 里的 px 精确控制尺寸（与 drawVolunteerCertificate 的 width/height 参数一致），
     这里用等比留白让容器高度跟随，避免绘制中/绘制前出现明显的高度跳变 */
  min-height: 480rpx;
  /* 给证书卡片加一圈投影，让它从弹窗背景里"浮"出来，更有实体证书的质感 */
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
}

.certificate-canvas {
  position: absolute;
  top: 0;
  left: 0;
  /* Canvas 节点本身不需要可见——它只是绘制源，最终展示的是下面的 <image>；
     保留在文档流里但视觉上完全被 image 盖住即可，不需要额外裁剪技巧 */
}

.certificate-preview-img {
  position: relative;
  width: 100%;
  display: block;
  border-radius: 16rpx;
}

.certificate-loading-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(251, 246, 233, 0.9);
  font-size: 24rpx;
  color: #8C6D46;
}

.certificate-save-btn {
  margin-top: 40rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #B8860B 0%, #DAA520 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(184, 134, 11, 0.35);
}

.certificate-save-btn::after {
  border: none;
}

.certificate-save-btn:active {
  opacity: 0.85;
  box-shadow: 0 2rpx 6rpx rgba(184, 134, 11, 0.2);
}

.certificate-save-btn[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

/* 家人证书专属操作按钮：与义工版 certificate-save-btn 同一套暖金质感，
   与义工按钮独立成一份，避免共用类名时因家人分支 disabled 语义不同而互相牵连 */
.certificate-family-save-btn {
  margin-top: 24rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #B8860B 0%, #DAA520 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(184, 134, 11, 0.35);
}

.certificate-family-save-btn::after {
  border: none;
}

.certificate-family-save-btn:active {
  opacity: 0.85;
  box-shadow: 0 2rpx 6rpx rgba(184, 134, 11, 0.2);
}

/* 🌸 家人版纯文本证书：与义工版 Canvas 证书共用同一个 certificate-modal-mask/
   certificate-modal-card 弹窗壳，这里只负责正文区域的排版，不含 Canvas/二维码。
   宣纸暖米白底 + 双重古典边框 + 朱红印鑑，营造纸质荣誉证书的仪式感 */
.certificate-family-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 8rpx 8rpx;
  background: #FAF6F0;
  border-radius: 12rpx;
}

.cf-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.cf-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #8C1D18;
  letter-spacing: 2rpx;
}

/* 双重边框：外层 certificate-family-body 的暖米白底本身算作外圈，
   这里再加一圈实线 + 内边距，形成"证书纸+装裱边框"的双层观感 */
.cf-inner-border {
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid #E2D1B2;
  padding: 24rpx;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.certificate-family-icon {
  font-size: 56rpx;
  margin-bottom: 20rpx;
}

/* 抬头顶格加粗：与正文分开单独一行，模拟传统证书"尊敬的...："起首语气 */
.cert-salutation {
  align-self: stretch;
  font-size: 28rpx;
  font-weight: bold;
  color: #5A3E2B;
  margin-bottom: 16rpx;
  text-align: left;
}

/* 正文段落：首行缩进两字 + 两端对齐，贴近实体证书的排版手感 */
.cert-paragraph {
  align-self: stretch;
  font-size: 26rpx;
  color: #6C4F3B;
  line-height: 1.8;
  text-indent: 2em;
  text-align: justify;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.cf-signature-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  align-self: stretch;
  gap: 16rpx;
  margin-top: 32rpx;
}

.cf-signature-text {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.cf-sign-line {
  font-size: 24rpx;
  color: #6B4C1E;
  line-height: 1.5;
}

/* 朱红古典印鑑：正方形、微旋转，模拟盖章时的随手歪斜手感 */
.cf-seal {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  border: 3rpx solid #C0392B;
  border-radius: 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform: rotate(-6deg);
  color: #C0392B;
  opacity: 0.88;
  box-shadow: 0 0 0 1rpx rgba(192, 57, 43, 0.15) inset;
}

.cf-seal-line {
  font-size: 22rpx;
  font-weight: bold;
  line-height: 1.3;
}

/* 🌸 雨花温情故事说明弹窗：与 certificate-modal-* 同一套弹窗视觉规范 */
.warm-story-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.warm-story-modal-card {
  width: 88%;
  max-width: 660rpx;
  background: linear-gradient(155deg, #FFF8F0 0%, #FFFFFF 60%);
  border-radius: 28rpx;
  padding: 28rpx 24rpx 32rpx;
  box-sizing: border-box;
}

.warm-story-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.warm-story-modal-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #222222;
}

.warm-story-modal-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #F1F3F5;
  color: #6B7280;
  font-size: 24rpx;
}

.warm-story-modal-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 4rpx 0;
}

.warm-story-modal-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

/* 正文段落：改居中为两端对齐 + 首行缩进两字，贴近实体文章的阅读排版；
   align-self:stretch 覆盖父级 .warm-story-modal-body 的 align-items:center
   （默认会把文本框收缩成"内容多宽就多宽"，text-indent/justify 需要撑满整行才有意义） */
.warm-story-modal-text {
  display: block;
  align-self: stretch;
  font-size: 26rpx;
  color: #6B4C1E;
  line-height: 1.8;
  text-align: justify;
  text-indent: 2em;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.warm-story-view-log-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  margin-top: 12rpx;
  background: linear-gradient(135deg, #E6A23C 0%, #DAA520 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 42rpx;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(230, 162, 60, 0.35);
}

.warm-story-view-log-btn::after {
  border: none;
}

.warm-story-view-log-btn:active {
  opacity: 0.85;
}

/* 📮 爱心意见箱：半屏底部弹窗，与 mine-quick-sheet 组件同一套 backdrop/panel/
   drag-handle 视觉规范（fixed 遮罩 + 底部滑出面板），保持全站弹窗手感统一 */
/* 🐛 自定义 TabBar（custom-tab-bar，z-index: 998）曾经把本弹窗底部的提交按钮
   盖住——弹窗结构里没有独立的遮罩层元素，.feedback-sheet-backdrop 本身同时
   兼任"全屏遮罩"与"面板定位容器"两个角色，这里用 !important 顶到最高层级，
   排除任何后续样式意外覆盖的可能 */
.feedback-sheet-backdrop {
  position: fixed !important;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999998 !important;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  opacity: 0;
  transition: opacity 0.25s ease;
}

.feedback-sheet-backdrop.show {
  opacity: 1;
}

.feedback-sheet-panel {
  position: relative;
  z-index: 999999 !important;
  width: 100%;
  background: #FBF9F5;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  /* 140rpx 安全抬升边距：custom-tab-bar 实际高度 100rpx，这里额外多留 40rpx
     缓冲，确保提交按钮完整露在 TabBar 上方——不再依赖按钮自己的 padding-bottom
     去凑这个安全区，直接在面板层级一次性预留够 */
  padding: 16rpx 28rpx calc(140rpx + env(safe-area-inset-bottom)) !important;
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.25s ease;
}

.feedback-sheet-backdrop.show .feedback-sheet-panel {
  transform: translateY(0);
}

.feedback-sheet-drag-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #E3D9C8;
  margin: 0 auto 24rpx;
}

.feedback-sheet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.feedback-sheet-header-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.feedback-sheet-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.feedback-sheet-subtitle {
  font-size: 22rpx;
  color: #A08A6A;
}

.feedback-sheet-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #F1F3F5;
  color: #6B7280;
  font-size: 24rpx;
  flex-shrink: 0;
}

/* 💌 家人意见箱双 Tab：提交建议 / 我的反馈与回复 */
.feedback-modal-tab-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #F1EBE0;
}

.feedback-modal-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #A08A6A;
  border-bottom: 4rpx solid transparent;
}

.feedback-modal-tab.active {
  color: #B8860B;
  font-weight: bold;
  border-bottom-color: #DAA520;
}

.feedback-modal-tab-badge {
  position: relative;
  top: 0;
}

.my-feedback-list-scroll {
  max-height: 60vh;
}

.my-feedback-item {
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

/* 🐛 根因修复：已驳回的卡片现在可点击查看详情/重新修改提交，加一点可点击的
   视觉提示（active 态轻微变暗），区别于待确认/已采纳这两个纯展示态卡片 */
.my-feedback-item.tappable {
  transition: opacity 0.15s ease;
}

.my-feedback-item.tappable:active {
  opacity: 0.7;
}

.my-feedback-reply {
  margin-top: 12rpx;
}

.my-feedback-pending-tag {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #ADB5BD;
}

.feedback-type-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.feedback-type-pill {
  padding: 14rpx 24rpx;
  border-radius: 32rpx;
  background: #F1EBE0;
  border: 2rpx solid transparent;
  color: #6B5B45;
  font-size: 24rpx;
  box-sizing: border-box;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.feedback-type-pill.active {
  background: linear-gradient(135deg, #E6A23C 0%, #DAA520 100%);
  border-color: #B8860B;
  color: #FFFFFF;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(184, 134, 11, 0.4);
}

.feedback-content-textarea {
  width: 100%;
  min-height: 180rpx;
  max-height: 320rpx;
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #333333;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.feedback-textarea-placeholder {
  color: #C7BBA8;
}

.feedback-submit-btn {
  width: 100%;
  min-height: 88rpx;
  /* 安全区缓冲已经由 .feedback-sheet-panel 的 padding-bottom 统一预留
     （140rpx + env(safe-area-inset-bottom)），这里不再重复叠加一次，
     避免按钮下方出现两倍安全区的多余空白 */
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  background: linear-gradient(135deg, #B8860B 0%, #DAA520 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(184, 134, 11, 0.35);
}

.feedback-submit-btn::after {
  border: none;
}

.feedback-submit-btn:active {
  opacity: 0.85;
}

.feedback-submit-btn[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

/* 📮 爱心意见箱管理弹窗：复用 .feedback-sheet-backdrop/.feedback-sheet-panel 的
   遮罩+滑出动效，这里只补充"列表可滚动、限制最大高度"这类管理弹窗特有的样式 */
.feedback-admin-sheet-panel {
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.feedback-admin-list-scroll {
  flex: 1;
  min-height: 0;
}

.feedback-admin-loading,
.feedback-admin-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #ADB5BD;
  font-size: 24rpx;
}

.feedback-admin-item {
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
  transition: opacity 0.15s ease;
}

.feedback-admin-item.is-handled {
  opacity: 0.6;
}

.fa-item-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.fa-item-nickname {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.fa-item-type-tag {
  font-size: 20rpx;
  color: #D9480E;
  background-color: #FFF3BF;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* 🐛 可读性修复：20rpx + #ADB5BD 浅灰在小屏幕上时间文本糊成一团难以辨认，
   调大字号并加深至清晰的墨灰色，加中等字重提升辨识度 */
.fa-item-time {
  display: block;
  font-size: 26rpx;
  color: #4A5568;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.fa-item-content {
  display: block;
  font-size: 26rpx;
  color: #495057;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

/* 待处理行动区：标记为已处理 / 回复家人 并排两个按钮 */
.fa-item-actions {
  display: flex;
  gap: 12rpx;
}

.fa-item-handle-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: #2B8A3E;
  background: #EBFBEE;
  border: 1rpx solid #B2F2BB;
  border-radius: 32rpx;
  transition: transform 0.1s ease, opacity 0.1s ease;
}

.fa-item-handle-btn::after {
  border: none;
}

.fa-item-handle-btn:active {
  transform: scale(0.97);
  opacity: 0.8;
}

.fa-item-handle-btn[disabled] {
  opacity: 0.6;
}

.fa-item-reply-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: #B8860B;
  background: #FFF9E6;
  border: 1rpx solid #F0DFA6;
  border-radius: 32rpx;
  transition: transform 0.1s ease, opacity 0.1s ease;
}

.fa-item-reply-btn::after {
  border: none;
}

.fa-item-reply-btn:active {
  transform: scale(0.97);
  opacity: 0.8;
}

.fa-item-handled-tag {
  display: inline-block;
  margin-top: 4rpx;
  font-size: 22rpx;
  font-weight: bold;
  color: #2B8A3E;
  background: #EBFBEE;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* 💬 展开式回复输入框：与 feedback-content-textarea 同一套输入框视觉规范 */
.fa-reply-box {
  margin-top: 16rpx;
}

.fa-reply-textarea {
  width: 100%;
  min-height: 120rpx;
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 25rpx;
  color: #333333;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.fa-reply-submit-btn {
  width: 100%;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: #FFFFFF;
  background: linear-gradient(135deg, #B8860B 0%, #DAA520 100%);
  border-radius: 32rpx;
  border: none;
}

.fa-reply-submit-btn::after {
  border: none;
}

.fa-reply-submit-btn[disabled] {
  opacity: 0.6;
}

/* 🗣️ 已回复展示区：柔和暖金背景，与待处理行动区互斥展示 */
.fa-reply-display {
  background: #FFF9E6;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin-top: 8rpx;
}

.fa-reply-display-label {
  display: block;
  font-size: 20rpx;
  color: #B8860B;
  font-weight: bold;
  margin-bottom: 6rpx;
}

/* 🏪 高级角色/新店申请队列专属：门店档案预览卡片（地址/联系电话/照片横滚），
   与 .fa-reply-display 同款柔和底色，视觉上归入"这条申请的附加信息" */
.ea-store-profile-card {
  background: #FAF7F0;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin-top: 4rpx;
  margin-bottom: 16rpx;
}

.ea-store-profile-card .fa-item-content {
  margin-bottom: 6rpx;
}

.ea-store-photo-row {
  white-space: nowrap;
  margin-top: 8rpx;
}

.ea-store-photo-thumb {
  display: inline-block;
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 12rpx;
  border: 1rpx solid #EFE6D8;
}

.fa-reply-display-text {
  display: block;
  font-size: 24rpx;
  color: #6B5B45;
  line-height: 1.6;
}

/* 🍱🌾 义工现场服务工具表单：与 feedback-sheet-* 共用弹窗壳，这里只补充
   表单专属的标签/单选胶囊/数字输入框样式 */
.vt-form-label {
  display: block;
  font-size: 24rpx;
  color: #6B5B45;
  margin-bottom: 12rpx;
}

.vt-status-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.vt-status-pill {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: #F1EBE0;
  color: #6B5B45;
  font-size: 26rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.vt-status-pill.active {
  background: linear-gradient(135deg, #E6A23C 0%, #DAA520 100%);
  border-color: #B8860B;
  color: #FFFFFF;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(184, 134, 11, 0.4);
}

.vt-count-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

/* 三餐人数：三列比原本两列窄，缩小列间距和输入框左右内边距，避免数字被挤压 */
.vt-count-row-3 {
  gap: 12rpx;
}

.vt-count-row-3 .vt-count-input {
  padding: 0 8rpx;
  text-align: center;
}

.vt-count-cell {
  flex: 1;
  min-width: 0;
}

/* 🌾 物资消耗四项：2x2 网格，比 3 列一行更宽裕，数字不用挤在一起 */
.vt-count-grid-2x2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.vt-count-input {
  width: 100%;
  height: 76rpx;
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 16rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333333;
}

/* 📄 我的餐报提交记录：待确认/已确认状态标签，与 fa-item-handled-tag 呼应但
   多一个"待确认"的暖金强调态，避免家人/义工看到全灰色以为提交没生效 */
.my-vs-status-tag {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.my-vs-status-tag.pending {
  color: #B8860B;
  background: #FFF9E6;
}

.my-vs-status-tag.approved {
  color: #2B8A3E;
  background: #EBFBEE;
  font-weight: bold;
}

.my-vs-status-tag.rejected {
  color: #C92A2A;
  background: #FFF0F0;
}

.my-vs-reject-reason {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #C92A2A;
  line-height: 1.6;
}

/* 详情弹窗里的驳回原因：字号略大、独立成段，与列表卡片上精简展示的同名样式区分 */
.my-vs-reject-reason.detail {
  margin-top: 20rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  padding: 16rpx;
  background: #FFF0F0;
  border-radius: 12rpx;
}

.my-vs-tap-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #ADB5BD;
}

/* 📊 门店餐饮与物资统计：三段 pd-health-grid 堆叠起来比其他 warm-story-modal-*
   用途（纯文案说明）更高，加个滚动容器兜底，避免小屏幕溢出弹窗卡片 */
.store-stats-modal-card {
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.store-stats-scroll {
  flex: 1;
  min-height: 0;
}

.store-stats-scroll .pd-health-title {
  margin-top: 20rpx;
}

.store-stats-scroll .pd-health-title:first-child {
  margin-top: 0;
}

