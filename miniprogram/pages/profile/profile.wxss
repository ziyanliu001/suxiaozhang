  transition: all 0.25s ease;
}

.release-modal-mask.show .release-modal-card {
  transform: scale(1) translateY(0);
  opacity: 1;
}

.release-warning-icon {
  display: block;
  text-align: center;
  font-size: 72rpx;
  margin-bottom: 20rpx;
