/* ==========================================
   🚪 卸任特权 Warning 弹窗
   ========================================== */
.release-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.release-modal-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.release-modal-card {
  width: 82%;
  max-width: 620rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 36rpx 36rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  transform: scale(0.9) translateY(20rpx);
  opacity: 0;
  transition: all 0.25s ease;
}

.release-modal-mask.show .release-modal-card {
  transform: scale(1) translateY(0);
  opacity: 1;
}

.release-warning-icon {
  display: block;
  text-align: center;
  font-size: 72rpx;
  margin-bottom: 20rpx;
  line-height: 1;
}

.release-modal-title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
  margin-bottom: 32rpx;
  line-height: 1.5;
}

.release-role-highlight {
  color: #D32F2F;
}

.release-consequence-list {
  background: #FFF5F5;
  border: 1.5rpx solid #FFCDD2;
  border-radius: 20rpx;
  padding: 24rpx 24rpx 8rpx;
  margin-bottom: 36rpx;
}

.release-consequence-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.bullet-dot {
  font-size: 26rpx;
  color: #D32F2F;
  margin-right: 12rpx;
  line-height: 1.6;
  flex-shrink: 0;
}

.bullet-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #5C5C5C;
  line-height: 1.6;
  word-break: break-all;
}

.release-consequence-item.danger .bullet-text {
  color: #D32F2F;
  font-weight: bold;
}

.release-modal-footer {
  display: flex;
  gap: 20rpx;
}

.release-btn-cancel,
.release-btn-confirm {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 42rpx;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.release-btn-cancel::after,
.release-btn-confirm::after {
  border: none;
}

.release-btn-cancel {
  background: #F1F3F5;
  color: #495057;
}

.release-btn-cancel:active {
  transform: scale(0.96);
  background: #E9ECEF;
}

.release-btn-confirm {
  background: linear-gradient(135deg, #E53935 0%, #C62828 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(198, 40, 40, 0.35);
}

.release-btn-confirm:active {
  transform: scale(0.96);
  opacity: 0.9;
  box-shadow: 0 4rpx 10rpx rgba(198, 40, 40, 0.3);
}

/* 🌟 工时保留承诺：与上方 .release-consequence-list 的淡红警示形成鲜明对比，
   浅绿底色传达"这部分不受影响、可以放心"，两种情绪在同一屏内清晰可辨 */
.release-safe-notice {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  background: #EBFBEE;
  border: 1.5rpx solid #B2F2BB;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 36rpx;
}

.safe-icon {
  font-size: 26rpx;
  line-height: 1.6;
  flex-shrink: 0;
}

.safe-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #2B8A3E;
  font-weight: bold;
  line-height: 1.6;
}

/* ================= 🏛️ 切换身份面板：多角色兼任时的身份切换/退出入口 ================= */
.switch-identity-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.switch-identity-modal-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.switch-identity-card {
  width: 82%;
  max-width: 620rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 36rpx 36rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  transform: scale(0.9) translateY(20rpx);
  opacity: 0;
  transition: all 0.25s ease;
}

.switch-identity-modal-mask.show .switch-identity-card {
  transform: scale(1) translateY(0);
  opacity: 1;
}

.switch-identity-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.switch-identity-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
}

.switch-identity-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #F1F3F5;
  color: #868E96;
  font-size: 26rpx;
}

.switch-identity-desc {
  display: block;
  font-size: 24rpx;
  color: #868E96;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.switch-identity-option-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.switch-identity-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFF8E1;
  border: 1.5rpx solid #FFE082;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  transition: all 0.15s ease;
}

.switch-identity-option:active {
  transform: scale(0.98);
  background: #FFECB3;
}

.switch-identity-option .option-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #8C5A00;
}

.switch-identity-option .option-arrow {
  font-size: 22rpx;
  color: #D9A441;
}

.switch-identity-divider {
  height: 1.5rpx;
  background: #F1F3F5;
  margin: 32rpx 0 24rpx;
}

.btn-exit-binding {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #868E96;
  background: #F1F3F5;
  border-radius: 40rpx;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  transition: transform 0.12s ease, background 0.12s ease;
}

.btn-exit-binding::after {
  border: none;
}

.btn-exit-binding:active {
  transform: scale(0.97);
  background: #E9ECEF;
}

/* ================= 🏅 数字荣誉墙 ================= */

.honor-wall-card {
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 28rpx;
  padding: 24rpx 28rpx 28rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 6rpx 20rpx rgba(239, 230, 216, 0.3);
}

.honor-wall-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.honor-wall-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
}

.honor-wall-cert-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: #8C1D18;
  padding: 8rpx 12rpx;
  border-radius: 20rpx;
  margin-right: -12rpx;
}

.honor-wall-cert-link:active {
  background: #F5E8E8;
}

.honor-badge-scroll {
  width: 100%;
  white-space: nowrap;
}

.honor-badge-row {
  display: flex;
  gap: 28rpx;
  padding: 4rpx 4rpx 8rpx;
}

.honor-badge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  width: 108rpx;
  transition: transform 0.15s ease;
}

.honor-badge-item:active {
  transform: scale(0.94);
}

.honor-badge-circle {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 已解锁：饱满金色渐变 + 微光投影 + 持续炫光呼吸动画，点击时整体缩放做"微光"反馈（见 .honor-badge-item:active） */
.honor-badge-item.unlocked .honor-badge-circle {
  background: linear-gradient(135deg, #F1C40F 0%, #B8860B 100%);
  box-shadow: 0 0 0 4rpx #FFF3BF, 0 6rpx 16rpx rgba(184, 134, 11, 0.45);
  animation: badgeGlowPulse 2.4s ease-in-out infinite;
}

@keyframes badgeGlowPulse {
  0%, 100% { box-shadow: 0 0 0 4rpx #FFF3BF, 0 6rpx 16rpx rgba(184, 134, 11, 0.45); }
  50% { box-shadow: 0 0 0 8rpx #FFF3BF, 0 6rpx 24rpx rgba(184, 134, 11, 0.7); }
}

/* 未点亮：小圆角百分比标签叠在徽章圆环右下角，柔和灰阶基础上标出完成进度 */
.honor-badge-percent {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  font-size: 16rpx;
  color: #8C6D46;
  background: #FFF9E8;
  border: 1rpx solid #E9D8B0;
  border-radius: 16rpx;
  padding: 1rpx 8rpx;
  line-height: 1.4;
  white-space: nowrap;
}

.honor-badge-item.unlocked .honor-badge-emoji {
  font-size: 44rpx;
}

.honor-badge-item.unlocked .honor-badge-name {
  color: #8C1D18;
  font-weight: bold;
}

/* 未解锁：整体置灰半透明，与已解锁形成清晰的"未达成"视觉信号 */
.honor-badge-item.locked .honor-badge-circle {
  background: #E9ECEF;
  opacity: 0.4;
}

.honor-badge-item.locked .honor-badge-emoji {
  font-size: 40rpx;
  filter: grayscale(100%);
}

.honor-badge-item.locked .honor-badge-name {
  color: #ADB5BD;
}

.honor-badge-name {
  font-size: 20rpx;
  text-align: center;
}

/* ================= 🎖️ 徽章详情 Modal ================= */
/* 复用 .certificate-modal-mask/.certificate-modal-header/.certificate-modal-close
   同一套弹窗壳，这里只需要 badge-detail-card 覆盖内边距 + 卡片正文样式 */
.badge-detail-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 8rpx;
}

.badge-detail-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.badge-detail-circle.unlocked {
  background: linear-gradient(135deg, #F1C40F 0%, #B8860B 100%);
  box-shadow: 0 0 0 6rpx #FFF3BF, 0 6rpx 16rpx rgba(184, 134, 11, 0.45);
}

.badge-detail-circle.glow-anim {
  animation: badgeGlowPulse 2.4s ease-in-out infinite;
}

.badge-detail-circle.unlocked .badge-detail-emoji {
  font-size: 56rpx;
}

.badge-detail-circle.locked {
  background: #E9ECEF;
  opacity: 0.6;
}

.badge-detail-circle.locked .badge-detail-emoji {
  font-size: 52rpx;
  filter: grayscale(100%);
}

.badge-detail-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.badge-detail-status {
  font-size: 22rpx;
  color: #ADB5BD;
  margin-bottom: 16rpx;
}

.badge-detail-status.unlocked {
  color: #2B8A3E;
  font-weight: bold;
}

/* 🎖️ 勋章寓意：比解锁条件更"有温度"的一句话说明，颜色略深、字号略大做视觉区分 */
.badge-detail-meaning {
  font-size: 25rpx;
  color: #8C1D18;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.badge-detail-desc {
  font-size: 24rpx;
  color: #6B5B45;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.badge-detail-progress-track {
  width: 100%;
  height: 16rpx;
  border-radius: 8rpx;
  background: #F1F3F5;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.badge-detail-progress-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #F1C40F 0%, #B8860B 100%);
  transition: width 0.3s ease;
}

.badge-detail-progress-text {
  font-size: 22rpx;
  color: #A08A6A;
}

/* 🌟 已解锁荣誉的分享入口 */
.badge-detail-share-btn {
  width: 100%;
  margin-top: 20rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #FFFFFF;
  background: linear-gradient(135deg, #F1C40F 0%, #B8860B 100%);
  border-radius: 38rpx;
  box-shadow: 0 6rpx 16rpx rgba(184, 134, 11, 0.35);
}

.badge-detail-share-btn::after {
  border: none;
}

/* ================= 🌟 义工证书 Modal ================= */

/* 🐛 硬性根治：本弹窗（驳回原因/拒绝申请原因等）经常是从「待审核的义工餐报与
   物资」这类半屏抽屉（.feedback-sheet-backdrop/.feedback-sheet-panel，
   z-index: 999998/999999 !important）里点开的二级弹窗。此前 z-index: 2000
   远低于抽屉的层级，导致弹出后视觉上仍被压在抽屉下面、看不见驳回输入框。
   这里顶到比抽屉更高的层级，并同样用 !important 排除任何后续样式意外覆盖 */
.certificate-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999999 !important;
}

.certificate-modal-card {
  width: 88%;
  max-width: 660rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 24rpx 32rpx;
  box-sizing: border-box;
}

.certificate-modal-header {
  display: flex;
  align-items: center;
  /* 标题文字已删除，header 现在只剩关闭按钮——改成 flex-end 让它继续贴右上角，
     不再需要 space-between 那种"两端对齐"布局 */
  justify-content: flex-end;
  margin-bottom: 20rpx;
}

.certificate-modal-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #F1F3F5;
  color: #6B7280;
  font-size: 24rpx;
}

/* 🏷️ 快捷驳回标签：常见驳回原因一键填入，减少店长手动打字 */
.quick-reject-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.quick-reject-tag {
  font-size: 22rpx;
  color: #6B5B45;
  background: #F5F0E6;
  border: 1rpx solid #E5DCC8;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  line-height: 1.4;
}

.quick-reject-tag.active {
  color: #FFFFFF;
  background: #C0392B;
  border-color: #C0392B;
}

.certificate-canvas-wrap {
  position: relative;
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  background: #F1E6C8;
  /* Canvas 用 style 里的 px 精确控制尺寸（与 drawVolunteerCertificate 的 width/height 参数一致），
     这里用等比留白让容器高度跟随，避免绘制中/绘制前出现明显的高度跳变 */
  min-height: 480rpx;
  /* 给证书卡片加一圈投影，让它从弹窗背景里"浮"出来，更有实体证书的质感 */
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
}

.certificate-canvas {
  position: absolute;
  top: 0;
  left: 0;
  /* Canvas 节点本身不需要可见——它只是绘制源，最终展示的是下面的 <image>；
     保留在文档流里但视觉上完全被 image 盖住即可，不需要额外裁剪技巧 */
}

.certificate-preview-img {
  position: relative;
  width: 100%;
  display: block;
  border-radius: 16rpx;
}

.certificate-loading-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(251, 246, 233, 0.9);
  font-size: 24rpx;
  color: #8C6D46;
}

.certificate-save-btn {
  margin-top: 40rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #B8860B 0%, #DAA520 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(184, 134, 11, 0.35);
}

.certificate-save-btn::after {
  border: none;
}

.certificate-save-btn:active {
  opacity: 0.85;
  box-shadow: 0 2rpx 6rpx rgba(184, 134, 11, 0.2);
}

.certificate-save-btn[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

/* 家人证书专属操作按钮：与义工版 certificate-save-btn 同一套暖金质感，
   与义工按钮独立成一份，避免共用类名时因家人分支 disabled 语义不同而互相牵连 */
.certificate-family-save-btn {
  margin-top: 24rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #B8860B 0%, #DAA520 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(184, 134, 11, 0.35);
}

.certificate-family-save-btn::after {
  border: none;
}

.certificate-family-save-btn:active {
  opacity: 0.85;
  box-shadow: 0 2rpx 6rpx rgba(184, 134, 11, 0.2);
}

/* 🌸 家人版纯文本证书：与义工版 Canvas 证书共用同一个 certificate-modal-mask/
   certificate-modal-card 弹窗壳，这里只负责正文区域的排版，不含 Canvas/二维码。
   宣纸暖米白底 + 双重古典边框 + 朱红印鑑，营造纸质荣誉证书的仪式感 */
.certificate-family-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 8rpx 8rpx;
  background: #FAF6F0;
  border-radius: 12rpx;
}

.cf-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.cf-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #8C1D18;
  letter-spacing: 2rpx;
}

/* 双重边框：外层 certificate-family-body 的暖米白底本身算作外圈，
   这里再加一圈实线 + 内边距，形成"证书纸+装裱边框"的双层观感 */
.cf-inner-border {
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid #E2D1B2;
  padding: 24rpx;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.certificate-family-icon {
  font-size: 56rpx;
  margin-bottom: 20rpx;
}

/* 抬头顶格加粗：与正文分开单独一行，模拟传统证书"尊敬的...："起首语气 */
.cert-salutation {
  align-self: stretch;
  font-size: 28rpx;
  font-weight: bold;
  color: #5A3E2B;
  margin-bottom: 16rpx;
  text-align: left;
}

/* 正文段落：首行缩进两字 + 两端对齐，贴近实体证书的排版手感 */
.cert-paragraph {
  align-self: stretch;
  font-size: 26rpx;
  color: #6C4F3B;
  line-height: 1.8;
  text-indent: 2em;
  text-align: justify;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.cf-signature-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  align-self: stretch;
  gap: 16rpx;
  margin-top: 32rpx;
}

.cf-signature-text {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.cf-sign-line {
  font-size: 24rpx;
  color: #6B4C1E;
  line-height: 1.5;
}

/* 朱红古典印鑑：正方形、微旋转，模拟盖章时的随手歪斜手感 */
.cf-seal {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  border: 3rpx solid #C0392B;
  border-radius: 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform: rotate(-6deg);
  color: #C0392B;
  opacity: 0.88;
  box-shadow: 0 0 0 1rpx rgba(192, 57, 43, 0.15) inset;
}

.cf-seal-line {
  font-size: 22rpx;
  font-weight: bold;
  line-height: 1.3;
}

/* 🌸 雨花温情故事说明弹窗：与 certificate-modal-* 同一套弹窗视觉规范 */
.warm-story-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.warm-story-modal-card {
  width: 88%;
  max-width: 660rpx;
  background: linear-gradient(155deg, #FFF8F0 0%, #FFFFFF 60%);
  border-radius: 28rpx;
  padding: 28rpx 24rpx 32rpx;
  box-sizing: border-box;
}

.warm-story-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.warm-story-modal-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #222222;
}

.warm-story-modal-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #F1F3F5;
  color: #6B7280;
  font-size: 24rpx;
}

.warm-story-modal-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 4rpx 0;
}

.warm-story-modal-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

/* 正文段落：改居中为两端对齐 + 首行缩进两字，贴近实体文章的阅读排版；
   align-self:stretch 覆盖父级 .warm-story-modal-body 的 align-items:center
   （默认会把文本框收缩成"内容多宽就多宽"，text-indent/justify 需要撑满整行才有意义） */
.warm-story-modal-text {
  display: block;
  align-self: stretch;
  font-size: 26rpx;
  color: #6B4C1E;
  line-height: 1.8;
  text-align: justify;
  text-indent: 2em;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.warm-story-view-log-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  margin-top: 12rpx;
  background: linear-gradient(135deg, #E6A23C 0%, #DAA520 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 42rpx;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(230, 162, 60, 0.35);
}

.warm-story-view-log-btn::after {
  border: none;
}

.warm-story-view-log-btn:active {
  opacity: 0.85;
}

/* 📮 爱心意见箱：半屏底部弹窗，与 mine-quick-sheet 组件同一套 backdrop/panel/
   drag-handle 视觉规范（fixed 遮罩 + 底部滑出面板），保持全站弹窗手感统一 */
/* 🐛 自定义 TabBar（custom-tab-bar，z-index: 998）曾经把本弹窗底部的提交按钮
   盖住——弹窗结构里没有独立的遮罩层元素，.feedback-sheet-backdrop 本身同时
   兼任"全屏遮罩"与"面板定位容器"两个角色，这里用 !important 顶到最高层级，
   排除任何后续样式意外覆盖的可能 */
.feedback-sheet-backdrop {
  position: fixed !important;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999998 !important;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  opacity: 0;
  transition: opacity 0.25s ease;
}

.feedback-sheet-backdrop.show {
  opacity: 1;
}

.feedback-sheet-panel {
  position: relative;
  z-index: 999999 !important;
  width: 100%;
  background: #FBF9F5;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  /* 140rpx 安全抬升边距：custom-tab-bar 实际高度 100rpx，这里额外多留 40rpx
     缓冲，确保提交按钮完整露在 TabBar 上方——不再依赖按钮自己的 padding-bottom
     去凑这个安全区，直接在面板层级一次性预留够 */
  padding: 16rpx 28rpx calc(140rpx + env(safe-area-inset-bottom)) !important;
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.25s ease;
}

.feedback-sheet-backdrop.show .feedback-sheet-panel {
  transform: translateY(0);
}

.feedback-sheet-drag-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #E3D9C8;
  margin: 0 auto 24rpx;
}

.feedback-sheet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.feedback-sheet-header-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.feedback-sheet-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.feedback-sheet-subtitle {
  font-size: 22rpx;
  color: #A08A6A;
}

.feedback-sheet-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #F1F3F5;
  color: #6B7280;
  font-size: 24rpx;
  flex-shrink: 0;
}

/* 💌 家人意见箱双 Tab：提交建议 / 我的反馈与回复 */
.feedback-modal-tab-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #F1EBE0;
}

.feedback-modal-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #A08A6A;
  border-bottom: 4rpx solid transparent;
}

.feedback-modal-tab.active {
  color: #B8860B;
  font-weight: bold;
  border-bottom-color: #DAA520;
}

.feedback-modal-tab-badge {
  position: relative;
  top: 0;
}

.my-feedback-list-scroll {
  max-height: 60vh;
}

.my-feedback-item {
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

/* 🐛 根因修复：已驳回的卡片现在可点击查看详情/重新修改提交，加一点可点击的
   视觉提示（active 态轻微变暗），区别于待确认/已采纳这两个纯展示态卡片 */
.my-feedback-item.tappable {
  transition: opacity 0.15s ease;
}

.my-feedback-item.tappable:active {
  opacity: 0.7;
}

/* 🚨 已驳回卡片警示态：淡红底 + 柔和红框，让需要修改重提的卡片在列表里一眼可辨，
   不用逐条看状态标签才知道哪几条要处理 */
.my-feedback-item.rejected {
  background: #FFF5F5;
  border: 1rpx solid #FED7D7;
  border-radius: 16rpx;
}

.my-feedback-reply {
  margin-top: 12rpx;
}

.my-feedback-pending-tag {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #ADB5BD;
}

.feedback-type-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.feedback-type-pill {
  padding: 14rpx 24rpx;
  border-radius: 32rpx;
  background: #F1EBE0;
  border: 2rpx solid transparent;
  color: #6B5B45;
  font-size: 24rpx;
  box-sizing: border-box;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.feedback-type-pill.active {
  background: linear-gradient(135deg, #E6A23C 0%, #DAA520 100%);
  border-color: #B8860B;
  color: #FFFFFF;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(184, 134, 11, 0.4);
}

.feedback-content-textarea {
  width: 100%;
  min-height: 180rpx;
  max-height: 320rpx;
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #333333;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.feedback-textarea-placeholder {
  color: #C7BBA8;
}

.feedback-submit-btn {
  width: 100%;
  min-height: 88rpx;
  /* 安全区缓冲已经由 .feedback-sheet-panel 的 padding-bottom 统一预留
     （140rpx + env(safe-area-inset-bottom)），这里不再重复叠加一次，
     避免按钮下方出现两倍安全区的多余空白 */
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  background: linear-gradient(135deg, #B8860B 0%, #DAA520 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(184, 134, 11, 0.35);
}

.feedback-submit-btn::after {
  border: none;
}

.feedback-submit-btn:active {
  opacity: 0.85;
}

.feedback-submit-btn[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

/* 📮 爱心意见箱管理弹窗：复用 .feedback-sheet-backdrop/.feedback-sheet-panel 的
   遮罩+滑出动效，这里只补充"列表可滚动、限制最大高度"这类管理弹窗特有的样式。
   🐛 根因修复：基类 .feedback-sheet-panel 的 padding-bottom 是为"面板底部有固
   定提交按钮"这一场景设计的（140rpx 预留 TabBar 遮挡缓冲）。所有使用本类的弹窗
   （意见箱管理/餐报提交/成员管理/申请审批等）操作按钮均在 scroll-view 内的列表
   项里，底部没有固定按钮，继承 140rpx 底部内边距只会制造一大块死白空间，同时挤
   压了 scroll-view 的可用高度（原 max-height: 55vh 与 140rpx 夹攻）。这里用
   !important 覆盖，改为仅保留安全区留白，列表内最后一项已有 fa-safe-area-spacer
   兜底，不再需要外层内边距重复处理安全区 */
.feedback-admin-sheet-panel {
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  padding-bottom: constant(safe-area-inset-bottom) !important;
  padding-bottom: env(safe-area-inset-bottom) !important;
}

/* ⏳✅ 待处理 / 已处理 Tab 切换栏 */
.fa-tab-bar {
  display: flex;
  border-bottom: 2rpx solid #EFE6D8;
  padding: 0 32rpx;
  flex-shrink: 0;
}

.fa-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #ADB5BD;
  font-weight: 500;
  border-bottom: 4rpx solid transparent;
  margin-bottom: -2rpx;
  transition: color 0.15s ease, border-color 0.15s ease;
}

.fa-tab.active {
  color: #E75B3E;
  border-bottom-color: #E75B3E;
  font-weight: bold;
}

.fa-tab-badge {
  font-size: 20rpx;
  font-weight: bold;
  color: #FFFFFF;
  background: #E75B3E;
  border-radius: 20rpx;
  padding: 2rpx 10rpx;
  min-width: 32rpx;
  text-align: center;
  line-height: 1.4;
}

.feedback-admin-list-scroll {
  flex: 1;
  min-height: 0;
  /* max-height: 55vh 已移除：配合上方 padding-bottom 修复，scroll-view 现在靠
     flex: 1 自然填满 85vh 面板内的剩余空间，不再需要人工上限截断 */
}

/* 安全区底部留白 */
.fa-safe-area-spacer {
  height: calc(20rpx + constant(safe-area-inset-bottom));
  height: calc(20rpx + env(safe-area-inset-bottom));
}

.feedback-admin-loading,
.feedback-admin-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #ADB5BD;
  font-size: 24rpx;
}

.feedback-admin-item {
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.06);
  transition: opacity 0.15s ease;
}

.feedback-admin-item.is-handled {
  opacity: 0.6;
}

.fa-item-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.fa-item-nickname {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.fa-item-type-tag {
  font-size: 26rpx;
  color: #D9480E;
  background-color: #FFF3BF;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
  /* 🐛 修复：与右侧紧接着的 .fa-item-time 日历图标贴在一起没有呼吸感，补一点右边距 */
  margin-right: 20rpx;
}

/* 🐛 可读性修复：20rpx + #ADB5BD 浅灰在小屏幕上时间文本糊成一团难以辨认，
   调大字号并加深至清晰的墨灰色，加中等字重提升辨识度 */
.fa-item-time {
  display: block;
  font-size: 26rpx;
  color: #4A5568;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.fa-item-content {
  display: block;
  font-size: 26rpx;
  color: #495057;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

/* 🌟 核心数据加强：用餐人数（早/午/晚）与物资消耗（米/面/油/菜）是这张卡片
   最重要的信息，比备注/说明这类次要文本更需要一眼看清——只加在这两行上，
   不影响 .fa-item-content 在意见箱内容/手机号/门店档案等其他场景的展示 */
.fa-item-core-data {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A202C;
  line-height: 1.5;
}

/* 📝 备注/说明：与上面核心数据行区分开的次要信息，上下各留一点边距，
   避免紧挨着核心数据行或底部的【店长已采纳】/【待店长确认】状态标签 */
.fa-item-note {
  font-size: 26rpx;
  color: #4A5568;
  margin-top: 12rpx;
  margin-bottom: 16rpx;
}

/* 数字高亮：在核心数据行内进一步突出具体数量，让人数/斤数比周围的标签文字更醒目 */
.highlight-num {
  color: #27AE60;
  font-weight: 600;
}

/* 待处理行动区：标记为已处理 / 回复家人 并排两个按钮 */
.fa-item-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

/* 🎨 圆角微渐变 Pill 按钮：与 .fa-reply-submit-btn/.feedback-submit-btn 的实心
   品牌渐变不同——这两个是列表项内的次级操作，逐条滚动时若每条都是高饱和实心
   渐变会显得视觉噪音很重，改用同色系浅→浅的柔和微渐变，质感升级但不抢主按钮的焦点
   🐛 根因修复：原来只靠 height === line-height 让文字垂直居中——微信原生 <button>
   自带默认内边距（左右 ~30rpx）与基线度量，emoji（✅/❌）与中文混排时行高基线
   本就和纯文本不一致，两者叠加导致按钮内文字/图标肉眼可见地偏左上或偏斜。
   显式 flex 居中 + box-sizing/padding/margin 归零，彻底不依赖 line-height 这条
   脆弱的隐式规则 */
.fa-item-handle-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 1;
  font-size: 25rpx;
  font-weight: bold;
  color: #FFFFFF;
  background: linear-gradient(135deg, #40C057 0%, #2B8A3E 100%);
  border: none;
  border-radius: 36rpx;
  box-shadow: 0 4rpx 10rpx rgba(43, 138, 62, 0.3);
  transition: transform 0.1s ease, opacity 0.1s ease, box-shadow 0.1s ease;
}

.fa-item-handle-btn::after {
  border: none;
}

.fa-item-handle-btn:active {
  transform: scale(0.96);
  opacity: 0.88;
  box-shadow: none;
}

.fa-item-handle-btn[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

/* ⚠️ 驳回：浅红警告色，与"一键采纳入库"的绿色主色形成明确的语义对比——
   一个是不可逆的正向确认操作，一个是需要用户三思的否定操作 */
.fa-item-reply-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 1;
  font-size: 25rpx;
  font-weight: bold;
  color: #E03131;
  background: linear-gradient(135deg, #FFF5F5 0%, #FFE3E3 100%);
  border: 2rpx solid #FFA8A8;
  border-radius: 36rpx;
  transition: transform 0.1s ease, opacity 0.1s ease, background-color 0.1s ease;
}

.fa-item-reply-btn::after {
  border: none;
}

.fa-item-reply-btn:active {
  transform: scale(0.96);
  opacity: 0.85;
  background: #FFE3E3;
}

.fa-item-reply-btn[disabled] {
  opacity: 0.5;
}

/* 🔑 人员权限管理：降级为义工 — 琥珀/警告色，区别于绿色"通过"和红色"移出" */
.fa-item-demote-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 1;
  font-size: 25rpx;
  font-weight: bold;
  color: #7B4F00;
  background: linear-gradient(135deg, #FFF8E1 0%, #FFE082 100%);
  border: 2rpx solid #F0C36D;
  border-radius: 36rpx;
  transition: transform 0.1s ease, opacity 0.1s ease;
}

.fa-item-demote-btn::after {
  border: none;
}

.fa-item-demote-btn:active {
  transform: scale(0.96);
  opacity: 0.85;
}

.fa-item-demote-btn[disabled] {
  opacity: 0.4;
}

/* ═══════════════════════════════════════════════════
   🔑 成员权限管理弹窗（member-manage-modal）新样式
