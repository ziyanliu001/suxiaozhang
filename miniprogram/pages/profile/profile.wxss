  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.store-stats-scroll {
  flex: 1;
  min-height: 0;
}

.store-stats-scroll .pd-health-title {
  margin-top: 20rpx;
}

.store-stats-scroll .pd-health-title:first-child {
  margin-top: 0;
}

.store-stats-timestamp {
  display: flex;
