}

.fa-kpi-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.fa-kpi-cell {
  background: #F8FCFA;
  border: 1rpx solid #D3F0E4;
  border-radius: 14rpx;
  padding: 18rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
}

.fa-kpi-val {
  font-size: 32rpx;
  font-weight: 800;
  color: #0B815A;
  line-height: 1.15;
}

.fa-kpi-val.fa-bold {
  font-size: 30rpx;
  color: #B57C1E;
}

.fa-kpi-val.fa-warn {
  color: #E8590C;
}

.fa-kpi-val.fa-danger {
  color: #E03131;
}

.fa-kpi-lbl {
  font-size: 20rpx;
  color: #868E96;
  text-align: center;
}

.fa-divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, #D3F0E4 30%, #D3F0E4 70%, transparent 100%);
  margin: 4rpx 0 16rpx;
}

/* 🦴 KPI 骨架屏：数据看板首次加载态占位，shimmer 扫光动画 */
.skel-cell {
  gap: 10rpx !important;
}

.skel-bar {
  border-radius: 8rpx;
  background: linear-gradient(90deg, #EEF0F2 25%, #E4E7EB 37%, #EEF0F2 63%);
  background-size: 400% 100%;
  animation: fa-skel-shimmer 1.6s ease-in-out infinite;
}

.skel-bar-lg {
  width: 56rpx;
  height: 28rpx;
}

.skel-bar-sm {
  width: 88rpx;
  height: 18rpx;
}

@keyframes fa-skel-shimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* ===== 🆕 店长专属【本店数据概览】2x2 卡片：位于【门店管理中心】正上方，
   与 patriarch-panel-card 同款金边卡片外观保持视觉一致，内部换成 2x2 数值宫格 ===== */
.mgr-snapshot-card {
  background: #FFFBF0;
  border: 1rpx solid #E6D0A0;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.mgr-snapshot-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.mgr-snapshot-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #8C1D18;
}

.mgr-snapshot-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.mgr-snapshot-cell {
  background: #F8F9FA;
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.mgr-snapshot-val {
  font-size: 40rpx;
  font-weight: bold;
  color: #212529;
  line-height: 1.2;
}

/* 待审批事项数字 > 0 时高亮，提示店长需要实时处理 */
.mgr-snapshot-val.highlight {
  color: #E03131;
}

.mgr-snapshot-lbl {
  font-size: 22rpx;
  color: #868E96;
}

/* ─── 专业版服务状态卡片（大家长/超管专属，位于管理面板内门店管理中心上方） ─── */
.pro-service-card {
  margin: 12rpx 0 20rpx;
  padding: 28rpx 28rpx 20rpx;
  background: linear-gradient(135deg, #1e3a5f 0%, #0f2744 100%);
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 39, 68, 0.30);
}

.pro-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.pro-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #e2c97e;
  letter-spacing: 0.5rpx;
}

.pro-status-badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
}

.pro-status-badge.active {
  background: rgba(52, 211, 153, 0.20);
  color: #34d399;
  border: 1rpx solid rgba(52, 211, 153, 0.40);
}

.pro-status-badge.inactive {
  background: rgba(251, 191, 36, 0.18);
  color: #fbbf24;
  border: 1rpx solid rgba(251, 191, 36, 0.35);
}

.pro-card-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pro-desc {
  font-size: 24rpx;
  color: rgba(226, 232, 240, 0.75);
  line-height: 1.6;
}

.pro-action-btn {
  all: unset;
  display: block;
  text-align: center;
  padding: 20rpx 0;
  background: linear-gradient(135deg, #e2c97e 0%, #c9a227 100%);
  color: #1e3a5f;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 12rpx;
  letter-spacing: 0.5rpx;
}

.pro-action-btn::after {
  border: none;
}

/* 🆕 门店名 Pill：收纳进 .patriarch-panel-header 大标题右侧，取代原先独占一行、
   与"⚙️ 门店管理中心"标题重复堆叠的第二行"🏢 门店管理中心 [门店名] ✏️修改" */
.pd-store-name-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #F3F4F6;
  border-radius: 20rpx;
  padding: 6rpx 14rpx;
  max-width: 400rpx;
  flex-shrink: 0;
}

.pd-store-name-pill-text {
  font-size: 22rpx;
  color: #374151;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 260rpx;
}

.pd-store-name-pill-edit {
  font-size: 20rpx;
  flex-shrink: 0;
}

/* 🆕 卡片内分组小标题：核心日常审批 / 门店运营公告，物理区分高频待办审批
   与低频公告类操作，字号/字重弱于卡片大标题，仅起分隔提示作用 */
.pd-mgmt-section-title {
  display: block;
  font-size: 22rpx;
  font-weight: bold;
  color: #9CA3AF;
  letter-spacing: 0.5rpx;
  margin: 4rpx 0 10rpx;
}

/* ── ✏️ 快捷修改门店名称 Mini-Modal ──────────────────────────────── */
.esn-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.esn-card {
  width: 86%;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);
}

.esn-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx 20rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.esn-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.esn-close {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: #F1F3F5;
  color: #6B7280;
  font-size: 22rpx;
}

.esn-body {
  padding: 28rpx 36rpx 20rpx;
}

.esn-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #D1D5DB;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #111827;
  background: #FAFAFA;
  box-sizing: border-box;
}

.esn-hint {
  display: block;
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 12rpx;
  line-height: 1.6;
}

.esn-footer {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  padding: 16rpx 36rpx 36rpx;
}

.esn-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.esn-btn-cancel {
  background: #F3F4F6;
  color: #6B7280;
}

.esn-btn-confirm {
  background: #2563EB;
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.25);
}

.esn-btn-loading {
  background: #93C5FD;
  box-shadow: none;
}

/* 管理中心内细分隔线（密钥行 / 工具行 之前） */
.pd-mgmt-divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, #E6D0A0 30%, #E6D0A0 70%, transparent 100%);
  margin: 12rpx 0;
}

.pd-health-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.pd-health-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
  margin-bottom: 16rpx;
}

.pd-health-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.pd-health-cell {
  background: #F8F9FA;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.pd-health-lbl {
  font-size: 22rpx;
  color: #868E96;
}

.pd-health-val {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
}

.pd-health-val.green {
  color: #2B8A3E;
}

.pd-health-val.red {
  color: #E03131;
}

.pd-health-val-zero {
  color: #ADB5BD;
  font-weight: normal;
}

.pd-verify-section {
  padding-top: 12rpx;
  border-top: 1rpx dashed #F1F3F5;
}

.pd-verify-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.pd-verify-icon {
  font-size: 24rpx;
}

/* 🆕 进度条：轨道+渐变填充，与荣誉勋章详情弹窗的 .badge-detail-progress-*
   同一套手法，用绿色系区别于勋章的金色系——防伪验真是"信任/核验"语义，
   与"荣誉成就"是两种不同的心理暗示，配色也应区分开 */
.pd-verify-progress-track {
  width: 100%;
  height: 12rpx;
  border-radius: 6rpx;
  background: #F1F3F5;
  overflow: hidden;
  margin-top: 10rpx;
}

.pd-verify-progress-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(135deg, #63E6BE 0%, #0CA678 100%);
  transition: width 0.3s ease;
}

.pd-verify-text {
  font-size: 24rpx;
  color: #495057;
}

/* 🆕 健康大盘整卡可点击跳转统计明细页：标题行右侧补一个"查看明细 ❯"文字提示，
   让用户知道点击整张卡片有响应，而不是误以为只是静态摘要展示 */
.pd-health-card--clickable {
  cursor: pointer;
}

.pd-health-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.pd-health-title-row .pd-health-title {
  margin-bottom: 0;
}

.pd-health-more {
  font-size: 22rpx;
  color: #D97706;
  flex-shrink: 0;
}

/* 🆕 门店管理中心·【日常审批与安全】2x2 宫格：高频操作 + 待办 Badge，
   与下方【门店运营配置】的列表形式做信息密度区分 */
.pd-mgmt-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.pd-mgmt-grid-cell {
  position: relative;
  background: #F8F9FA;
  border: 1rpx solid #EFE6D8;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  box-sizing: border-box;
}

.pd-mgmt-grid-icon {
  font-size: 40rpx;
  line-height: 1;
}

.pd-mgmt-grid-label {
  font-size: 24rpx;
  color: #495057;
  font-weight: 600;
}

/* 🔴 待办数量红点角标：叠在宫格右上角，与列表里的 .badge 同一套醒目红色，
   仅数字大于 0 时渲染，动态提示"有几件事要处理" */
.pd-mgmt-grid-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #E03131;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: bold;
  text-align: center;
  box-sizing: border-box;
  box-shadow: 0 2rpx 6rpx rgba(224, 49, 49, 0.35);
}

/* ===== 🆕 顶部卡片区（数据与高级功能）：左侧全国数据看板作为最高层级的
   全局数据视图，加粗放大突出展示；右侧专业服务弱化为轻量 Banner/Tag，
   只标明开通状态，不与左侧核心数据入口抢视觉焦点。配色与 .national-overview-card
   （超管的全国纵览卡片）同一套绿色系呼应，全站统一"全国/全局数据=绿色调"的
   视觉语言。取代原先并排的 .pd-advanced-row（专业版+全国数据看板同权重展示） ===== */
.top-advanced-row {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.top-advanced-primary {
  flex: 1.6;
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.10);
  box-sizing: border-box;
}

.top-advanced-primary-icon {
  font-size: 36rpx;
  line-height: 1;
}

.top-advanced-primary-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1F2937;
}

.top-advanced-primary-sub {
  font-size: 20rpx;
  color: #6B7280;
}

.top-advanced-primary-arrow {
  position: absolute;
  right: 20rpx;
  bottom: 22rpx;
  color: #10B981;
  font-size: 24rpx;
  font-weight: bold;
}

.top-advanced-secondary {
  flex: 1;
  background: #F8F9FA;
  border: 1rpx solid #E9ECEF;
  border-radius: 20rpx;
  padding: 18rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 6rpx;
  box-sizing: border-box;
}

.top-advanced-secondary-icon {
  font-size: 26rpx;
  line-height: 1;
}

.top-advanced-secondary-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #495057;
}

.top-advanced-secondary-tag {
  font-size: 20rpx;
  color: #9CA3AF;
}

.top-advanced-secondary.active .top-advanced-secondary-tag {
  color: #2B8A3E;
  font-weight: 600;
}

/* 🆕 大家长视角·个人荣誉模块折叠摘要条 + 展开/收起按钮：与「更多系统工具」
   （.sa-light-action-row/showAdminMoreTools）同一套折叠交互语言，用 ﹀/︿ 同源的
   ∨/∧ 符号提示可展开收起 */
.pd-honor-collapsed-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.pd-honor-collapsed-icon {
  font-size: 26rpx;
}

.pd-honor-collapsed-text {
  font-size: 26rpx;
  color: #495057;
  font-weight: 600;
}

.pd-honor-collapsed-arrow {
  font-size: 22rpx;
  color: #9CA3AF;
}

.pd-honor-collapse-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #868E96;
}

/* ── 💖 全网爱心支持卡片：个人页公开展示区，不含门店总数/服务人次等运营数据
   （那些留在统计页专属大屏），只保留发心分布比例条 + 最新爱心支持善缘墙 ── */
.national-overview-card {
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  border-radius: 24rpx;
  padding: 28rpx 24rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.08);
}

/* 发心分布：阳善 vs 积阴德——迁移自统计页全国大屏，配色（金/靛蓝）原样保留 */
.no-merit-section {
  border-top: 1rpx solid #F3F4F6;
  margin-top: 20rpx;
  padding-top: 16rpx;
}

/* 卡片内第一块内容时去掉顶部分隔线——不再有 KPI 网格/卡片标题挡在它前面 */
.no-merit-section--first {
  border-top: none;
  margin-top: 0;
  padding-top: 0;
}

.no-merit-title {
  font-size: 22rpx;
  color: #6B7280;
  display: block;
  margin-bottom: 10rpx;
}

.no-merit-bar-wrap {
  display: flex;
  height: 16rpx;
  border-radius: 100rpx;
  overflow: hidden;
  background: #F3F4F6;
  margin-bottom: 10rpx;
}

.no-merit-seg {
  height: 100%;
  min-width: 2rpx;
}

.no-merit-seg.seg-yang { background: linear-gradient(90deg, #F59E0B, #FBBF24); }
.no-merit-seg.seg-yin  { background: linear-gradient(90deg, #6366F1, #818CF8); }

.no-merit-legend {
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
}

.no-merit-legend-item {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.no-merit-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
  /* 图例现在是两行文字（百分比 + 说明文案），圆点与首行文字对齐，而不是整块居中 */
  margin-top: 6rpx;
}

.no-merit-dot.dot-yang { background: #F59E0B; }
.no-merit-dot.dot-yin  { background: #6366F1; }

.no-merit-legend-text-col {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.no-merit-legend-text {
  font-size: 20rpx;
  color: #6B7280;
}

/* 🆕 解释性提示文案：与首页「发心选择」卡片同一套措辞/字号层级——说明文案
   比百分比更弱化一档 */
.no-merit-legend-caption {
  font-size: 18rpx;
  color: #9CA3AF;
}

/* ✨ 最新爱心支持（阳善公开）善缘墙已抽成独立组件 <yangshan-wall/>（见
   components/yangshan-wall），自带面板样式；这里只需要给它跟上面比例条
   留一点间距，不必再维护一整套 .no-donor-* 滚动墙样式 */
.no-yangshan-wall-slot {
  margin-top: 20rpx;
}

.pd-section-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 20rpx 0 12rpx;
}

.pd-section-icon {
  font-size: 22rpx;
}

.pd-section-txt {
  font-size: 24rpx;
  font-weight: 600;
  color: #868E96;
  letter-spacing: 0.5rpx;
}

.pd-void-card,
.pd-profile-card {
  background: #FFFBE6;
  border: 1rpx solid #FFE58F;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.pd-void-info {
  margin-bottom: 16rpx;
}

.pd-void-date {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
  margin-bottom: 6rpx;
}

.pd-void-amount {
  font-size: 22rpx;
  color: #868E96;
}

.pd-profile-items {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 20rpx;
  margin-bottom: 16rpx;
}

.pd-profile-item {
  font-size: 24rpx;
  color: #5C4326;
}

.pd-void-actions {
  display: flex;
  gap: 16rpx;
}

.pd-btn-reject {
  flex: 1;
  background: #F1F3F5;
  color: #495057;
  border-radius: 12rpx;
  font-size: 26rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.pd-btn-approve {
  flex: 1;
  background: #D48806;
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: bold;
  height: 72rpx;
  line-height: 72rpx;
}

.pd-empty-tip {
  text-align: center;
  padding: 40rpx 0;
  color: #ADB5BD;
  font-size: 24rpx;
}

.pd-loading-box {
  text-align: center;
  padding: 40rpx 0;
  color: #ADB5BD;
  font-size: 24rpx;
}

/* 📮 爱心意见箱管理入口：店长/家长/超管共用的 patriarch-panel-card 内新增区块 */
.pd-feedback-entry-title {
  margin-top: 16rpx;
}

.pd-feedback-entry-cell {
  background: #FAF8F5;
  border-radius: 16rpx;
  margin: 0;
}

/* patriarch-panel-card 内连续的 pd-feedback-entry-cell 之间留细缝，
   让每个 16rpx 圆角"药片行"彼此分开，不粘连在一起 */
.pd-feedback-entry-cell + .pd-feedback-entry-cell {
  margin-top: 4rpx;
}

.pd-feedback-entry-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 🔴 .unread-badge 与 .badge 共用同一套醒目红色圆角数字角标样式——.badge 一般
   放在行尾（靠近箭头），.unread-badge 紧跟在入口标题文字右侧（如"我的餐报
   提交记录"），两种排布位置不同但视觉语言保持一致 */
.badge,
.unread-badge {
  display: inline-block;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #E03131;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: bold;
  text-align: center;
  box-sizing: border-box;
  vertical-align: middle;
  margin-right: 8rpx;
}

.action-list-container {
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 28rpx;
  padding: 10rpx 0;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.action-item-cell {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 32rpx;
  background: #FFFFFF;
}

.action-item-cell:not(:last-child) {
  border-bottom: 1rpx solid #FAF6F0;
}

.action-item-cell:active {
  background: #FAF8F5;
}

/* 🌟 菜单项点击态统一使用 hover-class="ui-hover"（比 :active 伪类更可靠的小程序
   触控反馈机制），与 :active 背景色保持一致，两者共存不冲突 */
.ui-hover {
  background: #FAF8F5;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.item-text {
  font-size: 26rpx;
  color: #444444;
  font-weight: 500;
  line-height: 1;
}

.item-arrow {
  font-size: 20rpx;
  color: #C7C7CC;
}

/* 🌟 店长专属管理入口："淡金底强化行"语言，让店长在自己的个人页里
   一眼看到这一行明显跟普通义工看到的列表不一样——权限层级的视觉区隔，不只是多一行文字 */
.manager-only-cell {
  background: linear-gradient(135deg, #FFFDF5 0%, #FFF3E0 100%);
}

.manager-only-cell:active {
  background: #FFE9C4;
}

.manager-only-emoji {
  font-size: 32rpx;
  width: 38rpx;
  flex-shrink: 0;
  text-align: center;
}

.item-premium-tag {
  font-size: 18rpx;
  font-weight: bold;
  color: #92400E;
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  border: 1rpx solid #F59E0B;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 10rpx;
  flex-shrink: 0;
}

/* 关于与帮助分组内的"切换身份"行：保留列表统一样式，仅文字提示危险语义 */
.danger-cell:active {
  background: #FFF5F5;
}

.item-text.danger-text {
  color: #D32F2F;
}

/* 低权限自助入口：刻意置于列表最下方且弱化视觉，符合"高权限低频功能不抢焦点"的排版逻辑 */
.subtle-group {
  margin-bottom: 30rpx;
}

.subtle-cell {
  padding: 22rpx 32rpx;
}

.subtle-text {
  color: #999999;
  font-weight: 400;
  font-size: 24rpx;
}

.subtle-icon {
  opacity: 0.45;
}

/* 开发者与超管工具箱：独立成卡（原先依附在 .action-list-container 内，
   现已拆分为独立分组，需要补回卡片背景/边框，避免变成无背景的裸列表） */
.admin-developer-section {
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 28rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
}

.admin-divider {
  font-size: 20rpx;
  font-weight: bold;
  color: #8E8E93;
  background: #F2F2F7;
  padding: 10rpx 32rpx;
}

/* ==========================================
   🌟 核心修复：高兼容性 SVG 矢量背景图注入
   ========================================== */

.item-icon-svg {
  width: 38rpx;
  height: 38rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  flex-shrink: 0;
}

.badge-icon-svg {
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  display: inline-block;
  vertical-align: middle;
}

.header-icon-svg {
  width: 32rpx;
  height: 32rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.flip-x {
  transform: scaleX(-1);
}

/* 🌟 统一菜单图标色调为深古铜色（不使用红色），提升整体质感的同时更符合"荣誉"而非"警示"的调性 */
.icon-svg-history { background-image: url('data:image/svg+xml;base64,'); }

.icon-svg-about { background-image: url('data:image/svg+xml;base64,'); }

.icon-svg-key { background-image: url('data:image/svg+xml;base64,'); }

.icon-svg-clear { background-image: url('data:image/svg+xml;base64,'); }

/* 🐛 顺带修复：原图标末尾坐标是损坏数据 y2="1*"，已修正为合法的 21 */
.icon-svg-screen { background-image: url('data:image/svg+xml;base64,'); }

/* 🐛 顺带修复：原图标 base64 数据已损坏（含非法字节，浏览器会渲染为空白/破图），重新绘制为简洁莲花双瓣造型 */
.icon-svg-flower { background-image: url('data:image/svg+xml;base64,'); }

/* 新增：昵称行编辑入口图标（简洁铅笔造型） */
.icon-svg-edit { background-image: url('data:image/svg+xml;base64,'); }

.icon-svg-release { background-image: url('data:image/svg+xml;base64,'); }

/* 🆕 日常记录列表图标统一：本店数据看板 / 门店档案 / 爱心建议箱三项此前用手打
   emoji（📊📋🏠📮），与同组「我的护持历程」「我的提交与数据」的 SVG 矢量图标
   风格不一致——补齐三枚同款 Feather 风格线性图标（bar-chart-2 / home / mail），
   笔触色沿用统一的深古铜色 #8B6F47，全组图标风格归一 */
.icon-svg-bar-chart { background-image: url('data:image/svg+xml;base64,'); }

.icon-svg-home { background-image: url('data:image/svg+xml;base64,'); }

.icon-svg-mail { background-image: url('data:image/svg+xml;base64,'); }

/* ==========================================
   🚪 卸任特权 Warning 弹窗
   ========================================== */
.release-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.release-modal-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.release-modal-card {
  width: 82%;
  max-width: 620rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 36rpx 36rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  transform: scale(0.9) translateY(20rpx);
  opacity: 0;
  transition: all 0.25s ease;
}

.release-modal-mask.show .release-modal-card {
  transform: scale(1) translateY(0);
  opacity: 1;
}

.release-warning-icon {
  display: block;
  text-align: center;
  font-size: 72rpx;
  margin-bottom: 20rpx;
  line-height: 1;
}

.release-modal-title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
  margin-bottom: 32rpx;
  line-height: 1.5;
}

.release-role-highlight {
  color: #D32F2F;
}

.release-consequence-list {
  background: #FFF5F5;
  border: 1.5rpx solid #FFCDD2;
  border-radius: 20rpx;
  padding: 24rpx 24rpx 8rpx;
  margin-bottom: 36rpx;
}

.release-consequence-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.bullet-dot {
  font-size: 26rpx;
  color: #D32F2F;
  margin-right: 12rpx;
  line-height: 1.6;
  flex-shrink: 0;
}

.bullet-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #5C5C5C;
  line-height: 1.6;
  word-break: break-all;
}

.release-consequence-item.danger .bullet-text {
  color: #D32F2F;
  font-weight: bold;
}

.release-modal-footer {
  display: flex;
  gap: 20rpx;
}

.release-btn-cancel,
.release-btn-confirm {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 42rpx;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.release-btn-cancel::after,
.release-btn-confirm::after {
  border: none;
}

.release-btn-cancel {
  background: #F1F3F5;
  color: #495057;
}

.release-btn-cancel:active {
  transform: scale(0.96);
  background: #E9ECEF;
}

.release-btn-confirm {
  background: linear-gradient(135deg, #E53935 0%, #C62828 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(198, 40, 40, 0.35);
}

.release-btn-confirm:active {
  transform: scale(0.96);
  opacity: 0.9;
  box-shadow: 0 4rpx 10rpx rgba(198, 40, 40, 0.3);
}

/* 🌟 工时保留承诺：与上方 .release-consequence-list 的淡红警示形成鲜明对比，
   浅绿底色传达"这部分不受影响、可以放心"，两种情绪在同一屏内清晰可辨 */
.release-safe-notice {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  background: #EBFBEE;
  border: 1.5rpx solid #B2F2BB;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 36rpx;
}

.safe-icon {
  font-size: 26rpx;
  line-height: 1.6;
  flex-shrink: 0;
}

.safe-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #2B8A3E;
  font-weight: bold;
  line-height: 1.6;
}

/* ================= 🏛️ 切换身份面板：多角色兼任时的身份切换/退出入口 ================= */
.switch-identity-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.switch-identity-modal-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.switch-identity-card {
  width: 82%;
  max-width: 620rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 36rpx 36rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  transform: scale(0.9) translateY(20rpx);
  opacity: 0;
  transition: all 0.25s ease;
}

.switch-identity-modal-mask.show .switch-identity-card {
  transform: scale(1) translateY(0);
  opacity: 1;
}

.switch-identity-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.switch-identity-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
}

.switch-identity-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #F1F3F5;
  color: #868E96;
  font-size: 26rpx;
}

.switch-identity-desc {
  display: block;
  font-size: 24rpx;
  color: #868E96;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.switch-identity-option-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.switch-identity-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFF8E1;
  border: 1.5rpx solid #FFE082;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  transition: all 0.15s ease;
}

.switch-identity-option:active {
  transform: scale(0.98);
  background: #FFECB3;
}

.switch-identity-option .option-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #8C5A00;
}

.switch-identity-option .option-arrow {
  font-size: 22rpx;
  color: #D9A441;
}

.switch-identity-divider {
  height: 1.5rpx;
  background: #F1F3F5;
  margin: 32rpx 0 24rpx;
}

.btn-exit-binding {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #868E96;
  background: #F1F3F5;
  border-radius: 40rpx;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  transition: transform 0.12s ease, background 0.12s ease;
}

.btn-exit-binding::after {
  border: none;
}

.btn-exit-binding:active {
  transform: scale(0.97);
  background: #E9ECEF;
}

/* ================= 🏅 数字荣誉墙 ================= */

.honor-wall-card {
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 28rpx;
  padding: 24rpx 28rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(239, 230, 216, 0.3);
}

.honor-wall-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.honor-wall-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
}

.honor-wall-cert-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: #8C1D18;
  padding: 8rpx 12rpx;
  border-radius: 20rpx;
  margin-right: -12rpx;
}

.honor-wall-cert-link:active {
  background: #F5E8E8;
}

.honor-badge-scroll {
  width: 100%;
  white-space: nowrap;
}

.honor-badge-row {
  display: flex;
  gap: 28rpx;
  padding: 4rpx 4rpx 8rpx;
}

.honor-badge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  width: 108rpx;
  transition: transform 0.15s ease;
}

.honor-badge-item:active {
  transform: scale(0.94);
}

.honor-badge-circle {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 已解锁：饱满金色渐变 + 微光投影 + 持续炫光呼吸动画，点击时整体缩放做"微光"反馈（见 .honor-badge-item:active） */
.honor-badge-item.unlocked .honor-badge-circle {
  background: linear-gradient(135deg, #F1C40F 0%, #B8860B 100%);
  box-shadow: 0 0 0 4rpx #FFF3BF, 0 6rpx 16rpx rgba(184, 134, 11, 0.45);
  animation: badgeGlowPulse 2.4s ease-in-out infinite;
}

@keyframes badgeGlowPulse {
  0%, 100% { box-shadow: 0 0 0 4rpx #FFF3BF, 0 6rpx 16rpx rgba(184, 134, 11, 0.45); }
  50% { box-shadow: 0 0 0 8rpx #FFF3BF, 0 6rpx 24rpx rgba(184, 134, 11, 0.7); }
}

/* 未点亮：小圆角百分比标签叠在徽章圆环右下角，柔和灰阶基础上标出完成进度 */
.honor-badge-percent {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  font-size: 16rpx;
  color: #8C6D46;
  background: #FFF9E8;
  border: 1rpx solid #E9D8B0;
  border-radius: 16rpx;
  padding: 1rpx 8rpx;
  line-height: 1.4;
  white-space: nowrap;
}

.honor-badge-item.unlocked .honor-badge-emoji {
  font-size: 44rpx;
}

.honor-badge-item.unlocked .honor-badge-name {
  color: #8C1D18;
  font-weight: bold;
}

/* 未解锁：整体置灰半透明，与已解锁形成清晰的"未达成"视觉信号 */
.honor-badge-item.locked .honor-badge-circle {
  background: #E9ECEF;
  opacity: 0.4;
}

.honor-badge-item.locked .honor-badge-emoji {
  font-size: 40rpx;
  filter: grayscale(100%);
}

.honor-badge-item.locked .honor-badge-name {
  color: #ADB5BD;
}

.honor-badge-name {
  font-size: 20rpx;
  text-align: center;
}

/* ================= 🎖️ 徽章详情 Modal ================= */
/* 复用 .certificate-modal-mask/.certificate-modal-header/.certificate-modal-close
   同一套弹窗壳，这里只需要 badge-detail-card 覆盖内边距 + 卡片正文样式 */
.badge-detail-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 8rpx;
}

.badge-detail-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.badge-detail-circle.unlocked {
  background: linear-gradient(135deg, #F1C40F 0%, #B8860B 100%);
  box-shadow: 0 0 0 6rpx #FFF3BF, 0 6rpx 16rpx rgba(184, 134, 11, 0.45);
}

.badge-detail-circle.glow-anim {
  animation: badgeGlowPulse 2.4s ease-in-out infinite;
}

.badge-detail-circle.unlocked .badge-detail-emoji {
  font-size: 56rpx;
}

.badge-detail-circle.locked {
  background: #E9ECEF;
  opacity: 0.6;
}

.badge-detail-circle.locked .badge-detail-emoji {
  font-size: 52rpx;
  filter: grayscale(100%);
}

.badge-detail-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.badge-detail-status {
  font-size: 22rpx;
  color: #ADB5BD;
  margin-bottom: 16rpx;
}

.badge-detail-status.unlocked {
  color: #2B8A3E;
  font-weight: bold;
}

/* 🎖️ 勋章寓意：比解锁条件更"有温度"的一句话说明，颜色略深、字号略大做视觉区分 */
.badge-detail-meaning {
  font-size: 25rpx;
  color: #8C1D18;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.badge-detail-desc {
  font-size: 24rpx;
  color: #6B5B45;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.badge-detail-progress-track {
  width: 100%;
  height: 16rpx;
  border-radius: 8rpx;
  background: #F1F3F5;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.badge-detail-progress-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #F1C40F 0%, #B8860B 100%);
  transition: width 0.3s ease;
}

.badge-detail-progress-text {
  font-size: 22rpx;
  color: #A08A6A;
}

/* 🌟 已解锁荣誉的分享入口 */
.badge-detail-share-btn {
  width: 100%;
  margin-top: 20rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #FFFFFF;
  background: linear-gradient(135deg, #F1C40F 0%, #B8860B 100%);
  border-radius: 38rpx;
  box-shadow: 0 6rpx 16rpx rgba(184, 134, 11, 0.35);
}

.badge-detail-share-btn::after {
  border: none;
}

/* ================= 🌟 义工证书 Modal ================= */

/* 🐛 硬性根治：本弹窗（驳回原因/拒绝申请原因等）经常是从「待审核的义工餐报与
   物资」这类半屏抽屉（.feedback-sheet-backdrop/.feedback-sheet-panel，
   z-index: 999998/999999 !important）里点开的二级弹窗。此前 z-index: 2000
   远低于抽屉的层级，导致弹出后视觉上仍被压在抽屉下面、看不见驳回输入框。
   这里顶到比抽屉更高的层级，并同样用 !important 排除任何后续样式意外覆盖 */
.certificate-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999999 !important;
}

.certificate-modal-card {
  width: 88%;
  max-width: 660rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 24rpx 32rpx;
  box-sizing: border-box;
}

.certificate-modal-header {
  display: flex;
  align-items: center;
  /* 标题文字已删除，header 现在只剩关闭按钮——改成 flex-end 让它继续贴右上角，
     不再需要 space-between 那种"两端对齐"布局 */
  justify-content: flex-end;
  margin-bottom: 20rpx;
}

.certificate-modal-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #F1F3F5;
  color: #6B7280;
  font-size: 24rpx;
}

/* 🏷️ 快捷驳回标签：常见驳回原因一键填入，减少店长手动打字 */
.quick-reject-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.quick-reject-tag {
  font-size: 22rpx;
  color: #6B5B45;
  background: #F5F0E6;
  border: 1rpx solid #E5DCC8;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  line-height: 1.4;
}

.quick-reject-tag.active {
  color: #FFFFFF;
  background: #C0392B;
  border-color: #C0392B;
}

.certificate-canvas-wrap {
  position: relative;
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  background: #F1E6C8;
  /* Canvas 用 style 里的 px 精确控制尺寸（与 drawVolunteerCertificate 的 width/height 参数一致），
     这里用等比留白让容器高度跟随，避免绘制中/绘制前出现明显的高度跳变 */
  min-height: 480rpx;
  /* 给证书卡片加一圈投影，让它从弹窗背景里"浮"出来，更有实体证书的质感 */
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
}

.certificate-canvas {
  position: absolute;
  top: 0;
  left: 0;
  /* Canvas 节点本身不需要可见——它只是绘制源，最终展示的是下面的 <image>；
     保留在文档流里但视觉上完全被 image 盖住即可，不需要额外裁剪技巧 */
}

.certificate-preview-img {
  position: relative;
  width: 100%;
  display: block;
  border-radius: 16rpx;
}

.certificate-loading-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(251, 246, 233, 0.9);
  font-size: 24rpx;
  color: #8C6D46;
}

.certificate-save-btn {
  margin-top: 40rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #B8860B 0%, #DAA520 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(184, 134, 11, 0.35);
}

.certificate-save-btn::after {
  border: none;
}

.certificate-save-btn:active {
  opacity: 0.85;
  box-shadow: 0 2rpx 6rpx rgba(184, 134, 11, 0.2);
}

.certificate-save-btn[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

/* 家人证书专属操作按钮：与义工版 certificate-save-btn 同一套暖金质感，
   与义工按钮独立成一份，避免共用类名时因家人分支 disabled 语义不同而互相牵连 */
.certificate-family-save-btn {
  margin-top: 24rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #B8860B 0%, #DAA520 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(184, 134, 11, 0.35);
}

.certificate-family-save-btn::after {
  border: none;
}

.certificate-family-save-btn:active {
  opacity: 0.85;
  box-shadow: 0 2rpx 6rpx rgba(184, 134, 11, 0.2);
}

/* 🌸 家人版纯文本证书：与义工版 Canvas 证书共用同一个 certificate-modal-mask/
   certificate-modal-card 弹窗壳，这里只负责正文区域的排版，不含 Canvas/二维码。
   宣纸暖米白底 + 双重古典边框 + 朱红印鑑，营造纸质荣誉证书的仪式感 */
.certificate-family-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 8rpx 8rpx;
  background: #FAF6F0;
  border-radius: 12rpx;
}

.cf-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.cf-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #8C1D18;
  letter-spacing: 2rpx;
}

/* 双重边框：外层 certificate-family-body 的暖米白底本身算作外圈，
   这里再加一圈实线 + 内边距，形成"证书纸+装裱边框"的双层观感 */
.cf-inner-border {
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid #E2D1B2;
  padding: 24rpx;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.certificate-family-icon {
  font-size: 56rpx;
  margin-bottom: 20rpx;
}

/* 抬头顶格加粗：与正文分开单独一行，模拟传统证书"尊敬的...："起首语气 */
.cert-salutation {
  align-self: stretch;
  font-size: 28rpx;
  font-weight: bold;
  color: #5A3E2B;
  margin-bottom: 16rpx;
  text-align: left;
}

/* 正文段落：首行缩进两字 + 两端对齐，贴近实体证书的排版手感 */
.cert-paragraph {
  align-self: stretch;
  font-size: 26rpx;
  color: #6C4F3B;
  line-height: 1.8;
  text-indent: 2em;
  text-align: justify;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.cf-signature-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  align-self: stretch;
  gap: 16rpx;
  margin-top: 32rpx;
}

.cf-signature-text {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.cf-sign-line {
  font-size: 24rpx;
  color: #6B4C1E;
  line-height: 1.5;
}

/* 朱红古典印鑑：正方形、微旋转，模拟盖章时的随手歪斜手感 */
.cf-seal {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  border: 3rpx solid #C0392B;
  border-radius: 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform: rotate(-6deg);
  color: #C0392B;
  opacity: 0.88;
  box-shadow: 0 0 0 1rpx rgba(192, 57, 43, 0.15) inset;
}

.cf-seal-line {
  font-size: 22rpx;
  font-weight: bold;
  line-height: 1.3;
}

/* 🌸 雨花温情故事说明弹窗：与 certificate-modal-* 同一套弹窗视觉规范 */
.warm-story-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.warm-story-modal-card {
  width: 88%;
  max-width: 660rpx;
  background: linear-gradient(155deg, #FFF8F0 0%, #FFFFFF 60%);
  border-radius: 28rpx;
  padding: 28rpx 24rpx 32rpx;
  box-sizing: border-box;
}

.warm-story-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.warm-story-modal-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #222222;
}

.warm-story-modal-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #F1F3F5;
  color: #6B7280;
  font-size: 24rpx;
}

.warm-story-modal-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 4rpx 0;
}

.warm-story-modal-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

/* 正文段落：改居中为两端对齐 + 首行缩进两字，贴近实体文章的阅读排版；
   align-self:stretch 覆盖父级 .warm-story-modal-body 的 align-items:center
   （默认会把文本框收缩成"内容多宽就多宽"，text-indent/justify 需要撑满整行才有意义） */
.warm-story-modal-text {
  display: block;
  align-self: stretch;
  font-size: 26rpx;
  color: #6B4C1E;
  line-height: 1.8;
  text-align: justify;
  text-indent: 2em;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.warm-story-view-log-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  margin-top: 12rpx;
  background: linear-gradient(135deg, #E6A23C 0%, #DAA520 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 42rpx;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(230, 162, 60, 0.35);
}

.warm-story-view-log-btn::after {
  border: none;
}

.warm-story-view-log-btn:active {
  opacity: 0.85;
}

/* 📮 爱心意见箱：半屏底部弹窗，与 mine-quick-sheet 组件同一套 backdrop/panel/
   drag-handle 视觉规范（fixed 遮罩 + 底部滑出面板），保持全站弹窗手感统一 */
/* 🐛 自定义 TabBar（custom-tab-bar，z-index: 998）曾经把本弹窗底部的提交按钮
   盖住——弹窗结构里没有独立的遮罩层元素，.feedback-sheet-backdrop 本身同时
   兼任"全屏遮罩"与"面板定位容器"两个角色，这里用 !important 顶到最高层级，
   排除任何后续样式意外覆盖的可能 */
.feedback-sheet-backdrop {
  position: fixed !important;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999998 !important;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  opacity: 0;
  transition: opacity 0.25s ease;
}

.feedback-sheet-backdrop.show {
  opacity: 1;
}

.feedback-sheet-panel {
  position: relative;
  z-index: 999999 !important;
  width: 100%;
  background: #FBF9F5;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  /* 140rpx 安全抬升边距：custom-tab-bar 实际高度 100rpx，这里额外多留 40rpx
     缓冲，确保提交按钮完整露在 TabBar 上方——不再依赖按钮自己的 padding-bottom
     去凑这个安全区，直接在面板层级一次性预留够 */
  padding: 16rpx 28rpx calc(140rpx + env(safe-area-inset-bottom)) !important;
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.25s ease;
}

.feedback-sheet-backdrop.show .feedback-sheet-panel {
  transform: translateY(0);
}

.feedback-sheet-drag-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #E3D9C8;
  margin: 0 auto 24rpx;
}

.feedback-sheet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.feedback-sheet-header-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.feedback-sheet-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.feedback-sheet-subtitle {
  font-size: 22rpx;
  color: #A08A6A;
}

.feedback-sheet-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #F1F3F5;
  color: #6B7280;
  font-size: 24rpx;
  flex-shrink: 0;
}

/* 💌 家人意见箱双 Tab：提交建议 / 我的反馈与回复 */
.feedback-modal-tab-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #F1EBE0;
}

.feedback-modal-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #A08A6A;
  border-bottom: 4rpx solid transparent;
}

.feedback-modal-tab.active {
  color: #B8860B;
  font-weight: bold;
  border-bottom-color: #DAA520;
}

.feedback-modal-tab-badge {
  position: relative;
  top: 0;
}

.my-feedback-list-scroll {
  max-height: 60vh;
}

.my-feedback-item {
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

/* 🐛 根因修复：已驳回的卡片现在可点击查看详情/重新修改提交，加一点可点击的
   视觉提示（active 态轻微变暗），区别于待确认/已采纳这两个纯展示态卡片 */
.my-feedback-item.tappable {
  transition: opacity 0.15s ease;
}

.my-feedback-item.tappable:active {
  opacity: 0.7;
}

/* 🚨 已驳回卡片警示态：淡红底 + 柔和红框，让需要修改重提的卡片在列表里一眼可辨，
   不用逐条看状态标签才知道哪几条要处理 */
.my-feedback-item.rejected {
  background: #FFF5F5;
  border: 1rpx solid #FED7D7;
  border-radius: 16rpx;
}

.my-feedback-reply {
  margin-top: 12rpx;
}

.my-feedback-pending-tag {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #ADB5BD;
}

.feedback-type-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.feedback-type-pill {
  padding: 14rpx 24rpx;
  border-radius: 32rpx;
  background: #F1EBE0;
  border: 2rpx solid transparent;
  color: #6B5B45;
  font-size: 24rpx;
  box-sizing: border-box;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.feedback-type-pill.active {
  background: linear-gradient(135deg, #E6A23C 0%, #DAA520 100%);
  border-color: #B8860B;
  color: #FFFFFF;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(184, 134, 11, 0.4);
}

.feedback-content-textarea {
  width: 100%;
  min-height: 180rpx;
  max-height: 320rpx;
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #333333;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.feedback-textarea-placeholder {
  color: #C7BBA8;
}

.feedback-submit-btn {
  width: 100%;
  min-height: 88rpx;
  /* 安全区缓冲已经由 .feedback-sheet-panel 的 padding-bottom 统一预留
     （140rpx + env(safe-area-inset-bottom)），这里不再重复叠加一次，
     避免按钮下方出现两倍安全区的多余空白 */
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  background: linear-gradient(135deg, #B8860B 0%, #DAA520 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(184, 134, 11, 0.35);
}

.feedback-submit-btn::after {
  border: none;
}

.feedback-submit-btn:active {
  opacity: 0.85;
}

.feedback-submit-btn[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

/* 📮 爱心意见箱管理弹窗：复用 .feedback-sheet-backdrop/.feedback-sheet-panel 的
   遮罩+滑出动效，这里只补充"列表可滚动、限制最大高度"这类管理弹窗特有的样式。
   🐛 根因修复：基类 .feedback-sheet-panel 的 padding-bottom 是为"面板底部有固
   定提交按钮"这一场景设计的（140rpx 预留 TabBar 遮挡缓冲）。所有使用本类的弹窗
   （意见箱管理/餐报提交/成员管理/申请审批等）操作按钮均在 scroll-view 内的列表
   项里，底部没有固定按钮，继承 140rpx 底部内边距只会制造一大块死白空间，同时挤
   压了 scroll-view 的可用高度（原 max-height: 55vh 与 140rpx 夹攻）。这里用
   !important 覆盖，改为仅保留安全区留白，列表内最后一项已有 fa-safe-area-spacer
   兜底，不再需要外层内边距重复处理安全区 */
.feedback-admin-sheet-panel {
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  padding-bottom: constant(safe-area-inset-bottom) !important;
  padding-bottom: env(safe-area-inset-bottom) !important;
}

/* ⏳✅ 待处理 / 已处理 Tab 切换栏 */
.fa-tab-bar {
  display: flex;
  border-bottom: 2rpx solid #EFE6D8;
  padding: 0 32rpx;
  flex-shrink: 0;
}

.fa-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #ADB5BD;
  font-weight: 500;
  border-bottom: 4rpx solid transparent;
  margin-bottom: -2rpx;
  transition: color 0.15s ease, border-color 0.15s ease;
}

.fa-tab.active {
  color: #E75B3E;
  border-bottom-color: #E75B3E;
  font-weight: bold;
}

.fa-tab-badge {
  font-size: 20rpx;
  font-weight: bold;
  color: #FFFFFF;
  background: #E75B3E;
  border-radius: 20rpx;
  padding: 2rpx 10rpx;
  min-width: 32rpx;
  text-align: center;
  line-height: 1.4;
}

.feedback-admin-list-scroll {
  flex: 1;
  min-height: 0;
  /* max-height: 55vh 已移除：配合上方 padding-bottom 修复，scroll-view 现在靠
     flex: 1 自然填满 85vh 面板内的剩余空间，不再需要人工上限截断 */
}

/* 安全区底部留白 */
.fa-safe-area-spacer {
  height: calc(20rpx + constant(safe-area-inset-bottom));
  height: calc(20rpx + env(safe-area-inset-bottom));
}

.feedback-admin-loading,
.feedback-admin-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #ADB5BD;
  font-size: 24rpx;
}

.feedback-admin-item {
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.06);
  transition: opacity 0.15s ease;
}

.feedback-admin-item.is-handled {
  opacity: 0.6;
}

.fa-item-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.fa-item-nickname {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.fa-item-type-tag {
  font-size: 26rpx;
  color: #D9480E;
  background-color: #FFF3BF;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
  /* 🐛 修复：与右侧紧接着的 .fa-item-time 日历图标贴在一起没有呼吸感，补一点右边距 */
  margin-right: 20rpx;
}

/* 🐛 可读性修复：20rpx + #ADB5BD 浅灰在小屏幕上时间文本糊成一团难以辨认，
   调大字号并加深至清晰的墨灰色，加中等字重提升辨识度 */
.fa-item-time {
  display: block;
  font-size: 26rpx;
  color: #4A5568;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.fa-item-content {
  display: block;
  font-size: 26rpx;
  color: #495057;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

/* 🌟 核心数据加强：用餐人数（早/午/晚）与物资消耗（米/面/油/菜）是这张卡片
   最重要的信息，比备注/说明这类次要文本更需要一眼看清——只加在这两行上，
   不影响 .fa-item-content 在意见箱内容/手机号/门店档案等其他场景的展示 */
.fa-item-core-data {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A202C;
  line-height: 1.5;
}

/* 📝 备注/说明：与上面核心数据行区分开的次要信息，上下各留一点边距，
   避免紧挨着核心数据行或底部的【店长已采纳】/【待店长确认】状态标签 */
.fa-item-note {
  font-size: 26rpx;
  color: #4A5568;
  margin-top: 12rpx;
  margin-bottom: 16rpx;
}

/* 数字高亮：在核心数据行内进一步突出具体数量，让人数/斤数比周围的标签文字更醒目 */
.highlight-num {
  color: #27AE60;
  font-weight: 600;
}

/* 待处理行动区：标记为已处理 / 回复家人 并排两个按钮 */
.fa-item-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

/* 🎨 圆角微渐变 Pill 按钮：与 .fa-reply-submit-btn/.feedback-submit-btn 的实心
   品牌渐变不同——这两个是列表项内的次级操作，逐条滚动时若每条都是高饱和实心
   渐变会显得视觉噪音很重，改用同色系浅→浅的柔和微渐变，质感升级但不抢主按钮的焦点
   🐛 根因修复：原来只靠 height === line-height 让文字垂直居中——微信原生 <button>
   自带默认内边距（左右 ~30rpx）与基线度量，emoji（✅/❌）与中文混排时行高基线
   本就和纯文本不一致，两者叠加导致按钮内文字/图标肉眼可见地偏左上或偏斜。
   显式 flex 居中 + box-sizing/padding/margin 归零，彻底不依赖 line-height 这条
   脆弱的隐式规则 */
.fa-item-handle-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 1;
  font-size: 25rpx;
  font-weight: bold;
  color: #FFFFFF;
  background: linear-gradient(135deg, #40C057 0%, #2B8A3E 100%);
  border: none;
  border-radius: 36rpx;
  box-shadow: 0 4rpx 10rpx rgba(43, 138, 62, 0.3);
  transition: transform 0.1s ease, opacity 0.1s ease, box-shadow 0.1s ease;
}

.fa-item-handle-btn::after {
  border: none;
}

.fa-item-handle-btn:active {
  transform: scale(0.96);
  opacity: 0.88;
  box-shadow: none;
}

.fa-item-handle-btn[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

/* ⚠️ 驳回：浅红警告色，与"一键采纳入库"的绿色主色形成明确的语义对比——
   一个是不可逆的正向确认操作，一个是需要用户三思的否定操作 */
.fa-item-reply-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 1;
  font-size: 25rpx;
  font-weight: bold;
