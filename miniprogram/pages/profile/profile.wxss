  background: linear-gradient(135deg, #FFF8F3 0%, #FFEDE0 100%) !important;
  border-color: #F4A57A !important;
}

/* 🍱🌾 义工现场服务工具表单：与 feedback-sheet-* 共用弹窗壳，这里只补充
   表单专属的标签/单选胶囊/数字输入框样式 */
.vt-form-label {
  display: block;
  font-size: 24rpx;
  color: #6B5B45;
  margin-bottom: 12rpx;
}

/* 📊「我的提交与数据」弹窗顶部月度统计摘要：合并原"我的统计数据"入口，
   轻量摘要 + 跳转完整统计页的入口，见 computeMonthlySubmissionStats() */
.my-vs-monthly-stats {
  background: #FFF9F0;
  border: 1rpx solid #F1E6D8;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.my-vs-monthly-stats-row {
