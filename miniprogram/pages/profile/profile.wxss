  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 1;
  font-size: 25rpx;
  font-weight: bold;
  color: #C92A2A;
  background: linear-gradient(135deg, #FFF5F5 0%, #FFE3E3 100%);
  border: 2rpx solid #FFA8A8;
  border-radius: 36rpx;
  transition: transform 0.1s ease, opacity 0.1s ease;
}

.mm-remove-btn::after { border: none; }

.mm-remove-btn:active {
  transform: scale(0.96);
  opacity: 0.85;
}

.mm-remove-btn[disabled] {
  opacity: 0.45;
  box-shadow: none;
}

.fa-item-handled-tag {
  display: inline-block;
  margin-top: 4rpx;
  font-size: 22rpx;
  font-weight: bold;
  color: #2B8A3E;
  background: #EBFBEE;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* 💬 展开式回复输入框：与 feedback-content-textarea 同一套输入框视觉规范 */
.fa-reply-box {
  margin-top: 16rpx;
}

.fa-reply-textarea {
  width: 100%;
  min-height: 120rpx;
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 25rpx;
  color: #333333;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.fa-reply-submit-btn {
  width: 100%;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: #FFFFFF;
  background: linear-gradient(135deg, #B8860B 0%, #DAA520 100%);
  border-radius: 32rpx;
  border: none;
}

.fa-reply-submit-btn::after {
  border: none;
}

.fa-reply-submit-btn[disabled] {
  opacity: 0.6;
}

/* 🗣️ 已回复展示区：柔和暖金背景，与待处理行动区互斥展示 */
.fa-reply-display {
  background: #FFF9E6;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin-top: 8rpx;
}

.fa-reply-display-label {
  display: block;
  font-size: 20rpx;
  color: #B8860B;
  font-weight: bold;
  margin-bottom: 6rpx;
}

/* 🏪 高级角色/新店申请队列专属：门店档案预览卡片（地址/联系电话/照片横滚），
   与 .fa-reply-display 同款柔和底色，视觉上归入"这条申请的附加信息" */
.ea-store-profile-card {
  background: #FAF7F0;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin-top: 4rpx;
  margin-bottom: 16rpx;
}

.ea-store-profile-card .fa-item-content {
  margin-bottom: 6rpx;
}

.ea-store-photo-row {
  white-space: nowrap;
  margin-top: 8rpx;
}

.ea-store-photo-thumb {
  display: inline-block;
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 12rpx;
  border: 1rpx solid #EFE6D8;
}

.fa-reply-display-text {
  display: block;
  font-size: 24rpx;
  color: #6B5B45;
  line-height: 1.6;
}

.fa-reply-display-meta {
  display: block;
  font-size: 20rpx;
  color: #B8860B;
  margin-top: 6rpx;
}

/* 💬 回复家人按钮：品牌暖橙色 Outline，与驳回/移出的红色警告色区分 */
.fa-feedback-reply-btn {
