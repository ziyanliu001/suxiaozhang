}

.my-vs-status-tag.rejected {
  color: #C92A2A;
  background: #FFF0F0;
}

.my-vs-reject-reason {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #C0392B;
  line-height: 1.6;
  background: #FFF0F0;
  border-left: 6rpx solid #E53E3E;
  padding: 12rpx 16rpx;
}

.my-vs-action-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.resubmit-btn {
  display: block;
  flex: 2;
  height: 72rpx;
  line-height: 72rpx;
  margin-top: 0;
  padding: 0;
  background: #C0392B;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 36rpx;
  border: none;
}

.resubmit-btn::after {
  border: none;
}

.resubmit-btn:active {
  opacity: 0.85;
}

.delete-submission-btn {
  display: block;
  flex: 1;
  height: 72rpx;
  line-height: 68rpx;
  margin-top: 0;
  padding: 0;
  background: #FFFFFF;
  color: #C0392B;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 36rpx;
  border: 2rpx solid #C0392B;
}

.delete-submission-btn::after {
  border: none;
}

.delete-submission-btn:active {
  opacity: 0.7;
}

.cancel-pending-btn {
  display: block;
  flex: 1;
  height: 72rpx;
  line-height: 68rpx;
  margin-top: 0;
  padding: 0;
  background: #FFFFFF;
  color: #868E96;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 36rpx;
  border: 2rpx solid #CED4DA;
}

.cancel-pending-btn::after {
  border: none;
}

.cancel-pending-btn:active {
  opacity: 0.7;
}

/* 🔒 申请冲销：已采纳入库记录对非超管的替代按钮，视觉上刻意做成灰色弱化的
   "非直接可执行"操作（与 .cancel-pending-btn 同款克制配色），点击只弹出引导
   联系店长的说明，不真正触发任何撤回/删除动作 */
.request-writeoff-btn {
  display: block;
  flex: 1;
  height: 72rpx;
  line-height: 68rpx;
  margin-top: 0;
  padding: 0;
  background: #F1F3F5;
  color: #868E96;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 36rpx;
  border: 2rpx solid #DEE2E6;
}

.request-writeoff-btn::after {
  border: none;
}

.request-writeoff-btn:active {
  opacity: 0.7;
}

/* 📊 门店餐饮与物资统计：三段 pd-health-grid 堆叠起来比其他 warm-story-modal-*
   用途（纯文案说明）更高，加个滚动容器兜底，避免小屏幕溢出弹窗卡片 */
.store-stats-modal-card {
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.store-stats-scroll {
  flex: 1;
  min-height: 0;
}

.store-stats-scroll .pd-health-title {
  margin-top: 20rpx;
}

.store-stats-scroll .pd-health-title:first-child {
  margin-top: 0;
}

.store-stats-timestamp {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: #868E96;
  margin-bottom: 20rpx;
}

.store-stats-timestamp-dot {
  color: #DEE2E6;
}

.store-stats-refresh {
  color: #2B8A3E;
}

.store-stats-empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx 0 12rpx;
}

.store-stats-empty-text {
  font-size: 26rpx;
  color: #868E96;
}

.store-stats-empty-btn {
  font-size: 26rpx;
  color: #FFFFFF;
  background: #8C1D18;
  padding: 12rpx 40rpx;
  line-height: 1.6;
  border-radius: 999rpx;
}

.store-stats-empty-btn::after {
  border: none;
}

.store-stats-footer-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #EEE;
  flex-shrink: 0;
}

.store-stats-footer-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 18rpx 0;
  border-radius: 12rpx;
}

.store-stats-footer-btn:active {
  opacity: 0.7;
}

.store-stats-footer-btn-detail {
  background: #F1F3F5;
  color: #495057;
}

.store-stats-footer-btn-supplement {
  background: #8C1D18;
  color: #FFFFFF;
}

/* ═══════════════════════════════════════════════════════════════
   🔐 套餐升级/续费半屏卡片 —— 轻奢极简重构版
   布局：mask 遮罩（毛玻璃）/ card（固定贴底）→ 黑钻身份卡 / scroll-view
   内容区（权益 + 兑换）/ footer（金色主 CTA + ghost 次按钮）
   card 自独立 position:fixed 贴底，z-index:9999，规避自定义 tabBar 遮挡
   ═══════════════════════════════════════════════════════════════ */

.subscription-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(10, 12, 18, 0.55);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 9998;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.28s ease;
}
.subscription-modal-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.subscription-modal-card {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  z-index: 9999;
  width: 100%;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  background: #F7F8FA;
  border-top-left-radius: 36rpx;
  border-top-right-radius: 36rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.34, 1.1, 0.64, 1);
}
.subscription-modal-mask.show .subscription-modal-card {
  transform: translateY(0);
}

/* 关闭按钮行 */
.sub-close-row {
  flex-shrink: 0;
  display: flex;
  justify-content: flex-end;
  padding: 20rpx 28rpx 0;
}
.sub-close-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(0,0,0,0.06);
  color: #6B7280;
  font-size: 28rpx;
}
.sub-close-btn:active { background: rgba(0,0,0,0.12); }

/* 加载骨架 */
.subscription-loading {
  padding: 80rpx 32rpx;
  text-align: center;
  color: #ADB5BD;
  font-size: 26rpx;
  flex: 1;
}

/* ── ① 黑钻身份卡 ───────────────────────────────────────────── */
.sub-identity-card {
  flex-shrink: 0;
  margin: 8rpx 28rpx 24rpx;
  border-radius: 24rpx;
  padding: 32rpx 32rpx 28rpx;
  background: linear-gradient(135deg, #1C2530 0%, #2D3A4A 60%, #1A2035 100%);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.28);
  position: relative;
  overflow: hidden;
}
/* 装饰光晕 */
.sub-identity-card::before {
  content: '';
  position: absolute;
  top: -40rpx; right: -40rpx;
  width: 200rpx; height: 200rpx;
  border-radius: 50%;
  background: rgba(212, 175, 55, 0.08);
}
/* 专业版/旗舰版身份卡微调色调 */
.sub-identity-card-pro {
  background: linear-gradient(135deg, #20200A 0%, #2E2A0E 55%, #1C1C08 100%);
}
.sub-identity-card-enterprise {
  background: linear-gradient(135deg, #0D0D0D 0%, #1A1A1A 55%, #0A0A0A 100%);
}

.sub-identity-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.sub-store-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  flex: 1;
  margin-right: 16rpx;
}
.sub-plan-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  letter-spacing: 1rpx;
}
.sub-plan-badge-basic {
  background: rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.70);
  border: 1rpx solid rgba(255,255,255,0.18);
}
.sub-plan-badge-pro {
  background: linear-gradient(90deg, #C9941A 0%, #E8C548 100%);
  color: #1C1200;
}
.sub-plan-badge-enterprise {
  background: linear-gradient(90deg, #FFD700 0%, #FFA500 100%);
  color: #1C1200;
}

.sub-identity-bottom { }
.sub-expiry-active {
  font-size: 23rpx;
  color: rgba(255,255,255,0.62);
}
.sub-expiry-free {
  font-size: 23rpx;
  color: rgba(255,255,255,0.50);
}
.sub-expiry-warn {
  font-size: 23rpx;
  color: #FFB347;
}
.sub-expiry-expired {
  font-size: 23rpx;
  color: #FF7B72;
}

/* ── scroll-view 内容区 ──────────────────────────────────────── */
.subscription-modal-body {
  flex: 1;
  height: 0;
  min-height: 0;
  box-sizing: border-box;
  padding-bottom: 8rpx;
}

/* 通用 section 容器 */
.sub-section {
  margin: 0 28rpx 28rpx;
}
.sub-section-title {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #9CA3AF;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

/* ── ② 高级权益卡片组 ────────────────────────────────────────── */
.sub-benefit-grid {
  display: flex;
  gap: 16rpx;
}
.sub-benefit-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 14rpx 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  border: 1.5rpx solid #EDEFF2;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  opacity: 0.52;
  transition: opacity 0.2s;
}
/* 已开通态：高亮激活 */
.sub-benefit-card.sub-benefit-active {
  opacity: 1;
  border-color: #E8C548;
  background: linear-gradient(160deg, #FFFCF0 0%, #FFF8E1 100%);
