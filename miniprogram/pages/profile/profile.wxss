}

.role-switch-modal-header .close-btn {
  margin-left: auto;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F1F3F5;
  color: #6B7280;
  font-size: 32rpx;
  line-height: 1;
}

.role-switch-modal-desc {
  display: block;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #999999;
  line-height: 1.6;
  padding: 0 30rpx 20rpx;
}

/* 2. Body (单独可滚动区)：唯一允许伸缩/滚动的一段，flex: 1 + height: 0 让它
   精确吃掉 header/footer 之外的剩余空间，多出的内容自己滚动，不会把固定的
   Header/Footer 挤出卡片 */
.role-switch-modal-body {
  flex: 1;
  min-height: 0;
  max-height: 40vh;
  padding: 0 30rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  box-sizing: border-box;
}

/* 🎴 视角选项 Card：默认暖灰底，选中态施加主题金色边框 + 浅金底高亮，
   与本页 .view-mode-switch-card 的金棕配色（#B57C1E / #E6D0A0）呼应 */
