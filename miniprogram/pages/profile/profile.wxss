  background: linear-gradient(135deg, #FFF5F5 0%, #FFE3E3 100%);
  border: 2rpx solid #FFA8A8;
  border-radius: 36rpx;
  transition: transform 0.1s ease, opacity 0.1s ease, background-color 0.1s ease;
}

.fa-item-reply-btn::after {
  border: none;
}

.fa-item-reply-btn:active {
  transform: scale(0.96);
  opacity: 0.85;
  background: #FFE3E3;
}

.fa-item-reply-btn[disabled] {
  opacity: 0.5;
}

/* 🔑 人员权限管理：降级为义工 — 琥珀/警告色，区别于绿色"通过"和红色"移出" */
.fa-item-demote-btn {
