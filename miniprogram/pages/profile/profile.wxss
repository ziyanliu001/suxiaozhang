/* 核心荣誉分组：义工证书/徽章 —— 淡金底强化卡片，与普通列表项拉开视觉层级 */
.honor-cell {
  background: linear-gradient(135deg, #FFFDF5 0%, #FFF9E6 100%);
}

.honor-cell:active {
  background: #FFF3D6;
}

/* 🌟 店长专属管理入口：与 .honor-cell 同一套"淡金底强化行"语言，让店长在自己的个人页里
   一眼看到这一行明显跟普通义工看到的列表不一样——权限层级的视觉区隔，不只是多一行文字 */
.manager-only-cell {
  background: linear-gradient(135deg, #FFFDF5 0%, #FFF3E0 100%);
}

.manager-only-cell:active {
  background: #FFE9C4;
}

.manager-only-emoji {
  font-size: 32rpx;
  width: 38rpx;
  flex-shrink: 0;
  text-align: center;
}

.item-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.item-sub-hint {
  font-size: 20rpx;
  color: #B57C1E;
}

/* 关于与帮助分组内的"切换身份"行：保留列表统一样式，仅文字提示危险语义 */
.danger-cell:active {
  background: #FFF5F5;
}

.item-text.danger-text {
  color: #D32F2F;
}

/* 低权限自助入口：刻意置于列表最下方且弱化视觉，符合"高权限低频功能不抢焦点"的排版逻辑 */
.subtle-group {
  margin-bottom: 30rpx;
}

.subtle-cell {
  padding: 22rpx 32rpx;
}

.subtle-text {
  color: #999999;
  font-weight: 400;
  font-size: 24rpx;
}

.subtle-icon {
  opacity: 0.45;
}

/* 开发者与超管工具箱：独立成卡（原先依附在 .action-list-container 内，
   现已拆分为独立分组，需要补回卡片背景/边框，避免变成无背景的裸列表） */
.admin-developer-section {
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 28rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
}

.admin-divider {
  font-size: 20rpx;
  font-weight: bold;
  color: #8E8E93;
  background: #F2F2F7;
  padding: 10rpx 32rpx;
}

/* ==========================================
   🌟 核心修复：高兼容性 SVG 矢量背景图注入
   ========================================== */

.item-icon-svg {
  width: 38rpx;
  height: 38rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  flex-shrink: 0;
}

.badge-icon-svg {
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  display: inline-block;
  vertical-align: middle;
}

.header-icon-svg {
  width: 32rpx;
  height: 32rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.flip-x {
  transform: scaleX(-1);
}

/* 🌟 统一菜单图标色调为深古铜色（不使用红色），提升整体质感的同时更符合"荣誉"而非"警示"的调性 */
.icon-svg-history { background-image: url('data:image/svg+xml;base64,'); }

.icon-svg-about { background-image: url('data:image/svg+xml;base64,'); }

.icon-svg-key { background-image: url('data:image/svg+xml;base64,'); }

.icon-svg-clear { background-image: url('data:image/svg+xml;base64,'); }

/* 🐛 顺带修复：原图标末尾坐标是损坏数据 y2="1*"，已修正为合法的 21 */
.icon-svg-screen { background-image: url('data:image/svg+xml;base64,'); }

/* 🐛 顺带修复：原图标 base64 数据已损坏（含非法字节，浏览器会渲染为空白/破图），重新绘制为简洁莲花双瓣造型 */
.icon-svg-flower { background-image: url('data:image/svg+xml;base64,'); }

/* 新增：义工证书/徽章菜单项图标（奖章造型） */
.icon-svg-badge { background-image: url('data:image/svg+xml;base64,'); }

/* 新增：昵称行编辑入口图标（简洁铅笔造型） */
.icon-svg-edit { background-image: url('data:image/svg+xml;base64,'); }

.icon-svg-release { background-image: url('data:image/svg+xml;base64,'); }

/* ==========================================
   🚪 卸任特权 Warning 弹窗
   ========================================== */
.release-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.release-modal-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.release-modal-card {
  width: 82%;
  max-width: 620rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 36rpx 36rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  transform: scale(0.9) translateY(20rpx);
  opacity: 0;
  transition: all 0.25s ease;
}

.release-modal-mask.show .release-modal-card {
  transform: scale(1) translateY(0);
  opacity: 1;
}

.release-warning-icon {
  display: block;
  text-align: center;
  font-size: 72rpx;
  margin-bottom: 20rpx;
  line-height: 1;
}

.release-modal-title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
  margin-bottom: 32rpx;
  line-height: 1.5;
}

.release-role-highlight {
  color: #D32F2F;
}

.release-consequence-list {
  background: #FFF5F5;
  border: 1.5rpx solid #FFCDD2;
  border-radius: 20rpx;
  padding: 24rpx 24rpx 8rpx;
  margin-bottom: 36rpx;
}

.release-consequence-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.bullet-dot {
  font-size: 26rpx;
  color: #D32F2F;
  margin-right: 12rpx;
  line-height: 1.6;
  flex-shrink: 0;
}

.bullet-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #5C5C5C;
  line-height: 1.6;
  word-break: break-all;
}

.release-consequence-item.danger .bullet-text {
  color: #D32F2F;
  font-weight: bold;
}

.release-modal-footer {
  display: flex;
  gap: 20rpx;
}

.release-btn-cancel,
.release-btn-confirm {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 42rpx;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.release-btn-cancel::after,
.release-btn-confirm::after {
  border: none;
}

.release-btn-cancel {
  background: #F1F3F5;
  color: #495057;
}

.release-btn-cancel:active {
  transform: scale(0.96);
  background: #E9ECEF;
}

.release-btn-confirm {
  background: linear-gradient(135deg, #E53935 0%, #C62828 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(198, 40, 40, 0.35);
}

.release-btn-confirm:active {
  transform: scale(0.96);
  opacity: 0.9;
  box-shadow: 0 4rpx 10rpx rgba(198, 40, 40, 0.3);
}

/* ================= 🏅 数字荣誉墙 ================= */

.honor-wall-card {
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 28rpx;
  padding: 24rpx 28rpx 28rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 6rpx 20rpx rgba(239, 230, 216, 0.3);
}

.honor-wall-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.honor-wall-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
}

.honor-wall-cert-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: #8C1D18;
}

.honor-badge-scroll {
  width: 100%;
  white-space: nowrap;
}

.honor-badge-row {
  display: flex;
  gap: 28rpx;
  padding: 4rpx 4rpx 8rpx;
}

.honor-badge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  width: 108rpx;
  transition: transform 0.15s ease;
}

.honor-badge-item:active {
  transform: scale(0.94);
}

.honor-badge-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 已解锁：饱满金色渐变 + 微光投影，点击时整体缩放做"微光"反馈（见 .honor-badge-item:active） */
.honor-badge-item.unlocked .honor-badge-circle {
  background: linear-gradient(135deg, #F1C40F 0%, #B8860B 100%);
  box-shadow: 0 0 0 4rpx #FFF3BF, 0 6rpx 16rpx rgba(184, 134, 11, 0.45);
}

.honor-badge-item.unlocked .honor-badge-emoji {
  font-size: 44rpx;
}

.honor-badge-item.unlocked .honor-badge-name {
  color: #8C1D18;
  font-weight: bold;
}

/* 未解锁：整体置灰半透明，与已解锁形成清晰的"未达成"视觉信号 */
.honor-badge-item.locked .honor-badge-circle {
  background: #E9ECEF;
  opacity: 0.4;
}

.honor-badge-item.locked .honor-badge-emoji {
  font-size: 40rpx;
  filter: grayscale(100%);
}

.honor-badge-item.locked .honor-badge-name {
  color: #ADB5BD;
}

.honor-badge-name {
  font-size: 20rpx;
  text-align: center;
}

/* ================= 🌟 义工证书 Modal ================= */

.certificate-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.certificate-modal-card {
  width: 88%;
  max-width: 660rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 24rpx 32rpx;
  box-sizing: border-box;
}

.certificate-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.certificate-modal-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #222222;
}

.certificate-modal-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #F1F3F5;
  color: #6B7280;
  font-size: 24rpx;
}

.certificate-canvas-wrap {
  position: relative;
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  background: #F1E6C8;
  /* Canvas 用 style 里的 px 精确控制尺寸（与 drawVolunteerCertificate 的 width/height 参数一致），
     这里用等比留白让容器高度跟随，避免绘制中/绘制前出现明显的高度跳变 */
  min-height: 480rpx;
  /* 给证书卡片加一圈投影，让它从弹窗背景里"浮"出来，更有实体证书的质感 */
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
}

.certificate-canvas {
  position: absolute;
  top: 0;
  left: 0;
  /* Canvas 节点本身不需要可见——它只是绘制源，最终展示的是下面的 <image>；
     保留在文档流里但视觉上完全被 image 盖住即可，不需要额外裁剪技巧 */
}

.certificate-preview-img {
  position: relative;
  width: 100%;
  display: block;
  border-radius: 16rpx;
}

.certificate-loading-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(251, 246, 233, 0.9);
  font-size: 24rpx;
  color: #8C6D46;
}

.certificate-save-btn {
  margin-top: 40rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #B8860B 0%, #DAA520 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(184, 134, 11, 0.35);
}

.certificate-save-btn::after {
  border: none;
}

.certificate-save-btn:active {
  opacity: 0.85;
  box-shadow: 0 2rpx 6rpx rgba(184, 134, 11, 0.2);
}

.certificate-save-btn[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

/* 🏪 查看店铺状态 Modal：与 .certificate-modal-mask/.certificate-modal-card 同款
   遮罩+卡片骨架，内容更轻量（只读两行信息），复用同一套视觉语言 */
.store-status-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.store-status-modal-card {
  width: 82%;
  max-width: 560rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 24rpx 32rpx;
  box-sizing: border-box;
}

.store-status-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.store-status-modal-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #222222;
}

.store-status-modal-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #F1F3F5;
  color: #6B7280;
  font-size: 24rpx;
}

.store-status-loading-box {
  text-align: center;
  padding: 40rpx 0;
  color: #ADB5BD;
  font-size: 24rpx;
}

.store-status-info-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.store-status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.store-status-lbl {
  font-size: 26rpx;
  color: #868E96;
}

.store-status-val {
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
}

/* 与 store-profile.wxss 的 .sp-operating-badge 同一套配色，保持全局运营状态标签视觉一致 */
.store-status-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 10rpx;
  font-weight: bold;
  background: #E8F5E9;
  color: #2E7D32;
}

.store-status-badge.preparing {
  background: #FFF3E0;
  color: #D48806;
}

.store-status-badge.paused {
  background: #F1F3F5;
  color: #868E96;
}
