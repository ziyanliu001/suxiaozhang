  transition: opacity 0.15s ease;
}

.feedback-admin-item.is-handled {
  opacity: 0.6;
}

.fa-item-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.fa-item-nickname {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.fa-item-type-tag {
  font-size: 26rpx;
  color: #D9480E;
  background-color: #FFF3BF;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
  /* 🐛 修复：与右侧紧接着的 .fa-item-time 日历图标贴在一起没有呼吸感，补一点右边距 */
  margin-right: 20rpx;
}

/* 🐛 可读性修复：20rpx + #ADB5BD 浅灰在小屏幕上时间文本糊成一团难以辨认，
   调大字号并加深至清晰的墨灰色，加中等字重提升辨识度 */
.fa-item-time {
  display: block;
  font-size: 26rpx;
  color: #4A5568;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.fa-item-content {
  display: block;
  font-size: 26rpx;
  color: #495057;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

/* 🌟 核心数据加强：用餐人数（早/午/晚）与物资消耗（米/面/油/菜）是这张卡片
   最重要的信息，比备注/说明这类次要文本更需要一眼看清——只加在这两行上，
   不影响 .fa-item-content 在意见箱内容/手机号/门店档案等其他场景的展示 */
.fa-item-core-data {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A202C;
  line-height: 1.5;
}

/* 📝 备注/说明：与上面核心数据行区分开的次要信息，上下各留一点边距，
   避免紧挨着核心数据行或底部的【店长已采纳】/【待店长确认】状态标签 */
.fa-item-note {
  font-size: 26rpx;
  color: #4A5568;
  margin-top: 12rpx;
  margin-bottom: 16rpx;
}

/* 数字高亮：在核心数据行内进一步突出具体数量，让人数/斤数比周围的标签文字更醒目 */
.highlight-num {
  color: #27AE60;
  font-weight: 600;
}

/* 待处理行动区：标记为已处理 / 回复家人 并排两个按钮 */
.fa-item-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

/* 🎨 圆角微渐变 Pill 按钮：与 .fa-reply-submit-btn/.feedback-submit-btn 的实心
   品牌渐变不同——这两个是列表项内的次级操作，逐条滚动时若每条都是高饱和实心
   渐变会显得视觉噪音很重，改用同色系浅→浅的柔和微渐变，质感升级但不抢主按钮的焦点
   🐛 根因修复：原来只靠 height === line-height 让文字垂直居中——微信原生 <button>
   自带默认内边距（左右 ~30rpx）与基线度量，emoji（✅/❌）与中文混排时行高基线
   本就和纯文本不一致，两者叠加导致按钮内文字/图标肉眼可见地偏左上或偏斜。
   显式 flex 居中 + box-sizing/padding/margin 归零，彻底不依赖 line-height 这条
   脆弱的隐式规则 */
.fa-item-handle-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 1;
  font-size: 25rpx;
  font-weight: bold;
  color: #FFFFFF;
  background: linear-gradient(135deg, #40C057 0%, #2B8A3E 100%);
  border: none;
  border-radius: 36rpx;
  box-shadow: 0 4rpx 10rpx rgba(43, 138, 62, 0.3);
  transition: transform 0.1s ease, opacity 0.1s ease, box-shadow 0.1s ease;
}

.fa-item-handle-btn::after {
  border: none;
}

.fa-item-handle-btn:active {
  transform: scale(0.96);
  opacity: 0.88;
  box-shadow: none;
}

.fa-item-handle-btn[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

/* ⚠️ 驳回：浅红警告色，与"一键采纳入库"的绿色主色形成明确的语义对比——
   一个是不可逆的正向确认操作，一个是需要用户三思的否定操作 */
.fa-item-reply-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 1;
  font-size: 25rpx;
  font-weight: bold;
  color: #E03131;
  background: linear-gradient(135deg, #FFF5F5 0%, #FFE3E3 100%);
  border: 2rpx solid #FFA8A8;
  border-radius: 36rpx;
  transition: transform 0.1s ease, opacity 0.1s ease, background-color 0.1s ease;
}

.fa-item-reply-btn::after {
  border: none;
}

.fa-item-reply-btn:active {
  transform: scale(0.96);
  opacity: 0.85;
  background: #FFE3E3;
}

.fa-item-reply-btn[disabled] {
  opacity: 0.5;
}

/* 🔑 人员权限管理：降级为义工 — 琥珀/警告色，区别于绿色"通过"和红色"移出" */
.fa-item-demote-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 1;
  font-size: 25rpx;
  font-weight: bold;
  color: #7B4F00;
  background: linear-gradient(135deg, #FFF8E1 0%, #FFE082 100%);
  border: 2rpx solid #F0C36D;
  border-radius: 36rpx;
  transition: transform 0.1s ease, opacity 0.1s ease;
}

.fa-item-demote-btn::after {
  border: none;
}

.fa-item-demote-btn:active {
  transform: scale(0.96);
  opacity: 0.85;
}

.fa-item-demote-btn[disabled] {
  opacity: 0.4;
}

/* 大家长撤销权限受限提示（非超管场景） */
