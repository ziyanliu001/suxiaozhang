.mine-page-container {
  min-height: 100vh;
  background-color: #FDF6E3;
  box-sizing: border-box;
}

/* 🌟 全站统一的卡片基础层：圆角柔和阴影，与 index.wxss/journey.wxss 等页面的
   .ui-card-wrapper 同一套数值规范（WXSS 页面级作用域不跨页共享样式，这里本地
   复刻一份）。菜单列表容器（.action-list-container/.admin-developer-section）
   自己的 border-radius/padding/border 定义在本文件更靠后的位置，会按 CSS
   层叠顺序正常覆盖这里的基础值——不会把列表行自身的内边距挤成两层 */
.ui-card-wrapper {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid #F1F3F5;
  box-sizing: border-box;
}

.status-bar-spacer {
  width: 100%;
}

.nav-title-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  position: relative;
}

.page-title-txt {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
}

.quick-sheet-trigger-btn {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-sheet-trigger-btn:active {
  opacity: 0.6;
}

.quick-sheet-trigger-icon {
  font-size: 36rpx;
  font-weight: bold;
  color: #666666;
  line-height: 1;
}

.mine-content-wrapper {
  /* 底部预留三段式导航栏高度（100rpx）+ 安全区，避免最后一项被遮挡 */
  padding: 20rpx 24rpx calc(100rpx + env(safe-area-inset-bottom) + 40rpx) 24rpx;
  box-sizing: border-box;
}

.user-profile-card {
  /* 🆕 微暖发光调：极浅暖黄到白的渐变，提升个人信息卡片（含机构归属展示）的
     视觉层级与高级感，与头像金边渐变（.avatar-ring）呼应，不引入新的主色调 */
  background: linear-gradient(135deg, #FFFDF5 0%, #FFFFFF 100%);
  border-radius: 28rpx;
  padding: 36rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  border: 1rpx solid #EFE6D8;
  box-shadow: 0 6rpx 20rpx rgba(239, 230, 216, 0.3);
  /* 🆕 结构瘦身：与其余各管理卡片统一收窄为 16rpx，缩短卡片间的堆叠缝隙 */
  margin-bottom: 16rpx;
}

/* 🐛 头像"严重放大只看到局部色块"根因排查：交叉测试确认同一张照片走食谱照片的普通
   <view><image> 结构完全正常，问题限定在头像——而头像与食谱照片唯一的结构性差异，
   就是头像的 <image> 之前被嵌套在 <button open-type="chooseAvatar"> 原生组件内部。
   现改为：可见展示（.avatar-outer 及以下）搬到 .avatar-tap-wrap 这个普通 <view> 下，
   与 chooseAvatar 按钮变成兄弟节点；按钮本身降级为铺满同一区域的纯透明点击热区
   （.avatar-choose-btn-overlay），只负责触发选择事件，不再包裹/展示任何内容。
   固定 128rpx×128rpx 尺寸与热区/视觉重合的设计保持不变，仅仅是从按钮身上移到
   .avatar-tap-wrap 身上。 */
.avatar-tap-wrap {
  position: relative;
  width: 128rpx !important;
  height: 128rpx !important;
  min-width: 128rpx;
  min-height: 128rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.avatar-choose-btn-overlay {
  position: absolute !important;
  top: 0;
  left: 0;
  width: 100% !important;
  height: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
  background: transparent !important;
  border-radius: 50%;
  z-index: 2;
}

.avatar-choose-btn-overlay::after {
  border: none;
}

/* 🐛 圆形裁剪失效修复：此前头像角标是 .avatar-ring 的子元素，导致 .avatar-ring
   不敢加 overflow:hidden（加了会把角标一起裁掉），圆形裁剪只能靠最内层 .user-avatar
   单独兜底，在部分渲染环境下不够可靠。现拆成两层：.avatar-outer 只负责定位，
   .avatar-ring 专职裁剪（overflow:hidden + border-radius:50%）。角标已移除，
   保留这层拆分是因为它本身就是让圆形裁剪稳定生效的正确结构，不依赖角标是否存在。
   🛡️ 物理锁死：width/height 由 100%（相对 .avatar-tap-wrap 128rpx 解出）改为直接
   写死 128rpx，链路上不再有任何百分比宽高需要逐层解析。 */
.avatar-outer {
  width: 128rpx !important;
  height: 128rpx !important;
  position: relative;
  flex-shrink: 0;
  box-sizing: border-box;
}

/* 🌟 渐变金边头像环：padding-box 撑开渐变描边，内层裁切绝对正圆，
   彻底杜绝头像变形/背景裁切异常，同时提升整体质感。
   🛡️ 物理锁死：同上，改百分比为写死 128rpx；4rpx padding + box-sizing:border-box
   解出的内容区正好是 120rpx，与 .user-avatar 的固定尺寸严丝合缝，不依赖任何
   百分比换算。 */
.avatar-ring {
  width: 128rpx !important;
  height: 128rpx !important;
  border-radius: 50% !important;
  overflow: hidden !important;
  padding: 4rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #F1C40F 0%, #E8B923 45%, #EFE6D8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-avatar {
  /* 🐛 回退为显式 rpx 定值：<image mode="aspectFill"> 配合百分比宽高在 flex 容器
     （.avatar-ring 是 align-items:center，不会拉伸子项撑满）里计算裁剪区域时不够可靠，
     曾观察到按图片自身原始像素尺寸而非容器尺寸取景、出现"放大只看到中间"的现象。
     父级 .avatar-ring 内容区本就是固定 120rpx×120rpx，这里直接写死定值更稳妥。
     🛡️ 这条 !important 规则本身从一开始就是对的——真正的问题是 WXML 里 <image>
     标签自己的行内 style 曾用 width:100% !important 把这条规则盖掉了，已在
     profile.wxml 里移除那处行内覆盖，现在这条规则能不受干扰地直接生效。 */
  width: 120rpx !important;
  height: 120rpx !important;
  border-radius: 50% !important;
  display: block;
  overflow: hidden !important;
  box-sizing: border-box;
  background: #F1EFEA;
  /* 🛡️ 与 mode="aspectFill" 是同一语义的双保险：object-fit 在部分基础库/渲染路径下
     对 <image> 生效更可靠，两者一起兜底，不冲突 */
  object-fit: cover !important;
}

.user-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  background: #F1EFEA;
}

.user-meta-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.nickname-edit-row {
  display: flex;
  align-items: center;
  overflow: hidden;
}

/* 🐛 彻底修复昵称与编辑图标重叠：裁切边界交给这层普通 <view>（flex:1 抢占剩余空间，
   min-width:0 允许在 flex 容器里正常收缩，overflow:hidden 做硬裁切），
   不再依赖原生 <input> 自身的 text-overflow——那个在部分机型上不可靠。 */
.nickname-input-wrap {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

/* 昵称输入框：视觉上仍表现为普通文字，聚焦编辑时才显现输入态；
   width:100% 撑满外层 wrap 分配到的空间，真正的裁切由外层 wrap 的 overflow:hidden 保证，
   这里的 white-space/text-overflow 仅作为该组件支持时的锦上添花，不是唯一防线 */
.user-nickname-input {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-sizing: border-box;
}

.edit-profile-icon-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 6rpx;
}

.edit-profile-icon-btn:active {
  opacity: 0.6;
}

/* 🆕 身份 Banner 容器：默认无样式（其余角色沿用原本紧凑展示），
   .identity-banner-patriarch 修饰类才套用高质感暖金渐变条带 */
.identity-banner {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.identity-banner-patriarch {
  background: linear-gradient(135deg, #FFF9E6 0%, #FFF3D6 60%, #FFEAC2 100%);
  border: 1rpx solid #F0D28A;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  margin-top: 6rpx;
  box-shadow: 0 4rpx 14rpx rgba(181, 124, 30, 0.14);
}

.role-badge-row {
  display: flex;
}

.badge-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 20rpx;
  font-weight: bold;
  color: #8C1D18;
  background: #FFF0ED;
  border: 1rpx solid #FFCDD2;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.badge-tag.super_admin {
  background: #FFF9E6;
  color: #B57C1E;
  border-color: #FFE082;
}

.badge-tag.store_manager {
  background: #FFF3E0;
  color: #E65100;
  border-color: #FFCC80;
}

.badge-tag.finance {
  background: #E8F5E9;
  color: #2E7D32;
  border-color: #A5D6A7;
}

/* 🏛️ 雨花家长：加粗为真正的暖金渐变实底徽章（不再是浅底细边框），
   与超管/店长/财务的浅色胶囊拉开分量差，凸显"大家长"这一专属身份的分量 */
.badge-tag.store_patriarch {
  background: linear-gradient(135deg, #F0C36A 0%, #D9A441 100%);
  color: #6B3E00;
  border-color: #C88F2E;
  box-shadow: 0 3rpx 10rpx rgba(191, 140, 40, 0.35);
}

/* 🌟 提升荣誉感：淡金色底 + 深棕色文字，志工身份也拥有仪式感的专属配色 */
.badge-tag.volunteer {
  background: #F9E79F;
  color: #784212;
  border-color: #F1C40F;
}

/* ❤️ 家人（服务对象）：暖红系配色，与志工的金色系明确区分开 */
.badge-tag.family {
  background: #FFF0ED;
  color: #C0392B;
  border-color: #FFCDD2;
}

/* 🆕 归属机构/平台标签：与角色胶囊分离展示，回答"我在哪个机构"而不是"我是什么角色"。
   🐛 长机构名不截断：此前 .store-name 强制单行 + ellipsis，"嵩屿街道敬老中心助餐点"
   这类较长的门店全称会被裁成"嵩屿街道敬老…"看不全——改为允许整行 flex-wrap，
   文字撑不下时自然换到第二行，而不是丢字 */
.belong-store-tag {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  row-gap: 4rpx;
  gap: 6rpx;
  min-width: 0;
}

.belong-store-tag .store-icon {
  font-size: 22rpx;
  line-height: 1;
  flex-shrink: 0;
}

.belong-store-tag .store-label {
  font-size: 24rpx;
  color: #ADB5BD;
  flex-shrink: 0;
}

.belong-store-tag .store-name {
  font-size: 24rpx;
  color: #868E96;
  font-weight: 500;
  white-space: normal;
  word-break: break-all;
  min-width: 0;
}

/* 🆕 机构类型徽标：略微加粗字重 + 字距，强化"这是一个经过归类的正式机构属性"
   的权威感，与 .badge-tag 角色胶囊的视觉语言呼应但配色区分（暖金色系） */
.belong-store-tag .org-type-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #B57C1E;
  background: #FFF9E6;
  border: 1rpx solid #FFE082;
  border-radius: 18rpx;
  padding: 2rpx 16rpx;
  line-height: 1.6;
  box-shadow: 0 2rpx 6rpx rgba(181, 124, 30, 0.12);
}

/* 🌐 超管专属：当前巡检门店指示器，点击唤起【门店选择与搜索】弹窗。
   与 .belong-store-tag 视觉呼应但用胶囊底色区分"这是一个可点击的切换入口" */
.sa-store-indicator {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 4rpx;
  padding: 8rpx 18rpx;
  background: #FFF9E6;
  border: 1rpx solid #FFE082;
  border-radius: 100rpx;
  align-self: flex-start;
}

.sa-store-indicator-icon {
  font-size: 20rpx;
  line-height: 1;
}

.sa-store-indicator-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #B57C1E;
}

.sa-store-indicator-arrow {
  font-size: 20rpx;
  color: #D9A441;
  margin-left: 2rpx;
}

/* 🐛 合并重构：原 .sa-inspect-bar（巡检门店）+ .sa-impersonation-bar（模拟视角）
   两条几乎同款配色/结构的顶部黄色提示条，合并为一条 .sa-status-bar——按当前
   实际激活的临时视角组合展示文案，避免两者同时激活时堆成两个提示框 */
.sa-status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: linear-gradient(135deg, #fff7e6 0%, #fff1d6 100%);
  border: 1rpx solid #f5c26b;
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(217, 155, 33, 0.12);
}

.sa-status-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}

.sa-status-icon {
  font-size: 30rpx;
  flex-shrink: 0;
}

.sa-status-text-col {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.sa-status-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #8a5a00;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sa-status-restore-btn {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
  background: #d99b21;
  padding: 12rpx 22rpx;
  border-radius: 100rpx;
  white-space: nowrap;
}

.sa-status-restore-btn:active {
  opacity: 0.85;
}

/* 📸 雨花温情图册与阳光凭证入口：从首页迁移至个人中心，与页面其余白底卡片
   同一套圆角+阴影语言，图标/标题/副标题/箭头四段式列表入口 */
.photo-archive-mine-entry {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.pame-icon-wrap {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FFF5F0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.pame-icon {
  font-size: 36rpx;
}

.pame-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.pame-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #222222;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pame-subtitle {
  font-size: 24rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pame-arrow {
  flex-shrink: 0;
  font-size: 32rpx;
  color: #C1C7CD;
  margin-left: 12rpx;
}

/* ❤️ 家人（服务对象）极简关怀版面：与 merit-board-card 同款卡片骨架，
   暖红色系与志工的金色系区分开，突出"关怀"而非"荣誉" */
.family-care-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(155deg, #FFF8F7 0%, #FFFFFF 55%);
  border: 1rpx solid #FFE0DB;
  border-radius: 28rpx;
  padding: 32rpx 20rpx 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 224, 219, 0.3);
  margin-bottom: 16rpx;
}

.family-care-card .header-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #C0392B;
  letter-spacing: 2rpx;
}

.family-care-hint {
  position: relative;
  z-index: 1;
  display: block;
  font-size: 24rpx;
  color: #8C4A42;
  line-height: 1.6;
  text-align: center;
  margin-bottom: 24rpx;
  padding: 0 12rpx;
}

/* 🛡️ 视觉统一：此前是半透明白 rgba(255,255,255,0.6)，会透出 .family-care-card 自身
   的暖粉渐变背景，列表看起来泛淡黄/奶咖色。改为纯不透明白，与义工版本"日常记录"
   列表（.action-list-container 默认就是纯白）保持一致 */
.family-care-list {
  position: relative;
  z-index: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
}

/* 卡片内嵌的"日常记录"小标题：与 .list-group-label 同一套弱化语义分组样式，
   只是紧跟在关怀语之后，顶部留白收窄一些，避免和上面的 hint 文字挤在一起 */
.family-care-list-label {
  margin-top: 0;
}

/* ─── 👑 超级管理员·全网指挥中心卡片 ───────────────────────────────── */
/* 🆕 卡片瘦身：margin-bottom 统一收窄为 16rpx，与下方合并后的 .admin-dashboard-card
   （原三张 .sa-light-card）保持一致的堆叠节奏，缓解拥挤感，不改变信息密度本身 */
.sa-command-card {
  background: linear-gradient(150deg, #0f2744 0%, #1e3a5f 60%, #0c3060 100%);
  border-radius: 28rpx;
  padding: 0 0 6rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(15, 39, 68, 0.28);
}

.sa-command-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.10);
  margin-bottom: 4rpx;
}

.sa-command-badge-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.sa-command-crown {
  font-size: 40rpx;
  line-height: 1;
}

.sa-command-title-col {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.sa-command-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #e2c97e;
  letter-spacing: 1rpx;
}

.sa-command-sub {
  font-size: 20rpx;
  color: rgba(226, 232, 240, 0.60);
  letter-spacing: 0.5rpx;
}

.sa-command-store-tag {
  background: rgba(255, 255, 255, 0.10);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 100rpx;
  padding: 6rpx 18rpx;
}

.sa-command-store-name {
  font-size: 20rpx;
  color: rgba(226, 232, 240, 0.75);
}

/* 操作行 */
.sa-action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 28rpx;
  gap: 12rpx;
}

.sa-action-row:active {
