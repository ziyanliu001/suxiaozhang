page {
  background-color: #F8F9FA;
  height: 100vh;
}

.help-page-container {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.help-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  background-color: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  height: 88rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #212529;
  flex-shrink: 0;
}

.nav-back-hover {
  opacity: 0.5;
}

.nav-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
  text-align: center;
  flex: 1;
}

.nav-placeholder {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.help-tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 90;
  display: flex;
  background: #FFFFFF;
  padding: 12rpx 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #495057;
  padding: 16rpx 0;
  border-bottom: 4rpx solid transparent;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.tab-item.active {
  color: #D9480E;
  font-weight: bold;
  border-bottom-color: #D9480E;
}

.help-content-scroll {
  flex: 1;
  min-height: 0;
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: calc(60rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.section-hero {
  background: linear-gradient(135deg, #FFF3BF 0%, #FFE066 100%);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #D9480E;
  display: block;
}

.hero-sub {
  font-size: 22rpx;
  color: #F59F00;
  margin-top: 6rpx;
  display: block;
}

.step-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.step-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.step-tag {
  background: #D9480E;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: bold;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.step-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
}

.step-body {
  font-size: 25rpx;
  color: #495057;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

.highlight {
  color: #D9480E;
  font-weight: bold;
}

/* 任务C：跳转首页打卡按钮 */
.btn-goto-checkin {
  margin-top: 16rpx;
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  background: linear-gradient(135deg, #F5A623 0%, #E65100 100%);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 38rpx;
  padding: 0;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(245, 166, 35, 0.35);
}

.btn-goto-checkin::after {
  border: none;
}

.btn-goto-checkin:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.faq-item {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.faq-q {
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.faq-a {
  font-size: 25rpx;
  color: #495057;
  line-height: 1.6;
  background: #F8F9FA;
  padding: 16rpx;
  border-radius: 12rpx;
  word-break: break-all;
  white-space: pre-wrap;
}

.help-footer {
  text-align: center;
  padding: 40rpx 0 20rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #868E96;
}
