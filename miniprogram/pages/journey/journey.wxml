<view class="journey-page">
  <navigation-bar
    title="暖心历程"
    back="{{true}}"
    showHomeButton="auto"
    bind:back="onGoBack"
    bind:home="onGoBack"
    bind:layout="onNavLayout"
  />

  <scroll-view scroll-y class="journey-scroll" style="padding-top: {{navBarTotalHeight}}px;">
    <!-- 顶部统计卡片：.ui-card-wrapper 是全站统一的圆角柔和阴影基础层（本页在
         journey.wxss 本地复刻同款数值，WXSS 页面级作用域不跨页共享样式），
         叠加各卡片自己的渐变/边框作为差异化装饰 -->
    <view class="ui-card-wrapper journey-header-card">
      <view class="journey-title-row">
        <view class="title-icon lotus-icon"></view>
        <text class="journey-title">{{pageTitle}}</text>
      </view>
      <view class="journey-subtitle">{{pageSubtitle}}</view>

      <view class="summary-stats">
        <view class="summary-cell">
          <text class="summary-num">{{totalDays}}</text>
          <text class="summary-label">{{dayLabel}}</text>
        </view>
        <view class="summary-cell">
          <text class="summary-num">{{totalCount}}</text>
          <text class="summary-label">累计打卡</text>
        </view>
        <view class="summary-cell">
          <text class="summary-num">{{totalHours}}</text>
          <text class="summary-label">{{hoursLabel}}</text>
        </view>
        <view class="summary-cell">
          <text class="summary-num">{{totalMeals}}</text>
          <text class="summary-label">{{mealsLabel}}</text>
        </view>
      </view>

      <button class="btn-gen-honor-card" bindtap="onGenerateHonorCard" loading="{{isGeneratingHonorCard}}" disabled="{{isGeneratingHonorCard}}">🎖️ 生成我的爱心荣誉卡</button>
    </view>

    <!-- 📍 多站点足迹汇总：仅在志愿者参与了 2 个及以上门店时展示，单站点不冗余显示 -->
    <view class="ui-card-wrapper store-stats-card" wx:if="{{storeStats.length > 1}}">
      <view class="card-header">
        <view class="card-header-left">
          <view class="header-icon map-icon"></view>
          <text class="card-title">多站点爱心足迹</text>
        </view>
        <text class="store-stats-badge">{{storeStats.length}} 个站点</text>
      </view>
      <view class="store-stats-list">
        <view class="store-stats-row" wx:for="{{storeStats}}" wx:key="storeName">
          <view class="store-stats-name-col">
            <text class="store-stats-dot">●</text>
            <text class="store-stats-name">{{item.storeName}}</text>
          </view>
          <view class="store-stats-nums">
            <view class="store-stats-cell">
              <text class="store-stats-num">{{item.days}}</text>
              <text class="store-stats-unit">天</text>
            </view>
            <view class="store-stats-cell">
              <text class="store-stats-num">{{item.hours}}</text>
              <text class="store-stats-unit">h</text>
            </view>
            <view class="store-stats-cell">
              <text class="store-stats-num">{{item.count}}</text>
              <text class="store-stats-unit">次</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 🔒 全国纵览：数据硬卡口——只有 isSuperAdmin === true 才渲染这张卡片，
         非管理员从 wxml 层面直接看不到入口，彻底防范越权查看全局数据 -->
    <view class="ui-card-wrapper national-overview-card" wx:if="{{isSuperAdmin}}">
      <view class="card-header">
        <view class="card-header-left">
          <view class="header-icon globe-icon"></view>
          <text class="card-title national-title">全国纵览</text>
        </view>
        <text class="national-badge">超管专属</text>
      </view>

      <view class="national-loading" wx:if="{{isLoadingNationalSummary}}">
        <view class="national-loading-spinner"></view>
        <text>正在汇总全国数据...</text>
      </view>

      <view class="national-grid" wx:else>
        <view class="national-cell">
          <text class="national-num">{{nationalSummary.totalVolunteers}}</text>
          <text class="national-label">义工总数</text>
        </view>
        <view class="national-cell">
          <text class="national-num">{{nationalSummary.totalServiceHours}}</text>
          <text class="national-label">总服务工时</text>
        </view>
        <view class="national-cell">
          <text class="national-num">{{nationalSummary.totalActiveStores}}</text>
          <text class="national-label">活跃门店</text>
        </view>
        <view class="national-cell">
          <text class="national-num">{{nationalSummary.totalServiceDays}}</text>
          <text class="national-label">总服务天数</text>
        </view>
        <view class="national-cell">
          <text class="national-num">{{nationalSummary.totalDiningCount}}</text>
          <text class="national-label">累计供餐人次</text>
        </view>
        <view class="national-cell">
          <text class="national-num">{{nationalSummary.totalReportCount}}</text>
          <text class="national-label">餐报总数</text>
        </view>
      </view>
    </view>

    <!-- 🎖️ 勋章墙：3 列 Grid，未解锁项高斯模糊 + 锁定态，点击任意一枚查看解锁条件 -->
    <view class="ui-card-wrapper badge-wall-card" wx:if="{{badgeList.length > 0}}">
      <view class="card-header">
        <view class="card-header-left">
          <view class="header-icon medal-icon"></view>
          <text class="card-title">勋章墙</text>
        </view>
        <text class="badge-progress-tip">{{badgeList.length}} 枚成就等你解锁</text>
      </view>

      <view class="badge-grid">
        <view
          class="badge-cell {{item.unlocked ? 'unlocked' : 'locked'}}"
          wx:for="{{badgeList}}"
          wx:key="id"
          bindtap="onTapBadge"
          data-id="{{item.id}}"
          hover-class="badge-cell-hover"
        >
          <view class="badge-circle">
            <text class="badge-emoji">{{item.emoji}}</text>
          </view>
          <view class="badge-lock-overlay" wx:if="{{!item.unlocked}}">
            <text class="badge-lock-icon">🔒</text>
          </view>
          <text class="badge-name">{{item.name}}</text>
          <text class="badge-percent" wx:if="{{!item.unlocked}}">{{item.progressPercent}}%</text>
        </view>
      </view>
    </view>

    <!-- 暖心热力图 -->
    <view class="ui-card-wrapper heatmap-card">
      <view class="card-header">
        <view class="card-header-left">
          <view class="header-icon flame-icon"></view>
          <text class="card-title">{{heatmapTitle}}</text>
        </view>
        <view class="heat-legend">
          <text class="legend-label">少</text>
          <view class="legend-dot level-1"></view>
          <view class="legend-dot level-2"></view>
          <view class="legend-dot level-3"></view>
          <view class="legend-dot level-4"></view>
          <text class="legend-label">多</text>
        </view>
      </view>

      <view class="heatmap-grid">
        <block wx:for="{{heatmapCells}}" wx:key="date">
          <view class="heat-cell {{item.count > 0 ? 'active' : ''}} level-{{item.hours > 0 ? (item.hours >= maxHeatHours * 0.75 ? 4 : (item.hours >= maxHeatHours * 0.5 ? 3 : (item.hours >= maxHeatHours * 0.25 ? 2 : 1))) : 0}}"
                bindtap="noop"
                data-date="{{item.date}}"
                data-hours="{{item.hours}}">
            <view class="cell-icon"></view>
            <text class="cell-date">{{item.dayLabel}}</text>
          </view>
        </block>
      </view>

      <view class="heatmap-tip">
        <view class="tip-icon bulb-icon"></view>
        <text class="tip-text">{{heatmapTip}}</text>
      </view>
    </view>

    <!-- 时间轴 -->
    <view class="ui-card-wrapper timeline-card">
      <view class="card-header">
        <view class="card-header-left">
          <view class="header-icon scroll-icon"></view>
          <text class="card-title">服务时间轴</text>
        </view>
        <view class="btn-toggle-all" bindtap="onToggleAll">
          <text class="toggle-text">{{allExpanded ? '全部收起' : '全部展开'}}</text>
          <text class="toggle-arrow {{allExpanded ? 'rotate' : ''}}">▾</text>
        </view>
      </view>

      <view class="timeline-empty" wx:if="{{timelineGroups.length === 0}}">
        <view class="empty-day-badge">Day 1</view>
        <view class="empty-icon flower-icon"></view>
        <text class="empty-title">{{emptyStateTitle}}</text>
        <text class="empty-desc">{{emptyStateDesc}}</text>
        <view class="empty-cta-btn" bindtap="onGoCheckIn">
          <text class="empty-cta-text">去首页打卡</text>
        </view>
      </view>

      <view class="timeline-groups" wx:else>
        <block wx:for="{{timelineGroups}}" wx:key="monthKey">
          <view class="timeline-group">
            <view class="group-header" bindtap="onToggleGroup" data-month-key="{{item.monthKey}}">
              <view class="group-dot"></view>
              <text class="group-title">{{item.monthLabel}}</text>
              <text class="group-count">共 {{item.logs.length}} 次</text>
              <text class="group-arrow {{item.expanded ? 'rotate' : ''}}">▾</text>
            </view>

            <view class="group-items {{item.expanded ? 'expanded' : 'collapsed'}}">
              <block wx:for="{{item.logs}}" wx:for-item="log" wx:key="timestamp">
                <view class="timeline-item" style="animation-delay: {{index * 60}}ms;">
                  <view class="item-left">
                    <view class="service-icon icon-{{log.serviceType || 'other'}}"></view>
                    <view class="item-line"></view>
                  </view>
                  <view class="item-body">
                    <view class="item-title-row">
                      <text class="item-shift">{{log.storeName ? log.storeName + ' · ' : ''}}{{log.shiftName || '志愿服务'}}</text>
                      <text class="item-hours">+{{log.hours}}h</text>
                    </view>
                    <view class="item-meta">
                      <text class="item-date">{{log.date}} {{log.time}}</text>
                    </view>
                  </view>
                </view>
              </block>
            </view>
          </view>
        </block>
      </view>
    </view>
    <view class="fa-safe-area-spacer"></view>
  </scroll-view>

  <canvas type="2d" id="posterCanvas" style="position: fixed; left: -9999px; top: 0; width: 375px; height: 600px;"></canvas>

  <!-- 🎖️ 爱心荣誉卡预览弹窗 -->
  <view class="honor-modal-mask" wx:if="{{showHonorModal}}" bindtap="onCloseHonorModal">
    <view class="honor-modal-box" catchtap="stopPropagation">
      <view class="honor-modal-header">
        <text class="honor-modal-title">我的爱心荣誉卡</text>
        <view class="honor-modal-close" bindtap="onCloseHonorModal">
          <text class="close-x-text">✕</text>
        </view>
      </view>

      <scroll-view scroll-y class="honor-card-scroll">
        <view class="honor-loading" wx:if="{{isGeneratingHonorCard}}">
          <view class="honor-loading-spinner"></view>
          <text class="honor-loading-text">正在为您生成荣誉卡...</text>
        </view>
        <image
          wx:else
          class="honor-card-image"
          src="{{honorCardImage}}"
          mode="widthFix"
          show-menu-by-longpress="{{true}}"
        />
        <view class="fa-safe-area-spacer"></view>
      </scroll-view>

      <text class="honor-modal-hint">💡 保存图片后可发送至朋友圈或微信群</text>

      <button
        class="honor-btn-save"
        bindtap="onSaveHonorCard"
        loading="{{isSavingHonorCard}}"
        disabled="{{isGeneratingHonorCard || isSavingHonorCard || !honorCardImage}}"
      >
        {{isSavingHonorCard ? '保存中...' : '💾 保存到相册'}}
      </button>
    </view>
  </view>

  <!-- 🎖️ 勋章详情弹窗：点击勋章墙任一枚，查看名称/寓意/解锁条件与进度 -->
  <view class="badge-modal-mask" wx:if="{{showBadgeDetailModal}}" bindtap="onCloseBadgeModal">
    <view class="badge-modal-box" catchtap="stopPropagation">
      <view class="badge-detail-circle {{selectedBadge.unlocked ? 'unlocked' : 'locked'}}">
        <text class="badge-detail-emoji">{{selectedBadge.emoji}}</text>
      </view>
      <text class="badge-detail-name">{{selectedBadge.name}}</text>
      <text class="badge-detail-status unlocked" wx:if="{{selectedBadge.unlocked}}">✅ 已解锁</text>
      <text class="badge-detail-status" wx:else>🔒 未解锁（{{selectedBadge.progressPercent}}%）</text>

      <text class="badge-detail-meaning">{{selectedBadge.meaning}}</text>
      <text class="badge-detail-desc">{{selectedBadge.unlockDesc}}</text>

      <view class="badge-detail-progress-track">
        <view class="badge-detail-progress-fill" style="width: {{selectedBadge.progressPercent}}%;"></view>
      </view>
      <text class="badge-detail-progress-text">{{selectedBadge.progressStatusText}}</text>

      <view class="badge-modal-close-btn" bindtap="onCloseBadgeModal">
        <text>关闭</text>
      </view>
    </view>
  </view>
</view>
