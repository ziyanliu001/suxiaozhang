<view class="sp-page">
  <view class="sp-nav-bar" style="padding-top: {{navTop}}px;">
    <view class="sp-nav-back" hover-class="sp-nav-back-hover" bindtap="goBack">←</view>
    <text class="sp-nav-title">🏠 门店档案</text>
  </view>

  <scroll-view scroll-y class="sp-scroll" style="margin-top: {{contentTop}}px;">

    <view class="sp-store-card">
      <view class="sp-store-name-row">
        <text class="sp-store-name">{{currentStoreName || '未命名门店'}}</text>
        <text class="sp-operating-badge {{operatingStatus}}">{{operatingStatusLabel}}</text>
        <!-- ✏️ 修改档案：与下方"门店档案信息"标题栏里的编辑入口共用同一个 onEditProfile，
             这里只是在店名旁再放一个更显眼的快捷入口 -->
        <text class="sp-btn-edit-archive" wx:if="{{canManage && !editing}}" bindtap="onEditProfile">✏️ 修改档案</text>
      </view>
      <text class="sp-store-address" wx:if="{{address}}">📍 {{address}}</text>
    </view>

    <!-- 📊 门店动态健康看板：4 格矩形健康度指标，数据来自 fetchHealthDashboard()
         （manageVolunteerSubmission statsSummary，与首页"今日餐况"同一数据源） -->
    <view class="sp-health-grid">
      <view class="sp-health-tile">
        <text class="sp-health-lbl">🍽️ 今日开餐</text>
        <text class="sp-health-val {{todayMealStatusClass}}">{{todayMealStatusLabel}}</text>
      </view>
      <view class="sp-health-tile">
        <text class="sp-health-lbl">🌾 物资健康度</text>
        <text class="sp-health-val {{materialHealthClass}}">{{materialHealthLabel}}</text>
      </view>
      <view class="sp-health-tile">
        <text class="sp-health-lbl">🙋 今日护持</text>
        <text class="sp-health-val neutral">{{todayVolunteerCount}} 人</text>
      </view>
      <view class="sp-health-tile">
        <text class="sp-health-lbl">🍚 今日服务</text>
        <text class="sp-health-val neutral">{{todayDiningCount}} 人次</text>
      </view>
    </view>

    <!-- 🏛️ 家长风控锁：本店已绑定家长/督导时，店长发起的门店档案变更需先经确认才生效 -->
    <view class="sp-pending-banner" wx:if="{{pendingProfileUpdate}}">
      <text class="sp-pending-icon">⏳</text>
      <text class="sp-pending-text">有一份门店档案更新正在等待家长/超管审批，当前展示的仍是生效中的数据</text>
    </view>

    <!-- 🏛️ 门店档案信息：详细地址/开业日期/民政登记名称/发起背景/家园特色 + 省市/运营状态/位置
         🛡️ 编辑入口改为卡片标题栏内的行内按钮，与下方"门店人员与服务人群画像"完全同款结构
         （sp-profile-title-row + sp-btn-edit-profile-count，样式通用，非"画像"专属）——
         此前放在顶部导航栏的"编辑"文字反复出现不渲染/被遮挡的问题，根治方案是不再依赖
         导航栏这套单独的定位/层级逻辑，统一复用已验证稳定可见的卡片标题按钮模式 -->
    <view class="sp-section-title sp-profile-title-row">
      <text class="sp-section-icon">📖</text>
      <text class="sp-section-txt">门店档案信息</text>
      <text class="sp-btn-edit-profile-count" wx:if="{{canManage && !editing}}" bindtap="onEditProfile">✏️ 修改</text>
    </view>

    <view class="sp-archive-card" wx:if="{{!editing}}">
      <view class="sp-archive-row">
        <text class="sp-archive-lbl">联系电话</text>
        <view class="sp-archive-val-with-action">
          <text class="sp-archive-val">{{contactPhone || '未填写'}}</text>
          <text class="sp-btn-quick-action" wx:if="{{contactPhone}}" catchtap="onCallPhone">📞 一键拨打</text>
        </view>
      </view>
      <view class="sp-archive-row">
        <text class="sp-archive-lbl">开业日期</text>
        <text class="sp-archive-val">{{openDate || '未填写'}}</text>
      </view>
      <view class="sp-archive-row">
        <text class="sp-archive-lbl">民政登记名称</text>
        <text class="sp-archive-val">{{registeredName || '未填写'}}</text>
      </view>
      <view class="sp-archive-row">
        <text class="sp-archive-lbl">所在省市</text>
        <text class="sp-archive-val">{{province || city ? (province + ' ' + city) : '未填写'}}</text>
      </view>
      <view class="sp-archive-row">
        <text class="sp-archive-lbl">详细地址</text>
        <view class="sp-archive-val-with-action">
          <text class="sp-archive-val">{{address || '未填写'}}</text>
          <text class="sp-btn-quick-action" wx:if="{{address}}" catchtap="onOpenNavigation">📍 一键导航</text>
        </view>
      </view>
      <view class="sp-archive-row vertical" wx:if="{{background}}">
        <text class="sp-archive-lbl">发起背景</text>
        <text class="sp-archive-val-block">{{background}}</text>
      </view>
      <view class="sp-archive-row vertical" wx:if="{{characteristics}}">
        <text class="sp-archive-lbl">家园特色</text>
        <text class="sp-archive-val-block">{{characteristics}}</text>
      </view>
      <view class="sp-archive-row vertical" wx:if="{{storePhotos.length > 0}}">
        <text class="sp-archive-lbl">门店照片</text>
        <view class="sp-photo-grid">
          <image class="sp-photo-thumb" wx:for="{{storePhotos}}" wx:key="*this" src="{{item}}" mode="aspectFill" bindtap="onPreviewProfilePhoto" data-url="{{item}}" data-urls="{{storePhotos}}" />
        </view>
      </view>
    </view>

    <!-- 🏅 门店资质与实景公示：门头照 / 民政备案复印件 / 食品安全承诺。卡片本身对所有角色
         （义工/财务/家属/店长等）常驻可见，与是否已上传照片、是否有管理权限无关——只有
         右上角【✏️ 修改】按钮与"暂未上传"占位的可点击态才受 canManage 约束。已上传的图片
         点击大图预览 (onPreviewProfilePhoto) 对所有角色开放 -->
    <view class="sp-section-title sp-profile-title-row" wx:if="{{!editing}}">
      <text class="sp-section-icon">🏅</text>
      <text class="sp-section-txt">门店资质与实景公示</text>
      <text class="sp-btn-edit-profile-count" wx:if="{{canManage}}" bindtap="onOpenQualificationModal">✏️ 修改</text>
    </view>

    <view class="sp-archive-card" wx:if="{{!editing}}">
      <view class="sp-archive-row vertical">
        <text class="sp-archive-lbl">门头照</text>
        <view class="sp-photo-grid" wx:if="{{storefrontPhotos.length > 0}}">
          <image class="sp-photo-thumb" wx:for="{{storefrontPhotos}}" wx:key="*this" src="{{item}}" mode="aspectFill" bindtap="onPreviewProfilePhoto" data-url="{{item}}" data-urls="{{storefrontPhotos}}" />
        </view>
        <text class="sp-archive-empty-hint clickable" wx:elif="{{canManage}}" bindtap="onOpenQualificationModal">暂未上传，点击上传</text>
        <text class="sp-archive-empty-hint" wx:else>暂未上传</text>
      </view>
      <view class="sp-archive-row vertical">
        <text class="sp-archive-lbl">民政备案复印件</text>
        <view class="sp-photo-grid" wx:if="{{civilAffairsPhotos.length > 0}}">
          <image class="sp-photo-thumb" wx:for="{{civilAffairsPhotos}}" wx:key="*this" src="{{item}}" mode="aspectFill" bindtap="onPreviewProfilePhoto" data-url="{{item}}" data-urls="{{civilAffairsPhotos}}" />
        </view>
        <text class="sp-archive-empty-hint clickable" wx:elif="{{canManage}}" bindtap="onOpenQualificationModal">暂未上传，点击上传</text>
        <text class="sp-archive-empty-hint" wx:else>暂未上传</text>
      </view>
      <view class="sp-archive-row vertical">
        <text class="sp-archive-lbl">食品安全承诺</text>
        <view class="sp-photo-grid" wx:if="{{foodSafetyPledgePhotos.length > 0}}">
          <image class="sp-photo-thumb" wx:for="{{foodSafetyPledgePhotos}}" wx:key="*this" src="{{item}}" mode="aspectFill" bindtap="onPreviewProfilePhoto" data-url="{{item}}" data-urls="{{foodSafetyPledgePhotos}}" />
        </view>
        <text class="sp-archive-empty-hint clickable" wx:elif="{{canManage}}" bindtap="onOpenQualificationModal">暂未上传，点击上传</text>
        <text class="sp-archive-empty-hint" wx:else>暂未上传</text>
      </view>
    </view>

    <view class="sp-archive-edit-card" wx:if="{{editing}}">
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">详细地址</text>
        <input class="sp-edit-input full" value="{{editForm.address}}" bindinput="onEditInput" data-field="address" placeholder="请输入门店详细地址" />
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">联系电话</text>
        <input class="sp-edit-input full" type="number" value="{{editForm.contactPhone}}" bindinput="onEditInput" data-field="contactPhone" placeholder="请输入门店联系电话" />
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">开业日期</text>
        <picker mode="date" value="{{editForm.openDate}}" bindchange="onEditOpenDateChange">
          <view class="sp-edit-input full sp-date-picker-value">{{editForm.openDate || '点击选择日期'}}</view>
        </picker>
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">民政登记名称</text>
        <input class="sp-edit-input full" value="{{editForm.registeredName}}" bindinput="onEditInput" data-field="registeredName" placeholder="请输入民政登记全称" />
      </view>
      <view class="sp-edit-row-2col">
        <view class="sp-edit-item">
          <text class="sp-edit-lbl">省份</text>
          <input class="sp-edit-input full" value="{{editForm.province}}" bindinput="onEditInput" data-field="province" placeholder="如：福建省" />
        </view>
        <view class="sp-edit-item">
          <text class="sp-edit-lbl">城市</text>
          <input class="sp-edit-input full" value="{{editForm.city}}" bindinput="onEditInput" data-field="city" placeholder="如：厦门市" />
        </view>
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">发起背景</text>
        <textarea class="sp-edit-textarea" value="{{editForm.background}}" bindinput="onEditInput" data-field="background" placeholder="请输入发起背景" maxlength="500" />
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">家园特色</text>
        <textarea class="sp-edit-textarea" value="{{editForm.characteristics}}" bindinput="onEditInput" data-field="characteristics" placeholder="请输入家园特色" maxlength="500" />
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">运营状态</text>
        <view class="sp-status-pill-row">
          <view class="sp-status-pill {{editForm.operatingStatus === 'operating' ? 'active' : ''}}" bindtap="onSelectOperatingStatus" data-value="operating">运营中</view>
          <view class="sp-status-pill {{editForm.operatingStatus === 'preparing' ? 'active' : ''}}" bindtap="onSelectOperatingStatus" data-value="preparing">筹备中</view>
          <view class="sp-status-pill {{editForm.operatingStatus === 'paused' ? 'active' : ''}}" bindtap="onSelectOperatingStatus" data-value="paused">暂停运营</view>
        </view>
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">门店位置（用于"附近门店"距离排序）</text>
        <view class="sp-location-picker-btn" bindtap="onChooseLocation">{{editForm.locationLabel || '📍 点击选择门店位置'}}</view>
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">门店照片（最多 9 张）</text>
        <view class="receipt-grid-container">
          <view class="grid-image-item" wx:for="{{editForm.storePhotos}}" wx:key="*this">
            <image class="grid-img" src="{{item}}" mode="aspectFill" />
            <view class="img-delete-badge" catchtap="onDeletePhoto" data-category="storePhotos" data-index="{{index}}">✕</view>
          </view>
          <view class="grid-add-btn" bindtap="onChoosePhoto" data-category="storePhotos" wx:if="{{editForm.storePhotos.length < 9}}">
            <text class="add-icon">{{storePhotoUploading ? '…' : '+'}}</text>
            <text class="add-txt">{{storePhotoUploading ? '压缩中' : '添加照片'}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 🔐 门店安全设置：管理员密钥仅大家长/超管可见并编辑；店长只读状态 -->
    <view class="sp-section-title sp-profile-title-row" wx:if="{{canManage && !editing}}">
      <text class="sp-section-icon">🔐</text>
      <text class="sp-section-txt">门店安全设置</text>
      <text class="sp-btn-edit-profile-count" wx:if="{{canSetAdminKey}}" bindtap="onOpenAdminKeyModal">✏️ 修改</text>
    </view>

    <view class="sp-archive-card" wx:if="{{canManage && !editing}}">
      <view class="sp-archive-row">
        <text class="sp-archive-lbl">管理员密钥</text>
        <view class="sp-archive-val-with-action">
          <view class="sp-admin-key-status-badge {{adminKeySet ? 'set' : 'unset'}}">
            <text>{{adminKeySet ? '✅ 已设置' : '⚪ 未设置'}}</text>
          </view>
          <text class="sp-admin-key-hint" wx:if="{{!canSetAdminKey}}">（仅大家长/超管可配置）</text>
        </view>
      </view>
      <view class="sp-archive-row" wx:if="{{adminKeySet && canSetAdminKey && adminKeyCurrentVal}}">
        <text class="sp-archive-lbl">当前密钥</text>
        <text class="sp-archive-val sp-admin-key-val">{{adminKeyCurrentVal}}</text>
      </view>
      <view class="sp-archive-row vertical" wx:if="{{canSetAdminKey}}">
        <text class="sp-archive-val-block sp-admin-key-desc">申请管理岗位（大家长/店长/财务）时需提供此密钥。设置后，无密钥者将无法提交高权限申请。</text>
      </view>
    </view>

    <view class="sp-section-title sp-profile-title-row">
      <text class="sp-section-icon">👥</text>
      <text class="sp-section-txt">门店人员与服务人群画像</text>
      <text class="sp-btn-edit-profile-count" wx:if="{{canManage}}" bindtap="onOpenProfileCountModal">✏️ 修改</text>
    </view>

    <!-- 展示态：4 列 x 2 行栅格，中共党员用红色高亮，其余暖橘/深灰数字；数值为 0 时
         降级为素灰简约样式（.zero），避免满屏彩色数字里混着一堆没意义的高亮 0 -->
    <view class="sp-profile-grid-4col" wx:if="{{!editing}}">
      <view class="grid-cell">
        <text class="cell-lbl">中共党员</text>
        <text class="cell-val {{partyMembers > 0 ? 'party-highlight' : 'zero'}}">{{partyMembers}}</text>
      </view>
      <view class="grid-cell">
        <text class="cell-lbl">社会工作者</text>
        <text class="cell-val {{socialWorkers > 0 ? 'orange' : 'zero'}}">{{socialWorkers}}</text>
      </view>
      <view class="grid-cell">
        <text class="cell-lbl">志愿者</text>
        <text class="cell-val {{volunteersCount > 0 ? 'orange' : 'zero'}}">{{volunteersCount}}</text>
      </view>
      <view class="grid-cell">
        <text class="cell-lbl">堂食老人</text>
        <text class="cell-val {{dineInSeniorsCount > 0 ? 'orange' : 'zero'}}">{{dineInSeniorsCount}}</text>
      </view>
      <view class="grid-cell">
        <text class="cell-lbl">送餐老人</text>
        <text class="cell-val {{deliverySeniorsCount > 0 ? 'orange' : 'zero'}}">{{deliverySeniorsCount}}</text>
      </view>
      <view class="grid-cell">
        <text class="cell-lbl">倾听陪伴老人</text>
        <text class="cell-val {{listeningSeniorsCount > 0 ? 'orange' : 'zero'}}">{{listeningSeniorsCount}}</text>
      </view>
      <view class="grid-cell">
        <text class="cell-lbl">其他</text>
        <text class="cell-val {{otherCount > 0 ? 'grey' : 'zero'}}">{{otherCount}}</text>
      </view>
    </view>

    <!-- 编辑态：同 7 项指标的输入框 -->
    <view class="sp-edit-grid" wx:if="{{editing}}">
      <view class="sp-edit-item">
        <text class="sp-edit-lbl party-highlight">中共党员</text>
        <input class="sp-edit-input" type="number" value="{{editForm.partyMembers}}" bindinput="onEditInput" data-field="partyMembers" />
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">社会工作者</text>
        <input class="sp-edit-input" type="number" value="{{editForm.socialWorkers}}" bindinput="onEditInput" data-field="socialWorkers" />
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">志愿者</text>
        <input class="sp-edit-input" type="number" value="{{editForm.volunteersCount}}" bindinput="onEditInput" data-field="volunteersCount" />
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">堂食老人</text>
        <input class="sp-edit-input" type="number" value="{{editForm.dineInSeniorsCount}}" bindinput="onEditInput" data-field="dineInSeniorsCount" />
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">送餐老人</text>
        <input class="sp-edit-input" type="number" value="{{editForm.deliverySeniorsCount}}" bindinput="onEditInput" data-field="deliverySeniorsCount" />
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">倾听陪伴老人</text>
        <input class="sp-edit-input" type="number" value="{{editForm.listeningSeniorsCount}}" bindinput="onEditInput" data-field="listeningSeniorsCount" />
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">其他</text>
        <input class="sp-edit-input" type="number" value="{{editForm.otherCount}}" bindinput="onEditInput" data-field="otherCount" />
      </view>
    </view>

    <view class="sp-edit-footer" wx:if="{{editing}}">
      <button class="sp-btn-cancel" bindtap="onCancelEdit">取消</button>
      <button class="sp-btn-save" bindtap="onSaveProfile" loading="{{saving}}" disabled="{{saving}}">保存</button>
    </view>

    <view class="sp-loading-box" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>

  </scroll-view>

  <!-- 门店人员与服务人群画像 · 快捷修改弹窗：只改这 7 项人数指标，比进入整页"编辑"
       模式更轻量——那个模式还会一并带出地址/开业日期等一大堆档案字段 -->
  <view class="sp-modal-backdrop" wx:if="{{showProfileCountModal}}" bindtap="onCloseProfileCountModal">
    <view class="sp-modal-card" catchtap="stopPropagation">
      <view class="sp-modal-header">
        <text class="sp-modal-title">修改人员与服务人群画像</text>
        <text class="sp-modal-close" bindtap="onCloseProfileCountModal">✕</text>
      </view>
      <scroll-view scroll-y class="sp-modal-scroll">
        <view class="sp-edit-grid">
          <view class="sp-edit-item">
            <text class="sp-edit-lbl party-highlight">中共党员</text>
            <input class="sp-edit-input" type="number" value="{{profileCountForm.partyMembers}}" bindinput="onProfileCountInput" data-field="partyMembers" />
          </view>
          <view class="sp-edit-item">
            <text class="sp-edit-lbl">社会工作者</text>
            <input class="sp-edit-input" type="number" value="{{profileCountForm.socialWorkers}}" bindinput="onProfileCountInput" data-field="socialWorkers" />
          </view>
          <view class="sp-edit-item">
            <text class="sp-edit-lbl">志愿者</text>
            <input class="sp-edit-input" type="number" value="{{profileCountForm.volunteersCount}}" bindinput="onProfileCountInput" data-field="volunteersCount" />
          </view>
          <view class="sp-edit-item">
            <text class="sp-edit-lbl">堂食老人</text>
            <input class="sp-edit-input" type="number" value="{{profileCountForm.dineInSeniorsCount}}" bindinput="onProfileCountInput" data-field="dineInSeniorsCount" />
          </view>
          <view class="sp-edit-item">
            <text class="sp-edit-lbl">送餐老人</text>
            <input class="sp-edit-input" type="number" value="{{profileCountForm.deliverySeniorsCount}}" bindinput="onProfileCountInput" data-field="deliverySeniorsCount" />
          </view>
          <view class="sp-edit-item">
            <text class="sp-edit-lbl">倾听陪伴老人</text>
            <input class="sp-edit-input" type="number" value="{{profileCountForm.listeningSeniorsCount}}" bindinput="onProfileCountInput" data-field="listeningSeniorsCount" />
          </view>
          <view class="sp-edit-item">
            <text class="sp-edit-lbl">其他</text>
            <input class="sp-edit-input" type="number" value="{{profileCountForm.otherCount}}" bindinput="onProfileCountInput" data-field="otherCount" />
          </view>
        </view>
      </scroll-view>
      <view class="sp-modal-footer">
        <button class="sp-btn-cancel" bindtap="onCloseProfileCountModal">取消</button>
        <button class="sp-btn-save" bindtap="onSaveProfileCount" loading="{{profileCountSaving}}" disabled="{{profileCountSaving}}">保存</button>
      </view>
    </view>
  </view>

  <!-- 门店资质与实景公示 · 快捷修改弹窗：门头照/民政备案复印件/食品安全承诺各最多 6 张，
       与 storePhotos 共用 onChoosePhoto/onDeletePhoto，data-target="qualificationForm"
       区分不写入整页 editForm -->
  <view class="sp-modal-backdrop" wx:if="{{showQualificationModal}}" bindtap="onCloseQualificationModal">
    <view class="sp-modal-card" catchtap="stopPropagation">
      <view class="sp-modal-header">
        <text class="sp-modal-title">修改门店资质与实景公示</text>
        <text class="sp-modal-close" bindtap="onCloseQualificationModal">✕</text>
      </view>
      <scroll-view scroll-y class="sp-modal-scroll">
        <view class="sp-edit-item">
          <text class="sp-edit-lbl">门头照（最多 6 张）</text>
          <view class="receipt-grid-container">
            <view class="grid-image-item" wx:for="{{qualificationForm.storefrontPhotos}}" wx:key="*this">
              <image class="grid-img" src="{{item}}" mode="aspectFill" bindtap="onPreviewProfilePhoto" data-url="{{item}}" data-urls="{{qualificationForm.storefrontPhotos}}" />
              <view class="img-delete-badge" catchtap="onDeletePhoto" data-category="storefrontPhotos" data-target="qualificationForm" data-index="{{index}}">✕</view>
            </view>
            <view class="grid-add-btn" bindtap="onChoosePhoto" data-category="storefrontPhotos" data-target="qualificationForm" wx:if="{{qualificationForm.storefrontPhotos.length < 6}}">
              <text class="add-icon">{{storePhotoUploading ? '…' : '+'}}</text>
              <text class="add-txt">{{storePhotoUploading ? '压缩中' : '添加照片'}}</text>
            </view>
          </view>
        </view>
        <view class="sp-edit-item">
          <text class="sp-edit-lbl">民政备案复印件（最多 6 张）</text>
          <view class="receipt-grid-container">
            <view class="grid-image-item" wx:for="{{qualificationForm.civilAffairsPhotos}}" wx:key="*this">
              <image class="grid-img" src="{{item}}" mode="aspectFill" bindtap="onPreviewProfilePhoto" data-url="{{item}}" data-urls="{{qualificationForm.civilAffairsPhotos}}" />
              <view class="img-delete-badge" catchtap="onDeletePhoto" data-category="civilAffairsPhotos" data-target="qualificationForm" data-index="{{index}}">✕</view>
            </view>
            <view class="grid-add-btn" bindtap="onChoosePhoto" data-category="civilAffairsPhotos" data-target="qualificationForm" wx:if="{{qualificationForm.civilAffairsPhotos.length < 6}}">
              <text class="add-icon">{{storePhotoUploading ? '…' : '+'}}</text>
              <text class="add-txt">{{storePhotoUploading ? '压缩中' : '添加照片'}}</text>
            </view>
          </view>
        </view>
        <view class="sp-edit-item">
          <text class="sp-edit-lbl">食品安全承诺（最多 6 张）</text>
          <view class="receipt-grid-container">
            <view class="grid-image-item" wx:for="{{qualificationForm.foodSafetyPledgePhotos}}" wx:key="*this">
              <image class="grid-img" src="{{item}}" mode="aspectFill" bindtap="onPreviewProfilePhoto" data-url="{{item}}" data-urls="{{qualificationForm.foodSafetyPledgePhotos}}" />
              <view class="img-delete-badge" catchtap="onDeletePhoto" data-category="foodSafetyPledgePhotos" data-target="qualificationForm" data-index="{{index}}">✕</view>
            </view>
            <view class="grid-add-btn" bindtap="onChoosePhoto" data-category="foodSafetyPledgePhotos" data-target="qualificationForm" wx:if="{{qualificationForm.foodSafetyPledgePhotos.length < 6}}">
              <text class="add-icon">{{storePhotoUploading ? '…' : '+'}}</text>
              <text class="add-txt">{{storePhotoUploading ? '压缩中' : '添加照片'}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="sp-modal-footer">
        <button class="sp-btn-cancel" bindtap="onCloseQualificationModal">取消</button>
        <button class="sp-btn-save" bindtap="onSaveQualification" loading="{{qualificationSaving}}" disabled="{{qualificationSaving}}">保存</button>
      </view>
    </view>
  </view>

  <canvas type="2d" id="storeProfileImgCompressCanvas" style="position: fixed; left: -9999px; top: -9999px; width: 1920px; height: 1920px;"></canvas>

  <!-- 🔐 管理员密钥 · 设置/修改弹窗：仅大家长/超管可触发 -->
  <view class="sp-modal-backdrop" wx:if="{{showAdminKeyModal}}" bindtap="onCloseAdminKeyModal">
    <view class="sp-modal-card" catchtap="stopPropagation">
      <view class="sp-modal-header">
        <text class="sp-modal-title">{{adminKeySet ? '修改管理员密钥' : '设置管理员密钥'}}</text>
        <text class="sp-modal-close" bindtap="onCloseAdminKeyModal">✕</text>
      </view>
      <scroll-view scroll-y class="sp-modal-scroll">
        <view class="sp-edit-item">
          <text class="sp-edit-lbl">新密钥（留空则清除）</text>
          <input
            class="sp-edit-input full"
            type="text"
            password
            value="{{adminKeyInput}}"
            bindinput="onAdminKeyInputChange"
            placeholder="请输入密钥/暗号，最多 50 字"
            maxlength="50"
          />
        </view>
        <view class="sp-admin-key-modal-hint">
          <text>设置后，申请大家长/店长/财务角色时必须输入此密钥才能提交申请。</text>
          <text>若要清除密钥（允许所有人自由申请），请将输入框留空后保存。</text>
        </view>
      </scroll-view>
      <view class="sp-modal-footer">
        <button class="sp-btn-cancel" bindtap="onCloseAdminKeyModal">取消</button>
        <button class="sp-btn-save" bindtap="onSaveAdminKey" loading="{{adminKeySaving}}" disabled="{{adminKeySaving}}">保存</button>
      </view>
    </view>
  </view>
</view>
