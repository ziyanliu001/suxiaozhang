<view class="sp-page">
  <!-- 图片压缩用离屏画布（大事记配图上传），全页面共用一个即可 -->
  <canvas type="2d" id="milestoneImgCompressCanvas" style="position: fixed; left: -9999px; top: -9999px; width: 1920px; height: 1920px;"></canvas>

  <view class="sp-nav-bar" style="padding-top: {{navTop}}px;">
    <view class="sp-nav-back" hover-class="sp-nav-back-hover" bindtap="goBack">←</view>
    <text class="sp-nav-title">🏠 门店档案</text>
  </view>

  <scroll-view scroll-y class="sp-scroll" style="margin-top: {{contentTop}}px;">

    <view class="sp-store-card">
      <view class="sp-store-name-row">
        <text class="sp-store-name">{{currentStoreName || '未命名门店'}}</text>
        <text class="sp-operating-badge {{operatingStatus}}">{{operatingStatusLabel}}</text>
      </view>
      <text class="sp-store-address" wx:if="{{address}}">📍 {{address}}</text>
    </view>

    <!-- 🏛️ 家长风控锁：本店已绑定家长/督导时，店长发起的门店档案变更需先经确认才生效 -->
    <view class="sp-pending-banner" wx:if="{{pendingProfileUpdate}}">
      <text class="sp-pending-icon">⏳</text>
      <text class="sp-pending-text">有一份门店档案更新正在等待家长/超管审批，当前展示的仍是生效中的数据</text>
    </view>

    <!-- 🏛️ 门店档案信息：详细地址/开业日期/民政登记名称/发起背景/家园特色 + 省市/运营状态/位置
         🛡️ 编辑入口改为卡片标题栏内的行内按钮，与下方"门店人员与服务人群画像"完全同款结构
         （sp-profile-title-row + sp-btn-edit-profile-count，样式通用，非"画像"专属）——
         此前放在顶部导航栏的"编辑"文字反复出现不渲染/被遮挡的问题，根治方案是不再依赖
         导航栏这套单独的定位/层级逻辑，统一复用已验证稳定可见的卡片标题按钮模式 -->
    <view class="sp-section-title sp-profile-title-row">
      <text class="sp-section-icon">📖</text>
      <text class="sp-section-txt">门店档案信息</text>
      <text class="sp-btn-edit-profile-count" wx:if="{{canManage && !editing}}" bindtap="onEditProfile">✏️ 修改</text>
    </view>

    <view class="sp-archive-card" wx:if="{{!editing}}">
      <view class="sp-archive-row">
        <text class="sp-archive-lbl">开业日期</text>
        <text class="sp-archive-val">{{openDate || '未填写'}}</text>
      </view>
      <view class="sp-archive-row">
        <text class="sp-archive-lbl">民政登记名称</text>
        <text class="sp-archive-val">{{registeredName || '未填写'}}</text>
      </view>
      <view class="sp-archive-row">
        <text class="sp-archive-lbl">所在省市</text>
        <text class="sp-archive-val">{{province || city ? (province + ' ' + city) : '未填写'}}</text>
      </view>
      <view class="sp-archive-row vertical" wx:if="{{background}}">
        <text class="sp-archive-lbl">发起背景</text>
        <text class="sp-archive-val-block">{{background}}</text>
      </view>
      <view class="sp-archive-row vertical" wx:if="{{characteristics}}">
        <text class="sp-archive-lbl">家园特色</text>
        <text class="sp-archive-val-block">{{characteristics}}</text>
      </view>
    </view>

    <view class="sp-archive-edit-card" wx:if="{{editing}}">
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">详细地址</text>
        <input class="sp-edit-input full" value="{{editForm.address}}" bindinput="onEditInput" data-field="address" placeholder="请输入门店详细地址" />
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">开业日期</text>
        <picker mode="date" value="{{editForm.openDate}}" bindchange="onEditOpenDateChange">
          <view class="sp-edit-input full sp-date-picker-value">{{editForm.openDate || '点击选择日期'}}</view>
        </picker>
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">民政登记名称</text>
        <input class="sp-edit-input full" value="{{editForm.registeredName}}" bindinput="onEditInput" data-field="registeredName" placeholder="请输入民政登记全称" />
      </view>
      <view class="sp-edit-row-2col">
        <view class="sp-edit-item">
          <text class="sp-edit-lbl">省份</text>
          <input class="sp-edit-input full" value="{{editForm.province}}" bindinput="onEditInput" data-field="province" placeholder="如：福建省" />
        </view>
        <view class="sp-edit-item">
          <text class="sp-edit-lbl">城市</text>
          <input class="sp-edit-input full" value="{{editForm.city}}" bindinput="onEditInput" data-field="city" placeholder="如：厦门市" />
        </view>
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">发起背景</text>
        <textarea class="sp-edit-textarea" value="{{editForm.background}}" bindinput="onEditInput" data-field="background" placeholder="请输入发起背景" maxlength="500" />
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">家园特色</text>
        <textarea class="sp-edit-textarea" value="{{editForm.characteristics}}" bindinput="onEditInput" data-field="characteristics" placeholder="请输入家园特色" maxlength="500" />
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">运营状态</text>
        <view class="sp-status-pill-row">
          <view class="sp-status-pill {{editForm.operatingStatus === 'operating' ? 'active' : ''}}" bindtap="onSelectOperatingStatus" data-value="operating">运营中</view>
          <view class="sp-status-pill {{editForm.operatingStatus === 'preparing' ? 'active' : ''}}" bindtap="onSelectOperatingStatus" data-value="preparing">筹备中</view>
          <view class="sp-status-pill {{editForm.operatingStatus === 'paused' ? 'active' : ''}}" bindtap="onSelectOperatingStatus" data-value="paused">暂停运营</view>
        </view>
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">门店位置（用于"附近门店"距离排序）</text>
        <view class="sp-location-picker-btn" bindtap="onChooseLocation">{{editForm.locationLabel || '📍 点击选择门店位置'}}</view>
      </view>
    </view>

    <view class="sp-section-title sp-profile-title-row">
      <text class="sp-section-icon">👥</text>
      <text class="sp-section-txt">门店人员与服务人群画像</text>
      <text class="sp-btn-edit-profile-count" wx:if="{{canManage}}" bindtap="onOpenProfileCountModal">✏️ 修改</text>
    </view>

    <!-- 展示态：4 列 x 2 行栅格，中共党员用红色高亮，其余暖橘/深灰数字；数值为 0 时
         降级为素灰简约样式（.zero），避免满屏彩色数字里混着一堆没意义的高亮 0 -->
    <view class="sp-profile-grid-4col" wx:if="{{!editing}}">
      <view class="grid-cell">
        <text class="cell-lbl">中共党员</text>
        <text class="cell-val {{partyMembers > 0 ? 'party-highlight' : 'zero'}}">{{partyMembers}}</text>
      </view>
      <view class="grid-cell">
        <text class="cell-lbl">社会工作者</text>
        <text class="cell-val {{socialWorkers > 0 ? 'orange' : 'zero'}}">{{socialWorkers}}</text>
      </view>
      <view class="grid-cell">
        <text class="cell-lbl">志愿者</text>
        <text class="cell-val {{volunteersCount > 0 ? 'orange' : 'zero'}}">{{volunteersCount}}</text>
      </view>
      <view class="grid-cell">
        <text class="cell-lbl">堂食老人</text>
        <text class="cell-val {{dineInSeniorsCount > 0 ? 'orange' : 'zero'}}">{{dineInSeniorsCount}}</text>
      </view>
      <view class="grid-cell">
        <text class="cell-lbl">送餐老人</text>
        <text class="cell-val {{deliverySeniorsCount > 0 ? 'orange' : 'zero'}}">{{deliverySeniorsCount}}</text>
      </view>
      <view class="grid-cell">
        <text class="cell-lbl">倾听陪伴老人</text>
        <text class="cell-val {{listeningSeniorsCount > 0 ? 'orange' : 'zero'}}">{{listeningSeniorsCount}}</text>
      </view>
      <view class="grid-cell">
        <text class="cell-lbl">其他</text>
        <text class="cell-val {{otherCount > 0 ? 'grey' : 'zero'}}">{{otherCount}}</text>
      </view>
    </view>

    <!-- 编辑态：同 7 项指标的输入框 -->
    <view class="sp-edit-grid" wx:if="{{editing}}">
      <view class="sp-edit-item">
        <text class="sp-edit-lbl party-highlight">中共党员</text>
        <input class="sp-edit-input" type="number" value="{{editForm.partyMembers}}" bindinput="onEditInput" data-field="partyMembers" />
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">社会工作者</text>
        <input class="sp-edit-input" type="number" value="{{editForm.socialWorkers}}" bindinput="onEditInput" data-field="socialWorkers" />
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">志愿者</text>
        <input class="sp-edit-input" type="number" value="{{editForm.volunteersCount}}" bindinput="onEditInput" data-field="volunteersCount" />
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">堂食老人</text>
        <input class="sp-edit-input" type="number" value="{{editForm.dineInSeniorsCount}}" bindinput="onEditInput" data-field="dineInSeniorsCount" />
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">送餐老人</text>
        <input class="sp-edit-input" type="number" value="{{editForm.deliverySeniorsCount}}" bindinput="onEditInput" data-field="deliverySeniorsCount" />
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">倾听陪伴老人</text>
        <input class="sp-edit-input" type="number" value="{{editForm.listeningSeniorsCount}}" bindinput="onEditInput" data-field="listeningSeniorsCount" />
      </view>
      <view class="sp-edit-item">
        <text class="sp-edit-lbl">其他</text>
        <input class="sp-edit-input" type="number" value="{{editForm.otherCount}}" bindinput="onEditInput" data-field="otherCount" />
      </view>
    </view>

    <view class="sp-edit-footer" wx:if="{{editing}}">
      <button class="sp-btn-cancel" bindtap="onCancelEdit">取消</button>
      <button class="sp-btn-save" bindtap="onSaveProfile" loading="{{saving}}" disabled="{{saving}}">保存</button>
    </view>

    <view class="sp-loading-box" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>

    <!-- 🏛️ 门店大事记/发展历程：按年份分组的时间轴，参照 pages/journey 的展开/收起范式 -->
    <view class="sp-section-title sp-milestone-title-row">
      <text class="sp-section-icon">📜</text>
      <text class="sp-section-txt">门店大事记 / 发展历程</text>
      <view class="sp-milestone-title-actions">
        <text class="sp-btn-toggle-all" wx:if="{{milestoneTimelineGroups.length > 0}}" bindtap="onToggleAllMilestones">{{allMilestonesExpanded ? '全部收起' : '全部展开'}}</text>
        <text class="sp-btn-add-milestone" wx:if="{{canManage}}" bindtap="onOpenAddMilestone">+ 添加</text>
      </view>
    </view>

    <view class="sp-milestone-groups" wx:if="{{!milestonesLoading && milestoneTimelineGroups.length > 0}}">
      <view class="sp-milestone-group" wx:for="{{milestoneTimelineGroups}}" wx:key="yearKey">
        <view class="sp-milestone-group-header" bindtap="onToggleMilestoneGroup" data-year-key="{{item.yearKey}}">
          <view class="sp-milestone-group-dot"></view>
          <text class="sp-milestone-group-label">{{item.yearLabel}}</text>
          <text class="sp-milestone-group-count">共 {{item.items.length}} 条</text>
          <text class="sp-milestone-group-arrow {{item.expanded ? 'rotate' : ''}}">▾</text>
        </view>
        <view class="sp-milestone-items {{item.expanded ? 'expanded' : 'collapsed'}}">
          <view class="sp-milestone-item" wx:for="{{item.items}}" wx:for-item="ms" wx:key="_id">
            <view class="sp-milestone-item-left">
              <view class="sp-milestone-dot"></view>
              <view class="sp-milestone-line"></view>
            </view>
            <view class="sp-milestone-item-body">
              <view class="sp-milestone-item-header">
                <text class="sp-milestone-date">{{ms.eventDate}}</text>
                <text class="sp-milestone-title">{{ms.title}}</text>
              </view>
              <text class="sp-milestone-content" wx:if="{{ms.content}}">{{ms.content}}</text>
              <view class="sp-milestone-img-grid" wx:if="{{ms.images.length > 0}}">
                <image class="sp-milestone-img" wx:for="{{ms.images}}" wx:for-item="img" wx:key="*this" src="{{img.url}}" mode="aspectFill" />
              </view>
              <view class="sp-milestone-item-actions" wx:if="{{canManage}}">
                <text class="sp-milestone-action-btn" data-item="{{ms}}" bindtap="onOpenEditMilestone">编辑</text>
                <text class="sp-milestone-action-btn danger" data-id="{{ms._id}}" bindtap="onDeleteMilestone">删除</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="sp-milestone-empty" wx:if="{{!milestonesLoading && milestoneTimelineGroups.length === 0}}">
      <text>暂无大事记，{{canManage ? '点击右上角"+ 添加"记录门店发展历程' : '敬请期待'}}</text>
    </view>

  </scroll-view>

  <!-- 大事记新增/编辑弹窗 -->
  <view class="sp-modal-backdrop" wx:if="{{showMilestoneModal}}" bindtap="onCloseMilestoneModal">
    <view class="sp-modal-card" catchtap="stopPropagation">
      <view class="sp-modal-header">
        <text class="sp-modal-title">{{milestoneForm.id ? '编辑大事记' : '添加大事记'}}</text>
        <text class="sp-modal-close" bindtap="onCloseMilestoneModal">✕</text>
      </view>
      <scroll-view scroll-y class="sp-modal-scroll">
        <text class="sp-form-label">标题</text>
        <input class="sp-modal-input" value="{{milestoneForm.title}}" bindinput="onMilestoneTitleInput" placeholder="如：门店成立仪式" maxlength="40" />

        <text class="sp-form-label">发生日期</text>
        <picker mode="date" value="{{milestoneForm.eventDate}}" bindchange="onMilestoneDateChange">
          <view class="sp-modal-input sp-date-picker-value">{{milestoneForm.eventDate || '点击选择日期'}}</view>
        </picker>

        <text class="sp-form-label">内容描述</text>
        <textarea class="sp-modal-textarea" value="{{milestoneForm.content}}" bindinput="onMilestoneContentInput" placeholder="请输入这段大事记的详细内容" maxlength="500" />

        <text class="sp-form-label">配图（最多 9 张）</text>
        <view class="sp-milestone-img-edit-grid">
          <view class="sp-milestone-img-wrap" wx:for="{{milestoneForm.images}}" wx:key="*this">
            <image class="sp-milestone-img" src="{{item}}" mode="aspectFill" />
            <view class="sp-milestone-img-remove" data-index="{{index}}" catchtap="onRemoveMilestoneImage">✕</view>
          </view>
          <view class="sp-milestone-img-add" bindtap="onChooseMilestoneImage" wx:if="{{milestoneForm.images.length < 9}}">
            <text>+</text>
          </view>
        </view>
      </scroll-view>
      <view class="sp-modal-footer">
        <button class="sp-btn-cancel" bindtap="onCloseMilestoneModal">取消</button>
        <button class="sp-btn-save" bindtap="onSaveMilestone" loading="{{milestoneSaving}}" disabled="{{milestoneSaving || milestoneUploading}}">保存</button>
      </view>
    </view>
  </view>

  <!-- 门店人员与服务人群画像 · 快捷修改弹窗：只改这 7 项人数指标，比进入整页"编辑"
       模式更轻量——那个模式还会一并带出地址/开业日期等一大堆档案字段 -->
  <view class="sp-modal-backdrop" wx:if="{{showProfileCountModal}}" bindtap="onCloseProfileCountModal">
    <view class="sp-modal-card" catchtap="stopPropagation">
      <view class="sp-modal-header">
        <text class="sp-modal-title">修改人员与服务人群画像</text>
        <text class="sp-modal-close" bindtap="onCloseProfileCountModal">✕</text>
      </view>
      <scroll-view scroll-y class="sp-modal-scroll">
        <view class="sp-edit-grid">
          <view class="sp-edit-item">
            <text class="sp-edit-lbl party-highlight">中共党员</text>
            <input class="sp-edit-input" type="number" value="{{profileCountForm.partyMembers}}" bindinput="onProfileCountInput" data-field="partyMembers" />
          </view>
          <view class="sp-edit-item">
            <text class="sp-edit-lbl">社会工作者</text>
            <input class="sp-edit-input" type="number" value="{{profileCountForm.socialWorkers}}" bindinput="onProfileCountInput" data-field="socialWorkers" />
          </view>
          <view class="sp-edit-item">
            <text class="sp-edit-lbl">志愿者</text>
            <input class="sp-edit-input" type="number" value="{{profileCountForm.volunteersCount}}" bindinput="onProfileCountInput" data-field="volunteersCount" />
          </view>
          <view class="sp-edit-item">
            <text class="sp-edit-lbl">堂食老人</text>
            <input class="sp-edit-input" type="number" value="{{profileCountForm.dineInSeniorsCount}}" bindinput="onProfileCountInput" data-field="dineInSeniorsCount" />
          </view>
          <view class="sp-edit-item">
            <text class="sp-edit-lbl">送餐老人</text>
            <input class="sp-edit-input" type="number" value="{{profileCountForm.deliverySeniorsCount}}" bindinput="onProfileCountInput" data-field="deliverySeniorsCount" />
          </view>
          <view class="sp-edit-item">
            <text class="sp-edit-lbl">倾听陪伴老人</text>
            <input class="sp-edit-input" type="number" value="{{profileCountForm.listeningSeniorsCount}}" bindinput="onProfileCountInput" data-field="listeningSeniorsCount" />
          </view>
          <view class="sp-edit-item">
            <text class="sp-edit-lbl">其他</text>
            <input class="sp-edit-input" type="number" value="{{profileCountForm.otherCount}}" bindinput="onProfileCountInput" data-field="otherCount" />
          </view>
        </view>
      </scroll-view>
      <view class="sp-modal-footer">
        <button class="sp-btn-cancel" bindtap="onCloseProfileCountModal">取消</button>
        <button class="sp-btn-save" bindtap="onSaveProfileCount" loading="{{profileCountSaving}}" disabled="{{profileCountSaving}}">保存</button>
      </view>
    </view>
  </view>
</view>
