.sp-page {
  min-height: 100vh;
  background: #F8F5F0;
}

.sp-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  height: 88rpx;
  background: #8C1D18;
}

.sp-nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
}

.sp-nav-back-hover {
  opacity: 0.5;
}

.sp-nav-title {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
}

.sp-nav-action {
  color: #FFFFFF;
  font-size: 26rpx;
  width: 110rpx;
  text-align: right;
}

.sp-nav-action.hidden {
  visibility: hidden;
}

.sp-scroll {
  height: calc(100vh - 88rpx);
  box-sizing: border-box;
  padding: 20rpx 24rpx 60rpx;
}

/* 🏛️ 家长风控锁：待审批提示条 */
.sp-pending-banner {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #FFFBE6;
  border: 1rpx solid #FFE58F;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.sp-pending-icon {
  font-size: 26rpx;
}

.sp-pending-text {
  font-size: 22rpx;
  color: #D48806;
  flex: 1;
}

.sp-store-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.sp-store-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.sp-store-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
}

/* 🌐 运营状态徽章：与 store-picker 组件同款配色口径 */
.sp-operating-badge {
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 10rpx;
  background: #E8F5E9;
  color: #2E7D32;
}

.sp-operating-badge.preparing {
  background: #FFF3E0;
  color: #D48806;
}

.sp-operating-badge.paused {
  background: #F1F3F5;
  color: #868E96;
}

.sp-store-address {
  display: block;
  font-size: 24rpx;
  color: #868E96;
}

.sp-section-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.sp-section-icon {
  font-size: 26rpx;
}

.sp-section-txt {
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
}

/* 4 列 x 2 行栅格：与 history.wxss 的 .dining-breakdown-grid 同款 grid-cell/cell-lbl/cell-val 口径 */
.sp-profile-grid-4col {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.grid-cell {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.cell-lbl {
  font-size: 22rpx;
  color: #868E96;
}

.cell-val {
  font-size: 34rpx;
  font-weight: bold;
  color: #212529;
}

/* 中共党员：醒目红色高亮，与其余暖橘色指标区分 */
.cell-val.party-highlight {
  color: #D9363E;
}

.cell-val.orange {
  color: #D2691E;
}

.cell-val.grey {
  color: #495057;
}

.sp-edit-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.sp-edit-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sp-edit-lbl {
  font-size: 22rpx;
  color: #495057;
}

.sp-edit-lbl.party-highlight {
  color: #D9363E;
  font-weight: bold;
}

.sp-edit-input {
  background: #F8F9FA;
  border: 1rpx solid #CED4DA;
  border-radius: 10rpx;
  height: 72rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
}

.sp-edit-footer {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.sp-btn-cancel {
  flex: 1;
  background: #F1F3F5;
  color: #495057;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.sp-btn-save {
  flex: 1;
  background: #8C1D18;
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.sp-loading-box {
  text-align: center;
  padding: 40rpx 0;
  color: #ADB5BD;
  font-size: 24rpx;
}

/* 🏛️ 门店档案信息：展示态纵向标签+值列表，编辑态复用 .sp-edit-item/.sp-edit-lbl */
.sp-archive-card,
.sp-archive-edit-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.sp-archive-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed #F1F3F5;
}

.sp-archive-row:last-child {
  border-bottom: none;
}

.sp-archive-row.vertical {
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}

.sp-archive-lbl {
  font-size: 24rpx;
  color: #868E96;
  flex-shrink: 0;
}

.sp-archive-val {
  font-size: 26rpx;
  color: #212529;
  text-align: right;
}

.sp-archive-val-block {
  font-size: 26rpx;
  color: #212529;
  line-height: 1.6;
}

.sp-archive-edit-card .sp-edit-item {
  margin-bottom: 20rpx;
}

.sp-archive-edit-card .sp-edit-item:last-child {
  margin-bottom: 0;
}

.sp-edit-row-2col {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.sp-edit-row-2col .sp-edit-item {
  flex: 1;
  margin-bottom: 0;
}

.sp-edit-input.full {
  width: 100%;
  box-sizing: border-box;
  font-weight: normal;
}

.sp-date-picker-value {
  display: flex;
  align-items: center;
}

.sp-edit-textarea {
  background: #F8F9FA;
  border: 1rpx solid #CED4DA;
  border-radius: 10rpx;
  min-height: 100rpx;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  color: #212529;
  width: 100%;
  box-sizing: border-box;
}

.sp-status-pill-row {
  display: flex;
  gap: 12rpx;
}

.sp-status-pill {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #666666;
  background: #F8F9FA;
  border: 1rpx solid #CED4DA;
  border-radius: 10rpx;
  padding: 12rpx 0;
}

.sp-status-pill.active {
  background: #8C1D18;
  color: #FFFFFF;
  border-color: #8C1D18;
  font-weight: bold;
}

.sp-location-picker-btn {
  height: 72rpx;
  line-height: 72rpx;
  background: #FFF9F0;
  border: 1rpx dashed #FFE58F;
  border-radius: 10rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
  color: #B45309;
}

/* 🏛️ 门店大事记/发展历程：年份分组时间轴，展开/收起动画照抄 pages/journey */
.sp-milestone-title-row {
  justify-content: space-between;
}

.sp-milestone-title-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-left: auto;
}

.sp-btn-toggle-all {
  font-size: 22rpx;
  color: #868E96;
}

.sp-btn-add-milestone {
  font-size: 24rpx;
  color: #8C1D18;
  font-weight: bold;
}

.sp-milestone-groups {
  margin-bottom: 20rpx;
}

.sp-milestone-group {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.sp-milestone-group-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.sp-milestone-group-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #8C1D18;
  flex-shrink: 0;
}

.sp-milestone-group-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
}

.sp-milestone-group-count {
  font-size: 22rpx;
  color: #ADB5BD;
  margin-left: auto;
}

.sp-milestone-group-arrow {
  font-size: 22rpx;
  color: #ADB5BD;
  transition: transform 0.2s ease;
}

.sp-milestone-group-arrow.rotate {
  transform: rotate(180deg);
}

.sp-milestone-items {
  overflow: hidden;
  max-height: 4000rpx;
  opacity: 1;
  transition: max-height 0.35s ease, opacity 0.3s ease;
  padding-left: 6rpx;
}

.sp-milestone-items.collapsed {
  max-height: 0;
  opacity: 0;
}

.sp-milestone-item {
  display: flex;
  gap: 16rpx;
  padding-top: 20rpx;
}

.sp-milestone-item-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 16rpx;
  flex-shrink: 0;
}

.sp-milestone-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #D2691E;
  flex-shrink: 0;
  margin-top: 8rpx;
}

.sp-milestone-line {
  flex: 1;
  width: 2rpx;
  background: #F1F3F5;
  margin-top: 6rpx;
}

.sp-milestone-item:last-child .sp-milestone-line {
  display: none;
}

.sp-milestone-item-body {
  flex: 1;
  padding-bottom: 20rpx;
  border-bottom: 1rpx dashed #F1F3F5;
}

.sp-milestone-item:last-child .sp-milestone-item-body {
  border-bottom: none;
}

.sp-milestone-item-header {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.sp-milestone-date {
  font-size: 22rpx;
  color: #ADB5BD;
  flex-shrink: 0;
}

.sp-milestone-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #212529;
}

.sp-milestone-content {
  display: block;
  font-size: 24rpx;
  color: #495057;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.sp-milestone-img-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.sp-milestone-img {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 8rpx;
  background: #F1F3F5;
}

.sp-milestone-item-actions {
  display: flex;
  gap: 24rpx;
}

.sp-milestone-action-btn {
  font-size: 22rpx;
  color: #868E96;
}

.sp-milestone-action-btn.danger {
  color: #D32F2F;
}

.sp-milestone-empty {
  text-align: center;
  padding: 40rpx 0;
  color: #ADB5BD;
  font-size: 24rpx;
}

/* 大事记新增/编辑弹窗 */
.sp-modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.sp-modal-card {
  width: 88%;
  max-width: 680rpx;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.sp-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F1F3F5;
  margin-bottom: 16rpx;
}

.sp-modal-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #212529;
}

.sp-modal-close {
  font-size: 32rpx;
  color: #ADB5BD;
}

.sp-modal-scroll {
  max-height: 60vh;
}

.sp-form-label {
  display: block;
  font-size: 22rpx;
  color: #868E96;
  margin-bottom: 10rpx;
}

.sp-modal-input {
  height: 72rpx;
  line-height: 72rpx;
  background: #F8F9FA;
  border: 1rpx solid #CED4DA;
  border-radius: 10rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  color: #212529;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.sp-modal-textarea {
  background: #F8F9FA;
  border: 1rpx solid #CED4DA;
  border-radius: 10rpx;
  min-height: 120rpx;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  color: #212529;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.sp-milestone-img-edit-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.sp-milestone-img-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
}

.sp-milestone-img-wrap .sp-milestone-img {
  width: 100%;
  height: 100%;
}

.sp-milestone-img-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  border-radius: 50%;
  font-size: 20rpx;
}

.sp-milestone-img-add {
  width: 100%;
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F8F9FA;
  border: 1rpx dashed #CED4DA;
  border-radius: 8rpx;
  font-size: 40rpx;
  color: #ADB5BD;
}

.sp-modal-footer {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
