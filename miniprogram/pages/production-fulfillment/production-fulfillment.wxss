.pf-page {
  min-height: 100vh;
  background: #F8F5F0;
}

.pf-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  height: 88rpx;
  background: #8C1D18;
}

.pf-nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.pf-nav-back-hover {
  opacity: 0.5;
}

.pf-nav-title {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
}

.pf-nav-placeholder {
  width: 64rpx;
  flex-shrink: 0;
}

.pf-body {
  padding: 24rpx;
  box-sizing: border-box;
}

.pf-loading-state,
.pf-error-state,
.pf-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: #8E8E93;
  font-size: 28rpx;
}

.pf-error-icon,
.pf-empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.pf-error-text,
.pf-empty-text {
  margin-bottom: 24rpx;
  text-align: center;
}

.pf-retry-btn {
  font-size: 28rpx;
  background: #8C1D18;
  color: #FFFFFF;
  padding: 0 40rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
}

.pf-list {
  height: calc(100vh - 200rpx);
}

.pf-order-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.pf-order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.pf-order-product {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.pf-order-status {
  font-size: 22rpx;
  color: #8C1D18;
  background: rgba(140, 29, 24, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.pf-order-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.pf-order-label {
  font-size: 26rpx;
  color: #8E8E93;
}

.pf-order-value {
  font-size: 26rpx;
  color: #1C1C1E;
}

.pf-ship-btn {
  margin-top: 20rpx;
  font-size: 28rpx;
  background: #8C1D18;
  color: #FFFFFF;
  line-height: 76rpx;
  border-radius: 12rpx;
}

.pf-ship-btn[disabled] {
  background: #D8CFC7;
  color: #FFFFFF;
}
