<view class="wj-page">

  <view class="wj-nav-bar" style="padding-top: {{navTop}}px;">
    <view class="wj-nav-back" hover-class="wj-nav-back-hover" bindtap="goBack">←</view>
    <text class="wj-nav-title">🤝 加入产销工坊</text>
    <view class="wj-nav-placeholder"></view>
  </view>

  <view class="wj-body" style="margin-top: {{contentTop}}px;">

    <view class="wj-input-card" wx:if="{{!peekResult}}">
      <text class="wj-input-label">工坊邀请码</text>
      <input
        class="wj-input"
        placeholder="请输入 6 位邀请码"
        value="{{code}}"
        bindinput="onCodeInput"
        maxlength="6"
      />
      <button class="wj-primary-btn" loading="{{peeking}}" bindtap="onTapPeek">查询邀请码</button>
      <text class="wj-error-text" wx:if="{{peekError}}">{{peekError}}</text>
    </view>

    <view class="wj-confirm-card" wx:else>
      <view class="wj-confirm-summary">
        <text class="wj-confirm-icon">📦</text>
        <text class="wj-confirm-title">即将加入</text>
        <text class="wj-confirm-tenant">{{peekResult.tenantName}}</text>
        <text class="wj-confirm-role">担任「{{peekResult.roleLabel}}」</text>
      </view>

      <view class="wj-form-row">
        <text class="wj-input-label">真实姓名</text>
        <input class="wj-input" placeholder="用于档案备注" value="{{realName}}" bindinput="onRealNameInput" />
      </view>
      <view class="wj-form-row">
        <text class="wj-input-label">联系电话（选填）</text>
        <input class="wj-input" placeholder="选填" value="{{phone}}" bindinput="onPhoneInput" type="number" />
      </view>

      <button class="wj-primary-btn" loading="{{submitting}}" bindtap="onConfirmJoin">确认加入</button>
      <button class="wj-secondary-btn" bindtap="goBack">取消</button>
    </view>

  </view>

</view>
