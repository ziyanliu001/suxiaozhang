.wj-page {
  min-height: 100vh;
  background: #F8F5F0;
}

.wj-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  height: 88rpx;
  background: #8C1D18;
}

.wj-nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.wj-nav-back-hover {
  opacity: 0.5;
}

.wj-nav-title {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
}

.wj-nav-placeholder {
  width: 64rpx;
  flex-shrink: 0;
}

.wj-body {
  padding: 24rpx;
  box-sizing: border-box;
}

.wj-input-card,
.wj-confirm-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.wj-input-label {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
  margin-bottom: 12rpx;
}

.wj-input {
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid #E5DED4;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 32rpx;
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
}

.wj-form-row {
  margin-bottom: 8rpx;
}

.wj-primary-btn {
  background: #8C1D18;
  color: #FFFFFF;
  font-size: 30rpx;
  line-height: 84rpx;
  border-radius: 12rpx;
  margin-top: 8rpx;
}

.wj-secondary-btn {
  background: #F0EBE3;
  color: #8E8E93;
  font-size: 28rpx;
  line-height: 76rpx;
  border-radius: 12rpx;
  margin-top: 16rpx;
}

.wj-error-text {
  display: block;
  color: #C0392B;
  font-size: 24rpx;
  margin-top: 16rpx;
  text-align: center;
}

.wj-confirm-summary {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 40rpx;
}

.wj-confirm-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.wj-confirm-title {
  font-size: 24rpx;
  color: #8E8E93;
}

.wj-confirm-tenant {
  font-size: 36rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin: 8rpx 0;
}

.wj-confirm-role {
  font-size: 26rpx;
  color: #8C1D18;
  background: rgba(140, 29, 24, 0.08);
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
}
