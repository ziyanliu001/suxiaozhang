.al-page {
  min-height: 100vh;
  background: #F8F5F0;
}

.al-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  height: 88rpx;
  background: #8C1D18;
}

.al-nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.al-nav-back-hover {
  opacity: 0.5;
}

.al-nav-title {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
}

.al-nav-action {
  color: #FFFFFF;
  font-size: 26rpx;
  width: 110rpx;
  text-align: right;
}

.al-nav-action.hidden {
  visibility: hidden;
}

.al-list-scroll {
  height: calc(100vh - 88rpx);
  box-sizing: border-box;
  padding: 20rpx 24rpx;
}

.al-store-tip {
  font-size: 24rpx;
  color: #8C1D18;
  margin-bottom: 16rpx;
}

/* ===== 📌 今日大事记（顶部高亮区） ===== */
.al-section-divider {
  display: flex;
  align-items: center;
  margin: 8rpx 4rpx 16rpx 4rpx;
}

.al-divider-icon {
  font-size: 20rpx;
  margin-right: 8rpx;
}

.al-divider-txt {
  font-size: 28rpx;
  font-weight: bold;
  color: #8C1D18;
}

.al-divider-date {
  font-size: 22rpx;
  color: #A67558;
  margin-left: 12rpx;
}

.al-today-card {
  background: linear-gradient(135deg, #FFFDFB 0%, #FFF8F0 100%);
  border: 1.5rpx solid #FFD3BE;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(140, 29, 24, 0.06);
}

.al-today-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.al-today-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.al-today-empty-txt {
  color: #999999;
  font-weight: normal;
}

.al-btn-today-edit {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: bold;
  color: #FFFFFF;
  background: #8C1D18;
  border-radius: 30rpx;
  padding: 12rpx 18rpx;
  line-height: 1.4;
  margin: 0;
}

.al-btn-today-edit::after {
  border: none;
}

/* 🌟 发布冲突提示：今日已存在记录时，展示发布人与时间，弱化视觉不抢主标题 */
.al-publish-meta {
  display: block;
  font-size: 20rpx;
  color: #999999;
  margin-top: -8rpx;
  margin-bottom: 8rpx;
}

.al-today-content {
  display: block;
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

/* ===== 时间轴 ===== */
.al-timeline-item {
  display: flex;
}

.al-timeline-dot-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 40rpx;
  flex-shrink: 0;
}

.al-timeline-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #8C1D18;
  margin-top: 30rpx;
  flex-shrink: 0;
}

.al-timeline-line {
  flex: 1;
  width: 2rpx;
  background: #EFE6D8;
  margin-top: 6rpx;
}

.al-timeline-item:last-child .al-timeline-line {
  display: none;
}

.al-timeline-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 0 0 24rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(140, 29, 24, 0.06);
}

.al-card-header-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.al-card-header-left {
  flex: 1;
  min-width: 0;
}

.al-card-time {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.al-card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

/* 🙋 发布者身份行：角色 Badge + 精确发布时间，紧贴标题下方 */
.al-card-publisher-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.al-card-publisher-badge {
  font-size: 20rpx;
  font-weight: 600;
  color: #8C1D18;
  background: #FFF3E0;
  border-radius: 16rpx;
  padding: 4rpx 14rpx;
}

.al-card-publisher-time {
  font-size: 20rpx;
  color: #999999;
}

/* ✏️🗑️ 编辑/删除操作行：与下方 al-card-footer 的"导出活动海报"分开一行，
   避免互相挤压。编辑用淡灰底表示常规操作，删除用淡红底表示危险操作，
   两者视觉上一眼可区分 */
.al-card-actions-row {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.al-btn-card-edit {
  flex: 1;
  font-size: 22rpx;
  font-weight: bold;
  color: #495057;
  background: #F1F3F5;
  border: 1.5rpx solid #E1E4E8;
  border-radius: 24rpx;
  padding: 10rpx 0;
  line-height: 1.4;
  margin: 0;
}

.al-btn-card-edit::after {
  border: none;
}

.al-btn-card-delete {
  flex: 1;
  font-size: 22rpx;
  font-weight: bold;
  color: #C0392B;
  background: #FFF0F0;
  border: 1.5rpx solid #FFD3D3;
  border-radius: 24rpx;
  padding: 10rpx 0;
  line-height: 1.4;
  margin: 0;
}

.al-btn-card-delete::after {
  border: none;
}

.al-thumb-9grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.al-thumb-grid-item {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  border-radius: 12rpx;
  overflow: hidden;
  background: #F0F0F0;
}

.al-thumb-grid-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 🛡️ 缩略图加载失败兜底：<image> binderror 时切换成这个占位块，而不是放任小程序
   原生裂图图标晾在原地；点击可重试，覆盖今日动态/历史动态/编辑表单三处图片网格 */
.thumb-load-failed {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border-radius: 12rpx;
  background: #F5F5F5;
  border: 1.5rpx dashed #D9D9D9;
}

.thumb-load-failed-icon {
  font-size: 28rpx;
  line-height: 1;
}

.thumb-load-failed-text {
  font-size: 18rpx;
  color: #999999;
}

.al-card-content {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
}

.al-card-footer {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0EAE2;
}

.al-btn-export-poster {
  font-size: 24rpx;
  font-weight: bold;
  color: #8C1D18;
  background: #FFF5F0;
  border: 1.5rpx solid #FFD3BE;
  border-radius: 32rpx;
  padding: 12rpx 0;
  line-height: 1.4;
  margin: 0;
}

.al-btn-export-poster::after {
  border: none;
}

/* ⏳ 待确认的义工投稿：暖金描边区分于下方公开时间轴的白卡，强调"还没生效" */
.al-pending-card {
  background: #FFFDF5;
  border: 1.5rpx solid #F0DFA6;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.al-pending-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.al-pending-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.al-pending-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #999999;
}

.al-pending-meta {
  display: block;
  font-size: 22rpx;
  color: #B8860B;
  margin-bottom: 12rpx;
}

.al-pending-content {
  display: block;
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.al-pending-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.al-btn-pending-reject {
  flex: 1;
  font-size: 24rpx;
  color: #999999;
  background: #F5F5F5;
  border: 1.5rpx solid #E0E0E0;
  border-radius: 32rpx;
  padding: 12rpx 0;
  line-height: 1.4;
  margin: 0;
}

.al-btn-pending-reject::after {
  border: none;
}

.al-btn-pending-approve {
  flex: 1;
  font-size: 24rpx;
  font-weight: bold;
  color: #FFFFFF;
  background: linear-gradient(135deg, #B8860B 0%, #DAA520 100%);
  border-radius: 32rpx;
  padding: 12rpx 0;
  line-height: 1.4;
  margin: 0;
}

.al-btn-pending-approve::after {
  border: none;
}

.al-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.al-empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.al-empty-text {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 24rpx;
}

.al-empty-btn {
  background: #8C1D18;
  color: #FFFFFF;
  font-size: 26rpx;
  padding: 0 40rpx;
}

.al-loading-more,
.al-no-more {
  text-align: center;
  padding: 24rpx 0;
  font-size: 22rpx;
  color: #999999;
}

.al-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.al-detail-box,
.al-edit-box {
  width: 100%;
  max-height: 85vh;
  background: #FFFFFF;
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  padding: 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.al-detail-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-bottom: 12rpx;
}

.al-detail-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  flex: 1;
  padding-right: 20rpx;
}

.al-detail-close {
  font-size: 32rpx;
  color: #999999;
}

.al-detail-time {
  font-size: 22rpx;
  color: #999999;
  display: block;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #EFE6D8;
  margin-bottom: 20rpx;
}

.al-detail-scroll {
  max-height: 56vh;
}

.al-detail-images {
  margin-bottom: 20rpx;
}

.al-detail-img {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.al-detail-content {
  font-size: 28rpx;
  color: #444444;
  line-height: 1.8;
  white-space: pre-wrap;
}

.al-detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #EFE6D8;
}

.al-btn-edit,
.al-btn-delete {
  flex: 1;
  font-size: 26rpx;
}

.al-btn-edit {
  background: #F8F5F0;
  color: #8C1D18;
}

.al-btn-delete {
  background: #FBE9E7;
  color: #C62828;
}

.al-edit-scroll {
  max-height: 62vh;
}

.al-form-label {
  display: block;
  font-size: 24rpx;
  color: #666666;
  font-weight: bold;
  margin-bottom: 12rpx;
  margin-top: 20rpx;
}

.al-form-input,
.al-form-picker,
.al-form-textarea {
  background: #F8F9FA;
  border: 1.5rpx solid #EFE6D8;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  color: #333333;
  box-sizing: border-box;
  width: 100%;
}

.al-form-textarea {
  min-height: 160rpx;
}

/* 🐛 修复原生 input 的 placeholder 文字下半部分被截断的问题：单独拆出固定 height，
   并让 line-height 与 height 完全一致，垂直方向只靠行高居中，不再叠加上下 padding
   （padding 与等值 line-height 同时存在会挤压出的行高超出内容区，导致文字被裁切） */
.al-form-input {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
}

/* 占位符专属样式：字号与 input 实际文字字号保持一致，避免字号不一致导致的视觉垂直偏移 */
.al-input-placeholder {
  font-size: 26rpx;
  line-height: 80rpx;
  color: #999999;
}

/* 微信标准双九宫格：每行固定 3 列，18 张自动换行成 6 行；与 daily-menu 的展示态/编辑态
   同款 CSS Grid + padding-bottom 撑正方形写法保持一致 */
.al-image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.al-image-item {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  border-radius: 12rpx;
  overflow: visible;
}

.al-image-thumb {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background: #F0F0F0;
}

.al-image-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: #E03131;
  color: #FFFFFF;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: bold;
  box-shadow: 0 2rpx 6rpx rgba(224, 49, 49, 0.4);
  z-index: 1;
}

.al-image-add {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1.5rpx dashed #C9B8A0;
  border-radius: 12rpx;
}

.al-image-add text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 22rpx;
  color: #999999;
  white-space: nowrap;
}

.al-submit-btn {
  background: #8C1D18;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  margin-top: 24rpx;
}

/* ===== 📤 活动海报导出弹窗 ===== */
.al-poster-box {
  width: 100%;
  max-height: 90vh;
  background: #FFFFFF;
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  padding: 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.al-poster-canvas-wrapper {
  display: flex;
  justify-content: center;
  margin: 12rpx 0 20rpx 0;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.al-poster-canvas {
  background: #FFFFFF;
}

.al-poster-actions {
  width: 100%;
  display: flex;
  gap: 16rpx;
}

.al-btn-poster-save,
.al-btn-poster-share {
  flex: 1;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 36rpx;
  padding: 16rpx 0;
  line-height: 1.4;
}

.al-btn-poster-save {
  background: #FFFFFF;
  color: #8C1D18;
  border: 1.5rpx solid #8C1D18;
}

.al-btn-poster-share {
  background: #8C1D18;
  color: #FFFFFF;
}
