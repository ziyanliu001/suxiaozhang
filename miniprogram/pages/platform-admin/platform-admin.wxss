.pa-page {
  min-height: 100vh;
  background: #F4F5F7;
}

.pa-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  height: 88rpx;
  background: #1C2530;
}

.pa-nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.pa-nav-back-hover {
  opacity: 0.5;
}

/* 🌟 通用点击反馈：本页此前大部分按钮完全没有 hover-class，点击手感生硬——
   统一补上这一条，与 .pa-nav-back-hover 同一套"轻微变暗"语言 */
.btn-hover {
  opacity: 0.7;
}

.pa-nav-title {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
}

.pa-nav-placeholder {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.pa-loading-state,
.pa-denied-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  text-align: center;
}

.pa-denied-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.pa-denied-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

.pa-denied-sub {
  font-size: 26rpx;
  color: #888888;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

/* 🐛 加固：此前完全依赖原生 <button> 默认内边距/行高，这里显式 flex 居中 +
   box-sizing/margin/line-height 归零，与本页其余按钮统一 */
.pa-denied-btn {
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  padding: 0 48rpx;
  margin: 0;
  line-height: 1;
  background: #1C2530;
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 38rpx;
}

.pa-denied-btn::after {
  border: none;
}

.pa-content {
  height: calc(100vh - 88rpx);
  box-sizing: border-box;
  padding: 24rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.pa-overview-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.pa-overview-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pa-ov-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #1C2530;
}

.pa-ov-label {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}

.pa-soon-expire-box {
  background: #FFF3E0;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.pa-soon-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #E65100;
  margin-bottom: 8rpx;
  display: block;
}

.pa-soon-item {
  font-size: 24rpx;
  color: #BF6000;
  display: block;
  padding: 4rpx 0;
}

.pa-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.pa-section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.pa-btn-create {
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  padding: 0 24rpx;
  margin: 0;
  line-height: 1;
  font-size: 24rpx;
  background: #1C2530;
  color: #FFFFFF;
  border-radius: 30rpx;
}

.pa-btn-create::after {
  border: none;
}

.pa-create-form,
.pa-tenant-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.pa-input {
  background: #F4F5F7;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}

.pa-textarea {
  background: #F4F5F7;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 26rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 120rpx;
  margin-bottom: 16rpx;
}

.pa-btn-submit {
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 1;
  border-radius: 38rpx;
  background: #1C2530;
  color: #FFFFFF;
  font-size: 28rpx;
}

.pa-btn-submit::after {
  border: none;
}

.pa-tenant-empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999999;
  font-size: 26rpx;
}

.pa-tenant-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.pa-tenant-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.pa-tenant-status {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  color: #FFFFFF;
  background: #999999;
}

.pa-status-active {
  background: #2E7D32;
}

.pa-status-trial {
  background: #F9A825;
}

.pa-status-suspended,
.pa-status-expired {
  background: #C62828;
}

.pa-tenant-row {
  display: block;
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 6rpx;
}

.pa-tenant-id {
  color: #BBBBBB;
  font-size: 20rpx;
}

/* 🎨 套餐 Tag：免费版灰色/专业版金色/旗舰版深色，即将到期橙色警告——
   与机构自身运营状态的 .pa-status-* 色系区分开，这是订阅套餐维度的标签 */
.pa-tenant-plan-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.pa-plan-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: bold;
}

.pa-plan-badge-basic {
  background: #EDEFF2;
  color: #6B7280;
}

.pa-plan-badge-pro {
  background: #FFF3E0;
  color: #B8860B;
}

.pa-plan-badge-enterprise {
  background: #1C2530;
  color: #FFD700;
}

.pa-plan-badge-expiring {
  background: #FFF3E0;
  color: #E8590C;
}

.pa-expire-text {
  display: inline;
  margin-bottom: 0;
}

.pa-tenant-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.pa-btn-small {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 1;
  border-radius: 32rpx;
  font-size: 24rpx;
  background: #EDEFF2;
  color: #333333;
}

.pa-btn-small::after {
  border: none;
}

.pa-btn-warn {
  background: #FBE9E7;
  color: #C62828;
}

/* 🌸 授权码生成/分发：过渡收入手段——见 platform-admin.ts data 声明处注释 */
.pa-generated-box {
  background: #FFF8E1;
  border: 2rpx solid #FFD54F;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.pa-generated-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.pa-generated-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #8D6E00;
}

.pa-generated-copy-all {
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  border-radius: 26rpx;
  background: #1C2530;
  color: #FFFFFF;
  font-size: 22rpx;
}

.pa-generated-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 10rpx;
}

.pa-generated-row:last-child {
  margin-bottom: 0;
}

.pa-generated-code {
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
  letter-spacing: 1rpx;
}

.pa-generated-meta {
  font-size: 20rpx;
  color: #999999;
}

.pa-codes-filter-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.pa-codes-filter-tab {
  flex: 1;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  font-size: 24rpx;
  background: #EDEFF2;
  color: #666666;
}

.pa-codes-filter-tab.active {
  background: #1C2530;
  color: #FFFFFF;
  font-weight: bold;
}

.pa-code-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.pa-code-row-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.pa-code-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  letter-spacing: 1rpx;
}

.pa-code-status {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  color: #FFFFFF;
}

.pa-code-status-UNUSED {
  background: #2E7D32;
}

.pa-code-status-USED {
  background: #999999;
}

.pa-code-row-bottom {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.pa-code-inline-row {
  margin-bottom: 0;
}

.pa-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pa-modal-box {
  width: 600rpx;
  max-height: 80vh;
  overflow-y: auto;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.pa-modal-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 24rpx;
}

.pa-plan-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.pa-plan-tag {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  padding: 16rpx 0;
  background: #F4F5F7;
  border-radius: 10rpx;
  color: #666666;
}

.pa-plan-tag.active {
  background: #1C2530;
  color: #FFFFFF;
}

.pa-field-label {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.pa-modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.pa-btn-cancel {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 1;
  border-radius: 38rpx;
  font-size: 28rpx;
  background: #EDEFF2;
  color: #333333;
}

.pa-btn-cancel::after {
  border: none;
}

.pa-modal-actions .pa-btn-submit {
  flex: 1;
}
