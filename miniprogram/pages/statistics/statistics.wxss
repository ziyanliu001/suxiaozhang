page {
  background-color: #f7f8fa;
}

.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #f7f8fa;
}

.nav-title {
  display: block;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #323233;
  padding: 16rpx 0;
  line-height: 48rpx;
}

.top-section {
  padding: 0 24rpx;
  background-color: #f7f8fa;
}

.tab-bar {
  display: flex;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  position: relative;
  transition: all 0.3s;
}

.tab-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.tab-text {
  font-size: 28rpx;
  color: #969799;
  font-weight: 400;
  white-space: nowrap;
}

.tab-item.active .tab-text {
  color: #f59e0b;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 8rpx;
  width: 48rpx;
  height: 8rpx;
  background: linear-gradient(90deg, #f59e0b 0%, #d97706 100%);
  border-radius: 4rpx;
}

.custom-date-picker {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.date-btn {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background-color: #f7f8fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #323233;
}

.date-separator {
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #969799;
}

.btn-query {
  width: 100%;
  background-color: #f59e0b;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 12rpx;
  padding: 24rpx;
  border: none;
}

.content-section {
  flex: 1;
  overflow: hidden;
  padding: 24rpx;
  padding-top: 16rpx;
}

.stats-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.stats-header {
  margin-bottom: 32rpx;
}

.stats-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #323233;
  display: block;
  margin-bottom: 8rpx;
}

.stats-date {
  font-size: 24rpx;
  color: #969799;
}

.net-balance-card {
  background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 100%);
  border-radius: 16rpx;
  padding: 40rpx;
  text-align: center;
  margin-bottom: 32rpx;
}

.net-balance-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.net-balance-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.stats-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  background-color: #f7f8fa;
  border-radius: 16rpx;
}

.stat-item:not(:last-child) {
  margin-right: 20rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.stat-item.income .stat-value {
  color: #4CAF50;
}

.stat-item.expense .stat-value {
  color: #E53935;
}

.stat-label {
  font-size: 26rpx;
  color: #969799;
}

.summary-section {
  background-color: #f7f8fa;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 32rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
}

.summary-label {
  font-size: 28rpx;
  color: #646566;
}

.summary-value {
  font-size: 28rpx;
  color: #323233;
  font-weight: bold;
}

.progress-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #323233;
  margin-bottom: 20rpx;
  display: block;
}

.progress-bar {
  height: 28rpx;
  background-color: #f0f0f0;
  border-radius: 14rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 14rpx;
  transition: width 0.5s ease;
}

.progress-fill.normal {
  background-color: #4CAF50;
}

.progress-fill.warning {
  background-color: #E53935;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.progress-text {
  font-size: 26rpx;
  color: #646566;
}

.progress-alert {
  font-size: 24rpx;
  color: #E53935;
  flex-shrink: 0;
}

.income-breakdown {
  background-color: #f7f8fa;
  border-radius: 16rpx;
  padding: 20rpx;
}

.breakdown-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
}

.breakdown-row:not(:last-child) {
  border-bottom: 2rpx solid #eee;
}

.breakdown-label {
  font-size: 28rpx;
  color: #646566;
}

.breakdown-value {
  font-size: 28rpx;
  color: #323233;
  font-weight: bold;
}

.daily-list {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.daily-item {
  display: flex;
  padding: 24rpx 0;
}

.daily-item:not(:last-child) {
  border-bottom: 2rpx solid #f0f0f0;
}

.daily-date {
  width: 160rpx;
  font-size: 26rpx;
  color: #969799;
  flex-shrink: 0;
}

.daily-details {
  flex: 1;
}

.daily-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}

.detail-label {
  font-size: 24rpx;
  color: #646566;
}

.detail-value {
  font-size: 24rpx;
  font-weight: bold;
}

.detail-value.income {
  color: #4CAF50;
}

.detail-value.expense {
  color: #E53935;
}

.detail-value.balance {
  color: #323233;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #323233;
  font-weight: 500;
  margin-top: 24rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #969799;
  margin-top: 12rpx;
}

.btn-back-home {
  width: 320rpx;
  font-size: 28rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  margin-top: 40rpx;
  background-color: #fff;
  border: 2rpx solid #f59e0b;
  color: #f59e0b;
  padding: 0;
}

.btn-hover {
  opacity: 0.8;
}