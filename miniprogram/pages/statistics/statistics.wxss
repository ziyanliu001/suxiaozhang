/* ===== 🌟 超管专属高阶治理面板 ===== */
/* ─── 👵 义工与用餐服务数据看板（原"全国长者关怀总力场"）──────────────
   深色科技 Hero Banner + 浅色分组网格两段式结构。Hero 用深蓝渐变+极简
   SVG 图标做出"数据大屏聚光灯"质感，分组网格延续页面其余卡片的浅色语言，
   两段之间用统一圆角/间距过渡，避免深浅切换显得突兀 ────────────────── */
.care-board {
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.10);
}

/* Hero Banner：深蓝渐变底 + 细网格纹理，两大核心 KPI 高亮展示 */
.cb-hero {
  position: relative;
  background: linear-gradient(135deg, #0F172A 0%, #1E293B 60%, #0C4A6E 100%);
  padding: 28rpx 24rpx 24rpx;
  overflow: hidden;
}

/* 极轻的科技网格纹理，纯 CSS 渐变实现，不引入任何图片资源 */
.cb-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.05) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255,255,255,0.05) 1rpx, transparent 1rpx);
  background-size: 48rpx 48rpx;
  pointer-events: none;
}

.cb-hero-top {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.cb-hero-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.cb-hero-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #F1F5F9;
  letter-spacing: 0.5rpx;
}

/* "数据自动计算"状态提示：替代原编辑表单里的"复用昨日"按钮——本卡片是
   全国口径只读汇总，没有可编辑的"昨日数据"可复用，用状态徽标说明这些
   数字是系统自动算出来的，不是任何人手填的 */
.cb-hero-badge {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(56, 189, 248, 0.14);
  border: 1rpx solid rgba(56, 189, 248, 0.30);
  border-radius: 100rpx;
  padding: 6rpx 16rpx 6rpx 12rpx;
}

.cb-hero-badge-text {
  font-size: 20rpx;
  color: #7DD3FC;
  font-weight: 500;
}

.cb-hero-kpis {
  position: relative;
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.cb-hero-kpi {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.cb-hero-kpi-val {
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.cb-hero-kpi-hot .cb-hero-kpi-val {
  color: #FB7185;
  text-shadow: 0 0 24rpx rgba(251, 113, 133, 0.45);
}

.cb-hero-kpi-warm .cb-hero-kpi-val {
  color: #FB923C;
  text-shadow: 0 0 24rpx rgba(251, 146, 60, 0.45);
}

.cb-hero-kpi-lbl {
  font-size: 24rpx;
