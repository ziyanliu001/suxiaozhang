.people-ratio-seg.seg-party     { background: #D9363E; }
.people-ratio-seg.seg-volunteer { background: #2B8A3E; }
.people-ratio-seg.seg-elderly   { background: #1971C2; }
.people-ratio-seg.seg-other     { background: #ADB5BD; }

.people-ratio-legend {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.people-legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.dot-legend-party     { background: #D9363E; }
.dot-legend-volunteer { background: #2B8A3E; }
.dot-legend-elderly   { background: #1971C2; }
.dot-legend-other     { background: #ADB5BD; }

.detail-items-list {
