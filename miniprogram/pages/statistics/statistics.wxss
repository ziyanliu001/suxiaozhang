/* 🆕 空状态防呆优化：顶部补一条暖金渐变强调条 + 图标改成柔和底色圆形徽标，
   与新增的"一键切换至全国总览"金色 CTA 按钮呼应，弱化"数据不存在=出错了"的
   焦虑感，强调这只是一个可以立刻被引导走出去的中间态 */
.smart-empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 72rpx 40rpx 56rpx;
  margin: 32rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border-top: 6rpx solid;
  border-image: linear-gradient(90deg, #B8860B 0%, #DAA520 50%, #F1C40F 100%) 1;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.empty-icon {
  display: block;
  width: 128rpx;
  height: 128rpx;
  line-height: 128rpx;
  font-size: 64rpx;
  text-align: center;
  background: #FFF8E8;
  border-radius: 50%;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 28rpx;
  color: #495057;
  font-weight: 500;
  text-align: center;
  margin-bottom: 32rpx;
}

/* 🌟 精简空状态文案与按钮：不再用黄色卡片框包裹建议文本，扁平直陈即可 */
.empty-suggest-text {
  display: block;
  font-size: 24rpx;
  color: #868E96;
  text-align: center;
  margin-bottom: 20rpx;
}

.empty-action-group {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 统一主操作按钮：扁平圆角 + 页面主色调（呼应周期 Tab 的 active 橙色），
   替代此前 .btn-primary-action(实心橙) / .btn-secondary-action(灰边框) 两套不一致的样式 */
.btn-empty-action {
  background: #FF922B;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 40rpx;
  padding: 12rpx 36rpx;
  border: none;
  margin-bottom: 16rpx;
}

.btn-empty-action::after {
  border: none;
}

/* 次要操作：扁平文字链接，弱化视觉但仍保持同色系 */
.btn-empty-secondary {
  font-size: 26rpx;
  color: #FF922B;
  padding: 0;
  background: none;
  border: none;
}

