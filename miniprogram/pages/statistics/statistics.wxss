}

/* 顶部 4 大核心指标：2x2 精致高光卡片——每个指标独立成卡（暖色微渐变底 +
   微阴影 + 16rpx 圆角），替代此前 4 个格子共享一张平铺白底、只靠文字本身
   撑视觉的写法 */
.overview-kpi-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.overview-kpi-cell {
  box-sizing: border-box;
  text-align: center;
  padding: 24rpx 12rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(140, 29, 24, 0.06), rgba(230, 162, 60, 0.08));
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.overview-kpi-val {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #8C1D18;
  line-height: 1.2;
}

.overview-kpi-masked {
  color: #C9A9A7;
  letter-spacing: 4rpx;
}

.overview-kpi-lbl {
  display: block;
  font-size: 22rpx;
  color: #495057;
  margin-top: 4rpx;
}

/* 次级指标行：收支细分/开餐天数/义工到岗——拆成紧凑的次级微卡片网格，
   小字号 + 浅底微阴影，视觉权重明显低于顶部核心指标卡，但不再是裸文字 */
.overview-secondary-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 20rpx;
}

.overview-sec-cell {
  box-sizing: border-box;
  text-align: center;
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
  background: #FAFAFA;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.overview-sec-val {
  display: block;
  font-size: 24rpx;
  font-weight: bold;
  color: #495057;
}

.overview-sec-masked .overview-sec-val {
  color: #CED4DA;
  letter-spacing: 4rpx;
}

.overview-sec-lbl {
  font-size: 20rpx;
  color: #969799;
}

/* 物资消耗：轻量级 4 列小字号微卡片，收拢在底部，不与核心指标抢视觉焦点 */
.overview-materials-row {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.overview-material-cell {
  flex: 1;
  text-align: center;
  background: #F7F8FA;
  border-radius: 16rpx;
  padding: 12rpx 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.overview-material-cell .material-val {
