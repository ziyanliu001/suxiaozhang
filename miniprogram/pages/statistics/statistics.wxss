page {
  background-color: #f7f8fa;
}

.page-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* 🌟 全站统一的卡片基础层与点击态：与 index/journey/profile/notice 等页面的
   .ui-card-wrapper/.ui-hover 同一套数值规范（WXSS 页面级作用域不跨页共享样式，
   这里本地复刻一份）。具体卡片自己的 border-radius/padding/box-shadow 定义在
   本文件更靠后的位置，按 CSS 层叠顺序正常覆盖这里的基础值 */
.ui-card-wrapper {
  width: 100%;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid #F1F3F5;
  box-sizing: border-box;
}

.ui-hover {
  opacity: 0.85;
  transform: scale(0.98);
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #f7f8fa;
  display: flex;
  align-items: center;
  /* 🛡️ 改为 space-between 自由布局：标题与刷新胶囊各自占位，
     不再用 position:absolute 强行贴右覆盖，配合动态 padding-right 避让官方胶囊菜单 */
  justify-content: space-between;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

/* 统一的 Reddit 风格「←」返回按钮：64rpx 方形点击区，居中图标，带轻微点击态反馈 */
.nav-back-arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #323233;
  flex-shrink: 0;
}

.nav-back-arrow-hover {
  opacity: 0.5;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #323233;
  line-height: 48rpx;
}

.nav-refresh-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  background-color: #fff;
  border-radius: 24rpx;
  border: 1rpx solid #e8e8e8;
  flex-shrink: 0;
}

.refresh-icon {
  font-size: 24rpx;
}

.refresh-text {
  font-size: 22rpx;
  color: #666;
}

.admin-switch {
  position: fixed;
  top: 80rpx;
  left: 0;
  right: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 16rpx 32rpx;
  background: linear-gradient(90deg, #f7f8fa 0%, #fff 20%, #fff 80%, #f7f8fa 100%);
  border-bottom: 1rpx solid #eee;
}

.switch-label {
  font-size: 24rpx;
  color: #999;
}

.switch-btn {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  color: #666;
  background-color: #f5f5f5;
  border-radius: 32rpx;
  transition: all 0.3s;
}

.switch-btn.active {
  color: #fff;
  background: linear-gradient(135deg, #B8860B 0%, #DAA520 100%);
}

.content-area {
  padding: 0 24rpx;
  background-color: #f7f8fa;
}

.period-control-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid #F1F3F5;
}

.store-select-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.store-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.store-label .title {
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
}

.store-picker-pill {
  background: #E7F5FF;
  border: 1rpx solid #A5D8FF;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.store-picker-pill.locked {
  background: #FFF9DB;
  border-color: #FFE066;
}

.store-picker-pill .name {
  font-size: 24rpx;
  color: #1C7ED6;
  font-weight: bold;
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 1;
}

.store-picker-pill.locked .name {
  color: #7A4D00;
}

.store-picker-pill .arrow {
  font-size: 20rpx;
  color: #1C7ED6;
}

.store-picker-pill.locked .arrow {
  display: none;
}

.store-picker-pill .lock-icon {
  font-size: 20rpx;
  margin-left: 6rpx;
}

.role-tag-badge {
  font-size: 18rpx;
  background: #FFF3BF;
  color: #D9480E;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 6rpx;
  font-weight: bold;
  flex-shrink: 0;
  white-space: nowrap;
}

/* 大家长：门店胶囊 + 全国看板快捷入口并排布局 */
.patriarch-store-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.national-entry-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: linear-gradient(135deg, #1A56DB 0%, #1E40AF 100%);
  padding: 8rpx 18rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
}

.national-entry-btn-hover {
  opacity: 0.8;
}

.national-entry-icon {
  font-size: 22rpx;
}

/* 🆕 全国大屏顶部横幅：替代单店模式下的"当前统计门店"卡片，见
   statistics.wxml store-select-header-row / national-banner-row 注释 */
.national-banner-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.national-banner-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  flex: 1;
}

.national-banner-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.national-banner-text {
  font-size: 26rpx;
  font-weight: bold;
  color: #1A56DB;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.national-banner-title-col {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

/* 🆕 机构套餐配额微章：轻量文字徽章，不与右侧数据导出/刷新按钮争夺视觉权重 */
.national-quota-badge {
  display: inline-flex;
  align-items: center;
  gap: 2rpx;
  width: fit-content;
  background: #FFF3E0;
  border-radius: 20rpx;
  padding: 2rpx 12rpx;
}

.nqb-text {
  font-size: 18rpx;
  color: #E8590C;
  font-weight: 600;
  white-space: nowrap;
}

.nqb-arrow {
  font-size: 18rpx;
  color: #E8590C;
}

.national-banner-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.national-banner-action-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: #E7F5FF;
  border: 1rpx solid #A5D8FF;
  padding: 8rpx 16rpx;
  border-radius: 30rpx;
}

.national-banner-action-icon {
  font-size: 20rpx;
}

.national-banner-action-text {
  font-size: 22rpx;
  color: #1C7ED6;
  font-weight: bold;
  white-space: nowrap;
}

.national-entry-text {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.national-entry-arrow {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
}

.period-tabs-segment {
  display: flex;
  background: #F1F3F5;
  border-radius: 16rpx;
  padding: 6rpx;
}

.period-tabs-segment .tab-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #495057;
  padding: 12rpx 0;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.period-tabs-segment .tab-item.active {
  background: #FFFFFF;
  color: #D9480E;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.date-picker-subrow {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.picker-pill-btn {
  flex: 1;
  background: #FFF9DB;
  border: 1rpx solid #FFE066;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-pill-btn.small {
  flex: 1;
}

.picker-pill-btn .lbl {
  font-size: 24rpx;
  color: #7A4D00;
  font-weight: bold;
}

.picker-pill-btn .arrow {
  font-size: 20rpx;
  color: #D9480E;
}

.date-separator {
  font-size: 24rpx;
  color: #868E96;
}

/* 🆕 "按地区筛选"弹窗内嵌式下拉：替代原生 <picker>，避免半屏弹窗之上再叠加
   一层系统底部选择器。触发器点击展开一个绝对定位在其正下方的选项面板，不
   影响同排另一个字段（省份/城市）的布局宽度 */
.region-select-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.region-select-field {
  flex: 1;
  position: relative;
}

.region-select-trigger {
  background: #FFF9DB;
  border: 1rpx solid #FFE066;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.region-select-trigger.active {
  border-color: #D9480E;
  background: #FFF3E0;
}

.region-select-trigger .lbl {
  font-size: 24rpx;
  color: #7A4D00;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.region-select-trigger .arrow {
  font-size: 20rpx;
  color: #D9480E;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.region-dropdown-panel {
  position: absolute;
  top: calc(100% + 8rpx);
  left: 0;
  right: 0;
  background: #FFFFFF;
  border: 1rpx solid #E9ECEF;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.16);
  z-index: 20;
  overflow: hidden;
}

.region-dropdown-scroll {
  max-height: 320rpx;
}

.region-dropdown-item {
  padding: 18rpx 24rpx;
  font-size: 26rpx;
  color: #333333;
  border-bottom: 1rpx solid #F1F3F5;
}

.region-dropdown-item:last-child {
  border-bottom: none;
}

.region-dropdown-item.active {
  color: #D9480E;
  font-weight: bold;
  background: #FFF9DB;
}

.btn-custom-query {
  margin-top: 16rpx;
  background: linear-gradient(135deg, #FFE066 0%, #FCC419 100%);
  color: #7A4D00;
  font-weight: bold;
  border-radius: 16rpx;
  font-size: 26rpx;
  padding: 16rpx 0;
  border: none;
}

.btn-custom-query::after {
  border: none;
}

/* 🎨 对齐规范：统一 inline-flex 居中，替代此前依赖 <text> 默认内联渲染 +
   父级 text-align 的隐式对齐，胶囊内容在任何字号/内容长度下都精确垂直居中 */
.cost-badge,
.warning-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.cost-badge.valid {
  color: #2B8A3E;
  font-weight: bold;
  font-size: 24rpx;
}

/* 🌟 去内卷文案：暂无支出/数据为空不该用一个带底色的徽章框强调出来，
   那看起来像"这家店有问题"——改成不带背景框的纯文字，语气更平和 */
.cost-badge.neutral {
  color: #ADB5BD;
  font-size: 22rpx;
  font-weight: normal;
}

/* 🌟 志工视角：单餐成本等运营敏感数据以遮罩形式展示，仅提示"店长可见"而不泄露具体数值 */
.cost-badge.masked {
  color: #ADB5BD;
  background: #F8F9FA;
  border: 1rpx dashed #DEE2E6;
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.warning-pill {
  font-size: 20rpx;
  font-weight: bold;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  white-space: nowrap;
}

.warning-pill.ample {
  background: #E6FCF5;
  color: #0CA678;
}

.warning-pill.warning {
  background: #FFF9DB;
  color: #F59F00;
}

.warning-pill.urgent {
  background: #E03131;
  color: #FFFFFF;
}

/* 🐛 "告急(0天)"误报修复配套样式：无数据时用中性灰徽章，不落入红/绿强色调 */
.warning-pill.nodata {
  background: #F1F3F5;
  color: #868E96;
}

.net-val-group {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.net-sub-tip {
  font-size: 20rpx;
  color: #868E96;
  font-weight: normal;
}

.major-expense-tag {
  font-size: 20rpx;
  color: #E03131;
  background: #FFF5F5;
  border: 1rpx solid #FFC9C9;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  margin-left: 8rpx;
  white-space: nowrap;
}

.fixed-major-row {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #FFC9C9;
  background: #FFFBFB;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.fixed-major-row .major-label {
  font-size: 22rpx;
  color: #E03131;
}

.fixed-major-row .major-val {
  font-size: 24rpx;
  color: #E03131;
  font-weight: bold;
}

.tab-bar {
  display: flex;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  position: relative;
  transition: all 0.3s;
}

.tab-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.tab-text {
  font-size: 28rpx;
  color: #969799;
  font-weight: 400;
  white-space: nowrap;
}

.tab-item.active .tab-text {
  color: #f59e0b;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 8rpx;
  width: 48rpx;
  height: 8rpx;
  background: linear-gradient(90deg, #f59e0b 0%, #d97706 100%);
  border-radius: 4rpx;
}

.custom-date-picker {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.date-btn {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background-color: #f7f8fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #323233;
}

.date-separator {
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #969799;
}

.btn-query {
  width: 100%;
  background-color: #f59e0b;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 12rpx;
  padding: 24rpx;
  border: none;
}

.content-section {
  flex: 1;
  overflow: hidden;
  padding: 24rpx;
  padding-top: 16rpx;
  /* 🛡️ 底部固定按钮 .bottom-sticky-bar 自身高度 128rpx（20+88+20），这里的
     padding-bottom 必须再叠加 env(safe-area-inset-bottom)，否则全面屏机型的
     底部手势条会让最后内容和按钮贴得过近——此前 144rpx 余量偏紧，安卓部分机型
     吸底按钮仍会压住卡片最后一行内容，加大到 160rpx 留足缓冲 */
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom)) !important;
}

.stats-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 40rpx;
}

.health-card {
  border-radius: 24rpx;
  padding: 32rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.health-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.health-icon {
  font-size: 48rpx;
}

.health-title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.health-title {
  font-size: 32rpx;
  font-weight: bold;
}

.health-date {
  font-size: 24rpx;
  opacity: 0.85;
}

.balance-amount {
  text-align: center;
  margin-bottom: 20rpx;
}

.balance-label {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 8rpx;
}

.balance-value {
  font-size: 64rpx;
  font-weight: bold;
  line-height: 1.2;
}

.runway-box {
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.runway-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 4rpx;
}

.runway-days {
  font-size: 36rpx;
  font-weight: bold;
}

.material-pills-row {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-top: 24rpx;
  margin-bottom: 16rpx;
}

.mat-pill-capsule {
  background: rgba(255, 255, 255, 0.92);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.mat-icon {
  font-size: 24rpx;
}

.mat-name {
  font-size: 24rpx;
  font-weight: bold;
  color: #212529;
}

.status-tag-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: bold;
}

.status-tag-pill .dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.status-tag-pill.success {
  background-color: #E6FCF5;
  color: #0CA678 !important;
}

.status-tag-pill.success .dot {
  background-color: #0CA678;
}

.status-tag-pill.warning {
  background-color: #FFF9DB;
  color: #D9480E !important;
}

.status-tag-pill.warning .dot {
  background-color: #D9480E;
}

.status-tag-pill.danger {
  background-color: #FFF5F5;
  color: #E03131 !important;
}

.status-tag-pill.danger .dot {
  background-color: #E03131;
}

.health-tip {
  text-align: center;
  font-size: 26rpx;
  line-height: 1.5;
  opacity: 0.95;
}

.income-expense-card,
.achievement-card,
.daily-list-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  overflow: visible;
}

.card-header {
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #323233;
}

.ie-columns {
  display: flex;
  align-items: stretch;
  margin-bottom: 24rpx;
}

.ie-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.ie-divider {
  width: 2rpx;
  background-color: #f0f0f0;
  margin: 0 16rpx;
}

.ie-label {
  font-size: 26rpx;
  color: #646566;
  margin-bottom: 12rpx;
}

.ie-value {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.ie-value.income {
  color: #4CAF50;
}

.ie-value.expense {
  color: #E53935;
}

.ie-detail {
  width: 100%;
  display: flex;
