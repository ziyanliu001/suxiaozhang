  transition: height 0.3s ease;
}

.trend-bar-count {
  font-size: 20rpx;
  font-weight: bold;
  color: #8C1D18;
  margin-top: 8rpx;
}

.trend-bar-label {
  font-size: 20rpx;
  color: #999999;
  margin-top: 4rpx;
}

/* ===== 🆕 个人爱心海报预览弹窗（与 pages/journey.ts 同款体验：立刻打开 + 加载态 +
   scroll-view max-height，而非 flex:1，避免图片区域塌陷成空白——同一个坑踩过两次，
   这次直接照抄已验证过的定案写法） ===== */
.honor-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.honor-modal-box {
  width: 600rpx;
  max-height: 90vh;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.honor-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.honor-modal-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.honor-modal-close {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.close-x-text {
  font-size: 28rpx;
  color: #999999;
}

.honor-card-scroll {
  max-height: 60vh;
}

.honor-card-image {
  display: block;
  width: 100%;
  border-radius: 16rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}

.honor-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.honor-loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 5rpx solid #F1ECE3;
  border-top-color: #8C1D18;
  border-radius: 50%;
  margin-bottom: 20rpx;
  animation: honor-spin 0.8s linear infinite;
}

@keyframes honor-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.honor-loading-text {
  font-size: 26rpx;
  color: #999999;
}

.honor-modal-hint {
  display: block;
  font-size: 22rpx;
  color: #B5A190;
  text-align: center;
  margin-top: 16rpx;
}

.honor-btn-save {
  width: 100%;
  margin-top: 16rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  font-size: 28rpx;
  font-weight: bold;
  background: #8C1D18;
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(140, 29, 24, 0.3);
}

.honor-btn-save::after {
  border: none;
}

/* 🐛 改用 class 选择器代替 [disabled] 属性选择器——button 的 disabled 状态
   同时驱动 WXML 里的 honor-btn-save-disabled 类名，纯 class 选择器风格与
   本文件其余样式保持一致 */
.honor-btn-save.honor-btn-save-disabled {
  opacity: 0.5;
  box-shadow: none;
}

/* ===== 🆕 财务/家长专属卡片：门店财务与凭证合规大屏 / 资源储备与续航预警 ===== */
.finance-compliance-card,
.patriarch-resource-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.finance-metric-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 16rpx;
}

.finance-metric-cell {
  background: #F8F9FA;
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.finance-metric-val {
  font-size: 34rpx;
  font-weight: bold;
  color: #212529;
}

.finance-metric-cell.green .finance-metric-val {
  color: #2B8A3E;
}

.finance-metric-cell.warn .finance-metric-val {
  color: #D48806;
}

.finance-metric-lbl {
  font-size: 22rpx;
  color: #868E96;
}

.patriarch-loading {
  text-align: center;
  padding: 40rpx 0;
  color: #ADB5BD;
  font-size: 24rpx;
}

.patriarch-resource-tip {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #FFFBE6;
  border: 1rpx solid #FFE58F;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #D48806;
}

.national-poster-btn {
  margin-top: 24rpx;
}

/* 🆕 底部固定操作栏内不再需要这份外边距——按钮已由 .bottom-sticky-bar 的
   flex 布局与 gap 统一对齐，多余的 margin-top 会让海报按钮比报表按钮低一截 */
.national-bottom-bar .national-poster-btn {
  margin-top: 0;
}

/* ===== 🆕 时间周期「◀ 上一期/下一期 ▶」快捷翻页 ===== */
.period-nav-btn {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF9DB;
  border: 1rpx solid #FFE066;
  border-radius: 50%;
  color: #D9480E;
  font-size: 24rpx;
  font-weight: bold;
}

.period-nav-btn-hover {
  opacity: 0.6;
}

.nav-label-pill {
  justify-content: center;
}

/* ===== 🆕 引导型空状态：快捷操作胶囊组（重构自原先的垂直大按钮堆叠） ===== */

/* 水平并排胶囊组：次要操作（切换全国总览 / 切换全部门店 / 查看有数据月份） */
.empty-quick-pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
  width: 100%;
  margin: 0 0 24rpx;
}

/* 胶囊基础样式：轻量灰底圆角，不与主按钮抢视觉权重 */
.btn-quick-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 28rpx;
  background: #F7F8FA;
  color: #495057;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 32rpx;
  border: 1rpx solid #E9ECEF;
  box-sizing: border-box;
  margin: 0;
  line-height: 1;
}

.btn-quick-pill::after {
  border: none;
}

.btn-quick-pill:active {
  background: #E9ECEF;
  opacity: 0.85;
}

/* 金色变体：超管专属「切换全国总览」 */
.btn-quick-pill-gold {
  background: #FFF8E8;
  color: #B8860B;
  border-color: #FFE082;
}

.btn-quick-pill-gold:active {
  background: #FFE9A0;
}

/* 主操作按钮：快捷补报餐报（全宽红色主 CTA，置于胶囊组下方） */
.btn-empty-primary {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  line-height: 1;
  background: linear-gradient(135deg, #C62828 0%, #B71C1C 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 42rpx;
  padding: 0;
  border: none;
  box-sizing: border-box;
  margin: 8rpx 0 0;
  box-shadow: 0 6rpx 16rpx rgba(198, 40, 40, 0.25);
}

.btn-empty-primary::after {
  border: none;
}

.btn-empty-primary:active {
  opacity: 0.88;
  transform: scale(0.98);
}

/* ===== 🆕 2x2 核心经营指标骨架卡：与 statistics 是否有数据解耦，固定渲染 ===== */
.core-metrics-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 🆕 3x2 网格：新增「阳光凭证数」「凭证合规率」两格后从 2 列改为 3 列，
   6 格排成 3 列 2 行，比原来 2 列 4 行更紧凑，不会把卡片拉得过高 */
.core-metrics-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 16rpx;
}

.core-metrics-cell {
  background: #F8F9FA;
  border-radius: 12rpx;
  padding: 16rpx 12rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

/* 🆕 数值 + 单位后缀同一行：总餐次数/服务人次原先是裸数字，加上"次/人次"
   后缀，读数时不必再回看下方标签才知道单位是什么 */
.core-metrics-val-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.core-metrics-val {
  font-size: 34rpx;
  font-weight: 800;
  color: #212529;
  line-height: 1.15;
}

.core-metrics-unit {
  font-size: 22rpx;
  font-weight: 600;
  color: #868E96;
}

.core-metrics-lbl {
  font-size: 22rpx;
  color: #868E96;
}

/* ═══════════════════════════════════════════════════════════════
   🦴 骨架屏：核心经营指标 / 门店人员画像首次加载态共用
   ═══════════════════════════════════════════════════════════════ */
.skel-cell {
  gap: 10rpx !important;
}

.skel-bar {
  border-radius: 8rpx;
  background: linear-gradient(90deg, #EEF0F2 25%, #E4E7EB 37%, #EEF0F2 63%);
  background-size: 400% 100%;
  animation: stat-skel-shimmer 1.6s ease-in-out infinite;
}

.skel-bar-lg {
  width: 64rpx;
  height: 32rpx;
}

.skel-bar-sm {
  width: 96rpx;
  height: 20rpx;
}

.skel-bar-xs {
  width: 72rpx;
  height: 18rpx;
}

@keyframes stat-skel-shimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* ═══════════════════════════════════════════════════════════════
   ☀️ 阳光大盘：Profile「阳光账本核查」/首页「阳光账本」的落地卡片，
   管理视图/个人视图共用同一套样式
   ═══════════════════════════════════════════════════════════════ */
.sunshine-board-card {
  background: linear-gradient(180deg, #FFFBEB 0%, #FFFFFF 120rpx);
  border: 1rpx solid #FFE9A8;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.sunshine-board-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sunshine-info-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(217, 72, 14, 0.08);
  color: #D9480E;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sunshine-board-sub {
  display: block;
  font-size: 22rpx;
  color: #868E96;
  margin-top: 6rpx;
}

.sunshine-board-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 16rpx;
}

.sunshine-board-cell {
  background: #FFFFFF;
  border: 1rpx solid #FFF3CD;
  border-radius: 12rpx;
  padding: 16rpx 12rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.sunshine-board-val {
  font-size: 30rpx;
  font-weight: 800;
  color: #D9480E;
  line-height: 1.15;
}

.sunshine-board-lbl {
  font-size: 22rpx;
  color: #868E96;
}

.sunshine-concept-modal-box {
  width: 640rpx;
}

.sunshine-concept-block {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F1F3F5;
}

.sunshine-concept-block:last-child {
  border-bottom: none;
}

.sunshine-concept-label {
  font-size: 24rpx;
  font-weight: bold;
  color: #D9480E;
}

.sunshine-concept-text {
  font-size: 26rpx;
  color: #495057;
  line-height: 1.6;
}

/* ═══════════════════════════════════════════════════════════════
   📋 账目流水明细：Profile「门店账目明细」（?tab=ledger）的落地区块
   ═══════════════════════════════════════════════════════════════ */
.ledger-list-container {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 🐛 折行截断修复：与 .ledger-card-header 配套（见 statistics.wxml 同处注释）——
   标题 flex-shrink:0 占住自己的宽度，副标题占满剩余空间并单行省略，宽度不够时
   截断成"...16"这类省略号收尾，而不是把最后几个字符硬挤到下一行 */
.ledger-card-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}
.ledger-card-header .card-title {
  flex-shrink: 0;
  font-size: 30rpx;
}

.ledger-list-sub {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #868E96;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ledger-list-loading,
.ledger-list-body {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 🎨 精致化空状态：圆形图标底 + 主/副两级文案，与 .smart-empty-card 同一套
   视觉语言的缩小版（本卡片内嵌，不需要整页那么大的留白） */
.ledger-empty-box {
  margin-top: 16rpx;
  padding: 48rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ledger-empty-icon {
  display: block;
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 44rpx;
  text-align: center;
  background: #F8F9FA;
  border-radius: 50%;
  margin: 16rpx 0 12rpx;
}

.ledger-empty-main {
  font-size: 26rpx;
  color: #495057;
  font-weight: 500;
  text-align: center;
  margin-bottom: 8rpx;
}

.ledger-empty-sub {
  font-size: 22rpx;
  color: #ADB5BD;
  text-align: center;
}

.ledger-list-row {
  background: #F8F9FA;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.ledger-row-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ledger-row-top-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ledger-row-date {
  font-size: 26rpx;
  font-weight: 700;
  color: #212529;
}

/* 🏷️ 分类 Tag：见 buildLedgerRecords 里的 classifyCategory，按当天收支构成
   推断出的展示分类（不是逐笔交易的精确分类） */
.ledger-row-category {
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
}

.ledger-category-meal {
  background: rgba(255, 152, 0, 0.12);
  color: #E67700;
}

.ledger-category-material {
  background: rgba(121, 85, 72, 0.12);
  color: #6D4C41;
}

.ledger-category-donation {
  background: rgba(233, 30, 99, 0.1);
  color: #C2185B;
}

.ledger-category-ops {
  background: rgba(120, 144, 156, 0.12);
  color: #546E7A;
}

.ledger-row-status {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.ledger-status-pending {
  background: rgba(255, 152, 0, 0.12);
  color: #E67700;
}

.ledger-status-approved {
  background: rgba(33, 150, 243, 0.12);
  color: #1971C2;
}

.ledger-status-locked {
  background: rgba(46, 125, 50, 0.12);
  color: #2E7D32;
}

.ledger-row-mid {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.ledger-row-source-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.ledger-row-source {
  font-size: 22rpx;
  color: #868E96;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 160rpx;
}

/* 🧾 凭证 Hook 图标：可点击，见 onPreviewLedgerReceipt——有凭证时唤起大图
   预览，无凭证时给明确提示，不是纯展示性的文字 */
.ledger-row-receipt {
  font-size: 20rpx;
  flex-shrink: 0;
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
}

.ledger-row-receipt.has-receipt {
  color: #495057;
  background: rgba(0, 0, 0, 0.04);
}

.ledger-row-receipt.no-receipt {
  color: #E03131;
  background: rgba(224, 49, 49, 0.08);
}

/* 💰 金额大字高亮：净额是这一行视觉上最重的元素，独占右侧 */
.ledger-row-amount {
  font-size: 32rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.ledger-row-amount.plus {
  color: #2E7D32;
}

.ledger-row-amount.minus {
  color: #C62828;
}

.ledger-row-bottom {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 22rpx;
  padding-top: 6rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.ledger-row-income {
  color: #2E7D32;
}

.ledger-row-expense {
  color: #C62828;
}

.core-metrics-yoy {
  font-size: 20rpx;
  font-weight: bold;
  margin-top: 4rpx;
}

.core-metrics-yoy.up {
  color: #E03131;
}

.core-metrics-yoy.down {
  color: #2B8A3E;
}

.core-metrics-yoy.flat {
  color: #868E96;
}


.btn-primary-poster {
  flex: 1;
  width: auto !important;
}

/* 🐛 按钮 Flex 强制居中："导出当前周期 Excel 账本"——此前 line-height:88rpx 是
   旧版靠行高撑开文字垂直居中的写法，与后来补上的 flex 居中叠加在一起纯属冗余
   （height 也和规范要求的 84rpx 对不上），显式改成 line-height:1 + box-sizing:
   border-box，避免文字/图标出现肉眼可见的基线偏斜 */
.btn-export-shortcut {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  line-height: 1;
  background: #E6FCF5 !important;
  color: #0CA678 !important;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 42rpx;
  border: 1rpx solid #63E6BE;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
}

.btn-export-shortcut::after {
  border: none;
}

.btn-export-shortcut:active {
  opacity: 0.85;
}

/* 🔐 专业版功能拦截弹窗：已收敛为 components/feature-locked-modal 共用组件，
   样式迁移到该组件自己的 .wxss（.flm-* 前缀），这里不再重复维护 */

/* ───────────────────────────────────────────
   📸 全网影像卷宗与阳光凭证面板
   ─────────────────────────────────────────── */
.national-media-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 0 24rpx 24rpx;
  padding: 28rpx 24rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.nm-header {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-bottom: 20rpx;
}

.nm-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A237E;
}

.nm-sub {
  font-size: 24rpx;
  color: #90A4AE;
}

/* 🆕 横向独立卡片组：原先是一整条带竖线分隔的 KPI 行，现改为三张独立小卡片，
   数据分组更清晰，也不必再依赖 .nm-kpi-divider 精确对位 */
.nm-kpi-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

/* 🎨 渐变微底色数据方块：替代原先纯色 #F5F7FF 平底，与页面顶部
   .overview-kpi-cell 同一套暖色微渐变语言呼应，圆角同步升级到 16rpx */
.nm-kpi-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  background: linear-gradient(135deg, rgba(21, 101, 192, 0.06), rgba(140, 29, 24, 0.05));
  border: 1.5rpx solid #E8ECFB;
  border-radius: 16rpx;
  padding: 20rpx 8rpx 16rpx;
}

.nm-kpi-icon {
  font-size: 28rpx;
  line-height: 1;
}

.nm-kpi-val {
  font-size: 36rpx;
  font-weight: 700;
  color: #1565C0;
  line-height: 1.1;
}

.nm-kpi-lbl {
  font-size: 20rpx;
  color: #78909C;
}

/* 底部「档案合计」：暖色胶囊底，优雅收束整块面板 */
.nm-total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFF8E8;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 8rpx;
}

.nm-total-label {
  font-size: 24rpx;
  color: #9C6B0A;
}

.nm-total-val {
  font-size: 30rpx;
  font-weight: 700;
  color: #B8860B;
}

.nm-gallery-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.nm-gallery-title {
  font-size: 26rpx;
  color: #78909C;
}

.nm-gallery-count {
  font-size: 20rpx;
  color: #B0BEC5;
}

.nm-gallery-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -2rpx;
}

.nm-gallery-item {
  position: relative;
  width: calc(33.333% - 4rpx);
  margin: 2rpx;
  padding-top: calc(33.333% - 4rpx);
  overflow: hidden;
  border-radius: 8rpx;
  /* 🆕 shimmer 底色：图片是网络加载的云存储图，加载完成前用扫光动画占位，
     比原来纯灰色块更能提示"正在加载"而非"这里没有内容" */
  background: linear-gradient(90deg, #ECEFF1 25%, #E1E5E8 37%, #ECEFF1 63%);
  background-size: 400% 100%;
  animation: nm-gallery-shimmer 1.6s ease-in-out infinite;
}

@keyframes nm-gallery-shimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* 🆕 触摸反馈：hover-class 在小程序里对应触摸按下态，轻微下沉+提亮，
   让影像墙的可点击性更明确 */
.nm-gallery-item-hover {
  transform: scale(0.96);
  opacity: 0.85;
}

.nm-gallery-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.nm-gallery-img-fallback {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ECEFF1;
  animation: none;
}

.nm-fallback-icon {
  font-size: 32rpx;
  opacity: 0.5;
}

.nm-gallery-tag-row {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 6rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, transparent 100%);
}

.nm-tag {
  font-size: 20rpx;
  flex-shrink: 0;
}

.nm-tag-store {
  font-size: 18rpx;
  color: rgba(255,255,255,0.85);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

/* 🆕 平台徽章：仅"全部平台"视角下渲染，缩略图底部空间很紧，用极小字号+不换行 */
.nm-tag-org {
  font-size: 16rpx;
  color: rgba(255,255,255,0.65);
  flex-shrink: 0;
  white-space: nowrap;
}

.nm-gallery-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 0 28rpx;
  text-align: center;
}

.nm-empty-icon {
  display: block;
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 40rpx;
  text-align: center;
  background: #F5F7FF;
  border-radius: 50%;
  margin-bottom: 16rpx;
}

.nm-empty-text {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #78909C;
  margin-bottom: 8rpx;
}

.nm-empty-sub {
  display: block;
  font-size: 22rpx;
  color: #B0BEC5;
}
