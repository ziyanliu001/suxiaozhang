/* ═══ 🌐 全国爱心网络数据总览：统一白底卡片，替代此前并列的暖黄
   national-macro-kpi-card + 深蓝 national-hero-card 两张视觉不一致的卡片 ═══ */
.national-overview-card {
  padding: 28rpx 24rpx;
}

.overview-header {
  margin-bottom: 24rpx;
}

.overview-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.overview-title {
  font-size: 30rpx;
  font-weight: bold;
