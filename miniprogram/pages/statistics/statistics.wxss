}

.item-left-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  /* 🐛 修复金额贴边/溢出：flex 子项默认 min-width:auto，长事由文字（item-title-text）
     不会自动收缩换行，会把整行撑宽到超出卡片边界，导致右侧金额被挤出可视区域甚至
     裁切——flex:1 让左侧文字区域参与收缩分配剩余空间，min-width:0 解除"不缩小于
     内容宽度"的默认限制，使超长文字改为正常换行而不是撑爆容器 */
  flex: 1;
  min-width: 0;
}

