/* ===== 🆕 个人视角：非管理角色专属护持数据面板 ===== */
.personal-dashboard-container {
  padding: 0 24rpx;
  /* 🐛 修复：原 160rpx 缺失 env(safe-area-inset-bottom)——全面屏设备的
     底部手势条会让最后一张卡被固定吸底的「生成海报」按钮遮住；
     160rpx = 按钮高度(88) + 上下各20内边距 + 约 32rpx 缓冲 */
  padding-bottom: calc(160rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

