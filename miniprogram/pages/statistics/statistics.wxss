.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
  padding-bottom: 100rpx;
}

.header {
  text-align: center;
  padding: 30rpx 0;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
}

.tab-bar {
  display: flex;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #666;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background-color: #f59e0b;
  color: #fff;
}

.custom-date-picker {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.date-btn {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.date-separator {
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #999;
}

.btn-query {
  width: 100%;
  background-color: #f59e0b;
  color: #fff;
  font-size: 30rpx;
  border-radius: 12rpx;
  padding: 24rpx;
  border: none;
}

.stats-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.stats-header {
  margin-bottom: 32rpx;
}

.stats-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.stats-date {
  font-size: 24rpx;
  color: #999;
}

.net-balance-card {
  background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 100%);
  border-radius: 16rpx;
  padding: 40rpx;
  text-align: center;
  margin-bottom: 32rpx;
}

.net-balance-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.net-balance-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.stats-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  background-color: #f9f9f9;
  border-radius: 12rpx;
}

.stat-item:not(:last-child) {
  margin-right: 20rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.stat-item.income .stat-value {
  color: #4CAF50;
}

.stat-item.expense .stat-value {
  color: #E53935;
}

.stat-label {
  font-size: 26rpx;
  color: #999;
}

.summary-section {
  background-color: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 32rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
}

.summary-label {
  font-size: 28rpx;
  color: #666;
}

.summary-value {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.progress-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.progress-bar {
  height: 28rpx;
  background-color: #f0f0f0;
  border-radius: 14rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 14rpx;
  transition: width 0.5s ease;
}

.progress-fill.normal {
  background-color: #4CAF50;
}

.progress-fill.warning {
  background-color: #E53935;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-text {
  font-size: 26rpx;
  color: #666;
}

.progress-alert {
  font-size: 24rpx;
  color: #E53935;
  flex-shrink: 0;
}

.income-breakdown {
  background-color: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
}

.breakdown-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
}

.breakdown-row:not(:last-child) {
  border-bottom: 2rpx solid #eee;
}

.breakdown-label {
  font-size: 28rpx;
  color: #666;
}

.breakdown-value {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.daily-list {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.daily-item {
  display: flex;
  padding: 24rpx 0;
}

.daily-item:not(:last-child) {
  border-bottom: 2rpx solid #f0f0f0;
}

.daily-date {
  width: 160rpx;
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.daily-details {
  flex: 1;
}

.daily-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}

.detail-label {
  font-size: 24rpx;
  color: #666;
}

.detail-value {
  font-size: 24rpx;
  font-weight: bold;
}

.detail-value.income {
  color: #4CAF50;
}

.detail-value.expense {
  color: #E53935;
}

.detail-value.balance {
  color: #333;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
}