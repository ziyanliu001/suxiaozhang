  background: #8C1D18;
}

.gratitude-modal-header .header-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.gratitude-modal-header .icon {
  font-size: 32rpx;
}

.gratitude-modal-header .text {
  font-size: 30rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.gratitude-modal-header .close-btn {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
  padding: 8rpx;
}

.gratitude-card-body {
  max-height: 75vh;
  padding: 24rpx;
  background-color: #FBF9F5;
}

.report-poster-canvas-box {
  background: #ffffff;
  border: 2rpx solid #F0E6D2;
  border-radius: 20rpx;
  padding: 28rpx;
}

.poster-header-banner {
  text-align: center;
  padding-bottom: 20rpx;
  border-bottom: 2rpx dashed #E8DCC4;
}

.poster-header-banner .main-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #8C1D18;
  letter-spacing: 2rpx;
}

.poster-header-banner .sub-title {
  font-size: 24rpx;
  color: #8C7355;
  margin-top: 8rpx;
}

.status-badge-bar {
  margin: 20rpx 0;
  padding: 12rpx 20rpx;
  border-radius: 30rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 500;
}

.status-badge-bar.active {
  background: #E8F5E9;
  color: #2E7D32;
  border: 1rpx solid #C8E6C9;
}

.status-badge-bar.preparing {
  background: #FFF8EE;
  color: #D32F2F;
  border: 1rpx solid #FFE0B2;
}

.card-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8C1D18;
  margin-top: 16rpx;
  margin-bottom: 12rpx;
}

.metrics-grid-2x2 {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.metrics-grid-2x2 .grid-item {
  width: 48%;
  background: #FFFDF8;
  border: 1rpx solid #F2E9D8;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
  text-align: center;
}

.grid-item .grid-label {
  font-size: 22rpx;
  color: #888888;
  display: block;
}

.grid-item .grid-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-top: 6rpx;
  display: block;
}

.grid-item .grid-value.highlight {
  color: #8C1D18;
}

.finance-summary-box {
  background: #FFFDF8;
  border: 1rpx solid #F2E9D8;
  border-radius: 16rpx;
  padding: 20rpx;
}

.finance-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.finance-row.total {
  margin-bottom: 0;
  padding-top: 12rpx;
  border-top: 1rpx dashed #E0D5C1;
}

.f-label {
  color: #666666;
}

.f-label.bold {
  font-weight: 600;
  color: #333333;
}

.f-val.income {
  color: #2E7D32;
  font-weight: bold;
}

.f-val.expense {
  color: #C62828;
}

.f-val.balance {
  color: #8C1D18;
  font-size: 32rpx;
  font-weight: bold;
}

.material-status-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: #FFFDF8;
  border-radius: 12rpx;
}

.material-status-bar .m-title {
  font-size: 24rpx;
  color: #666666;
}

.material-status-bar .m-tag {
  font-size: 22rpx;
  color: #666666;
  background: #F5F5F5;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.material-status-bar .m-tag.urgent {
  background: #FFEBEE;
  color: #C62828;
}

.poster-footer-seal {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #E8DCC4;
  text-align: center;
}

.poster-footer-seal .heart-quote {
  font-size: 24rpx;
  color: #8C7355;
  display: block;
}

.poster-footer-seal .sub-quote {
  font-size: 20rpx;
  color: #ADB5BD;
  margin-top: 8rpx;
  display: block;
}

.gratitude-modal-footer {
  display: flex;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-top: 1rpx solid #EEEEEE;
  gap: 16rpx;
}

.gratitude-modal-footer button {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 38rpx;
  padding: 0;
  margin: 0;
}

.gratitude-modal-footer button::after {
  border: none;
}

.btn-copy-text {
  background: #FFF3E0;
  color: #E65100;
}

.btn-share-wx {
  background: #07C160;
  color: #ffffff;
}

.btn-save-card {
  background: #8C1D18;
  color: #ffffff;
}
