page {
  background-color: #f7f8fa;
}

.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #f7f8fa;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 24rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #323233;
  line-height: 48rpx;
}

.nav-refresh-btn {
  position: absolute;
  right: 24rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  background-color: #fff;
  border-radius: 24rpx;
  border: 1rpx solid #e8e8e8;
}

.refresh-icon {
  font-size: 24rpx;
}

.refresh-text {
  font-size: 22rpx;
  color: #666;
}

.admin-switch {
  position: fixed;
  top: 80rpx;
  left: 0;
  right: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 16rpx 32rpx;
  background: linear-gradient(90deg, #f7f8fa 0%, #fff 20%, #fff 80%, #f7f8fa 100%);
  border-bottom: 1rpx solid #eee;
}

.switch-label {
  font-size: 24rpx;
  color: #999;
}

.switch-btn {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  color: #666;
  background-color: #f5f5f5;
  border-radius: 32rpx;
  transition: all 0.3s;
}

.switch-btn.active {
  color: #fff;
  background: linear-gradient(135deg, #B8860B 0%, #DAA520 100%);
}

.content-area {
  padding: 0 24rpx;
  background-color: #f7f8fa;
}

.period-control-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid #F1F3F5;
}

.store-select-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.store-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.store-label .title {
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
}

.store-picker-pill {
  background: #E7F5FF;
  border: 1rpx solid #A5D8FF;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.store-picker-pill.locked {
  background: #FFF9DB;
  border-color: #FFE066;
}

.store-picker-pill .name {
  font-size: 24rpx;
  color: #1C7ED6;
  font-weight: bold;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-picker-pill.locked .name {
  color: #7A4D00;
}

.store-picker-pill .arrow {
  font-size: 20rpx;
  color: #1C7ED6;
}

.store-picker-pill.locked .arrow {
  display: none;
}

.role-tag-badge {
  font-size: 18rpx;
  background: #FFF3BF;
  color: #D9480E;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 6rpx;
  font-weight: bold;
}

.period-tabs-segment {
  display: flex;
  background: #F1F3F5;
  border-radius: 16rpx;
  padding: 6rpx;
}

.period-tabs-segment .tab-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #495057;
  padding: 12rpx 0;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.period-tabs-segment .tab-item.active {
  background: #FFFFFF;
  color: #D9480E;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.date-picker-subrow {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.picker-pill-btn {
  flex: 1;
  background: #FFF9DB;
  border: 1rpx solid #FFE066;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-pill-btn.small {
  flex: 1;
}

.picker-pill-btn .lbl {
  font-size: 24rpx;
  color: #7A4D00;
  font-weight: bold;
}

.picker-pill-btn .arrow {
  font-size: 20rpx;
  color: #D9480E;
}

.date-separator {
  font-size: 24rpx;
  color: #868E96;
}

.btn-custom-query {
  margin-top: 16rpx;
  background: linear-gradient(135deg, #FFE066 0%, #FCC419 100%);
  color: #7A4D00;
  font-weight: bold;
  border-radius: 16rpx;
  font-size: 26rpx;
  padding: 16rpx 0;
  border: none;
}

.btn-custom-query::after {
  border: none;
}

.cost-badge.valid {
  color: #2B8A3E;
  font-weight: bold;
  font-size: 24rpx;
}

.cost-badge.neutral {
  color: #868E96;
  background: #F1F3F5;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.warning-pill {
  font-size: 20rpx;
  font-weight: bold;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  white-space: nowrap;
}

.warning-pill.ample {
  background: #E6FCF5;
  color: #0CA678;
}

.warning-pill.warning {
  background: #FFF9DB;
  color: #F59F00;
}

.warning-pill.urgent {
  background: #FFF5F5;
  color: #E03131;
}

.net-val-group {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.net-sub-tip {
  font-size: 20rpx;
  color: #868E96;
  font-weight: normal;
}

.major-expense-tag {
  font-size: 20rpx;
  color: #E03131;
  background: #FFF5F5;
  border: 1rpx solid #FFC9C9;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  margin-left: 8rpx;
  white-space: nowrap;
}

.fixed-major-row {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #FFC9C9;
  background: #FFFBFB;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.fixed-major-row .major-label {
  font-size: 22rpx;
  color: #E03131;
}

.fixed-major-row .major-val {
  font-size: 24rpx;
  color: #E03131;
  font-weight: bold;
}

.tab-bar {
  display: flex;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  position: relative;
  transition: all 0.3s;
}

.tab-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.tab-text {
  font-size: 28rpx;
  color: #969799;
  font-weight: 400;
  white-space: nowrap;
}

.tab-item.active .tab-text {
  color: #f59e0b;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 8rpx;
  width: 48rpx;
  height: 8rpx;
  background: linear-gradient(90deg, #f59e0b 0%, #d97706 100%);
  border-radius: 4rpx;
}

.custom-date-picker {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.date-btn {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background-color: #f7f8fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #323233;
}

.date-separator {
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #969799;
}

.btn-query {
  width: 100%;
  background-color: #f59e0b;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 12rpx;
  padding: 24rpx;
  border: none;
}

.content-section {
  flex: 1;
  overflow: hidden;
  padding: 24rpx;
  padding-top: 16rpx;
  padding-bottom: 144rpx !important;
}

.stats-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 40rpx;
}

.health-card {
  border-radius: 24rpx;
  padding: 32rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.health-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.health-icon {
  font-size: 48rpx;
}

.health-title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.health-title {
  font-size: 32rpx;
  font-weight: bold;
}

.health-date {
  font-size: 24rpx;
  opacity: 0.85;
}

.balance-amount {
  text-align: center;
  margin-bottom: 20rpx;
}

.balance-label {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 8rpx;
}

.balance-value {
  font-size: 64rpx;
  font-weight: bold;
  line-height: 1.2;
}

.runway-box {
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.runway-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 4rpx;
}

.runway-days {
  font-size: 36rpx;
  font-weight: bold;
}

.material-pills-row {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-top: 24rpx;
  margin-bottom: 16rpx;
}

.mat-pill-capsule {
  background: rgba(255, 255, 255, 0.92);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.mat-icon {
  font-size: 24rpx;
}

.mat-name {
  font-size: 24rpx;
  font-weight: bold;
  color: #212529;
}

.status-tag-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: bold;
}

.status-tag-pill .dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.status-tag-pill.success {
  background-color: #E6FCF5;
  color: #0CA678 !important;
}

.status-tag-pill.success .dot {
  background-color: #0CA678;
}

.status-tag-pill.warning {
  background-color: #FFF9DB;
  color: #D9480E !important;
}

.status-tag-pill.warning .dot {
  background-color: #D9480E;
}

.status-tag-pill.danger {
  background-color: #FFF5F5;
  color: #E03131 !important;
}

.status-tag-pill.danger .dot {
  background-color: #E03131;
}

.health-tip {
  text-align: center;
  font-size: 26rpx;
  line-height: 1.5;
  opacity: 0.95;
}

.income-expense-card,
.achievement-card,
.daily-list-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  overflow: visible;
}

.card-header {
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #323233;
}

.ie-columns {
  display: flex;
  align-items: stretch;
  margin-bottom: 24rpx;
}

.ie-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.ie-divider {
  width: 2rpx;
  background-color: #f0f0f0;
  margin: 0 16rpx;
}

.ie-label {
  font-size: 26rpx;
  color: #646566;
  margin-bottom: 12rpx;
}

.ie-value {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.ie-value.income {
  color: #4CAF50;
}

.ie-value.expense {
  color: #E53935;
}

.ie-detail {
  width: 100%;
  display: flex;
  justify-content: space-between;
  padding: 8rpx 16rpx;
  box-sizing: border-box;
}

.ie-detail-label {
  font-size: 24rpx;
  color: #969799;
}

.ie-detail-value {
  font-size: 24rpx;
  color: #323233;
  font-weight: 500;
}

.net-accumulation-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background-color: #f7f8fa;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.net-label {
  font-size: 28rpx;
  color: #646566;
}

.net-value {
  font-size: 36rpx;
  font-weight: bold;
}

.text-success {
  color: #4CAF50 !important;
}

.text-danger {
  color: #E53935 !important;
}

.expense-structure {
  padding-top: 24rpx;
  border-top: 2rpx solid #f0f0f0;
}

.structure-label {
  display: block;
  font-size: 28rpx;
  color: #646566;
  margin-bottom: 16rpx;
}

.structure-bar {
  display: flex;
  height: 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.structure-fill.daily {
  background-color: #4CAF50;
  transition: width 0.5s ease;
}

.structure-fill.large {
  background-color: #FF9800;
  transition: width 0.5s ease;
}

.structure-legend {
  display: flex;
  justify-content: space-around;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}

.legend-dot.daily {
  background-color: #4CAF50;
}

.legend-dot.large {
  background-color: #FF9800;
}

.legend-text {
  font-size: 24rpx;
  color: #646566;
}

.achievement-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}

.achievement-item {
  width: calc(50% - 20rpx);
  margin: 10rpx;
  background-color: #f7f8fa;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  box-sizing: border-box;
}

.achievement-icon {
  font-size: 40rpx;
  display: block;
  margin-bottom: 12rpx;
}

.achievement-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #323233;
  display: block;
  margin-bottom: 8rpx;
}

.achievement-label {
  font-size: 24rpx;
  color: #646566;
}

.volunteer-summary-row {
  text-align: center;
  margin-top: 20rpx;
  padding: 16rpx;
  background: linear-gradient(135deg, #FFF8F0 0%, #FFE4C4 100%);
  border-radius: 12rpx;
}

.vol-summary-text {
  font-size: 26rpx;
  color: #8B4513;
  font-weight: 500;
}

.materials-summary-card {
  margin-top: 24rpx;
  padding: 24rpx;
  background-color: #FFFEF7;
  border: 2rpx solid #FFE4B5;
  border-radius: 16rpx;
}

.materials-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #B8860B;
  display: block;
  margin-bottom: 16rpx;
}

.materials-empty {
  font-size: 26rpx;
  color: #969799;
  padding: 12rpx 0;
  text-align: center;
}

.materials-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.materials-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.materials-name {
  font-size: 26rpx;
  color: #646566;
}

.materials-qty {
  font-size: 26rpx;
  color: #323233;
  font-weight: bold;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title-bar {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.store-scope-tag {
  align-self: flex-start;
  font-size: 22rpx;
  background-color: #E7F5FF;
  color: #1C7ED6;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.header-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
}

.action-btn.primary {
  background-color: #4CAF50;
  color: #fff;
}

.action-btn.outline {
  background-color: #fff;
  color: #f59e0b;
  border: 2rpx solid #f59e0b;
}

.action-icon {
  font-size: 26rpx;
}

.action-text {
  font-size: 24rpx;
  font-weight: 500;
}

.empty-box {
  padding: 60rpx 32rpx;
  text-align: center;
  background: #f8f9fa;
  border-radius: 16rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #868E96;
}

.daily-card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.monthly-aggregate-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.month-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 1rpx solid #E9ECEF;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.month-card-header {
  padding: 24rpx;
  background: linear-gradient(135deg, #FFF4E6 0%, #FFE8CC 100%);
}

.month-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.month-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #D9480F;
}

.month-record-count {
  font-size: 22rpx;
  color: #ADB5BD;
  background: rgba(255, 255, 255, 0.6);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.month-summary-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.month-summary-item {
  flex: 1;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}

.ms-label {
  font-size: 20rpx;
  color: #868E96;
  display: block;
  margin-bottom: 4rpx;
}

.ms-value {
  font-size: 26rpx;
  font-weight: bold;
}

.ms-value.green {
  color: #2F9E44;
}

.ms-value.red {
  color: #E03131;
}

.month-expand-arrow {
  font-size: 22rpx;
  color: #D9480F;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.month-detail-body {
  padding: 20rpx;
  background: #F8F9FA;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.month-detail-body .daily-item-card {
  box-shadow: none;
  border: 1rpx solid #DEE2E6;
}

.daily-item-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #E9ECEF;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.daily-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx dashed #F1F3F5;
  margin-bottom: 16rpx;
}

.date-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.date-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
}

.status-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.status-tag.success {
  background: #E6FCF5;
  color: #0CA678;
}

.status-tag.warning {
  background: #FFF9DB;
  color: #F59F00;
}

.net-change {
  font-size: 28rpx;
  font-weight: bold;
}

.net-change.plus {
  color: #2B8A3E;
}

.net-change.minus {
  color: #C92A2A;
}

.daily-card-body {
  display: flex;
  justify-content: space-between;
}

.grid-col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.col-label {
  font-size: 22rpx;
  color: #868E96;
  margin-bottom: 4rpx;
}

.col-value {
