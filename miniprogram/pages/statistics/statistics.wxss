  box-shadow: none;
}

/* ===== 🆕 财务/家长专属卡片：门店财务与凭证合规大屏 / 资源储备与续航预警 ===== */
.finance-compliance-card,
.patriarch-resource-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.finance-metric-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 16rpx;
}

.finance-metric-cell {
  background: #F8F9FA;
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.finance-metric-val {
  font-size: 34rpx;
  font-weight: bold;
  color: #212529;
}

.finance-metric-cell.green .finance-metric-val {
  color: #2B8A3E;
}

.finance-metric-cell.warn .finance-metric-val {
  color: #D48806;
}

.finance-metric-lbl {
  font-size: 22rpx;
  color: #868E96;
}

.patriarch-loading {
  text-align: center;
  padding: 40rpx 0;
  color: #ADB5BD;
  font-size: 24rpx;
}

.patriarch-resource-tip {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #FFFBE6;
  border: 1rpx solid #FFE58F;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #D48806;
}

.national-poster-btn {
  margin-top: 24rpx;
}
