}

.cb-hero-kpi-formula {
  font-size: 20rpx;
  color: #94A3B8;
}

.cb-hero-kpi-divider {
  width: 1.5rpx;
  height: 76rpx;
  background: rgba(148, 163, 184, 0.25);
  flex-shrink: 0;
}

.cb-hero-foot {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid rgba(148, 163, 184, 0.18);
  padding-top: 16rpx;
}

.cb-hero-foot-text {
  font-size: 22rpx;
  color: #94A3B8;
}

.cb-hero-foot-val {
  font-size: 26rpx;
  font-weight: 700;
  color: #7DD3FC;
  font-variant-numeric: tabular-nums;
}

/* 分组网格：浅色卡片，延续页面其余区域的视觉语言 */
.cb-group {
  background: #FFFFFF;
  padding: 20rpx 20rpx 4rpx;
}

.cb-group-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
  margin-bottom: 14rpx;
}

.cb-group-grid {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.cb-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  background: #F8FAFC;
  border: 1.5rpx solid #EEF2F7;
  border-radius: 16rpx;
  padding: 18rpx 6rpx 14rpx;
}

/* 倾听陪伴单独强调：与关怀/温度主题呼应的青色高亮卡片 */
.cb-cell-accent {
  background: #F0FDFA;
  border-color: #CCFBF1;
}

.cb-cell-val {
  font-size: 32rpx;
  font-weight: 800;
  color: #1E293B;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}

.cb-cell-lbl {
  font-size: 20rpx;
  color: #64748B;
  text-align: center;
  line-height: 1.3;
}

.cb-cell-unit {
  font-size: 18rpx;
  color: #94A3B8;
}

/* 🆕 全网义工奉献光荣榜：与上方浅色 cb-cell 网格同一区域，列表项走更紧凑的
   单行布局（排名 + 脱敏姓名 + 工时 + 主要服务门店） */
.volunteer-honor-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.vhl-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #F8FAFC;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}

.vhl-rank {
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 20rpx;
  font-weight: 700;
  background: #E2E8F0;
  color: #475569;
  flex-shrink: 0;
}

.vhl-item:nth-child(1) .vhl-rank {
  background: #FCD34D;
  color: #78350F;
}

.vhl-item:nth-child(2) .vhl-rank {
  background: #E2E8F0;
  color: #334155;
}

.vhl-item:nth-child(3) .vhl-rank {
  background: #FDBA74;
  color: #7C2D12;
}

.vhl-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #1E293B;
}

.vhl-hours {
  font-size: 22rpx;
  font-weight: 700;
  color: #D9480E;
}

.vhl-store {
  flex: 1;
  text-align: right;
  font-size: 20rpx;
  color: #94A3B8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 比例条（替代饼图，纯 CSS，不依赖 ECharts） */
.cb-ratio-section {
  background: #FFFFFF;
  border-top: 1rpx solid #f1f5f9;
  padding: 16rpx 20rpx 20rpx;
}

.cb-ratio-title {
  font-size: 22rpx;
  color: #64748b;
  display: block;
  margin-bottom: 10rpx;
}

.cb-ratio-bar-wrap {
  display: flex;
  height: 16rpx;
  border-radius: 100rpx;
  overflow: hidden;
  background: #f1f5f9;
  margin-bottom: 10rpx;
}

.cb-ratio-seg {
  height: 100%;
  min-width: 2rpx;
  transition: width 0.4s ease;
}

.seg-dine-in  { background: #22c55e; }
.seg-delivery { background: #3b82f6; }
.seg-listen   { background: #06b6d4; }

.cb-ratio-legend {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.cb-legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-dine-in  { background: #22c55e; }
.dot-delivery { background: #3b82f6; }
.dot-listen   { background: #06b6d4; }

.legend-text {
  font-size: 20rpx;
  color: #64748b;
}

/* 空状态：全国范围各细分维度均为 0 时的兜底展示，与 Hero 卡片同宽同位 */
.cb-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFFFFF;
  border: 1.5rpx dashed #E2E8F0;
  border-radius: 24rpx;
  padding: 40rpx 24rpx 32rpx;
  margin-bottom: 24rpx;
}

/* 🐛 用 .cb-svg-icon.cb-empty-icon 复合选择器而非单独 .cb-empty-icon——
   下方 .cb-svg-icon 在样式表里定义在后面，若单独选择器与它同等特异度，
   源码顺序会让 36rpx 的默认尺寸盖掉这里的 64rpx，复合选择器把特异度
   提高一级，不管两条规则谁写在前面都能稳定生效 */
.cb-svg-icon.cb-empty-icon {
  width: 64rpx;
  height: 64rpx;
  opacity: 0.35;
  margin-bottom: 14rpx;
}

.cb-empty-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #64748B;
  margin-bottom: 6rpx;
}

.cb-empty-sub {
  font-size: 22rpx;
  color: #94A3B8;
}

