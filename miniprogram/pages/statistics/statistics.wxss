/* ─── 💖 全网爱心支持与善缘墙卡片 ──────────────────────────────────── */
.love-wall-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx 20rpx;
  margin-bottom: 24rpx;
  border: 1.5rpx solid #fce7f3;
  box-shadow: 0 4rpx 16rpx rgba(236, 72, 153, 0.06);
}

.love-wall-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.love-wall-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #831843;
  letter-spacing: 0.5rpx;
}

.love-wall-sub {
  font-size: 20rpx;
  color: #d1d5db;
  font-style: italic;
}

/* 🆕 阳光防篡改存证徽标（2026-08-31）：SECURED 用沉稳的蓝绿色传达"已核验"，
   VERIFYING 用中性灰黄提示"核查中"——刻意不用红色，避免和资金/离线告警的
   报警色混淆，这条徽标本身传达的是正面的公信力信息 */
.audit-proof-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
}

.audit-proof-SECURED {
  background: rgba(13, 148, 136, 0.08);
  border: 1rpx solid rgba(13, 148, 136, 0.20);
}

.audit-proof-VERIFYING {
  background: rgba(156, 163, 175, 0.12);
  border: 1rpx solid rgba(156, 163, 175, 0.25);
}

/* 🆕（2026-08-31 商业化权益中心）免费版锁定态：浅橙色调，与"告急"红色/
   "核验中"灰色区分，避免读成一条负面告警 */
.audit-proof-LOCKED {
  background: rgba(217, 72, 14, 0.06);
  border: 1rpx solid rgba(217, 72, 14, 0.18);
}

.audit-proof-icon {
  font-size: 22rpx;
  flex-shrink: 0;
}

.audit-proof-text {
  font-size: 21rpx;
  color: #374151;
  line-height: 1.4;
}

/* 🆕 逐条/逐店"已存证"微标：善缘墙单条捐赠、门店矩阵单个门店都复用同一个
   小巧的绿色标签，与上面卡片级 .audit-proof-badge 是同一套"已核验"视觉
   语言的缩小版 */
.audit-proof-mini-tag {
  display: inline-block;
  font-size: 18rpx;
  font-weight: 600;
  color: #0f766e;
  background: rgba(13, 148, 136, 0.12);
  padding: 1rpx 10rpx;
  border-radius: 100rpx;
  margin-left: 6rpx;
  vertical-align: middle;
}

/* KPI 行 */
.love-kpi-row {
  display: flex;
  align-items: center;
  background: #fff1f2;
  border-radius: 16rpx;
  padding: 16rpx 0;
  margin-bottom: 20rpx;
}

.love-kpi-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.love-kpi-divider {
  width: 1rpx;
  height: 48rpx;
  background: #fecdd3;
  flex-shrink: 0;
}

.love-kpi-val {
  font-size: 36rpx;
  font-weight: 800;
  color: #be185d;
}

.love-kpi-lbl {
  font-size: 20rpx;
  color: #9ca3af;
}

.masked-love {
  color: #d1d5db !important;
  font-size: 28rpx !important;
}

/* 🆕 阳善 / 阴德细分：两张并排小卡片，人次 + 金额（金额对志工遮罩） */
.love-merit-split-row {
  display: flex;
  gap: 16rpx;
  border-top: 1rpx solid #fce7f3;
  margin-top: 20rpx;
  padding-top: 16rpx;
}

.love-merit-split-cell {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-radius: 16rpx;
  padding: 14rpx 16rpx;
}

/* 🎨 对齐卡片升级：加边框 + 微阴影，两枚卡片各自成为独立可辨识的"卡"，
   而不是共用一整行背景色块，强化"阳善 vs 积阴德"的左右对比感 */
.love-merit-split-cell.yang {
  background: rgba(245, 158, 11, 0.08);
  border: 1.5rpx solid rgba(245, 158, 11, 0.18);
  box-shadow: 0 2rpx 8rpx rgba(245, 158, 11, 0.08);
}

.love-merit-split-cell.yin {
  background: rgba(99, 102, 241, 0.08);
  border: 1.5rpx solid rgba(99, 102, 241, 0.18);
  box-shadow: 0 2rpx 8rpx rgba(99, 102, 241, 0.08);
}

.love-merit-split-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.love-merit-split-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

.love-merit-split-val {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2937;
}

/* 善款金额加粗：与人次数字同一视觉权重，两枚卡片左右并排时更容易一眼
   对比出阳善/积阴德的善款差异 */
.love-merit-split-amount {
  font-size: 24rpx;
  font-weight: 700;
  color: #92400e;
}

.love-merit-split-cell.yin .love-merit-split-amount {
  color: #4338ca;
}

.love-merit-split-amount.masked {
  color: #d1d5db;
  letter-spacing: 2rpx;
}

.love-merit-split-lbl {
  font-size: 20rpx;
  color: #9ca3af;
}

/* 🆕 最新爱心支持滚动墙：全国大屏版，多店聚合所以带 [门店名称] 前缀，
   与个人页单店版（components/yangshan-wall，无需门店前缀）视觉语言一致 */
.love-scroll-section {
  border-top: 1rpx solid #fce7f3;
  margin-top: 20rpx;
  padding-top: 16rpx;
}

.love-scroll-title {
  font-size: 22rpx;
  color: #6b7280;
  display: block;
  margin-bottom: 10rpx;
}

.love-scroll-swiper {
  height: 52rpx;
}

/* 🎨 精致列表项：轻量胶囊底色替代此前纯文字裸行，滚动跑马灯（swiper
   autoplay circular）本身已经实现"轻微滑动"效果，这里只升级单条的视觉质感 */
.love-scroll-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 52rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(236, 72, 153, 0.06), rgba(236, 72, 153, 0.02));
}

.love-scroll-store {
  font-size: 22rpx;
  color: #9ca3af;
  flex-shrink: 0;
}

.love-scroll-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #be185d;
  flex-shrink: 0;
}

.love-scroll-amount {
  font-size: 24rpx;
  color: #374151;
  flex-shrink: 0;
}

.love-scroll-time {
  font-size: 20rpx;
  color: #9ca3af;
}

/* ─── 🚨 门店健康度告警中心：合并原「待支援站点预警」+「离线门店预警」───── */
.health-alert-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 24rpx 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.health-alert-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.health-alert-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 呼吸灯：始终用 critical 红色脉冲，三档卡片共用同一个标题灯 */
.health-alert-pulse {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.health-alert-pulse.critical {
  background: #ef4444;
  box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.5);
  animation: pulse-critical 2s ease-out infinite;
}

/* 🆕 空状态（无待支援站点）：绿色静态圆点，不做呼吸动画，避免"正常"状态还在
   视觉上抢眼地闪烁，与预警态的红色脉冲形成明确的冷静/紧急对比 */
.health-alert-pulse.normal {
  background: #2f9e44;
}

@keyframes pulse-critical {
  0%   { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.55); }
  60%  { box-shadow: 0 0 0 12rpx rgba(239, 68, 68, 0); }
  100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
}

.health-alert-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #b91c1c;
  letter-spacing: 0.5rpx;
}

.health-alert-count {
  font-size: 22rpx;
  color: #ef4444;
  background: rgba(239, 68, 68, 0.10);
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
  font-weight: 600;
}

/* 列表容器 */
.health-alert-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 🆕 空状态：与 .matrix-filter-empty/.ranking-empty 同一套弱化居中文案规范 */
.health-alert-empty {
  text-align: center;
  padding: 24rpx 0;
}

.health-alert-empty-text {
  font-size: 24rpx;
  color: #2f9e44;
}

/* 单条告警行：左侧门店名称/位置，右侧危险红/警示橙圆角 Tag */
/* 🐛 2026-08-31 结构调整：原来的行内 flex 布局（hai-left/hai-right 并排）
   下移到新增的 .hai-top-row 上，.health-alert-item 本身改为纵向排列，
   为下方新增的 .hai-actions（一键联系/督导关怀）腾出独立的一行 */
.health-alert-item {
  display: flex;
  flex-direction: column;
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  gap: 10rpx;
}

.hai-top-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

/* 🆕 一键联系 / 督导关怀操作行 */
.hai-actions {
  display: flex;
  gap: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.hai-action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(0, 0, 0, 0.10);
  border-radius: 100rpx;
  padding: 8rpx 0;
}

.hai-action-icon {
  font-size: 22rpx;
}

.hai-action-text {
  font-size: 22rpx;
  color: #374151;
  font-weight: 600;
}

.health-alert-item.severity-critical {
  background: rgba(239, 68, 68, 0.06);
  border: 1rpx solid rgba(239, 68, 68, 0.20);
}

.health-alert-item.severity-high {
  background: rgba(249, 115, 22, 0.06);
  border: 1rpx solid rgba(249, 115, 22, 0.20);
}

.health-alert-item.severity-medium {
  background: rgba(234, 179, 8, 0.06);
  border: 1rpx solid rgba(234, 179, 8, 0.22);
}

/* 左侧布局：门店名称与省市位置 */
.hai-left {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}

/* 严重程度指示圆点（带呼吸动画） */
.hai-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 6rpx;
}

.hai-dot.severity-dot-critical {
  background: #ef4444;
  animation: pulse-critical 1.8s ease-out infinite;
}

.hai-dot.severity-dot-high {
  background: #f97316;
  box-shadow: 0 0 0 0 rgba(249, 115, 22, 0.5);
  animation: pulse-high 2.2s ease-out infinite;
}

.hai-dot.severity-dot-medium {
  background: #eab308;
  box-shadow: 0 0 0 0 rgba(234, 179, 8, 0.5);
  animation: pulse-medium 2.8s ease-out infinite;
}

@keyframes pulse-high {
  0%   { box-shadow: 0 0 0 0 rgba(249, 115, 22, 0.55); }
  60%  { box-shadow: 0 0 0 12rpx rgba(249, 115, 22, 0); }
  100% { box-shadow: 0 0 0 0 rgba(249, 115, 22, 0); }
}

@keyframes pulse-medium {
  0%   { box-shadow: 0 0 0 0 rgba(234, 179, 8, 0.55); }
  60%  { box-shadow: 0 0 0 12rpx rgba(234, 179, 8, 0); }
  100% { box-shadow: 0 0 0 0 rgba(234, 179, 8, 0); }
}

.hai-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.hai-name-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 4rpx;
}

.hai-location {
  font-size: 22rpx;
  color: #6b7280;
}

.hai-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}

/* 🆕 平台徽章：仅"全部平台"视角下渲染，用中性灰，避免和右侧按严重程度着色的
   原因标签混淆语义 */
.hai-org-tag {
  font-size: 18rpx;
  color: #6b7280;
  background: rgba(107, 114, 128, 0.10);
  padding: 2rpx 10rpx;
  border-radius: 100rpx;
}

/* 🆕 风险分改为随 severity 着色的小徽标（原为纯灰字），与左侧指示点/边框
   的红橙黄配色呼应，一眼就能把"风险分数"和"严重程度"对上号 */
.hai-score {
  align-self: flex-start;
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: 100rpx;
}

.hai-score.hai-score-critical {
  color: #b91c1c;
  background: rgba(239, 68, 68, 0.10);
}

.hai-score.hai-score-high {
  color: #c2410c;
  background: rgba(249, 115, 22, 0.10);
}

.hai-score.hai-score-medium {
  color: #92400e;
  background: rgba(234, 179, 8, 0.12);
}

/* 右侧：危险红/警示橙圆角 Tag 组，靠右对齐，排查一眼可见 */
.hai-right {
  flex-shrink: 0;
  max-width: 45%;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.hai-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 100rpx;
  line-height: 1.4;
  text-align: right;
  white-space: nowrap;
}

.hai-tag.hai-tag-critical {
  background: #FEE2E2;
  color: #b91c1c;
}

.hai-tag.hai-tag-high {
  background: #FFEDD5;
  color: #c2410c;
}

.hai-tag.hai-tag-medium {
  background: #FEF3C7;
  color: #92400e;
}

/* 🆕 超过 2 条原因标签时的折叠徽标：中性灰，弱化于上方两条主标签，
   不再抢视觉重点，只提示"还有更多原因"而非重复展示完整文案 */
.hai-tag-more {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 100rpx;
  background: rgba(107, 114, 128, 0.10);
  color: #6b7280;
}

/* 底部得分说明 */
.health-alert-footer {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(239, 68, 68, 0.12);
}

.health-alert-tip {
  font-size: 20rpx;
  color: #9ca3af;
  line-height: 1.5;
}

/* ─── end 门店健康度告警中心 ───────────────────────────────────────── */

/* 🆕 爱心互助调拨建议卡片（2026-08-30 跨店爱心调拨建议引擎）：与告警中心的
   红色紧急配色区分开，用协作感的蓝绿色调，传达"这是解决方案建议"而不是
   "又一条警报" */
.support-suggestion-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 24rpx 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.support-suggestion-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.support-suggestion-item {
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  background: rgba(13, 148, 136, 0.06);
  border: 1rpx solid rgba(13, 148, 136, 0.20);
}

.ssi-header {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.ssi-store {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f766e;
}

/* 🆕 urgency 徽标：HIGH（资金续航≤7天）用告急红，MEDIUM（仅主料告急，
   资金尚健康）用关注橙，与门店健康度告警中心的红/橙配色呼应，但用不同
   底色区分"这是调拨建议区"而不是"又一条红色警报" */
.ssi-urgency-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 14rpx;
  border-radius: 100rpx;
}

.ssi-urgency-HIGH {
  color: #b91c1c;
  background: rgba(239, 68, 68, 0.12);
}

.ssi-urgency-MEDIUM {
  color: #b45309;
  background: rgba(245, 158, 11, 0.14);
}

.ssi-text {
  display: block;
  font-size: 24rpx;
  color: #374151;
  line-height: 1.5;
}

.ssi-store-bold {
  font-weight: 700;
  color: #0f766e;
}

.ssi-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 10rpx;
}

.ssi-copy-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(13, 148, 136, 0.30);
  border-radius: 100rpx;
  padding: 6rpx 18rpx;
}

.ssi-copy-icon {
  font-size: 20rpx;
}

.ssi-copy-text {
  font-size: 22rpx;
  color: #0d9488;
  font-weight: 600;
}

/* 🆕 空状态：与 .health-alert-empty 同一套弱化居中文案规范 */
.support-suggestion-empty {
  text-align: center;
  padding: 24rpx 0;
}

.support-suggestion-empty-text {
  font-size: 24rpx;
  color: #2f9e44;
}

/* 🌾（2026-08-31 商业化生态延伸）爱心粮油源头集采直通车：暖麦穗黄绿调，
   与"调拨建议"（蓝绿协作色）、"健康度告警"（红橙警示色）区分开，传达
   "这是供应链增值服务"而不是治理/告警类信息 */
.procurement-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

/* 🌾（2026-08-31 集采进阶）只在集采卡片内把 .matrix-header 改成两端对齐的
   flex 行（标题 + 阶梯徽章），不改动 .matrix-header 基础规则本身——避免
   影响页面其它同样复用这个类名的卡片头部（如全国门店运营健康度概览） */
.procurement-card .matrix-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx;
}

.procurement-tier-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: linear-gradient(135deg, #F08C00, #D9480E);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.procurement-pool-progress {
  margin: 16rpx 0;
}

.procurement-pool-progress-label-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.procurement-pool-progress-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #5C4A1E;
}

.procurement-pool-progress-gap {
  font-size: 20rpx;
  color: #D9480E;
  flex-shrink: 0;
}

.procurement-pool-progress-track {
  width: 100%;
  height: 14rpx;
  background: #FBF0D6;
  border-radius: 7rpx;
  overflow: hidden;
}

.procurement-pool-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #F08C00, #D9480E);
  border-radius: 7rpx;
  transition: width 0.3s ease;
}

.procurement-demand-row {
  display: flex;
  gap: 12rpx;
  margin: 16rpx 0;
}

.procurement-demand-cell {
  flex: 1;
  text-align: center;
  background: #FBF8EF;
  border-radius: 14rpx;
  padding: 16rpx 4rpx;
}

.procurement-demand-val {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #A67C00;
  font-variant-numeric: tabular-nums;
}

.procurement-demand-lbl {
  font-size: 20rpx;
  color: #8A7E5C;
}

.procurement-savings-banner {
  background: linear-gradient(135deg, #FFF3D6, #FFE8B3);
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
}

.procurement-savings-text {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #8A5A00;
  line-height: 1.5;
}

/* 🌾（2026-08-31 集采进阶）第二行"预计每斤直降"文案与上面的月度节省善款
   文案字号拉开层级，避免两行同等权重显得拥挤 */
.procurement-savings-text + .procurement-savings-text {
  font-size: 22rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

.procurement-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.procurement-partner-tag {
  font-size: 22rpx;
  color: #8A7E5C;
  flex-shrink: 0;
}

.procurement-cta-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #A67C00;
  border-radius: 100rpx;
  padding: 12rpx 24rpx;
}

.procurement-cta-icon {
  font-size: 22rpx;
}

.procurement-cta-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
  white-space: nowrap;
}

/* 🌾 集采意向说明弹窗内容区 */
.procurement-modal-section {
  margin-bottom: 20rpx;
}

.procurement-modal-section-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #8A5A00;
  margin-bottom: 8rpx;
}

.procurement-modal-section-text {
  display: block;
  font-size: 24rpx;
  color: #495057;
  line-height: 1.6;
}

.procurement-modal-tip {
  font-size: 21rpx;
  color: #ADB5BD;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

/* 🆕 黑金配色治理区块：与页面其余白底卡片明确区隔，标示这是超管权限专区 */
.super-admin-insights-card {
  background: linear-gradient(135deg, #2B1D10 0%, #17110A 100%);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1.5rpx solid #B8860B;
}

.super-admin-insights-card .matrix-title {
  color: #FFD966;
}

.range-tab-row {
  display: flex;
  gap: 12rpx;
  margin: 16rpx 0 24rpx;
}

.range-tab-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 22rpx;
  color: #666666;
  background: #F8F9FA;
  border-radius: 30rpx;
}

.range-tab-item.active {
  background: #8C1D18;
  color: #FFFFFF;
  font-weight: bold;
}

.insights-metric-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.insights-metric-cell {
  flex: 1;
  text-align: center;
  background: rgba(255, 255, 255, 0.07);
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
}

.insights-metric-cell.warn {
  background: rgba(255, 135, 135, 0.12);
}

.insights-metric-val {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #F1D9A0;
  margin-bottom: 6rpx;
  /* 🐛 防止金额文本（如 ¥10230.00）在小屏手机上折行溢出撑破卡片，单行裁切显示 */
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.insights-metric-cell.warn .insights-metric-val {
  color: #FF8787;
}

.insights-metric-lbl {
  display: block;
  font-size: 20rpx;
  color: #C9B18A;
}

/* 高对比度核心数据卡：深色底 + 白字，2x2 四宫格，与下方浅灰底的次要指标区隔出主次。
   🐛 此前用 flex-wrap + flex: 0 0 calc(50% - 8rpx) 实现两列，在部分机型/基础库下
   flex-basis 的 calc() 计算与 gap 叠加会失准，导致四张卡片退化成单列纵向排列、
   右侧大片留白。改用标准 CSS Grid 固定两列，不再依赖 flex-basis 的间接换算 */
.insights-metric-grid.hero-contrast {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.hero-contrast-cell {
  width: 100%;
  margin: 0;
  box-sizing: border-box;
  background: linear-gradient(135deg, #3D2416 0%, #1F1209 100%);
  padding: 24rpx 8rpx;
}

.hero-contrast-cell .insights-metric-val {
  color: #FFD966;
  font-size: 34rpx;
}

.hero-contrast-cell .insights-metric-lbl {
  color: #E8D5B5;
}

.hero-contrast-cell.warn {
  background: linear-gradient(135deg, #5C1A1A 0%, #2B0A0A 100%);
}

.hero-contrast-cell.warn .insights-metric-val {
  color: #FF8787;
}

/* 🆕 悬浮质感：轻微半透明毛玻璃背景 + 更柔和的顶部阴影，让悬浮栏与下方
   内容之间是自然过渡而不是一条硬边界。只加在 .national-bottom-bar 这个
   修饰类上，不影响单店视角共用的 .bottom-sticky-bar 纯白底样式 */
.bottom-sticky-bar.national-bottom-bar {
  background: rgba(255, 255, 255, 0.92);
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* 🆕 底部固定操作栏（国家看板专属）：与非全国视角共用的 .bottom-sticky-bar
   基础定位/阴影/安全区规则，这里只补两个按钮各占一半宽度——.btn-primary-poster
   基础规则里 width:100% !important 是给单按钮场景设计的，双按钮并排时改用
   flex:1 让两者各自撑满一半，不再依赖 flex-shrink 的隐式换算 */
.national-bottom-bar .btn-primary-poster,
.national-bottom-bar .btn-national-report {
  flex: 1;
  width: auto !important;
}

/* 报表按钮：黑金配色，呼应上方「超管高阶治理面板」，与主按钮（海报，红色渐变）
   形成主次分明的视觉层级 */
.btn-national-report {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 12rpx;
  white-space: nowrap;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #3D2416 0%, #1F1209 100%);
  color: #FFD966;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: 1rpx solid #B8860B;
}

/* 🐛 修复吸底操作栏遮挡"超管高阶治理面板"与合规声明文案的问题：
   .national-bottom-bar 是 position:fixed，脱离文档流不会自动撑开滚动区域，
   页面滚到底时它会直接盖在最后一张卡片/说明文案上方。这里在文档流末尾
   补一个等高留白占位，让原生页面滚动到底部时，真实内容已经完全露出在
   悬浮栏上方，不被遮挡；140rpx→160rpx 与悬浮栏自身高度（88rpx 按钮 +
   20+20rpx 上下 padding≈128rpx）留出更充分的余量 */
.national-bottom-bar-spacer {
  height: calc(160rpx + constant(safe-area-inset-bottom));
  height: calc(160rpx + env(safe-area-inset-bottom));
}

.report-check-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #333333;
  border-bottom: 1rpx solid #F1F3F5;
}

/* 🆕 机构多店合并阳光台账导出确认弹窗说明文案 */
.export-confirm-desc {
  padding: 8rpx 0 24rpx 0;
  font-size: 26rpx;
  color: #495057;
  line-height: 1.6;
}

/* 🆕（2026-08-31 生态演进第三步）导出弹窗专业调性标签 */
.export-format-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  width: fit-content;
  background: #FFF3E0;
  border: 1rpx solid #FFD8A8;
  border-radius: 20rpx;
  padding: 8rpx 18rpx;
  margin-bottom: 20rpx;
}

.export-format-badge-icon {
  font-size: 22rpx;
}

.export-format-badge-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #D9480E;
}

/* 🆕（2026-08-31 商业化权益中心）机构 SaaS 权益看板：半屏弹窗，与页面其余
   .patch-modal-mask 居中弹窗风格区分——底部贴边 + 圆角顶部，符合"半屏"要求 */
.saas-benefits-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.saas-benefits-sheet {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sbs-handle {
  width: 72rpx;
  height: 8rpx;
  background: #E9ECEF;
  border-radius: 4rpx;
  margin: 0 auto 24rpx;
}

.sbs-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

