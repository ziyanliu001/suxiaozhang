  color: #495057;
}

/* 人群构成进度比例条：与「义工与用餐服务数据看板」的长者服务结构比例条同一套
   纯 CSS 分段条手法，不依赖 ECharts */
.people-ratio-section {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F1F3F5;
}

