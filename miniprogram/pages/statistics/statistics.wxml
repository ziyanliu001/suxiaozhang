<view class="page-container">
  <watermark identity="{{watermarkIdentity}}" />
  <!-- 🛡️ 动态避让官方胶囊菜单：padding-right 由 capsuleLeft/windowWidth 换算得出，
       不再用固定像素贴右，避免在不同机型上与胶囊按钮重叠遮挡 -->
  <view class="custom-nav" style="padding-top: {{navTop}}px; padding-right: {{windowWidth - capsuleLeft + 10}}px;">
    <view class="nav-back-arrow" hover-class="nav-back-arrow-hover" bindtap="goBackHome">←</view>
    <text class="nav-title">统计分析</text>
    <view class="nav-refresh-btn" hover-class="ui-hover" bindtap="onRefreshData">
      <text class="refresh-icon">🔄</text>
      <text class="refresh-text">刷新数据</text>
    </view>
  </view>

  <view class="admin-switch" wx:if="{{canViewAllStoresDropdown}}">
    <view class="switch-label">查看模式</view>
    <view class="switch-btn {{viewMode === 'all' ? 'active' : ''}}" bindtap="switchViewMode" data-mode="all">全店汇总</view>
    <view class="switch-btn {{viewMode === 'personal' ? 'active' : ''}}" bindtap="switchViewMode" data-mode="personal">个人统计</view>
  </view>

  <view class="content-area" style="padding-top: {{contentTop}}px;">
    <view class="ui-card-wrapper period-control-card">
      <!-- 🐛 根因修复：全国大屏模式下此前仍然常驻展示"当前统计门店：xxx"这张
           单店卡片（只有下方周期 Tab 那一段被隐藏），与页面下方真正的全国大屏
           内容语义脱节——用户在全国总览视角还看着一行单店信息，容易误以为
           大屏数据只是这一家店的。现在按 showNationalDashboard 二选一：单店
           模式展示原有的门店信息+切换器，全国大屏模式换成专属横幅 -->
      <view class="store-select-header-row" wx:if="{{!showNationalDashboard}}">
        <view class="store-label">
          <text class="pin-icon">📍</text>
          <text class="title">当前统计门店</text>
        </view>
        <!-- 🛡️ "全部门店"下拉选择器完全受 canViewAllStoresDropdown（严格收窄到
             super_admin）控制：非超管（含角色尚未解析完成的加载期间，此时该字段
             的初始值就是 false，不会有任何闪烁）一律走下面纯文字展示的锁定态，
             不渲染任何可点击切换门店的 picker，避免出现能选到其他门店/全部门店
             的可乘之机 -->
        <picker wx:if="{{canViewAllStoresDropdown && storePickerArray.length > 0}}" mode="selector" range="{{storePickerArray}}" range-key="shopName" bindchange="onSuperAdminSelectStore">
          <view class="store-picker-pill">
            <text class="name">{{currentUserStoreName || shopName}}</text>
            <text class="arrow">▼</text>
          </view>
        </picker>
        <view wx:elif="{{isPatriarch && showNationalDashboardEntry}}" class="patriarch-store-row">
          <view class="store-picker-pill locked">
            <text class="name">{{currentUserStoreName || shopName}}</text>
            <text class="lock-icon">🔒</text>
            <text class="role-tag-badge" wx:if="{{currentUserRole}}">{{roleLabelMap[currentUserRole]}}</text>
          </view>
          <view class="national-entry-btn" hover-class="national-entry-btn-hover" bindtap="onPatriarchGoNational">
            <text class="national-entry-icon">🌐</text>
            <text class="national-entry-text">全国看板</text>
            <text class="national-entry-arrow">↗</text>
          </view>
        </view>
        <view wx:else class="store-picker-pill locked">
          <text class="name">{{currentUserStoreName || shopName}}</text>
          <text class="lock-icon">🔒</text>
          <text class="role-tag-badge" wx:if="{{currentUserRole}}">{{roleLabelMap[currentUserRole]}}</text>
        </view>
      </view>
      <view class="national-banner-row" wx:else>
        <view class="national-banner-title">
          <text class="national-banner-icon">📊</text>
          <text class="national-banner-text">爱心网络总览 · {{currentTenantName || '全国爱心网络'}}</text>
        </view>
        <view class="national-banner-actions">
          <view class="national-banner-action-btn" hover-class="ui-hover" bindtap="onRefreshData">
            <text class="national-banner-action-icon">🔄</text>
            <text class="national-banner-action-text">刷新数据</text>
          </view>
          <!-- 🆕（2026-08-31）数据导出：改为发起"机构多店合并阳光台账"Excel 导出
               确认弹窗（含存证核验码），与底部吸底栏"📄 生成运营/财务报表"按钮
               （轻量级 CSV 聚合报表，走 onOpenNationalReportModal）是两个不同
               产出物的独立入口，不再复用同一个弹窗——同一条 isAdmin 权限口径 -->
          <view class="national-banner-action-btn" hover-class="ui-hover" bindtap="onOpenNationalExcelExportModal" wx:if="{{isAdmin}}">
            <text class="national-banner-action-icon">📄</text>
            <text class="national-banner-action-text">数据导出</text>
          </view>
        </view>
      </view>

      <!-- 🐛 周/月/年/自定义这套 Tab 只对"单店历史统计"（getStatisticsData）有意义——
           "全部门店"选中后走的是完全独立的全国大屏（自己的近7天/本月/本季度/
           全部时间范围选择器，见下方 super-admin-insights-card），此前这套 Tab
           在全国大屏模式下仍然常驻显示，切了也没有任何效果，纯属误导 -->
      <block wx:if="{{!showNationalDashboard}}">
      <view class="period-tabs-segment">
        <view class="tab-item {{currentTab === 'week' ? 'active' : ''}}" bindtap="switchTab" data-tab="week">周报</view>
        <view class="tab-item {{currentTab === 'month' ? 'active' : ''}}" bindtap="switchTab" data-tab="month">月报</view>
        <view class="tab-item {{currentTab === 'year' ? 'active' : ''}}" bindtap="switchTab" data-tab="year">年报</view>
        <view class="tab-item {{currentTab === 'custom' ? 'active' : ''}}" bindtap="switchTab" data-tab="custom">自定义</view>
      </view>

      <!-- 🌟 「◀ 上一期/下一期 ▶」快捷翻页：三侧布局包住原有的周/月/年/自定义
           展示区，免去财务人员反复打开 Picker 弹窗才能连续前后翻看不同周期 -->
      <view class="date-picker-subrow period-nav-subrow" wx:if="{{currentTab === 'week'}}">
        <view class="period-nav-btn" hover-class="period-nav-btn-hover" bindtap="onPeriodNav" data-dir="-1">◀</view>
        <view class="picker-pill-btn nav-label-pill">
          <text class="lbl">🗓️ 当前范围：{{weekRangeLabel}}</text>
        </view>
        <view class="period-nav-btn" hover-class="period-nav-btn-hover" bindtap="onPeriodNav" data-dir="1">▶</view>
      </view>

      <view class="date-picker-subrow period-nav-subrow" wx:if="{{currentTab === 'month'}}">
        <view class="period-nav-btn" hover-class="period-nav-btn-hover" bindtap="onPeriodNav" data-dir="-1">◀</view>
        <picker mode="date" fields="month" value="{{selectedYear}}-{{String(selectedMonth).padStart(2, '0')}}-01" bindchange="onMonthChange">
          <view class="picker-pill-btn">
            <text class="lbl">🗓️ 当前范围：{{selectedYear}}年{{selectedMonth}}月</text>
            <text class="arrow">▼</text>
          </view>
        </picker>
        <view class="period-nav-btn" hover-class="period-nav-btn-hover" bindtap="onPeriodNav" data-dir="1">▶</view>
      </view>

      <view class="date-picker-subrow period-nav-subrow" wx:if="{{currentTab === 'year'}}">
        <view class="period-nav-btn" hover-class="period-nav-btn-hover" bindtap="onPeriodNav" data-dir="-1">◀</view>
        <picker mode="date" fields="year" value="{{selectedYear}}-01-01" bindchange="onYearChange">
          <view class="picker-pill-btn">
            <text class="lbl">🗓️ 当前范围：{{selectedYear}}年</text>
            <text class="arrow">▼</text>
          </view>
        </picker>
        <view class="period-nav-btn" hover-class="period-nav-btn-hover" bindtap="onPeriodNav" data-dir="1">▶</view>
      </view>

      <view class="date-picker-subrow period-nav-subrow" wx:if="{{currentTab === 'custom'}}">
        <view class="period-nav-btn" hover-class="period-nav-btn-hover" bindtap="onPeriodNav" data-dir="-1">◀</view>
        <picker mode="date" value="{{customStartDate}}" bindchange="onCustomStartDateChange">
          <view class="picker-pill-btn small">
            <text class="lbl">{{customStartDate || '开始日期'}}</text>
            <text class="arrow">▼</text>
          </view>
        </picker>
        <text class="date-separator">至</text>
        <picker mode="date" value="{{customEndDate}}" bindchange="onCustomEndDateChange">
          <view class="picker-pill-btn small">
            <text class="lbl">{{customEndDate || '结束日期'}}</text>
            <text class="arrow">▼</text>
          </view>
        </picker>
        <view class="period-nav-btn" hover-class="period-nav-btn-hover" bindtap="onPeriodNav" data-dir="1">▶</view>
      </view>
      <button class="btn-custom-query" wx:if="{{currentTab === 'custom'}}" bindtap="loadCustomStatistics">查询统计</button>
      </block>
    </view>
  </view>

  <!-- 全国全网数据大屏：超管/总部财务精细化管理视角，志工只读荣誉版
       🐛 根因修复：容器本身只认 showNationalDashboard——此前额外叠加
       nationalData.nationalTotalDiners !== undefined 当作"已加载完成"的隐式判据，
       loadNationalDashboard() 云调用还在飞行中或失败时这个字段永远是 undefined，
       容器就一直不渲染；而下方单店 stats-content 又已经因 !showNationalDashboard
       被隐藏，两边都不出内容，界面表现为"点了全部门店但什么反应都没有"。现在容器
       优先渲染，内部用 nationalDashboardLoading/nationalDashboardError 显式区分
       "正在加载"/"加载失败"两种过渡态，不再用数据字段反推加载状态 -->
  <view class="national-dashboard-container" wx:if="{{showNationalDashboard}}">
    <view class="national-dashboard-loading" wx:if="{{nationalDashboardLoading}}">
      <text>全国总览加载中...</text>
    </view>
    <view class="national-dashboard-error" wx:elif="{{nationalDashboardError}}">
      <text class="error-text">{{nationalDashboardError}}</text>
      <button class="btn-empty-action" hover-class="ui-hover" bindtap="loadNationalDashboard">重试</button>
    </view>
    <block wx:elif="{{nationalData.nationalTotalDiners !== undefined}}">
    <!-- 🆕 当前筛选范围提示条：仅超管（拥有门店切换权限）可见，非"全国总览"（即
         按地区/自定义门店筛选）时展示当前范围文案 + "更改筛选"快捷入口，不必
         退回顶部门店选择器重新点一次 -->
    <view class="national-filter-status-bar" wx:if="{{canViewAllStoresDropdown && nationalFilterMode !== 'national'}}">
      <text class="filter-status-text">{{nationalFilterMode === 'region' ? '📍 当前按地区筛选：' : '🏬 当前自定义门店：'}}{{currentUserStoreName}}</text>
      <view class="filter-status-btn" bindtap="onChangeNationalFilter">更改筛选</view>
    </view>

    <!-- 🆕 时间范围选择器：从原先深埋在超管高阶治理面板里挪到页面顶部——切换
         时间粒度是最高频操作之一，此前要滚动过 KPI 卡/门店矩阵/排行榜才能看到，
         现置顶方便随时切换。rangeType 只对 super_admin 生效（云函数侧会再次
         校验角色，见 getNationalDashboard），非超管切了也不影响任何数据，故仍按
         isAdmin 收窄展示，不展示无效入口 -->
    <view class="range-tab-row" wx:if="{{isAdmin}}">
      <view
        wx:for="{{nationalRangeOptions}}"
        wx:key="value"
        class="range-tab-item {{nationalRangeType === item.value ? 'active' : ''}}"
        data-range="{{item.value}}"
        bindtap="onSwitchNationalRange"
      >{{item.label}}</view>
    </view>

    <!-- 🐛 根因修复（精简冗余分类层级）：此处原有"平台类型筛选器"（全部平台/
         雨花斋/助老食堂/义工服务站）Tab 已移除——工作空间进入统计页时早已
         锁定"雨花公益食堂专区"这一个业务范围，再让用户选一次"看哪个专区"
         是多余的一层。orgType 现固定传 'all'（见 loadNationalDashboard()
         callParams 注释），直接呈现本机构名下的完整爱心网络大盘 -->

    <!-- 🆕 全国爱心网络数据总览：统一为一张白底卡片，顶部 4 大核心指标用大
         字号数字置顶，收支细分/开餐天数/义工到岗降为次级小字号行，物资消耗
         （大米/面粉/油/蔬菜）收拢到底部轻量 4 列微卡片，不再挤占首屏 -->
    <view class="ui-card-wrapper national-overview-card">
      <!-- 🐛 修复标题重复：此前标题下方还挂了一行 dashboardTitle 文案（"全网
           爱心矩阵数据大屏"），与主标题"全国爱心网络数据总览"语义完全重复，
           两行连读像是同一句话被拆成两行——这里不重复展示，只保留一个主标题 -->
      <view class="overview-header">
        <view class="overview-title-row">
          <text class="overview-title">🌐 全国爱心网络数据总览</text>
          <text class="overview-role-tag" wx:if="{{dashboardRoleTag}}">{{dashboardRoleTag}}</text>
        </view>
      </view>

      <!-- 顶部 4 大核心指标：覆盖门店数 / 全国累计服务人次 / 总餐食支出 / 总志愿工时 -->
      <view class="overview-kpi-grid">
        <view class="overview-kpi-cell">
          <text class="overview-kpi-val">{{nationalData.totalStores}}</text>
          <text class="overview-kpi-lbl">覆盖门店数</text>
        </view>
        <view class="overview-kpi-cell">
          <text class="overview-kpi-val">{{nationalData.nationalTotalDinersDisplay}}</text>
          <text class="overview-kpi-lbl">全国累计服务人次</text>
          <!-- 🆕 环比趋势：与当前 nationalRangeType 选定的时间粒度对比上一个同长度
               周期，rangeType='all' 或查无可比基数时服务端返回 null，隐藏徽标 -->
          <view class="core-metrics-yoy {{nationalData.nationalTotalDinersTrend > 0 ? 'up' : (nationalData.nationalTotalDinersTrend < 0 ? 'down' : 'flat')}}" wx:if="{{nationalData.nationalTotalDinersTrend !== null && nationalData.nationalTotalDinersTrend !== undefined}}">
            <text>{{nationalData.nationalTotalDinersTrend > 0 ? '▲' : (nationalData.nationalTotalDinersTrend < 0 ? '▼' : '—')}} {{nationalData.nationalTotalDinersTrend}}% 环比</text>
          </view>
        </view>
        <!-- 🌟 志工视角：总餐食支出属运营敏感数据，与下方次级行的收支脱敏口径一致 -->
        <view class="overview-kpi-cell" wx:if="{{isManager}}">
          <text class="overview-kpi-val">¥{{nationalData.nationalTotalExpenseDisplay}}</text>
          <text class="overview-kpi-lbl">总餐食支出</text>
          <view class="core-metrics-yoy {{nationalData.nationalTotalExpenseTrend > 0 ? 'up' : (nationalData.nationalTotalExpenseTrend < 0 ? 'down' : 'flat')}}" wx:if="{{nationalData.nationalTotalExpenseTrend !== null && nationalData.nationalTotalExpenseTrend !== undefined}}">
            <text>{{nationalData.nationalTotalExpenseTrend > 0 ? '▲' : (nationalData.nationalTotalExpenseTrend < 0 ? '▼' : '—')}} {{nationalData.nationalTotalExpenseTrend}}% 环比</text>
          </view>
        </view>
        <view class="overview-kpi-cell" wx:else>
          <text class="overview-kpi-val overview-kpi-masked">***</text>
          <text class="overview-kpi-lbl">总餐食支出</text>
        </view>
        <!-- 全国义工服务工时：服务成果类指标，非财务数据，全角色可见 -->
        <view class="overview-kpi-cell">
          <text class="overview-kpi-val">{{nationalData.nationalTotalVolunteerHours}}</text>
          <text class="overview-kpi-lbl">总志愿工时（小时）</text>
        </view>
      </view>

      <!-- 次级指标行：收支细分/开餐天数/义工到岗——降为小字号，不再抢占首屏视觉焦点 -->
      <view class="overview-secondary-row">
        <view class="overview-sec-cell" wx:if="{{isManager}}">
          <text class="overview-sec-val">+¥{{nationalData.nationalTotalIncomeDisplay}}</text>
          <text class="overview-sec-lbl">全国服务汇入</text>
        </view>
        <view class="overview-sec-cell overview-sec-masked" wx:else>
          <text class="overview-sec-val">***</text>
          <text class="overview-sec-lbl">全国服务汇入</text>
        </view>
        <view class="overview-sec-cell">
          <text class="overview-sec-val">{{nationalData.nationalOpenDays}} 天</text>
          <text class="overview-sec-lbl">累计开餐天数</text>
        </view>
        <view class="overview-sec-cell">
          <text class="overview-sec-val">{{nationalData.nationalTotalVolunteers}} 人次</text>
          <text class="overview-sec-lbl">义工到岗人次</text>
        </view>
      </view>

      <!-- 物资消耗：轻量级 4 列小字号微卡片，避免挤占首屏空间 -->
      <view class="overview-materials-row" wx:if="{{nationalData.nationalRiceTotal > 0 || nationalData.nationalFlourTotal > 0 || nationalData.nationalOilTotal > 0 || nationalData.nationalVegetableTotal > 0}}">
        <view class="overview-material-cell" wx:if="{{nationalData.nationalRiceTotal > 0}}">
          <text class="material-val">{{nationalData.nationalRiceTotal}}斤</text>
          <text class="material-lbl">🌾 大米</text>
        </view>
        <view class="overview-material-cell" wx:if="{{nationalData.nationalFlourTotal > 0}}">
          <text class="material-val">{{nationalData.nationalFlourTotal}}斤</text>
          <text class="material-lbl">🌽 面粉</text>
        </view>
        <view class="overview-material-cell" wx:if="{{nationalData.nationalOilTotal > 0}}">
          <text class="material-val">{{nationalData.nationalOilTotal}}斤</text>
          <text class="material-lbl">🫗 食用油</text>
        </view>
        <view class="overview-material-cell" wx:if="{{nationalData.nationalVegetableTotal > 0}}">
          <text class="material-val">{{nationalData.nationalVegetableTotal}}斤</text>
          <text class="material-lbl">🥬 蔬菜</text>
        </view>
      </view>

      <!-- 🆕 食材消耗统计卡片（2026-08-31 供应链集采预估）：固定近30天窗口，
           与上方「物资消耗」微卡片（随顶部 rangeType 联动，7天/本月/本季度/
           全部时间）刻意分开——切换时间片 Tab 不会影响这里的集采预估数字，
           避免大家长误以为"本季度"大米消耗量就是月度集采基准 -->
      <view class="ingredient-trend-card" wx:if="{{nationalData.ingredientStats30d && (nationalData.ingredientStats30d.riceKg > 0 || nationalData.ingredientStats30d.flourKg > 0 || nationalData.ingredientStats30d.oilKg > 0 || nationalData.ingredientStats30d.veggieKg > 0)}}">
        <view class="itc-header">
          <text class="itc-title">📦 近30天食材消耗趋势</text>
          <text class="itc-sub">供机构集采参考</text>
        </view>
        <view class="itc-grid">
          <view class="itc-cell" wx:if="{{nationalData.ingredientStats30d.riceKg > 0}}">
            <text class="itc-val">{{nationalData.ingredientStats30d.riceKg}}kg</text>
            <text class="itc-lbl">🌾 大米</text>
          </view>
          <view class="itc-cell" wx:if="{{nationalData.ingredientStats30d.flourKg > 0}}">
            <text class="itc-val">{{nationalData.ingredientStats30d.flourKg}}kg</text>
            <text class="itc-lbl">🌽 面粉</text>
          </view>
          <view class="itc-cell" wx:if="{{nationalData.ingredientStats30d.oilKg > 0}}">
            <text class="itc-val">{{nationalData.ingredientStats30d.oilKg}}kg</text>
            <text class="itc-lbl">🫗 食用油</text>
          </view>
          <view class="itc-cell" wx:if="{{nationalData.ingredientStats30d.veggieKg > 0}}">
            <text class="itc-val">{{nationalData.ingredientStats30d.veggieKg}}kg</text>
            <text class="itc-lbl">🥬 蔬菜</text>
          </view>
        </view>
        <view class="itc-forecast" wx:if="{{nationalData.ingredientStats30d.estimatedMonthlySupplyNeeds}}">
          <text class="itc-forecast-text">💡 {{nationalData.ingredientStats30d.estimatedMonthlySupplyNeeds}}</text>
        </view>
      </view>

      <!-- 志工荣誉版温馨提示 -->
      <view class="volunteer-warm-tip" wx:if="{{isVolunteerNationalView}}">
        <text class="tip-text">用一餐饭的温度，传递温暖与关爱。每一餐，都有您的爱心护持。</text>
      </view>
    </view>

    <!-- 👵 义工与用餐服务数据看板：全国长者关怀总力场。
         数据来自 getNationalDashboard 新增的 nationalDineInSeniors 等字段，
         totalDiningCount/totalVolunteerPersonTimes/totalServicePersonTimes 由
         loadNationalDashboard 客户端算术派生（不额外发起云调用）。
         所有指标均为服务成果类（非财务），全角色可见，不走脱敏分支。
         仅当至少一个细分维度有数据时才展示，防止老数据时代全0卡片占位。
         🆕 结构重排：原 2x4 均质方格改为「深色科技 Hero Banner（用餐总数/
         志愿者总人次两大核心 KPI）+ 助餐服务/义工力量两组浅色网格 + 结构比例条」
         三段式，信息层级从"九个数字并排"变成"总览 → 分组明细"。深色底色是
         本卡片专属处理，与页面其余浅色卡片形成有意的视觉分层——全国大屏里
         信息密度最高、最具展示性的旗舰指标区，值得单独做"聚光灯"式呈现。
         看板内数值全部走 careDisplay.*（由 animateCareCountUp 驱动 0 → 目标值
         的滚动动画），wx:if 可见性判断仍读原始 nationalData.* 字段，不受动画
         中间态影响。 -->
    <view class="care-board" wx:if="{{nationalData.nationalDineInSeniors > 0 || nationalData.nationalDeliverySeniors > 0 || nationalData.nationalListeningSeniors > 0 || nationalData.nationalTakeawayCount > 0 || nationalData.nationalDeliveryVolunteers > 0}}">

      <!-- Hero Banner：两大核心 KPI + 自动计算状态提示 -->
      <view class="cb-hero">
        <view class="cb-hero-top">
          <view class="cb-hero-title-row">
            <view class="cb-svg-icon cb-icon-heart"></view>
            <text class="cb-hero-title">义工与用餐服务</text>
          </view>
          <view class="cb-hero-badge">
            <view class="cb-svg-icon cb-icon-sparkle"></view>
            <text class="cb-hero-badge-text">数据自动计算</text>
          </view>
        </view>
        <view class="cb-hero-kpis">
          <view class="cb-hero-kpi cb-hero-kpi-hot">
            <text class="cb-hero-kpi-val">{{careDisplay.totalDiningCount}}</text>
            <text class="cb-hero-kpi-lbl">用餐总数（人/份）</text>
            <text class="cb-hero-kpi-formula">堂食 + 送餐 + 打包</text>
          </view>
          <view class="cb-hero-kpi-divider"></view>
          <view class="cb-hero-kpi cb-hero-kpi-warm">
            <text class="cb-hero-kpi-val">{{careDisplay.totalVolunteerPersonTimes}}</text>
            <text class="cb-hero-kpi-lbl">志愿者总人次</text>
            <text class="cb-hero-kpi-formula">到岗 + 送餐</text>
          </view>
        </view>
        <view class="cb-hero-foot">
          <text class="cb-hero-foot-text">六项人次汇总（含倾听陪伴）</text>
          <text class="cb-hero-foot-val">{{careDisplay.totalServicePersonTimes}} 人次</text>
        </view>
      </view>

      <!-- 助餐服务统计组 -->
      <view class="cb-group">
        <text class="cb-group-title">助餐服务统计</text>
        <view class="cb-group-grid cols-3">
          <view class="cb-cell" wx:if="{{nationalData.nationalDineInSeniors >= 0}}">
            <view class="cb-svg-icon cb-icon-bowl"></view>
            <text class="cb-cell-val">{{careDisplay.dineIn}}</text>
            <text class="cb-cell-lbl">堂食长者</text>
            <text class="cb-cell-unit">人</text>
          </view>
          <view class="cb-cell" wx:if="{{nationalData.nationalDeliverySeniors >= 0}}">
            <view class="cb-svg-icon cb-icon-truck"></view>
            <text class="cb-cell-val">{{careDisplay.delivery}}</text>
            <text class="cb-cell-lbl">送餐长者</text>
            <text class="cb-cell-unit">人</text>
          </view>
          <view class="cb-cell" wx:if="{{nationalData.nationalTakeawayCount >= 0}}">
            <view class="cb-svg-icon cb-icon-package"></view>
            <text class="cb-cell-val">{{careDisplay.takeaway}}</text>
            <text class="cb-cell-lbl">打包份数</text>
            <text class="cb-cell-unit">份</text>
          </view>
        </view>
      </view>

      <!-- 义工力量与服务关怀组 -->
      <view class="cb-group">
        <text class="cb-group-title">义工力量与服务关怀</text>
        <view class="cb-group-grid cols-4">
          <view class="cb-cell">
            <view class="cb-svg-icon cb-icon-users"></view>
            <text class="cb-cell-val">{{careDisplay.onDutyVolunteers}}</text>
            <text class="cb-cell-lbl">到岗志愿者</text>
            <text class="cb-cell-unit">人</text>
          </view>
          <view class="cb-cell">
            <view class="cb-svg-icon cb-icon-truck"></view>
            <text class="cb-cell-val">{{careDisplay.deliveryVolunteers}}</text>
            <text class="cb-cell-lbl">送餐志愿者</text>
            <text class="cb-cell-unit">人</text>
          </view>
          <view class="cb-cell cb-cell-accent">
            <view class="cb-svg-icon cb-icon-headphones"></view>
            <text class="cb-cell-val">{{careDisplay.listen}}</text>
            <text class="cb-cell-lbl">倾听陪伴</text>
            <text class="cb-cell-unit">人次</text>
          </view>
          <view class="cb-cell">
            <view class="cb-svg-icon cb-icon-clock"></view>
            <text class="cb-cell-val">{{careDisplay.volunteerHours}}</text>
            <text class="cb-cell-lbl">累计服务工时</text>
            <text class="cb-cell-unit">小时</text>
          </view>
        </view>
      </view>

      <!-- 服务结构比例条：堂食 vs 送餐 vs 倾听（替代饼图，纯 CSS，不需要 ECharts） -->
      <view class="cb-ratio-section" wx:if="{{nationalData.nationalDineInSeniors > 0 || nationalData.nationalDeliverySeniors > 0 || nationalData.nationalListeningSeniors > 0}}">
        <text class="cb-ratio-title">长者服务结构分布</text>
        <view class="cb-ratio-bar-wrap">
          <!-- 各段宽度由 nationalData.*RatioPct 驱动，TS 侧在 loadNationalDashboard 计算 -->
          <view class="cb-ratio-seg seg-dine-in"  style="width:{{nationalData.dineInRatioPct}}%"  wx:if="{{nationalData.dineInRatioPct > 0}}"></view>
          <view class="cb-ratio-seg seg-delivery" style="width:{{nationalData.deliveryRatioPct}}%" wx:if="{{nationalData.deliveryRatioPct > 0}}"></view>
          <view class="cb-ratio-seg seg-listen"   style="width:{{nationalData.listenRatioPct}}%"  wx:if="{{nationalData.listenRatioPct > 0}}"></view>
        </view>
        <view class="cb-ratio-legend">
          <view class="cb-legend-item" wx:if="{{nationalData.dineInRatioPct > 0}}">
            <view class="legend-dot dot-dine-in"></view>
            <text class="legend-text">堂食 {{nationalData.dineInRatioPct}}%</text>
          </view>
          <view class="cb-legend-item" wx:if="{{nationalData.deliveryRatioPct > 0}}">
            <view class="legend-dot dot-delivery"></view>
            <text class="legend-text">送餐 {{nationalData.deliveryRatioPct}}%</text>
          </view>
          <view class="cb-legend-item" wx:if="{{nationalData.listenRatioPct > 0}}">
            <view class="legend-dot dot-listen"></view>
            <text class="legend-text">倾听 {{nationalData.listenRatioPct}}%</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 🆕 义工与用餐服务数据看板·空状态：全国范围内所有细分维度都是 0（老
         数据时代或刚接入的新平台）。与上方深色 Hero 卡片同宽同位，避免整块
         区域直接消失让人以为功能缺失 -->
    <view class="cb-empty" wx:elif="{{nationalData.nationalDineInSeniors !== undefined}}">
      <view class="cb-svg-icon cb-icon-bowl cb-empty-icon"></view>
      <text class="cb-empty-text">暂无义工与用餐服务数据</text>
      <text class="cb-empty-sub">各站点提交每日报表后，这里会自动汇总全国数据</text>
    </view>

    <!-- 💖 全网爱心支持与善缘墙：完整面板——支持总人次 + 阳善/阴德细分（人次+
         金额）+ 最新公开（阳善）支持滚动墙。
         🐛 修复：此前只有一枚"总人次"KPI，阳善/阴德细分与滚动墙都被误移去了
         个人中心页——但那边是单店口径（getSunshineLedger），这里的全国大屏
         需要的是跨店聚合视角（含 [门店名称]），两者是不同场景，不能互相替代。
         个人中心页保留它自己单店口径的版本，这里恢复全国口径的完整版。
         nationalOfflineIncome/yangshanAmount/yindeAmount 属财务数据，对志工脱敏
         （云函数出口 + utils/dataService.ts 双层遮罩）；总人次/阳善阴德人次为
         服务成果类公开数据，全角色可见。 -->
    <view class="love-wall-card" wx:if="{{nationalData.nationalSponsorCount > 0 || nationalData.nationalOfflineIncome > 0}}">
      <view class="love-wall-header">
        <text class="love-wall-title">💖 全网爱心支持与善缘墙</text>
        <text class="love-wall-sub">了凡四训 · 阳善积德</text>
      </view>

      <!-- 🆕 阳光防篡改存证徽标（2026-08-31）：auditProofSummary 是公信力/
           合规展示指标（覆盖率、是否存在签名缺口），不涉及具体收支金额，
           对所有角色（含志工）一视同仁展示。chainStatus==='VERIFYING' 时
           换一种颜色提示"存在需要核查的数据完整性缺口"，不代表账目被篡改，
           不使用红色等报警色，避免和真正的资金/离线告警混淆 -->
      <view class="audit-proof-badge audit-proof-{{nationalData.auditProofSummary.chainStatus}}" wx:if="{{nationalData.auditProofSummary}}">
        <text class="audit-proof-icon">🛡️</text>
        <text class="audit-proof-text">财务核账存证保护中 · 覆盖率 {{nationalData.auditProofSummary.auditCoverageRate}}</text>
      </view>

      <!-- KPI 行：支持人次 + 现场随喜总额（随喜总额对志工脱敏） -->
      <view class="love-kpi-row">
        <view class="love-kpi-cell">
          <text class="love-kpi-val">{{nationalData.totalSupportCount}}</text>
          <text class="love-kpi-lbl">全网爱心支持总人次</text>
        </view>
        <view class="love-kpi-divider"></view>
        <view class="love-kpi-cell" wx:if="{{isManager && nationalData.nationalOfflineIncome > 0}}">
          <text class="love-kpi-val">¥{{nationalData.nationalOfflineIncome}}</text>
          <text class="love-kpi-lbl">全网现场随喜总额</text>
        </view>
        <view class="love-kpi-cell" wx:elif="{{!isManager}}">
          <text class="love-kpi-val masked-love">***</text>
          <text class="love-kpi-lbl">全网现场随喜总额</text>
        </view>
      </view>

      <!-- 🆕 阳善 / 阴德细分：人次 + 金额，金额对志工脱敏。yangshanCount+yindeCount
           恒等于上方 totalSupportCount（同一份 donationItems 明细的两个子集） -->
      <view class="love-merit-split-row">
        <view class="love-merit-split-cell yang">
          <text class="love-merit-split-icon">🌟</text>
          <view class="love-merit-split-info">
            <text class="love-merit-split-val">{{nationalData.yangshanCount}} 人次</text>
            <text class="love-merit-split-amount" wx:if="{{isManager}}">¥{{nationalData.yangshanAmount}}</text>
            <text class="love-merit-split-amount masked" wx:else>¥***</text>
            <text class="love-merit-split-lbl">阳善（公开）</text>
          </view>
        </view>
        <view class="love-merit-split-cell yin">
          <text class="love-merit-split-icon">🌙</text>
          <view class="love-merit-split-info">
            <text class="love-merit-split-val">{{nationalData.yindeCount}} 人次</text>
            <text class="love-merit-split-amount" wx:if="{{isManager}}">¥{{nationalData.yindeAmount}}</text>
            <text class="love-merit-split-amount masked" wx:else>¥***</text>
            <text class="love-merit-split-lbl">积阴德（匿名）</text>
          </view>
        </view>
      </view>

      <!-- 公开爱心支持滚动墙：仅阳善（公开姓名）条目，垂直 swiper -->
      <view class="love-scroll-section" wx:if="{{nationalData.latestPublicDonors && nationalData.latestPublicDonors.length > 0}}">
        <text class="love-scroll-title">✨ 最新爱心支持（阳善公开）</text>
        <swiper class="love-scroll-swiper" vertical autoplay circular interval="2800" duration="400">
          <!-- 🐛 latestPublicDonors 每一项是对象（{name, amount, storeName, timeLabel}），
               wx:key="*this" 会把整个对象字面转成字符串当 key，多条记录会撞 key，
               改用 wx:for-index 提供的下标作为 key -->
          <swiper-item wx:for="{{nationalData.latestPublicDonors}}" wx:for-index="donorIdx" wx:key="donorIdx">
            <view class="love-scroll-item">
              <text class="love-scroll-store">[{{item.storeName}}]</text>
              <text class="love-scroll-name">{{item.name}}</text>
              <!-- 🆕 已存证微标：hasAuditProof===true 时点亮，反映这条记录所在
                   报表已通过财务稽核封账（AUDITED_LOCKED），见
                   getNationalDashboard formatDonorDisplayName 调用处附近的
                   hasAuditProof 打标注释 -->
              <text class="audit-proof-mini-tag" wx:if="{{item.hasAuditProof}}">✅已存证</text>
              <text class="love-scroll-amount">支持 ¥{{item.amount}}</text>
              <text class="love-scroll-time" wx:if="{{item.timeLabel}}">· {{item.timeLabel}}</text>
            </view>
          </swiper-item>
        </swiper>
      </view>
    </view>

    <!-- 📸 全网影像卷宗与凭证审计：超管专属，展示三类照片总量 KPI + 最新 12 张影像墙 -->
    <view class="national-media-card" wx:if="{{superAdminInsights && superAdminInsights.nationalTotalPhotos !== undefined}}">
      <!-- 🆕 标题区改为纵向堆叠：原横向 flex + baseline 对齐在标题较长时会与
           副标题挤在同一行造成折行错位（见截图反馈），纵向布局不受标题长度影响 -->
      <view class="nm-header">
        <text class="nm-title">📸 全网影像卷宗与阳光凭证</text>
        <text class="nm-sub">凭证 · 食谱 · 活动日志</text>
      </view>

      <!-- 🆕 KPI 小卡片补充图标圆徽，emoji 从文字标签里独立出来，数值/图标/文案
           三级视觉层次更清晰，也便于图标与数值分别做样式微调 -->
      <view class="nm-kpi-row">
        <view class="nm-kpi-card">
          <text class="nm-kpi-icon">🧾</text>
          <text class="nm-kpi-val">{{superAdminInsights.totalReceiptPhotos || 0}}</text>
          <text class="nm-kpi-lbl">凭证照片</text>
        </view>
        <view class="nm-kpi-card">
          <text class="nm-kpi-icon">🍱</text>
          <text class="nm-kpi-val">{{superAdminInsights.totalMenuPhotos || 0}}</text>
          <text class="nm-kpi-lbl">食谱照片</text>
        </view>
        <view class="nm-kpi-card">
          <text class="nm-kpi-icon">📷</text>
          <text class="nm-kpi-val">{{superAdminInsights.totalLogPhotos || 0}}</text>
          <text class="nm-kpi-lbl">日志照片</text>
        </view>
      </view>
      <view class="nm-total-row">
        <text class="nm-total-label">📁 档案合计</text>
        <text class="nm-total-val">{{superAdminInsights.nationalTotalPhotos || 0}} 张</text>
      </view>

      <!-- 最新影像墙：3 列网格，lazy-load，点击全屏预览。
           🆕 头部补充"已展示 X/共 Y 张"，让超管知道这只是最新一批而非全量 -->
      <view class="nm-gallery-header" wx:if="{{nationalMediaGallery.length > 0}}">
        <text class="nm-gallery-title">最新上传影像</text>
        <text class="nm-gallery-count" wx:if="{{(superAdminInsights.nationalTotalPhotos || 0) > nationalMediaGallery.length}}">
          已展示 {{nationalMediaGallery.length}}/{{superAdminInsights.nationalTotalPhotos}} 张
        </text>
      </view>
      <view class="nm-gallery-grid" wx:if="{{nationalMediaGallery.length > 0}}">
        <view
          class="nm-gallery-item"
          hover-class="nm-gallery-item-hover"
          hover-stay-time="80"
          wx:for="{{nationalMediaGallery}}"
          wx:key="url"
          data-index="{{index}}"
          bindtap="onPreviewNationalPhoto"
        >
          <!-- 🆕 图片加载失败时（临时链接过期等）用占位图标兜底，避免网格里露出
               微信默认的裂图图标 -->
          <view class="nm-gallery-img-fallback" wx:if="{{item.loadError}}">
            <text class="nm-fallback-icon">🖼️</text>
          </view>
          <image
            wx:else
            class="nm-gallery-img"
            src="{{item.url}}"
            mode="aspectFill"
            lazy-load="{{true}}"
            data-index="{{index}}"
            binderror="onNationalPhotoError"
          />
          <view class="nm-gallery-tag-row">
            <text class="nm-tag nm-tag-{{item.type}}">
              {{item.type === 'receipt' ? '🧾' : item.type === 'menu' ? '🍱' : '📷'}}
            </text>
            <text class="nm-tag-store">{{item.storeName}}</text>
            <!-- 🆕 平台徽章：区分影像来源属于哪一类业态站点——平台类型筛选 Tab
                 已移除（大盘固定展示全部平台），不再需要按筛选状态判断是否展示 -->
            <text class="nm-tag-org">{{item.orgTypeLabel}}</text>
          </view>
        </view>
      </view>
      <!-- 🆕 空状态改为图标 + 主文案 + 引导副文案三段式，替换原先单行灰字 -->
      <view class="nm-gallery-empty" wx:elif="{{nationalMediaGallery.length === 0}}">
        <text class="nm-empty-icon">🗂️</text>
        <text class="nm-empty-text">暂无影像档案</text>
        <text class="nm-empty-sub">请先上传凭证或食谱照片，影像会自动汇总到这里</text>
      </view>
    </view>

    <!-- 🚨 门店健康度告警中心：由 deriveSupportNeededStores 在客户端从 storeMatrix
         派生，仅当存在风险得分 > 0 的门店时渲染列表；severity 三档 → 危险红/警示橙/
         提示黄。原「待支援爱心站点预警」与超管治理面板里的「离线门店预警」两块
         卡片已合并——deriveSupportNeededStores 的评分维度本就把"离线未记账"计入
         +40 分并生成"离线 X 天未记账"原因标签（见该函数注释），离线站点必然已经
         出现在这份列表里，原来的 offline-store-list 只是同一份数据的窄化重复展示，
         合并后不丢任何信息，还消除了两张卡片间的数据/视觉不一致。
         🆕 卡片本身不再受 supportNeededStores.length 门槛限制：即便当前 0 家待支援，
         也常驻渲染卡片本身并切换为"运行正常"空状态，而不是整块消失——让大家长/超管
         明确知道"系统检查过、结果是没有风险"，而非"这块功能暂时看不到" -->
    <view class="health-alert-card" wx:if="{{isPatriarch || isAdmin}}">
      <view class="health-alert-header">
        <view class="health-alert-title-row">
          <view class="health-alert-pulse {{supportNeededStores.length > 0 ? 'critical' : 'normal'}}"></view>
          <text class="health-alert-title">{{supportNeededStores.length > 0 ? '🚨 门店健康度告警中心' : '✅ 全网站点运行正常'}}</text>
        </view>
        <text class="health-alert-count" wx:if="{{supportNeededStores.length > 0}}">{{supportNeededStores.length}} 家需关注</text>
      </view>

      <view class="health-alert-list" wx:if="{{supportNeededStores.length > 0}}">
        <view
          class="health-alert-item severity-{{item.severity}}"
          wx:for="{{supportNeededStores}}"
          wx:key="storeId"
        >
          <view class="hai-top-row">
            <!-- 左侧：严重程度指示点 + 门店名称与省市位置 -->
            <view class="hai-left">
              <view class="hai-dot severity-dot-{{item.severity}}"></view>
              <view class="hai-info">
                <view class="hai-name-row">
                  <text class="hai-location" wx:if="{{item.location}}">【{{item.location}}】</text>
                  <text class="hai-name">{{item.storeName}}</text>
                  <!-- 🆕 平台徽章：区分待支援站点所属业态——平台类型筛选 Tab 已移除
                       （大盘固定展示全部平台），不再需要按筛选状态判断是否展示 -->
                  <text class="hai-org-tag">{{item.orgTypeLabel}}</text>
                </view>
                <text class="hai-score hai-score-{{item.severity}}">风险分 {{item.supportScore}}</text>
              </view>
            </view>
            <!-- 右侧：危险红/警示橙圆角 Tag，靠右对齐展示，排查一眼可见。
                 🆕 原因标签最多展示 2 条（reasonTags 已按扣分权重降序排列，见
                 deriveSupportNeededStores），超过部分折叠成"+N"徽标——此前风险因素
                 多的门店（如同时离线+资金告急+合规不足）会堆出 3~4 个满宽度胶囊，
                 把整行撑得很高，与旁边只有 1 条标签的门店行高差异悬殊 -->
            <view class="hai-right">
              <text
                class="hai-tag hai-tag-{{item.severity}}"
                wx:for="{{item.reasonTags}}"
                wx:key="*this"
                wx:for-item="tag"
                wx:if="{{index < 2}}"
              >{{tag}}</text>
              <text class="hai-tag-more" wx:if="{{item.reasonTags.length > 2}}">+{{item.reasonTags.length - 2}}</text>
            </view>
          </view>
          <!-- 🆕 失联告警一键督导触达（2026-08-31）：两个按钮对任意告警门店都
               常驻展示——managerPhone 只在 CRITICAL/OFFLINE 门店由服务端下发
               （见 getNationalDashboard isSuperAdmin || isPatriarchCaller 判断），
               缺失时 onCallStoreManager 自己兜底改为复制门店名称，不需要在
               WXML 里预判"有没有电话"再决定要不要渲染按钮 -->
          <view class="hai-actions">
            <view class="hai-action-btn" hover-class="ui-hover" bindtap="onCallStoreManager" data-item="{{item}}">
              <text class="hai-action-icon">📞</text>
              <text class="hai-action-text">一键联系</text>
            </view>
            <view class="hai-action-btn" hover-class="ui-hover" bindtap="onCopyCareMessage" data-item="{{item}}">
              <text class="hai-action-icon">💌</text>
              <text class="hai-action-text">督导关怀</text>
            </view>
          </view>
        </view>
      </view>
      <!-- 🆕 空状态兜底 -->
      <view class="health-alert-empty" wx:else>
        <text class="health-alert-empty-text">各站点资金、记账与合规状态均正常，暂无需要支援的站点</text>
      </view>

      <view class="health-alert-footer" wx:if="{{supportNeededStores.length > 0}}">
        <text class="health-alert-tip">💡 风险分 = 失联(+45)/离线(+30) · 资金告急(+40)/预警(+20) · 赤字(+20) · 主料告急(+25) · 合规(+10)</text>
      </view>
    </view>

    <!-- 🆕 爱心互助与调拨建议（2026-08-30 首版，2026-08-31 升级为
         rebalanceSuggestions 结构化撮合结果，同日再迭代为最终 UI 交互）：
         同机构内"受援门店"（资金续航 ≤7 天或主料库存告急）与"支援门店"
         （资金续航 ≥45 天）轻量撮合，帮大家长/超管一眼看出"该找哪家兄弟
         门店求助"。🐛 与上一版不同：无受援门店时整张卡片优雅隐藏（不再
         常驻展示正向空状态）——门店健康度告警中心已经承担了"系统检查过、
         没有风险"的常驻反馈职责，这张卡片本身只服务于"有事要办"的场景，
         没有建议时不需要再占一屏版面 -->
    <view class="support-suggestion-card" wx:if="{{nationalData.rebalanceSuggestions && nationalData.rebalanceSuggestions.length > 0}}">
      <view class="matrix-header">
        <text class="matrix-title">🤝 爱心互助与调拨建议</text>
      </view>
      <view class="support-suggestion-list">
        <view class="support-suggestion-item" wx:for="{{nationalData.rebalanceSuggestions}}" wx:key="targetStoreId">
          <view class="ssi-header">
            <text class="ssi-store">🏪 {{item.targetStoreName}}</text>
            <text class="ssi-urgency-tag ssi-urgency-{{item.urgency}}">{{item.urgency === 'HIGH' ? '紧急' : '关注'}}</text>
          </view>
          <!-- 撮合成功：同城/同省有支援门店 -->
          <text class="ssi-text" wx:if="{{item.sourceStoreName}}">🤝 建议 <text class="ssi-store-bold">{{item.targetStoreName}}</text> 向同城/周边 <text class="ssi-store-bold">{{item.sourceStoreName}}</text> 申请爱心平调（对方资金续航 {{item.sourceFundingDays}} 天）</text>
          <!-- 撮合不到：改走对外劝募 -->
          <text class="ssi-text" wx:else>📢 <text class="ssi-store-bold">{{item.targetStoreName}}</text> {{item.reason}}（建议发起定向爱心倡议与劝募）</text>
          <view class="ssi-footer">
            <view class="ssi-copy-btn" hover-class="ui-hover" bindtap="onCopyRebalanceSuggestion" data-item="{{item}}">
              <text class="ssi-copy-icon">📋</text>
              <text class="ssi-copy-text">复制建议</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="national-matrix-card">
      <view class="matrix-header">
        <text class="matrix-title">📊 全国门店运营健康度概览</text>
      </view>

      <!-- 一键快筛：isOffline/hasRiskFlag 是 getNationalDashboard 服务端仅对 super_admin
           下发的字段，快筛入口只在超管视角展示，其余角色沿用不筛选的完整列表 -->
      <view class="matrix-filter-row" wx:if="{{isAdmin}}">
        <view class="matrix-filter-tab {{storeMatrixFilter === 'normal' ? 'active' : ''}}" data-filter="normal" bindtap="onSwitchMatrixFilter">正常运营门店</view>
        <view class="matrix-filter-tab {{storeMatrixFilter === 'risk' ? 'active' : ''}}" data-filter="risk" bindtap="onSwitchMatrixFilter">需关注预警门店</view>
      </view>

      <view class="matrix-table">
        <view class="table-thead">
          <text class="th col-store">门店名称</text>
          <text class="th col-cost">单餐成本</text>
          <text class="th col-diners">服务人次</text>
          <text class="th col-status">续航预警</text>
        </view>

        <view class="table-tbody">
          <view
            class="table-tr {{item.statusLevel === 'urgent' ? 'risk-row' : ''}}"
            wx:for="{{nationalMatrixList}}"
            wx:key="storeId"
            wx:if="{{!isAdmin || (storeMatrixFilter === 'risk' ? (item.isOffline || item.hasRiskFlag) : !(item.isOffline || item.hasRiskFlag))}}"
          >
            <view class="td col-store">
              <text class="font-bold">{{item.storeName}}</text>
              <!-- 🆕 已存证微标：门店最新一条记录已通过财务稽核封账 -->
              <text class="audit-proof-mini-tag" wx:if="{{item.hasAuditProof}}">✅已存证</text>
            </view>
            <!-- 🌟 志工视角：门店成本属运营敏感数据，列保留但数值以 *** 屏蔽（服务端已同步做空值处理，而非仅前端隐藏） -->
            <view class="td col-cost" wx:if="{{isManager}}">
              <text class="cost-badge {{item.isCostValid ? 'valid' : 'neutral'}}">{{item.costPerMealStr}}</text>
            </view>
            <view class="td col-cost" wx:else>
              <text class="cost-badge masked">{{item.costPerMealStr}}</text>
            </view>
            <text class="td col-diners">{{item.totalDiners}} 人</text>
            <view class="td col-status">
              <text class="warning-pill {{item.statusLevel}}">{{item.statusText}}</text>
            </view>
          </view>

          <view class="matrix-filter-empty" wx:if="{{isAdmin && storeMatrixFilter === 'risk' && superAdminInsights && superAdminInsights.riskStoreCount === 0}}">
            <text>🎉 暂无需要关注的预警门店，各门店运营正常</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 🆕 多店排行榜/对比模块：超管专属，纯客户端从 nationalMatrixList 派生出的
         Top 5——"报表活跃度"按 openDays（本次统计窗口内实际提交过餐报的天数）
         降序，"餐饮服务人次"按 totalDiners 降序，让全景界面具备真正的跨店透视。
         🆕 原先纵向堆叠的两份榜单改为 Tab 切换单一列表，压缩垂直高度；前三名
         使用金/银/铜三色数字徽章（.ranking-badge.rank-1/2/3），一眼可辨名次 -->
    <view class="national-ranking-card" wx:if="{{isAdmin}}">
      <view class="matrix-header">
        <text class="matrix-title">🏅 全国门店排行榜</text>
      </view>

      <view class="ranking-tab-row">
        <view class="ranking-tab-item {{rankingTab === 'active' ? 'active' : ''}}" data-tab="active" bindtap="onSwitchRankingTab">📋 餐报活跃度</view>
        <view class="ranking-tab-item {{rankingTab === 'diners' ? 'active' : ''}}" data-tab="diners" bindtap="onSwitchRankingTab">🍚 服务人次</view>
      </view>

      <view class="ranking-list" wx:if="{{rankingTab === 'active'}}">
        <view class="ranking-item" wx:for="{{nationalTopActiveStores}}" wx:key="storeId" wx:for-index="rankIdx">
          <text class="ranking-badge rank-{{rankIdx + 1}}">{{rankIdx + 1}}</text>
          <text class="ranking-name">{{item.storeName}}</text>
          <!-- 🆕 平台徽章：区分排行榜条目所属业态——平台类型筛选 Tab 已移除
               （大盘固定展示全部平台），不再需要按筛选状态判断是否展示 -->
          <text class="ranking-org-tag">{{item.orgTypeLabel}}</text>
          <text class="ranking-value">{{item.openDays}} 天</text>
        </view>
        <view class="ranking-empty" wx:if="{{nationalTopActiveStores.length === 0}}">
          <text>暂无门店报表数据</text>
        </view>
      </view>

      <view class="ranking-list" wx:if="{{rankingTab === 'diners'}}">
        <view class="ranking-item" wx:for="{{nationalTopDinersStores}}" wx:key="storeId" wx:for-index="rankIdx">
          <text class="ranking-badge rank-{{rankIdx + 1}}">{{rankIdx + 1}}</text>
          <text class="ranking-name">{{item.storeName}}</text>
          <!-- 🆕 平台徽章：区分排行榜条目所属业态——平台类型筛选 Tab 已移除
               （大盘固定展示全部平台），不再需要按筛选状态判断是否展示 -->
          <text class="ranking-org-tag">{{item.orgTypeLabel}}</text>
          <text class="ranking-value">{{item.totalDiners}} 人次</text>
        </view>
        <view class="ranking-empty" wx:if="{{nationalTopDinersStores.length === 0}}">
          <text>暂无门店服务数据</text>
        </view>
      </view>
    </view>

    <!-- 🌟 超管专属高阶治理面板：核心指标/时间切片/CSV 报表导出。黑金配色区别于
         页面其余白底卡片，标示这是超管权限专区。
         superAdminInsights 由 getNationalDashboard 云函数在二次校验 role==='super_admin'
         后才下发，非超管账号该字段恒为 null，wx:if 双重把关（isAdmin + 数据本身存在）。
         🆕 原先内嵌的「离线门店预警」清单已并入上方「门店健康度告警中心」（同一份
         风险评分数据源，见该卡片注释），此处不再重复渲染；"超X天未记账门店数"
         汇总指标仍保留在下方次级指标行，作为治理面板自己的统计摘要。
         🆕 报表导出按钮移至页面底部固定操作栏，与"生成全国公示海报"并排，
         不再作为卡片内嵌按钮 -->
    <view class="super-admin-insights-card" wx:if="{{isAdmin && superAdminInsights}}">
      <view class="matrix-header">
        <text class="matrix-title">🛡️ 超管高阶治理面板</text>
      </view>

      <!-- 高对比度核心数据卡：总累计服务餐次/总爱心支出/活跃门店数量/今日预警门店数 -->
      <view class="insights-metric-grid hero-contrast">
        <view class="insights-metric-cell hero-contrast-cell">
          <text class="insights-metric-val">{{nationalData.nationalTotalDinersDisplay}}</text>
          <text class="insights-metric-lbl">总累计服务餐次</text>
        </view>
        <view class="insights-metric-cell hero-contrast-cell">
          <text class="insights-metric-val">¥{{nationalData.nationalTotalExpenseDisplay}}</text>
          <text class="insights-metric-lbl">总爱心支出金额</text>
        </view>
        <view class="insights-metric-cell hero-contrast-cell">
          <text class="insights-metric-val">{{superAdminInsights.activeStoreCount}}</text>
          <text class="insights-metric-lbl">活跃门店数量</text>
        </view>
        <view class="insights-metric-cell hero-contrast-cell {{superAdminInsights.riskStoreCount > 0 ? 'warn' : ''}}">
          <text class="insights-metric-val">{{superAdminInsights.riskStoreCount}}</text>
          <text class="insights-metric-lbl">今日预警门店数</text>
        </view>
      </view>

      <view class="insights-metric-grid">
        <view class="insights-metric-cell">
          <text class="insights-metric-val">{{superAdminInsights.avgCostPerMealStr === '—' ? '—' : '¥' + superAdminInsights.avgCostPerMealStr}}</text>
          <text class="insights-metric-lbl">全国平均单餐成本</text>
        </view>
        <view class="insights-metric-cell">
          <text class="insights-metric-val">{{superAdminInsights.complianceRate === null ? '暂无数据' : superAdminInsights.complianceRate + '%'}}</text>
          <text class="insights-metric-lbl">全国凭证合规率</text>
        </view>
        <view class="insights-metric-cell {{superAdminInsights.offlineStoreCount > 0 ? 'warn' : ''}}">
          <text class="insights-metric-val">{{superAdminInsights.offlineStoreCount}}</text>
          <text class="insights-metric-lbl">超{{superAdminInsights.offlineAlertThresholdDays}}天未记账门店</text>
        </view>
      </view>
    </view>

    <view class="compliance-disclaimer">
      <text class="compliance-disclaimer-text">本平台仅用于爱心餐报与志愿服务记录，不直接面向公众发起公开募捐；如涉及个人信息，已在前端做脱敏展示处理。</text>
    </view>

    <!-- 🆕 底部固定操作栏：原先分散在治理面板内（报表）与卡片外（海报）的两个
         独立按钮，合并为吸底双按钮组合。海报为主按钮（红色渐变高亮），报表为
         次按钮（黑金配色，呼应上方治理面板），与非全国视角的 .bottom-sticky-bar
         同一套吸底规范，靠 padding-bottom 在 .national-dashboard-container 里
         预留出安全间距，不遮挡最后一张卡片 -->
    <view class="bottom-sticky-bar national-bottom-bar" wx:if="{{isAdmin}}">
      <button class="btn-national-report" hover-class="ui-hover" bindtap="onOpenNationalReportModal">📄 生成运营/财务报表</button>
      <button class="btn-primary-poster national-poster-btn" hover-class="ui-hover" bindtap="onGenerateNationalPoster">🖼️ 生成全国公示海报</button>
    </view>
    <view class="national-bottom-bar-spacer" wx:if="{{isAdmin}}"></view>
    </block>
  </view>

  <!-- 🌟 超管专属：全国运营/财务报表生成弹窗（结构对齐本页既有 .patch-modal-mask 弹窗写法） -->
  <view class="patch-modal-mask" wx:if="{{showNationalReportModal}}">
    <view class="patch-modal-box">
      <view class="modal-header">
        <text class="modal-title">📄 生成全国运营/财务报表</text>
        <text class="btn-close" bindtap="onCloseNationalReportModal">✕</text>
      </view>

      <view class="report-check-item" data-key="operations" bindtap="onToggleReportSelection">
        <checkbox checked="{{nationalReportSelection.operations}}" color="#8C1D18" />
        <text>全国门店运营汇总表（服务人次/开餐天数/单餐成本/续航预警）</text>
      </view>
      <view class="report-check-item" data-key="financeAudit" bindtap="onToggleReportSelection">
        <checkbox checked="{{nationalReportSelection.financeAudit}}" color="#8C1D18" />
        <text>全国财务与凭证审计表（收支/结余/凭证合规率）</text>
      </view>

      <view class="modal-footer">
        <button class="btn-modal-cancel" bindtap="onCopyNationalReport" disabled="{{generatingNationalReport}}">复制到剪贴板</button>
        <button class="btn-modal-submit" bindtap="onExportNationalReport" disabled="{{generatingNationalReport}}" loading="{{generatingNationalReport}}">导出下载</button>
      </view>
    </view>
  </view>

  <!-- 🆕（2026-08-31）机构多店合并阳光台账导出确认弹窗：与上面 CSV 报表弹窗
       是两条独立的导出通道——这个走 exportAccountExcel 云函数生成真实的
       多 Sheet .xlsx 工作簿（每店一 Sheet + 总览汇总 Sheet），附带存证核验码，
       而不是客户端聚合出的纯文本 CSV -->
  <view class="patch-modal-mask" wx:if="{{showNationalExcelExportModal}}">
    <view class="patch-modal-box">
      <view class="modal-header">
        <text class="modal-title">📊 导出机构多店合并阳光台账</text>
        <text class="btn-close" bindtap="onCloseNationalExcelExportModal">✕</text>
      </view>

      <view class="export-confirm-desc">
        <text>将本机构名下所有门店近期的开餐人次、财务收支及食材流水明细，合并生成一份标准化 Excel 工作簿（各店一个 Sheet + 机构总览 Sheet），并附带存证核验码，便于理事会/民政核对存档。</text>
      </view>

      <view class="modal-footer">
        <button class="btn-modal-cancel" bindtap="onCloseNationalExcelExportModal" disabled="{{generatingNationalExcelExport}}">取消</button>
        <button class="btn-modal-submit" bindtap="onConfirmNationalExcelExport" disabled="{{generatingNationalExcelExport}}" loading="{{generatingNationalExcelExport}}">确认并导出</button>
      </view>
    </view>
  </view>

  <!-- 🆕 导出配置弹窗：底部「导出当前周期 Excel 账本」快捷入口的落地点，显式
       选定"导出哪段数据"（周期类型 + 年/月），确认后走已有的核对/确认/生成/
       下载全流程（见 onConfirmExportConfig 复用 _autoShowExportPending 机制） -->
  <view class="patch-modal-mask" wx:if="{{showExportConfigModal}}" bindtap="onCloseExportConfigModal">
    <view class="patch-modal-box" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">📊 导出 Excel 账本</text>
        <text class="btn-close" bindtap="onCloseExportConfigModal">✕</text>
      </view>
      <text class="modal-tip">选择要导出的账本周期，确认后自动核对数据并生成表格</text>

      <view class="period-tabs-segment export-config-type-row">
        <view class="tab-item {{exportConfigTab === 'week' ? 'active' : ''}}" data-tab="week" bindtap="onSelectExportConfigTab">周报</view>
        <view class="tab-item {{exportConfigTab === 'month' ? 'active' : ''}}" data-tab="month" bindtap="onSelectExportConfigTab">月报</view>
        <view class="tab-item {{exportConfigTab === 'year' ? 'active' : ''}}" data-tab="year" bindtap="onSelectExportConfigTab">年报</view>
      </view>

      <view class="export-config-picker-row" wx:if="{{exportConfigTab === 'month'}}">
        <picker mode="date" fields="month" value="{{exportConfigYear}}-{{String(exportConfigMonth).padStart(2, '0')}}-01" bindchange="onExportConfigMonthChange">
          <view class="picker-pill-btn">
            <text class="lbl">🗓️ {{exportConfigYear}}年{{exportConfigMonth}}月</text>
            <text class="arrow">▼</text>
          </view>
        </picker>
      </view>
      <view class="export-config-picker-row" wx:elif="{{exportConfigTab === 'year'}}">
        <picker mode="date" fields="year" value="{{exportConfigYear}}-01-01" bindchange="onExportConfigYearChange">
          <view class="picker-pill-btn">
            <text class="lbl">🗓️ {{exportConfigYear}}年</text>
            <text class="arrow">▼</text>
          </view>
        </picker>
      </view>
      <view class="export-config-picker-row" wx:else>
        <view class="picker-pill-btn">
          <text class="lbl">🗓️ 本周（{{weekRangeLabel}}）</text>
        </view>
      </view>

      <view class="modal-footer">
        <button class="btn-modal-cancel" bindtap="onCloseExportConfigModal">取消</button>
        <button class="btn-modal-submit" bindtap="onConfirmExportConfig">生成并下载</button>
      </view>
    </view>
  </view>

  <!-- 🌟「先核对、再确认、后导出」导出预览核对弹窗：exportToExcel 只发起 previewOnly
       查询，真正生成 xlsx 必须等用户在这里点击「确认并导出」 -->
  <view class="patch-modal-mask" wx:if="{{showExportPreviewModal}}">
    <view class="patch-modal-box">
      <view class="modal-header">
        <text class="modal-title">🧾 凭证与账本核对 · {{exportPreviewSummary.periodLabel}}</text>
        <text class="btn-close" bindtap="onCloseExportPreviewModal">✕</text>
      </view>
      <text class="modal-tip">导出前请核对以下明细，确认无误后再导出</text>

      <view class="export-preview-summary-grid">
        <view class="export-preview-summary-cell">
          <text class="export-preview-summary-num income">¥{{exportPreviewSummary.totalIncome}}</text>
          <text class="export-preview-summary-lbl">总收入</text>
        </view>
        <view class="export-preview-summary-cell">
          <text class="export-preview-summary-num expense">¥{{exportPreviewSummary.totalExpense}}</text>
          <text class="export-preview-summary-lbl">总支出</text>
        </view>
        <view class="export-preview-summary-cell">
          <text class="export-preview-summary-num">¥{{exportPreviewSummary.netTotal}}</text>
          <text class="export-preview-summary-lbl">净结余</text>
        </view>
        <view class="export-preview-summary-cell">
          <text class="export-preview-summary-num">{{exportPreviewSummary.recordCount}}</text>
          <text class="export-preview-summary-lbl">总笔数</text>
        </view>
        <view class="export-preview-summary-cell">
          <text class="export-preview-summary-num audited">{{exportPreviewSummary.auditedReceiptCount}}</text>
          <text class="export-preview-summary-lbl">已审核小票数</text>
        </view>
        <view class="export-preview-summary-cell">
          <text class="export-preview-summary-num {{exportPreviewSummary.anomalyCount > 0 ? 'anomaly' : ''}}">{{exportPreviewSummary.anomalyCount}}</text>
          <text class="export-preview-summary-lbl">异常标记数</text>
        </view>
      </view>

      <scroll-view scroll-y class="modal-scroll-list export-preview-list">
        <view class="export-preview-row" wx:for="{{exportPreviewRecords}}" wx:key="date" wx:for-item="rec">
          <text class="row-date">{{rec.date}}</text>
          <text class="export-preview-row-shop">{{rec.shopName}}</text>
          <text class="row-income">收¥{{rec.income}} 支¥{{rec.expense}}</text>
          <text class="export-preview-receipt-badge" wx:if="{{rec.hasReceipt}}">🧾{{rec.receiptCount}}</text>
          <text class="export-preview-receipt-badge is-missing" wx:else>⚠️无票</text>
        </view>
        <view class="empty-box" wx:if="{{exportPreviewRecords.length === 0}}">
          <text class="empty-tip">该周期内暂无明细数据</text>
        </view>
        <view class="fa-safe-area-spacer"></view>
      </scroll-view>

      <view class="modal-footer">
        <button class="btn-modal-cancel" bindtap="onExportPreviewGoFix">发现异常，前去核对</button>
        <button class="btn-modal-submit" bindtap="onExportPreviewConfirm">数据无误，确认并导出</button>
      </view>
    </view>
  </view>

  <!-- 🆕 全国大屏"按地区筛选"弹窗：省份→城市级联选择，两者都留空表示不限地区
       （效果等同"全国总览"，只是走的是这套地区筛选入口） -->
  <view class="patch-modal-mask" wx:if="{{showRegionFilterModal}}">
    <view class="patch-modal-box">
      <view class="modal-header">
        <text class="modal-title">📍 按地区筛选</text>
        <text class="btn-close" bindtap="onCancelRegionFilter">✕</text>
      </view>
      <text class="modal-tip">选择省份/城市后，将只汇总该地区门店的数据；留空表示不限地区</text>

      <!-- 🐛 根因修复：不再使用原生 <picker mode="selector">（点击会在本弹窗之上
           再叠加一层系统底部选择器，两层弹层冲突）。改为弹窗内嵌式下拉——点击
           触发器展开/收起一个绝对定位在触发器正下方的选项面板，全程只有这一个
           半屏弹窗，没有第二层原生弹层 -->
      <view class="region-select-row">
        <view class="region-select-field">
          <view class="region-select-trigger {{showProvinceDropdown ? 'active' : ''}}" bindtap="onToggleProvinceDropdown">
            <text class="lbl">{{selectedProvince || '全部省份'}}</text>
            <text class="arrow">{{showProvinceDropdown ? '▲' : '▼'}}</text>
          </view>
          <view class="region-dropdown-panel" wx:if="{{showProvinceDropdown}}">
            <scroll-view scroll-y class="region-dropdown-scroll">
              <view
                class="region-dropdown-item {{selectedProvinceIndex === idx ? 'active' : ''}}"
                wx:for="{{provincePickerOptions}}"
                wx:key="*this"
                wx:for-index="idx"
                data-index="{{idx}}"
                bindtap="onSelectProvinceOption"
              >{{item}}</view>
            </scroll-view>
          </view>
        </view>

        <view class="region-select-field">
          <view class="region-select-trigger {{showCityDropdown ? 'active' : ''}}" bindtap="onToggleCityDropdown">
            <text class="lbl">{{selectedCity || '全部城市'}}</text>
            <text class="arrow">{{showCityDropdown ? '▲' : '▼'}}</text>
          </view>
          <view class="region-dropdown-panel" wx:if="{{showCityDropdown}}">
            <scroll-view scroll-y class="region-dropdown-scroll">
              <view
                class="region-dropdown-item {{selectedCityIndex === idx ? 'active' : ''}}"
                wx:for="{{cityPickerOptions}}"
                wx:key="*this"
                wx:for-index="idx"
                data-index="{{idx}}"
                bindtap="onSelectCityOption"
              >{{item}}</view>
            </scroll-view>
          </view>
        </view>
      </view>

      <view class="modal-footer">
        <button class="btn-modal-cancel" bindtap="onCancelRegionFilter">取消</button>
        <button class="btn-modal-submit" bindtap="onConfirmRegionFilter">确定</button>
      </view>
    </view>
  </view>

  <!-- 🆕 全国大屏"自定义门店对比"弹窗：勾选多家门店聚合查看，只勾一家即等同"单店视角" -->
  <view class="patch-modal-mask" wx:if="{{showCustomStoreModal}}">
    <view class="patch-modal-box">
      <view class="modal-header">
        <text class="modal-title">🏬 自定义门店对比</text>
        <text class="btn-close" bindtap="onCancelCustomStores">✕</text>
      </view>
      <text class="modal-tip">勾选需要对比/合并统计的门店（可多选，至少选择一家）</text>

      <!-- 🆕 门店名称搜索框：input 直接触发 onCustomStoreSearchInput 重算每一项
           的 matchesSearch 字段，下面 wx:if 只读这个同作用域字段 -->
      <input
        class="custom-store-search-input"
        placeholder="🔍 搜索门店名称"
        value="{{customStoreSearchKeyword}}"
        bindinput="onCustomStoreSearchInput"
        confirm-type="search"
      />

      <!-- 🆕 按省份一键全选：每个芯片点击后把该省份下所有门店勾选为 true -->
      <view class="custom-store-province-chips" wx:if="{{customStoreProvinceChips.length > 0}}">
        <view
          class="custom-store-province-chip"
          wx:for="{{customStoreProvinceChips}}"
          wx:key="*this"
          wx:for-item="province"
          data-province="{{province}}"
          bindtap="onSelectAllByProvince"
        >{{province}} 全选</view>
      </view>

      <!-- 🐛 每一行的勾选状态直接绑定这一项自己的 store.checked 字段（wx:for
           列表单项状态的标准写法），不再靠 checkbox-group 聚合 bindchange 反推
           membership——整行 bindtap 触发 onToggleCustomStoreDraft，用精确下标
           路径 setData 只更新这一项，勾选图标与数据状态可靠同步。搜索过滤同理，
           用同作用域的 store.matchesSearch 字段做 wx:if，而不是跨作用域表达式 -->
      <scroll-view scroll-y class="modal-scroll-list">
        <view
          class="report-check-item"
          wx:for="{{customStoreDraftList}}"
          wx:key="storeId"
          wx:for-item="store"
          wx:for-index="idx"
          wx:if="{{store.matchesSearch}}"
          bindtap="onToggleCustomStoreDraft"
          data-index="{{idx}}"
        >
          <checkbox value="{{store.storeId}}" checked="{{store.checked}}" color="#8C1D18" />
          <text>{{store.storeName}}<text wx:if="{{store.province || store.city}}"> ({{store.province}}{{store.city}})</text></text>
        </view>
        <view class="fa-safe-area-spacer"></view>
      </scroll-view>
      <view class="empty-box" wx:if="{{customStoreDraftList.length === 0}}">
        <text class="empty-tip">暂无可选门店</text>
      </view>

      <view class="modal-footer">
        <button class="btn-modal-cancel" bindtap="onCancelCustomStores">取消</button>
        <button class="btn-modal-submit" bindtap="onConfirmCustomStores">确定（已选{{customStoreDraftCheckedCount}}家）</button>
      </view>
    </view>
  </view>

  <!-- 🆕 个人视角：非管理角色（普通义工/无角色账号）专属，与「全国大屏」/「单店明细」
       完全独立——不展示任何跨门店治理/运营敏感数据，只有属于自己的护持数据 -->
  <view class="personal-dashboard-container" wx:if="{{showPersonalView}}">
    <!-- ☀️ 阳光大盘：首页「阳光账本」跳转（?tab=sunshine）落地的第一屏，个人
         视角下与管理视角共用同一套 fetchSunshineBoardData 数据管线/卡片结构，
         只是排在个人护持数据之前——阳光账本是公开数据，与角色无关 -->
    <view class="ui-card-wrapper sunshine-board-card" id="sunshineBoardAnchor">
      <view class="card-header sunshine-board-header">
        <text class="card-title">☀️ 阳光大盘</text>
        <view class="sunshine-info-icon" bindtap="onOpenSunshineConceptModal">ⓘ</view>
      </view>
      <text class="sunshine-board-sub">{{sunshineBoardData.storeName || currentUserStoreName || '本门店'}} · {{sunshineBoardData.periodLabel || '本月'}} · 公开透明 · 全民监督</text>

      <view class="sunshine-board-grid" wx:if="{{!sunshineBoardLoading}}">
        <view class="sunshine-board-cell" wx:for="{{sunshineBoardCards}}" wx:key="label">
          <text class="sunshine-board-val">{{item.value}}</text>
          <text class="sunshine-board-lbl">{{item.label}}</text>
        </view>
      </view>
      <view class="sunshine-board-grid" wx:else>
        <view class="sunshine-board-cell skel-cell" wx:for="{{[1,2,3,4,5,6]}}" wx:key="*this">
          <view class="skel-bar skel-bar-lg"></view>
          <view class="skel-bar skel-bar-sm"></view>
        </view>
      </view>
    </view>

    <view class="ui-card-wrapper personal-hero-card">
      <view class="hero-header">
        <text class="hero-title">💛 我的雨花爱心微数据</text>
      </view>

      <view class="hero-main-num">
        <text class="num-lbl">累计护持天数</text>
        <text class="num-val">{{personalStats.totalDays}} <text class="unit">天</text></text>
      </view>

      <view class="hero-grid-4">
        <view class="h-cell">
          <text class="h-val">{{personalStats.diningCount}}</text>
          <text class="h-lbl">累计服务人次</text>
        </view>
        <view class="h-cell">
          <text class="h-val">{{personalStats.totalHours}}</text>
          <text class="h-lbl">贡献工时(h)</text>
        </view>
        <view class="h-cell">
          <text class="h-val">{{personalStats.totalCount}}</text>
          <text class="h-lbl">累计打卡次数</text>
        </view>
      </view>

      <view class="volunteer-warm-tip">
        <text class="tip-text">用一餐饭的温度，传递温暖与关爱。感恩您的每一次默默付出！</text>
      </view>
    </view>

    <view class="personal-trend-card">
      <view class="matrix-header">
        <text class="matrix-title">📈 我的月度护持频次趋势</text>
      </view>

      <view class="personal-trend-loading" wx:if="{{personalStatsLoading}}">
        <text>加载中...</text>
      </view>

      <view class="personal-trend-chart" wx:else>
        <view class="trend-bar-col" wx:for="{{personalMonthlyTrend}}" wx:key="monthLabel">
          <view class="trend-bar-track">
            <view class="trend-bar-fill" style="height: {{item.barPercent}}%;"></view>
          </view>
          <text class="trend-bar-count">{{item.count}}</text>
          <text class="trend-bar-label">{{item.monthLabel}}</text>
        </view>
      </view>
    </view>

    <view class="compliance-disclaimer">
      <text class="compliance-disclaimer-text">本平台仅用于爱心餐报与志愿服务记录，不直接面向公众发起公开募捐；如涉及个人信息，已在前端做脱敏展示处理。</text>
    </view>

    <view class="bottom-sticky-bar">
      <button class="btn-primary-poster" hover-class="ui-hover" bindtap="onGeneratePersonalPoster">
        🖼️ 生成我的个人爱心海报
      </button>
    </view>
  </view>

  <!-- 🎖️ 个人爱心海报预览弹窗：与 pages/journey.ts「爱心荣誉卡」同一套预览体验
       （立刻打开 + 加载态 + scroll-view max-height，避免图片区域塌陷成空白） -->
  <view class="honor-modal-mask" wx:if="{{showPersonalPosterModal}}" bindtap="onClosePersonalPosterModal">
    <view class="honor-modal-box" catchtap="stopPropagation">
      <view class="honor-modal-header">
        <text class="honor-modal-title">我的个人爱心海报</text>
        <view class="honor-modal-close" bindtap="onClosePersonalPosterModal">
          <text class="close-x-text">✕</text>
        </view>
      </view>

      <scroll-view scroll-y class="honor-card-scroll">
        <view class="honor-loading" wx:if="{{isGeneratingPersonalPoster}}">
          <view class="honor-loading-spinner"></view>
          <text class="honor-loading-text">正在为您生成海报...</text>
        </view>
        <image
          wx:else
          class="honor-card-image"
          src="{{personalPosterImage}}"
          mode="widthFix"
          show-menu-by-longpress="{{true}}"
        />
      </scroll-view>

      <text class="honor-modal-hint">💡 保存图片后可发送至朋友圈或微信群</text>

      <button
        class="honor-btn-save {{(isGeneratingPersonalPoster || isSavingPersonalPoster || !personalPosterImage) ? 'honor-btn-save-disabled' : ''}}"
        bindtap="onSavePersonalPoster"
        loading="{{isSavingPersonalPoster}}"
        disabled="{{isGeneratingPersonalPoster || isSavingPersonalPoster || !personalPosterImage}}"
      >
        {{isSavingPersonalPoster ? '保存中...' : '💾 保存到相册'}}
      </button>
    </view>
  </view>

  <scroll-view class="content-section" scroll-y scroll-into-view="{{scrollIntoViewId}}" wx:if="{{!showNationalDashboard && !showPersonalView}}">

    <!-- ☀️ 阳光大盘：Profile「阳光账本核查」/首页「阳光账本」跳转的真正落地区块
         （?tab=sunshine 时 scrollIntoViewId 会自动把它带入可视区域），取代此前
         "点了只弹一个理念宣言 Modal、不落到任何数据页面"的交互死胡同。独立于
         statistics.recordCount>0（下方 stats-content）之外——阳光账本是与周期
         无关的独立公开数据管线，见 fetchSunshineBoardData。
         🐛 根因修复：entryFocus==='ledger'（?tab=ledger 落地）时收起本卡——
         此前阳光大盘/账目流水明细无论从哪个入口进来都同时展示，两个入口点进来
         的页面长得一模一样。普通访问（entryFocus===''）不受影响，两块都保留 -->
    <view class="ui-card-wrapper sunshine-board-card" id="sunshineBoardAnchor" wx:if="{{entryFocus !== 'ledger'}}">
      <view class="card-header sunshine-board-header">
        <text class="card-title">☀️ 阳光大盘</text>
        <!-- ⓘ 说明图标：点击才拉起阳光宣言/理念说明弹窗，与数据大盘解耦——用户
             一进页面看到的是真实数据，不是一个必须先关掉才能看数据的宣言弹窗 -->
        <view class="sunshine-info-icon" bindtap="onOpenSunshineConceptModal">ⓘ</view>
      </view>
      <text class="sunshine-board-sub">{{sunshineBoardData.storeName || currentUserStoreName || shopName}} · {{sunshineBoardData.periodLabel || '本月'}} · 公开透明 · 全民监督</text>

      <view class="sunshine-board-grid" wx:if="{{!sunshineBoardLoading}}">
        <view class="sunshine-board-cell" wx:for="{{sunshineBoardCards}}" wx:key="label">
          <text class="sunshine-board-val">{{item.value}}</text>
          <text class="sunshine-board-lbl">{{item.label}}</text>
        </view>
      </view>
      <view class="sunshine-board-grid" wx:else>
        <view class="sunshine-board-cell skel-cell" wx:for="{{[1,2,3,4,5,6]}}" wx:key="*this">
          <view class="skel-bar skel-bar-lg"></view>
          <view class="skel-bar skel-bar-sm"></view>
        </view>
      </view>
    </view>

    <!-- 📋 账目流水明细：Profile「门店账目明细」跳转（?tab=ledger）的真正落地
         区块——此前 tab=ledger 落地后除了把 currentTab 切到"月报"之外，看到的
         卡片跟 tab=sunshine 完全一样，只有几个汇总数字，没有任何逐笔流水。
         数据源是 loadStatistics() 里已经拉到手的当期原始 report_logs 记录
         （见 buildLedgerRecords），每条精确到日期/收支金额/凭证关联状态/核销
         状态，与 statistics.recordCount 无关、不依赖数据是否已加载完成即可
         稳定存在于 DOM 中，保证 onLoad 阶段设置的 scroll-into-view 生效。
         entryFocus==='sunshine' 时收起本卡，把版面让给阳光大盘 -->
    <view class="ui-card-wrapper ledger-list-container" id="ledgerListAnchor" wx:if="{{entryFocus !== 'sunshine'}}">
      <!-- 🐛 折行截断修复：.card-header 是本文件 9 张卡片共用的裸类名，只有
           margin-bottom，没有任何 flex 布局——标题与副标题两个 <text> 兄弟节点
           因此按纯行内流排版，宽度不够时副标题会在任意字符处断行，日期区间
           末尾的"16"这类数字就会被硬生生挤到下一行。加一个只作用于本卡片的
           ledger-card-header 类做左右两端对齐，不去动其余 8 处共用 .card-header
           的布局 -->
      <view class="card-header ledger-card-header">
        <text class="card-title">📋 账目流水明细</text>
        <!-- 🐛 根因修复：此前副标题写死拼 selectedYear/selectedMonth，年报/周报/
             自定义区间下会显示一个跟实际查询范围对不上的"年-月"；改用
             ledgerPeriodText（loadStatistics() 按 currentTab 口径统一算好，
             见 buildLedgerPeriodLabel），与下方空状态提示同一个数据源，两处
             永远一致 -->
        <text class="ledger-list-sub">{{currentUserStoreName || shopName}} · {{ledgerPeriodText}}</text>
      </view>

      <view class="ledger-list-loading" wx:if="{{statisticsLoadLoading && ledgerRecords.length === 0}}">
        <view class="ledger-list-row skel-cell" wx:for="{{[1,2,3]}}" wx:key="*this">
          <view class="skel-bar skel-bar-lg"></view>
          <view class="skel-bar skel-bar-sm"></view>
        </view>
      </view>

      <!-- 🎨 精致化空状态：图标 + 主文案（联动当前选中周期，不再是写死文案）+
           副文案引导下一步操作 -->
      <view class="ledger-empty-box" wx:elif="{{ledgerRecords.length === 0}}">
        <text class="ledger-empty-icon">🗂️</text>
        <text class="ledger-empty-main">{{ledgerPeriodText}}暂无账目流水记录</text>
        <text class="ledger-empty-sub">建议切换上方"周/月/年"或选择其他历史月份核查</text>
      </view>

      <view class="ledger-list-body" wx:else>
        <view class="ledger-list-row" wx:for="{{ledgerRecords}}" wx:key="id">
          <!-- 左：日期 + 分类 Tag；右：核销状态 Tag -->
          <view class="ledger-row-top">
            <view class="ledger-row-top-left">
              <text class="ledger-row-date">{{item.date}}</text>
              <text class="ledger-row-category ledger-category-{{item.categoryClass}}">{{item.categoryLabel}}</text>
            </view>
            <text class="ledger-row-status ledger-status-{{item.statusClass}}">{{item.statusLabel}}</text>
          </view>
          <!-- 中：来源 + 凭证图标（可点开大图预览）；右：金额大字高亮 -->
          <view class="ledger-row-mid">
            <view class="ledger-row-source-group">
              <text class="ledger-row-source">{{item.sourceLabel}}</text>
              <view class="ledger-row-receipt {{item.hasReceipt ? 'has-receipt' : 'no-receipt'}}" bindtap="onPreviewLedgerReceipt" data-index="{{index}}">
                <text>{{item.hasReceipt ? '🧾 凭证 ' + item.receiptCount + ' 张' : '⚠️ 无凭证'}}</text>
              </view>
            </view>
            <text class="ledger-row-amount {{item.netPositive ? 'plus' : 'minus'}}">{{item.netPositive ? '+' : '-'}}¥{{item.netStr}}</text>
          </view>
          <view class="ledger-row-bottom">
            <text class="ledger-row-income">收 +¥{{item.incomeStr}}</text>
            <text class="ledger-row-expense">支 -¥{{item.expenseStr}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 🆕 核心经营指标骨架卡：独立于下方 statistics.recordCount>0 才渲染的
         stats-content，无论当期是否有数据都固定展示这 3x2 网格结构，避免
         "无数据=页面直接塌陷成空状态卡"——无数据时格子显示 "--"，同比徽标一并隐藏。
         🆕 首次请求还在飞、且还没有任何数据可展示时（statisticsLoadLoading &&
         !coreMetrics.hasData），改用骨架屏占位而不是直接展示 "--"——"--" 应该只
         代表"确认过、这期真的没数据"，不该在请求结果还没回来前就先亮出来，
         那会让用户误以为已经查完了。
         🆕 新增「阳光凭证数」「凭证合规率」两格：数据源是 statsData（fetchStatistics
         →getStatisticsData 云函数结果，与前 4 格的 coreMetrics 来自 loadStatistics
         是两条独立并行的数据管线，见 calculateStats() 同时触发两者）。两条管线
         正常情况下几乎同时返回，这两格用各自的 ?? 兜底即可，不需要为此新增一套
         独立的 loading 状态机 -->
    <view class="ui-card-wrapper core-metrics-card">
      <view class="card-header">
        <text class="card-title">📌 核心经营指标</text>
      </view>
      <view class="core-metrics-grid" wx:if="{{!(statisticsLoadLoading && !coreMetrics.hasData)}}">
        <view class="core-metrics-cell">
          <view class="core-metrics-val-row">
            <text class="core-metrics-val">{{coreMetrics.hasData ? coreMetrics.diningCount : '--'}}</text>
            <text class="core-metrics-unit" wx:if="{{coreMetrics.hasData}}">次</text>
          </view>
          <text class="core-metrics-lbl">总餐次数</text>
          <view class="core-metrics-yoy {{coreMetrics.diningCountYoy > 0 ? 'up' : (coreMetrics.diningCountYoy < 0 ? 'down' : 'flat')}}" wx:if="{{coreMetrics.diningCountYoy !== null}}">
            <text>{{coreMetrics.diningCountYoy > 0 ? '▲' : (coreMetrics.diningCountYoy < 0 ? '▼' : '—')}} {{coreMetrics.diningCountYoy}}%</text>
          </view>
        </view>
        <view class="core-metrics-cell">
          <view class="core-metrics-val-row">
            <text class="core-metrics-val">{{coreMetrics.hasData ? coreMetrics.volunteerCount : '--'}}</text>
            <text class="core-metrics-unit" wx:if="{{coreMetrics.hasData}}">人次</text>
          </view>
          <text class="core-metrics-lbl">服务人次</text>
          <view class="core-metrics-yoy {{coreMetrics.volunteerCountYoy > 0 ? 'up' : (coreMetrics.volunteerCountYoy < 0 ? 'down' : 'flat')}}" wx:if="{{coreMetrics.volunteerCountYoy !== null}}">
            <text>{{coreMetrics.volunteerCountYoy > 0 ? '▲' : (coreMetrics.volunteerCountYoy < 0 ? '▼' : '—')}} {{coreMetrics.volunteerCountYoy}}%</text>
          </view>
        </view>
        <view class="core-metrics-cell">
          <text class="core-metrics-val">{{coreMetrics.expenseTotalStr}}</text>
          <text class="core-metrics-lbl">支出总额</text>
          <view class="core-metrics-yoy {{coreMetrics.expenseTotalYoy > 0 ? 'up' : (coreMetrics.expenseTotalYoy < 0 ? 'down' : 'flat')}}" wx:if="{{coreMetrics.expenseTotalYoy !== null}}">
            <text>{{coreMetrics.expenseTotalYoy > 0 ? '▲' : (coreMetrics.expenseTotalYoy < 0 ? '▼' : '—')}} {{coreMetrics.expenseTotalYoy}}%</text>
          </view>
        </view>
        <view class="core-metrics-cell">
          <text class="core-metrics-val">{{coreMetrics.perMealCostStr}}</text>
          <text class="core-metrics-lbl">平均单餐成本</text>
          <view class="core-metrics-yoy {{coreMetrics.perMealCostYoy > 0 ? 'up' : (coreMetrics.perMealCostYoy < 0 ? 'down' : 'flat')}}" wx:if="{{coreMetrics.perMealCostYoy !== null}}">
            <text>{{coreMetrics.perMealCostYoy > 0 ? '▲' : (coreMetrics.perMealCostYoy < 0 ? '▼' : '—')}} {{coreMetrics.perMealCostYoy}}%</text>
          </view>
        </view>
        <view class="core-metrics-cell">
          <view class="core-metrics-val-row">
            <!-- 🐛 WXML 表达式引擎不保证支持 ?? 空值合并运算符（这份代码库其余
                 任何 wxml 文件里都找不到一处已验证可用的先例），用 || 0 兜底——
                 recordCount 语义上不会是负数，0 本身也是合法值，|| 在这里与 ??
                 效果完全等价，不会误伤"确实是 0"的情况 -->
            <text class="core-metrics-val">{{statsData.recordCount || 0}}</text>
            <text class="core-metrics-unit">张</text>
          </view>
          <text class="core-metrics-lbl">阳光凭证数</text>
        </view>
        <view class="core-metrics-cell">
          <view class="core-metrics-val-row">
            <text class="core-metrics-val">{{statsData.complianceRate === null || statsData.complianceRate === undefined ? '--' : statsData.complianceRate}}</text>
            <text class="core-metrics-unit" wx:if="{{statsData.complianceRate !== null && statsData.complianceRate !== undefined}}">%</text>
          </view>
          <text class="core-metrics-lbl">凭证合规率</text>
        </view>
      </view>
      <view class="core-metrics-grid" wx:else>
        <view class="core-metrics-cell skel-cell" wx:for="{{[1,2,3,4,5,6]}}" wx:key="*this">
          <view class="skel-bar skel-bar-lg"></view>
          <view class="skel-bar skel-bar-sm"></view>
        </view>
      </view>
    </view>

    <view class="stats-content" wx:if="{{statistics && statistics.recordCount > 0}}">

      <!-- 🆕 财务专属：门店财务与凭证合规大屏——突出单餐成本/记账笔数/凭证合规率。
           🐛 补上 financeEntryMode：Profile「财务稽核专区」跳转带来的 ?viewMode=finance
           标记在 onLoad 就同步写入，而 isFinance 要等 initUserRole() 这个异步请求
           回来才会变 true——纯 isFinance 判断会让财务专区从 Profile 跳过来的这一屏
           先空一下再补出这张卡，financeEntryMode || isFinance 消除这个视觉跳变 -->
      <view class="finance-compliance-card" wx:if="{{isFinance || financeEntryMode}}">
        <view class="card-header">
          <text class="card-title">💳 门店财务与凭证合规大屏</text>
        </view>
        <view class="finance-metric-grid">
          <view class="finance-metric-cell">
            <text class="finance-metric-val">¥{{statsData.costPerMeal || '0.00'}}</text>
            <text class="finance-metric-lbl">单餐成本</text>
          </view>
          <view class="finance-metric-cell">
            <text class="finance-metric-val">{{statsData.recordCount || 0}}</text>
            <text class="finance-metric-lbl">记账笔数</text>
          </view>
          <view class="finance-metric-cell">
            <text class="finance-metric-val">{{statsData.auditedCount || 0}}</text>
            <text class="finance-metric-lbl">已稽核笔数</text>
          </view>
          <view class="finance-metric-cell {{statsData.complianceRate !== null && statsData.complianceRate < 60 ? 'warn' : ''}}">
            <text class="finance-metric-val">{{statsData.complianceRate === null || statsData.complianceRate === undefined ? '暂无数据' : statsData.complianceRate + '%'}}</text>
            <text class="finance-metric-lbl">凭证合规率</text>
          </view>
        </view>
      </view>

      <!-- 🆕 家长专属：资源储备/资金物资兜底状况与续航预警天数——数据来自
           getPatriarchDashboard（该云函数已把 storeId 硬锁定为本人绑定门店） -->
      <view class="patriarch-resource-card" wx:if="{{isPatriarch}}">
        <view class="card-header">
          <text class="card-title">🏛️ 门店资源储备与续航预警</text>
        </view>
        <view class="patriarch-loading" wx:if="{{patriarchStatsLoading}}">
          <text>加载中...</text>
        </view>
        <view wx:else>
          <view class="finance-metric-grid">
            <view class="finance-metric-cell">
              <text class="finance-metric-val">{{patriarchStats.monthDiners}}</text>
              <text class="finance-metric-lbl">{{patriarchStats.monthLabel}}服务人次</text>
            </view>
            <view class="finance-metric-cell {{patriarchStats.monthNetPositive ? 'green' : 'warn'}}">
              <text class="finance-metric-val">{{patriarchStats.monthNetPositive ? '+' : '-'}}¥{{patriarchStats.monthNet}}</text>
              <text class="finance-metric-lbl">本月资金结余</text>
            </view>
            <view class="finance-metric-cell">
              <text class="finance-metric-val">{{patriarchStats.auditedCount}} / {{patriarchStats.totalCount}}</text>
              <text class="finance-metric-lbl">防伪验真进度</text>
            </view>
            <view class="finance-metric-cell {{patriarchStats.pendingVoidCount > 0 || patriarchStats.pendingProfileUpdate ? 'warn' : ''}}">
              <text class="finance-metric-val">{{patriarchStats.pendingVoidCount + (patriarchStats.pendingProfileUpdate ? 1 : 0)}}</text>
              <text class="finance-metric-lbl">待确认高风险操作</text>
            </view>
          </view>
          <view class="patriarch-resource-tip" wx:if="{{patriarchStats.pendingVoidCount > 0 || patriarchStats.pendingProfileUpdate}}">
            <text>⚠️ 有待确认的作废申请/门店画像变更，请前往【个人中心 · 家长管理】处理</text>
          </view>
        </view>
      </view>

      <view class="health-card" style="background: linear-gradient(135deg, {{statistics.healthGradientFrom}} 0%, {{statistics.healthGradientTo}} 100%);">
        <view class="health-header">
          <text class="health-icon">{{statistics.healthIcon}}</text>
          <view class="health-title-wrap">
            <text class="health-title">爱心续航看板</text>
            <text class="health-date">{{statsData.dateRangeText || (statistics.startDate + ' ~ ' + statistics.endDate)}}</text>
          </view>
        </view>
        <view class="balance-amount">
          <text class="balance-label">账户实时总结余</text>
          <text class="balance-value">¥{{statistics.latestBalanceStr}}</text>
        </view>
        <view class="runway-box">
          <text class="runway-label">预计可平稳开餐</text>
          <text class="runway-days">{{statistics.runwayDaysStr}}</text>
        </view>
        <view class="material-pills-row">
          <view class="mat-pill-capsule">
            <text class="mat-icon">🍚</text>
            <text class="mat-name">大米</text>
            <view class="status-tag-pill {{statistics.riceStatusClass || 'success'}}">
              <text class="dot"></text>
              <text class="status-text">{{statistics.riceStatusText || '一般'}}</text>
            </view>
          </view>
          <view class="mat-pill-capsule">
            <text class="mat-icon">🫒</text>
            <text class="mat-name">食用油</text>
            <view class="status-tag-pill {{statistics.oilStatusClass || 'success'}}">
              <text class="dot"></text>
              <text class="status-text">{{statistics.oilStatusText || '充足'}}</text>
            </view>
          </view>
        </view>
        <view class="health-tip">{{statistics.healthStatusText}}</view>
      </view>

      <view class="ui-card-wrapper income-expense-card">
        <view class="card-header">
          <text class="card-title">收支透明账本</text>
        </view>
        <view class="ie-columns">
          <view class="ie-col income-col">
            <text class="ie-label">服务汇入</text>
            <text class="ie-value income">+¥{{statsData.totalIncome || statistics.totalIncomeStr}}</text>
            <view class="ie-detail">
              <text class="ie-detail-label">自愿赞助</text>
              <text class="ie-detail-value">¥{{statsData.selfSponsor || statistics.totalListDonationStr}}</text>
            </view>
            <view class="ie-detail">
              <text class="ie-detail-label">现场/其他支持</text>
              <text class="ie-detail-value">¥{{statsData.otherIncome || statistics.totalOtherDonationStr}}</text>
            </view>
          </view>
          <view class="ie-divider"></view>
          <view class="ie-col expense-col">
            <text class="ie-label">支出总额</text>
            <text class="ie-value expense">-¥{{statsData.totalExpense || statistics.totalExpenseStr}}</text>
            <view class="ie-detail">
              <text class="ie-detail-label">日常开餐食材</text>
              <text class="ie-detail-value">¥{{statsData.foodExpense || statistics.dailyExpenseTotalStr}}</text>
            </view>
            <view class="ie-detail">
              <text class="ie-detail-label">房租/专项固定</text>
              <text class="ie-detail-value highlight">¥{{statsData.majorExpense || statistics.largeExpenseTotalStr}}</text>
            </view>
          </view>
        </view>

        <view class="net-accumulation-row">
          <text class="net-label">本期服务积累</text>
          <view class="net-val-group">
            <text class="net-value {{statistics.netAccumulationClass}}">{{statsData.netAccumulation || statistics.netAccumulationStr}}</text>
            <text class="net-sub-tip" wx:if="{{statistics.showLargeExpenseTip}}">(含房租/专项大额)</text>
          </view>
        </view>

        <view class="expense-structure">
          <text class="structure-label">支出结构占比</text>
          <view class="structure-bar">
            <view class="structure-fill daily" style="width: {{statistics.dailyExpensePercent}}%;"></view>
            <view class="structure-fill large" style="width: {{statistics.largeExpensePercent}}%;"></view>
          </view>
          <view class="structure-legend">
            <view class="legend-item">
              <view class="legend-dot daily"></view>
              <text class="legend-text">日常开销 {{statistics.dailyExpensePercent}}%</text>
            </view>
            <view class="legend-item">
              <view class="legend-dot large"></view>
              <text class="legend-text">大额固定 {{statistics.largeExpensePercent}}%</text>
            </view>
          </view>
        </view>
      </view>

      <view class="major-detail-card" wx:if="{{statistics.majorExpenseList && statistics.majorExpenseList.length > 0}}">
        <view class="card-header">
          <view class="header-title-box">
            <text class="card-icon">📋</text>
            <text class="card-title">本期大额与专项支出明细</text>
          </view>
          <text class="count-badge">共 {{statistics.majorExpenseList.length}} 项</text>
        </view>

        <view class="detail-items-list">
          <view class="detail-sub-item" wx:for="{{statistics.majorExpenseList}}" wx:key="index">
            <view class="item-left-info">
              <text class="item-title-text">{{item.detailText}}</text>
              <text class="item-date-text">🗓️ {{item.date}}</text>
            </view>
            <view class="item-right-box">
              <text class="amount-val">-¥{{item.amount}}</text>
              <button 
                class="btn-patch-text" 
                wx:if="{{item.isMissingRemark}}" 
                bindtap="onOpenEditMajorModal" 
                data-item="{{item}}"
              >
                ✏️ 补全事由
              </button>
            </view>
          </view>
        </view>

        <view class="card-footer-summary">
          <text class="summary-lbl">大额专项支出合计</text>
          <text class="summary-val">-¥{{statistics.largeExpenseTotalStr}}</text>
        </view>
      </view>

      <view class="ui-card-wrapper achievement-card">
        <view class="card-header">
          <text class="card-title">爱心成果与义工奉献</text>
        </view>

        <view class="achievement-grid" wx:if="{{statistics.openDays > 0}}">
          <view class="achievement-item">
            <text class="achievement-icon">🍱</text>
            <text class="achievement-value">{{statistics.openDays || 0}}</text>
            <text class="achievement-label">开餐天数 (休餐服务{{statistics.donationDays || 0}}天)</text>
          </view>
          <view class="achievement-item">
            <text class="achievement-icon">👥</text>
            <text class="achievement-value">{{statsData.totalDiningPeople || statistics.totalDiningCount}}</text>
            <text class="achievement-label">服务用餐人次</text>
            <text class="achievement-sub" wx:if="{{statistics.totalDineInCount > 0 || statistics.totalDeliveryCount > 0 || statistics.totalTakeawayCount > 0}}">堂食{{statistics.totalDineInCount}}·送餐{{statistics.totalDeliveryCount}}·打包{{statistics.totalTakeawayCount}}</text>
          </view>
          <view class="achievement-item" wx:if="{{statistics.showPerMealCost || statsData.costPerMeal}}">
            <text class="achievement-icon">💚</text>
            <text class="achievement-value">¥{{statsData.costPerMeal || statistics.perMealCostStr}}</text>
            <text class="achievement-label">每餐服务投入 (元)</text>
          </view>
          <view class="achievement-item" wx:else>
            <text class="achievement-icon">💚</text>
            <text class="achievement-value">—</text>
            <text class="achievement-label">每餐服务投入 (元)</text>
          </view>
          <view class="achievement-item">
            <text class="achievement-icon">🧡</text>
            <text class="achievement-value">{{statsData.totalVolunteerHours || statistics.totalVolunteerHours}}</text>
            <text class="achievement-label">义工服务总工时</text>
          </view>
        </view>

        <view class="warm-donation-box" wx:else>
          <view class="warm-icon">❤️</view>
          <view class="warm-title">本期为休餐筹备期</view>
          <view class="warm-desc">
            共收到 <text class="highlight">{{statistics.donationDays || 0}} 笔</text> 服务汇入，积累资金用于后续持续开餐！
          </view>
        </view>

        <view class="volunteer-summary-row" wx:if="{{statistics.totalVolunteerCount > 0 || statsData.totalVolunteers > 0}}">
          <text class="vol-summary-text">❤️ 义工护持：{{statsData.totalVolunteers || statistics.totalVolunteerCount}} 人次 · {{statsData.totalVolunteerHours || statistics.totalVolunteerHours}} 小时</text>
        </view>

        <view class="materials-summary-card">
          <text class="materials-title">📦 物资赞助明细汇总</text>
          <view class="materials-empty" wx:if="{{!statistics.materialsSummary || statistics.materialsSummary.length === 0}}">
            <text>暂无物资赞助记录</text>
          </view>
          <view class="materials-list" wx:else>
            <view class="materials-item" wx:for="{{statistics.materialsSummary}}" wx:key="item">
              <text class="materials-name">• {{item.item}}</text>
              <text class="materials-qty">共 {{item.totalQty}} {{item.unit}}</text>
            </view>
          </view>
        </view>

        <!-- 🌾 核心物资消耗总量：大米/面粉/食用油/蔬菜累计斤数，来自 material_logs
             （义工登记消耗经采纳后落库，见 getStatisticsData 云函数），与上面
             "物资赞助明细汇总"（report_logs 里记录的捐赠物资）是两套不同数据源 -->
        <view class="materials-summary-card" wx:if="{{statsData.riceTotal > 0 || statsData.flourTotal > 0 || statsData.oilTotal > 0 || statsData.vegetableTotal > 0}}">
          <text class="materials-title">🌾 核心物资消耗总量</text>
          <view class="materials-list">
            <view class="materials-item" wx:if="{{statsData.riceTotal > 0}}">
              <text class="materials-name">• 大米</text>
              <text class="materials-qty">共 {{statsData.riceTotal}} 斤</text>
            </view>
            <view class="materials-item" wx:if="{{statsData.flourTotal > 0}}">
              <text class="materials-name">• 面粉</text>
              <text class="materials-qty">共 {{statsData.flourTotal}} 斤</text>
            </view>
            <view class="materials-item" wx:if="{{statsData.oilTotal > 0}}">
              <text class="materials-name">• 食用油</text>
              <text class="materials-qty">共 {{statsData.oilTotal}} 斤</text>
            </view>
            <view class="materials-item" wx:if="{{statsData.vegetableTotal > 0}}">
              <text class="materials-name">• 蔬菜</text>
              <text class="materials-qty">共 {{statsData.vegetableTotal}} 斤</text>
            </view>
          </view>
        </view>
      </view>

      <view class="daily-list-card">
        <view class="detail-section-header">
          <view class="header-main-row">
            <view class="title-with-badge">
              <text class="section-main-title">📅 每日明细</text>
              <text class="record-count-tag">({{statistics.dailyRecords.length}}天记录)</text>
            </view>
            <text class="store-location-badge">{{currentUserStoreName || shopName}}</text>
          </view>
          <view class="header-tools-row">
            <button class="tool-btn thanks" bindtap="onGenerateGratitudeReport">
              📝 生成感恩汇报
            </button>
            <button class="tool-btn export" hover-class="ui-hover" bindtap="exportToExcel">
              📊 导出表格
            </button>
          </view>
          <view class="export-tip-banner">
            <text class="tip-text">💡 导出后建议选择发送给【文件传输助手】或微信群保存</text>
          </view>
        </view>

        <!-- 智能提示：开餐期提示补录用餐人数，休餐期提示筹备状态 -->
        <block wx:if="{{statistics.dailyExpenseTotal > 0 || (statsData.foodExpense && statsData.foodExpense > 0)}}">
          <view class="batch-notice-bar" wx:if="{{statistics.missingCount > 0}}" bindtap="onOpenBatchDinerModal">
            <text class="notice-icon">💡</text>
            <text class="notice-text">检测到 {{statistics.missingCount}} 笔记录未填写用餐人数，<text class="highlight">点击快捷补录 ➔</text></text>
          </view>
        </block>
        <block wx:else>
          <view class="preparing-period-banner">
            <text class="notice-icon">🌱</text>
            <text class="notice-text">当前处于休餐筹备期，开餐后将开启用餐人数统计</text>
          </view>
        </block>

        <view class="empty-box" wx:if="{{statistics.dailyRecords.length === 0}}">
          <text class="empty-tip">该周期内【{{currentUserStoreName || shopName}}】暂无餐报记录</text>
        </view>

        <!-- 年报模式：按月聚合折叠展示 -->
        <view class="monthly-aggregate-list" wx:elif="{{currentTab === 'year' && monthlyAggregatedList.length > 0}}">
          <view class="month-card" wx:for="{{monthlyAggregatedList}}" wx:key="month" wx:for-item="monthItem">
            <view class="month-card-header" bindtap="toggleMonthExpand" data-month="{{monthItem.month}}">
              <view class="month-title-row">
                <text class="month-name">📅 {{monthItem.monthName}}</text>
                <text class="month-record-count">{{monthItem.recordCount}} 天</text>
              </view>
              <view class="month-summary-row">
                <view class="month-summary-item">
                  <text class="ms-label">汇入</text>
                  <text class="ms-value green">+¥{{monthItem.incomeStr}}</text>
                </view>
                <view class="month-summary-item">
                  <text class="ms-label">支出</text>
                  <text class="ms-value red">-¥{{monthItem.totalExpenseStr}}</text>
                </view>
                <view class="month-summary-item">
                  <text class="ms-label">用餐</text>
                  <text class="ms-value">{{monthItem.diners}} 人次</text>
                </view>
                <text class="month-expand-arrow">{{expandedMonthSet[monthItem.month] ? '▲' : '▼'}}</text>
              </view>
            </view>

            <view class="month-detail-body" wx:if="{{expandedMonthSet[monthItem.month]}}">
              <view class="daily-item-card" wx:for="{{monthItem.days}}" wx:for-item="dayItem" wx:key="index" wx:for-index="dayIdx">
                <view class="daily-card-header">
                  <view class="date-box">
                    <text class="date-text">{{dayItem.date}}</text>
                    <text class="status-badge {{dayItem.statusTag}}">{{dayItem.statusLabel}}</text>
                    <text class="major-expense-tag" wx:if="{{dayItem.hasLargeExpense}}">🖨️ 含专项大额</text>
                  </view>
                  <view class="net-change {{dayItem.netChange >= 0 ? 'plus' : 'minus'}}">
                    {{dayItem.netChange >= 0 ? '+' : '-'}}{{dayItem.netChangeStr}} 元
                  </view>
                </view>

                <view class="daily-card-body">
                  <view class="grid-col">
                    <text class="col-label">服务收入</text>
                    <text class="col-value green">+¥{{dayItem.incomeStr}}</text>
                  </view>
                  <view class="grid-col">
                    <text class="col-label">日常食材</text>
                    <text class="col-value red">-¥{{dayItem.dailyExpenseStr}}</text>
                  </view>
                  <view class="grid-col">
                    <text class="col-label">用餐人次</text>
                    <text class="col-value">{{dayItem.diningCount || 0}} 人</text>
                  </view>
                </view>

                <view class="fixed-major-row" wx:if="{{dayItem.largeExpense > 0}}">
                  <text class="major-label">🏢 房租/专项大额支出：</text>
                  <text class="major-val">-¥{{dayItem.largeExpenseStr}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 周报/月报/自定义：每日明细卡片 -->
        <view class="daily-card-list" wx:else>
          <view class="daily-item-card" wx:for="{{statistics.dailyRecords}}" wx:key="index">
            <view class="daily-card-header">
              <view class="date-box">
                <text class="date-text">{{item.date}}</text>
                <text class="status-badge {{item.statusTag}}">{{item.statusLabel}}</text>
                <text class="major-expense-tag" wx:if="{{item.hasLargeExpense}}">🖨️ 含专项大额</text>
              </view>
              <view class="net-change {{item.netChange >= 0 ? 'plus' : 'minus'}}">
                {{item.netChange >= 0 ? '+' : '-'}}{{item.netChangeStr}} 元
              </view>
            </view>

            <view class="daily-card-body">
              <view class="grid-col">
                <text class="col-label">服务收入</text>
                <text class="col-value green">+¥{{item.incomeStr}}</text>
              </view>
              <view class="grid-col">
                <text class="col-label">日常食材</text>
                <text class="col-value red">-¥{{item.dailyExpenseStr}}</text>
              </view>
              <view class="grid-col">
                <text class="col-label">用餐人次</text>
                <view class="diners-cell" bindtap="onQuickEditDiners" data-index="{{index}}">
                  <text class="col-value">{{item.diningCount || 0}} 人</text>
                  <text class="edit-icon" wx:if="{{!item.diningCount || item.diningCount === 0}}">✏️</text>
                </view>
              </view>
            </view>

            <view class="fixed-major-row" wx:if="{{item.largeExpense > 0}}">
              <text class="major-label">🏢 房租/专项大额支出：</text>
              <text class="major-val">-¥{{item.largeExpenseStr}}</text>
            </view>

            <view class="daily-card-footer" wx:if="{{item.volunteerCount || item.hasMaterials}}">
              <text class="sub-tip" wx:if="{{item.volunteerCount}}">❤️ 到岗义工：{{item.volunteerCount}} 人</text>
              <text class="sub-tip" wx:if="{{item.hasMaterials}}">📦 收到物资：{{item.materialsSummary}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 🏠 门店人员与服务人群画像：独立于本期是否有餐报记录展示，仅在单店视角下出现。
         🆕 从"色彩指示点+灰字标签"升级为真正的色彩 Badge（背景色胶囊，不只是
         一个小圆点），三大分组配色：党员=红、志愿者体系(社工+志愿者)=绿、
         长者服务对象(堂食+送餐+倾听老人)=蓝，"其他"保持中性灰。
         底部新增进度比例条：把 7 个原始计数按上述 4 组归并算出占比
         （见 fetchStoreProfile 里的 partyRatioPct 等派生字段），一眼看出
         门店人员构成，不必逐格默数 -->
    <view class="store-people-card" wx:if="{{!isAllStoresMode && storeProfile}}">
      <view class="card-header">
        <view class="header-title-box">
          <text class="card-icon">👥</text>
          <text class="card-title">门店人员与服务人群画像</text>
        </view>
      </view>
      <view class="store-people-grid-4col">
        <view class="grid-cell">
          <view class="cell-badge badge-party">党员</view>
          <text class="cell-lbl">中共党员</text>
          <text class="cell-val party-highlight">{{storeProfile.partyMembers}}</text>
        </view>
        <view class="grid-cell">
          <view class="cell-badge badge-volunteer">志愿</view>
          <text class="cell-lbl">社会工作者</text>
          <text class="cell-val volunteer">{{storeProfile.socialWorkers}}</text>
        </view>
        <view class="grid-cell">
          <view class="cell-badge badge-volunteer">志愿</view>
          <text class="cell-lbl">志愿者</text>
          <text class="cell-val volunteer">{{storeProfile.volunteersCount}}</text>
        </view>
        <view class="grid-cell">
          <view class="cell-badge badge-elderly">长者</view>
          <text class="cell-lbl">堂食老人</text>
          <text class="cell-val elderly">{{storeProfile.dineInSeniorsCount}}</text>
        </view>
        <view class="grid-cell">
          <view class="cell-badge badge-elderly">长者</view>
          <text class="cell-lbl">送餐老人</text>
          <text class="cell-val elderly">{{storeProfile.deliverySeniorsCount}}</text>
        </view>
        <view class="grid-cell">
          <view class="cell-badge badge-elderly">长者</view>
          <text class="cell-lbl">倾听陪伴老人</text>
          <text class="cell-val elderly">{{storeProfile.listeningSeniorsCount}}</text>
        </view>
        <view class="grid-cell">
          <view class="cell-badge badge-other">其他</view>
          <text class="cell-lbl">其他</text>
          <text class="cell-val grey">{{storeProfile.otherCount}}</text>
        </view>
      </view>

      <!-- 人群构成进度比例条：无人员数据时（profileTotal===0）不渲染，避免展示一条空比例条 -->
      <view class="people-ratio-section" wx:if="{{storeProfile.profileTotal > 0}}">
        <text class="people-ratio-title">人群构成占比</text>
        <view class="people-ratio-bar-wrap">
          <view class="people-ratio-seg seg-party"     style="width:{{storeProfile.partyRatioPct}}%"     wx:if="{{storeProfile.partyRatioPct > 0}}"></view>
          <view class="people-ratio-seg seg-volunteer" style="width:{{storeProfile.volunteerRatioPct}}%" wx:if="{{storeProfile.volunteerRatioPct > 0}}"></view>
          <view class="people-ratio-seg seg-elderly"   style="width:{{storeProfile.elderlyRatioPct}}%"   wx:if="{{storeProfile.elderlyRatioPct > 0}}"></view>
          <view class="people-ratio-seg seg-other"     style="width:{{storeProfile.otherRatioPct}}%"     wx:if="{{storeProfile.otherRatioPct > 0}}"></view>
        </view>
        <view class="people-ratio-legend">
          <view class="people-legend-item" wx:if="{{storeProfile.partyRatioPct > 0}}">
            <view class="legend-dot dot-legend-party"></view>
            <text class="legend-text">党员 {{storeProfile.partyRatioPct}}%</text>
          </view>
          <view class="people-legend-item" wx:if="{{storeProfile.volunteerRatioPct > 0}}">
            <view class="legend-dot dot-legend-volunteer"></view>
            <text class="legend-text">志愿 {{storeProfile.volunteerRatioPct}}%</text>
          </view>
          <view class="people-legend-item" wx:if="{{storeProfile.elderlyRatioPct > 0}}">
            <view class="legend-dot dot-legend-elderly"></view>
            <text class="legend-text">长者 {{storeProfile.elderlyRatioPct}}%</text>
          </view>
          <view class="people-legend-item" wx:if="{{storeProfile.otherRatioPct > 0}}">
            <view class="legend-dot dot-legend-other"></view>
            <text class="legend-text">其他 {{storeProfile.otherRatioPct}}%</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 🆕 门店人员画像骨架屏：首次请求还在飞、还没有 storeProfile 数据时展示，
         与上面的真实卡片互斥（wx:elif），加载完成后若确认无画像数据则两者都不渲染 -->
    <view class="store-people-card" wx:elif="{{!isAllStoresMode && storeProfileLoading}}">
      <view class="card-header">
        <view class="header-title-box">
          <text class="card-icon">👥</text>
          <text class="card-title">门店人员与服务人群画像</text>
        </view>
      </view>
      <view class="store-people-grid-4col">
        <view class="grid-cell skel-cell" wx:for="{{[1,2,3,4,5,6,7]}}" wx:key="*this">
          <view class="skel-bar skel-bar-xs"></view>
          <view class="skel-bar skel-bar-sm"></view>
        </view>
      </view>
    </view>

    <!-- 🌟 精简空状态：去掉"系统诊断"调试文本与外层黄色卡片框，按钮统一为扁平圆角主色调
         🆕 引导型空状态：三个历史数据分支各自的专属操作保留在上半部分，底部统一
         追加「快捷补报餐报」主按钮 + 「查看有数据月份」辅助按钮（后者仅当
         latestDataLabel 已从本店历史记录里解析出最近一条数据所在月份时才显示，
         见 loadStatistics() 里的计算逻辑） -->
    <view class="smart-empty-card" wx:if="{{!statistics || statistics.recordCount === 0}}">
      <text class="empty-icon">📊</text>
      <text class="empty-title">暂无【{{currentUserStoreName || shopName}}】在选定周期的统计数据</text>

      <!-- 🏷️ 快捷操作胶囊组：所有次要引导操作并排展示，取代原先垂直堆叠的大按钮 -->
      <view class="empty-quick-pill-row">
        <button class="btn-quick-pill btn-quick-pill-gold" wx:if="{{canViewAllStoresDropdown}}" bindtap="onGoToNationalDashboard">🌐 切换全国总览</button>

        <block wx:if="{{currentStoreTotalCount > 0}}">
          <button class="btn-quick-pill" bindtap="onShowAllStoreRecords">📋 全部 {{currentStoreTotalCount}} 条记录</button>
        </block>
        <block wx:elif="{{!isAllStoresMode && hasOtherStoreData}}">
          <button class="btn-quick-pill" bindtap="onSwitchToAllStores">🔄 切换全部门店</button>
        </block>
        <block wx:elif="{{showAllStoresOption && !isAllStoresMode}}">
          <button class="btn-quick-pill" bindtap="onSwitchToAllStores">🏪 全部门店汇总</button>
        </block>

        <button class="btn-quick-pill" wx:if="{{latestDataLabel}}" bindtap="onJumpToLatestDataPeriod">📅 {{latestDataLabel}}</button>
      </view>

      <!-- 条件说明文字 -->
      <text class="empty-suggest-text" wx:if="{{currentStoreTotalCount > 0}}">该门店下共有 {{currentStoreTotalCount}} 条历史记录</text>
      <text class="empty-suggest-text" wx:elif="{{!isAllStoresMode && hasOtherStoreData}}">该周期内其他门店存在餐报记录</text>

      <!-- 主操作：快捷补报（保持全宽红色主按钮） -->
      <button class="btn-empty-primary" hover-class="btn-hover" bindtap="goBackHome">📝 快捷补报餐报</button>
    </view>

    <view class="compliance-disclaimer" wx:if="{{statistics && statistics.recordCount > 0}}">
      <text class="compliance-disclaimer-text">本平台仅用于爱心餐报与志愿服务记录，不直接面向公众发起公开募捐；如涉及个人信息，已在前端做脱敏展示处理。</text>
    </view>
  </scroll-view>

  <!-- 🆕 底部固定导出入口：无论当期是否有数据都常驻展示。
       🐛 UX 重构：此前点击直接复用 exportToExcel() 导出"当前正在看的周期"，
       用户点完既不清楚会导出哪段数据，当期恰好无数据时又只弹一个 Toast 就
       停在原地，没有下一步可做——现在先弹 onOpenExportConfigModal 的周期选择
       配置弹窗，显式选完周期类型 + 年/月再进入已有的"核对 → 确认 → 生成 →
       下载"全流程 -->
  <view class="bottom-sticky-bar" wx:if="{{!showNationalDashboard && !showPersonalView}}">
    <button class="btn-primary-poster" hover-class="ui-hover" wx:if="{{statistics && statistics.recordCount > 0}}" bindtap="onGeneratePoster">
      🖼️ {{isFinance ? '生成门店财务月报海报' : (isPatriarch ? '生成门店续航/爱心公示海报' : '生成本店营运月报海报')}}
    </button>
    <button class="btn-export-shortcut" hover-class="ui-hover" bindtap="onOpenExportConfigModal">
      📊 导出当前周期 Excel 账本
    </button>
  </view>

  <canvas 
    type="2d" 
    id="posterCanvas" 
    style="position: fixed; left: -9999px; top: -9999px; width: 600px; height: 900px;"
  ></canvas>

  <view class="poster-modal-mask" wx:if="{{showPosterModal}}">
    <view class="poster-modal-box">
      <view class="modal-top-bar">
        <text class="modal-title">🖼️ 收支公示海报已生成</text>
        <text class="btn-close-modal" bindtap="onClosePosterModal">✕</text>
      </view>

      <view class="poster-preview-wrapper">
        <image class="poster-img" src="{{posterTempFilePath}}" mode="widthFix" show-menu-by-longpress="{{true}}" />
      </view>

      <view class="save-tip-text">💡 长按图片也可直接发送给好友或保存</view>

      <view class="poster-action-group">
        <button class="btn-poster-action close" bindtap="onClosePosterModal">关闭</button>
        <button class="btn-poster-action share" bindtap="onSharePosterToWeChat">
          <text class="icon">💬</text> 分享到微信
        </button>
        <button class="btn-poster-action save" bindtap="onSavePosterToAlbum">
          <text class="icon">📥</text> 保存到相册
        </button>
      </view>
    </view>
  </view>

  <view class="batch-modal-mask" wx:if="{{showBatchDinerModal}}">
    <view class="batch-modal-content">
      <view class="modal-header">
        <text class="modal-title">🍲 批量补录用餐人数</text>
        <text class="btn-close" bindtap="onCloseBatchDinerModal">✕</text>
      </view>
      
      <view class="modal-tip">快速填入各日期的用餐人次（单位：人）</view>

      <scroll-view scroll-y class="modal-scroll-list">
        <view class="batch-input-row" wx:for="{{missingDinerRecords}}" wx:key="index">
          <text class="row-date">{{item.date}}</text>
          <text class="row-income">+¥{{item.incomeStr}}</text>
          <input 
            class="row-diner-input" 
            type="number" 
            placeholder="填人数" 
            value="{{item.tempDiners}}" 
            bindinput="onBatchDinerInput" 
            data-index="{{index}}"
          />
        </view>
        <view class="fa-safe-area-spacer"></view>
      </scroll-view>

      <view class="modal-footer">
        <button class="btn-modal-cancel" bindtap="onCloseBatchDinerModal">取消</button>
        <button class="btn-modal-submit" bindtap="onSubmitBatchDiners">一键保存更新</button>
      </view>
    </view>
  </view>

  <view class="patch-modal-mask" wx:if="{{showEditMajorModal}}">
    <view class="patch-modal-box">
      <view class="modal-header">
        <text class="modal-title">✏️ 补全【{{editingTargetRecord.date}}】大额开销事由</text>
        <text class="btn-close" bindtap="onCloseEditMajorModal">✕</text>
      </view>

      <view class="modal-tip">系统检测到该笔 -¥{{editingTargetRecord.amount}} 开销缺失具体事由，请填入明细（如：店铺租金6000 义工服2106）：</view>

      <textarea 
        class="patch-textarea" 
        placeholder="例：店铺租金6000 义工服2106" 
        bindinput="onMajorInputBlur"
        value="{{editingInputText}}"
      />

      <view class="modal-footer">
        <button class="btn-modal-cancel" bindtap="onCloseEditMajorModal">取消</button>
        <button class="btn-modal-submit" bindtap="onSubmitPatchMajorText">保存并拆解明细</button>
      </view>
    </view>
  </view>

  <canvas 
    type="2d" 
    id="gratitudeReportCanvas" 
    class="gratitude-canvas-hidden"
    style="position: fixed; left: -9999px; top: -9999px; width: 320px; height: 580px;"
  ></canvas>

  <view class="gratitude-modal-backdrop" wx:if="{{showGratitudeModal}}">
    <view class="gratitude-modal-card">
      <view class="gratitude-modal-header">
        <view class="header-title">
          <text class="icon">❤️</text>
          <text class="text">雨花斋感恩汇报</text>
        </view>
        <text class="close-btn" bindtap="onCloseGratitudeModal">✕</text>
      </view>

      <scroll-view scroll-y class="gratitude-card-body">
        <view class="report-poster-canvas-box">
          <view class="poster-header-banner">
            <view class="main-title">吃素一日 健康一天</view>
            <view class="sub-title">📍 {{gratitudeReportData.storeName || '海沧区雨花斋'}} · {{gratitudeReportData.periodTitle || '2026年度'}}</view>
          </view>

          <view class="status-badge-bar {{isPreparingPhase ? 'preparing' : 'active'}}">
            <text wx:if="{{isPreparingPhase}}">🌱 试运营统筹阶段 · 资金与场地筹备中</text>
            <text wx:else>✨ 顺利开餐运营中 · 温暖爱心传递</text>
          </view>

          <view class="card-section-title">🧡 爱心护持成果</view>
          <view class="metrics-grid-2x2">
            <view class="grid-item">
              <text class="grid-label">累计开餐</text>
              <text class="grid-value">{{gratitudeReportData.diningDays > 0 ? gratitudeReportData.diningDays + ' 天' : '筹备期'}}</text>
            </view>
            <view class="grid-item">
              <text class="grid-label">服务用餐</text>
              <text class="grid-value highlight">{{gratitudeReportData.totalDiners || 0}} 人次</text>
            </view>
            <view class="grid-item">
              <text class="grid-label">义工护持</text>
              <text class="grid-value">{{gratitudeReportData.volunteerCount || 0}} 人次</text>
            </view>
            <view class="grid-item">
              <text class="grid-label">无偿工时</text>
              <text class="grid-value">{{gratitudeReportData.volunteerHours || 0}} 小时</text>
            </view>
          </view>

          <view class="card-section-title">💰 收支透明账本</view>
          <view class="finance-summary-box">
            <view class="finance-row">
              <text class="f-label">服务汇入：</text>
              <text class="f-val income">+¥{{gratitudeIncomeStr || '0.00'}}</text>
            </view>
            <view class="finance-row">
              <text class="f-label">运营支出：</text>
              <text class="f-val expense">-¥{{gratitudeExpenseStr || '0.00'}}</text>
            </view>
            <view class="finance-row total">
              <text class="f-label bold">账户实时总结余：</text>
              <text class="f-val balance">¥{{gratitudeBalanceStr || '0.00'}}</text>
            </view>
          </view>

          <view class="material-status-bar">
            <text class="m-title">📦 主食物资：</text>
            <text class="m-tag {{gratitudeReportData.riceStatus === '告急' ? 'urgent' : ''}}">大米 [{{gratitudeReportData.riceStatus || '一般'}}]</text>
            <text class="m-tag {{gratitudeReportData.oilStatus === '告急' ? 'urgent' : ''}}">食用油 [{{gratitudeReportData.oilStatus || '充足'}}]</text>
          </view>

          <view class="poster-footer-seal">
            <view class="seal-text">
              <text class="heart-quote">感恩各位爱心人士护持与义工团队无私付出！</text>
              <text class="sub-quote">透明账本 · 实时可查</text>
            </view>
          </view>
        </view>
        <view class="fa-safe-area-spacer"></view>
      </scroll-view>

      <view class="gratitude-modal-footer">
        <button class="btn-copy-text" bindtap="onCopyGratitudeText">
          <text>📋 复制文本</text>
        </button>
        <button class="btn-share-wx" bindtap="onForwardGratitudeToWeChat">
          <text>💬 转发微信</text>
        </button>
        <button class="btn-save-card" bindtap="onSaveGratitudeCardToAlbum">
          <text>📥 保存卡片</text>
        </button>
      </view>
    </view>
  </view>

  <!-- ☀️ 阳光宣言辅助弹窗：由阳光大盘标题旁的 ⓘ 图标触发，只做理念/宣言说明，
       不再是进页面就顶在最前面必须先关掉才能看数据的强制弹窗 -->
  <view class="honor-modal-mask" wx:if="{{showSunshineConceptModal}}" bindtap="onCloseSunshineConceptModal">
    <view class="honor-modal-box sunshine-concept-modal-box" catchtap="stopPropagation">
      <view class="honor-modal-header">
        <text class="honor-modal-title">{{sunshineConceptTitle}}</text>
        <view class="honor-modal-close" bindtap="onCloseSunshineConceptModal">
          <text class="close-x-text">✕</text>
        </view>
      </view>
      <view class="sunshine-concept-block">
        <text class="sunshine-concept-label">{{sunshineConceptLabel}}</text>
        <text class="sunshine-concept-text">{{sunshineConceptContent}}</text>
      </view>
      <view class="sunshine-concept-block">
        <text class="sunshine-concept-label">阳光宣言</text>
        <text class="sunshine-concept-text">阳光账本坚持公开透明、全民监督，所有账目与服务数据均经双重核销实时公示。</text>
      </view>
    </view>
  </view>

  <!-- 🔐 专业版功能拦截弹窗：多门店汇总看板/Excel导出触发的套餐升级引导。
       已收敛为跨页面共用组件（见 components/feature-locked-modal），不再
       各页面各自维护一份同款 WXML/WXSS -->
  <feature-locked-modal
    visible="{{showPlanUpgradeModal}}"
    feature-name="{{planUpgradeFeatureName}}"
    can-self-upgrade="{{isPatriarch}}"
    bind:close="onClosePlanUpgradeModal"
  />
</view>
