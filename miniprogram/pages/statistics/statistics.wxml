<view class="container">
  <view class="tab-bar">
    <view 
      class="tab-item {{currentTab === 'week' ? 'active' : ''}}" 
      bindtap="switchTab" 
      data-tab="week"
    >
      📅 本周统计
    </view>
    <view 
      class="tab-item {{currentTab === 'month' ? 'active' : ''}}" 
      bindtap="switchTab" 
      data-tab="month"
    >
      📆 本月统计
    </view>
  </view>

  <view class="month-picker" wx:if="{{currentTab === 'month'}}">
    <picker mode="date" value="{{dateValue}}" fields="month" bindchange="onMonthChange">
      <view class="picker-btn">
        <text>{{selectedYear}}年{{selectedMonth}}月</text>
        <text class="arrow">▼</text>
      </view>
    </picker>
  </view>

  <view class="stats-card" wx:if="{{statistics}}">
    <view class="stats-header">
      <text class="stats-title">{{currentTab === 'week' ? '本周财务汇总' : `${selectedYear}年${selectedMonth}月财务汇总`}}</text>
      <text class="stats-date">{{statistics.startDate}} ~ {{statistics.endDate}}</text>
    </view>

    <view class="stats-grid">
      <view class="stat-item income">
        <text class="stat-value">¥{{statistics.totalIncome.toFixed(2)}}</text>
        <text class="stat-label">总收入</text>
      </view>
      <view class="stat-item expense">
        <text class="stat-value">¥{{statistics.totalExpenses.toFixed(2)}}</text>
        <text class="stat-label">总支出</text>
      </view>
      <view class="stat-item net {{statistics.netBalance >= 0 ? 'positive' : 'negative'}}">
        <text class="stat-value">¥{{statistics.netBalance.toFixed(2)}}</text>
        <text class="stat-label">净结余</text>
      </view>
    </view>

    <view class="progress-section">
      <text class="section-title">收入构成</text>
      <view class="progress-item">
        <text class="progress-label">爱心人士供养</text>
        <view class="progress-bar">
          <view 
            class="progress-fill donation" 
            style="width: {{getDonationPercent()}}%"
          ></view>
        </view>
        <text class="progress-value">¥{{statistics.totalDonations.toFixed(2)}}</text>
      </view>
      <view class="progress-item">
        <text class="progress-label">随喜/现场供养</text>
        <view class="progress-bar">
          <view 
            class="progress-fill batch4" 
            style="width: {{getBatch4Percent()}}%"
          ></view>
        </view>
        <text class="progress-value">¥{{statistics.totalBatch4.toFixed(2)}}</text>
      </view>
    </view>

    <view class="summary-section">
      <view class="summary-row">
        <text class="summary-label">统计天数</text>
        <text class="summary-value">{{statistics.recordCount}} 天</text>
      </view>
      <view class="summary-row">
        <text class="summary-label">日均收入</text>
        <text class="summary-value">¥{{getDailyAverage(statistics.totalIncome, statistics.recordCount)}}</text>
      </view>
      <view class="summary-row">
        <text class="summary-label">日均支出</text>
        <text class="summary-value">¥{{getDailyAverage(statistics.totalExpenses, statistics.recordCount)}}</text>
      </view>
    </view>
  </view>

  <view class="daily-list" wx:if="{{statistics && statistics.dailyRecords && statistics.dailyRecords.length > 0}}">
    <text class="section-title">每日明细</text>
    <view class="daily-item" wx:for="{{statistics.dailyRecords}}" wx:key="index">
      <view class="daily-date">{{item.date}}</view>
      <view class="daily-details">
        <view class="daily-row">
          <text class="detail-label">收入</text>
          <text class="detail-value income">+¥{{item.income.toFixed(2)}}</text>
        </view>
        <view class="daily-row">
          <text class="detail-label">支出</text>
          <text class="detail-value expense">-¥{{item.expenses.toFixed(2)}}</text>
        </view>
        <view class="daily-row">
          <text class="detail-label">结余</text>
          <text class="detail-value balance">¥{{item.balance.toFixed(2)}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!statistics || (statistics.recordCount === 0)}}">
    <text class="empty-icon">📊</text>
    <text class="empty-text">暂无统计数据</text>
    <text class="empty-hint">请先在首页生成餐报记录</text>
  </view>
</view>