.history-page-wrapper {
  position: relative;
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
  box-sizing: border-box;
  background-color: #F7F8FA;
}

.fixed-top-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background-color: #F7F8FA;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.status-bar-spacer {
  width: 100%;
}

/* 🐛 根因修复（标题/图标与胶囊重叠）：此前是 justify-content:space-between +
   标题 position:absolute 在整条头部宽度上居中，右侧 padding 只有固定 24rpx，
   完全没有对齐胶囊按钮真实坐标。改为真正的三段式 flex 布局：返回键固定宽度，
   标题 flex:1 占满剩余空间自行居中省略，右侧图标行跟随内容宽度——整条
   .nav-title-bar 的 padding-right 由 history.ts calculateNavBarHeight() 按
   wx.getMenuButtonBoundingClientRect() 实测出的胶囊安全距离动态绑定（见
   WXML style），标题和图标天然不会越过这条安全线，不再靠猜测的固定数值 */
.nav-title-bar {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-sizing: border-box;
  position: relative;
}

.btn-back-arrow {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #212529;
}

.btn-back-arrow-hover {
  opacity: 0.5;
}

.page-title-txt {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-sizing: border-box;
}

.nav-right-placeholder {
  width: 64rpx;
}

/* 右上角操作区：图册切换 + 设置齿轮，flex:none 保持内容宽度，紧跟在标题
   右侧、整条头部预留的胶囊安全区之前 */
.nav-right-actions {
  flex: none;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.btn-photo-archive-toggle {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border-radius: 30rpx;
}

/* 🆕 隐私脱敏模式「一键眼睛」：与 .btn-photo-archive-toggle 同尺寸，保持右上角
   图标行观感统一 */
.btn-sensitive-reveal {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  border-radius: 30rpx;
}

.btn-photo-archive-toggle-hover {
  background: rgba(0, 0, 0, 0.06);
}

/* 📄 导出财务审计表：原先是横跨一整行的文字按钮，下沉为与 📸/⚙️ 同尺寸的
   图标按钮，收进右上角次要操作区，不再单独占一整行 */
.btn-export-audit-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  border-radius: 30rpx;
}

.btn-export-audit-loading {
  font-size: 26rpx;
}

/* 🛡️ 一键校准入口降级：右上角"⚙️ 设置"图标承载二次菜单，替代原先常驻的显眼大按钮 */
.btn-settings-gear {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.btn-settings-gear:active {
  opacity: 0.6;
}

/* 🌟 统一筛选栏：查看视角 / 站点选择 / 月份选择三列等宽，统一浅灰底 + 深灰字的
   极简下拉选择器观感，取消原先"查看视角"maroon 实心胶囊、月份胶囊白底描边、
   导出按钮金色描边各自不同配色的"花哨拼盘"，三列视觉统一 */
.unified-filter-row {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  padding: 12rpx 24rpx 16rpx;
}

.filter-col {
  flex: 1;
  min-width: 0;
}

/* 🆕 左侧 SegmentedControl 固定紧凑宽度，不再跟右侧门店/月份 Chip 抢等宽空间——
   这正是长门店名此前被压缩截断的根因（三列硬性等分时，门店名可用宽度被压到
   很窄）。文案固定（🏪门店/👤我的 或 🌐全国/🏪门店），180rpx 足够容纳不换行 */
.filter-col-segment {
  flex: 0 0 180rpx;
  min-width: 0;
}

/* 🆕 右侧门店 + 月份两枚胶囊 Chip 分组：平分 SegmentedControl 让出的剩余空间，
   门店 Chip 略宽于月份 Chip（门店名通常比"2026年07月"更长） */
.filter-chips-group {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.filter-chips-group .filter-col:first-child {
  flex: 1.3;
}

.filter-chips-group .filter-col:last-child {
  flex: 1;
}

/* 🐛 WXSS 规范修复：微信小程序不支持组件标签选择器（如 `store-picker`），
   `.filter-col store-picker` 编译期即报违规警告。store-picker 是独立自定义
   组件，样式作用域本就不共享，这里只负责给它在三列布局里分配等宽空间——改为
   在 WXML 上直接打一个纯 class（.filter-col-storepicker），组件内部观感维持
   原样（不在本次改动范围内） */
.filter-col-storepicker {
  display: block;
  width: 100%;
}

.filter-col-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  background: #F5F5F5;
  border-radius: 32rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  gap: 4rpx;
}

.filter-col-seg {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #666;
  padding: 10rpx 0;
  border-radius: 26rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: all 0.2s ease;
}

.filter-col-seg.active {
  background: #FFFFFF;
  color: #C2185B;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.filter-col-lbl {
  font-size: 24rpx;
  color: #343A40;
  font-weight: 500;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-col-pill.month-pill.has-value .filter-col-lbl {
  color: #8C1D18;
  font-weight: bold;
}

.filter-col-arrow {
  font-size: 18rpx;
  color: #868E96;
  flex-shrink: 0;
}

.filter-col-clear {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  background: #E9ECEF;
  color: #6C757D;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: bold;
  transition: all 0.2s ease;
}

.filter-col-clear:active {
  background: #D32F2F;
  color: #FFFFFF;
}

/* ===== 🆕 状态筛选 Tab：全部/待审核/已通过/已驳回 =====
   放在 .fixed-top-header 内部（与筛选栏同级），随头部一起测高、一起固定，
   不需要额外的 sticky/滚动偏移计算 */
.status-tab-row {
  position: relative;
  display: flex;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.status-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  text-align: center;
  font-size: 26rpx;
  color: #868E96;
  padding: 16rpx 0;
  position: relative;
  transition: color 0.25s ease;
}

.status-tab.active {
  color: #8C1D18;
  font-weight: bold;
}

/* 🆕 单条滑动指示条：取代此前每个 Tab 各自独立的 ::after 下划线（瞬时切换/
   容易看起来像"跳变"），改成 .status-tab-row 内唯一一条指示条，靠 left 百分比
   （四个 Tab 等宽 25%，由 statusTabIndex 算出，见 WXML）+ CSS transition
   平滑滑动到目标 Tab 下方，观感上是"同一条线在移动"而不是"旧的消失、新的出现" */
.status-tab-indicator {
  position: absolute;
  bottom: 0;
  width: 25%;
  height: 5rpx;
  transition: left 0.25s ease;
}

.status-tab-indicator::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 40rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background: #8C1D18;
}

/* 🆕 状态 Tab 数量角标：默认灰底深字，待审核态换成警示橙，与全站语义色对齐 */
.status-tab-badge {
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border-radius: 15rpx;
  background: #F1F3F5;
  color: #868E96;
  font-size: 18rpx;
  font-weight: bold;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
  transition: background 0.25s ease, color 0.25s ease;
}

.status-tab.active .status-tab-badge {
  background: #FBE9E7;
  color: #8C1D18;
}

.status-tab-badge.warn {
  background: #FFF3E0;
  color: #FF9F00;
}

.status-tab.active .status-tab-badge.warn {
  background: #FF9F00;
  color: #FFFFFF;
}

