  position: absolute;
  top: 25%;
  left: 50%;
  transform: translateX(-50%);
  font-size: 36rpx;
}

.upload-grid-box .upload-label {
  position: absolute;
  bottom: 22%;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: #64748B;
  font-weight: 500;
  white-space: nowrap;
}

.image-manage-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 0;
}

.img-thumb-item {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  overflow: visible;
}

.thumb-img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  border: 1rpx solid #EFE6D8;
}

.btn-delete-img {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  background: #D32F2F;
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(211, 47, 47, 0.4);
  z-index: 10;
}

.btn-add-img {
  width: 140rpx;
  height: 140rpx;
  background: #F8F9FA;
  border: 2rpx dashed #DEE2E6;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.plus-icon {
  font-size: 40rpx;
  color: #888888;
  line-height: 1;
}

.add-text {
  font-size: 20rpx;
  color: #888888;
  margin-top: 6rpx;
}

.form-input-full {
  width: 100%;
  font-size: 28rpx;
  color: #212529;
  padding: 16rpx;
  background: #F8F9FA;
  border: 1rpx solid #DEE2E6;
  border-radius: 8rpx;
  box-sizing: border-box;
}

/* 卡片顶部 header */
.card-top-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  border-bottom: 1rpx dashed #EFE6D8;
  padding-bottom: 18rpx;
  margin-bottom: 20rpx;
}

.date-box {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.report-date {
  font-size: 32rpx;
  font-weight: bold;
  color: #222222;
  display: block;
}

/* 加深门店标签对比度：#888888 -> #5C5C5C，与日期文字层级拉开但仍清晰可读 */
.store-tag {
  font-size: 20rpx;
  color: #5C5C5C;
  margin-top: 4rpx;
  display: block;
}

/* 单行圆角状态 Flow Tag：同一时刻只展示一枚徽章，取代此前堆叠的两枚状态胶囊 */
.status-flow-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: bold;
  line-height: 1.2;
  white-space: nowrap;
}

/* 待店长确认：醒目黄橙实色背景，与其余淡色胶囊拉开视觉差距，第一时间抓住店长注意力 */
/* 🆕 待审核（黄色）：与全站其余"待处理"轻提示条同一套暖黄色语汇
   （如 org-config 弹窗机构类型 Tag、anomaly-filter-banner） */
.status-flow-tag.st-manager {
  background: #FFF7E6;
  color: #FF9F00;
  border: 1.5rpx solid #FFE1A8;
}

/* 待财务稽核 (庄严淡红) */
/* 🆕 已通过（绿色）：此前用红/粉色（#FFEBEE / #C62828），与"待财务稽核"这一已经
   通过店长确认的正向状态语义相反，容易被误读成"有问题/被驳回"——红色现在专门
   留给真正的驳回/作废状态（见下方 void-seal-box），这里改为绿色系 */
.status-flow-tag.st-finance {
  background: #E6F7EE;
  color: #07C160;
  border: 1.5rpx solid #B7EACB;
}

/* 已锁定 (烫金高级感) */
.status-flow-tag.st-locked {
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 10rpx rgba(7, 193, 96, 0.2);
}

/* 锁定状态下的卡片样式 */
.history-card.state-locked {
  background: #F8FBF8 !important;
  border-color: #C8E6C9 !important;
  position: relative;
  overflow: hidden;
}

/* 财务已封账专属水印 (右上角安全印章) */
.history-card.state-locked::before {
  content: "🛡️ 已封账归档";
  position: absolute;
  top: 80rpx;
  right: 20rpx;
  font-size: 28rpx;
  color: #2E7D32;
  opacity: 0.12;
  font-weight: 900;
  transform: rotate(-15deg);
  pointer-events: none;
  z-index: 0;
  letter-spacing: 2rpx;
}

/* 封账后，所有内部元素的层级需要在水印之上，以免被遮挡 */
.history-card .card-top-header,
.history-card .card-grid-data,
.history-card .card-receipt-section,
.history-card .card-action-footer {
  position: relative;
  z-index: 1;
}

/* 财务稽核专用的绿色操作按钮 */
.btn-finance-lock {
  background: linear-gradient(135deg, #2E7D32 0%, #1B5E20 100%) !important;
  color: #FFFFFF;
  border: none;
}

.btn-finance-lock:active {
  background: #1B5E20 !important;
}

/* 封账后的禁用按钮统一样式 */
.btn-disabled {
  background: #F1F3F5;
  color: #ADB5BD;
  border: 1rpx solid #DEE2E6;
}


/* ================= 优化后的分层操作区样式 ================= */

/* 操作区基础容器：主按钮与次级工具栏间距拉大，加强主次层级差距 */
.card-action-footer {
  margin-top: 24rpx;
  border-top: 2rpx dashed #EFE6D8;
  padding-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 第一层：工作流大按钮 */
.primary-workflow-row {
  width: 100%;
}

.btn-workflow-main {
  width: 100% !important;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  padding: 0;
  margin: 0;
  border: none;
}

.btn-workflow-main::after {
  border: none;
  padding: 0;
  margin: 0;
}

/* 主按钮：待店长确认 / 待财务稽核 —— 统一醒目 CTA 橙色 */
.btn-workflow-audit-cta {
  background: linear-gradient(135deg, #FF9F00 0%, #F08C00 100%);
  color: #FFFFFF;
}

/* 主按钮：已锁定状态下的分享/导出 —— 稳重绿色 */
.btn-workflow-share {
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  color: #FFFFFF;
}

/* 已作废/冲销：无操作按钮，仅一条静态提示条 */
.void-footer-notice {
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: #8c8c8c;
  background: #fafafa;
  border-radius: 12rpx;
  font-weight: 500;
}

/* 已锁定状态下的极简"查看明细"链接 */
.minimal-link-row {
  text-align: center;
}

.btn-minimal-link {
  font-size: 22rpx;
  color: #868E96;
  padding: 8rpx 0;
  display: inline-block;
}

/* 第二层：轻量工具栏 */
.utility-actions-row {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  width: 100%;
}

.btn-utility {
  flex: 1;
  height: 64rpx;
  border-radius: 32rpx;
  font-size: 22rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border: 1.5rpx solid #DEE2E6;
  color: #495057;
  padding: 0 !important;
  margin: 0;
  line-height: normal;
}

.btn-utility::after {
  border: none;
  padding: 0;
  margin: 0;
}

.btn-utility:active {
  background: #F8F9FA;
  transform: scale(0.97);
}

/* ✏️ 编辑：胶囊实色轻按钮——无描边、纯色浅底，视觉分量适中，鼓励日常修正操作 */
.btn-util-edit {
  border: none;
  color: #1565C0;
  background: #E3F2FD;
}

/* 🚨 红字作废：轻量警告线框——透明底 + 描边，视觉分量明显低于「编辑」的实色按钮，
   防止与高频的编辑操作并排时被误触；仅描边不填色，需要用户主动辨认才会点击 */
.btn-util-void {
  border: 1.5rpx solid #FA5151;
  color: #FA5151;
  background: transparent;
}

.btn-util-void:active {
  background: #FFF1F0;
}

/* 🏛️ 家长风控锁：已提交待确认的作废申请，替代原"红字作废"按钮所在位置 */
.btn-util-void-pending {
  border: 1rpx solid #FFE58F;
  color: #D48806;
  background: #FFFBE6;
}

.btn-void-danger {
  flex: 0.8;
  background: #FFEBEE;
  color: #D32F2F;
  border: 1rpx solid #FFCDD2;
  border-radius: 34rpx;
  font-size: 22rpx;
  font-weight: bold;
}

/* 审批状态印章 */
.status-stamp-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: bold;
  z-index: 2;
}

.status-stamp-badge.AUDITED_LOCKED {
  background: #E8F5E9;
  color: #2E7D32;
  border: 1rpx solid #A5D6A7;
}

.status-stamp-badge.APPROVED {
  background: #E3F2FD;
  color: #1565C0;
  border: 1rpx solid #90CAF9;
}

.status-stamp-badge.PENDING_APPROVAL {
  background: #FFF3E0;
  color: #E65100;
  border: 1rpx solid #FFCC80;
}

/* 锁定提示标签 */
.locked-tip-tag {
  font-size: 22rpx;
  color: #666666;
  background: #F5F5F5;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

/* 店长确认按钮 */
.btn-action-pill.btn-approve-record {
  background: #E3F2FD;
  border: 1rpx solid #90CAF9;
}

.btn-action-pill.btn-approve-record .icon {
  font-size: 26rpx;
}

.btn-action-pill.btn-approve-record .lbl {
  font-size: 24rpx;
  color: #1565C0;
  font-weight: bold;
}

.btn-action-pill.btn-approve-record:active {
  background: #BBDEFB;
  transform: scale(0.98);
}

/* 财务稽核锁定按钮 */
.btn-action-pill.btn-audit-lock {
  background: #E8F5E9;
  border: 1rpx solid #A5D6A7;
}

.btn-action-pill.btn-audit-lock .icon {
  font-size: 26rpx;
}

.btn-action-pill.btn-audit-lock .lbl {
  font-size: 24rpx;
  color: #2E7D32;
  font-weight: bold;
}

.btn-action-pill.btn-audit-lock:active {
  background: #C8E6C9;
  transform: scale(0.98);
}

/* 解封按钮 */
.btn-action-pill.btn-unlock-record {
  background: #FFF3E0;
  border: 1rpx solid #FFCC80;
}

.btn-action-pill.btn-unlock-record .icon {
  font-size: 26rpx;
}

.btn-action-pill.btn-unlock-record .lbl {
  font-size: 24rpx;
  color: #E65100;
  font-weight: bold;
}

.btn-action-pill.btn-unlock-record:active {
  background: #FFE0B2;
  transform: scale(0.98);
}

/* ================= 🧾 凭证与账本：今日凭证与记账 + 历史小票九宫格 + 稽核详情弹窗 ================= */

.section-divider-label {
  display: flex;
  align-items: center;
  margin: 28rpx 4rpx 12rpx 4rpx;
}

.section-divider-label .divider-icon {
  font-size: 20rpx;
  margin-right: 8rpx;
}

.section-divider-label .divider-txt {
  font-size: 28rpx;
  font-weight: bold;
  color: #8C1D18;
}

.section-divider-label .divider-date {
  font-size: 22rpx;
  color: #A67558;
  margin-left: 12rpx;
}

.today-ledger-section {
  margin-top: 16rpx;
}

/* 全国总览视角下"今日凭证与记账"整块隐藏，本模块顶部紧接固定头部的"一键校准"提示条，
   额外补足呼吸间距，避免内容紧贴橙色提示条 */
.history-ledger-divider {
  margin-top: 20rpx;
}

/* 🌟 圆角与阴影统一为 16rpx / 0 4rpx 16rpx rgba(0,0,0,0.04)，边距整体提升，与空状态卡片一致 */
.today-ledger-card {
  background: linear-gradient(135deg, #FFFDFB 0%, #FFF8F0 100%);
  border: 1.5rpx solid #FFD3BE;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.today-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.today-expense-block {
  display: flex;
  flex-direction: column;
}

.today-expense-lbl {
  font-size: 22rpx;
  color: #A67558;
  margin-bottom: 4rpx;
}

.today-expense-val {
  font-size: 40rpx;
  font-weight: bold;
  color: #D32F2F;
}

.today-status-pill {
  font-size: 22rpx;
  font-weight: bold;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  background: #FFF3E0;
  color: #FF9F00;
}

.today-status-pill.approved {
  background: #E6F7EE;
  color: #07C160;
}

.today-status-pill.locked {
  background: #ECEFF1;
  color: #455A64;
}

.today-expense-detail-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.today-receipt-9grid,
.receipt-9grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.grid9-item {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1.5rpx solid #EFE6D8;
}

.grid9-item.grey-img {
  filter: grayscale(100%);
  opacity: 0.6;
}

.grid9-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.today-receipt-empty {
  padding: 16rpx 0;
  text-align: center;
}

/* 🆕 快捷上传凭证 FAB：替代此前嵌在今日卡片里的强色通栏大按钮
   （.btn-today-action/.btn-today-upload/.today-action-row 已随之整体移除，
   不再挤占卡片/列表内容区）。悬浮于右下角，任意滚动位置都可快速唤起。
   🐛 吸底层级修复：z-index 提到 200，稳定高于卡片内任何绝对定位装饰元素
   （如 .void-seal-box z-index:10、.status-stamp-badge z-index:2），并低于
   弹窗遮罩（.modal-backdrop/.audit-modal-mask z-index:500/1000），避免打开
   弹窗时 FAB 仍浮在遮罩之上；真正防遮挡的关键是 .history-scroll-list 的
   底部内边距已上调到 160rpx + 安全区（见上方注释），FAB 不会再压住最后一张
   卡片的编辑/作废/分享按钮 */
.fab-upload-receipt {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8C1D18 0%, #6B1512 100%);
  box-shadow: 0 8rpx 20rpx rgba(140, 29, 24, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.fab-upload-receipt-hover {
  opacity: 0.85;
  transform: scale(0.96);
}

.fab-upload-icon {
  font-size: 44rpx;
}

/* 🆕 今日未录入餐报：改为轻量 Alert 提示条（暖黄色，与全站其余轻提示条同一套
   视觉语言），替代此前一整张带虚线边框、内含大按钮的空状态卡片 */
/* 🆕 标准内嵌 NoticeBar：单行布局（图标+文案+"去录入"+关闭按钮），整行可点击
   跳转录入（history.wxml bindtap="goToHome"），与全站其余轻提示条同一套暖黄
   色语汇 */
.today-ledger-empty {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #FFF7E6;
  border: 1rpx solid #FFE1A8;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.today-ledger-empty .alert-icon {
  font-size: 24rpx;
  flex-shrink: 0;
  line-height: 1;
}

.today-ledger-empty .empty-tip {
  font-size: 24rpx;
  color: #B45309;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.btn-go-fill-today-mini {
  font-size: 22rpx;
  font-weight: bold;
  color: #8C1D18;
  flex-shrink: 0;
}

/* 🆕 一键关闭：非阻断式收起整条提醒（onDismissTodayReminder），catchtap 拦截
   冒泡，不会顺带触发外层整行的"去录入"跳转 */
.today-reminder-close {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #C99A4B;
  margin: -8rpx -8rpx -8rpx 0;
}

.today-reminder-close:active {
  opacity: 0.6;
}

.staged-receipt-block {
  margin-top: 12rpx;
  margin-bottom: 8rpx;
}

.staged-tip {
  display: block;
  font-size: 20rpx;
  color: #E65100;
  margin-top: 4rpx;
  margin-bottom: 8rpx;
}

/* 历史卡片：小票九宫格标题行的锁定/对单徽章 */
.r-lock-badge {
  font-size: 18rpx;
  color: #FF9F00;
  background: #FFF3E0;
  border-radius: 12rpx;
  padding: 2rpx 10rpx;
  margin-left: auto;
}

.r-lock-badge.locked {
  color: #455A64;
  background: #ECEFF1;
}

.r-reconcile-badge {
  font-size: 18rpx;
  color: #07C160;
  background: #E6F7EE;
  border-radius: 12rpx;
  padding: 2rpx 10rpx;
  margin-left: 8rpx;
}

/* 稽核详情弹窗 */
.receipt-detail-card {
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.receipt-detail-info-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 32rpx 16rpx 32rpx;
}

.receipt-detail-info-row .detail-expense-val {
  font-size: 26rpx;
  font-weight: bold;
  color: #D32F2F;
}

.receipt-detail-scroll {
  padding: 0 32rpx;
  max-height: 60vh;
}

.detail-9grid {
  margin-bottom: 12rpx;
}

.detail-tip {
  display: block;
  font-size: 20rpx;
  color: #AAAAAA;
  text-align: center;
  margin-bottom: 16rpx;
}

.receipt-detail-actions {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)) 32rpx;
  border-top: 1rpx solid #F0EAE2;
}

.btn-detail-action {
  flex: 1;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 36rpx;
  padding: 14rpx 0;
  line-height: 1.4;
}

.btn-reconcile {
  background: #FFFFFF;
  color: #2E7D32;
  border: 1.5rpx solid #2E7D32;
}

.btn-reconcile.done {
  background: #E8F5E9;
}

.btn-supplement {
  background: #8C1D18;
  color: #FFFFFF;
}

.preview-mode-banner {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 16rpx 24rpx 0;
  padding: 16rpx 20rpx;
  background: #FFF3E0;
  border: 1.5rpx solid #FFB74D;
  border-radius: 12rpx;
}

.preview-mode-banner-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.preview-mode-banner-text {
  font-size: 24rpx;
  color: #E65100;
  line-height: 1.4;
  flex: 1;
}

/* ──────────────────────────────────────────────────────────────────────────── */
/* 📸 图册模式 */
/* ──────────────────────────────────────────────────────────────────────────── */

.photo-archive-container {
  padding: 0 0 40rpx;
}

/* 照片类型过滤标签栏：横向滚动 + 胶囊选中态，替换原先等宽分段控件的
   #C2185B 强调色——与全站其余页面（如上方 .status-tab-row）统一改用
   #8C1D18 主题红，视觉语言不再自成一派 */
.photo-type-tabs-scroll {
  width: 100%;
  white-space: nowrap;
  margin: 16rpx 0;
  box-sizing: border-box;
}

.photo-type-tabs {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 24rpx;
  box-sizing: border-box;
}

.photo-type-tab {
  flex: none;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  color: #6B6B70;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: #F5F5F5;
  white-space: nowrap;
  transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
}

.photo-type-tab-icon {
  font-size: 26rpx;
  line-height: 1;
}

.photo-type-tab-label {
  line-height: 1;
}

.photo-type-tab.active {
  background: #8C1D18;
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(140, 29, 24, 0.28);
}

/* 统计行：张数用主题色数字强调，右侧范围文案改为可点击的下拉胶囊 */
.photo-archive-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx 16rpx;
}

.photo-archive-count {
  font-size: 24rpx;
  color: #888;
}

.photo-archive-count-num {
  font-size: 30rpx;
  font-weight: 700;
  color: #8C1D18;
  margin: 0 2rpx;
}

.photo-archive-range-pill {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #F5F5F5;
}

.photo-archive-range-txt {
  font-size: 24rpx;
  color: #6B6B70;
  font-weight: 600;
}

.photo-archive-range-arrow {
  font-size: 20rpx;
  color: #ADADB2;
}

/* 加载中 */
.photo-archive-loading {
  text-align: center;
  padding: 60rpx 0;
  color: #aaa;
  font-size: 26rpx;
}

/* 瀑布流网格：3 列定高网格，圆角与间距升级——16rpx 圆角 + 微阴影，图片本身
   继续用 aspectFill（对应设计稿的 cover 裁剪），.photo-grid-tags 的 absolute
   叠层定位不受影响（.photo-grid-item 仍是 position:relative 的定位上下文） */
.photo-waterfall-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding: 12rpx 24rpx;
}

.photo-grid-item {
  position: relative;
  height: 200rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #E8E8E8;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.photo-grid-img {
  display: block;
  width: 100%;
  height: 200rpx;
  border-radius: 16rpx;
}

/* 日期 + 类型标签叠加在图片底部 */
.photo-grid-tags {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-end;
  padding: 6rpx 10rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.5));
}

.photo-tag-date {
  font-size: 18rpx;
  color: rgba(255,255,255,0.88);
  line-height: 1.3;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.photo-tag-type {
  font-size: 18rpx;
  color: rgba(255,255,255,0.9);
  flex-shrink: 0;
  margin-left: 4rpx;
}

/* 空状态 */
.photo-archive-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 40rpx;
  gap: 16rpx;
}

.photo-archive-empty-icon {
  font-size: 64rpx;
}

.photo-archive-empty-tip {
  font-size: 28rpx;
  color: #555;
  font-weight: 600;
}

.photo-archive-empty-sub {
  font-size: 24rpx;
  color: #aaa;
  text-align: center;
}

/* ── 长按详情弹窗（复用 .modal-card 基础样式） ── */
.photo-detail-thumb-wrap {
  position: relative;
  width: 100%;
  height: 320rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  background: #E8E8E8;
}

.photo-detail-thumb {
  display: block;
  width: 100%;
  height: 100%;
}

.photo-detail-thumb-hint {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: 20rpx;
}

.photo-detail-info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid #EFE6D8;
}

.photo-detail-info-row:last-of-type {
  border-bottom: none;
}

.photo-detail-info-lbl {
  color: #777777;
}

.photo-detail-info-val {
  color: #333333;
  font-weight: 600;
}