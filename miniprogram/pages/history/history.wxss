.history-page-wrapper {
  position: relative;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #F8F9FA;
}

.fixed-top-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background-color: #F8F9FA;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.status-bar-spacer {
  width: 100%;
}

.nav-title-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  position: relative;
}

.btn-back-arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #212529;
}

.page-title-txt {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
}

.nav-right-placeholder {
  width: 64rpx;
}

.mode-switch-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 32rpx 16rpx 32rpx;
  background: linear-gradient(90deg, #f7f8fa 0%, #fff 20%, #fff 80%, #f7f8fa 100%);
}

.mode-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 12rpx;
}

.mode-switch-pill {
  display: flex;
  background: #F8F9FA;
  border: 1rpx solid #E9ECEF;
  border-radius: 30rpx;
  padding: 4rpx;
}

.mode-switch-pill .tab {
  padding: 8rpx 24rpx;
  font-size: 22rpx;
  color: #666;
  border-radius: 26rpx;
  transition: all 0.2s ease;
}

.mode-switch-pill .tab.active {
  background: #8C1D18;
  color: #fff;
  font-weight: bold;
}

.admin-tools-row {
  padding: 8rpx 24rpx 16rpx 24rpx;
}

.btn-recalibrate {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
  color: #E65100;
  border: 1rpx solid #FFCC80;
  border-radius: 30rpx;
  padding: 12rpx 0;
  font-size: 22rpx;
  font-weight: bold;
}

.btn-recalibrate .icon {
  font-size: 26rpx;
}

.month-pill .lbl {
  font-size: 22rpx;
  color: #444;
}

.filter-pills-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 24rpx 16rpx 24rpx;
}

.filter-controls-group {
  display: flex;
  gap: 16rpx;
}

.filter-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #FFFFFF;
  border: 1rpx solid #CED4DA;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}

.filter-pill .lbl {
  font-size: 24rpx;
  color: #343A40;
  font-weight: bold;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.month-filter-capsule-box {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #CED4DA;
  border-radius: 30rpx;
  padding: 2rpx 6rpx;
  overflow: hidden;
}

.filter-pill.month-pill.has-value .lbl {
  color: #8C1D18;
}

.btn-clear-month {
  width: 36rpx;
  height: 36rpx;
  background: #E9ECEF;
  color: #6C757D;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: bold;
  margin-right: 10rpx;
  transition: all 0.2s ease;
}

.btn-clear-month:active {
  background: #D32F2F;
  color: #FFFFFF;
}

.filter-pill .arrow {
  font-size: 20rpx;
  color: #868E96;
}

.btn-clear-empty-pill {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #FFF5F5;
  border: 1rpx solid #FFC9C9;
  padding: 8rpx 18rpx;
  border-radius: 30rpx;
}

.btn-clear-empty-pill .icon {
  font-size: 22rpx;
}

.btn-clear-empty-pill .lbl {
  font-size: 22rpx;
  color: #E03131;
}

.history-tools-bar {
  padding: 16rpx 24rpx 8rpx 24rpx;
}

.btn-fix-ledger {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  width: 100%;
  height: 80rpx;
  background: #F5A623;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 20rpx rgba(245, 166, 35, 0.3);
  transition: all 0.2s ease;
}

.btn-fix-ledger:active {
  background: #E09513;
  transform: scale(0.98);
}

.btn-fix-ledger .icon {
  font-size: 28rpx;
}

.btn-fix-ledger .lbl {
  color: #FFFFFF;
  font-weight: bold;
}

.history-scroll-list {
  height: 100vh;
  padding: 0 24rpx 40rpx 24rpx;
  box-sizing: border-box;
}

.history-list-box {
  padding: 16rpx 0;
}

.history-card {
  position: relative;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid #F1F3F5;
}

.history-card.locked-card {
  border-left: 8rpx solid #2E7D32;
}

.history-card.state-voided {
  background: #F8F9FA !important;
  border-color: #E9ECEF !important;
  opacity: 0.8;
}

.void-seal-box {
  position: absolute;
  top: 20rpx;
  right: 140rpx;
  width: 100rpx;
  height: 100rpx;
  border: 4rpx double #D32F2F;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-18deg);
  opacity: 0.85;
  z-index: 10;
  pointer-events: none;
}

.void-seal-box .seal-txt {
  font-size: 18rpx;
  color: #D32F2F;
  font-weight: bold;
  text-align: center;
  line-height: 1.2;
}

.strikethrough {
  text-decoration: line-through;
  color: #999999 !important;
}

.grey-img {
  filter: grayscale(100%);
  opacity: 0.6;
}

.error-badge {
  font-size: 18rpx;
  color: #D32F2F;
  background: #FFEBEE;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
  font-weight: bold;
}

.date-title-row {
  display: flex;
  align-items: center;
}

.card-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.card-top-bar .date-group {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.card-top-bar .record-date {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
}

.card-top-bar .store-badge {
  font-size: 22rpx;
  color: #868E96;
  background: #F8F9FA;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  width: fit-content;
}

.card-top-bar .status-badge-group {
  display: flex;
  gap: 8rpx;
}

.card-top-bar .stamp-badge {
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.card-top-bar .stamp-badge.approved {
  background: #E3F2FD;
  color: #1565C0;
  border: 1rpx solid #90CAF9;
}

.card-top-bar .stamp-badge.locked {
  background: #E8F5E9;
  color: #2E7D32;
  border: 1rpx solid #A5D6A7;
}

.card-header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.header-left-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.record-date {
  font-size: 32rpx;
  font-weight: 800;
  color: #212529;
  white-space: nowrap;
  flex-shrink: 0;
}

.store-badge {
  font-size: 20rpx;
  color: #1C7ED6;
  background: #E7F5FF;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
}

.header-right-actions {
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
}

.action-btn {
  font-size: 22rpx;
  padding: 4rpx 8rpx;
  white-space: nowrap;
}

.action-btn.delete {
  color: #868E96;
}

.action-btn.report {
  color: #D9480E;
}

.net-income-banner {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.net-income-banner.positive {
  background: #E6FCF5;
}

.net-income-banner.negative {
  background: #FFF5F5;
}

.net-income-banner .banner-lbl {
  font-size: 22rpx;
  color: #0CA678;
}

.net-income-banner.negative .banner-lbl {
  color: #E03131;
}

.net-income-banner .banner-val {
  font-size: 24rpx;
  font-weight: bold;
  color: #0CA678;
}

.net-income-banner.negative .banner-val {
  color: #E03131;
}

.card-header-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.metric-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  white-space: nowrap;
}

.metric-tag.info {
  background: #F8F9FA;
  color: #495057;
}

.balance-4grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx 24rpx;
  padding: 16rpx 0;
  border-top: 1rpx dashed #F1F3F5;
  border-bottom: 1rpx dashed #F1F3F5;
  margin-bottom: 20rpx;
}

.grid-cell {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.cell-lbl {
  font-size: 22rpx;
  color: #868E96;
}

.cell-val {
  font-size: 28rpx;
  color: #212529;
}

.cell-val.bold {
  font-weight: bold;
}

.cell-val.green {
  color: #2B8A3E;
  font-weight: bold;
}

.cell-val.red {
  color: #E03131;
  font-weight: bold;
}

.cell-val.orange {
  color: #F59F00;
  font-weight: bold;
}

.card-receipts {
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #F1F3F5;
  margin-bottom: 20rpx;
}

.receipts-label {
  display: block;
  font-size: 24rpx;
  color: #868E96;
  margin-bottom: 12rpx;
}

.receipts-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.receipt-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  border: 1rpx solid #eee;
}

.card-bottom-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.card-bottom-actions .btn-action-pill {
  flex: 1;
  min-width: 0;
}

.btn-action-pill {
  height: 68rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: all 0.2s ease;
}

.btn-action-pill.btn-share-wechat {
  background: #FFF9DB;
  border: 1rpx solid #FFE066;
  padding: 0 !important;
  margin: 0 !important;
  line-height: normal;
  font-size: 0;
}

.btn-action-pill.btn-share-wechat .icon {
  font-size: 26rpx;
}

.btn-action-pill.btn-share-wechat .lbl {
  font-size: 24rpx;
  color: #7A4D00;
  font-weight: bold;
}

.btn-action-pill.btn-share-wechat:active {
  background: #FFF3BF;
  transform: scale(0.98);
}

.btn-action-pill.btn-share-wechat::after {
  border: none;
  padding: 0;
  margin: 0;
}

.btn-action-pill.btn-edit-record {
  background: #E7F5FF;
  border: 1rpx solid #A5D8FF;
}

.btn-action-pill.btn-edit-record .icon {
  font-size: 26rpx;
}

.btn-action-pill.btn-edit-record .lbl {
  font-size: 24rpx;
  color: #1C7ED6;
  font-weight: bold;
}

.btn-action-pill.btn-edit-record:active {
  background: #D0EBFF;
  transform: scale(0.98);
}

.history-empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #868E96;
}

.btn-go-home {
  font-size: 30rpx;
  color: #fff;
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  border: none;
  border-radius: 44rpx;
  padding: 20rpx 64rpx;
  margin-top: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(245, 158, 11, 0.3);
}

.btn-go-home::after {
  border: none;
}

.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-card {
  width: 90%;
  max-width: 660rpx;
  background: #FAF8F5;
  border-radius: 36rpx;
  padding: 32rpx;
  box-sizing: border-box;
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.15);
}

.edit-report-card {
  width: 90%;
  max-width: 660rpx;
  background: #FAF8F5;
  border-radius: 36rpx;
  padding: 32rpx;
  box-sizing: border-box;
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.15);
}

.modal-header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.title-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pendant-dot {
  color: #8C1D18;
  font-size: 24rpx;
}

.modal-title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #8C1D18;
}

.modal-close-btn {
  font-size: 36rpx;
  color: #999999;
  padding: 10rpx;
}

.edit-scroll-body {
  max-height: 65vh;
  box-sizing: border-box;
}

.info-readonly-card {
  background: #FFFFFF;
  border: 1rpx solid #EFE6D8;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.readonly-item {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 26rpx;
}

.readonly-item .label {
  color: #777777;
}

.readonly-item .value {
  color: #333333;
  font-weight: bold;
}

.highlight-date {
  color: #8C1D18 !important;
}

.form-group-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #EFE6D8;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-badge {
  font-size: 24rpx;
  font-weight: bold;
  color: #8C1D18;
  background: #FFF0ED;
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
  display: inline-block;
  margin-bottom: 20rpx;
}

.section-title-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.badge-counter {
  font-size: 22rpx;
  color: #8C1D18;
  font-weight: bold;
}

.form-field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.field-label {
  font-size: 26rpx;
  color: #444444;
  width: 130rpx;
  flex-shrink: 0;
}

.input-wrapper {
  flex: 1;
  background: #FDFDFD;
  border: 2rpx solid #D6CEBF;
  border-radius: 16rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.currency-unit {
  font-size: 28rpx;
  color: #888888;
  margin-right: 8rpx;
}

.field-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #333333;
}

.font-bold {
  font-weight: bold;
}

.text-red {
  color: #C62828 !important;
}

.text-grey {
  color: #888888 !important;
}

.locked-bg {
  background: #F4F3F0 !important;
  border-color: #E2DDD5 !important;
}

.lock-icon {
  font-size: 24rpx;
  margin-left: 10rpx;
}

.balance-row {
  border-top: 1rpx dashed #EFE6D8;
  padding-top: 20rpx;
  margin-top: 20rpx;
}

.gold-label {
  font-weight: bold;
  color: #B57C1E !important;
}

.balance-value {
  font-size: 34rpx;
  font-weight: 900;
  color: #B57C1E;
}

.double-column-row {
  display: flex;
  gap: 20rpx;
}

.column-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.col-label {
  font-size: 24rpx;
  color: #666666;
}

.col-input {
  background: #FDFDFD;
  border: 2rpx solid #D6CEBF;
  border-radius: 16rpx;
  height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.receipt-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.grid-img-wrap {
  position: relative;
  width: 100%;
  padding-top: 100%;
}

.grid-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  border: 1rpx solid #EFE6D8;
}

.img-delete-dot {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 34rpx;
  height: 34rpx;
  background: rgba(140, 29, 24, 0.9);
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: bold;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.grid-add-btn {
  background: #FDFDFD;
  border: 2rpx dashed #C8B195;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  aspect-ratio: 1 / 1;
}

.grid-add-btn .plus-icon {
  font-size: 38rpx;
  color: #8C1D18;
  font-weight: 300;
}

.grid-add-btn .add-txt {
  font-size: 18rpx;
  color: #8C1D18;
}

.form-field-row-vertical {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 20rpx;
}

.form-textarea {
  width: 100%;
  height: 120rpx;
  background: #FDFDFD;
  border: 2rpx solid #D6CEBF;
  border-radius: 16rpx;
  padding: 16rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.modal-footer-box {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.btn-cancel {
  flex: 1;
  height: 84rpx;
  background: #EFEBE4;
  color: #666155;
  border-radius: 42rpx;
  font-size: 26rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-cancel::after {
  border: none;
  padding: 0;
  margin: 0;
}

.btn-save-recalc {
  flex: 1.8;
  height: 84rpx;
  background: linear-gradient(135deg, #FF9E22 0%, #E65100 100%);
  color: #FFFFFF;
  border-radius: 42rpx;
  font-size: 26rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(230, 81, 0, 0.2);
}

.btn-save-recalc::after {
  border: none;
  padding: 0;
  margin: 0;
}

/* ================= 历史卡片小票预览条 ================= */
.card-receipt-section {
  background: #FAF8F5;
  border-radius: 16rpx;
  padding: 16rpx;
  margin: 18rpx 0;
  border: 1rpx solid #F0E8DD;
}

.receipt-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.receipt-title-row .r-icon { font-size: 24rpx; margin-right: 6rpx; }
.receipt-title-row .r-title { font-size: 22rpx; font-weight: bold; color: #444444; }
.receipt-title-row .r-count { font-size: 20rpx; color: #888888; margin-left: 6rpx; }

.receipt-horizontal-scroll {
  width: 100%;
  white-space: nowrap;
}

.receipt-strip-list {
  display: flex;
  gap: 12rpx;
}

.receipt-strip-img {
  width: 110rpx;
  height: 110rpx;
  border-radius: 12rpx;
  border: 1.5rpx solid #EFE6D8;
  flex-shrink: 0;
}

.card-receipt-empty {
  padding: 10rpx 0;
  text-align: center;
}

.card-receipt-empty .empty-tip { font-size: 20rpx; color: #B0B0B0; }

/* ================= 编辑弹窗 4 宫格网格 ================= */
.receipt-grid-4col {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 8rpx 0 16rpx 0;
}

.grid-img-wrapper {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  border-radius: 16rpx;
}

.grid-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  border: 1.5rpx solid #EFE6D8;
}

.delete-badge {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: #D32F2F;
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 10rpx rgba(211, 47, 47, 0.4);
  z-index: 10;
}

.upload-grid-box {
  width: 100%;
  padding-bottom: 100%;
  position: relative;
  background: #F9FAFB;
  border: 2rpx dashed #CBD5E1;
  border-radius: 16rpx;
}

.upload-grid-box .camera-icon {
  position: absolute;
  top: 25%;
  left: 50%;
  transform: translateX(-50%);
  font-size: 36rpx;
}

.upload-grid-box .upload-label {
  position: absolute;
  bottom: 22%;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: #64748B;
  font-weight: 500;
  white-space: nowrap;
}

.image-manage-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 0;
}

.img-thumb-item {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  overflow: visible;
}

.thumb-img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  border: 1rpx solid #EFE6D8;
}

.btn-delete-img {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  background: #D32F2F;
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(211, 47, 47, 0.4);
  z-index: 10;
}

.btn-add-img {
  width: 140rpx;
  height: 140rpx;
  background: #F8F9FA;
  border: 2rpx dashed #DEE2E6;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.plus-icon {
  font-size: 40rpx;
  color: #888888;
  line-height: 1;
}

.add-text {
  font-size: 20rpx;
  color: #888888;
  margin-top: 6rpx;
}

.form-input-full {
  width: 100%;
  font-size: 28rpx;
  color: #212529;
  padding: 16rpx;
  background: #F8F9FA;
  border: 1rpx solid #DEE2E6;
  border-radius: 8rpx;
  box-sizing: border-box;
}

/* 卡片顶部 header */
.card-top-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  border-bottom: 1rpx dashed #EFE6D8;
  padding-bottom: 18rpx;
  margin-bottom: 20rpx;
}

.date-box {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.report-date {
  font-size: 32rpx;
  font-weight: bold;
  color: #222222;
  display: block;
}

.store-tag {
  font-size: 20rpx;
  color: #888888;
  margin-top: 4rpx;
  display: block;
}

/* 状态胶囊容器 */
.status-badge-group {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: flex-end;
}

/* 状态胶囊基础样式 (加大字号与内边距) */
.status-badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: bold;
  line-height: 1;
}

.badge-icon { margin-right: 6rpx; font-size: 22rpx; }

/* 待店长确认 (醒目亮黄) */
.status-badge.pending-manager {
  background: #FFF3E0;
  color: #E65100;
  border: 1rpx solid #FFE0B2;
}

/* 店长已确认 (柔和草绿) */
.status-badge.confirmed {
  background: #E8F5E9;
  color: #2E7D32;
  border: 1rpx solid #C8E6C9;
}

/* 待财务稽核 (庄严淡红) */
.status-badge.pending-finance {
  background: #FFEBEE;
  color: #C62828;
  border: 1rpx solid #FFCDD2;
}

/* 账本已锁定 (烫金高级感) */
.status-badge.audited {
  background: linear-gradient(135deg, #2E7D32 0%, #1B5E20 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 10rpx rgba(46, 125, 50, 0.2);
}

/* 锁定状态下的卡片样式 */
.history-card.state-locked {
  background: #F8FBF8 !important;
  border-color: #C8E6C9 !important;
  position: relative;
  overflow: hidden;
}

/* 财务已封账专属水印 (右上角安全印章) */
.history-card.state-locked::before {
  content: "🛡️ 已封账归档";
  position: absolute;
  top: 80rpx;
  right: 20rpx;
  font-size: 28rpx;
  color: #2E7D32;
  opacity: 0.12;
  font-weight: 900;
  transform: rotate(-15deg);
  pointer-events: none;
  z-index: 0;
  letter-spacing: 2rpx;
}

/* 封账后，所有内部元素的层级需要在水印之上，以免被遮挡 */
.history-card .card-top-header,
.history-card .card-grid-data,
.history-card .card-receipt-section,
.history-card .card-action-footer {
  position: relative;
  z-index: 1;
}

/* 财务稽核专用的绿色操作按钮 */
.btn-finance-lock {
  background: linear-gradient(135deg, #2E7D32 0%, #1B5E20 100%) !important;
  color: #FFFFFF;
  border: none;
}

.btn-finance-lock:active {
  background: #1B5E20 !important;
}

/* 封账后的禁用按钮统一样式 */
.btn-disabled {
  background: #F1F3F5;
  color: #ADB5BD;
  border: 1rpx solid #DEE2E6;
}

/* 高亮背景 */
.grid-cell.highlight-bg {
  background: #FFFDF8;
  border-radius: 12rpx;
  padding: 8rpx 12rpx;
}

/* ================= 优化后的分层操作区样式 ================= */

/* 操作区基础容器 */
.card-action-footer {
  margin-top: 24rpx;
  border-top: 2rpx dashed #EFE6D8;
  padding-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 第一层：工作流大按钮 */
.primary-workflow-row {
  width: 100%;
}

.btn-workflow-main {
  width: 100% !important;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  padding: 0;
  margin: 0;
  border: none;
}

.btn-workflow-main::after {
  border: none;
  padding: 0;
  margin: 0;
}

/* 待店长确认 */
.btn-workflow-confirm {
  background: linear-gradient(135deg, #FF9100 0%, #FF6D00 100%);
  color: #FFFFFF;
}

/* 待财务审计 */
.btn-workflow-audit {
  background: linear-gradient(135deg, #00C853 0%, #009624 100%);
  color: #FFFFFF;
}

/* 禁用与封账置灰态 */
.btn-state-disabled, .btn-state-locked {
  background: #ECEFF1 !important;
  color: #90A4AE !important;
  border: 1rpx solid #CFD8DC !important;
  box-shadow: none !important;
}

/* 第二层：轻量工具栏 */
.utility-actions-row {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  width: 100%;
}

.btn-utility {
  flex: 1;
  height: 64rpx;
  border-radius: 32rpx;
  font-size: 22rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border: 1.5rpx solid #DEE2E6;
  color: #495057;
  padding: 0 !important;
  margin: 0;
  line-height: normal;
}

.btn-utility::after {
  border: none;
  padding: 0;
  margin: 0;
}

.btn-utility:active {
  background: #F8F9FA;
  transform: scale(0.97);
}

/* 分享微信高亮绿边 */
.btn-util-share {
  border-color: #A5D6A7;
  color: #2E7D32;
  background: #F1F8F5;
}

/* 编辑按钮淡雅蓝 */
.btn-util-edit {
  border-color: #90CAF9;
  color: #1565C0;
  background: #E3F2FD;
}

/* 作废危险红色 */
.btn-util-void {
  border-color: #EF9A9A;
  color: #C62828;
  background: #FFEBEE;
}

.btn-void-danger {
  flex: 0.8;
  background: #FFEBEE;
  color: #D32F2F;
  border: 1rpx solid #FFCDD2;
  border-radius: 34rpx;
  font-size: 22rpx;
  font-weight: bold;
}

/* 审批状态印章 */
.status-stamp-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: bold;
  z-index: 2;
}

.status-stamp-badge.AUDITED_LOCKED {
  background: #E8F5E9;
  color: #2E7D32;
  border: 1rpx solid #A5D6A7;
}

.status-stamp-badge.APPROVED {
  background: #E3F2FD;
  color: #1565C0;
  border: 1rpx solid #90CAF9;
}

.status-stamp-badge.PENDING_APPROVAL {
  background: #FFF3E0;
  color: #E65100;
  border: 1rpx solid #FFCC80;
}

/* 锁定提示标签 */
.locked-tip-tag {
  font-size: 22rpx;
  color: #666666;
  background: #F5F5F5;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

/* 店长确认按钮 */
.btn-action-pill.btn-approve-record {
  background: #E3F2FD;
  border: 1rpx solid #90CAF9;
}

.btn-action-pill.btn-approve-record .icon {
  font-size: 26rpx;
}

.btn-action-pill.btn-approve-record .lbl {
  font-size: 24rpx;
  color: #1565C0;
  font-weight: bold;
}

.btn-action-pill.btn-approve-record:active {
  background: #BBDEFB;
  transform: scale(0.98);
}

/* 财务稽核锁定按钮 */
.btn-action-pill.btn-audit-lock {
  background: #E8F5E9;
  border: 1rpx solid #A5D6A7;
}

.btn-action-pill.btn-audit-lock .icon {
  font-size: 26rpx;
}

.btn-action-pill.btn-audit-lock .lbl {
  font-size: 24rpx;
  color: #2E7D32;
  font-weight: bold;
}

.btn-action-pill.btn-audit-lock:active {
  background: #C8E6C9;
  transform: scale(0.98);
}

/* 解封按钮 */
.btn-action-pill.btn-unlock-record {
  background: #FFF3E0;
  border: 1rpx solid #FFCC80;
}

.btn-action-pill.btn-unlock-record .icon {
  font-size: 26rpx;
}

.btn-action-pill.btn-unlock-record .lbl {
  font-size: 24rpx;
  color: #E65100;
  font-weight: bold;
}

.btn-action-pill.btn-unlock-record:active {
  background: #FFE0B2;
  transform: scale(0.98);
}