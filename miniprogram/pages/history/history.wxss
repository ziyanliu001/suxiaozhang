page {
  background-color: #f7f8fa;
}

.page-container {
  min-height: 100vh;
  background-color: #f7f8fa;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  background-color: #f7f8fa;
}

.nav-left {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.back-icon {
  font-size: 44rpx;
  color: #333;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.nav-right {
  width: 80rpx;
}

.content-section {
  height: calc(100vh - 100rpx);
  padding: 0 24rpx;
  padding-bottom: 60rpx;
}

.report-list {
  padding: 24rpx 0;
}

.report-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-date {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.card-shop {
  font-size: 26rpx;
  color: #999;
  padding: 8rpx 16rpx;
  background-color: #f5f5f5;
  border-radius: 20rpx;
}

.card-divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, #eee 10%, #eee 90%, transparent 100%);
  margin: 24rpx 0;
}

.card-body {
  display: flex;
  flex-wrap: wrap;
}

.stat-item {
  width: 50%;
  display: flex;
  flex-direction: column;
  padding: 16rpx 0;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.stat-value.income {
  color: #52c41a;
}

.stat-value.expense {
  color: #ff4d4f;
}

.stat-value.balance {
  color: #f59e0b;
}

.card-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 24rpx;
}

.copy-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #f59e0b;
  background-color: rgba(245, 158, 11, 0.1);
  border: none;
  border-radius: 32rpx;
  padding: 16rpx 28rpx;
}

.copy-icon {
  font-size: 28rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: calc(100vh - 200rpx);
  padding: 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 48rpx;
}

.btn-go-home {
  font-size: 30rpx;
  color: #fff;
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  border: none;
  border-radius: 44rpx;
  padding: 20rpx 64rpx;
  box-shadow: 0 8rpx 24rpx rgba(245, 158, 11, 0.3);
}

.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  height: calc(100vh - 200rpx);
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.btn-hover {
  opacity: 0.8;
}