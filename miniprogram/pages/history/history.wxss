.history-scroll-list {
  height: 100vh;
  /* history 已不是 TabBar 页面（通过 navigateTo 进入，无底部导航栏），仅预留安全区。
     🐛 底部内边距额外叠加 FAB 直径(96rpx)+间距，避免滚动到底部时最后一张卡片的
     操作按钮（编辑/红字作废/分享）被悬浮拍照按钮遮挡 */
  padding: 0 24rpx calc(160rpx + env(safe-area-inset-bottom)) 24rpx;
  box-sizing: border-box;
}

