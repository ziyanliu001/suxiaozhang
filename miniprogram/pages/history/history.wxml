<view class="history-page-wrapper">
  <!-- 🌟 微信用户隐私授权弹窗：本页会调用 chooseMedia（上传补充凭证照片等）隐私接口 -->
  <privacy-popup />
  <watermark identity="{{watermarkIdentity}}" />
  <view class="fixed-top-header">
    <view class="status-bar-spacer" style="height: {{statusBarHeight}}px;"></view>

    <view class="nav-title-bar" style="height: {{navBarHeight}}px; padding-right: {{navCapsuleSafePx}}px;">
      <view class="btn-back-arrow" hover-class="btn-back-arrow-hover" bindtap="goBack">←</view>
      <text class="page-title-txt">{{pageTitle || '🧾 凭证与账本'}}</text>
      <view class="nav-right-actions">
        <!-- 🆕 隐私脱敏模式「一键眼睛」：仅当设置页开关开启时展示，临时显示/隐藏
             本页所有金额（会话内展示态，不影响持久化开关） -->
        <view class="btn-sensitive-reveal" hover-class="btn-photo-archive-toggle-hover" wx:if="{{!photoArchiveMode && privacyMaskEnabled}}" bindtap="onToggleSensitiveReveal">
          <text>{{sensitiveRevealed ? '🙈' : '👁️'}}</text>
        </view>
        <!-- 📄 导出财务审计表：从原先横跨一整行的文字按钮下沉为图标，仅账本模式展示 -->
        <view class="btn-export-audit-icon" hover-class="btn-photo-archive-toggle-hover" wx:if="{{!photoArchiveMode && (isManagerOrAdmin || isFinanceOrAdmin)}}" bindtap="onExportMonthlyAudit">
          <text wx:if="{{!exportingAudit}}">📄</text>
          <text wx:else class="btn-export-audit-loading">⏳</text>
        </view>
        <!-- 📸 图册/账本模式切换 -->
        <view class="btn-photo-archive-toggle" hover-class="btn-photo-archive-toggle-hover" bindtap="onTogglePhotoArchive">
          <text>{{photoArchiveMode ? '📒' : '📸'}}</text>
        </view>
        <!-- 🛡️ 一键校准入口降级：从顶部常驻按钮收进这里的"⚙️ 设置"二次菜单，降低误触概率 -->
        <view class="btn-settings-gear" wx:if="{{!photoArchiveMode && (isManagerRole || isFinanceRole || isSuperAdmin)}}" bindtap="onOpenHistorySettingsMenu">⚙️</view>
      </view>
    </view>

    <!-- 🌟 统一筛选栏：查看视角 / 站点选择 / 月份选择合并为一行三列极简选择器。
         🐛 根因修复：此前这一整块没有 photoArchiveMode 判断，切到图册模式后，
         账本专属的这一整套筛选栏（查看视角 + 站点 + 月份 + 导出审计表按钮）
         仍会和下方图册自己的 photo-type-tabs 同屏堆叠——两套毫不相关的筛选控件
         叠在一起，才是"控件过多、视觉杂乱"的真正根因。现在加上 wx:if 严格
         互斥：账本模式显示这一栏，图册模式显示 photo-type-tabs，绝不同屏 -->
    <!-- 🆕 个人视角入口（mineEntryMode，见 history.ts onLoad）：隐去"门店/我的"
         切换栏与门店选择下拉框，专注展示个人提交记录，避免非管理员用户面对一堆
         与自己无关的门店管理向控件；月份筛选仍保留，翻查自己历史记录时依然有用 -->
    <!-- 🆕 第一行（快速过滤器）布局重排：左侧「全部门店/我的」SegmentedControl
         紧凑固定宽度，右侧门店/月份两枚胶囊 Chip 平分剩余空间——此前三列等宽
         挤在一起是门店名长文本被压缩截断的直接原因，SegmentedControl 文案固定
         就不需要跟门店名抢等宽空间 -->
    <view class="unified-filter-row" wx:if="{{!photoArchiveMode}}">
      <view class="filter-col filter-col-segment" wx:if="{{!mineEntryMode}}">
        <view class="filter-col-pill">
          <!-- 🛡️ 越权兜底：即使 isAllStoresView 因某种异常状态被误置为 true，
               这里再叠加一层 isSuperAdmin 校验，非超管永远只能看到"🏪 门店账本"，
               绝不渲染"🌐 全国汇总"文案——与 resolveIsAllStoresView()/loadReports()
               的角色校验口径保持一致，双保险 -->
          <text class="filter-col-seg {{viewMode === 'all' ? 'active' : ''}}" bindtap="switchViewMode" data-mode="all">
            <block wx:if="{{isSuperAdmin}}">{{isAllStoresView ? '🌐 全国' : '🏪 门店'}}</block>
            <block wx:else>🏪 门店</block>
          </text>
          <text class="filter-col-seg {{viewMode === 'personal' ? 'active' : ''}}" bindtap="switchViewMode" data-mode="personal">👤 我的</text>
        </view>
      </view>

      <view class="filter-chips-group">
        <!-- 🐛 长门店名截断修复：store-picker 内部展示文案配合这里给出的
             flex-basis 自适应收缩 + ellipsis，展示不下时省略号收尾；组件本身
             点击即拉起完整门店选择面板（见 store-picker.wxml），面板里门店名
             不再受这条胶囊宽度限制，等同于"点击查看完整名称" -->
        <view class="filter-col" wx:if="{{!mineEntryMode}}">
          <store-picker id="historyStorePicker" class="filter-col-storepicker" bind:storechange="onStorePickerChange"></store-picker>
        </view>

        <view class="filter-col">
          <picker mode="date" fields="month" value="{{selectedMonthStr}}" bindchange="onMonthFilterChange">
            <view class="filter-col-pill month-pill {{selectedMonthStr ? 'has-value' : ''}}">
              <text class="filter-col-lbl">📅 {{selectedMonthDisplay || '全部月份'}}</text>
              <text class="filter-col-arrow" wx:if="{{!selectedMonthStr}}">▾</text>
              <view class="filter-col-clear" wx:if="{{selectedMonthStr}}" catchtap="onClearMonthFilter">✕</view>
            </view>
          </picker>
        </view>
      </view>
    </view>

    <!-- 🆕 状态筛选 Tab：全部/待审核/已通过/已驳回，与月份/门店筛选可叠加，
         纯客户端过滤（见 history.ts applyFilters）。放在固定头部内，
         measureActualHeaderHeight() 会自动把它的高度并入 totalHeaderHeight，
         滚动列表的 padding-top 自动跟着让位，不需要额外手算偏移 -->
    <view class="status-tab-row" wx:if="{{!photoArchiveMode}}">
      <view class="status-tab {{statusTab === 'all' ? 'active' : ''}}" data-tab="all" bindtap="onSwitchStatusTab">
        <text>全部</text>
        <text class="status-tab-badge" wx:if="{{statusTabCounts.all > 0}}">{{statusTabCounts.all > 99 ? '99+' : statusTabCounts.all}}</text>
      </view>
      <view class="status-tab {{statusTab === 'pending' ? 'active' : ''}}" data-tab="pending" bindtap="onSwitchStatusTab">
        <text>待审核</text>
        <text class="status-tab-badge warn" wx:if="{{statusTabCounts.pending > 0}}">{{statusTabCounts.pending > 99 ? '99+' : statusTabCounts.pending}}</text>
      </view>
      <view class="status-tab {{statusTab === 'approved' ? 'active' : ''}}" data-tab="approved" bindtap="onSwitchStatusTab">
        <text>已通过</text>
        <text class="status-tab-badge" wx:if="{{statusTabCounts.approved > 0}}">{{statusTabCounts.approved > 99 ? '99+' : statusTabCounts.approved}}</text>
      </view>
      <view class="status-tab {{statusTab === 'rejected' ? 'active' : ''}}" data-tab="rejected" bindtap="onSwitchStatusTab">
        <text>已驳回</text>
        <text class="status-tab-badge" wx:if="{{statusTabCounts.rejected > 0}}">{{statusTabCounts.rejected > 99 ? '99+' : statusTabCounts.rejected}}</text>
      </view>
      <!-- 🆕 单条滑动指示条：取代此前每个 Tab 各自的 ::after 下划线，随 statusTabIndex
           （0~3，四个 Tab 等宽 25%）用 left 百分比 + CSS transition 平滑移动，而不是
           在四个位置之间瞬时跳变 -->
      <view class="status-tab-indicator" style="left: {{statusTabIndex * 25}}%;"></view>
    </view>

    <!-- 🌟 从首页「风控预警日志」弹窗点击卡片跳转过来时的精准追溯筛选提示 -->
    <view class="anomaly-filter-banner" wx:if="{{anomalyFilterType}}">
      <text class="anomaly-filter-text">🔍 风控筛选：{{anomalyFilterLabel}}明细</text>
      <view class="anomaly-filter-clear" catchtap="onClearAnomalyFilter">清除 ✕</view>
    </view>

  </view>

  <scroll-view scroll-y class="history-scroll-list" style="padding-top: {{totalHeaderHeight}}px;">

    <!-- 🛡️ 超管预览模式提示 Banner：仅展示，不影响本页任何权限判断——本页操作始终按
         真实身份（超级管理员）执行，与个人中心/首页的"视角切换"展示层完全无关。
         🆕 个人视角入口（mineEntryMode）强制隐藏：这条 Banner 是管理向的角色预览
         提示，与"专注展示个人提交记录"的诉求无关，展示出来只会造成困惑 -->
    <view class="preview-mode-banner" wx:if="{{showPreviewBanner && !mineEntryMode}}">
      <text class="preview-mode-banner-icon">👁️</text>
      <text class="preview-mode-banner-text">{{previewBannerText}}</text>
    </view>

    <!-- 📸 图册模式：照片类型过滤 + 瀑布流网格，账本内容同时隐藏 -->
    <view class="photo-archive-container" wx:if="{{photoArchiveMode}}">

      <!-- 照片类型过滤标签栏：横向滚动 + 胶囊选中态，与 status-tab-row 共用
           #8C1D18 主题强调色，不再用与全站不一致的 #C2185B -->
      <scroll-view scroll-x class="photo-type-tabs-scroll" enhanced show-scrollbar="{{false}}">
        <view class="photo-type-tabs">
          <view
            wx:for="{{[{label:'全部照片',icon:'🖼️',value:'all'},{label:'报销凭证',icon:'🧾',value:'receipt'},{label:'每日食谱',icon:'🍱',value:'menu'},{label:'温情活动',icon:'📸',value:'log'}]}}"
            wx:key="value"
            class="photo-type-tab {{photoTypeFilter === item.value ? 'active' : ''}}"
            data-type="{{item.value}}"
            bindtap="onPhotoTypeTabChange"
          >
            <text class="photo-type-tab-icon">{{item.icon}}</text>
            <text class="photo-type-tab-label">{{item.label}}</text>
          </view>
        </view>
      </scroll-view>

      <!-- 统计 + 时间范围快捷切换 -->
      <view class="photo-archive-meta" wx:if="{{!photoArchiveLoading}}">
        <text class="photo-archive-count">共 <text class="photo-archive-count-num">{{photoArchiveTotal}}</text> 张照片</text>
        <view class="photo-archive-range-pill" bindtap="onTogglePhotoArchiveRangeMenu">
          <text class="photo-archive-range-txt">{{photoArchiveRangeLabels[photoArchiveRangeKey]}}</text>
          <text class="photo-archive-range-arrow">▾</text>
        </view>
      </view>
      <view class="photo-archive-loading" wx:if="{{photoArchiveLoading}}">
        <text>加载中...</text>
      </view>

      <!-- 瀑布流照片网格：点击预览大图，长按查看详情/关联记录 -->
      <view class="photo-waterfall-grid" wx:if="{{!photoArchiveLoading && photoArchiveList.length > 0}}">
        <view
          class="photo-grid-item"
          wx:for="{{photoArchiveList}}"
          wx:key="url"
          data-index="{{index}}"
          bindtap="onPreviewPhotoItem"
          bindlongpress="onLongPressPhotoItem"
        >
          <image
            class="photo-grid-img"
            src="{{item.url}}"
            mode="aspectFill"
            lazy-load="{{true}}"
          />
          <view class="photo-grid-tags">
            <text class="photo-tag-date">{{item.date}}</text>
            <text class="photo-tag-type {{item.type}}">
              {{item.type === 'receipt' ? '🧾 爱心采购' : item.type === 'menu' ? '🍱 温情就餐' : '📸 温情活动'}}
            </text>
          </view>
        </view>
      </view>

      <!-- 空状态：温情文案 + 与页面其余空态（.empty-icon 🍃）一致的图标语言，
           不再引用图册模式下从未真正被赋值过的 selectedMonthDisplay（那个
           picker 只在账本模式展示，此前这里的条件分支其实是死代码，见
           history.ts loadPhotoArchive 同一处修复注释） -->
      <view class="photo-archive-empty" wx:if="{{!photoArchiveLoading && photoArchiveList.length === 0}}">
        <text class="photo-archive-empty-icon">🍃</text>
        <text class="photo-archive-empty-tip">用镜头记录温暖，每一份付出皆有印记</text>
        <text class="photo-archive-empty-sub">{{photoArchiveRangeLabels[photoArchiveRangeKey]}}内暂无照片，可切换分类或时间范围试试</text>
      </view>

    </view>

    <!-- 🧾 今日凭证与记账：当日+历史一体化，置顶高亮展示当天已录入的支出与小票，对齐食谱/大事记模块交互
         全国总览/多店汇总视角下无具体单店可挂载今日凭证，整块隐藏，直接展示历史账本列表，提升信息密度 -->
    <view class="today-ledger-section" wx:if="{{!isAllStoresView && !photoArchiveMode}}">
      <view class="section-divider-label">
        <text class="divider-icon">🔴</text>
        <text class="divider-txt">今日凭证与记账</text>
        <text class="divider-date">{{todayDateStr}}</text>
      </view>

      <view class="today-ledger-card" wx:if="{{todayLedger}}">
        <view class="today-card-top">
          <view class="today-expense-block">
            <text class="today-expense-lbl">今日支出</text>
            <text class="today-expense-val">¥{{todayLedger.expenseAmountStr}}</text>
          </view>
          <view class="today-status-pill {{todayLedger.approvalStatus === 'AUDITED_LOCKED' ? 'locked' : (todayLedger.approvalStatus === 'APPROVED' ? 'approved' : 'pending')}}">
            {{todayLedger.approvalStatus === 'AUDITED_LOCKED' ? '🛡️ 已锁定' : (todayLedger.approvalStatus === 'APPROVED' ? '✅ 店长已确认' : '⏳ 待确认')}}
          </view>
        </view>

        <view class="today-expense-detail-row" wx:if="{{todayLedger.diningCount > 0 || todayLedger.volunteerCount > 0}}">
          <text class="metric-tag info" wx:if="{{todayLedger.diningCount > 0}}">👥 结缘 {{todayLedger.diningCount}}人</text>
          <text class="metric-tag info" wx:if="{{todayLedger.volunteerCount > 0}}">❤️ 义工 {{todayLedger.volunteerCount}}人</text>
        </view>

        <view class="today-receipt-9grid" wx:if="{{(todayLedger.receiptImages && todayLedger.receiptImages.length > 0) || (todayLedger.receiptImageList && todayLedger.receiptImageList.length > 0)}}">
          <view class="grid9-item" wx:for="{{todayLedger.receiptImages.length > 0 ? todayLedger.receiptImages : todayLedger.receiptImageList}}" wx:key="*this" bindtap="onPreviewFullReceiptFromDetail" data-url="{{item}}">
            <image class="grid9-img" src="{{item}}" mode="aspectFill" lazy-load="{{true}}" />
          </view>
        </view>
        <view class="today-receipt-empty" wx:else>
          <text class="empty-tip">📷 今日暂无小票凭证</text>
        </view>
        <!-- 🆕 拍照识别 OCR / 快捷补传凭证入口已收编为全局悬浮按钮（见页面末尾
             .fab-upload-receipt），不再以强色大按钮的形式挤占卡片内容区 -->
      </view>

      <!-- 🆕 "今日未录入餐报"改为标准内嵌 NoticeBar：整行可点击跳转录入，
           右侧带一键关闭 ✕（非阻断式收起，onDismissTodayReminder，纯会话内
           展示态，见 history.ts 注释）。todayReminderDismissed 为 true 时
           连同下方暂存凭证预览一并收起，不占任何空间 -->
      <block wx:elif="{{!todayReminderDismissed}}">
        <view class="today-ledger-empty" bindtap="goToHome">
          <text class="alert-icon">💡</text>
          <text class="empty-tip">今日尚未录入餐报</text>
          <!-- 🐛 右侧操作区拆分："去录入"（冒泡到外层跳转）与"×"关闭（catchtap
               拦截冒泡，避免点关闭误触发跳转）此前紧挨着，热区容易连带误触，
               现用独立 flex 行 + 20rpx 间距彻底分开 -->
          <view class="notice-right-actions">
            <text class="btn-go-fill-today-mini">去录入 ›</text>
            <text class="dismiss-btn" catchtap="onDismissTodayReminder">×</text>
          </view>
        </view>

        <view class="staged-receipt-block" wx:if="{{stagedReceiptImages.length > 0}}">
          <view class="receipt-9grid">
            <view class="grid9-item" wx:for="{{stagedReceiptImages}}" wx:key="*this" catchtap="onPreviewStagedReceipt" data-url="{{item}}">
              <image class="grid9-img" src="{{item}}" mode="aspectFill" lazy-load="{{true}}" />
            </view>
          </view>
          <text class="staged-tip">📥 已暂存 {{stagedReceiptImages.length}} 张，提交今日餐报时自动带入</text>
        </view>
      </block>
    </view>

    <view class="section-divider-label history-ledger-divider" wx:if="{{!photoArchiveMode && !loading && filteredReports.length > 0}}">
      <text class="divider-icon">📚</text>
      <text class="divider-txt">历史账本与凭证</text>
    </view>

    <view class="history-list-box" wx:if="{{!photoArchiveMode && !loading && filteredReports.length > 0}}">
      <view wx:for="{{filteredReports}}" wx:key="rowKey" class="history-card {{item.isLocked ? 'locked-card state-locked' : ''}} {{item.isVoid ? 'state-voided' : ''}} {{item.approvalStatus === 'AUDITED_LOCKED' ? 'state-locked' : ''}}" hover-class="item-hover" hover-stay-time="80" data-index="{{index}}" wx:if="{{item.dateString}}">

        <!-- 🌟 作废印章 -->
        <view class="void-seal-box" wx:if="{{item.isVoid}}">
          <text class="seal-txt">已作废\n红字冲销</text>
        </view>

        <!-- 卡片顶部：日期 + 门店 + 单行状态 Flow Tag。点击跳转"🔍 凭证稽核"详情
             （本项目没有独立的记录详情页，稽核详情弹窗是最接近的既有"查看明细"
             入口，与卡片底部"🔍 查看明细"复用同一个 onOpenReceiptDetail，不新增
             一套流程）；bindtap 而非 catchtap——这个区域内没有更深的可点击子元素，
             不需要拦截冒泡 -->
        <view class="card-top-header" bindtap="onOpenReceiptDetail" data-index="{{index}}">
          <view class="date-box">
            <view class="date-title-row">
              <text class="report-date {{item.isVoid ? 'strikethrough' : ''}}">{{item.dateString}}</text>
              <text class="error-badge error-badge-tappable" wx:if="{{item.isAmountMismatch && !item.isVoid}}" catchtap="onShowMismatchDiagnosis" data-index="{{index}}">⚠️ 资金不平 ℹ️</text>
            </view>
            <text class="store-tag">{{item.shopName || '未命名'}}</text>
          </view>

          <!-- 单行圆角状态 Tag：同一时刻只展示当前所处的那一个阶段，取代此前堆叠的两枚徽章 -->
          <view class="status-flow-tag {{item.approvalStatus === 'AUDITED_LOCKED' ? 'st-locked' : (item.approvalStatus === 'APPROVED' ? 'st-finance' : 'st-manager')}}" wx:if="{{!item.isVoid}}">
            {{item.approvalStatus === 'AUDITED_LOCKED' ? '🛡️ 已锁定' : (item.approvalStatus === 'APPROVED' ? '🔒 待财务稽核' : '⏳ 待店长确认')}}
          </view>
        </view>

        <!-- 🆕 经办人信息：仅在确有值时展示，隐私脱敏模式开启时按 privacyMaskEnabled
             切换到 approvedByMasked/auditedByMasked（预先算好，见 history.ts loadReports） -->
        <view class="handler-info-row" wx:if="{{!item.isVoid && (item.approvedBy || item.auditedBy)}}">
          <text class="handler-info-text" wx:if="{{item.approvedBy}}">👤 店长确认：{{privacyMaskEnabled ? item.approvedByMasked : item.approvedBy}}</text>
          <text class="handler-info-text" wx:if="{{item.auditedBy}}">👤 财务稽核：{{privacyMaskEnabled ? item.auditedByMasked : item.auditedBy}}</text>
        </view>

        <!-- 💰 资产看板：结余与净变动为核心高亮指标，昨日/今日收支明细并列紧凑排布在下方。
             隐私脱敏模式开启且未临时显示时（amountsMasked），金额直接换成掩码占位文本
             "¥ ***.**"，而不是对真实数字加 CSS 模糊——低端机型上大量 filter:blur 元素会
             拖慢渲染，且模糊态下真实数字仍在 DOM 里，长按仍可选中复制泄露；掩码文本两个
             问题都不存在。配合右上角"一键眼睛"（onToggleSensitiveReveal）临时显示 -->
        <view class="asset-board {{item.isVoid ? 'strikethrough' : ''}}" bindtap="onOpenReceiptDetail" data-index="{{index}}">
          <view class="asset-board-highlight-row">
            <view class="asset-highlight-cell">
              <text class="asset-highlight-lbl">今日结余</text>
              <text class="asset-highlight-val">{{amountsMasked ? '¥ ***.**' : ('¥' + item.todayBalanceStr)}}</text>
            </view>
            <view class="asset-divider"></view>
            <view class="asset-highlight-cell">
              <text class="asset-highlight-lbl">净变动</text>
              <text class="asset-highlight-val {{item.netChange >= 0 ? 'up' : 'down'}}">{{amountsMasked ? '¥ ***.**' : ((item.netChange >= 0 ? '+' : '') + '¥' + item.netChangeStr)}}</text>
            </view>
          </view>
          <view class="asset-board-detail-row">
            <view class="asset-detail-cell">
              <text class="asset-detail-lbl">昨日余额</text>
              <text class="asset-detail-val">{{amountsMasked ? '¥ ***.**' : ('¥' + item.yesterdayBalanceStr)}}</text>
            </view>
            <view class="asset-detail-cell">
              <text class="asset-detail-lbl">服务收入</text>
              <text class="asset-detail-val up">{{amountsMasked ? '¥ ***.**' : ('+¥' + item.totalIncomeStr)}}</text>
            </view>
            <view class="asset-detail-cell">
              <text class="asset-detail-lbl">今日支出</text>
              <text class="asset-detail-val down">{{amountsMasked ? '¥ ***.**' : ('-¥' + item.expenseAmountStr)}}</text>
            </view>
          </view>
        </view>

        <!-- 🍱 用餐/义工双区紧凑布局：记录本身带细分统计（新记录，或老记录被编辑弹窗补录过）才展示；
             老记录没有细分数据时，沿用此前的"结缘/义工"两枚汇总标签 -->
        <view class="card-header-tags" wx:if="{{!item.hasDiningBreakdown}}">
          <text class="metric-tag info" wx:if="{{item.diningCount > 0}}">👥 结缘 {{item.diningCount}}人</text>
          <text class="metric-tag info" wx:if="{{item.volunteerCount > 0}}">❤️ 义工 {{item.volunteerCount}}人</text>
        </view>

        <view class="dual-zone-board" wx:if="{{item.hasDiningBreakdown}}">
          <view class="zone-col zone-dining">
            <view class="zone-col-header">
              <text class="zone-col-icon">🍽️</text>
              <text class="zone-col-title">用餐</text>
              <text class="zone-col-total">{{item.totalDineCount}}<text class="zone-col-total-unit">人</text></text>
            </view>
            <view class="zone-row">
              <text class="zone-row-lbl">堂食长者</text>
              <text class="zone-row-val">{{item.dineInSeniors}}</text>
            </view>
            <view class="zone-row">
              <text class="zone-row-lbl">送餐长者</text>
              <text class="zone-row-val">{{item.deliverySeniors}}</text>
            </view>
            <view class="zone-row">
              <text class="zone-row-lbl">打包份数</text>
              <text class="zone-row-val">{{item.takeawayCount}}</text>
            </view>
          </view>
          <view class="zone-col zone-volunteer">
            <view class="zone-col-header">
              <text class="zone-col-icon">❤️</text>
              <text class="zone-col-title">志愿</text>
              <text class="zone-col-total">{{item.totalVolunteers}}<text class="zone-col-total-unit">人次</text></text>
            </view>
            <view class="zone-row">
              <text class="zone-row-lbl">用餐志愿者</text>
              <text class="zone-row-val">{{item.dineInVolunteers}}</text>
            </view>
            <view class="zone-row">
              <text class="zone-row-lbl">送餐志愿者</text>
              <text class="zone-row-val">{{item.deliveryVolunteers}}</text>
            </view>
          </view>
        </view>

        <!-- 🌟 历史卡片小票凭证直观预览：60x60 缩略图，点击直接 wx.previewImage 放大；
             财务对单/补传凭证等稽核操作收进右上角单独的"🔍 稽核"入口，避免和快速预览混淆 -->
        <view class="card-receipt-section" wx:if="{{(item.receiptImages && item.receiptImages.length > 0) || (item.receiptImageList && item.receiptImageList.length > 0)}}">
          <view class="receipt-title-row">
            <text class="r-icon">🧾</text>
            <text class="r-title">支出凭证 / 记账小票</text>
            <text class="r-count">({{item.receiptImages.length > 0 ? item.receiptImages.length : item.receiptImageList.length}}张)</text>
            <text class="r-lock-badge {{item.isLocked || item.approvalStatus === 'AUDITED_LOCKED' ? 'locked' : ''}}">
              {{item.isLocked || item.approvalStatus === 'AUDITED_LOCKED' ? '🛡️ 已锁定' : '🔓 未锁定'}}
            </text>
            <text class="r-reconcile-badge {{item.financeReconciled ? 'done' : ''}}" wx:if="{{item.financeReconciled}}">✅ 已对单</text>
            <text class="r-audit-link" catchtap="onOpenReceiptDetail" data-index="{{index}}">🔍 稽核</text>
          </view>

          <view class="receipt-thumb-row">
            <view class="thumb60-item {{item.isVoid ? 'grey-img' : ''}}"
                  wx:for="{{item.receiptImages.length > 0 ? item.receiptImages : item.receiptImageList}}"
                  wx:for-item="imgUrl"
                  wx:for-index="imgIdx"
                  wx:key="*this"
                  catchtap="onPreviewReceiptThumb"
                  data-index="{{index}}"
                  data-current="{{imgUrl}}">
              <image class="thumb60-img" src="{{imgUrl}}" mode="aspectFill" lazy-load="{{true}}" />
            </view>
          </view>
        </view>
        <!-- 🆕 缺省凭证交互化：从纯文字提示改为可点击的轻量卡片按钮，直接拉起
             稽核详情弹窗（内含"📤 补传凭证"入口），已作废记录不再邀请上传，
             仍保留静态提示 -->
        <view class="card-receipt-empty card-receipt-empty-btn" wx:elif="{{!item.isVoid}}" bindtap="onOpenReceiptDetail" data-index="{{index}}">
          <text class="empty-camera-icon">📷</text>
          <text class="empty-tip">补传凭证</text>
        </view>
        <view class="card-receipt-empty" wx:else>
          <text class="empty-tip">📷 暂无上传小票凭证</text>
        </view>

        <!-- 🌟 按审核状态区分主次操作：待确认/待稽核 → 确认为主；已锁定 → 分享为主；已作废 → 无按钮，仅提示条
             🛡️ 防穿透：本区域内的审核确认/编辑/作废按钮统一用 catchtap（而非 bindtap）拦截冒泡——
             card-top-header/asset-board 上绑定了 onOpenReceiptDetail（见上文），若这几个按钮的点击
             冒泡上去，会在关闭/处理这些操作的同时意外弹出稽核详情弹窗 -->
        <view class="card-action-footer">

          <!-- 状态：已作废/冲销 —— 不展示任何操作按钮，仅一条静态提示 -->
          <view class="void-footer-notice" wx:if="{{item.isVoid}}">
            <text>🚫 记录已红字冲销作废</text>
          </view>

          <!-- 状态：已确认/已锁定 —— 分享为主按钮，下方极简"查看明细"；财务/超管可解封 -->
          <block wx:elif="{{item.approvalStatus === 'AUDITED_LOCKED'}}">
            <view class="primary-workflow-row">
              <button class="btn-workflow-main btn-workflow-share" open-type="share" catchtap="onShareReportToWeChat" data-id="{{item._id || item._localId}}" data-date="{{item.dateString}}">
                💬 分享/导出凭证
              </button>
            </view>
            <view class="minimal-link-row" wx:if="{{isFinanceRole || isSuperAdmin}}">
              <text class="btn-minimal-link" catchtap="onUnlockRecord" data-id="{{item._id}}">🔓 解封（修改需先解封）</text>
            </view>
            <view class="minimal-link-row" wx:if="{{(item.receiptImages && item.receiptImages.length > 0) || (item.receiptImageList && item.receiptImageList.length > 0)}}">
              <text class="btn-minimal-link" catchtap="onOpenReceiptDetail" data-index="{{index}}">🔍 查看明细</text>
            </view>
          </block>

          <!-- 状态：待确认（店长）/ 待稽核（财务） —— 确认审核为主按钮，编辑/作废并排为次，隐藏分享 -->
          <block wx:else>
            <view class="primary-workflow-row" wx:if="{{item.approvalStatus === 'PENDING_APPROVAL' && (isManagerRole || isSuperAdmin)}}">
              <button class="btn-workflow-main btn-workflow-audit-cta" catchtap="onManagerAuditClick" data-id="{{item._id}}">
                ⚖️ 确认审核（店长）
              </button>
            </view>
            <view class="primary-workflow-row" wx:elif="{{item.approvalStatus === 'APPROVED' && (isFinanceRole || isSuperAdmin)}}">
              <button class="btn-workflow-main btn-workflow-audit-cta" catchtap="onFinanceAuditClick" data-id="{{item._id}}">
                ⚖️ 确认审核（财务）
              </button>
            </view>

            <!-- 🛡️ 六大角色对齐：编辑按钮不再只对店长/超管开放——只要这条记录是提交人
                 本人提交、且还没进入 APPROVED/AUDITED_LOCKED（item.isOwnPendingRecord，
                 见 loadReports() 里的预计算），提交人也能看到编辑入口修正自己的草稿。
                 红字作废仍严格保持仅店长/超管可见，不随这次放宽扩大 -->
            <view class="utility-actions-row" wx:if="{{isManagerRole || isSuperAdmin || item.isOwnPendingRecord}}">
              <button class="btn-utility btn-util-edit" catchtap="onEditReport" data-index="{{index}}">
                ✏️ 编辑
              </button>
              <block wx:if="{{isManagerRole || isSuperAdmin}}">
                <button class="btn-utility btn-util-void" wx:if="{{!item.voidPending}}" catchtap="onVoidReportModal" data-id="{{item._id || item._localId}}" data-date="{{item.dateString}}">
                  🚨 红字作废
                </button>
                <text class="btn-utility btn-util-void-pending" wx:else>⏳ 待家长确认作废中</text>
              </block>
            </view>
          </block>

        </view>

      </view>
    </view>

    <!-- 🆕 网络异常占位卡片：与下面的"空状态"互斥——loadError 只在"云端确有
         错误 且 最终没有任何数据可展示"时才为 true（见 history.ts loadReports），
         优先于普通空状态展示，避免把"网络问题"误当成"真的没有记录" -->
    <view class="history-error-box" wx:if="{{!photoArchiveMode && !loading && loadError}}">
      <text class="empty-icon">📡</text>
      <text class="empty-text">网络异常，加载失败</text>
      <text class="empty-subtitle">请检查网络后重试</text>
      <view class="error-retry-btn" bindtap="onRetryLoadReports">🔄 重新加载</view>
    </view>

    <!-- 🆕 空状态智能分场景：筛选条件（月份/状态 Tab/风控追溯）导致 0 条结果时，
         提示"该分类/月份下暂无记录" + "重置筛选"文字链接；账号/门店本身确实没有
         任何记录时，提示"暂无相关记录"，引导使用右下角 FAB（不在这里重复放一个
         强色大按钮——FAB 已经是唯一的"立即记账/上传凭证"入口，两处入口会显得
         冗余，全国总览等 FAB 本就隐藏的场景也不提这句引导，避免文案对不上界面） -->
    <view class="history-empty-box" wx:if="{{!photoArchiveMode && !loading && !loadError && filteredReports.length === 0}}">
      <text class="empty-icon">🍃</text>
      <block wx:if="{{hasActiveFilters}}">
        <text class="empty-text">该分类/月份下暂无记录</text>
        <view class="empty-reset-link" hover-class="empty-reset-link-hover" bindtap="onResetFilters">🔄 重置筛选</view>
      </block>
      <block wx:else>
        <text class="empty-text">暂无相关记录</text>
        <text class="empty-subtitle" wx:if="{{!isAllStoresView}}">可点击右下角按钮上传新凭证</text>
      </block>
    </view>

    <!-- 🆕 骨架屏：切换门店/查看视角触发 loadReports() 全量重载期间，用卡片形状
         的占位骨架替代此前的纯文字"加载中..."——切筛选条件时列表会先被 wx:if
         整块卸载再重新挂载，纯文字提示会让人感觉"白屏一下"，骨架屏承接住这段
         过渡，观感上是"内容还在加载"而不是"页面空了" -->
    <view class="skeleton-list" wx:if="{{loading && !photoArchiveMode}}">
      <view class="skeleton-card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
        <view class="skeleton-row skeleton-row-top">
          <view class="skeleton-block skeleton-block-date"></view>
          <view class="skeleton-block skeleton-block-tag"></view>
        </view>
        <view class="skeleton-block skeleton-block-wide"></view>
        <view class="skeleton-row">
          <view class="skeleton-block skeleton-block-cell"></view>
          <view class="skeleton-block skeleton-block-cell"></view>
          <view class="skeleton-block skeleton-block-cell"></view>
        </view>
      </view>
    </view>

    <view class="compliance-disclaimer" wx:if="{{!photoArchiveMode && !loading && filteredReports.length > 0}}">
      <text class="compliance-disclaimer-text">本平台仅用于爱心餐报与志愿服务记录，不直接面向公众发起公开募捐；如涉及个人信息，已在前端做脱敏展示处理。</text>
    </view>
    <view class="fa-safe-area-spacer"></view>
  </scroll-view>

  <!-- 🆕 快捷上传凭证 FAB：从今日卡片内嵌的强色大按钮改为悬浮按钮，任何滚动
       位置都能快速唤起拍照 OCR，不再挤占卡片/列表内容区的视觉焦点。与
       .fixed-top-header 同样作为 scroll-view 的兄弟节点脱离滚动内容，可见范围
       与原按钮所在的 today-ledger-section 一致（需要具体单店上下文，全国总览/
       图册模式下隐藏） -->
  <view class="fab-upload-receipt" wx:if="{{!isAllStoresView && !photoArchiveMode}}" hover-class="fab-upload-receipt-hover" bindtap="onTodayOcrScan">
    <text class="fab-upload-icon">📷</text>
  </view>

  <view class="modal-backdrop" wx:if="{{showEditModal}}" bindtap="onCancelEdit">
    <view class="modal-card edit-report-card" catchtap="stopPropagation">
      
      <view class="modal-header-bar">
        <view class="title-left">
          <text class="pendant-dot">●</text>
          <text class="modal-title-text">编辑餐报记录</text>
        </view>
        <view class="modal-close-btn" bindtap="onCancelEdit">✕</view>
      </view>

      <scroll-view scroll-y class="edit-scroll-body">
        
        <view class="info-readonly-card">
          <view class="readonly-item">
            <text class="label">日期</text>
            <text class="value highlight-date">{{editingRecord.dateString || editingRecord.reportDate}}</text>
          </view>
          <view class="readonly-item">
            <text class="label">门店</text>
            <text class="value">{{editingRecord.shopName || '未命名'}}</text>
          </view>
        </view>

        <view class="form-group-section">
          <view class="section-badge">❤️ 爱心支持明细</view>
          <view class="form-field-row-vertical">
            <textarea class="form-textarea donations-textarea"
                      placeholder="{{donationsPlaceholder}}"
                      value="{{editingRecord.donationsText}}"
                      bindinput="onEditDonationsInput"
                      auto-height
                      maxlength="-1" />
            <view class="donations-total-tip">已解析合计：<text class="donations-total-val">¥{{editingRecord.donationsTotalStr || '0.00'}}</text></view>
          </view>
        </view>

        <view class="form-group-section">
          <view class="section-badge">💰 资金账目明细</view>

          <view class="form-field-row">
            <text class="field-label">昨日余额</text>
            <view class="input-wrapper locked-bg">
              <text class="currency-unit">¥</text>
              <input class="field-input text-grey" value="{{editingRecord.yesterdayBalance}}" disabled />
              <text class="lock-icon">🔒</text>
            </view>
          </view>

          <view class="form-field-row">
            <text class="field-label">现场赞助/其他支持</text>
            <view class="input-wrapper">
              <text class="currency-unit">¥</text>
              <input class="field-input font-bold"
                     type="digit"
                     placeholder="请输入现场赞助/其他支持金额"
                     value="{{editingRecord.otherDonation}}"
                     bindinput="onEditInput"
                     data-field="otherDonation" />
            </view>
          </view>

          <view class="form-field-row">
            <text class="field-label">今日支出</text>
            <view class="input-wrapper">
              <text class="currency-unit">¥</text>
              <input class="field-input font-bold text-red"
                     type="digit"
                     placeholder="请输入今日支出金额"
                     value="{{editingRecord.expenseAmount}}"
                     bindinput="onEditInput"
                     data-field="expenseAmount" />
            </view>
          </view>

          <view class="form-field-row balance-row">
            <text class="field-label gold-label">今日结余</text>
            <text class="balance-value">¥ {{editingRecord.calculatedTodayBalance || 0}}</text>
          </view>
        </view>

        <view class="form-group-section">
          <view class="section-badge">👥 护持数据统计 <text class="optional-tag">(选填，用餐总数/志愿者总人次自动计算)</text></view>

          <view class="double-column-row">
            <view class="column-item">
              <text class="col-label">堂食长者 (人)</text>
              <input class="col-input" type="number" placeholder="0" value="{{editingRecord.dineInSeniors}}" bindinput="onEditInput" data-field="dineInSeniors" />
            </view>
            <view class="column-item">
              <text class="col-label">送餐长者 (人)</text>
              <input class="col-input" type="number" placeholder="0" value="{{editingRecord.deliverySeniors}}" bindinput="onEditInput" data-field="deliverySeniors" />
            </view>
          </view>
          <view class="double-column-row">
            <view class="column-item">
              <text class="col-label">打包份数 (份)</text>
              <input class="col-input" type="number" placeholder="0" value="{{editingRecord.takeawayCount}}" bindinput="onEditInput" data-field="takeawayCount" />
            </view>
            <view class="column-item">
              <text class="col-label">堂食/到岗志愿者 (人)</text>
              <input class="col-input" type="number" placeholder="0" value="{{editingRecord.dineInVolunteers}}" bindinput="onEditInput" data-field="dineInVolunteers" />
            </view>
          </view>
          <view class="double-column-row">
            <view class="column-item">
              <text class="col-label">送餐志愿者 (人)</text>
              <input class="col-input" type="number" placeholder="0" value="{{editingRecord.deliveryVolunteers}}" bindinput="onEditInput" data-field="deliveryVolunteers" />
            </view>
          </view>

          <view class="edit-auto-total-row">
            <view class="edit-auto-total-item">
              <text class="lbl">用餐总数</text>
              <text class="val">{{editingRecord.totalDineCount || editingRecord.diningPeople || 0}} 人</text>
            </view>
            <view class="edit-auto-total-item">
              <text class="lbl">志愿者总人次</text>
              <text class="val">{{editingRecord.totalVolunteers || editingRecord.volunteers || 0}} 人次</text>
            </view>
          </view>
        </view>

        <view class="form-group-section">
          <view class="section-badge">📦 物资赞助明细 <text class="optional-tag">(选填)</text></view>
          <view class="form-field-row-vertical">
            <textarea class="form-textarea"
                      placeholder="示例：张三: 大米50斤；李四: 食用油2箱"
                      value="{{editingRecord.materialsInput}}"
                      bindinput="onEditMaterialsInput"
                      auto-height
                      maxlength="-1" />
          </view>
        </view>

        <view class="form-group-section">
          <view class="section-badge">🍚 主食物资储备状态 <text class="optional-tag">(选填)</text></view>

          <view class="edit-inventory-row">
            <text class="edit-inventory-name">大米/面粉</text>
            <view class="edit-status-pill-group">
              <view class="edit-status-pill green {{editingRecord.stapleRiceStatus === 'sufficient' ? 'active' : ''}}" bindtap="onEditStapleStatusChange" data-type="rice" data-value="sufficient">充足</view>
              <view class="edit-status-pill yellow {{editingRecord.stapleRiceStatus === 'normal' ? 'active' : ''}}" bindtap="onEditStapleStatusChange" data-type="rice" data-value="normal">一般</view>
              <view class="edit-status-pill red {{editingRecord.stapleRiceStatus === 'urgent' ? 'active' : ''}}" bindtap="onEditStapleStatusChange" data-type="rice" data-value="urgent">告急</view>
            </view>
          </view>

          <view class="edit-inventory-row">
            <text class="edit-inventory-name">食用油</text>
            <view class="edit-status-pill-group">
              <view class="edit-status-pill green {{editingRecord.stapleOilStatus === 'sufficient' ? 'active' : ''}}" bindtap="onEditStapleStatusChange" data-type="oil" data-value="sufficient">充足</view>
              <view class="edit-status-pill yellow {{editingRecord.stapleOilStatus === 'normal' ? 'active' : ''}}" bindtap="onEditStapleStatusChange" data-type="oil" data-value="normal">一般</view>
              <view class="edit-status-pill red {{editingRecord.stapleOilStatus === 'urgent' ? 'active' : ''}}" bindtap="onEditStapleStatusChange" data-type="oil" data-value="urgent">告急</view>
            </view>
          </view>
        </view>

        <view class="form-group-section">
          <view class="section-title-between">
            <text class="section-badge">📷 支出凭证管理</text>
            <text class="badge-counter">{{receiptImgCount}}/9 张</text>
          </view>

          <view class="receipt-grid">
            <view class="grid-img-wrap" wx:for="{{editingRecord.receiptImageList}}" wx:key="*this">
              <image class="grid-image" src="{{item}}" mode="aspectFill" bindtap="onPreviewEditImage" data-src="{{item}}" />
              <view class="img-delete-dot" catchtap="onRemoveEditImage" data-index="{{index}}">✕</view>
            </view>
            <view class="grid-add-btn" bindtap="onChooseNewEditImage" wx:if="{{receiptImgCount < 9}}">
              <text class="plus-icon">+</text>
              <text class="add-txt">添加小票</text>
            </view>
          </view>

          <view class="form-field-row-vertical">
            <text class="field-label">修改说明 (必填，用于审计留痕)</text>
            <textarea class="form-textarea"
                      placeholder="例如：补录发票 / 修正用餐人数..."
                      value="{{editingRecord.modifyReason}}"
                      bindinput="onEditInput"
                      data-field="modifyReason"
                      maxlength="60" />
          </view>
        </view>

      </scroll-view>

      <view class="modal-footer-danger-row">
        <button class="btn-delete-record" bindtap="onDeleteEditRecord">🗑️ 删除该条记录</button>
      </view>

      <view class="modal-footer-box">
        <button class="btn-cancel" bindtap="onCancelEdit">取消</button>
        <button class="btn-save-recalc" bindtap="onConfirmEditHistory">确认保存并重算</button>
      </view>

    </view>
  </view>

  <!-- 🔍 历史小票稽核详情弹窗：放大原图 / 财务对单 / 补传凭证 -->
  <view class="modal-backdrop" wx:if="{{showReceiptDetailModal}}" bindtap="onCloseReceiptDetail">
    <view class="modal-card receipt-detail-card" catchtap="stopPropagation">

      <view class="modal-header-bar">
        <view class="title-left">
          <text class="pendant-dot">●</text>
          <text class="modal-title-text">{{receiptDetailItem.dateString}} 凭证稽核</text>
        </view>
        <view class="modal-close-btn" bindtap="onCloseReceiptDetail">✕</view>
      </view>

      <view class="receipt-detail-info-row">
        <text class="store-tag">{{receiptDetailItem.shopName || '未命名'}}</text>
        <text class="detail-expense-val">支出 ¥{{receiptDetailItem.expenseAmountStr}}</text>
        <text class="r-lock-badge {{receiptDetailItem.isLocked || receiptDetailItem.approvalStatus === 'AUDITED_LOCKED' ? 'locked' : ''}}">
          {{receiptDetailItem.isLocked || receiptDetailItem.approvalStatus === 'AUDITED_LOCKED' ? '🛡️ 已锁定' : '🔓 未锁定'}}
        </text>
      </view>

      <scroll-view scroll-y class="receipt-detail-scroll">
        <view class="receipt-9grid detail-9grid">
          <view class="grid9-item" wx:for="{{receiptDetailImages}}" wx:key="*this" bindtap="onPreviewFullReceiptFromDetail" data-url="{{item}}">
            <image class="grid9-img" src="{{item}}" mode="aspectFill" />
          </view>
        </view>
        <text class="detail-tip">点击图片可放大查看高清原图</text>
      </scroll-view>

      <view class="receipt-detail-actions">
        <button class="btn-detail-action btn-reconcile {{receiptDetailItem.financeReconciled ? 'done' : ''}}"
                wx:if="{{isFinanceRole || isSuperAdmin}}"
                bindtap="onToggleFinanceReconcile">
          {{receiptDetailItem.financeReconciled ? '✅ 已对单（点击取消）' : '☐ 标记已对单'}}
        </button>
        <button class="btn-detail-action btn-supplement" bindtap="onSupplementReceiptFromDetail">
          📤 补传凭证
        </button>
      </view>

    </view>
  </view>

  <!-- 🆕 图册长按详情弹窗：拍摄/上报日期 + 分类 + 所属门店，报销凭证类型
       额外提供"查看当月账本"跳转 -->
  <view class="modal-backdrop" wx:if="{{showPhotoDetailModal}}" bindtap="onClosePhotoDetailModal">
    <view class="modal-card photo-detail-card" catchtap="stopPropagation">

      <view class="modal-header-bar">
        <view class="title-left">
          <text class="pendant-dot">●</text>
          <text class="modal-title-text">照片详情</text>
        </view>
        <view class="modal-close-btn" bindtap="onClosePhotoDetailModal">✕</view>
      </view>

      <view class="photo-detail-thumb-wrap" bindtap="onPreviewPhotoDetailImage">
        <image class="photo-detail-thumb" src="{{photoDetailItem.url}}" mode="aspectFill" />
        <view class="photo-detail-thumb-hint">🔍 点击查看大图</view>
      </view>

      <view class="photo-detail-info-row">
        <text class="photo-detail-info-lbl">日期</text>
        <text class="photo-detail-info-val">{{photoDetailItem.date}}</text>
      </view>
      <view class="photo-detail-info-row">
        <text class="photo-detail-info-lbl">分类</text>
        <text class="photo-detail-info-val">{{photoDetailItem.typeLabel}}</text>
      </view>
      <view class="photo-detail-info-row">
        <text class="photo-detail-info-lbl">门店</text>
        <text class="photo-detail-info-val">{{photoDetailItem.storeName || '未命名'}}</text>
      </view>

      <view class="modal-footer-box">
        <button class="btn-cancel" bindtap="onClosePhotoDetailModal">关闭</button>
        <button class="btn-save-recalc" wx:if="{{photoDetailItem.type === 'receipt'}}" bindtap="onGoToLedgerFromPhotoDetail">📖 查看当月账本</button>
      </view>

    </view>
  </view>

  <!-- 🌟「先核对、再确认、后导出」导出预览核对弹窗：onExportMonthlyAudit 只发起
       previewOnly 查询，真正生成 xlsx 必须等用户在这里点击「确认并导出」 -->
  <view class="audit-modal-mask" wx:if="{{showExportPreviewModal}}" bindtap="onCloseExportPreviewModal">
    <view class="audit-modal-box" catchtap="stopPropagation">
      <view class="audit-modal-header">
        <text class="audit-modal-title">🧾 凭证与账本核对 · {{exportPreviewSummary.periodLabel}}</text>
        <text class="audit-modal-close" bindtap="onCloseExportPreviewModal">✕</text>
      </view>

      <view class="export-preview-summary-grid">
        <view class="export-preview-summary-cell">
          <text class="export-preview-summary-num income">¥{{exportPreviewSummary.totalIncome}}</text>
          <text class="export-preview-summary-lbl">总收入</text>
        </view>
        <view class="export-preview-summary-cell">
          <text class="export-preview-summary-num expense">¥{{exportPreviewSummary.totalExpense}}</text>
          <text class="export-preview-summary-lbl">总支出</text>
        </view>
        <view class="export-preview-summary-cell">
          <text class="export-preview-summary-num">¥{{exportPreviewSummary.netTotal}}</text>
          <text class="export-preview-summary-lbl">净结余</text>
        </view>
        <view class="export-preview-summary-cell">
          <text class="export-preview-summary-num">{{exportPreviewSummary.recordCount}}</text>
          <text class="export-preview-summary-lbl">总笔数</text>
        </view>
        <view class="export-preview-summary-cell">
          <text class="export-preview-summary-num audited">{{exportPreviewSummary.auditedReceiptCount}}</text>
          <text class="export-preview-summary-lbl">已审核小票数</text>
        </view>
        <view class="export-preview-summary-cell">
          <text class="export-preview-summary-num {{exportPreviewSummary.anomalyCount > 0 ? 'anomaly' : ''}}">{{exportPreviewSummary.anomalyCount}}</text>
          <text class="export-preview-summary-lbl">异常标记数</text>
        </view>
      </view>

      <scroll-view scroll-y class="audit-text-preview export-preview-list">
        <view class="export-preview-row" wx:for="{{exportPreviewRecords}}" wx:key="date" wx:for-item="rec">
          <text class="export-preview-row-date">{{rec.date}}</text>
          <text class="export-preview-row-shop">{{rec.shopName}}</text>
          <text class="export-preview-row-amounts">收¥{{rec.income}} 支¥{{rec.expense}}</text>
          <text class="export-preview-receipt-badge" wx:if="{{rec.hasReceipt}}">🧾{{rec.receiptCount}}</text>
          <text class="export-preview-receipt-badge is-missing" wx:else>⚠️无票</text>
        </view>
        <view class="empty-box" wx:if="{{exportPreviewRecords.length === 0}}">
          <text class="empty-tip">该周期内暂无明细数据</text>
        </view>
      </scroll-view>

      <view class="audit-modal-actions">
        <button class="audit-btn-copy" bindtap="onExportPreviewGoFix">发现异常，前去核对</button>
        <button class="audit-btn-download" bindtap="onExportPreviewConfirm">数据无误，确认并导出</button>
      </view>
    </view>
  </view>

  <!-- 🌟 月度财务审计表导出结果弹窗 -->
  <view class="audit-modal-mask" wx:if="{{showAuditExportModal}}" bindtap="onCloseAuditExportModal">
    <view class="audit-modal-box" catchtap="stopPropagation">
      <view class="audit-modal-header">
        <text class="audit-modal-title">{{auditExportPeriodLabel}} 财务审计表</text>
        <text class="audit-modal-close" bindtap="onCloseAuditExportModal">✕</text>
      </view>

      <scroll-view scroll-y class="audit-text-preview">
        <text class="audit-text-content">{{auditExportText}}</text>
      </scroll-view>

      <view class="audit-modal-actions">
        <button class="audit-btn-copy" bindtap="onCopyAuditText">复制审计文本</button>
        <button class="audit-btn-download" bindtap="onDownloadAuditExcel">保存/下载报表</button>
      </view>
    </view>
  </view>

  <!-- 🌟 校准操作二次确认：自定义弹窗，替代原生 wx.showModal——原生弹窗不支持
       任何样式定制，长文案 + editable 输入框组合在部分机型上会把正文压缩/裁切到
       难以阅读，只有页面自己渲染才能保证文字完整展示、按钮样式符合全站规范 -->
  <view class="modal-backdrop" wx:if="{{showRecalibrateConfirmModal}}" bindtap="onCloseRecalibrateConfirmModal">
    <view class="calib-modal-card" catchtap="stopPropagation">
      <text class="calib-modal-title">⚠️ 校准操作二次确认</text>
      <view class="calib-modal-body-wrap">
        <text class="calib-modal-body">{{recalibrateConfirmContent}}</text>
      </view>
      <input
        class="calib-modal-input"
        placeholder="请输入：确认校准"
        value="{{recalibrateConfirmInput}}"
        bindinput="onRecalibrateConfirmInput"
      />
      <view class="calib-modal-actions">
        <button class="calib-btn-cancel" hover-class="calib-btn-cancel-hover" bindtap="onCloseRecalibrateConfirmModal">取消</button>
        <button class="calib-btn-confirm" hover-class="calib-btn-confirm-hover" bindtap="onRecalibrateConfirmNext">下一步</button>
      </view>
    </view>
  </view>

  <!-- 🔐 专业版功能拦截弹窗：月度财务审计表导出为专业版专属，见 onExportMonthlyAudit -->
  <feature-locked-modal
    visible="{{showFeatureLockedModal}}"
    feature-name="月度财务审计表导出"
    can-self-upgrade="{{featureLockedCanSelfUpgrade}}"
    bind:close="onCloseFeatureLockedModal"
  />
</view>
