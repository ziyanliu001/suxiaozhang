<view class="page-container">
  <view class="custom-nav" style="padding-top: {{navTop}}px;">
    <view class="nav-left" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    <text class="nav-title">历史餐报记录</text>
    <view class="nav-right"></view>
  </view>

  <view class="admin-switch" wx:if="{{isAdmin}}">
    <view class="switch-label">查看模式</view>
    <view class="switch-btn {{viewMode === 'all' ? 'active' : ''}}" bindtap="switchViewMode" data-mode="all">全店汇总</view>
    <view class="switch-btn {{viewMode === 'personal' ? 'active' : ''}}" bindtap="switchViewMode" data-mode="personal">个人历史</view>
  </view>

  <scroll-view class="content-section" style="margin-top: {{isAdmin ? contentTop + 80 : contentTop}}px;" scroll-y>
    <view class="report-list" wx:if="{{!loading && reports.length > 0}}">
      <view wx:for="{{reports}}" wx:key="{{item._id || item._localId}}" class="report-card" data-index="{{index}}">
        <view class="card-header">
          <text class="card-date">{{item.dateString}}</text>
          <view class="card-header-right">
            <view class="delete-btn" bindtap="onDeleteRecord" data-id="{{item._id || item._localId}}" data-date="{{item.dateString}}">
              <text class="delete-icon">🗑️</text>
              <text class="delete-text">[删除]</text>
            </view>
            <text class="card-shop">{{item.shopName || '店铺'}}</text>
          </view>
        </view>

        <view class="card-divider"></view>

        <view class="card-body">
          <view class="stat-item">
            <text class="stat-label">昨日余额</text>
            <text class="stat-value">¥{{item.yesterdayBalanceStr}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">随喜收入</text>
            <text class="stat-value income">¥{{item.totalIncomeStr}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">今日支出</text>
            <text class="stat-value expense">¥{{item.expenseAmountStr}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">今日结余</text>
            <text class="stat-value balance">¥{{item.todayBalanceStr}}</text>
          </view>
        </view>

        <view class="card-receipts" wx:if="{{item.receiptImages && item.receiptImages.length > 0}}">
          <text class="receipts-label">📸 支出凭证</text>
          <view class="receipts-list">
            <image 
              wx:for="{{item.receiptImages}}" 
              wx:key="index" 
              class="receipt-thumb" 
              src="{{item}}" 
              mode="aspectFill"
              bindtap="previewReceipt"
              data-images="{{item.receiptImages}}"
              data-index="{{index}}"
            />
          </view>
        </view>

        <view class="card-footer">
          <button class="copy-btn" hover-class="btn-hover" bindtap="copyReport" data-index="{{index}}">
            <text class="copy-icon">📋</text>
            <text>复制此日报文本</text>
          </button>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{!loading && reports.length === 0}}">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无历史餐报记录</text>
      <text class="empty-hint">今天还没有提交过餐报，快去记录一笔吧</text>
      <button class="btn-go-home" hover-class="btn-hover" bindtap="goToHome">去录入今日餐报</button>
    </view>

    <view class="loading-state" wx:if="{{loading}}">
      <text class="loading-text">加载中...</text>
    </view>
  </scroll-view>
</view>