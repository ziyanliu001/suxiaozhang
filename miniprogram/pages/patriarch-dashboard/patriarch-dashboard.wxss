.pd-page {
  min-height: 100vh;
  background: #F8F5F0;
}

.pd-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  height: 88rpx;
  background: #8C1D18;
}

.pd-nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
}

.pd-nav-back-hover {
  opacity: 0.5;
}

.pd-nav-title {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
}

.pd-nav-placeholder {
  width: 64rpx;
}

.pd-scroll {
  height: calc(100vh - 88rpx);
  box-sizing: border-box;
  padding: 20rpx 24rpx 60rpx;
}

.pd-store-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.pd-store-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
  margin-bottom: 12rpx;
}

.pd-people-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.pd-people-item {
  font-size: 24rpx;
  color: #5C4326;
}

.pd-health-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.pd-health-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
  margin-bottom: 16rpx;
}

.pd-health-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.pd-health-cell {
  background: #F8F9FA;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.pd-health-lbl {
  font-size: 22rpx;
  color: #868E96;
}

.pd-health-val {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
}

.pd-health-val.green {
  color: #2B8A3E;
}

.pd-health-val.red {
  color: #E03131;
}

.pd-verify-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #F1F3F5;
}

.pd-verify-icon {
  font-size: 24rpx;
}

.pd-verify-text {
  font-size: 24rpx;
  color: #495057;
}

.pd-section-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 20rpx 0 12rpx;
}

.pd-section-icon {
  font-size: 24rpx;
}

.pd-section-txt {
  font-size: 26rpx;
  font-weight: bold;
  color: #D48806;
}

.pd-void-card,
.pd-profile-card {
  background: #FFFBE6;
  border: 1rpx solid #FFE58F;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.pd-void-info {
  margin-bottom: 16rpx;
}

.pd-void-date {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #212529;
  margin-bottom: 6rpx;
}

.pd-void-amount {
  font-size: 22rpx;
  color: #868E96;
}

.pd-profile-items {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 20rpx;
  margin-bottom: 16rpx;
}

.pd-profile-item {
  font-size: 24rpx;
  color: #5C4326;
}

.pd-void-actions {
  display: flex;
  gap: 16rpx;
}

.pd-btn-reject {
  flex: 1;
  background: #F1F3F5;
  color: #495057;
  border-radius: 12rpx;
  font-size: 26rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.pd-btn-approve {
  flex: 1;
  background: #D48806;
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: bold;
  height: 72rpx;
  line-height: 72rpx;
}

.pd-empty-tip {
  text-align: center;
  padding: 40rpx 0;
  color: #ADB5BD;
  font-size: 24rpx;
}

.pd-loading-box {
  text-align: center;
  padding: 40rpx 0;
  color: #ADB5BD;
  font-size: 24rpx;
}
