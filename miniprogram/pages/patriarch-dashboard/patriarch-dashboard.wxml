<view class="pd-page">
  <view class="pd-nav-bar" style="padding-top: {{navTop}}px;">
    <view class="pd-nav-back" hover-class="pd-nav-back-hover" bindtap="goBack">←</view>
    <text class="pd-nav-title">🏛️ 家长监督台</text>
    <view class="pd-nav-placeholder"></view>
  </view>

  <scroll-view scroll-y class="pd-scroll" style="margin-top: {{contentTop}}px;">

    <view class="pd-store-card">
      <text class="pd-store-name">{{storeName || '未命名门店'}}</text>
      <view class="pd-people-row">
        <text class="pd-people-item" wx:if="{{patriarch}}">🏛️ 护持家长：{{patriarch}}</text>
        <text class="pd-people-item" wx:if="{{manager}}">📋 日常店长：{{manager}}</text>
      </view>
    </view>

    <!-- 极简门店健康大盘：本月服务人次 + 收支总览 + 验真状态 -->
    <view class="pd-health-card">
      <view class="pd-health-title">📊 {{monthLabel}}门店健康大盘</view>
      <view class="pd-health-grid">
        <view class="pd-health-cell">
          <text class="pd-health-lbl">本月服务人次</text>
          <text class="pd-health-val">{{monthDiners}} 人次</text>
        </view>
        <view class="pd-health-cell">
          <text class="pd-health-lbl">本月收入</text>
          <text class="pd-health-val green">¥{{monthIncome}}</text>
        </view>
        <view class="pd-health-cell">
          <text class="pd-health-lbl">本月支出</text>
          <text class="pd-health-val red">¥{{monthExpense}}</text>
        </view>
        <view class="pd-health-cell">
          <text class="pd-health-lbl">本月净额</text>
          <text class="pd-health-val {{monthNetPositive ? 'green' : 'red'}}">{{monthNetPositive ? '+' : '-'}}¥{{monthNet}}</text>
        </view>
      </view>
      <view class="pd-verify-row">
        <text class="pd-verify-icon">🛡️</text>
        <text class="pd-verify-text">防伪验真：已验真 {{auditedCount}} / 共 {{totalCount}} 条</text>
      </view>
    </view>

    <!-- 待确认队列：作废申请 -->
    <view class="pd-section-title" wx:if="{{pendingVoidList.length > 0}}">
      <text class="pd-section-icon">⏳</text>
      <text class="pd-section-txt">待确认的作废申请（{{pendingVoidList.length}}）</text>
    </view>
    <view class="pd-void-card" wx:for="{{pendingVoidList}}" wx:key="docId">
      <view class="pd-void-info">
        <text class="pd-void-date">{{item.dateString}}</text>
        <text class="pd-void-amount">今日结余 ¥{{item.todayBalance}} · 支出 ¥{{item.expenseAmount}}</text>
      </view>
      <view class="pd-void-actions">
        <button class="pd-btn-reject" data-id="{{item.docId}}" data-action="reject" bindtap="onDecideVoid" disabled="{{voidActionInFlight}}">驳回</button>
        <button class="pd-btn-approve" data-id="{{item.docId}}" data-action="approve" bindtap="onDecideVoid" disabled="{{voidActionInFlight}}">确认作废</button>
      </view>
    </view>

    <!-- 待确认队列：门店画像变更 -->
    <view class="pd-section-title" wx:if="{{pendingProfileUpdate}}">
      <text class="pd-section-icon">⏳</text>
      <text class="pd-section-txt">待确认的门店画像变更</text>
    </view>
    <view class="pd-profile-card" wx:if="{{pendingProfileUpdate}}">
      <view class="pd-profile-items">
        <text class="pd-profile-item" wx:for="{{pendingProfileItems}}" wx:for-item="pf" wx:key="label">{{pf.label}}：{{pf.value}}</text>
      </view>
      <view class="pd-void-actions">
        <button class="pd-btn-reject" data-action="reject" bindtap="onDecideProfileUpdate" disabled="{{profileActionInFlight}}">驳回</button>
        <button class="pd-btn-approve" data-action="approve" bindtap="onDecideProfileUpdate" disabled="{{profileActionInFlight}}">确认变更</button>
      </view>
    </view>

    <!-- 待确认队列：店长/财务角色申请（家长与超管均可审批，见 processRoleAudit） -->
    <view class="pd-section-title" wx:if="{{pendingRoleRequests.length > 0}}">
      <text class="pd-section-icon">⏳</text>
      <text class="pd-section-txt">待审核的店长/财务申请（{{pendingRoleRequests.length}}）</text>
    </view>
    <view class="pd-void-card" wx:for="{{pendingRoleRequests}}" wx:key="applyId">
      <view class="pd-void-info">
        <text class="pd-void-date">{{item.realName}} · 申请【{{item.requestedRoleLabel}}】</text>
        <text class="pd-void-amount">手机号 {{item.phone}} · {{item.applyTime}}</text>
      </view>
      <view class="pd-void-actions">
        <button class="pd-btn-reject" data-id="{{item.applyId}}" data-action="reject" bindtap="onDecideRoleRequest" disabled="{{roleActionInFlight}}">驳回</button>
        <button class="pd-btn-approve" data-id="{{item.applyId}}" data-action="approve" bindtap="onDecideRoleRequest" disabled="{{roleActionInFlight}}">通过</button>
      </view>
    </view>

    <view class="pd-empty-tip" wx:if="{{pendingVoidList.length === 0 && !pendingProfileUpdate && pendingRoleRequests.length === 0 && !loading}}">
      <text>✅ 当前没有待确认的高风险操作</text>
    </view>

    <view class="pd-loading-box" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>

  </scroll-view>
</view>
