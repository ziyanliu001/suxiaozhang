        "itemNames": ["洗洁精", "纸巾"],
        "itemCategories": { "洗洁精": "kitchen_supplies", "纸巾": "kitchen_supplies" }
      }
    },
    {
      "id": "supermarket_promo_tag",
      "category": "超市小票·促销标签混入品名",
