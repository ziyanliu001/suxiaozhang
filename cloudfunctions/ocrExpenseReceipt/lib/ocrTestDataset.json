{
  "description": "真实/高拟真小票与发票 OCR 端到端压测数据集（2026-09-11 方向：真实小票端到端压测与解析容错加固）。每条 case 的 input 是模拟 OCR 逐行识别输出的原始文本数组（已包含真实场景常见的脏数据：方言别名、折痕断行、字母数字混淆、促销标签、无年份日期、纯中文金额与日期），expect 是 parseReceiptPayload() 输出草稿里需要满足的关键断言，供 parseReceiptPayload.stress.test.js 逐条驱动跑测并统计命中率。expect 字段均为可选，测试文件只校验数据集里实际给出的字段。",
  "cases": [
    {
      "id": "market_handwritten_dialect",
      "category": "农贸市场手写收据·方言别名+¥符号金额",
      "note": "洋芋(土豆方言)、番薯(红薯方言)是否能命中生鲜蔬菜关键词；总金额带¥符号",
      "input": [
        "陈记菜摊",
        "洋芋 3斤 x 2.00 = 6.00",
        "番薯 2斤 x 3.50 = 7.00",
        "合计 ¥13.00",
        "2026-09-08"
      ],
      "expect": {
        "merchant": "陈记菜摊",
        "reportDate": "2026-09-08",
        "totalAmount": 13,
        "totalAmountSource": "tier2_subtotal",
        "flagNeedsReview": false,
        "itemNames": ["洋芋", "番薯"],
        "itemCategories": { "洋芋": "fresh_veggie", "番薯": "fresh_veggie" }
      }
    },
    {
      "id": "market_handwritten_chinese_amount",
      "category": "农贸市场手写白条·纯中文大写金额（无任何阿拉伯数字总金额）",
      "note": "白条上完全没有印刷的阿拉伯数字总金额，只有手写的中文大写金额陈述",
      "input": [
        "老王蔬菜摊",
        "今收款：肆拾伍元整",
        "2026年09月08日"
      ],
      "expect": {
        "merchant": "老王蔬菜摊",
        "reportDate": "2026-09-08",
        "totalAmount": 45,
        "totalAmountSource": "chinese_words_amount"
      }
    },
    {
      "id": "supermarket_fold_linebreak",
      "category": "超市热敏纸小票折痕断行·品名与金额分行断裂",
      "note": "折痕导致同一件商品的品名与金额被识别成两行，验证跨行品名+金额兜底",
