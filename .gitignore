# 小程序代码上传密钥：绝不能进入版本库
private.*.key
*.pem

# 本地开发者工具私有配置
project.private.config.json
miniprogram/project.private.config.json

# 本地校验用临时依赖（tsc 等），不进入版本库
node_modules/

# 微信开发者工具"构建 npm"生成的产物，可由 package.json + node_modules 重新生成
miniprogram/miniprogram_npm/

# 微信开发者工具本地云函数调试缓存
.cloudbase/

# scripts/build-open-core.js 的构建产物，可随时重新生成，不进入版本库
dist/

# scripts/seedActivationCodes.ts 生成的真实激活码 JSON——等价于可直接兑换出
# 付费套餐权益的凭证，绝不能进入版本库（即便是私有仓库）
scripts/output/

# scripts/visual-check.js（miniprogram-automator 视觉快照）产出的截图——
# 每次运行都会覆盖重生成，纯本地调试用途，不进入版本库
.agent/
